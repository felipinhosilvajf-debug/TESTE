        {
            InfectadosGanharam(playerid);
        }
        if(QuantidadeInfectados == 0)
        {
            HumanosGanharam(playerid);
        }
    }
    if(TanoEventoJogosVorazes[playerid] == 1) //jogos vorazes
    {
        QuantidadeEvento --;
        TanoEventoJogosVorazes[playerid] = 0;
        format(gstring, sizeof(gstring), "[Jogos Vorazes] %s Saiu do jogo durante o evento, restam [%d] sobreviventes.",PlayerName(playerid),QuantidadeEvento);
        SendClientMessageToAll(COR_VERDE,gstring);
        VerificarGanhador(playerid);
    }
    if(CrashInfoSis == true)
    {
        switch(reason)
        {
                    case 0: format(gstring, sizeof(gstring), "%s saiu do server por erro de conexao ou crash", PlayerName(playerid));
                    case 1: format(gstring, sizeof(gstring), "%s saiu por vontade propria.", PlayerName(playerid));
                    case 2: format(gstring, sizeof(gstring), "%s Saiu do servidor kickado ou banido", PlayerName(playerid));
        }
        ProxDetector(100.0, playerid, gstring,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE);
    }
    if(WantedLevel[playerid] > 0)
    {
        foreach(new i: Player)
        {
            if(IsACop(i))
            {
                if(ProxDetectorS(30.0, playerid, i))
                {
                    new string[250];
                    WantedLevel[playerid] += 1;
                    //OnPlayerSave(playerid);
                    format(string, sizeof(string), "[AVISO COPS] Suspeito %s estava perto de Voce e saiu do servidor com [%d] crimes.", PlayerName(playerid), WantedLevel[playerid]);
                    if(ProxDetectorS(30.0, i, playerid))
                    {
                        SendClientMessage(i, COR_LIGHTRED, string);
                    }
                }
            }
        }
    }
    if(VozDePrisao[playerid] == 1)
    {
        PlayerInfo[playerid][pJailed] = 1;
        PlayerInfo[playerid][pJailTime] = 8 * 60;
        new string[99+MAX_PLAYER_NAME];
        format(string, sizeof(string), "[AVISO COPS]:{FFFFFF} %s{FFFF00} saiu do servidor com voz de prisao, e foi preso automaticamente!", PlayerName(playerid));
        SendFamilyMessage(1, COR_AMARELO, string);
        SendFamilyMessage(2, COR_AMARELO, string);
        SendFamilyMessage(3, COR_AMARELO, string);
        SendFamilyMessage(12, COR_AMARELO, string);
        SendFamilyMessage(13, COR_AMARELO, string);
        SendFamilyMessage(17, COR_AMARELO, string);
        SendFamilyMessage(25, COR_AMARELO, string);
        VozDePrisao[playerid] = 0;
    }
    new files[MAX_PLAYER_NAME];
    format(files, sizeof files, "DJ/%s.ini", PlayerName(playerid));
    if(DOF2_FileExists(files))
    {
        new vid = GetPlayerVehicleID(PlayerInfo[playerid][pCarKey]);
        if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
        PutPlayerInVehicle(playerid, vid, 0);
        ForT:ligarsom(playerid);
        DOF2_RemoveFile(files);
    }
    gActivePlayers[playerid]--;
    numplayers--;
