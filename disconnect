        SetVehicleToRespawn(HireCar[playerid]);
        HireCar[playerid] = 0;
    }
    if(TaNoQuarentena[playerid] == 1)
    {
        new QuantidadeHumanos, QuantidadeInfectados;

        foreach(new i: Player)
        {
            if(EquipeQuarentena[i] == 1) QuantidadeHumanos++;
            if(EquipeQuarentena[i] == 2) QuantidadeInfectados++;
        }
        if(EquipeQuarentena[playerid] == 1)
        {
            format(gstring, sizeof(gstring), "[Quarentena][Humano] %s saiu do jogo durante o evento, estam[%d] humanos.",PlayerName(playerid),QuantidadeHumanos);
            MensagemQuarentena(COR_GREEN, gstring);
            EquipeQuarentena[playerid] = 0;
            pClassiQuarentena[playerid] = 0;
        }
        else if(EquipeQuarentena[playerid] == 2)
        {
            format(gstring, sizeof(gstring), "[Quarentena][Infectado] %s saiu do jogo durante o evento, estam[%d] infectados.",PlayerName(playerid),QuantidadeInfectados);
            MensagemQuarentena(COR_GREEN, gstring);
            EquipeQuarentena[playerid] = 0;
            pClassiQuarentena[playerid] = 0;
        }

