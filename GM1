forward AccountExists(Name[]);
public AccountExists(Name[])
{
    new Query[200];
    format(Query, sizeof(Query), "SELECT `ID` FROM `contas` WHERE `Nome` = '%s'", DB_Escape(Name));
    Resultado = db_query(Conexao,Query);
    if(db_num_rows(Resultado) > 0)
    {
        db_free_result(Resultado);
        return true;
    }
    else
    {
        db_free_result(Resultado);
        return false;
    }
}

stock SaveToMysql(String[])
{
    CharReplace(String, ''', '~');
    CharReplace(String, '`', '~');
    CharReplace(String, '|', '#');
}
stock LoadFromMysql(String[])
{
    CharReplace(String, '~', ''');
    CharReplace(String, '#', '|');
}
stock CharReplace(string[], character, replace) //n3d
{
    for(new i = strlen(string); (--i) != -1; )
        if(string[i] == character) string[i] = replace;
    return false;
}
START::ClearMarriage(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        strmid(PlayerInfo[playerid][pMarriedTo], "Ninguem", 0, strlen("Ninguem"), 255);
        PlayerInfo[playerid][pMarried] = 0;
    }
    return 1;
}
START::ClearCrime(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        new string[MAX_PLAYER_NAME];
        format(string, sizeof(string), "********");
        strmid(PlayerCrime[playerid][pAcusado], string, 0, strlen(string), 255);
        strmid(PlayerCrime[playerid][pAcusador], string, 0, strlen(string), 255);
        strmid(PlayerCrime[playerid][pAcusoCrime], string, 0, strlen(string), 255);
        strmid(PlayerCrime[playerid][pAccusedof], string, 0, strlen(string), 255);
    }
    return 1;
}
