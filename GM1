public OnVehicleRespray(playerid, vehicleid, color1, color2)
{
    if(GetPVarInt(playerid, "pintura_Recente") > gettime()) //Bern by Equipe BGS
    {
        new string[80];
        format(string, sizeof(string), "ANTIXITER: %s[%d] foi kickado por floodar pinturas em veiculos, fique de olho!", PlayerName(playerid),playerid);
        ABroadCast(COR_LIGHTRED,string,1);
        AntiXiterLog(string);
        Kick(playerid);
    }
    PMC += 500;
    PDU += 500;
    DepositarOrgGrana(7,500);
    SetPVarInt(playerid, "pintura_Recente", gettime() + 1);
    CarrosTunados[vehicleid][COR1] = color1;
    CarrosTunados[vehicleid][COR2] = color2;
    return 1;
}
