START::CriarCorpo(playerid, animname[32])
{
    cActor[playerid][cActorID] = CreateActor(cActor[playerid][cSkinID],0,0,0,0);
    SetActorHealth(cActor[playerid][cActorID], 0);
    SetActorPos(cActor[playerid][cActorID], cActor[playerid][cPos][0],cActor[playerid][cPos][1],cActor[playerid][cPos][2]);
    SetActorFacingAngle(cActor[playerid][cActorID], cActor[playerid][cPos][3]);
    ApplyActorAnimation(cActor[playerid][cActorID], "PED", animname, 4.1, 0, 1, 1, 1, 0);
    SetTimerEx("RemoverCorpo", 30000, false, "i", playerid);
}

