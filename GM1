forward CM_EndEvent(time);
public CM_EndEvent(time)
{
    if(ColorMatchStage != STAGE_PLAYING) return 1;
    new string[32];

    if(time > 1) {
        time--;

        format(string, sizeof(string), "Tempo Restante: %s%s", (time > 10) ? ("~y~~h~") : ("~r~~h~"), ConvertToMinutes(time));
        TextDrawSetString(ColorMatchTD, string);
        ColorMatchEventTimer = SetTimerEx("CM_EndEvent", 1000, false, "i", time);
    }else if(time == 1) {
        for(new i, mp = GetPlayerPoolSize(); i <= mp; i++)
        {
            if(!IsPlayerConnected(i) || !InCMEvent[i]) continue;
            GivePlayerMoneyEx(i, CM_REWARD);
            PlayerInfo[i][pCoins] += 2;
            SendClientMessage(i, 0x3498DBFF, "[COLORMATCH] {FFFFFF}Voces sao todos vencedores!");
            SendClientMessage(i, 0x3498DBFF, "[COLORMATCH] {FFFFFF}Voce ganhou R$5000,00 + 2 Moedas, Parabens!");
        }

        SendClientMessageToAll(0x3498DBFF, "[COLORMATCH] {FFFFFF}Evento concluido.");
        ColorMatch_CleanUp(1);
    }

    return 1;
}
