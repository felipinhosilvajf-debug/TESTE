    CMD:irposicao(playerid)
    {
        if(BloqueadoIrPosicao[playerid] == 0)
        {
            new File[56];
            format(File, sizeof(File), "Posicoes/%s.txt", PlayerName(playerid));
            if(DOF2_FileExists(File))
            {
                SetPlayerPos(playerid, DOF2_GetFloat(File, "PosX"),  DOF2_GetFloat(File, "PosY"), DOF2_GetFloat(File, "PosZ")+1);
                SetPlayerInterior(playerid, DOF2_GetInt(File, "Interior"));
                SetPlayerFacingAngle(playerid, DOF2_GetFloat(File, "PosA"));
                SetCameraBehindPlayer(playerid);
                BloqueadoIrPosicao[playerid] = 1;
                SendClientMessage(playerid, COR_GREY, "{818689}Voce foi setado na ultima posicao onde saiu do jogo.");
            }
        }
        else if(BloqueadoIrPosicao[playerid] == 1)
        {
            SendClientMessage(playerid, COR_GREY, "O tempo para ir para a posicao que Voce saiu pela ultima vez do jogo, excedeu! ou Voce ja deu /irposicao.");
        }
        return 1;
    }

