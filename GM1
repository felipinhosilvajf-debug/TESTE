            if(Tax < 1)
            {
                SendClientMessage(playerid, COR_GREY, "   nao ha Dinheiro suficiente no banco de Impostos !");
                return true;
            }
            if(org < 1 || org > 35)
            {
                SendClientMessage(playerid, COR_GREY, "Organizacoes de 1 a 35");
                return true;
            }
            new Orgs = 0;
            new string[128];
            foreach(new i: Player)
            {
                if(GetPlayerOrg(i) == org)
                {
                    Orgs += 1;
                }
            }
            if(Orgs >= 1)
            {
                new price = dindin * Orgs;
                if(CofreOrg[7][Dinheiro] < price)return SendClientMessage(playerid, COR_GRAD1, "O cofre da prefeitura nao tem esse dinheiro todo!");
                SacarOrgGrana(7,price);
                PLV += price;
                format(string, sizeof(string), "Voce deu R$%d de taxa para cada um da Organizacao %s!",dindin, GetOrgName(org));
                SendClientMessage(playerid, COR_GREY, string);
                format(string, sizeof(string), "Gasto Total: R$%d!",price);
                SendClientMessage(playerid, COR_GREY, string);
                foreach(new i: Player)
                {
                    if(GetPlayerOrg(i) == org)
                    {
                        format(string, sizeof(string), "* Voce recebeu R$%d do banco de Impostos pelo Prefeito.",dindin);
