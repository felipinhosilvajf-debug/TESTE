START::OnPlayerAtualizador(playerid) //
{
    new string[128];
    if(IsPlayerConnected(playerid) && gPlayerLogged[playerid] == 1)
    {
        if(PlayerInfo[playerid][pSFOME] == 0) AtualizarFomeSede(playerid);
        TempoOnline[playerid] += 1;
        if(EditandoAcessorio[playerid])
        {
            if(ModoEditar[playerid] == 1)
            {
                PlayerTextDrawSetString(playerid, EditorMobile[playerid][10], "Posicao");
            }
            else if(ModoEditar[playerid] == 2)
            {
                PlayerTextDrawSetString(playerid, EditorMobile[playerid][10], "Rotacao");
            }
            else if(ModoEditar[playerid] == 3)
            {
                PlayerTextDrawSetString(playerid, EditorMobile[playerid][10], "Tamanho");
            }
        }
        if(LagSis == true)
        {
            OnPlayerSave(playerid); //pode dar merda
        //  SalvarVeiculosConce(playerid);
        }
        SalvarVeiculosConce(playerid);
        ScoreLevel(playerid);
        switch(GetPlayerState(playerid)){
            case 1, 2, 3:{
                if((gettime()-TempoAFK[playerid]) > 4 && !IsPlayerNPC(playerid)){
                        format(gstring, sizeof gstring, "{df5454}Ausente a {ffffff}%s", ConvertTime(gettime()-TempoAFK[playerid]));
                        SetPlayerChatBubble(playerid, gstring, -1, 45.0, 1500);
                        EstaAFK[playerid] = 1;
                    }
                    else
                    {
                            EstaAFK[playerid] = 0;
                    }

            }
        }
        if((gettime()-TempoAFK[playerid]) > 2)return true;
        ResetPlayerMoney(playerid);
        GivePlayerMoney(playerid, GetPlayerMoneyEx(playerid));
        if (IsPlayerInRangeOfPoint(playerid, 10.0, FogoX[1], FogoY[1], FogoZ[1]))
        {
            if (PlayerInfo[playerid][pMembro] != 4 && PlayerInfo[playerid][pLider] != 4 && IncendioAcontecendo == true)
            {
                CreateExplosion(FogoX[1], FogoY[1], FogoZ[1], 1, 3.0);
            }
        }
        if(PlayerInfo[playerid][pEmprego] == 10)
        {
            if(!IsPlayerInFazenda(playerid))
            {
                new vid = GetPlayerVehicleID(playerid);
                if(IsPlayerInVehicle(playerid, vid))
                {
                    if(CarrosColheita(vid) || CarrosPlantacao(vid))
                    {
                        SendClientMessage(playerid, COR_VERDE, "Voce estava saindo com o veiculo da fazenda, e proibido. O veiculo voltou para a fazenda !");
                        SetVehicleToRespawn(vid);
                    }
                }
            }
        }
        //Clock
        new hora, minuto, segundo;
        gettime(hora, minuto, segundo);
        if(hora == 0 && minuto == 0 && segundo == 59)
