    switch(((gettime()+334800)/86400-(gettime()+334800)/86400/7*7))
    {
        case 0: WeekDay = "____Domingo";
        case 1: WeekDay = "Segunda-Feira";
        case 2: WeekDay = "__Terca-Feira";
        case 3: WeekDay = "_Quarta-Feira";
        case 4: WeekDay = "_Quinta-Feira";
        case 5: WeekDay = "__Sexta-Feira";
        case 6: WeekDay = "_____Sabado";
    }
    return WeekDay;
}






