        new rand = random(2000); rand += 3000;
        Jackpot += rand;
        SaveStuff();
        format(gstring, sizeof(gstring), "{df5454}[Loterica] {ffffff}A Bolada foi levantada para R$%d!", Jackpot);
        SendClientMessageToAll(COR_START, gstring);
    }
    return 1;
