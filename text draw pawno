// -----------------------------------------------------------------------------
// VIRTUAL BOOST RPG - LOGIN / MENU TEXTDRAWS
// Redesign: identidade escura, minimalista e dourado-ambar.
// Os indices 12 a 17 continuam reservados aos botoes clicaveis existentes.
// -----------------------------------------------------------------------------
//
// IMPORTANTE: manter a array VirtualBoost com pelo menos 18 elementos.
//
// Exemplo:
// new Text:VirtualBoost[18];
//
// -----------------------------------------------------------------------------


howTelaLogin(playerid)
{
    new Str[700];

    for(new i = 0; i < sizeof(VirtualBoost); i++)
    {
        TextDrawShowForPlayer(playerid, VirtualBoost[i]);
    }

    format(Str, sizeof(Str),
        "PAINEL_DE_ATIVIDADE~n~~n~NOVOS_CADASTROS:_%d~n~ACESSOS_TOTAIS:_%d",
        estatisticasplayer2, estatisticasplayer);

    TextDrawSetString(VirtualBoost[5], Str);
    SelectTextDraw(playerid, 0xD6A84FFF);
}

hideTelaLogin(playerid)
{
    for(new i = 0; i < sizeof(VirtualBoost); i++)
    {
        TextDrawHideForPlayer(playerid, VirtualBoost[i]);
    }

    CancelSelectTextDraw(playerid);
}


// Cria uma caixa TextDraw com dimensoes fixas.
stock Text:VB_CreatePanel(Float:x, Float:y, Float:w, Float:h, color)
{
    new Text:td = TextDrawCreate(x, y, " ");
    TextDrawLetterSize(td, 0.0, h / 10.0);
    TextDrawTextSize(td, x + w, y + h);
    TextDrawAlignment(td, 1);
    TextDrawColor(td, 0xFFFFFFFF);
    TextDrawUseBox(td, 1);
    TextDrawBoxColor(td, color);
    TextDrawSetShadow(td, 0);
    TextDrawSetOutline(td, 0);
    TextDrawBackgroundColor(td, 0x00000000);
    TextDrawFont(td, 1);
    TextDrawSetProportional(td, 1);
    return td;
}


