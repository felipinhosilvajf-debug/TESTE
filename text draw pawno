// Ajuste a posicao de toda a interface alterando estes dois valores.
// X positivo move para a direita; Y positivo move para baixo.
#define VB_LOGIN_OFFSET_X (0.0)
#define VB_LOGIN_OFFSET_Y (0.0)

// Cria um card retangular. Os indices 6 a 11 ficam atras dos textos clicaveis.
stock Text:VBLoginCard(Float:x, Float:y, Float:w, Float:h, color)
{
    new Text:td = TextDrawCreate(x + VB_LOGIN_OFFSET_X, y + VB_LOGIN_OFFSET_Y, "_");
    TextDrawLetterSize(td, 0.0, 1.0);
    TextDrawTextSize(td, x + w + VB_LOGIN_OFFSET_X, y + h + VB_LOGIN_OFFSET_Y);
    TextDrawAlignment(td, 1);
    TextDrawColor(td, 0xFFFFFFFF);
    TextDrawUseBox(td, 1);
    TextDrawBoxColor(td, color);
    TextDrawSetShadow(td, 0);
    TextDrawSetOutline(td, 0);
    TextDrawBackgroundColor(td, 0x00000000);
    TextDrawFont(td, 1);
    TextDrawSetProportional(td, 1);
    return td;
}

