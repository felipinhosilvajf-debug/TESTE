	/*
	 * =============================================================
	 * AUTO FARM
	 * =============================================================
	 */

	public void start()
	{
		if (self == null)
			return;

		if (self.isAutoFarm())
		{
			back();
			return;
		}

		self.startAutoFarm();

		back();
	}

	public void stop()
	{
		if (self == null)
			return;

		if (!self.isAutoFarm())
		{
			back();
			return;
		}

		self.stopAutoFarm();

		back();
	}

	public void toggle()
	{
		if (self == null)
			return;

		if (self.isAutoFarm())
			stop();
		else
			start();
	}

