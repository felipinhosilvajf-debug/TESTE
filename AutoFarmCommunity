	private void showHtml(String html)
	{
		if (self == null)
			return;

		/*
		 * Auto Farm usa uma janela HTML pequena, no mesmo estilo
		 * de uma janela de NPC. Não abrir no Community Board.
		 */
		NpcHtmlMessage message =
			new NpcHtmlMessage(0);

		message.setHtml(html);

		self.sendPacket(message);
	}

	/*
	 * =============================================================
	 * AUTO FARM
	 * =============================================================
	 */

	public void start()
	{
		if (self == null)
			return;

		if (self.isAutoFarm())
		{
			back();
			return;
		}

		self.startAutoFarm();

		back();
	}

	public void stop()
	{
		if (self == null)
			return;

		if (!self.isAutoFarm())
		{
			back();
			return;
		}

		self.stopAutoFarm();

		back();
	}

	public void toggle()
	{
		if (self == null)
			return;

		if (self.isAutoFarm())
			stop();
		else
			start();
	}

