	public void setPotion(String[] args)
	{
		if (self == null)
			return;

		if (args == null || args.length < 1)
			return;

		try
		{
			int itemId =
				Integer.parseInt(args[0]);

			/*
			 * Somente:
			 *
			 * 1539 HP
			 * 5592 CP
			 * 728 MP
			 * 0 Sem poção
			 */
			if (itemId != 0 &&
				itemId != 1539 &&
				itemId != 5592 &&
				itemId != 728)
			{
				self.sendMessage(
					"Recurso inválido."
				);

				return;
			}

			if (itemId > 0 &&
				self.getInventory().getItemByItemId(itemId) == null)
			{
				self.sendMessage(
					"Você não possui esta poção no inventário."
				);

				return;
			}

			self.setVar(
				"autofarm_potion",
				String.valueOf(itemId),
				-1
			);

			back();
		}
		catch (NumberFormatException e)
		{
			self.sendMessage(
				"Recurso inválido."
			);
		}
	}

