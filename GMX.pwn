                   SetPlayerFacingAngle(playerid, gChuckArena[rand][3]);
                   SetPlayerVirtualWorld(playerid,0);
                   SetPlayerInterior(playerid,10);
                   InteriorAtual[playerid] = 43;
                   PlayerInfo[playerid][pTrazerChuck] = 0;
                   return 1;
              }
