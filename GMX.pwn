START::Incendio(playerid)
{
     new string[200], NickName[MAX_PLAYER_NAME];
     new location[MAX_ZONE_NAME];
     GetPlayer2DZone(playerid, location, MAX_ZONE_NAME);
     GetPlayerName(playerid, NickName, sizeof(NickName));
     format(string, sizeof(string), "[AVISO] Um novo incendio surgiu nas proximidades de %s. Culpado: %s[%d]!", location, PlayerName(playerid), playerid);
     SendClientMessageToAll(COR_START, string);
     format(string, sizeof(string), "[MeDICOS] Incendio!!! Digite: /localincendio e va apagar com o cartao batido + extintor!", NickName,playerid);
     SendFamilyMessage(4, COR_LIGHTRED, string);
     FogoID[0] = CreateDynamicObject(18690,FogoX[0],FogoY[0],FogoZ[0],0,0,0,0);
     FogoID[1] = CreateDynamicObject(18690,FogoX[1],FogoY[1],FogoZ[1],0,0,0,0);
     FogoID[2] = CreateDynamicObject(18690,FogoX[2],FogoY[2],FogoZ[2],0,0,0,0);
     FogoID[3] = CreateDynamicObject(18691,FogoX[3],FogoY[3],FogoZ[3],0,0,0,0);
     FogoID[4] = CreateDynamicObject(18690,FogoX[4],FogoY[4],FogoZ[4],0,0,0,0);
     FogoID[5] = CreateDynamicObject(18691,FogoX[5],FogoY[5],FogoZ[5],0,0,0,0);
     FogoID[6] = CreateDynamicObject(18690,FogoX[6],FogoY[6],FogoZ[6],0,0,0,0);
     FogoID[7] = CreateDynamicObject(18690,FogoX[7],FogoY[7],FogoZ[7],0,0,0,0);
     FogoID[8] = CreateDynamicObject(18691,FogoX[8],FogoY[8],FogoZ[8],0,0,0,0);
     CreateExplosion(FogoX[1],FogoY[1],FogoZ[1], 1, 3.0);
     GivePlayerMoneyEx(playerid,1000);
     SetPlayerCriminal(playerid,255, "Incendio");
     Foguinho = SetTimerEx("NovoIncendio", 2000, 0, "i", playerid);
     return 1;
}
START::NovoIncendio(playerid)
{
     FogoID[9] = CreateDynamicObject(18690,FogoX[9],FogoY[9],FogoZ[9],0,0,0,0);
     FogoID[10] = CreateDynamicObject(18690,FogoX[10],FogoY[10],FogoZ[10],0,0,0,0);
     FogoID[11] = CreateDynamicObject(18690,FogoX[11],FogoY[11],FogoZ[11],0,0,0,0);
     FogoID[12] = CreateDynamicObject(18691,FogoX[12],FogoY[12],FogoZ[12],0,0,0,0);
     FogoID[13] = CreateDynamicObject(18690,FogoX[13],FogoY[13],FogoZ[13],0,0,0,0);
     FogoID[14] = CreateDynamicObject(18691,FogoX[14],FogoY[14],FogoZ[14],0,0,0,0);
     FogoID[15] = CreateDynamicObject(18690,FogoX[15],FogoY[15],FogoZ[15],0,0,0,0);
     FogoID[16] = CreateDynamicObject(18690,FogoX[16],FogoY[16],FogoZ[16],0,0,0,0);
     FogoID[17] = CreateDynamicObject(18691,FogoX[17],FogoY[17],FogoZ[17],0,0,0,0);
     CreateExplosion(FogoX[1],FogoY[1],FogoZ[1], 7, 3.0);
     Foguinho = SetTimerEx("tempoapagar", 1200000, 0, "i", playerid);
     return 1;
}
START::tempoapagar(playerid)
{
    GivePlayerMoneyEx(playerid, 1000);
    SendClientMessage(playerid, 0xA0A0A0FF, "[INFO]: Voce recebeu uma quantia de R$1000 no incendio!");
    SendClientMessageToAll(COR_VAGOS, "[AVISO]: A SA:MU nao apagaram o foco de incendio e o incendio se espalhou!");
    DestroyDynamicObject(FogoID[0]);
    DestroyDynamicObject(FogoID[1]);
    DestroyDynamicObject(FogoID[2]);
    DestroyDynamicObject(FogoID[3]);
    DestroyDynamicObject(FogoID[4]);
    DestroyDynamicObject(FogoID[5]);
    DestroyDynamicObject(FogoID[6]);
    DestroyDynamicObject(FogoID[7]);
    DestroyDynamicObject(FogoID[8]);
    DestroyDynamicObject(FogoID[9]);
    DestroyDynamicObject(FogoID[10]);
    DestroyDynamicObject(FogoID[11]);
    DestroyDynamicObject(FogoID[12]);
    DestroyDynamicObject(FogoID[13]);
    DestroyDynamicObject(FogoID[14]);
    DestroyDynamicObject(FogoID[15]);
    DestroyDynamicObject(FogoID[16]);
    DestroyDynamicObject(FogoID[17]);
    IncendioAcontecendo = false;
    ApagandoIncendio[playerid] = false;
    KillTimer(Foguinho);
    return 1;
}
START::ApagarFogo(playerid)
{
     new NickName[MAX_PLAYER_NAME];
     if(Extintor[playerid] > 0 && ApagandoIncendio[playerid] == true && MeioDeApagar[playerid] > 0 && PlayerInfo[playerid][pMembro] == 4 || PlayerInfo[playerid][pLider] == 4)
     {
          if(MeioDeApagar[playerid] == EXTINTOR)
          {
               for(new e = 0; e < 17; e++)
               {
                    if(IsPlayerInRangeOfPoint(playerid, 20.0, FogoX[e], FogoY[e], FogoZ[e]))
                    {
                         DestroyDynamicObject(FogoID[e]);
                         FogoApagado[e] = true;
                         if(FogoApagado[8] == true)
                         {
                              new string[128];
                              IncendioAcontecendo = false;
                              ApagandoIncendio[playerid] = false;
                              Extintor[playerid] = 0;
                              GetPlayerName(playerid, NickName, sizeof(NickName));
                              MeioDeApagar[playerid] = 0;
                              if(PlayerInfo[playerid][pSex] == 1)
                              {
                                  format(string, sizeof(string), "[AVISO] Bombeiro: %s e a SAMU apagaram o incendio!", PlayerName(playerid));
                                  SendClientMessageToAll(COR_LIGHTRED, string);
                              }
                              else if(PlayerInfo[playerid][pSex] == 2)
                              {
                                  format(string, sizeof(string), "[AVISO] Bombeiro: %s e a SAMU apagaram o incendio!", PlayerName(playerid));
                                  SendClientMessageToAll(COR_LIGHTRED, string);
                              }
                              SendFamilyMessage(4, COR_LIGHTBLUE, "[AVISO] Os bombeiros apagou o incendio, todos os membros irao receber +R$1500,00 no salario !");
                              foreach(new i: Player)
                              {
                                   if(IsPlayerConnected(i))
                                   {
                                        if(GetPlayerOrg(i) == 4)
                                        {
                                            GameTextForPlayer(i, "~b~incendio apagado~n~ bonus: ~g~R$1500!", 5000, 1);
                                            PlayerInfo[i][pSalario] += 1500;
                                        }
                                   }
                              }
                              new Conta = CofreOrg[4][Dinheiro] + 1000;
                              DepositarGranaOrg(4, Conta);
                              PlayerInfo[playerid][pApagado] += 1;
                              KillTimer(SetTimerEx("ApagarFogo", 12000, false, "i", playerid));
                              KillTimer(Foguinho);
                         }
                    }
               }
          }
          if(MeioDeApagar[playerid] == CAMINHAO && IsPlayerInRangeOfPoint(playerid, 40.0, FogoX[1]-8.3718,FogoY[1]-8.429,FogoZ[1]) && PlayerInfo[playerid][pMembro] == 4 || PlayerInfo[playerid][pLider] == 4)
          {
               for(new e = 0; e < 17; e++)
               {
                    DisablePlayerCheckpoint(playerid);
                    DestroyDynamicObject(FogoID[e]);
                    FogoApagado[e] = true;
                    if(FogoApagado[8] == true)
                    {
                         new string[128];
                         IncendioAcontecendo = false;
                         ApagandoIncendio[playerid] = false;
                         Extintor[playerid] = 0;
                         GetPlayerName(playerid, NickName, sizeof(NickName));
                         GivePlayerMoneyEx(playerid,8000);
                         PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                         SendClientMessage(playerid, COR_GRAD1, "Voce apagou um incendio e ganhou R$[8000] ! ");
                         format(string, sizeof(string), "[AVISO]Medico: %s e a SA-MU apagaram o incendio !", PlayerName(playerid));
                         SendClientMessageToAll(COR_LIGHTRED, string);
                         MeioDeApagar[playerid] = 0;
                         KillTimer(SetTimerEx("ApagarFogo", 12000, false, "i", playerid));
                         KillTimer(Foguinho);
                    }
               }
          }
     }
     return 1;
}
stock GanharItem(playerid, Item, Ammo)
{
    new Nome[20];
    new i;
    while(i != 8)
    {
        if(CaixaArma[i][playerid] == Item)
        {
            CaixaAmmo[i][playerid]=CaixaAmmo[i][playerid]+Ammo;
            break;
        }
        if(CaixaArma[i][playerid] == 0)
        {
            CaixaArma[i][playerid]=Item;
            CaixaAmmo[i][playerid]=Ammo;
            break;
        }
        i++;
    }
    GetWeaponName(Item, Nome, 20);
    new string[35]=" Adquirido!";
    strins(string, Item == 18 ? ("Cocktail Molotov") : (Nome), 0, 20);
    return SendClientMessage(playerid, -1, i == 8 ? ("Caixa de armas cheia!") : (string));
}

stock GuardarItem(playerid)
{
    new Item = GetPlayerWeapon(playerid);
    new Ammo = GetPlayerAmmo(playerid);
    if(Item == 0) return SendClientMessage(playerid, -1, "Item invalido!");
    new i;
    while(i != 8)
    {
        if(CaixaArma[i][playerid] == Item)
        {
            CaixaAmmo[i][playerid]=CaixaAmmo[i][playerid]+Ammo;
            RemoverItem(playerid, Item);
            break;
        }
        if(CaixaArma[i][playerid] == 0)
        {
            CaixaArma[i][playerid]=Item;
            CaixaAmmo[i][playerid]=Ammo;
            RemoverItem(playerid, Item);
            break;
        }
        i++;
    }
    return i == 8 ? SendClientMessage(playerid, -1, "Caixa de armas cheia!") : 1;
}

stock RemoverItem(playerid, item)
{
    new Arma[13][2];
    for(new i = 1; i < 13; ++i) GetPlayerWeaponData(playerid, i, Arma[i][0], Arma[i][1]);
    ResetPlayerWeapons(playerid);
    for(new i = 1; i < 13; ++i)
    {
        if(item != Arma[i][0]) GivePlayerWeapon(playerid, Arma[i][0], Arma[i][1]);
    }
}

stock ItemOpcoes(playerid, Item)
{
    if(CaixaArma[Item][playerid] == 0) return PlayerPlaySound(playerid, 1053, 0.0, 0.0, 0.0);
    ItemOpcao[playerid]=Item;
    return ShowPlayerDialog(playerid,DialogOpc,DIALOG_STYLE_LIST,"Opcoes:","Usar\nDestruir","OK","Fechar");
}
