                Fixr[i] = 0;
            }
        }
    }
}
START::PlantarMaconhas(playerid, slt)
{

    for(new mac = 0; mac < MAX_MACONHA; mac++)
    {
        if(MaconhaInfo[mac][PodeUsar] == false && IsPlayerInRangeOfPoint(playerid, 5.0, MaconhaInfo[mac][mX],MaconhaInfo[mac][mY],MaconhaInfo[mac][mZ]))
        {
            ClearAnimations(playerid);
            PlantandoMaconha[playerid] = false;
            SendClientMessage(playerid, COR_GRAD1, "Ja existe uma plantacao de maconha muito proximo a este local");
            MaconhaInfo[slt][PodeUsar] = true;
            return true;
        }
    }

    new string[200];
    static
        Float:pX, Float:pY, Float:pZ;
    GetPlayerPos(playerid, pX, pY, pZ);
    MaconhaInfo[slt][mX] = pX;
    MaconhaInfo[slt][mY] = pY;
    MaconhaInfo[slt][mZ] = pZ-1;
    MaconhaInfo[slt][GramasProntas] = 0;
    MaconhaInfo[slt][Crescida] = 0;
    MaconhaInfo[slt][Object] = CreateDynamicObject(19300, pX, pY, pZ-1,0.0, 0.0, 0.0);
    strmid(MaconhaInfo[slt][Dono], PlayerName(playerid), 0, strlen(PlayerName(playerid)), 35);
    format(string, sizeof string, "â€¢Plantacao de maconhaâ€¢\nDono: %s\nPlantacao NÂº: %d\nCrescida: %d/%d\nGramas: %dg",
    MaconhaInfo[slt][Dono], slt,MaconhaInfo[slt][Crescida],Max_Crescida, MaconhaInfo[slt][GramasProntas]);
    MaconhaInfo[slt][TT] = Create3DTextLabel(string, 0x1FF61F99, pX, pY, pZ, 10.0, 0);
    ClearAnimations(playerid);
    PlantandoMaconha[playerid] = false;
    SendClientMessage(playerid, 0xF6F600FF, "Semente plantada com sucesso, use: /maconhas para ver suas plantacoes.");

    return true;
}

stock GetPlayerSpeedEx(playerid)
{
    static Float: posS[ 3 ] ;
    GetPlayerVelocity(playerid , posS [ 0 ] , posS [ 1 ] , posS [ 2 ] ) ;
    return floatround(floatmul(floatsqroot(floatadd(floatpower(posS[ 0 ] , 2 ) ,floatpower(posS [ 1 ] , 2 ))), 170.0));
}
public OnPlayerCommandReceived(playerid, cmdtext[])
{
    if(enjaulado[playerid] == 1)
    {
         if(PlayerInfo[playerid][pAdmin] == 0)
         {
              SendClientMessage(playerid, COR_LIGHTRED, "Voce nao pode usar comandos, Voce esta sequestrado !");
              return 0;
         }
    }
    if(pimobilizado[playerid] == 1 && PlayerInfo[playerid][pAdmin] == 0)
    {
         SendClientMessage(playerid, COR_AMARELO, "Voce nao pode usar comandos, Voce esta imobilizado !");
         return 0;
    }
    if(Dormindo[playerid] == true) // sistema de dormir
    {
         SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao pode usar comandos dormindo, para acordar aperte Enter !");
         return 0;
    }
    if(strcmp("/sairduelo", cmdtext, true) == 0)
    {
         if(emduelo[playerid] == 0)
         {
             return SendClientMessage(playerid,COR_GRAD1,"Voce nao esta em um Duelo!");
         }
         new Float:arm;
         GetPlayerHealth(playerid,arm);
         if(arm < 100) return SendClientMessage(playerid,COR_GRAD1,"Voce so pode usar esse comando com vida cheia!");
         emduelo[playerid] = 0;
         desafiou[playerid] = 0;
         desafiado[playerid] = 0;
         duelols[playerid] = 0;
         duelolv[playerid] = 0;
         SetPlayerInterior(playerid, 0);
         SetPlayerPos(playerid, 2688.7698,-1702.2043,10.3984);
         SetPlayerVirtualWorld(playerid, 0);
         PlayerInfo[playerid][pDesafiador] = 0;
         PlayerInfo[playerid][pDesafiante] = 0;
         return 1;
    }
    if(emduelo[playerid] == 1)
    {
        SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao pode usar comandos durante o duelo ! para sair digite /sairduelo");
        return 0;
    }
    if(strcmp("/sairarena", cmdtext, true) == 0)
    {
         if(TDM[playerid] == 0)
         {
             return SendClientMessage(playerid,COR_GRAD1,"Voce nao esta em na Arena Deagle!");
         }
         new Float:arm;
         GetPlayerHealth(playerid,arm);
         if(arm < 100) return SendClientMessage(playerid,COR_GRAD1,"Voce so pode usar esse comando com vida cheia!");
         TDM[playerid] = 0;
         SetPlayerInterior(playerid, 0);
         SetPlayerPos(playerid, 1211.6652,-1750.1676,13.5942);
         SetPlayerVirtualWorld(playerid, 0);
         return 1;
    }
    if(TDM[playerid] == 1)
    {
        SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao pode usar comandos na arena de duelos ! para sair digite /sairarena");
        return 0;
    }
    if(NoTuto[playerid] > 0)
    {
        SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao pode usar comandos durante o tutorial !");
        return 0;
    }
    return 1;
}
static stock SacarOrgGrana(org,valor)
{
    new antes = CofreOrg[org][Dinheiro];
    CofreOrg[org][Dinheiro] = antes-valor;
    new arquivo[75];
    format(arquivo, sizeof(arquivo), Pasta_CofreOrg,org);
    DOF2_SetInt(arquivo,"Dinheiro",CofreOrg[org][Dinheiro]);
    DOF2_SaveFile();
    return true;
}
static stock DepositarOrgGrana(org,valor)
{
    new antes = CofreOrg[org][Dinheiro];
    CofreOrg[org][Dinheiro] = antes+valor;
    new arquivo[75];
    format(arquivo, sizeof(arquivo), Pasta_CofreOrg,org);
    DOF2_SetInt(arquivo,"Dinheiro",CofreOrg[org][Dinheiro]);
    DOF2_SaveFile();
    return true;
}
stock CreateDroppedItem(Item, Amount, Float:gPosX, Float:gPosY, Float:gPosZ)
{
    new f = MAX_OBJ+1;
    for(new a = 0; a < MAX_OBJ; a++)
    {
        if(dItemData[a][ObjtPos][0] == 0.0)
        {
            f = a;
            break;
        }
    }
    if(f > MAX_OBJ) return;
    dItemData[f][droptTimer] = gettime() + 60;//60 segundos para o item sumir
    dItemData[f][ObjtData][0] = Item;
    dItemData[f][ObjtData][1] = Amount;
    dItemData[f][ObjtPos][0] = gPosX;
    dItemData[f][ObjtPos][1] = gPosY;
    dItemData[f][ObjtPos][2] = gPosZ;
    dItemData[f][ObjtID] = CreateDynamicPickup(1210, 24, dItemData[f][ObjtPos][0], dItemData[f][ObjtPos][1], dItemData[f][ObjtPos][2]-0.8); //CreateDynamicObject(Item, dItemData[f][ObjtPos][0], dItemData[f][ObjtPos][1], dItemData[f][ObjtPos][2]-1, 93.7, 120.0, random(360), -1, -1, -1, 80.0);
    new buffer[900];
    format(buffer, sizeof buffer, "{858585}Item: {FFFFFF}%s\n{858585}Unidade(s): {FFFFFF}%d", NomeItemInventario(dItemData[f][ObjtData][0]), dItemData[f][ObjtData][1]);
    dItemData[f][textt3d] = CreateDynamic3DTextLabel(buffer, 0xAAAAAAAA, dItemData[f][ObjtPos][0], dItemData[f][ObjtPos][1], dItemData[f][ObjtPos][2]-1, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1, -1, 80.0);
    return;
}
stock DestroyDroppedObjectItem(dropid)
{
        DestroyDynamicPickup(dItemData[dropid][ObjtID]);
        DestroyDynamic3DTextLabel(dItemData[dropid][textt3d]);
        dItemData[dropid][ObjtPos][0] = 0.0;
        dItemData[dropid][ObjtPos][1] = 0.0;
        dItemData[dropid][ObjtPos][2] = 0.0;
        dItemData[dropid][ObjtID] = -1;
        dItemData[dropid][ObjtData][1] = 0;
        return 1;
}
stock DestroyDroppedObject(dropid)
{
        DestroyDynamicObject(dItemData[dropid][ObjtID]);
        DestroyDynamic3DTextLabel(dItemData[dropid][textt3d]);
        dItemData[dropid][ObjtPos][0] = 0.0;
        dItemData[dropid][ObjtPos][1] = 0.0;
        dItemData[dropid][ObjtPos][2] = 0.0;
        dItemData[dropid][ObjtID] = -1;
        dItemData[dropid][ObjtData][0] = 0;
        dItemData[dropid][ObjtData][1] = 0;
        return 1;
}
