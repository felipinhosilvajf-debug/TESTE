            SendClientMessage(playerid, COR_OBS, "[DETRAN]: {ffffff}Voce pagou R$2.000 para abrir o menu do Detran, o dinheiro que Voce pagou foi para o cofre da ORG.");
            DepositarGranaOrg(14, 2000);
            ShowPlayerDialog(playerid, 15584, DIALOG_STYLE_LIST, "Cabine do Detran", "Blindar Veiculo R$3.000\nReparar Veiculo R$3.000\nAbastecer por Completo R$5.000", "Comprar", "Fechar");
        }
        if(GetPlayerOrg(playerid) == 1)
