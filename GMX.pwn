    CMD:parma(playerid)
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
        new f = MAX_OBJ+1;
        for(new a = 0; a < MAX_OBJ; a++)
        {
            if(IsPlayerInRangeOfPoint(playerid, 1.8, dItemData[a][ObjtPos][0], dItemData[a][ObjtPos][1], dItemData[a][ObjtPos][2]))
            {
                f = a;
                break;
            }
        }
        if(f > MAX_OBJ) return 1;
        if(gettime() < GetPVarInt(playerid, #VarFlood8))
            return 1;
        SetPVarInt(playerid, #VarFlood8, gettime()+2);
        GivePlayerWeaponEx(playerid, dItemData[f][ObjtData][0], dItemData[f][ObjtData][1]);
        DestroyDroppedObject(f);
        ApplyAnimation(playerid,"BOMBER","BOM_Plant_2Idle",4.1,0,1,1,0,0);
        new buffer[85];
        format(buffer, sizeof(buffer), "Voce pegou um(a) %s.", Nomesdasarmas[dItemData[f][ObjtData][0]]);
        SendClientMessage(playerid, 0x33AA3300, buffer);
        format(buffer, sizeof(buffer), "*%s pegou um(a) %s do chao.", PlayerName(playerid), Nomesdasarmas[dItemData[f][ObjtData][0]]);
        ProxDetector(30.0, playerid, buffer, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
        printf("%s", buffer);
        return 1;
    }
    CMD:pitem(playerid)
    {
        if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;
        new f = MAX_OBJ+1;
        for(new a = 0; a < MAX_OBJ; a++)
        {
            if(IsPlayerInRangeOfPoint(playerid, 1.8, dItemData[a][ObjtPos][0], dItemData[a][ObjtPos][1], dItemData[a][ObjtPos][2]))
            {
                f = a;
                break;
            }
        }
        if(f > MAX_OBJ) return 1;

        if(gettime() < GetPVarInt(playerid, #VarFlood8))
            return 1;
        SetPVarInt(playerid, #VarFlood8, gettime()+2);

        for(new i=0; i<75; i++)
        {
            if(InventarioInfo[playerid][i][iSlot] == 19382)
            {
                InventarioInfo[playerid][i][iSlot] = dItemData[f][ObjtData][0];
                InventarioInfo[playerid][i][iUnidades] = dItemData[f][ObjtData][1];
                break;
            }
        }

        new str[256];
        format(str, sizeof str, "{858585}Voce pegou um item: %s, com %d unidade(s)", NomeItemID(dItemData[f][ObjtData][0]), dItemData[f][ObjtData][1]);
        SendClientMessage(playerid, COR_LIGHTRED, str);

        format(stringZCMD, sizeof(stringZCMD), "[Inventario]: {858585}%s pegou um item: %s", PlayerName(playerid), NomeItemInventario(dItemData[f][ObjtData][0]));
        ProxDetector(20.0, playerid, stringZCMD,COR_LIGHTRED,COR_LIGHTRED,COR_LIGHTRED,COR_LIGHTRED,COR_LIGHTRED);
        DestroyDroppedObjectItem(f);

        ApplyAnimation(playerid,"BOMBER","BOM_Plant_2Idle",4.1,0,1,1,0,0);
        return 1;
    }
    CMD:caixinha(playerid){

        if(PlayerToPoint(2.0,playerid,1480.2086,-1639.5801,14.1484) || IsPlayerConnected(playerid))
        {
            if(ContarJogadores() < PlayersCaixinha && PlayerInfo[playerid][pCaixinha] != char)
            {
                format(stringZCMD, sizeof(stringZCMD), "nao atingimos o numero de jogadores(%d) necessario para desbloquear os presentes.", PlayersCaixinha);
                SendClientMessage(playerid, -1, stringZCMD);
                SendClientMessage(playerid,COR_GRO,"Convide seus amigos para jogar, assim Voce e eles poderao ganhar presentes!");
                return 1;
            }
            if(PlayerInfo[playerid][pCaixinha] == char) return SendClientMessage(playerid, COR_BRANCO, "Voce ja pegou sua caixa surpresa, volte no proximo payday.");
            new str1[50], string[256];
            new TipoCaixinha;

            if(CaixaPla == true)
            {
                new RandomCaixa = random(120);
                if(RandomCaixa == 120) TipoCaixinha = 19057;
                else if(RandomCaixa >= 45 && RandomCaixa <= 79) TipoCaixinha = 19055;
                else if(RandomCaixa >= 95 && RandomCaixa <= 98) TipoCaixinha = 19056;
                else TipoCaixinha = 19054;
                if(TipoCaixinha == 19054) format(str1, sizeof(str1), "{a0522d}Bronze");
                if(TipoCaixinha == 19055) format(str1, sizeof(str1), "{a4a4a4}Prata");
                if(TipoCaixinha == 19056) format(str1, sizeof(str1), "{FFFF00}Ouro");
                if(TipoCaixinha == 19057) format(str1, sizeof(str1), "{FFFF00}Platina");
            }
            else if(CaixaPla == false)
            {
                new RandomCaixa = random(120);
                if(RandomCaixa == 120) TipoCaixinha = 19057;
                else if(RandomCaixa >= 45 && RandomCaixa <= 79) TipoCaixinha = 19055;
                else if(RandomCaixa >= 95 && RandomCaixa <= 98) TipoCaixinha = 19056;
                else TipoCaixinha = 19054;
                if(TipoCaixinha == 19054) format(str1, sizeof(str1), "{a0522d}Bronze");
                if(TipoCaixinha == 19055) format(str1, sizeof(str1), "{a4a4a4}Prata");
                if(TipoCaixinha == 19056) format(str1, sizeof(str1), "{FFFF00}Ouro");
            }
            for(new i=0; i<75; i++)
            {
                if(InventarioInfo[playerid][i][iSlot] == 19382)
                {
                    InventarioInfo[playerid][i][iSlot] = TipoCaixinha;
                    InventarioInfo[playerid][i][iUnidades] = 1;
                    PlayerInfo[playerid][pCaixinha] = char;
                    format(string, sizeof(string), "[Caixa Supresa]: {FFFFFF}%s pegou um Presente %s.{FFFFFF} (/infocaixa)",PlayerName(playerid), str1);
                    SendClientMessageToAll(COR_TITULO,string);
                    SendClientMessage(playerid, COR_BRANCO, "Para pegar seu presente abra seu inventario pressionando ( {ff3399}N {FFFFFF}). Para informacoes das caixas digite: /infocaixa.");
                    break;
                }
            }
        }
        return 1;
    }
