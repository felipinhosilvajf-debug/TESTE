stock IdDoItem(ArmaID)
{
    switch(ArmaID)
    {
        case 331: ArmaID = 1;
        case 333: ArmaID = 2;
        case 334: ArmaID = 3;
        case 335: ArmaID = 4;
        case 336: ArmaID = 5;
        case 337: ArmaID = 6;
        case 338: ArmaID = 7;
        case 339: ArmaID = 8;
