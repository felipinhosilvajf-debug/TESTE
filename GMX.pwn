START::DCandidatoInfoOrg(nome[], numero)
{
    new arquivo[85];
    format(arquivo, sizeof(arquivo), Pasta_Candidatos,numero);
    if(strcmp(nome,InfoCandtiados[numero][Candidato1],true)==0)
    {
        strmid(InfoCandtiados[numero][Candidato1], "Ninguem", 0, strlen("Ninguem"), MAX_PLAYER_NAME);
        DOF2_SetString(arquivo,"Candidato1","Ninguem");
        DOF2_SaveFile();
        return true;
    }
    if(strcmp(nome,InfoCandtiados[numero][Candidato2],true)==0)
    {
        strmid(InfoCandtiados[numero][Candidato2], "Ninguem", 0, strlen("Ninguem"), MAX_PLAYER_NAME);
        DOF2_SetString(arquivo,"Candidato2","Ninguem");
        DOF2_SaveFile();
        return true;
    }
    if(strcmp(nome,InfoCandtiados[numero][Candidato3],true)==0)
    {
        strmid(InfoCandtiados[numero][Candidato3], "Ninguem", 0, strlen("Ninguem"), MAX_PLAYER_NAME);
        DOF2_SetString(arquivo,"Candidato3","Ninguem");
        DOF2_SaveFile();
