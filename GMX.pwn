                    format(arquivo, sizeof(arquivo), Pasta_ORGVIP, PlayerInfo[playerid][pMembro]);
                    if(DOF2_FileExists(arquivo))
                    {

                        if(DOF2_GetInt(arquivo, "Tipo") == 3)
                        {

                            if(strcmp(PlayerNick,InfoOrg[org][Membro31],true)==0)
                            {

                                pCheckInfoOrg[playerid] = 0;
                                return 1;
                            }
                            if(strcmp(PlayerNick,InfoOrg[org][Membro32],true)==0)
