    CMD:advogados(playerid, params[])
    {
        if(IsPlayerConnected(sscanfid))
        {
            SendClientMessage(playerid, COR_VERDE, "Advogados Online:");
            foreach(new i: Player)
            {
                if(IsPlayerConnected(i))
                {
                    if(PlayerInfo[i][pEmprego] == 2)
                    {
                        new cel = PlayerInfo[i][pPnumber];
                        new level = PlayerInfo[i][pLawSkill];
                        GetPlayerName(i,sendername,sizeof(sendername));
                        if(level >= 0 && level <= 50)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "%s: ID[%d] - Cel[%d] - Hab[Um]",sendername,i,cel);
                            SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                        }
                        if(level >= 51 && level <= 100)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "%s: ID[%d] - Cel[%d] - Hab[Dois]",sendername,i,cel);
                            SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                        }
                        if(level >= 101 && level <= 200)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "%s: ID[%d] - Cel[%d] - Hab[Tres]",sendername,i,cel);
                            SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                        }
                        if(level >= 201 && level <= 300)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "%s: ID[%d] - Cel[%d] - Hab[Quatro]",sendername,i,cel);
                            SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                        }
                        if(level >= 301)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "%s: ID[%d] - Cel[%d] - Hab[Cinco]",sendername,i,cel);
                            SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                        }
                    }
                }
            }
        }
        return true;
    }
    CMD:socios(playerid, params[])
    {
        new str[126], strDialog[4000], Cont = 0, Nome[MAX_PLAYER_NAME];
        format(str, sizeof(str), "ID\tNome\tTempo\tTipo\n");
        strcat(strDialog, str);
        foreach(new i: Player)
        {
            if(IsPlayerConnected(i) == 1 && PlayerInfo[i][pSocio] > 0 && PlayerInfo[i][pSocio] < 4)
            {
                new lolz[35];
                if(PlayerInfo[i][pSocio] == 1)lolz = "SoCIO-COMUM";
                if(PlayerInfo[i][pSocio] == 2)lolz = "{EEEE00}SoCIO-PREMIUM{FFFFFF}";
                if(PlayerInfo[i][pSocio] == 3)lolz = "{FFFF00}SoCIO-DIAMANTE{FFFFFF}";
                GetPlayerName(i, Nome, MAX_PLAYER_NAME);
                if(PlayerInfo[i][pSocio] != 0)
                {
                    format (str, sizeof str, "%d\t%s\t%d Dias\t%s\n", i, Nome, PlayerInfo[i][pDiaVIP], lolz);
                    Cont++;
                }
                strcat(strDialog, str);
            }
        }
        new titulo[35];
        format(titulo, sizeof(titulo), "Socios Onlines ({00d900}%d{ffffff})",Cont);
        if (Cont == 0)
        {
            ShowPlayerDialog(playerid, 259+3, DIALOG_STYLE_TABLIST_HEADERS, "Socios","{f60000}Nenhum socio online\n\n{FFFFFF}Para ver somente os VIPs\n Digite /vips.\n Obs: Podem haver administradores invisiveis.","OK", "");
        }
        else
        {
            ShowPlayerDialog(playerid, 9992, DIALOG_STYLE_TABLIST_HEADERS, titulo, strDialog, "Enviar SMS", "Cancelar");
        }
        return 1;
    }
    CMD:blindarposto(playerid, params[])
    {
        new vehicleid = GetPlayerVehicleID(playerid);// modeloo = GetVehicleModel(vehicleid);
        new vid = GetPlayerVehicleID(playerid);
        new Float:vida;
        GetVehicleHealth(vehicleid, vida);
        if(WantedLevel[playerid] != 0)
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce esta procurado pela policia, nao pode blindar !");
            return 1;
        }
        if(vida < 700.0)
        {
            SendClientMessage(playerid, 0x228B22FF, "A Lataria do seu veiculo deve estar acima de 70 para poder blindar !");
            return 1;
        }
        if(Vuln[vid] >= 50)
        {
            SendClientMessage(playerid, 0x228B22FF, "A blindagem do seu veiculo deve estar abaixo da metade para poder blindar !");
            return 1;
        }
        // switch(modeloo)
        //{
            //    case 522, 581, 586, 521, 468, 463, 461, 462, 448: return SendClientMessage(playerid, COR_VERMELHO, "{228B22}Voce nao pode blindar este tipo de veiculo!");
        // }
        if(PlayerToPoint(10.0,playerid,2495.9846,-1460.4069,24.0212) || PlayerToPoint(10.0,playerid,998.1703,2137.3923,10.8203))
        {
            ShowPlayerDialog(playerid, 47, DIALOG_STYLE_MSGBOX, "Blindagem de Veiculos", "Voce deseja blindar o seu veiculo?\n\nObs: A blindagem dura ate o carro explodir!\n\nPreco = R$3.000", "Blindar", "Cancelar");
        }
        else
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao esta na oficina de blindagem !");
            return true;
        }
        return 1;
    }
