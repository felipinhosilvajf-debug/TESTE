         SendClientMessageToAll(GetPlayerColor(playerid), string);
         KillTimer(tempoexplodir[playerid]);
         SetTimerEx("VoltarPortas", 40000, 0, "i", playerid);
    }
    if(dinamitounavio[playerid] == 1)
    {
