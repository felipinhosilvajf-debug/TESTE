    CMD:membros(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new countmembros = 0;
            if(GetPlayerOrg(playerid) < 1)
            {
                return SendClientMessage(playerid,COR_GRAD1,"Voce nao e Membro de nenhuma Equipe!");
            }
            new titulo[800];
            format(titulo, sizeof(titulo), "Membros Online: {00FFFF}(%d)", countmembros);
            foreach(new i: Player)
            {
                if(GetPlayerOrg(i) == GetPlayerOrg(playerid) && IsPlayerConnected(i))
                {
                    if(PlayerInfo[i][pLider] == GetPlayerOrg(playerid))
                    {
                        format(stringZCMD, sizeof stringZCMD, "%s(%d), Cargo: [LIDER]", PlayerName(i), i);
                        countmembros ++;
                    }
                    else if(DeslogandoSocio[i] == 1)
                    {
                        format(stringZCMD,sizeof(stringZCMD),"[Socio] %s(%d), Cargo: [%d].",PlayerName(i), i, PlayerInfo[i][pCargo]);
                        countmembros ++;
                    }
                    else
                    {
                        format(stringZCMD, sizeof stringZCMD, "%s(%d), Cargo: [%d].", PlayerName(i), i, PlayerInfo[i][pCargo]);
                        countmembros ++;
                    }
                }
            }
            ShowPlayerDialog(playerid, 4875, DIALOG_STYLE_LIST, titulo, stringZCMD, "Informado", "");
        }
        return 1;
    }
