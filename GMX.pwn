    CMD:passarnivel(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if (gPlayerLogged[playerid] != 0)
            {
                PlayerInfo[playerid][pDinheiro] = GetPlayerMoneyEx(playerid);
                if(PlayerInfo[playerid][pLevel] >= 0)
                {
                    new nxtlevel = PlayerInfo[playerid][pLevel]+1;
                    new expquantidade = nxtlevel*levelexp;
                    if (PlayerInfo[playerid][pExp] < expquantidade)
                    {
                        format(gstring, 128, "Voce precisa de %d pontos de respeito, Voce tem: [%d] !",expquantidade,PlayerInfo[playerid][pExp]);
                        SendClientMessage(playerid, COR_GRAD1, gstring);
                        return 1;
                    }
                    else
                    {
                        new RandomRespeitos;// = 1 + random(PlayerInfo[playerid][pLevel]);
                        PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                        PlayerPlayMusic(playerid);
                        PlayerInfo[playerid][pLevel]++;
                        ScoreLevel(playerid);
                        PlayerInfo[playerid][pExp] -= expquantidade;
                        PlayerInfo[playerid][pExp] += RandomRespeitos;
                        new rp;
                        rp = expquantidade;
                        format(gstring, sizeof(gstring), "{ffffff}Voce atingiu os respeitos necessario para passar de nivel!\n\n{ffff00}Informacoes:\n{ffffff}Nivel adquirido: {df5454}%d\n{ffffff}Respeitos Requerido: {df5454}%d\n{ffffff}Respeito(s) atual: {df5454}%d\n{ffffff}Bonus: {df5454}+{ffffff}RP{6ea0ff}%d", PlayerInfo[playerid][pLevel], rp, PlayerInfo[playerid][pExp], RandomRespeitos);
                        strcat(MEGAString,gstring);
                        ShowPlayerDialog(playerid,999,DIALOG_STYLE_MSGBOX, "{ffffff}Upagem De Level", MEGAString, "Informado", "");
                    }
                }
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta logado !");
            }
        }
        return 1;
    }
    CMD:comprararma(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(GetPlayerMoneyEx(playerid) < 1)
            {
                SendClientMessage(playerid, COR_GREY, "   Voce nao tem todo esse dinheiro estrupicio!");
                return 1;
            }
            new gun;
            new gunid[16];
            new gunstring1[256];
            new gunstring2[256];
            new gunstring3[256];
            new infostring[256];
            new guncharge;
            new ammocharge;
            new location = LocalAtual[playerid];
            new ammo;
            if(PlayerInfo[playerid][pConnectTime] <  2)
            {
                SendClientMessage(playerid, COR_GREY, "e preciso ter 2+ horas jogadas para poder comprar armas !");
                return 1;
            }
            if(IsPlayerConnected(playerid))
            {
                new mod = 100;
                if(sscanf(params, "s[25]d", gunid, ammo))
                {
                    SendClientMessage(playerid, COR_GREEN,"_______________________________________");
                    SendClientMessage(playerid, COR_BRANCO,"*** Armas ***");
                    format(stringZCMD, sizeof(stringZCMD), "{df5454}Ã—{ffffff} USE: /comprararma [nomedaarma] [quantidade] - Obs: O preco e por bala de cada arma !");
                    SendClientMessage(playerid, COR_GREEN, stringZCMD);
                    SendClientMessage(playerid, COR_GRAD2,stringZCMD);
                    format(gunstring1, 256, "Armas: parachute (R$[%d]) golfclub (R$[%d]) nightstick (R$[%d]) baseballbat (R$[%d]) shovel (R$[%d]) poolcue (R$[%d])",
                    GunPrice[0][0]/100*mod,GunPrice[1][0]/100*mod,GunPrice[2][0]/100*mod,GunPrice[3][0]/100*mod,GunPrice[4][0]/100*mod,GunPrice[5][0]/100*mod,GunPrice[6][0]/100*mod);
                    SendClientMessage(playerid, COR_GRAD3, gunstring1);
                    format(gunstring2, 256, "Armas: purpledildo (R$[%d]) whitedildo (R$[%d]) longwhitedildo (R$[%d]) whitedildo2 (R$[%d]) flowers (R$[%d]) cane",
                    GunPrice[7][0]/100*mod,GunPrice[8][0]/100*mod,GunPrice[9][0]/100*mod,GunPrice[10][0]/100*mod,GunPrice[11][0]/100*mod,GunPrice[12][0]/100*mod);
                    SendClientMessage(playerid, COR_GRAD3, gunstring2);
                    format(gunstring3, 256, "Armas: eagle (R$[%d]) pistolas (R$[%d]) mp5 (R$[%d]) shotgun (R$[%d]) ak47 (R$[%d]) m4 (R$[%d]) rifle (R$[%d])",
                    GunPrice[13][0]/100*mod,GunPrice[14][0]/100*mod,GunPrice[15][0]/100*mod,GunPrice[16][0]/100*mod,GunPrice[17][0]/100*mod,GunPrice[18][0]/100*mod,GunPrice[19][0]/100*mod,GunPrice[20][0]/100*mod,GunPrice[21][0]/100*mod,GunPrice[22][0]/100*mod,GunPrice[23][0]/100*mod,GunPrice[24][0]/100*mod);
                    SendClientMessage(playerid, COR_GRAD3, gunstring3);
                    SendClientMessage(playerid, COR_GREEN,"_______________________________________");
                    return 1;
                }
                if(ammo < 1 || ammo > 999) { SendClientMessage(playerid, COR_GREY, "Balas tem que ser entre 1 e 999 !"); return 1; }
                if (strcmp(gunid, "parachute", true, strlen(gunid)) == 0)
                {
                    gun = 46;
                    guncharge = GunPrice[0][0]/100*mod;
                    ammocharge = 0;
                }
                else if (strcmp(gunid, "golfclub", true, strlen(gunid)) == 0)
                {
                    gun = 2; guncharge = GunPrice[1][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "nightstick", true, strlen(gunid)) == 0)
                {
                    gun = 3; guncharge = GunPrice[2][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "baseballbat", true, strlen(gunid)) == 0)
                {
                    gun = 5; guncharge = GunPrice[4][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "shovel", true, strlen(gunid)) == 0)
                {
                    gun = 6; guncharge = GunPrice[5][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "poolcue", true, strlen(gunid)) == 0)
                {
                    gun = 7; guncharge = GunPrice[6][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "purpledildo", true, strlen(gunid)) == 0)
                {
                    gun = 10; guncharge = GunPrice[7][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "whitedildo", true, strlen(gunid)) == 0)
                {
                    gun = 11; guncharge = GunPrice[8][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "longwhitedildo", true, strlen(gunid)) == 0)
                {
                    gun = 12; guncharge = GunPrice[9][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "whitedildo2", true, strlen(gunid)) == 0)
                {
                    gun = 13; guncharge = GunPrice[10][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "flowers", true, strlen(gunid)) == 0)
                {
                    gun = 14; guncharge = GunPrice[11][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "cane", true, strlen(gunid)) == 0)
                {
                    gun = 15; guncharge = GunPrice[12][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "eagle", true, strlen(gunid)) == 0)
                {
                    gun = 24; guncharge = GunPrice[15][0]/100*mod; ammocharge = GunPrice[25][0]*ammo;
                }
                else if (strcmp(gunid, "mp5", true, strlen(gunid)) == 0)
                {
                    gun = 29; guncharge = GunPrice[18][0]/100*mod; ammocharge = GunPrice[27][0]*ammo;
                }
                else if (strcmp(gunid, "shotgun", true, strlen(gunid)) == 0)
                {
                    gun = 25; guncharge = GunPrice[19][0]/100*mod; ammocharge = GunPrice[26][0]*ammo;
                }
                else if (strcmp(gunid, "ak47", true, strlen(gunid)) == 0)
                {
                    gun = 30; guncharge = GunPrice[22][0]/100*mod; ammocharge = GunPrice[28][0]*ammo;
                }
                else if (strcmp(gunid, "m4", true, strlen(gunid)) == 0)
                {
                    gun = 31; guncharge = GunPrice[23][0]/100*mod; ammocharge = GunPrice[28][0]*ammo;
                }
                else if (strcmp(gunid, "rifle", true, strlen(gunid)) == 0)
                {
                    gun = 33; guncharge = GunPrice[24][0]/100*mod; ammocharge = GunPrice[29][0]*ammo;
                }
                else if (strcmp(gunid, "eagle", true, strlen(gunid)) == 0)
                {
                    gun = 24; guncharge = GunPrice[15][0]/100*mod; ammocharge = 0;
                }
                else if (strcmp(gunid, "camera", true, strlen(gunid)) == 0)
                {
                    gun = 43; guncharge = GunPrice[11][0]/100*mod; ammocharge = 0;
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD6, "Traficante: Nunca ouvi falar dessa arma.");
                    return 1;
                }
                if((guncharge+ammocharge) > GetPlayerMoneyEx(playerid))
                {
                    format(infostring, 256, "   Voce nao tem R$%d !",guncharge+ammocharge);
                    SendClientMessage(playerid, COR_GRAD3, infostring);
                    return 1;
                }
                if(GetPlayerMoneyEx(playerid) < (guncharge+ammocharge))
                {
                    SendClientMessage(playerid, COR_GREY, "   nao pode se permitir isso !");
                    return 1;
                }
                new payout = guncharge + ammocharge;
                if(location == 102 && IsACop(playerid)) { }
                else { GivePlayerMoneyEx(playerid, - payout); }
                BizzInfo[6][bTill] += payout;
                ExtortionBiz(6, payout);
                BizzInfo[0][bTill] += payout;
                ExtortionBiz(0, 2000);
                BizzInfo[1][bTill] += payout;
                ExtortionBiz(1, payout);
                new Conta = CofreOrg[7][Dinheiro] + payout;
                DepositarGranaOrg(7, Conta);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                if(formadinheiro[playerid] == 1)
                {
                    GivePlayerWeaponEx(playerid, gun, ammo);
                    format(gstring, 128, "Voce comprou um(a) %s com %d bala(s) por R$[%d] com seu dinheiro.",gunid,ammo,payout);
                    SendClientMessage(playerid, COR_GRAD1, gstring);
                }
                else if(formacartao[playerid] == 1)
                {
                    PlayerInfo[playerid][pConta] -= ammo;
                    PlayerInfo[playerid][pConta] -= gun;
                    format(gstring, 128, "Voce comprou um(a) %s com %d bala(s) por R$[%d] com seu cartao de debito.",gunid,ammo,payout);
                    SendClientMessage(playerid, COR_GRAD1, gstring);
                }
                formacartao[playerid] = 0;
                formadinheiro[playerid] = 0;
                GivePlayerWeaponEx(playerid, gun, ammo);
                GetPlayerName(playerid, sendername, sizeof(sendername));
                format(stringZCMD, sizeof(stringZCMD), "%s comprou armas por R$%d na empresa %d", sendername, payout, location-99);
                printf("%s", stringZCMD);
                GranaLog(stringZCMD);
            }
            else
            {
                SendClientMessage(playerid, COR_BRANCO,"Sem Equipamento de Venda.");
                return 1;
            }
        }
        return 1;
    }
    CMD:registrar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(gPlayerLogged[playerid] == 1)
            {
                SendClientMessage(playerid, COR_GREY, "ERRO: Voce ja e registrado!");
                SetPlayerPos(playerid, 1153.4733,-1771.0773,16.5992);
                return 1;
            }
//          new loginstring[255];
            GetPlayerName(playerid, sendername, sizeof(sendername));
            new Query[64];
            format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(sendername));
            Resultado = db_query(Conexao,Query);
            if(ModoSavSis == true)
            {
                if(db_num_rows(Resultado) > 0)
                {
                    SendClientMessage(playerid, 0xFF0000FF, "[VBR]: Este Nick ja existe, use outro por favor.");
                    //format(loginstring,sizeof(loginstring),"{FC0000}Voce nao e registrado\n\n{FFFFFF}Ola {07C3F7}%s,\n {FFFFFF}Voce nao esta cadastrado em nosso servidor.\n\n{FFFFFF}Cadastre-se agora, e venha se divertir!\n\nVisite nosso site: {00F200}{df5454}https://discord.gg/9QP6UnS6xd", PlayerName(playerid));
                    //ShowPlayerDialog(playerid, 2, DIALOG_STYLE_PASSWORD,"nao Registrado",loginstring,"Registrar","Ajuda");
                    //SetPlayerPos(playerid, 1153.4733,-1771.0773,16.5992);
                    return 1;
                }
            }
            else if(ModoSavSis == false)
            {
                if(gPlayerAccount[playerid] == 1)
                {
                    new DOF2[128];
                    format(DOF2, sizeof DOF2, Pasta_Contas2, PlayerName(playerid))
                    if(DOF2_FileExists(DOF2))
                    {
                        SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce foi kickado por ja ter uma conta registrada...");
                        SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}INFO: {ffffff}Voce pode resolver isso mudando o seu nick.");
                        Kick(playerid);
                    }
                }
            }
            new tmppass;
            if(sscanf(params, "d", tmppass))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /registrar [Senha]");
                SendClientMessage(playerid, COR_START, "{df5454}ALERTA: {ffffff}Use somente numeros.");
                new loginstring[300];
                new loginname[64];
                GetPlayerName(playerid,loginname,sizeof(loginname));
                format(loginstring,sizeof(loginstring),"{ffffff}Bem Vindo ao Servidor: {df5454}%s{ffffff}!\n\n{818689}Este Nick nao esta registrado, para registrar\ninsira abaixo uma senha com 3 a 16 digitos\nuse somente numeros.\n\n{fa4c4c}OBS: {ffffff}Certifique-se de que Voce nao vai esquecer!\n\n{818689}Insira uma senha Abaixo:",loginname);
                ShowPlayerDialog(playerid, 2, DIALOG_STYLE_PASSWORD,"{ffffff}{ffffff}Virtual {aaacae}Boost{ffffff} {ffffff}- Registro",loginstring,"Registrar","Ajuda");
                return 1;
            }
            SetPlayerPos(playerid, 1153.4733,-1771.0773,16.5992);
            OnPlayerRegister(playerid,tmppass);
            gPlayerAccount[playerid] = 1;
            PlayerInfo[playerid][pSenha] = tmppass;
            new DOF2[500];
            format(DOF2, sizeof(DOF2), "Players/%s.ini", PlayerName(playerid));
            DOF2_CreateFile(DOF2);
            DOF2_SetInt(DOF2, "Senha", PlayerInfo[playerid][pSenha]);
            DOF2_SetInt(DOF2, "Registrado", gPlayerAccount[playerid]);
        }
        return 1;
    }


    CMD:mudarsenha(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new tmppass;
            if(gPlayerLogged[playerid] == 0)
            {
                SendClientMessage(playerid,COR_GRAD1,"Voce nao esta logado !");
                return 1;
            }
            if(MudarSenhaAceito[playerid] == 0)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado!");
                return 1;
            }
            GetPlayerName(playerid,sendername,sizeof(sendername));
            if(sscanf(params, "d", tmppass))
            {
                SendClientMessage(playerid,COR_OBS,"ERRO, USE: {aaacae}/mudarsenha [Nova Senha](Somente Numeros)");
                SendClientMessage(playerid,COR_OBS,"OBS: {ffffff}Guarde a senha ou tire SS da tela apertando F8 para nao esquecer!");
                return 1;
            }
            if(tmppass <= 4 && tmppass >= 16)
            {
                return SendClientMessage(playerid, COR_OBS, "[ERRO]: {ffffff}A sua senha deve ter entre 4 e 16 digitos!");
            }
            format(stringZCMD, sizeof(stringZCMD), "[Mudanca de Senha]: {ffffff}A sua nova senha agora e: [{FF6347}%d{ffffff}], cuidado para nao perde-la.", tmppass);
            SendClientMessage(playerid, COR_OBS, stringZCMD);
            PlayerInfo[playerid][pSenha] = tmppass;
            PlayerInfo[playerid][pMudouSenha] = 1;
            OnPlayerSave(playerid);
            return 1;
        }
        return 1;
    }
    CMD:an(playerid, result[])
    {
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_GRAY,"Voce esta preso,so pode anunciar pedindo um Advogado!");
                return 1;
            }
            if(isnull(result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/anl) [texto]");
                return true;
            }
            if (panuncio == 1)
            {
                SendClientMessage(playerid, COR_GRAD2, "Espere 30 segundos para poder anunciar novamente!");
                return 1;
            }
            if (strlen(result) > 50) return SendClientMessage(playerid, 0xFFFFFFAA, "Limite de caracteres atingido [MaXIMO 50]!");
            GetPlayerName(playerid, sendername, MAX_PLAYER_NAME);
            GivePlayerMoneyEx(playerid, -150);
            SBizzInfo[7][sbTill] += 150;
            ExtortionSBiz(7, 150);
            GameTextForPlayer(playerid, "~r~-R$150", 5000, 5);
            format(stringZCMD, sizeof(stringZCMD), "{33FF00}[ANuNCIO]: {ffffff} %s, {00ff00}%s - Celular:[%d] ID:[%d]", result, sendername, PlayerInfo[playerid][pPnumber], playerid);
            SendClientMessageToAll(0x33FF00FF, stringZCMD);
            print(stringZCMD);
            panuncio = 1;
            TempoAn = SetTimer("Anuncio", 15000, 0);
            return 1;
    }
    CMD:anunciop(playerid, params[])  return ForT:anp(playerid, params);
    CMD:anp(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(AnuncioSis == true)
            {
                if(mudandodp[playerid] == 1)
                {
                    SendClientMessage(playerid, COR_GRAD1, "Voce esta mudando de departamento, nao pode utilizar este comando!");
                    return 1;
                }
                if(PlayerInfo[playerid][pConnectTime] <  1)
                {
                    SendClientMessage(playerid,COR_GREY,"e preciso ter  1+ horas jogada para mandar anuncios !");
                    return 1;
                }
                ShowPlayerDialog(playerid, 119,DIALOG_STYLE_LIST,"Menu De Anuncios","Anunciar Venda de Drogas\nAnunciar Venda de Armas\nAnunciar Servico Seguranca\nAnunciar Servico Advogado\nProcuro ORG/GANG/MAFIA\nPreciso de Um Taxi/onibus\nPreciso de Um Advogado\nPreciso de Um Policial\nPreciso de Um Medico/Medico\nPreciso de Um Mecanico\nPreciso de Um Seguranca\nCompro Uma Casa\nVendo uma Casa\nCompro Moedas\nVendo Moedas\nCompro itens\nVendo Itens","Confirmar", "Cancelar");
            }
        }
        else if(AnuncioSis == false)
        {
            SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O /anl e /anp esta bloqueado no {df5454}/menusistema{ffffff}.");
        }
        return 1;
    }
