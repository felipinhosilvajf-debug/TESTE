        return 1;
    }
    CMD:so(playerid, params[])  return ForT:socio(playerid, params);
    CMD:socio(playerid, result[])
    {
        if(IsPlayerConnected(playerid) && PlayerInfo[playerid][pSocio] >= 1)
        {
            if(ChatsSis == true)
            {
                if(PlayerInfo[playerid][pChatSocioDesativado] == 0)
                {
                    GetPlayerName(playerid, sendername, sizeof(sendername));
                    if(isnull(result))
                        return SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /so [Chat Socio]");
                    if(GetTickCount() - TempoChatSocio[playerid] < 3000 && PlayerInfo[playerid][pAdmin] == 0)
                    {
                        SendClientMessage(playerid,COR_GRAD1,"Voce so pode escrever uma mensagem a cada 3 segundos.");
                        return 1;
                    }
                    if(PlayerMutado[playerid] == 1)
                    {
                        SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao poder falar, Voce foi calado");
                        return 1;
                    }
                    if(Palavrao(result))
                    {
                        GivePlayerMoneyEx(playerid, -500);
                        SendClientMessage(playerid, COR_LIGHTRED, "e PROIBIDO CHINGAR NO CHAT SoCIO,Voce PERDEU 500 REAIS !");
                        return 1;
                    }
                    if (PlayerInfo[playerid][pSocio] >= 1)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "** Socio %s: %s", sendername, result);
                        SendSocioMessage(COR_VIP, stringZCMD);
                        foreach(new i: Player)
                        {
                            if(IsPlayerConnected(i))
                            {
                                if(PlayerInfo[i][pVIP] == 0 && PlayerInfo[playerid][pSocio] == 0)
                                {
                                    SendClientMessage(i, COR_START,stringZCMD);
                                }
                            }
                        }
                        ChatSocioLog(stringZCMD);
                        TempoChatSocio[playerid] = GetTickCount();
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "O Chat Socio esta desativado !");
                    return 1;
                }
            }
        }
        return 1;
    }
    CMD:pagar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(sscanf(params, "ud", sscanfid, moneysZCMD))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /pagar [id] [quantidade]");
                return 1;
            }
            if(AdminTrabalhando[sscanfid] != 0 && PlayerInfo[sscanfid][pAdmin] >= 1)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao pode pagar para admins em trabalho!");
                return 1;
            }
            if(moneysZCMD > 1000 && PlayerInfo[playerid][pLevel] < 3)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce precisa ser level 3+ para pagar mais que R$ 1000 !");
                return 1;
            }
            if(moneysZCMD > 1000 && PlayerInfo[playerid][pLevel] < 3)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce precisa ser level 2+ para pagar mais de R$1000 !");
                return 1;
            }
            if(moneysZCMD > 4000 && PlayerInfo[playerid][pLevel] < 4)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce precisa ser level 4+ para pagar mais de R$4000 !");
                return 1;
            }
            if(moneysZCMD > 5000 && PlayerInfo[playerid][pVIP] == 0)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce precisa ser vip para pagar mais de 5000(digite:/vip)");
                return 1;
            }
            if(moneysZCMD < 1 || moneysZCMD > 10000)
            {
                SendClientMessage(playerid, COR_GRAD1, "Minimo R$1 - Maximo R$10000.");
                return 1;
            }
            if (IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(LocalAtual[sscanfid] == 106)
                    {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando neste local !");
                        return 1;
                    }
                    if (ProxDetectorS(5.0, playerid, sscanfid))
                    {
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        playerdinheiroZCMD = GetPlayerMoneyEx(playerid);
                        if (playerdinheiroZCMD >= moneysZCMD)
                        {
                            ConsumingMoney[sscanfid] = 1;
                            GivePlayerMoneyEx(playerid, (0 - moneysZCMD));
                            GivePlayerMoneyEx(sscanfid, moneysZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Voce pagou %s(Para: %d), R$%d.", giveplayerZCMD,sscanfid, moneysZCMD);
                            PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                            SendClientMessage(playerid, COR_GRAD1, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Voce recebeu R$%d de %s(ID: %d).", moneysZCMD, sendername, playerid);
                            SendClientMessage(sscanfid, COR_GRAD1, stringZCMD);
                            PlayerPlaySound(sscanfid, 1052, 0.0, 0.0, 0.0);
                            format(stringZCMD, sizeof(stringZCMD), "* %s deu alguma grana para %s.", sendername ,giveplayerZCMD);
                            ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                            GranaLog(stringZCMD);
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_GRAD1, "Voce nao esta com essa grana no bolso.");
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GRAD1, "O jogador esta longe.");
                    }
                }//invalid id
            }
            else
            {
                format(stringZCMD, sizeof(stringZCMD), "%d nao e um jogador ativo.", sscanfid);
                SendClientMessage(playerid, COR_GRAD1, stringZCMD);
            }
        }
        return 1;
    }
    CMD:caridade(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(sscanf(params, "d", moneysZCMD))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /caridade [quantidade]");
                return 1;
            }
            if(LocalAtual[playerid] == 106)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando neste local");
                return 1;
            }
            if(moneysZCMD < 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Minimo R$ 1");
                return 1;
            }
            if(GetPlayerMoneyEx(playerid) < moneysZCMD)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta com essa grana no bolso.");
                return 1;
            }
            GivePlayerMoneyEx(playerid, -moneysZCMD);
            GetPlayerName(playerid, sendername, sizeof(sendername));
            format(stringZCMD, sizeof(stringZCMD), "%s obrigado pela sua doacao de R$[%d].",sendername, moneysZCMD);
            Tax += moneysZCMD;
            PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
            SendClientMessage(playerid, COR_GRAD1, stringZCMD);
        }
        return 1;
    }

