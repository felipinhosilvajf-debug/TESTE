    CMD:batercartaodetran(playerid, params[])
    {
        if(PlayerInfo[playerid][pJailed] != 0)
        {
            SendClientMessage(playerid,COR_AMARELO," Voce nao pode bater cartao na cadeia!");
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
                GetPlayerName(playerid, sendername, sizeof(sendername));
                if(PlayerToPoint(3, playerid, 2478.2737,-1528.6306,24.0741))
                {
                    if(GetPlayerOrg(playerid) != 0)
                    {
                            if (PlayerInfo[playerid][pMembro] == 14 || PlayerInfo[playerid][pLider] == 14)
                            {
                                if(PlayerInfo[playerid][pCargo] >= 2)
                                {
                                    if(CartaoBatidoDetran[playerid] == false)
                                    {
                                        SendClientMessage(playerid, COR_OBS, "[DETRAN]: {ffffff}Agora Voce esta com o cartao batido!");
                                        SendClientMessage(playerid, COR_OBS, "[DETRAN]: {ffffff}Sgora Voce pode ir trabalhar reparando, blindando, abastecendo veiculos e etc...");
                                        CartaoBatidoDetran[playerid] = true;
                                        SetPlayerColor(playerid, COR_OBS);
                                        ShowPlayerDialog(playerid, 12522, DIALOG_STYLE_LIST, "Modo de Trabalho", "Modo Rocam(Abordar e etc)\nModo Mecanico(Reparar, Blindar e etc)", "Selecionar", "");
                                    }
                                    else if(CartaoBatidoDetran[playerid] == true)
                                    {
                                        SendClientMessage(playerid, COR_OBS, "[DETRAN]: {ffffff}Agora Voce nao esta mais com o cartao batido!");
                                        CartaoBatidoDetran[playerid] = false;
                                        if(ModoTrabalhoDetran[playerid] == 2)
                                        {
                                            Mechanics -= 1;
                                        }
                                        ModoTrabalhoDetran[playerid] = 0;
                                    }
                                }
                            }
                    }
                }
        }
        return 1;
    }

