public OnPlayerUpdate(playerid)
{
    new string[190];
    if(IsPlayerConnected(playerid) && gPlayerLogged[playerid])
    {
        new cashstr[128];
        //new nickcasa[500];
        format(cashstr,sizeof(cashstr),"Moedas VIP: ~w~%s", ConvertMoney(PlayerInfo[playerid][pCoins]));
        PlayerTextDrawSetString(playerid, TDCoins[playerid], cashstr);
        //format(nickcasa, sizeof(nickcasa), "~w~Dono: ~r~%s", PlayerName(playerid));
        //PlayerTextDrawSetString(playerid, TDEditor_PTD[playerid][16], nickcasa);
        //Tempo AFK
        TempoAFK[playerid] = gettime();
        if(TaNoQuarentena[playerid] == 1)
        {
            format(string,sizeof(string),"HUMANOS WIN %d", ContagemQuarentena[playerid]);
            TextDrawSetString(TextDrawCQ, string);
        }
        if(TanoWarZone[playerid] == 1)
        {
            // === [ TextDraw ] === //
            anime = GetPlayerAnimationIndex(playerid);
            //  printf("%d",anime);
            if ((anime== 1544) || (anime== 1250) ||  ((anime>=  1538) && (anime<= 1542)))
            {
                if(EquipeWarZone[playerid] == 1)
                {
                    SetPlayerSkin(playerid, skinsRed[random(7)]);
                    SetPlayerPos(playerid, -2520.7698,1215.6158,37.4283);
                }
                if(EquipeWarZone[playerid] == 2)
                {
                    SetPlayerSkin(playerid, skinsBlue[random(6)]);
                    SetPlayerPos(playerid, -2021.0950,-772.6932,30.1719);
                }
                if(EquipeWarZone[playerid] == 3)
                {
                    SetPlayerSkin(playerid, skinsGreen[random(7)]);
                    SetPlayerPos(playerid, -2405.7529,-601.1105,132.6484);
                }
            }

            if(ContagemRed > ContagemGreen && ContagemRed > ContagemBlue)
            {
                TextDrawBackgroundColor(TextDrawRED, COR_VERMELHO);
                TextDrawBackgroundColor(TextDrawBLUE, COR_VERMELHO);
                TextDrawBackgroundColor(TextDrawGREEN, COR_VERMELHO);

                TextDrawShowForPlayer(playerid, TextDrawGREEN);
                format(string,sizeof(string),"RED %d |", ContagemRed);
                TextDrawSetString(TextDrawGREEN, string);

                TextDrawShowForPlayer(playerid, TextDrawRED);
                format(string,sizeof(string),"BLUE %d |", ContagemBlue);
                TextDrawSetString(TextDrawRED, string);

                TextDrawShowForPlayer(playerid, TextDrawBLUE);
                format(string,sizeof(string),"GREEN %d", ContagemGreen);
                TextDrawSetString(TextDrawBLUE, string);

            }
            else if(ContagemGreen > ContagemBlue && ContagemGreen > ContagemRed)
            {
                TextDrawBackgroundColor(TextDrawRED, COR_GREEN);
                TextDrawBackgroundColor(TextDrawBLUE, COR_GREEN);
                TextDrawBackgroundColor(TextDrawGREEN, COR_GREEN);

                TextDrawShowForPlayer(playerid, TextDrawGREEN);
                format(string,sizeof(string),"GREEN %d |", ContagemGreen);
                TextDrawSetString(TextDrawGREEN, string);

                TextDrawShowForPlayer(playerid, TextDrawRED);
