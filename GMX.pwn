    CMD:creu(playerid, params[])
    {
        GetPlayerName(playerid, sendername, sizeof(sendername));
        format(stringZCMD, sizeof(stringZCMD), "* %s esta dancando o Creu VBR OwNeD ^^!.", sendername);
        ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
        ApplyAnimation(playerid,"CHOPPA","CHOPPA_back",4.1,1,1,1,1,1);
        SendClientMessage(playerid, COR_DBLUE, "eeee Creeeeeeu VBR OWNED ^^!");
        ComAnim[playerid] = true;
        return 1;
    }
    CMD:hd(playerid, params[])  return ForT:handsup(playerid, params);
    CMD:handsup(playerid, params[])
    {
        if(GetTickCount() - Tempohandsup[playerid] < 7000)
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce so pode usar este comando a cada 7 segundos.");
            return 1;
        }
        if(gPlayerInGuerra(playerid) || IsPlayerInSkate(playerid) || IsPlayerInPark(playerid) || IsPlayerInCasarao(playerid) || IsPlayerInMotel(playerid) || IsPlayerInMata(playerid) || IsPlayerInEstacao(playerid) || IsPlayerInChuck(playerid))
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando agora !");
            return 1;
        }
        if(IsPlayerInAnyVehicle(playerid))
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando dentro de um veiculo !");
            return 1;
        }
        if(Roubando[playerid] == 1)
        {
            SendClientMessage(playerid, -1, "Voce nao pode usar este comando estando roubando!");
        }
        new Float:Vida;
        new Float:Colete;
        GetPlayerArmour(playerid, Colete);
        GetPlayerHealth(playerid, Vida);
        format(stringZCMD, sizeof(stringZCMD), "* Suspeito %s digitou: /handsup com: Vida[%.0f] Colete[%.0f].", PlayerName(playerid), Vida, Colete);
        ProxDetector(30.0, playerid, stringZCMD, COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE);
        SendClientMessage(playerid, COR_GREY, "{818689}[HandSup]: {ffffff}Voce foi congelado por {818689}5{ffffff} segundos!");
        TogglePlayerControllable(playerid, 1);
        SetTimerEx("LiberarEnforcer", 5000, false, "i", playerid);
        SetPlayerSpecialAction(playerid, 10);
        ComAnim[playerid] = true;
        SeRendeu[playerid] = 1;
        return 1;
    }
    CMD:angry(playerid, params[])
    {
        ApplyAnimation(playerid,"RIOT","RIOT_ANGRY",4.0,0,0,0,0,0);
