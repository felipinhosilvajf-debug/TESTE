                if(strfind(inputtext,"%",true) != -1) return SendClientMessage(playerid, COR_VERMELHO, "Voce nao pode utilizar caracteres especiais.");
                if(!IsNumeric(inputtext)) return SendClientMessage(playerid,-1,"INFO: Apenas IDs dos objetos.");
                new obj = strval(inputtext);
                if(strlen(inputtext))
                {
