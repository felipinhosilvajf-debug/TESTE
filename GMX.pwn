    CMD:darprocurado(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1340)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao tem autorizacao para usar esse comando.");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new para1;
            new procura;
            if(sscanf(params, "ud", para1, procura))
            {
                SendClientMessage(playerid, COR_GREY, "/darprocurado [id] [nivel]");
                return 1;
            }
            if(IsPlayerConnected(para1))
            {
                if(para1 != INVALID_PLAYER_ID)
                {
                    WantedLevel[para1] += procura;
                    SetPlayerWantedLevelEx(para1, WantedLevel[para1]);
                    format(stringZCMD, sizeof(stringZCMD), "ADMCMD: %s colocou [%d] nivel de procurado em %s.",PlayerName(playerid), procura, PlayerName(para1));
                    ABroadCast(COR_LIGHTRED, stringZCMD,1);
                    format(stringZCMD, sizeof(stringZCMD), "Voce foi setado com [%d] nivel de procura pelo Administrador %s.", procura);
                    SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                }
            }
        }
        return 1;
    }
    CMD:retirarprocura(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] < 1340)
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao tem autorizacao para usar esse comando.");
            return 1;
        }
        if(AdminTrabalhando[playerid] < 1)
        {
            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
            return 1;
        }
        new para1;
        new rprocura;
        if(sscanf(params, "ud", para1, rprocura))
        {
            SendClientMessage(playerid, COR_GREY, "/retirarprocura [id] [quantia]");
            return 1;
        }
        if(WantedLevel[para1] == 0)
        {
            SendClientMessage(playerid, COR_GRAD1, "Este jogador nao esta procurado !");
            return 1;
        }
        if(IsPlayerConnected(para1))
        {
            if(para1 != INVALID_PLAYER_ID)
            {
                WantedLevel[para1] -= rprocura;
                SetPlayerWantedLevelEx(para1, WantedLevel[para1]);
                if(WantedLevel[para1] > 0)
                {
                    format(stringZCMD, sizeof(stringZCMD), "P:[%d]",WantedLevel[playerid]);
                    SetPlayerChatBubble(para1, stringZCMD, COR_VERMELHO, 45.0, 100000);
                }
                else if(WantedLevel[para1] == 0)
                {
                    SetPlayerChatBubble(para1, "*", COR_VERMELHO, 1, 1);
                }
                OnPlayerUpdate(para1);
                format(stringZCMD, sizeof(stringZCMD), "ADMCMD: %s retirou [%d] nivel de procurado em %s.",PlayerName(playerid), rprocura, PlayerName(para1));
                ABroadCast(COR_LIGHTRED, stringZCMD,1);
                format(stringZCMD, sizeof(stringZCMD), "* Voce limpou [%d] nivel de procura do jogador %s.",rprocura, giveplayerZCMD);
                SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                format(stringZCMD, sizeof(stringZCMD), "* Admin %s: retirou [%d] nivel de procura da sua ficha.",PlayerName(playerid), rprocura);
                SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
            }
        }
        return 1;
    }
    CMD:habilidades(playerid, x_nr[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(isnull(x_nr))
            {
                SendClientMessage(playerid, COR_BRANCO, "|_________________ Habilidades Skill _________________|");
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /Habilidades [numero]");
                SendClientMessage(playerid, COR_GREY, "| 1: Detetive");
                SendClientMessage(playerid, COR_GREY, "| 2: Advogado");
                SendClientMessage(playerid, COR_GREY, "| 3: Vendedor de Drogas");
                SendClientMessage(playerid, COR_BRANCO, "|__________________________________________________|");
                return 1;
            }
            if(strcmp(x_nr,"1",true) == 0)//Detetive
            {
                new level = PlayerInfo[playerid][pDetSkill];
                if(level >= 0 && level <= 50) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 1."); format(stringZCMD, sizeof(stringZCMD), "Voce precisa procurar mais %d para passar de nivel.", 10 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 51 && level <= 100) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 2."); format(stringZCMD, sizeof(stringZCMD), "Voce precisa procurar mais %d para passar de nivel.", 20 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 101 && level <= 150) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 3."); format(stringZCMD, sizeof(stringZCMD), "Voce precisa procurar mais %d para passar de nivel.", 30 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 151 && level <= 200) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 4."); format(stringZCMD, sizeof(stringZCMD), "Voce precisa procurar mais %d para passar de nivel.", 40 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 201) { SendClientMessage(playerid, COR_AMARELO, "Level de detetive = 5(Maximo)."); }
            }
            else if(strcmp(x_nr,"2",true) == 0)//Advogado
            {
                new level = PlayerInfo[playerid][pLawSkill];
                if(level >= 0 && level <= 50) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 1."); format(stringZCMD, sizeof(stringZCMD), "Voce precisa soltar mais %d pessoas para passar de nivel.", 50 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 51 && level <= 100) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 2."); format(stringZCMD, sizeof(stringZCMD), "Voce precisa soltar mais %d pessoas para passar de nivel.", 100 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 101 && level <= 200) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 3."); format(stringZCMD, sizeof(stringZCMD), "Voce precisa soltar mais %d pessoas para passar de nivel.", 200 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 201 && level <= 300) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 4."); format(stringZCMD, sizeof(stringZCMD), "Voce precisa soltar mais %d pessoas para passar de nivel.", 400 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 301) { SendClientMessage(playerid, COR_AMARELO, "Level de advogado = 5(Maximo)."); }
            }
            else if(strcmp(x_nr,"3",true) == 0)//Vendedor de Drogas
            {
                new level = PlayerInfo[playerid][pDrogasSkill];
                if(level >= 0 && level <= 50) { SendClientMessage(playerid, COR_AMARELO, "Level de venda de drogas = 1."); format(stringZCMD, sizeof(stringZCMD), "Voce precisar vender mais %d drogas para passar de nivel.", 50 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 51 && level <= 100) { SendClientMessage(playerid, COR_AMARELO, "Level de venda de drogas = 2."); format(stringZCMD, sizeof(stringZCMD), "Voce precisar vender mais %d drogas para passar de nivel.", 100 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 101 && level <= 150) { SendClientMessage(playerid, COR_AMARELO, "Level de venda de drogas = 3."); format(stringZCMD, sizeof(stringZCMD), "Voce precisar vender mais %d drogas para passar de nivel.", 200 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 151 && level <= 200) { SendClientMessage(playerid, COR_AMARELO, "Level de venda de drogas = 4."); format(stringZCMD, sizeof(stringZCMD), "Voce precisar vender mais %d drogas para passar de nivel.", 400 - level); SendClientMessage(playerid, COR_AMARELO, stringZCMD); }
                else if(level >= 201) { SendClientMessage(playerid, COR_AMARELO, "Level de V.Drogas = 5(Maximo)."); }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Numero de habilidade invalido !");
                return 1;
            }
        }
        return 1;
    }
    CMD:mervdecod(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(GetPlayerOrg(playerid) != 21 && GetPlayerOrg(playerid) != 24 && GetPlayerOrg(playerid) != 29)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um mercenario!");
                return 1;
            }
            new money;
            if(sscanf(params, "ud", sscanfid, money))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /mervdecod [ id ] [preco]");
                return 1;
            }
            if(PlayerInfo[playerid][pMats] < 70)
            {
                SendClientMessage(playerid, COR_GRAD1, "* Voce precisa ter mas de 70 de Materiais para vender um decodificador !");
                return 1;
            }
            if(money < 500 || money > 3000) { SendClientMessage(playerid, COR_GREY, "Preco minimo 500, preco maximo 3000!"); return 1; }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce ofereceu um decodificador ao(a) %s por R$[%d] .", giveplayerZCMD, money);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* Mercenario %s quer lhe vender um decodificador por R$[%d], (Digite /aceitar decod) para aceitar.", sendername, money);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        DecodificadorOffer[sscanfid] = playerid;
                        DecodificadorPrice[sscanfid] = money;
                        PlayerInfo[playerid][pMats] -= 70;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "O Jogador nao esta perto de Voce !");
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
            }
        }
        return 1;
    }
    CMD:mafiavdinamite(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pMembro] != 20 && PlayerInfo[playerid][pLider] != 20 && PlayerInfo[playerid][pMembro] != 22&& PlayerInfo[playerid][pLider] != 22 && PlayerInfo[playerid][pMembro] != 28&& PlayerInfo[playerid][pLider] != 28 && PlayerInfo[playerid][pMembro] != 29&& PlayerInfo[playerid][pLider] != 29)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e Mafioso !");
                return 1;
            }
            new carid = GetPlayerVehicleID(playerid);
            if(!IsABoxCar(carid))
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce precisa estar dentro do BoxVille Para Vender Dinamites!");
                return 1;
            }
            if(GetPlayerOrg(playerid) == 20 && donocasarao != 2)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce e da Mafia Yakuza, precisa estar dominando algum territorio para usar este comando !");
                return 1;
            }
            if(GetPlayerOrg(playerid) == 22 && donocasarao != 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce e da Mafia Yakuza, precisa estar dominando algum territorio para usar este comando !");
                return 1;
            }
            new money;
            if(sscanf(params, "ud", sscanfid, money))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /mafiavdinamite [id] [preco]");
                return 1;
            }
            if(PlayerInfo[playerid][pMats] < 20)
            {
                SendClientMessage(playerid, COR_GRAD1, "* Voce precisa ter mas de 20 de Materiais para vender dinamites!");
                return 1;
            }
            if(money < 1 || money > 5000) { SendClientMessage(playerid, COR_GREY, "Preco maior que 1, menor que 5000!"); return 1; }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid)
                        {
                            SendClientMessage(playerid, COR_GREY, "Voce nao pode se vender dinamite!");
                            return 1;
                        }
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce ofereceu dinamites para %s por R$[%d].", giveplayerZCMD, money);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "*  %s lhe ofereceu dinamites por R$[%d], (Digite /aceitar dinamite) para aceitar.", sendername, money);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        DinamiteOffer[sscanfid] = playerid;
                        DinamitePrice[sscanfid] = money;
                        PlayerInfo[playerid][pMats] -= 20;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "O Jogador nao esta perto de Voce !");
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
            }
        }
        return 1;
    }
