                          SendClientMessage(playerid, COR_GRAD1, "Voce nao pode duelar contra si mesmo.");
                          return 1;
                     }
                     if (!ProxDetectorS(8.0, playerid, chosenpid))
                     {
                          SendClientMessage(playerid, COR_GRAD1, "Este jogador nao esta perto de Voce.");
                          return 1;
                     }
                     if(WantedLevel[playerid] > 0)
                     {
                          SendClientMessage(playerid, COR_GRAD1, "Voce nao pode digitar este comando agora!");
                          return 1;
                     }
                     if(WantedLevel[chosenpid] > 0)
                     {
                          SendClientMessage(playerid, COR_GRAD1, "Voce nao pode duelar com um jogador procurado!");
                          return 1;
                     }
                     PlayerInfo[chosenpid][pDesafiador] = playerid;
                     PlayerInfo[playerid][pDesafiante] = chosenpid;
                     format(string, sizeof(string), "* Voce desafiou %s para ir 1x1, aguarde.", PlayerName(chosenpid));
                     SendClientMessage(playerid, COR_LIGHTBLUE, string);
                     format(string, sizeof(string), "* %s esta lhe desafiando para 1x1\nVoce deseja aceitar este desafio?", PlayerName(playerid));
                     ShowPlayerDialog(chosenpid, 175,DIALOG_STYLE_MSGBOX,"Duelos", string, "Sim", "nao");
                 }
                 else
                 {
                     SendClientMessage(playerid,COR_GREY,"O jogador nao esta online !");
                     return 1;
                 }
             }
             else
             {
                  SendClientMessage(playerid,COR_GREY,"O jogador nao esta online !");
                  return 1;
             }
        }
        else
        {
            chosenpid = strval(inputtext);
            format(gstring,sizeof(gstring),"Digite o ID de seu oponente");
            ShowPlayerDialog(playerid, 175, DIALOG_STYLE_INPUT,"Desafiando 1x1 !", gstring,"Confirmar","Cancelar"); //avaliar
