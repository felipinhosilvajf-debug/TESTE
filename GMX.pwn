START::GuerraCasarao(playerid)
{
    new string[128];
    new playername[MAX_PLAYER_NAME];
    PlayerInfo[playerid][pDominador] ++;
    if(PlayerInfo[playerid][pMembro] == 22 || PlayerInfo[playerid][pLider] == 22)
    {
        if(ProvocoCasarao[playerid] == 1)
        {
            if(IsPlayerInCasarao(playerid))
            {
                GetPlayerName(playerid, playername, MAX_PLAYER_NAME);
                if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid, "https://dl.dropboxusercontent.com/s/okdv5qlstevu9ec/dominating.mp3");
                foreach(new i: Player)
                {
                     if(PlayerInfo[i][pChatTerritorio] == 0)
                     {
                          format(string, sizeof(string), "[Territorios]: %s e a Mafia CN Dominaram o Casarao!",playername);
                          SendClientMessage(i, COR_COSA, string);
                     }
                }
                SendClientMessage(playerid, COR_GRAD5, "Voce dominou o casarao, a cada 3 minutos nela ganhara grana.");
                SendClientMessage(playerid, COR_GRAD5, "Voce tambem ganhara uma porcentagem do lucro nas vendas do mercado negro.");
                GangZoneStopFlashForAll(GZCasarao);
                GangZoneShowForAll(GZCasarao,COR_COSA);
                Dominando[playerid] = 0;
                ProvocoCasarao[playerid] = 0;
                GuerranoCasarao = 0;
                donocasarao = 1;
                DisputaCN++;
                KillTimer(TempoGuerraCasarao);
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta no casarao.");
                Dominando[playerid] = 0;
                GangZoneStopFlashForAll(GZCasarao);
                GangZoneShowForAll(GZCasarao, 0xFFFFFF96);
                ProvocoCasarao[playerid] = 0;
                GuerranoCasarao = 0;
                donocasarao = 0;
                KillTimer(TempoGuerraCasarao);
                return 1;
            }
        }
        return 1;
    }
    if(PlayerInfo[playerid][pMembro] == 20 || PlayerInfo[playerid][pLider] == 20)
    {
        if(ProvocoCasarao[playerid] == 1)
        {
            if(IsPlayerInCasarao(playerid))
            {
                GetPlayerName(playerid, playername, MAX_PLAYER_NAME);
                if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid, "https://dl.dropboxusercontent.com/s/okdv5qlstevu9ec/dominating.mp3");
                foreach(new i: Player)
                {
                     if(PlayerInfo[i][pChatTerritorio] == 0)
                     {
                          format(string, sizeof(string), "[Territorios]: %s e a Mafia Yakuza Dominaram o Casarao!",playername);
                          SendClientMessage(i, COR_YAK, string);
                     }
                }
                SendClientMessage(playerid, COR_GRAD5, "Voce dominou o casarao, a cada 3 minutos nela ganhara grana.");
                SendClientMessage(playerid, COR_GRAD5, "Voce tambem ganhara uma porcentagem do lucro nas vendas do mercado negro.");
                GangZoneStopFlashForAll(GZCasarao);
                GangZoneShowForAll(GZCasarao,COR_YAK);
                Dominando[playerid] = 0;
                ProvocoCasarao[playerid] = 0;
                GuerranoCasarao = 0;
                donocasarao = 2;
                DisputaYakuza++;
                KillTimer(TempoGuerraCasarao);
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta no casarao.");
                Dominando[playerid] = 0;
                GangZoneStopFlashForAll(GZCasarao);
                GangZoneShowForAll(GZCasarao, 0xFFFFFF96);
                ProvocoCasarao[playerid] = 0;
                GuerranoCasarao = 0;
                donocasarao = 0;
                KillTimer(TempoGuerraCasarao);
                return 1;
            }
        }
        return 1;
    }
    if(PlayerInfo[playerid][pMembro] == 25 || PlayerInfo[playerid][pLider] == 25)
    {
        if(ProvocoCasarao[playerid] == 1)
        {
            if(IsPlayerInCasarao(playerid))
            {
                GetPlayerName(playerid, playername, MAX_PLAYER_NAME);
                if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid, "https://dl.dropboxusercontent.com/s/okdv5qlstevu9ec/dominating.mp3");
                foreach(new i: Player)
                {
                     if(PlayerInfo[i][pChatTerritorio] == 0)
                     {
                          format(string, sizeof(string), "[Territorios]: %s e a Policia Federal Dominaram o Casarao!",playername);
                          SendClientMessage(i, COR_PF, string);
                     }
                }
                SendClientMessage(playerid, COR_GRAD5, "Voce dominou o casarao, a cada 3 minutos nela ganhara grana.");
                GangZoneStopFlashForAll(GZCasarao);
                GangZoneShowForAll(GZCasarao,COR_PF);
                Dominando[playerid] = 0;
                ProvocoCasarao[playerid] = 0;
                GuerranoCasarao = 0;
                donocasarao = 3;
                KillTimer(TempoGuerraCasarao);
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta no casarao.");
                Dominando[playerid] = 0;
                GangZoneStopFlashForAll(GZCasarao);
                GangZoneShowForAll(GZCasarao, 0xFFFFFF96);
                ProvocoCasarao[playerid] = 0;
                GuerranoCasarao = 0;
                donocasarao = 0;
                KillTimer(TempoGuerraCasarao);
                return 1;
            }
        }
        return 1;
    }
    return 1;
}
