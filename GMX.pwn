    CMD:moedas(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] < 1340) return true;
        SendClientMessage(playerid, COR_VERDE, "Jogadores com Moedas:");
        foreach(new i: Player)
        {
            if(IsPlayerConnected(playerid))
            {
                if(PlayerInfo[i][pCoins] > 0 && PlayerInfo[i][pAdmin] == 0)
                {
                    format(stringZCMD, sizeof(stringZCMD), "%s[%d] - Moedas[%d]", PlayerName(i), i, PlayerInfo[i][pCoins]);
                    SendClientMessage(playerid, 0xc4c4c4ff, stringZCMD);
                }
                if(PlayerInfo[i][pReceberCoins] > 0 && PlayerInfo[i][pAdmin] == 0)
                {
                    format(stringZCMD, sizeof(stringZCMD), "%s[%d] - Moedas A Receber[%d]", PlayerName(i), i, PlayerInfo[i][pCoins]);
                    SendClientMessage(playerid, COR_AMARELO, stringZCMD);
                }
            }
        }
        return 1;
    }
