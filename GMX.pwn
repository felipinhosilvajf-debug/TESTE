                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /tapa [id]");
                return 1;
            }
            new Float:slx, Float:sly, Float:slz;
            if(PlayerInfo[playerid][pAdmin] >= 1)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(playa))
                {
                    if(playa != INVALID_PLAYER_ID)
                    {
                        if(PlayerInfo[playa][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] != 1342)
                        {
                            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode dar tapa em um Admin Dono !");
                            return 1;
                        }
                        GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        GetPlayerPos(playa, slx, sly, slz);
                        SetPlayerPos(playa, slx, sly, slz+12);
                        PlayerPlaySound(playa, 1130, slx, sly, slz+12);
                        printf("ADMIN CMD: %s ganhou um tapa de: %s",sendername,  giveplayerZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s ganhou um tapa de: %s",giveplayerZCMD ,sendername);
                        ABroadCast(COR_LIGHTRED,stringZCMD,1);
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
            }
        }
        return 1;
    }
    CMD:explodir(playerid, params[])
    {
        GetPlayerName(playerid, sendername, sizeof(sendername));
        if(sscanf(params, "u", sscanfid))
        {
            SendClientMessage(playerid, COR_GREY, "/explodir [id]");
            return 1;
        }
        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
        GetPlayerName(playerid, sendername, sizeof(sendername));
        if(IsPlayerConnected(sscanfid))
        {
            if(PlayerInfo[playerid][pAdmin] >= 3)
            {
                if(PlayerInfo[sscanfid][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] != 1342)
                {
                    SendClientMessage(playerid, COR_GRAD1, "Voce nao pode explodir um Admin Dono !");
                    return 1;
                }
                if(IsPlayerConnected(sscanfid))
                {
                    format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s foi explodido por %s",giveplayerZCMD, sendername);
                    ABroadCast(COR_LIGHTRED,stringZCMD,1);
                    SetPlayerHealth(sscanfid, 10);
                    new Float:boomx, Float:boomy, Float:boomz;
                    GetPlayerPos(sscanfid,boomx, boomy, boomz);
                    CreateExplosion(boomx, boomy , boomz, 7, 10);
                    new PlayerName2[30];
                    GetPlayerName(playerid, PlayerName2, 30);
                    printf("[Admins] %s usou /explode em %s", PlayerName2, giveplayerZCMD);
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "Esse jogador nao esta online.");
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando!");
            }
        }
        else
        {
            SendClientMessage(playerid, COR_GREY, "Voce deve estar logado para usar o comando!");
        }
        return 1;
    }
