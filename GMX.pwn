    CMD:repararvip(playerid)
    {
        if(!IsPlayerInAnyVehicle(playerid))
        {
            SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}Voce nao esta em um veiculo");
        }
        else if(IsPlayerInAnyVehicle(playerid))
        {
            if(PlayerInfo[playerid][pSocio] > 0)
            {
                     new vehicle = GetPlayerVehicleID(playerid);
                     Quebrado[vehicle] = 0;
                     //RepairCar[playerid] = GetPlayerVehicleID(playerid);
                     SetVehicleHealth(vehicle, 1000.0);
                     SendClientMessage(playerid, COR_START, "{df5454}Socio: {ffffff}O seu veiculo foi reparado com sucesso.");
            }
        }
        return 1;
    }

    CMD:abastecervip(playerid)
    {
        if(!IsPlayerInAnyVehicle(playerid))
        {
            SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}Voce nao esta em um veiculo");
        }
        else if(IsPlayerInAnyVehicle(playerid))
        {
            if(PlayerInfo[playerid][pSocio] > 0)
            {
                     new vehicle = GetPlayerVehicleID(playerid);
                     //Quebrado[vehicle] = 0;
                     //RepairCar[playerid] = GetPlayerVehicleID(playerid);
                     Gas[vehicle] = 100;
                     SendClientMessage(playerid, COR_START, "{df5454}Socio: {ffffff}O seu veiculo foi abastecido com sucesso.");
            }
            else if(PlayerInfo[playerid][pVIP] > 0)
            {
                     new vehicle = GetPlayerVehicleID(playerid);
                     //Quebrado[vehicle] = 0;
                     //RepairCar[playerid] = GetPlayerVehicleID(playerid);
                     Gas[vehicle] = 100;
                     SendClientMessage(playerid, COR_START, "{df5454}VIP: {ffffff}O seu veiculo foi abastecido com sucesso.");
            }
        }
        return 1;
    }

