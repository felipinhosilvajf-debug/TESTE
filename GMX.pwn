                return 1;
            }
            if(PlayerInfo[Armazenar[playerid]][pDinheiro] < ArmazenarValor[playerid])
            {
                ArmazenarValor[playerid] = strval(inputtext);
                return SendClientMessage(playerid, COR_LIGHTRED, "Esse jogador nao pode pagar por esse item !");
            }
