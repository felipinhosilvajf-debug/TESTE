        if(PlayerInfo[playerid][pSede] == 7)
        {
            format(str, 100, "%d%",PlayerInfo[playerid][pSede]);
            //PlayerTextDrawHide(playerid, BarraFome[playerid]);
            PlayerTextDrawSetString(playerid, BarraSede1[playerid], str);
            PlayerTextDrawTextSize(playerid, BarraSede[playerid], 535, 1.0 );
            PlayerTextDrawShow(playerid, BarraSede[playerid]);
        }
        if(PlayerInfo[playerid][pSede] == 6)
        {
            format(str, 100, "%d%",PlayerInfo[playerid][pSede]);
            //PlayerTextDrawHide(playerid, BarraFome[playerid]);
            PlayerTextDrawSetString(playerid, BarraSede1[playerid], str);
            PlayerTextDrawTextSize(playerid, BarraSede[playerid], 534, 1.0 );
            PlayerTextDrawShow(playerid, BarraSede[playerid]);
        }
        if(PlayerInfo[playerid][pSede] <= 5)
        {
            format(str, 100, "%d%",PlayerInfo[playerid][pSede]);
            //PlayerTextDrawHide(playerid, BarraFome[playerid]);
            PlayerTextDrawSetString(playerid, BarraSede1[playerid], str);
            PlayerTextDrawTextSize(playerid, BarraSede[playerid], 533, 1.0 );
            PlayerTextDrawShow(playerid, BarraSede[playerid]);
        }
        retirada[playerid] ++;
        TextDrawShowForPlayer(playerid, FomeFome);
        TextDrawShowForPlayer(playerid, SedeSede);
        TextDrawShowForPlayer(playerid, FomeFome1);
        TextDrawShowForPlayer(playerid, SedeSede1);
        PlayerTextDrawShow(playerid, BarraFome1[playerid]);
        PlayerTextDrawShow(playerid, BarraSede1[playerid]);
        if(retirada[playerid] == 150)
        {
            if(vidaplayer > 5)
            {
                if(PlayerInfo[playerid][pFome] < 10  || PlayerInfo[playerid][pSede] < 10)
                {
                    PlayerInfo[playerid][pFome] -- ;
                    PlayerInfo[playerid][pSede] -= random(2);
                    if(PlayerInfo[playerid][pFome] < 1)PlayerInfo[playerid][pFome] = 1;
                    if(PlayerInfo[playerid][pSede] < 1)PlayerInfo[playerid][pSede] = 1;
                    new porcento;
                    if(vidaplayer >10 )
                    {
                        SetPlayerHealth(playerid, vidaplayer - 10);
                        porcento = 10;
                    }
                    else if(vidaplayer >6 )
                    {
                        SetPlayerHealth(playerid, vidaplayer - 6);
                        porcento = 6;
                    }
                    else if(vidaplayer >3 )
                    {
                        SetPlayerHealth(playerid, vidaplayer - 3);
                        porcento = 3;
                    }
                    if(PlayerInfo[playerid][pFome] < 10){
                        format(stringZCMD, sizeof stringZCMD, "* Voce esta com fome, perdeu %d porcento de vida!", porcento);
                        SendClientMessage(playerid, COR_START2, stringZCMD);
                    }
                    if(PlayerInfo[playerid][pSede] < 10){
                        format(stringZCMD, sizeof stringZCMD, "* Voce esta com sede, perdeu %d porcento de vida!", porcento);
                        SendClientMessage(playerid, COR_START2, stringZCMD);
                    }
                    retirada[playerid] = 0;
                    return 1;
                }

                if(PlayerInfo[playerid][pFome] < 25 || PlayerInfo[playerid][pSede] < 25)
                {
                    PlayerInfo[playerid][pFome] -- ;
                    PlayerInfo[playerid][pSede] -= random(2);
                    if(PlayerInfo[playerid][pFome] < 1)PlayerInfo[playerid][pFome] = 1;
                    if(PlayerInfo[playerid][pSede] < 1)PlayerInfo[playerid][pSede] = 1;
                    if(vidaplayer >5 )
                    {
                        SetPlayerHealth(playerid, vidaplayer - 5);
                    }
                    retirada[playerid] = 0;
                    return 1;
                }
                if(PlayerInfo[playerid][pFome] < 50 || PlayerInfo[playerid][pSede] < 50 )
                {
                    PlayerInfo[playerid][pFome] -- ;
                    PlayerInfo[playerid][pSede] -= random(2);
                    if(PlayerInfo[playerid][pFome] < 1)PlayerInfo[playerid][pFome] = 1;
                    if(PlayerInfo[playerid][pSede] < 1)PlayerInfo[playerid][pSede] = 1;
                    if(vidaplayer >2 )
                    {
                        SetPlayerHealth(playerid, vidaplayer - 2);
                    }
                    retirada[playerid] = 0;
                    return 1;
                }
                PlayerInfo[playerid][pFome] -- ;
                PlayerInfo[playerid][pSede] -= random(2);
                retirada[playerid] = 0;
            }
        }
    }
    return 1;
}
new IncomingConnection[iI];
public OnIncomingConnection(playerid, ip_address[], port)
{
    if(!strcmp(IncomingConnection[IncomingIP], ip_address, true) && IncomingConnection[IncomingTempo] > gettime()) {
        if(IncomingConnection[IncomingVezes] > 3) return BlockIpAddress(ip_address, 0), printf("ip %s bloqueado!", ip_address);
        IncomingConnection[IncomingVezes]++;
        return 1;
    }
    format(IncomingConnection[IncomingIP], 16, ip_address);
    IncomingConnection[IncomingVezes] = 0;
    IncomingConnection[IncomingTempo] = GetTickCount()+2;
    return 1;
}
//Mobilia Casa
public OnPlayerSelectDynamicObject(playerid, objectid, modelid, Float:x, Float:y, Float:z){
    for(new h; h != MAX_HOUSES; h++)
    {
        for(new m; m != MAX_MOVEIS; m++)
        {
            if(MobInfo[h][m][mobCreated] && objectid == MobInfo[h][m][mobObject])
            {
                SetPVarInt(playerid, "editandoh", 999);
                EditDynamicObject(playerid, MobInfo[h][m][mobObject]);
                SetPVarInt(playerid, "editMovel", m);
                return 1;
            }
        }
    }
    return 1;
}
public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
    if(response == 1 || response == 0)
    {
        if(GetPVarInt(playerid, "editandoh") == 999)
        {
            new m = GetPVarInt(playerid, "editMovel"),casaid = PlayerInfo[playerid][pPHousekey];
            if(response == 1)
            {
                MobInfo[casaid][m][mobX] = x;
                MobInfo[casaid][m][mobY] = y;
                MobInfo[casaid][m][mobZ] = z;
                //
                MobInfo[casaid][m][mobRX] = rx;
                MobInfo[casaid][m][mobRY] = ry;
                MobInfo[casaid][m][mobRZ] = rz;
                //
                DestroyDynamicObject(MobInfo[casaid][m][mobObject]);
                MobInfo[casaid][m][mobObject]   = CreateDynamicObject(MobInfo[casaid][m][mobModel], x, y, z, rx, ry, rz, GetPlayerVirtualWorld(playerid));
                SetPlayerInterior(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hInt]);
                SetPlayerVirtualWorld(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hWorld]);
                SetPlayerPos(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hExitx],HouseInfo[PlayerInfo[playerid][pPHousekey]][hExity],HouseInfo[PlayerInfo[playerid][pPHousekey]][hExitz]);
                showBalao(playerid, "Movel Colocado Com Sucesso", 5000);
                if(EstaNaLoja[playerid] == 1)
                {
                    SetPlayerInterior(playerid, 0);
                    SetPlayerVirtualWorld(playerid, 0);
                    SetPlayerPos(playerid, poshx, poshy, poshz);
                    InteriorAtual[playerid] = 0;
                    LocalAtual[playerid] = 999;
                    HouseEntered[playerid] = 999;
                    EstaNaLoja[playerid] = 0;
                }
            }
            else
            {
                MobInfo[casaid][m][mobCreated] = 0;
                DestroyDynamicObject(MobInfo[casaid][m][mobObject]);
                SetPlayerInterior(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hInt]);
                SetPlayerVirtualWorld(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hWorld]);
                SetPlayerPos(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hExitx],HouseInfo[PlayerInfo[playerid][pPHousekey]][hExity],HouseInfo[PlayerInfo[playerid][pPHousekey]][hExitz]);
                showBalao(playerid, "Voce cancelou o Movel", 5000);
                if(EstaNaLoja[playerid] == 1)
                {
                    SetPlayerInterior(playerid, 0);
                    SetPlayerVirtualWorld(playerid, 0);
                    SetPlayerPos(playerid, poshx, poshy, poshz);
                    InteriorAtual[playerid] = 0;
                    LocalAtual[playerid] = 999;
                    HouseEntered[playerid] = 999;
                    EstaNaLoja[playerid] = 0;
                }

            }
            SetPVarInt(playerid, "editandoh", 0);
            salvarMoveis(casaid);
        }
        if(GetPVarInt(playerid, "editando") == 999)
        {
            new p = GetPVarInt(playerid, "editPortao"), Str[5000+MAX_PLAYER_NAME];
            //Posicoes
            PortaoInfo[p][portaoX]          = x;
            PortaoInfo[p][portaoY]          = y;
            PortaoInfo[p][portaoZ]          = z;
            //Rotacao
            PortaoInfo[p][portaoRX]         = rx;
            PortaoInfo[p][portaoRY]         = ry;
            PortaoInfo[p][portaoRZ]         = rz;
            DestroyDynamicObject(PortaoInfo[p][portaoObject]);
            PortaoInfo[p][portaoObject]     = CreateDynamicObject(980, x, y, z, rx, ry, rz);
            DestroyDynamic3DTextLabel(PortaoInfo[p][portaoText]);
            format(Str, sizeof Str, "{ffffff}ID do Portao: {df5454}%d\n{FFFFFF}Dono Do Portao: {df5454}%s\n{FFFFFF}Use: {df5454}/abrirportao{FFFFFF} para abrir!", p, PortaoInfo[p][portaoNick]);
            PortaoInfo[p][portaoText]       = CreateDynamic3DTextLabel(Str, COR_LIGHTBLUE, x, y, z, 25.0);
            SetPVarInt(playerid, "editando", 0);
            salvarPortoes();
        }
        if(EditandoObjeto[playerid] == true)
        {
            new p = EditandoObjeto2[playerid], Str[5000+MAX_PLAYER_NAME];
            //Posicoes
            ObjetoInfo[p][objetoX]          = x;
            ObjetoInfo[p][objetoY]          = y;
            ObjetoInfo[p][objetoZ]          = z;
            //Rotacao
            ObjetoInfo[p][objetoRX]         = rx;
            ObjetoInfo[p][objetoRY]         = ry;
            ObjetoInfo[p][objetoRZ]         = rz;
            DestroyDynamicObject(ObjetoInfo[p][objetoObject]);
            ObjetoInfo[p][objetoObject]     = CreateDynamicObject(ObjetoInfo[p][objetoID], x, y, z, rx, ry, rz);
            format(Str, sizeof Str, "{ffffff}ID do Objeto: {df5454}%d\n{FFFFFF}Dono do Objeto: {df5454}%s", p, ObjetoInfo[p][objetoNick]);
            Update3DTextLabelText(ObjetoInfo[p][objetoText], COR_LIGHTBLUE, Str);
            SetPVarInt(playerid, "editando", 0);
            EditandoObjeto[playerid] = false;
            salvarPortoes();
            salvarObjetos();
        }
    }
    return 1;
}

public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
     new string[256];
     new Float:Vida;
     new Float:Colete;
     GetPlayerArmour(playerid,Colete);
     GetPlayerHealth(playerid, Vida);
     SaiuSpawn[damagedid] = 0;
     // bloquear dano de admin
     if(IniciouCombate[damagedid] != playerid)
     {
        format(string, sizeof(string),"%s iniciou um combate contra %s", PlayerName(damagedid), PlayerName(playerid));
        WriteLog("Logs/combates.log", string);
        IniciouCombate[damagedid] = playerid;
     }
     // bloquear dano apos sair da barraca guerra
     if(SaiuSpawn[playerid] == 1)
     {
        if(Colete >= 1)
        {
            SetPlayerArmour(playerid, Colete - 0);
        }
        else
        {
            SetPlayerHealth(playerid, Vida - 0);
        }
     }
     // bloquear bazuca de perto
     if(GetPlayerWeapon(damagedid) == 35)
     {
        if(IsPlayerInEmboscada(playerid))
        {
            if(Colete >= 1)
            {
                SetPlayerArmour(playerid, Colete - 0);
            }
            else
            {
                SetPlayerHealth(playerid, Vida - 0);
            }
            SendClientMessage(damagedid,COR_LIGHTRED, "Bazuca nao causa dano em jogadores que estao na emboscada.");
        }
        if(GetDistanceBetweenPlayers(damagedid, playerid) <= 20)
        {
            if(Colete >= 1)
            {
                SetPlayerArmour(playerid, Colete - 0);
            }
            else
            {
                SetPlayerHealth(playerid, Vida - 0);
            }
            SendClientMessage(damagedid,COR_LIGHTRED, "Bazuca de perto e proibido, o tiro foi bloqueado.");
        }
     }
     if(EquipeQuarentena[damagedid] == 1 && EquipeQuarentena[playerid] == 1)
     {
        if(Colete >= 1)
        {
            SetPlayerArmour(playerid,Colete - 0);
        }
        else
        {
            SetPlayerHealth(playerid, Vida - 0);
        }
        return 1;
     }
     if(EquipeQuarentena[damagedid] == 2 && EquipeQuarentena[playerid] == 2)
     {
        if(Colete >= 1)
        {
            SetPlayerArmour(playerid,Colete - 0);
        }
        else
        {
            SetPlayerHealth(playerid, Vida - 0);
        }
        return 1;
     }
     // sistema de headshot(eventos) / partes do corpo
     if(bodypart == 9)
     {
          if(headshot[playerid] == 0)
          {
              if(PlayerInfo[playerid][pTiroteio] > 0 && PlayerInfo[damagedid][pTiroteio] > 0)
              {
                   if(weaponid == 24 || weaponid == 25)
                   {
                        headshot[playerid] = 1;
                        DeslogouNoTiroteio[playerid] = 0;
                        DeslogouNoTiroteio[damagedid] = 0;
                        GameTextForPlayer(playerid, "~r~HEAD SHOT NOOB!", 2500, 3);
                        GameTextForPlayer(damagedid, "~w~HEAD SHOT PORRA!", 2500, 3);
                        SetPlayerHealth(playerid, 0.0);
                        //SendDeathMessage(damagedid, playerid, GetPlayerweaponid(damagedid));
                   }
              }
              if(PrimeiroChuck[playerid] == 1)
              {
                  if(PlayerInfo[playerid][pTrazerChuck] == 0 && PlayerInfo[damagedid][pTrazerChuck] == 1)
                  {
                       if(weaponid == 24 || weaponid == 25)
                       {
                            headshot[playerid] = 1;
                            GameTextForPlayer(playerid, "~r~HEAD SHOT NOOB!", 2500, 3);
                            GameTextForPlayer(damagedid, "~w~HEAD SHOT PORRA!", 2500, 3);
                            SetPlayerHealth(playerid, 0.0);
                            //SendDeathMessage(damagedid, playerid, GetPlayerweaponid(damagedid));
                       }
                  }
              }
              else if(PrimeiroChuck[playerid] == 0)
              {
                  if(PlayerInfo[playerid][pTrazerChuck] == 1 && PlayerInfo[damagedid][pTrazerChuck] == 1)
                  {
                       if(weaponid == 24 || weaponid == 25)
                       {
                            headshot[playerid] = 1;
                            GameTextForPlayer(playerid, "~r~HEAD SHOT NOOB!", 2500, 3);
                            GameTextForPlayer(damagedid, "~w~HEAD SHOT PORRA!", 2500, 3);
                            SetPlayerHealth(playerid, 0.0);
                            //SendDeathMessage(damagedid, playerid, GetPlayerweaponid(damagedid));
                       }
                  }
              }
          }
          AtirouCorpo[playerid] = 1;
     }
     else if(bodypart == 3)
     {
          AtirouCorpo[playerid] = 2;
     }
     else if(bodypart == 4)
     {
          AtirouCorpo[playerid] = 3;
     }
     else if(bodypart == 6)
     {
          AtirouCorpo[playerid] = 4;
     }
     else if(bodypart == 5)
     {
          AtirouCorpo[playerid] = 5;
     }
     else if(bodypart == 8)
     {
          AtirouCorpo[playerid] = 6;
     }
     else if(bodypart == 7)
     {
          AtirouCorpo[playerid] = 7;
     }
     if(protecao[playerid] != 0)
     {
          if(GetPlayerWeapon(damagedid) != 34 && GetPlayerWeapon(damagedid) != 35)
          {
               return 1;
          }
          new Float:VidaP, Float:ColeteP;
          GetPlayerArmour(playerid,ColeteP);
          GetPlayerHealth(playerid, VidaP);
          if(protecao[playerid] == 1)
          {
               RemovePlayerAttachedObject(playerid,1);
               RemovePlayerAttachedObject(playerid,2);
               protecao[playerid] = 0;
               if(AtirouCorpo[damagedid] == 1)
               {
                    format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Cabeca], sua protecao foi destruida.",PlayerName(damagedid));
                    SendClientMessage(playerid, COR_LIGHTRED, string);
                    return 1;
               }
               else if(AtirouCorpo[damagedid] == 2)
               {
                    format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Tronco], sua protecao foi destruida.",PlayerName(damagedid));
                    SendClientMessage(playerid, COR_LIGHTRED, string);
                    return 1;
               }
               else if(AtirouCorpo[damagedid] == 3)
               {
                    format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Virilia], sua protecao foi destruida.",PlayerName(damagedid));
                    SendClientMessage(playerid, COR_LIGHTRED, string);
                    return 1;
               }
               else if(AtirouCorpo[damagedid] == 4)
               {
                    format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Braco Direito], sua protecao foi destruida.",PlayerName(damagedid));
                    SendClientMessage(playerid, COR_LIGHTRED, string);
                    return 1;
               }
               else if(AtirouCorpo[damagedid] == 5)
               {
                    format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Braco Esquerdo], sua protecao foi destruida.",PlayerName(damagedid));
                    SendClientMessage(playerid, COR_LIGHTRED, string);
                    return 1;
               }
               else if(AtirouCorpo[damagedid] == 6)
               {
                    format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Perna Direita], sua protecao foi destruida.",PlayerName(damagedid));
                    SendClientMessage(playerid, COR_LIGHTRED, string);
                    return 1;
               }
               else if(AtirouCorpo[damagedid] == 7)
               {
                    format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Perna Esquerda], sua protecao foi destruida",PlayerName(damagedid));
                    SendClientMessage(playerid, COR_LIGHTRED, string);
                    return 1;
               }
               format(string, sizeof(string), "[PROTEcao]Voce acertou um tiro de Sniper na protecao do(a)%s, ela foi destruida.",PlayerName(playerid));
               SendClientMessage(damagedid, COR_LIGHTRED, string);
               return 1;
          }
          protecao[playerid] -= 1;
          if(AtirouCorpo[damagedid] == 1)
          {
               format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Cabeca], sua protecao foi danificada, Voce tem [%d] protecoes.",PlayerName(damagedid), protecao[playerid]);
               SendClientMessage(playerid, COR_LIGHTBLUE, string);
          }
          else if(AtirouCorpo[damagedid] == 2)
          {
               format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Tronco], sua protecao foi danificada, Voce tem [%d] protecoes.",PlayerName(damagedid), protecao[playerid]);
               SendClientMessage(playerid, COR_LIGHTBLUE, string);
          }
          else if(AtirouCorpo[damagedid] == 3)
          {
               format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Virilia], sua protecao foi danificada, Voce tem [%d] protecoes.",PlayerName(damagedid), protecao[playerid]);
               SendClientMessage(playerid, COR_LIGHTBLUE, string);
          }
          else if(AtirouCorpo[damagedid] == 4)
          {
               format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Braco Direito], sua protecao foi danificada, Voce tem [%d] protecoes.",PlayerName(damagedid), protecao[playerid]);
               SendClientMessage(playerid, COR_LIGHTBLUE, string);
          }
          else if(AtirouCorpo[damagedid] == 5)
          {
               format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Braco Esquerdo], sua protecao foi danificada, Voce tem [%d] protecoes.",PlayerName(damagedid), protecao[playerid]);
               SendClientMessage(playerid, COR_LIGHTBLUE, string);
          }
          else if(AtirouCorpo[damagedid] == 6)
          {
               format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Perna Direita], sua protecao foi danificada, Voce tem [%d] protecoes.",PlayerName(damagedid), protecao[playerid]);
               SendClientMessage(playerid, COR_LIGHTBLUE, string);
          }
          else if(AtirouCorpo[damagedid] == 7)
          {
               format(string, sizeof(string), "[PROTEcao]Voce levou um tiro de [%s]. Local:[Perna Esquerda], sua protecao foi danificada, Voce tem [%d] protecoes.",PlayerName(damagedid), protecao[playerid]);
               SendClientMessage(playerid, COR_LIGHTBLUE, string);
          }
          format(string, sizeof(string), "[PROTEcao]Voce acertou um tiro de Sniper na protecao do(a)%s, ela foi danificada.",PlayerName(playerid));
          SendClientMessage(damagedid, COR_LIGHTBLUE, string);
          SetPlayerArmour(playerid, ColeteP - 0);
          SetPlayerHealth(playerid, VidaP - 0);
     }
     // sistema de imobilizaca(rifle)
     if(weaponid == 33)
     {
        if(IsACop(damagedid))
        {
            if(Colete >= 1)
            {
                SetPlayerArmour(playerid,Colete - 0);
            }
            else
            {
                SetPlayerHealth(playerid,Vida - 0);
            }
            if(WantedLevel[playerid] != 0)
            {
                new vid = GetPlayerVehicleID(playerid);
                if(!IsPlayerInVehicle(damagedid, vid))
                {
                    TogglePlayerControllable(playerid, 0);
                    pimobilizado[playerid] = 1;
                    ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0);
                    format(string, sizeof(string), "Voce imobilizou o suspeito: %s.", PlayerName(playerid));
                    SendClientMessage(damagedid, COR_LIGHTBLUE, string);
                    format(string, sizeof(string), "Voce foi imobilizado pelo Oficial: %s.", PlayerName(damagedid));
                    SendClientMessage(playerid, COR_LIGHTBLUE, string);
                    SetTimerEx("TempoImobilizado", 3000, 0, "i", playerid);
                    GameTextForPlayer(playerid, "~r~IMOBILIZADO", 2500, 3);
                }
            }
        }
        else if(NaPorraDoEvento[damagedid] == true)
        {
            if(Colete >= 1)
            {
                SetPlayerArmour(playerid,Colete - 50);
            }
            else
            {
                SetPlayerHealth(playerid,Vida - 50);
            }
        }
        return 1;
     }
     if(weaponid == 0)
     {
         if(Colete >= 1)
         {
             SetPlayerArmour(playerid,Colete - 2);
         }
         else
         {
             SetPlayerHealth(playerid,Vida - 2);
         }
         if(TaNoQuarentena[damagedid] == 1 && TaNoQuarentena[playerid] == 1)
         {
            if(LiberarInfectar == true)
            {
                if(Colete >= 1)
                {
                    SetPlayerArmour(playerid,Colete - 0);
                }
                else
                {
                    SetPlayerHealth(playerid,Vida - 0);
                }
                if(EquipeQuarentena[damagedid] == 2 && EquipeQuarentena[playerid] == 1)
                {
                    new Float:Vidaa;
                    GetPlayerHealth(damagedid, Vida);
                    EquipeQuarentena[playerid] = 2;
                   // InfectouHumanos[damagedid] ++;
                    GivePlayerMoneyEx(damagedid, 4000)
                    PlacarQuarentena(damagedid);
                    SetPlayerColor(playerid, COR_CV);
                    SetPlayerAttachedObject(playerid, 9, 2906, 5, -0.2, 0.0, 0.0, 0, 0.0, -90, 1.0, 1.0, 1.0);
                    SetPlayerAttachedObject(playerid, 10, 2906, 6, -0.2, 0.0, 0.0, 0, 345, 270, 1.0, 1.0, 1.0);
                    SetPlayerAttachedObject(playerid, 2, 2908, 2, 0.05,0.06, 0.0, 180, 0.0, 90, 1.1, 1.1, 1.1);
                    SetPlayerAttachedObject(playerid, 3, 2905, 12, 0.1, 0.05, 0.0, 0.0, 0.0, -70, 1.0, 1.0, 1.0);
                    ResetPlayerWeaponsEx(playerid);
                    SetPlayerSkin(playerid, 162);
                    //
                    if(Vidaa >= 90)
                    {
                        SetPlayerHealth(damagedid, 100);
                    }
                }
            }
            return 1;
         }
     }
     //MARTELINHO DO BAN
     if(UmMartelinho[damagedid] == true && weaponid == 5)
     {
        new banmessage[50+MAX_PLAYER_NAME*2]; //Our string
        format(banmessage,sizeof(banmessage),"{FF0000}O admin %s baniu %s com seu martelinho do ban.",PlayerName(damagedid),PlayerName(playerid)); //We format it with the player and victim's name.
        SendClientMessageToAll(-1,banmessage); //We send the message to everyone.
        getdate(Ano, Mes, Dia); //We get the date.
        gettime(Hora, Minuto, Segundo); //We get the time.
        format(gstring, sizeof(gstring), "[%04d/%02d/%02d - %02d:%02d:%02d] %s baniu %s com seu martelinho do ban\r\n", Ano, Mes, Dia, Hora, Minuto, Segundo, PlayerName(damagedid),PlayerName(playerid)); //We format the string
        BanLog(gstring);
        PlayerInfo[playerid][pDiaBanTemp] = 0;
        PlayerInfo[playerid][pMesBanTemp] = 0;
        PlayerInfo[playerid][pAnoBanTemp] = 0;
        OnPlayerSave(playerid);
        PlayerPlaySound(playerid, 31202, 0.0, 0.0, 0.0);
        BanBHC(playerid, "MARTELINHO DO BAN", PlayerName(damagedid));
     }
     //------------------------------------------------------------------------------
     //playerid
     KillTimer(TempoMostrarLife[damagedid]);
     format(string,sizeof(string),"~>~ ~g~~h~%s~n~         ~g~~h~+%0.0f DMG~n~~p~Arma: ~w~~h~%s", PlayerName(playerid), amount, NomeArma(weaponid));
     PlayerTextDrawSetString(damagedid, textinfodamage[damagedid][1], string);
     PlayerTextDrawShow(damagedid, textinfodamage[damagedid][0]);
     PlayerTextDrawShow(damagedid, textinfodamage[damagedid][1]);
     TempoMostrarLife[damagedid] = SetTimerEx("HideTextoLife", 1000, 0, "i", damagedid);
     MostrandoVida[damagedid] = 1;
     //------------------------------------------------------------------------------
     //playerid
     KillTimer(TempoMostrarLife[playerid]);
     format(string,sizeof(string),"~>~ ~r~~h~%s~n~         ~r~~h~-%0.0f DMG~n~~p~Arma: ~w~~h~%s", PlayerName(damagedid), amount, NomeArma(weaponid));
     PlayerTextDrawSetString(playerid, textinfodamage[playerid][1], string);
     PlayerTextDrawShow(playerid, textinfodamage[playerid][0]);
     PlayerTextDrawShow(playerid, textinfodamage[playerid][1]);
     TempoMostrarLife[playerid] = SetTimerEx("HideTextoLife", 1000, 0, "i", playerid);
     MostrandoVida[playerid] = 1;
     //------------------------------------------------------------------------------
     if(PlayerInfo[damagedid][pSino] == 1 || PlayerInfo[damagedid][pSino] == 3)
     {
        PlayerPlaySound(damagedid, 17802, 0.0, 0.0, 0.0); // Ding Sound
     }
     if(PlayerInfo[playerid][pSino] == 2 || PlayerInfo[playerid][pSino] == 3)
     {
        PlayerPlaySound(playerid, 17802, 0.0, 0.0, 0.0); // Ding Sound
     }
     return 1;
}


public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(clickedid == BTTUTO[1])
    {
        if(NumeroTutorial[playerid] <= 10 && NumeroTutorial[playerid] >= 1)
        {
            if(NumeroTutorial[playerid] == 2)
            {
                NumeroTutorial[playerid] = 1;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 3)
            {
                NumeroTutorial[playerid] = 2;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 4)
            {
                NumeroTutorial[playerid] = 3;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 5)
            {
                NumeroTutorial[playerid] = 4;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 6)
            {
                NumeroTutorial[playerid] = 5;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 7)
            {
                NumeroTutorial[playerid] = 6;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 8)
            {
                NumeroTutorial[playerid] = 7;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 9)
            {
                NumeroTutorial[playerid] = 8;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 10)
            {
                NumeroTutorial[playerid] = 9;
                STuto(playerid, NumeroTutorial[playerid]);
            }
        }
    }
    else if(clickedid == BTTUTO[0])
    {
        if(PulaTuto[playerid] == 1)
        {
            GameTextForPlayer(playerid, "~r~Aguarde alguns segundos...", 3000, 5);
            return 1;
        }
        else
        {
            if(NumeroTutorial[playerid] == 1)
            {
                NumeroTutorial[playerid] = 2;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 2)
            {
                NumeroTutorial[playerid] = 3;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 3)
            {
                NumeroTutorial[playerid] = 4;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 4)
            {
                NumeroTutorial[playerid] = 5;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 5)
            {
                NumeroTutorial[playerid] = 6;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 6)
            {
                NumeroTutorial[playerid] = 7;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 7)
            {
                NumeroTutorial[playerid] = 8;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 8)
            {
                NumeroTutorial[playerid] = 9;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 9)
            {
                NumeroTutorial[playerid] = 10;
                STuto(playerid, NumeroTutorial[playerid]);
            }
            else if(NumeroTutorial[playerid] == 10)
            {
                SIntro(playerid, 11);
                if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
                TogglePlayerControllable(playerid, 1);
                NoTuto[playerid] = 0;
                ClearChatbox(playerid, 100);
                WantedLevel[playerid] = 0;
                gNews[playerid] = 0;
                gFam[playerid] = 0;
                SetPlayerVirtualWorld(playerid,0);
                PlayerInfo[playerid][pCaixinha] = char;
                MedicBill[playerid] = 0;
                SetCameraBehindPlayer(playerid);
                PlayerInfo[playerid][pConta] = 100;
                PlayerPlayMusic(playerid);
                new randphone = 1000 + random(8999);
                PlayerInfo[playerid][pPnumber] = randphone;
                PlayerInfo[playerid][pCreditos] = 50;
                RegistrationStep[playerid] = 2;
                ResetPlayerMoneyEx(playerid);
                PlayerInfo[playerid][pCoins] = 0;
                MudarNick[playerid] = 0;
                PlayerInfo[playerid][pDiaVIP] = 0;
                PlayerInfo[playerid][pReceberCoins] = 0;
                TogglePlayerSpectating(playerid, 0);
                CancelSelectTextDraw(playerid);
                GivePlayerMoneyEx(playerid, 6000);
                PlayerInfo[playerid][pTutorial] = 1;
                OnPlayerSave(playerid);
                PlayerTextDrawHide(playerid, TutoAviso[playerid]);
                PlayerTextDrawHide(playerid, TituloTuto[playerid]);
                TextDrawHideForPlayer(playerid, BTTUTO[0]);
                TextDrawHideForPlayer(playerid, BTTUTO[1]);
                TextDrawHideForPlayer(playerid, BaseTuto[0]);
                TextDrawSetString(BTTUTO[0], "Proximo ~>~");
                MEGAString[0] = EOS;
                if(BonusBPS == true)
                {
                    SendClientMessage(playerid, COR_START, "{df5454}[Dica]: Siga o icone vermelho marcado no seu mapa(radar)!");
                    PlayerInfo[playerid][pLevel] = 4;
                    ResetPlayerMoneyEx(playerid);
                    GivePlayerMoneyEx(playerid, 80000);
                    SendClientMessage(playerid, 0x00FFFFFF, "{00ffff}[Bonus]: Voce foi bonificado com 4 Leveis e R$80.000!");
                }
                else if(BonusBPS == false)
                {
                    SendClientMessage(playerid, COR_START, "{df5454}[Dica]: Siga o icone vermelho marcado no seu mapa(radar)!");
                    PlayerInfo[playerid][pLevel] = 2;
                    ResetPlayerMoneyEx(playerid);
                    GivePlayerMoneyEx(playerid, 6000);
                    SendClientMessage(playerid, 0x00FFFFFF, "{00ffff}[Bonus]: Voce foi bonificado com 2 Leveis e R$6.000!");
                }
                if(PlayerInfo[playerid][pConqRegistro] == 0)
                {
                            showConq(playerid, "$200_-_Registro_no_Servidor");
                            showAlerta(playerid, "Parabens, Voce conseguiu cumprir mais uma conquista, para ver suas conquistas, digite: /conquistas!");
                            PlayerInfo[playerid][pConqRegistro] = 1;
                }
                strcat(MEGAString, "{fa4c4c}Alerta: {818689}Deseja deixar o sistema de Fome e Sede {00ff00}ATIVO {ffffff}?\n\n{00ffff}Obs: {ffffff}Com o sistema ativo Voce recebe mais experiencias por Cada Salario(Pay Day).\nVoce podera inverter essa configuracao posteriomente utilizando o comando\n(/configuracoes).\n\n{818689}Escolha uma Opcao Abaixo:");
                ShowPlayerDialog(playerid, 170, DIALOG_STYLE_MSGBOX, "Sistema de Fome e Sede:", MEGAString, "Ativado","Desativado");
                OnPlayerSave(playerid);

                if(PlayerInfo[playerid][pSpawnCity] == 0)
                {
                            SetPlayerPos(playerid,1154.1556,-1768.5778,16.5938); //nascimento civil LS
                            SetPlayerFacingAngle(playerid, 1.5602);
                            SetPlayerInterior(playerid,0);
                            SetPlayerHealth(playerid, 100);
                            SetPlayerVirtualWorld(playerid,0);
                            InteriorAtual[playerid] = 0;
                }
                else if(PlayerInfo[playerid][pSpawnCity] == 1)
                {
                            SetPlayerPos(playerid,-2651.0117,376.2788,6.0019); //nascimento civil LS
                            SetPlayerFacingAngle(playerid, 266.9954);
                            SetPlayerInterior(playerid,0);
                            SetPlayerHealth(playerid, 100);
                            SetPlayerVirtualWorld(playerid,0);
                            InteriorAtual[playerid] = 0;
                }
                //IrAviao(playerid);
                return true;
            }
        }
    }
    if(!gPlayerLogged[playerid]){
        if(clickedid == VirtualBoost[12]){//Logar

            CarregarRegistro(playerid);

            foreach(new i: Player)
            {
                CreateDynamicObject(16362, 1481.8105, -1722.7473, 15.6074, 0.0000, 0.0000, -90.0999); //desn2_tscanopy
            }

            if(gPlayerAccount[playerid] == 1){
                new loginstring[255];
                new loginname[64];
                GetPlayerName(playerid,loginname,sizeof(loginname));
                format(loginstring,sizeof(loginstring),"{ffffff}Bem Vindo ao {ffffff}{ffffff}Virtual {aaacae}Boost{ffffff} {ffffff}RPG!\n\nSua conta: {df5454}%s{ffffff}.\n{ffffff}Status: {818689}Registrada{ffffff}.\n\n{818689}Insira a Senha Abaixo para logar:",loginname);
                ShowPlayerDialog(playerid, 1, DIALOG_STYLE_PASSWORD," ",loginstring,"Logar","Ajuda");
                ClearChatbox(playerid, 100);
                SendClientMessage(playerid, COR_START2, "[CONTA] Sua conta esta registrada, digite a sua senha para logar!");
                if(PlayerMobile[playerid] == true)
                {
                    CancelSelectTextDraw(playerid);
                }
            }
            else if(gPlayerAccount[playerid] == 0){
                new loginstring[300];
                new loginname[64];
                GetPlayerName(playerid,loginname,sizeof(loginname));
                format(loginstring,sizeof(loginstring),"{ffffff}Bem Vindo ao Servidor: {df5454}%s{ffffff}!\n\n{818689}Este Nick nao esta registrado, para registrar\ninsira abaixo uma senha com 3 a 16 digitos\nuse somente numeros.\n\n{fa4c4c}OBS: {ffffff}Certifique-se de que Voce nao vai esquecer!\n\n{818689}Insira uma senha Abaixo:",loginname);
                ShowPlayerDialog(playerid, 2, DIALOG_STYLE_PASSWORD,"{ffffff}{ffffff}Virtual {aaacae}Boost{ffffff} {ffffff}- Registro",loginstring,"Registrar","Ajuda");
                SendClientMessage(playerid, COR_START2, "[CONTA] Sua conta nao esta registrada, digite uma senha para se registrar.");
                if(PlayerMobile[playerid] == true)
                {
                    CancelSelectTextDraw(playerid);
                }
            }
        }
        else if(clickedid == VirtualBoost[13])
        {
            //SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Este sistema ainda esta em construcao, para recuperar a senha contate algum administrador no discord.");
            ShowPlayerDialog(playerid, 12869, DIALOG_STYLE_INPUT, "Recuperacao de Senha", "{ffffff}Voce esta preste a recuperar o Nick e a senha de sua conta.\n\n{FA4C4C}OBS: {818689}Devera informar o discord que vinculou em\nsua conta corretamente.\n\n{FA4C4C}* {818689}Caso nao se lembre de seu discord, chame um admin no discord\npara lhe puxar para a call de recuperacao de contas.\n\n{ffffff}Discord para Suporte: {228B22}VBSTAFF#0001\n\n{818689}Insira abaixo o discord vinculado em sua conta:", "Confirmar", "Cancelar");
        }
        else if(clickedid == VirtualBoost[14])
        {
            ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX, " ", "Em BREVE", "Entendi", "");
        }
        else if(clickedid == textTelaLogin[11]){//Novidades

            //ForT:infoserver(playerid);
        }
        else if(clickedid == VirtualBoost[17]){//Novidades

            hideTelaLogin(playerid);
            //GameTextForPlayer(playerid, "~r~Desconectado", 5000, 1);
            SendClientMessage(playerid, COR_START, "Voce foi desconectado do servidor, para fechar o GTA digite: /q no CHAT.");
        //  SetTimerEx("KickTime", 1000, false, "i", playerid);
            Kick(playerid);
        }
        else if(clickedid == textTelaLogin[10]){//Sair

            //ForT:changelogs(playerid);
        }
        else if(clickedid == VirtualBoost[15]){
            ForT:creditos(playerid);
        }
        else if(clickedid == textTelaLogin[14]){
            ForT:discord(playerid, #);
        }
        else{

            SelectTextDraw(playerid,0xFFFFFFFF);
        }
        return 1;
    }
    if(clickedid == Text:INVALID_TEXT_DRAW){
        if(InventarioAberto[playerid] == 1){

            InventarioAberto[playerid] = 0;
            CancelSelectTextDraw(playerid);
            FecharInventario(playerid);
            CombinandoInv[playerid] = 0;
            MovendoInv[playerid] = 0;
            return 1;
        }
    }
    return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    if(playertextid == EditorMobile[playerid][4])
    {
        ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX, " ", "{df5454}Editor: {ffffff}Voce cancelou a edicao do Objeto, ele voltou\npara a sua posicao de inicio.\n\n{df5454}Sistema em Fase de Testes: {ffffff}Caso ache algum BUG, reporte no {df5454}/bug.", "Fechar", "");
        return 1;
    }
    if(playertextid == invText[playerid][1]){ //voltar
        if(InventarioPagina[playerid] == 1) return 1;
        InventarioPagina[playerid] -= 1;
        AtualizarInventario(playerid);
        return 1;
    }
    if(playertextid == invText[playerid][2]){ //proximo
        if(InventarioPagina[playerid] == 5) return 1;
        InventarioPagina[playerid] += 1;
        AtualizarInventario(playerid);
        return 1;
    }
    if(playertextid == PlayerText:INVALID_TEXT_DRAW){
        if(TeladeLogin[playerid] == true){
            for(new i = 7; i < 40; i++){

                TextDrawShowForPlayer(playerid, VirtualBoost[i]);
                //BoxAberto[playerid] = 0;
            }
            SelectTextDraw(playerid, 0xAFAFAFAA);
            return 1;
        }
    }
    if(playertextid == TDEditor_PTD[playerid][3])
    {
            SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == TDEditor_PTD[playerid][4])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == TDEditor_PTD[playerid][5])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == TDEditor_PTD[playerid][6])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == TDEditor_PTD[playerid][7])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == TDEditor_PTD[playerid][8])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == TDEditor_PTD[playerid][9])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == TDEditor_PTD[playerid][10])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == TDEditor_PTD[playerid][11])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O inventario da Casa esta em Desenvolvimento! Ainda nao esta disponivel.");
    }// 3 ao 8
    if(playertextid == invText[playerid][6])
    {
        FecharInventario(playerid);
        CancelSelectTextDraw(playerid);
        //PlayerTextDrawHide(playerid, invText[playerid][16]);
        return 1;
    }

    if(playertextid == TDEditor_PTD[playerid][23])
    {
        MEGAString[0] = EOS;
        format(stringZCMD, sizeof(stringZCMD), "{ffffff}**\t**\n");
        strcat(MEGAString,stringZCMD);
        format(stringZCMD, sizeof(stringZCMD), "{ffffff}Maconha Escondida\t{818689}Guardar Maconha\n");
        strcat(MEGAString,stringZCMD);
        format(stringZCMD, sizeof(stringZCMD), "{ffffff}Maconha Escondida\t{818689}Pegar Maconha\n");
        strcat(MEGAString,stringZCMD);
        ShowPlayerDialog(playerid, 300, DIALOG_STYLE_TABLIST_HEADERS, "Configuracoes Sistemas", MEGAString, "Alterar", "Sair");
        return 1;
    }


    if(playertextid == TDEditor_PTD[playerid][23])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}Esse sistema ainda nao existe! sera adicionado na Proxima manutencao do Servidor.");
    }
    if(playertextid == TDEditor_PTD[playerid][24])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}Esse sistema ainda nao existe! sera adicionado na Proxima manutencao do Servidor.");
    }
    if(playertextid == TDEditor_PTD[playerid][25])
    {
        SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}Esse sistema ainda nao existe! sera adicionado na Proxima manutencao do Servidor.");
    }
    if(playertextid == TDEditor_PTD[playerid][22])
    {
//      new Str[8000];
        SendClientMessage(playerid, -1, "Gerencie sua Casa.");
        ShowPlayerDialog(playerid, 225, DIALOG_STYLE_LIST,"{ffffff}{ffffff}Virtual {aaacae}Boost{ffffff} {ffffff}RPG {ffffff}> Menu Casa > {818689}Gerenciar", "Maconha\nCrack\nSaldo Cofre\nOutras Definicoes","Selecionar","Fechar");
    }
    if(playertextid == TDEditor_PTD[playerid][26])
    {
        new Str[850];
        format(Str, sizeof(Str), "{ffffff}Seu Nick: {df5454}%s{ffffff} ||  ID da Casa: {df5454}%d", PlayerName(playerid), PlayerInfo[playerid][pPHousekey])
        strcat(Str,stringZCMD);
        ShowPlayerDialog(playerid, 226, DIALOG_STYLE_MSGBOX,"{818689}Ca{df5454}sa {ffffff}> {818689}Gerenciar", Str,"Informado","");
    }
    if(playertextid == TDEditor_PTD[playerid][2])
    {
        for(new i; i > 27; i++)
        {
            PlayerTextDrawHide(playerid, TDEditor_PTD[playerid][i]);
        }
        PlayerTextDrawHide(playerid, TDEditor_PTD[playerid][20]);
        PlayerTextDrawHide(playerid, TDEditor_PTD[playerid][21]);
        PlayerTextDrawHide(playerid, TDEditor_PTD[playerid][22]);
        PlayerTextDrawHide(playerid, TDEditor_PTD[playerid][23]);
        PlayerTextDrawHide(playerid, TDEditor_PTD[playerid][24]);
        PlayerTextDrawHide(playerid, TDEditor_PTD[playerid][25]);
        PlayerTextDrawHide(playerid, TDEditor_PTD[playerid][26]);

        MenuCasaAberto[playerid] = false;
        //ForT:saircelular(playerid);
        return 1;
    }

    if(playertextid == invText[playerid][8]){

        for(new i = 7; i < 16; i++){

            PlayerTextDrawHide(playerid, invText[playerid][i]);
            BoxAberto[playerid] = 0;
        }
        SelectTextDraw(playerid, 0xAFAFAFAA);
    }
    for(new i = 0; i < 75; i++){

        if(playertextid == invPreview[playerid][i]){

            if(MovendoInv[playerid] == 0 || CombinandoInv[playerid] == 0){

                PlayerTextDrawShow(playerid, invText[playerid][7]);
                //PlayerTextDrawShow(playerid, invText[playerid][16]);
                PlayerTextDrawShow(playerid, invText[playerid][8]);
                PlayerTextDrawShow(playerid, invText[playerid][9]);
                PlayerTextDrawShow(playerid, invText[playerid][10]);
                PlayerTextDrawShow(playerid, invText[playerid][11]);
                PlayerTextDrawShow(playerid, invText[playerid][12]);
                PlayerTextDrawShow(playerid, invText[playerid][13]);
                PlayerTextDrawShow(playerid, invText[playerid][14]);
                PlayerTextDrawShow(playerid, invText[playerid][15]);
                //PlayerTextDrawShow(playerid, invText[playerid][16]);
                BoxAberto[playerid] = 1;
            }

            if(CombinandoInv[playerid] == 1)
            {
                if(InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot] != InventarioInfo[playerid][i][iSlot]){

                    CombinandoInv[playerid] = 0;
                    SelectTextDraw(playerid, 0xAFAFAFAA);
                    SendClientMessage(playerid, 0xFF6347AA, "* nao foi possivel combinar os dois itens!");

                    return 1;
                }
                if(ItemSelecionado[playerid] == i){

                    CombinandoInv[playerid] = 0;
                    SelectTextDraw(playerid, 0xAFAFAFAA);
                    SendClientMessage(playerid, 0xFF6347AA, "* nao foi possivel combinar os dois itens!");
                    return 1;
                }

                InventarioInfo[playerid][i][iUnidades] += InventarioInfo[playerid][ItemSelecionado[playerid]][iUnidades];
                InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot] = 19382;
                InventarioInfo[playerid][ItemSelecionado[playerid]][iUnidades] = 0;
                AtualizarInventario(playerid);
                SelectTextDraw(playerid, 0xafafafaa);
                CombinandoInv[playerid] = 0;
                PlayerTextDrawHide(playerid, invText[playerid][7]);
                PlayerTextDrawHide(playerid, invText[playerid][8]);
                PlayerTextDrawHide(playerid, invText[playerid][9]);
                PlayerTextDrawHide(playerid, invText[playerid][10]);
                //PlayerTextDrawHide(playerid, invText[playerid][16]);
                PlayerTextDrawHide(playerid, invText[playerid][11]);
                PlayerTextDrawHide(playerid, invText[playerid][12]);
                PlayerTextDrawHide(playerid, invText[playerid][13]);
                PlayerTextDrawHide(playerid, invText[playerid][14]);
                PlayerTextDrawHide(playerid, invText[playerid][15]);
                BoxAberto[playerid] = 0;

            }

            if(MovendoInv[playerid] == 1)
            {
                if(InventarioInfo[playerid][i][iSlot] != 19382)
                    return MovendoInv[playerid] = 0,
                    SelectTextDraw(playerid, 0xAFAFAFAA),
                    SendClientMessage(playerid, 0xFF6347AA, "* nao foi possivel mover este item!");

                MovendoInv[playerid] = 0;
                InventarioInfo[playerid][i][iSlot] = InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot];
