          {
               //new vehicle = GetPlayerVehicleID(playerid);
               format(gstring, sizeof(gstring), "~g~%s",Nomedosveiculos[GetVehicleModel(GetPlayerVehicleID(playerid))-400]);
               GameTextForPlayer(playerid, gstring, 6000, 1);
          }
     }
     if(newstate == PLAYER_STATE_PASSENGER) // TAXI, BUSSES, BOTS
     {
          new name[MAX_PLAYER_NAME];
          GetPlayerName(playerid, name, sizeof(name));
          new vehicleid = GetPlayerVehicleID(playerid);
          foreach(new i: Player)
          {
               if(IsPlayerConnected(i))
               {
                    if(IsPlayerInVehicle(i, vehicleid) && GetPlayerState(i) == 2 && TransportDuty[i] > 0)
                    {
                         if(GetPlayerMoneyEx(playerid) < TransportValue[i])
                         {
                              format(gstring, sizeof(gstring), "* Voce precisa de R$%d para entrar.", TransportValue[i]);
                              SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                              RemovePlayerFromVehicleEx(playerid);
                         }
                         else
                         {
                              if(TransportDuty[i] == 1)
                              {
                                   format(gstring, sizeof(gstring), "* Pagou R$[%d] para o Taxista.", TransportValue[i]);
                                   SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                                   format(gstring, sizeof(gstring), "* Passageiro %s entrou no Taxi.", name);
                                   SendClientMessage(i, COR_LIGHTBLUE, gstring);
                                   TransportTime[i] = 1;
                                   TransportTime[playerid] = 1;
                                   TransportCost[playerid] = TransportValue[i];
                                   TransportCost[i] = TransportValue[i];
                                   TransportDriver[playerid] = i;
                              }
                              else if(TransportDuty[i] == 2)
                              {
                                   format(gstring, sizeof(gstring), "* Pagou R$[%d] para o Motorista De Onibus.", TransportValue[i]);
                                   SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                                   format(gstring, sizeof(gstring), "* Passageiro %s entrou no Onibus.", name);
                                   SendClientMessage(i, COR_LIGHTBLUE, gstring);
                              }
                              GivePlayerMoneyEx(playerid, - TransportValue[i]);
                              TransportMoney[i] += TransportValue[i];
                         }
                    }
               }
          }
     }
     if(newstate == PLAYER_STATE_DRIVER)
     {
          new newcar = GetPlayerVehicleID(playerid);
          new oldcar = gLastCar[playerid];
          new HouseCar = PlayerInfo[playerid][pPHousekey];
          TelePos[playerid][0] = 0.0;
          TelePos[playerid][1] = 0.0;
          new carid = GetVehicleModel(newcar);

          new carvip[65];
          new carfixo[65];
          format(carvip, sizeof(carvip), Pasta_CarrosVIP, newcar);
          if(DOF2_FileExists(carvip))
          {
               format(gstring,sizeof(gstring),"Voce entrou no carro vip do jogador %s.", DOF2_GetString(carvip, "Dono"));
               SendClientMessage(playerid, COR_COSA, gstring);
          }
          format(carfixo, sizeof(carfixo), Pasta_CarrosFixo, newcar);
          if(DOF2_FileExists(carfixo))
          {
               format(gstring,sizeof(gstring),"Voce entrou no carro fixo do jogador %s.", DOF2_GetString(carfixo, "Dono"));
               SendClientMessage(playerid, COR_COSA, gstring);
          }
          if(MaletaAnexada[playerid] == 1 && TanoWarZone[playerid] == 1)
          {
                GetPlayerPos(playerid,maletax,maletay,maletaz);
                maletaid = CreateDynamicObject(1210,maletax,maletay,maletaz-0.8,0,0,0.0);
                MaletaAnexada[playerid] = 0;
                StopPlayerHoldingObject(playerid);
                MaletaEmUso = 0;
                DestroyDynamicObject(maletaid);
          }
          if(LixeiroCarros(newcar))
          {
                if(LoadedTrash[newcar] > 0) {
                    new string[128];
