START::PiscarFarol(playerid)
{
     new vid = GetPlayerVehicleID(playerid);
     new panelsx,doorsx,lightsx,tiresx;
     if(GetPlayerState(playerid) == 2)
     {
          if(alarmeativado[vid] == 1)
          {
               GetVehicleDamageStatus(vid,panelsx,doorsx,lightsx,tiresx);
               UpdateVehicleDamageStatus(vid, panelsx, doorsx, 4, tiresx);
               alarmeativado[vid] = 0;
          }
          else if(alarmeativado[vid] == 0)
          {
               GetVehicleDamageStatus(vid,panelsx,doorsx,lightsx,tiresx);
               UpdateVehicleDamageStatus(vid, panelsx, doorsx, 1, tiresx);
               alarmeativado[vid] = 1;
          }
     }
     return 1;
}
