            NaPorraDoEvento[playerid] = false;
            return 1;
        }
        if(response == 1)
        {
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_PM,"Voce esta preso e nao pode ir!");
                NaPorraDoEvento[playerid] = false;
                return 0;
            }
            if(Roubando[playerid] == 1)
            {
                SendClientMessage(playerid,COR_PM,"Voce esta Roubando e Nao pode ir no Evento agora!");
                NaPorraDoEvento[playerid] = false;
                return 0;
            }
            if(WantedLevel[playerid] > 0)
            {
                SendClientMessage(playerid,COR_PM,"Voce nao pode ir no evento estando procurado!");
                NaPorraDoEvento[playerid] = false;
                return 0;
            }
            if(ColorMatchStage == STAGE_PLAYING) return SendClientMessage(playerid, 0xE74C3CFF, "ERRO: {FFFFFF}O Evento: [COLOR MATCH], ja foi iniciado.");
            if(ColorMatchPlayers >= CM_MAX_PLAYERS) return SendClientMessage(playerid, 0xE74C3CFF, "ERRO: {FFFFFF}O Color Match Esta Cheio.");
            ColorMatchPlayers++;
            InCMEvent[playerid] = true;
            NaPorraDoEvento[playerid] = true;
            ResetPlayerWeapons(playerid);
            new Float: x, Float: y, Float: z;
            GetObjectPos(ColorMatchObjects[ random(9) ], x, y, z);
            SetPlayerPos(playerid, x + frandom(1.0, -1.0), y + frandom(1.0, -1.0), z + 1.0);
            SetPlayerVirtualWorld(playerid, 1);
            format(string, sizeof(string), "[COLORMATCH] {FFFFFF}Voce esta participando do {F1C40F}ColorMatch. {FFFFFF}Jogadores: [%d/%d]", ColorMatchPlayers-1, CM_MAX_PLAYERS);
            SendClientMessage(playerid, 0x3498DBFF, string);
            SendClientMessage(playerid, 0x3498DBFF, "[COLORMATCH] {FFFFFF}Aguarde o tempo para iniciar a partida.");
            SendClientMessage(playerid, 0x3498DBFF, "[COLORMATCH] {FFFFFF}Objetivo: Ir na COR do texto da mensagem, o nome do texto ignore!");
        }
        return 1;
    }
