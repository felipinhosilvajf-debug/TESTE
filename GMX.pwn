                    SendClientMessage(playerid, COR_AMARELO, "Voce precisa ter 5 Moedas para comprar uma caixa de armas !");
                    return 1;
                }
                /*for(new i=0; i<75; i++)
                {
                    if(InventarioInfo[playerid][i][iSlot] == 19382)
                    {
                        InventarioInfo[playerid][i][iSlot] = 964;
                        InventarioInfo[playerid][i][iUnidades] += 1;
                        break;
                    }
                }*/
                PlayerInfo[playerid][pCoins] -= 5;
                SendClientMessage(playerid, COR_AMARELO, "Voce adquiriu uma caixa de armas ela foi para seu inventario !");
                return 1;
            }
        }
        return 1;
    }
    if(listid == carrosviplist)
    {
        if(response)
        {
            new arquivo[64];
            new carid;
            carid = GetPlayerVehicleID(playerid);
            if(carid == PlayerInfo[playerid][pCarKey])
            {
                format(arquivo, sizeof(arquivo), Pasta_CarrosVIP, carid);
                if(DOF2_FileExists(arquivo))
                {
                    if(!strcmp(DOF2_GetString(arquivo, "Dono"), PlayerName(playerid)))
                    {
                        if(carid == PlayerInfo[playerid][pCarKey])
                        {
                            DOF2_SetInt(arquivo, "ModeloCarro", modelid);
                            DOF2_SaveFile();
                            DestroyVehicle(carid);
                            carrovip[playerid] = CreateVehicle(DOF2_GetInt(arquivo, "ModeloCarro"),DOF2_GetFloat(arquivo, "PosX"),DOF2_GetFloat(arquivo, "PosY"),DOF2_GetFloat(arquivo, "PosZ")+1.0,DOF2_GetFloat(arquivo, "Angulo"),DOF2_GetInt(arquivo, "cor1"),DOF2_GetInt(arquivo, "cor2"),-1);
                            TogglePlayerControllable(playerid, 1);
                            GivePlayerMoneyEx(playerid, -1000);
                            GameTextForPlayer(playerid, "~y~Âº MODELO DO SEU CARRO VIP~n~MUDADO! -R$1000 Âº.", 10000, 3);
                            return 1;
                        }
                    }
                }
                SendClientMessage(playerid, COR_LIGHTBLUE, "Modelo modificado !");
            }
            else if(carid == PlayerInfo[playerid][pCarFixo])
            {
                format(arquivo, sizeof(arquivo), Pasta_CarrosFixo, carid);
                if(DOF2_FileExists(arquivo))
                {
                    if(!strcmp(DOF2_GetString(arquivo, "Dono"), PlayerName(playerid)))
                    {
                        if(carid == PlayerInfo[playerid][pCarFixo])
                        {
                            DOF2_SetInt(arquivo, "ModeloCarro", modelid);
                            DOF2_SaveFile();
                            DestroyVehicle(carid);
                            carrofixo[playerid] = CreateVehicle(DOF2_GetInt(arquivo, "ModeloCarro"),DOF2_GetFloat(arquivo, "PosX"),DOF2_GetFloat(arquivo, "PosY"),DOF2_GetFloat(arquivo, "PosZ")+1.0,DOF2_GetFloat(arquivo, "Angulo"),DOF2_GetInt(arquivo, "cor1"),DOF2_GetInt(arquivo, "cor2"),-1);
                            TogglePlayerControllable(playerid, 1);
                            GivePlayerMoneyEx(playerid, -1000);
                            GameTextForPlayer(playerid, "~y~Âº MODELO DO SEU CARRO FIXO~n~MUDADO! -R$1000 Âº.", 10000, 3);
                            return 1;
                        }
                    }
                }
                SendClientMessage(playerid, COR_LIGHTBLUE, "Modelo modificado !");
            }
        }
        else SendClientMessage(playerid, COR_BRANCO, "Voce nao escolheu nenhum modelo.");
        return 1;
    }
    if(listid == housecarfreelist || listid == housecarsoclist || listid == housecarviplist)
    {
        if(response)
        {
            new carid = PlayerInfo[playerid][pCarroCasa];
            new House = PlayerInfo[playerid][pPHousekey];
            HouseInfo[House][hVec] = modelid;
            SaveCasa(House);
            DestroyVehicle(carid);
            GivePlayerMoneyEx(playerid, -2000);
            PlayerPlaySound(playerid, 1134, 0.0, 0.0, 0.0);
            //AddStaticVehicleEx(HouseInfo[House][hVec], HouseInfo[House][hCarrox], HouseInfo[House][hCarroy], HouseInfo[House][hCarroz], HouseInfo[House][hCarroa], HouseInfo[House][hVcol1], HouseInfo[House][hVcol2], -1);
            SendClientMessage(playerid, COR_LIGHTBLUE, "Modelo modificado, custou R$2.000.");
        }
        else return SendClientMessage(playerid, COR_BRANCO, "Voce nao escolheu nenhum modelo.");
    }
    return 1;
}
START::ChecarAgendado(agendado, playerid)
{
    new arquivo[64], AgendadoTempo, AgendadoDenuncia[64], AdminAgendou[64], string[256];
    if(agendado == 1)
    {
        format(arquivo, sizeof(arquivo), Pasta_Agendados,PlayerName(playerid));
        if(DOF2_FileExists(arquivo))
        {
            strmid(AdminAgendou, DOF2_GetString(arquivo,"Admin"), 0, strlen(DOF2_GetString(arquivo,"Admin")), 255);
            strmid(AgendadoDenuncia, DOF2_GetString(arquivo,"Denuncia"), 0, strlen(DOF2_GetString(arquivo,"Denuncia")), 255);
            AgendadoTempo = DOF2_GetInt(arquivo,"Tempo");
            format(gstring, sizeof(gstring), "AdmCmd: %s foi punido automaticamente ao logar, pelo admin [%s].",PlayerName(playerid), AdminAgendou);
            ABroadCast(COR_LIGHTRED,gstring,1);
            format(gstring, sizeof(gstring), "[Puniao Agendada] %s foi punido automaticamente ao logar por: Minutos[%d] - Avisos[%d] - Motivo:[%d]",PlayerName(playerid),AgendadoTempo, DOF2_GetInt(arquivo,"Avisos"), DOF2_GetString(arquivo,"Denuncia"));
            SendClientMessageToAll(COR_LIGHTRED, gstring);


            format(stringZCMD, sizeof(stringZCMD), "Voce foi avisado por %s, Motivo: %s, Avisos: %d(Carandiru Agendado + Aviso)",DOF2_GetString(arquivo,"Admin"), AdminAgendou, DOF2_GetInt(arquivo,"Avisos"));
            pAvisoLog(playerid, stringZCMD);


            GameTextForPlayer(playerid, "~b~Bem Vindo ao ~n~~r~Carandiru", 5000, 3);
            SetPlayerInterior(playerid, 0);
            if(PlayerInfo[playerid][pSex] == 2) {  SetPlayerSkin(playerid, 69); }
            if(PlayerInfo[playerid][pSocio] >= 1) {  SetPlayerSkin(playerid, 42); }
            ResetPlayerWeaponsEx(playerid);
            PlayerInfo[playerid][pAvisos] += DOF2_GetInt(arquivo,"Avisos");
            WantedLevel[playerid] = 0;
            SetPlayerWantedLevelEx(playerid, 0);
            PlayerInfo[playerid][pPenitenciaria] = 2;
            PlayerInfo[playerid][pJailed] = 2;
            PlayerInfo[playerid][pJailTime] = AgendadoTempo * 60;
            SetPlayerPos(playerid, 268.58, 1857.94, 9.81);
            SetPlayerWorldBounds(playerid, 337.5694,101.5826,1940.9759,1798.7453);
            SetPlayerChatBubble(playerid, ".", COR_VERMELHO, 1, 1);
            if(PlayerInfo[playerid][pAvisos] >= 3)
            {
                SendClientMessage(playerid, COR_AMARELO, "Sua Conta contem tem 3 Avisos!");
                SendClientMessage(playerid, COR_AMARELO, "Voce foi banido automaticamente por 2 meses!");
                format(string, sizeof(string), "[BAN]: %s foi banido por 2 meses, Motivo[3Âº Aviso]", PlayerName(playerid));
                BanTempLog(string);
                format(string, sizeof(string), "[BAN]: %s foi banido por 2 meses, Motivo[3Âº Aviso]", PlayerName(playerid));
                SendClientMessageToAll(COR_LIGHTRED, string);
                getdate(Ano, Mes, Dia);
                PlayerInfo[playerid][pDiaBanTemp] = Dia;
                if(Mes == 11)
                {
                    PlayerInfo[playerid][pMesBanTemp] = 1;
                    PlayerInfo[playerid][pAnoBanTemp] = Ano+1;
                }
                else if(Mes == 12)
                {
                    PlayerInfo[playerid][pMesBanTemp] = 2;
                    PlayerInfo[playerid][pAnoBanTemp] = Ano+1;
                }
                else if(Mes <= 10)
                {
                    PlayerInfo[playerid][pMesBanTemp] = Mes+2;
                    PlayerInfo[playerid][pAnoBanTemp] = Ano;
                }
                BanTemp(playerid, "Terceiro aviso", PlayerName(playerid));
                PlayerInfo[playerid][pAvisos] = 0;
            }
            fremove(arquivo);
        }
        return 1;
    }
    return 1;
}
START::ChecarAgendadoMoedas(agendadoMoedas, playerid)
{
    new arquivo[64], AdminAgendou[64], string[256];
    if(agendadoMoedas == 1)
    {
        format(arquivo, sizeof(arquivo), Pasta_Moedas,PlayerName(playerid));
        if(DOF2_FileExists(arquivo))
        {
            strmid(AdminAgendou, DOF2_GetString(arquivo,"Admin"), 0, strlen(DOF2_GetString(arquivo,"Admin")), 255);
            PlayerInfo[playerid][pReceberCoins] += DOF2_GetInt(arquivo,"Coins");
            format(string, sizeof(string), "[Moedas VBR] Voce recebeu:[%d] Moedas, para vende-las, use: /vendermoedas. Obrigado pela sua doacao", DOF2_GetInt(arquivo,"Coins"));
            SendClientMessage(playerid, COR_AMARELO, string);
            DOF2_RemoveFile(arquivo);
            fremove(arquivo);
        }
        return 1;
    }
    return 1;
}
START::ChecarAnuncioVendido(playerid)
{
    new string[100];
    if(PlayerInfo[playerid][pAnuncioCoins] >= 1)
    {
        new arquivo[64];
        format(arquivo, sizeof(arquivo), Pasta_AnuncioVendido,PlayerName(playerid));
        if(DOF2_FileExists(arquivo))
        {
            new NomeAnuncio[MAX_PLAYER_NAME];
            new NomeComprador[MAX_PLAYER_NAME];
            new CoinsAnuncio;
            new VendaAnuncio;
            VendaAnuncio = DOF2_GetInt(arquivo, "Venda");
            CoinsAnuncio = DOF2_GetInt(arquivo, "Coins");
            strmid(NomeAnuncio, DOF2_GetString(arquivo,"Jogador"), 0, strlen(DOF2_GetString(arquivo,"Jogador")), 255);
            strmid(NomeComprador, DOF2_GetString(arquivo,"Comprador"), 0, strlen(DOF2_GetString(arquivo,"Comprador")), 255);
            if(strcmp(PlayerName(playerid), NomeAnuncio, true) == 0)
            {
                PlayerInfo[playerid][pCoins] -= CoinsAnuncio;
                PlayerInfo[playerid][pConta] += VendaAnuncio;
                PlayerInfo[playerid][pAnuncioCoins] = 0;
                format(string, sizeof(string), "[Moedas Venda]: Voce vendeu: [%d] Moedas para %s, por R$:[%d].", CoinsAnuncio, NomeComprador, VendaAnuncio);
                SendClientMessage(playerid, COR_VAGOS, string);
                SendClientMessage(playerid, COR_LIGHTRED, "[ATENcao]: Dinheiro depositado no banco!");
                DOF2_RemoveFile(arquivo);
                return 1;
            }
        }
    }
    return 1;
}
START::CarrosFixados(vehicleid)
{
     new arquivo[64];
     format(arquivo, sizeof(arquivo), Pasta_CarrosFixados, vehicleid);
     if(DOF2_FileExists(arquivo))
     {
          SetVehiclePos(vehicleid, DOF2_GetFloat(arquivo,"PosX"), DOF2_GetFloat(arquivo,"PosY"), DOF2_GetFloat(arquivo,"PosZ"));
          SetVehicleZAngle(vehicleid, DOF2_GetFloat(arquivo,"Angulo"));
     }
     return 1;
}

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
    if(PlayerInfo[playerid][pAdmin] >= 1338)
    {
        SetPVarFloat(playerid, "VBSTAFFX", fX);
        SetPVarFloat(playerid, "VBSTAFFY", fY);
        SetPVarFloat(playerid, "VBSTAFFZ", fZ);
        format(stringZCMD, sizeof stringZCMD, "* Voce marcou no mapa: Algum Local(**m de Voce), para ir ate la, use: /irmapa.");
        SendClientMessage(playerid, COR_SHOX, stringZCMD);

        format(stringZCMD, sizeof stringZCMD, "Anti-Cheat: %s[%d] marcou um local no mapa, pode ser Teleporte Hack, fique de olho!", PlayerName(playerid), playerid);
        ABroadCast(COR_OBS,stringZCMD,1);
        MarcouMapa[playerid] = true;
        //ShowPlayerDialog(playerid, 4600, DIALOG_STYLE_MSGBOX, "Teleporte Mapa", "Voce deseja ir ao local que Voce marcou no mapa?", #Sim, #nao);
    }
    return 1;
}
stock VerificarVip(playerid)
{
    new dia,mes,ano;
    getdate(ano,mes,dia);
    if(PlayerInfo[playerid][pDiaVIP] > 0)
    {

        if(PlayerInfo[playerid][pLogouHoje] != dia)
        {

            PlayerInfo[playerid][pDiaVIP] -= 1;
            PlayerInfo[playerid][pLogouHoje] = dia;
            //SendClientMessage(playerid, COR_CV, "[VBR Aviso]: Foi descontado [-1] dia do seu beneficio! Confira no RG(/rg) os dias restantes.");
        }
    }
    if(PlayerInfo[playerid][pDiaVIP] <= 0)
    {

        PlayerInfo[playerid][pDiaVIP] = 0;
        if(PlayerInfo[playerid][pCarKey] > 0)
        {

            new file[64];
            format(file, sizeof(file), Pasta_CarrosVIP, PlayerInfo[playerid][pCarKey]);
            if(!strcmp(DOF2_GetString(file, "Dono"), PlayerName(playerid)))
            {

                PlayerInfo[playerid][pCarKey] = 0;
                PlayerInfo[playerid][pOldCarKey] = 0;
                DestroyVehicle(playerid);
                DOF2_RemoveFile(file);
            }
        }
        if(PlayerInfo[playerid][pVIP] > 0)
        {

        if(PlayerInfo[playerid][pSocio] > 0)
            {
                PlayerInfo[playerid][pSocio] = 0;
                //SendClientMessage(playerid, COR_CV, "[VBR Aviso]: Seu Socio chegou ao fim! Renove-o, e receba seus beneficios novamente!");
            }
            else
            {
                PlayerInfo[playerid][pVIP] = 0;
                //SendClientMessage(playerid, COR_CV, "[VBR Aviso]: Seu VIP chegou ao fim! Renove-o, e receba seus beneficios novamente!");
            }
        }
        new h = PlayerInfo[playerid][pPHousekey];
        if(strlen(HouseInfo[h][hType]) > 2 && strfind(HouseInfo[h][hType], "Mansao Socio", true) != -1 || strlen(HouseInfo[h][hType]) > 2 && strfind(HouseInfo[h][hType], "VIP", true) != -1)
        {
            if(PlayerInfo[playerid][pVIP] == 0)
            {
//              ForT:vendercasa(playerid, #);
//              SendClientMessage(playerid, -1, "Sua casa foi vendida automatica.");
            }
        }
        if(PlayerInfo[playerid][pPbiskey] < 255)
        {
            if(PlayerInfo[playerid][pPbiskey] >= 100 && PlayerInfo[playerid][pPbiskey] < 200 && strcmp(PlayerName(playerid), SBizzInfo[PlayerInfo[playerid][pPbiskey]-100][sbOwner], true) == 0)
            {
                new borse = PlayerInfo[playerid][pPbiskey]-100;
                SBizzInfo[borse][sbLocked] = 0;
                SBizzInfo[borse][sbOwned] = 0;
                strmid(SBizzInfo[borse][sbOwner], "The State", 0, strlen("The State"), 255);
                strmid(SBizzInfo[borse][sbExtortion], "Ninguem", 0, strlen("Ninguem"), 255);
                PlayerInfo[playerid][pPbiskey] = 255;
                Atualizar3Dtexts();
                SalvarSEmpresa(borse);
            }
            else if(strcmp(PlayerName(playerid), BizzInfo[PlayerInfo[playerid][pPbiskey]][bOwner], true) == 0)
            {
                new borse = PlayerInfo[playerid][pPbiskey];
                BizzInfo[borse][bLocked] = 0;
                BizzInfo[borse][bOwned] = 0;
                strmid(BizzInfo[borse][bOwner], "The State", 0, strlen("The State"), 255);
                strmid(BizzInfo[borse][bExtortion], "Ninguem", 0, strlen("Ninguem"), 255);
                PlayerInfo[playerid][pPbiskey] = 255;
                Atualizar3Dtexts();
                SalvarEmpresa(borse);
            }
            if(PlayerInfo[playerid][pPFazkey] < 255 && strcmp(PlayerName(playerid), FBizzInfo[PlayerInfo[playerid][pPFazkey]][fbOwner], true) == 0)
            {
                new borse = PlayerInfo[playerid][pPFazkey];
                FBizzInfo[borse][fbLocked] = 0;
                FBizzInfo[borse][fbOwned] = 0;
                strmid(FBizzInfo[borse][fbOwner], "The State", 0, strlen("The State"), 255);
                strmid(FBizzInfo[borse][fbExtortion], "Ninguem", 0, strlen("Ninguem"), 255);
                PlayerInfo[playerid][pPFazkey] = 255;
                Atualizar3Dtexts();
                SalvarFEmpresa(borse);
            }
        }
    }
    return 1;
}
START::VerBanSerial(playerid)
{
    new Dialog[500];
    new ip[150];
    GetPlayerIp(playerid, ip, sizeof ip);
    if(fexist(GetPlayerSerialINI(playerid)))
    {
        GameTextForPlayer(playerid, "~r~CONTA BANIDA", 10000, 3);
        //SendClientMessage(playerid,COR_START,"{df5454}MySQL: {ffffff}Nosso banco de dados acaba de detectar que seu Serial esta banido!");
        format(Dialog, sizeof(Dialog),"{818689}Conta: %s\nIP: %s\nAdmin: ****\nMotivo: Serial Banido\n\n{ffffff}Acha isso um erro? Faca Revisao!\n\n{df5454}https://discord.gg/9QP6UnS6xd",PlayerName(playerid),ip,BanInfo[playerid][pAdmBan]);
        ShowPlayerDialog(playerid,DSFUNCAO,DIALOG_STYLE_MSGBOX, "Informacoes do Banimento",Dialog, "Fechar","");
        Kick(playerid);
    }
    return 1;
}
START::VerBan(playerid)
{
     new ip[150];
     new bannick[256];
     new banip[256];
     new Dialog[1500];
     GetPlayerIp(playerid, ip, sizeof ip);
     format(bannick, sizeof(bannick), Pasta_Banidos, PlayerName(playerid));
     format(banip, sizeof(banip), Pasta_IPBanidos, ip);
     if(DOF2_FileExists(bannick) || DOF2_FileExists(banip))
     {
          strmid(BanInfo[playerid][pMotivo], DOF2_GetString(bannick,"Motivo"), 0, strlen(DOF2_GetString(bannick,"Motivo")), 255);
          strmid(BanInfo[playerid][pAdmBan], DOF2_GetString(bannick,"Admin"), 0, strlen(DOF2_GetString(bannick,"Admin")), 255);
          strmid(BanInfo[playerid][pData], DOF2_GetString(bannick,"Data"), 0, strlen(DOF2_GetString(bannick,"Data")), 255);
          strmid(BanInfo[playerid][pHora], DOF2_GetString(bannick,"Hora"), 0, strlen(DOF2_GetString(bannick,"Hora")), 255);
          //SendClientMessage(playerid,COR_START,"{df5454}MySQL: {ffffff}Nosso banco de dados acaba de detectar que sua Conta esta banida!");
          GameTextForPlayer(playerid, "~r~CONTA BANIDA", 10000, 3);
          format(Dialog, sizeof(Dialog),"{818689}Conta: %s\nIP: %s\nAdmin: %s\nMotivo: %s\n\n{ffffff}Acha isso um erro? Faca Revisao!\n\n{df5454}https://discord.gg/9QP6UnS6xd",PlayerName(playerid),ip,BanInfo[playerid][pAdmBan],BanInfo[playerid][pMotivo]);
          ShowPlayerDialog(playerid, DSFUNCAO, DIALOG_STYLE_MSGBOX, "Informacoes do Banimento",Dialog, "Fechar", "");
          NaoPodeLogar[playerid] = 1;
          Kick(playerid);
     }
     return 1;
}
START::VerBanTemp(playerid)
{
     new ip[150];
     new bannick[128];
     new banip[128];
     new Dialog[1500];
     GetPlayerIp(playerid, ip, sizeof ip);
     getdate(Ano, Mes, Dia);
     format(bannick, sizeof(bannick), Pasta_BanidosTemp, PlayerName(playerid));
     format(banip, sizeof(banip), Pasta_IPBanidosTemp, ip);
     if(DOF2_FileExists(bannick) || DOF2_FileExists(banip))
     {
          if(Dia >= PlayerInfo[playerid][pDiaBanTemp] && Mes >= PlayerInfo[playerid][pMesBanTemp] && Ano >= PlayerInfo[playerid][pAnoBanTemp])
          {
              PlayerInfo[playerid][pDiaBanTemp] = 0;
              PlayerInfo[playerid][pMesBanTemp] = 0;
              PlayerInfo[playerid][pAnoBanTemp] = 0;
              if(DOF2_FileExists(bannick))
              {
                  DOF2_RemoveFile(bannick);
              }
              if(DOF2_FileExists(banip))
              {
                  DOF2_RemoveFile(banip);
              }
              OnPlayerSave(playerid);
              return 1;
          }
          else
          {
              if(DOF2_FileExists(bannick))
              {
                  strmid(BanInfo[playerid][pMotivo], DOF2_GetString(bannick,"Motivo"), 0, strlen(DOF2_GetString(bannick,"Motivo")), 255);
                  strmid(BanInfo[playerid][pAdmBan], DOF2_GetString(bannick,"Admin"), 0, strlen(DOF2_GetString(bannick,"Admin")), 255);
                  strmid(BanInfo[playerid][pData], DOF2_GetString(bannick,"Data"), 0, strlen(DOF2_GetString(bannick,"Data")), 255);
                  strmid(BanInfo[playerid][pHora], DOF2_GetString(bannick,"Hora"), 0, strlen(DOF2_GetString(bannick,"Hora")), 255);
                  strmid(BanInfo[playerid][BanDia], DOF2_GetString(bannick,"DiaBanTemp"), 0, strlen(DOF2_GetString(bannick,"DiaBanTemp")), 255);
                  strmid(BanInfo[playerid][BanMes], DOF2_GetString(bannick,"MesBanTemp"), 0, strlen(DOF2_GetString(bannick,"MesBanTemp")), 255);
                  strmid(BanInfo[playerid][BanAno], DOF2_GetString(bannick,"AnoBanTemp"), 0, strlen(DOF2_GetString(bannick,"AnoBanTemp")), 255);
              }
              else if(DOF2_FileExists(banip))
              {
                  strmid(BanInfo[playerid][pMotivo], DOF2_GetString(banip,"Motivo"), 0, strlen(DOF2_GetString(banip,"Motivo")), 255);
                  strmid(BanInfo[playerid][pAdmBan], DOF2_GetString(banip,"Admin"), 0, strlen(DOF2_GetString(banip,"Admin")), 255);
                  strmid(BanInfo[playerid][pData], DOF2_GetString(banip,"Data"), 0, strlen(DOF2_GetString(banip,"Data")), 255);
                  strmid(BanInfo[playerid][pHora], DOF2_GetString(banip,"Hora"), 0, strlen(DOF2_GetString(banip,"Hora")), 255);
                  strmid(BanInfo[playerid][BanDia], DOF2_GetString(banip,"DiaBanTemp"), 0, strlen(DOF2_GetString(banip,"DiaBanTemp")), 255);
                  strmid(BanInfo[playerid][BanMes], DOF2_GetString(banip,"MesBanTemp"), 0, strlen(DOF2_GetString(banip,"MesBanTemp")), 255);
                  strmid(BanInfo[playerid][BanAno], DOF2_GetString(banip,"AnoBanTemp"), 0, strlen(DOF2_GetString(banip,"AnoBanTemp")), 255);
              }
              //SendClientMessage(playerid,COR_START,"{df5454}MySQL: {ffffff}Nosso banco de dados acaba de detectar que sua Conta esta banida!");
              GameTextForPlayer(playerid, "~r~CONTA BANIDA", 10000, 3);
              format(Dialog, sizeof(Dialog),"{818689}Conta: %s\nIP: %d\nAdmin: %s\nMotivo: %s\nDia do Desban:%02d/%02d/%02d\n\n{ffffff}Acha isso um erro? Faca Revisao!\n\n******* {df5454}https://discord.gg/9QP6UnS6xd *******",PlayerName(playerid),ip,BanInfo[playerid][pAdmBan],BanInfo[playerid][pMotivo],PlayerInfo[playerid][pDiaBanTemp],PlayerInfo[playerid][pMesBanTemp],PlayerInfo[playerid][pAnoBanTemp]);
              ShowPlayerDialog(playerid,DSFUNCAO,DIALOG_STYLE_MSGBOX, "Informacoes do Banimento",Dialog, "Fechar","");
              NaoPodeLogar[playerid] = 1;
              Kick(playerid);
          }
     }
     return 1;
}
START::BanTemp(playerid, string[], string2[])
{
    new arquivo[64], tmp[20], tmp2[20], stri[64], ip[16];
    new Dialog[3000];
    new tMinuto[20], tSegundo[20], tHora[20], tDia[20], tMes[20], tAno[20];
    GetPlayerIp(playerid, ip, sizeof ip);
    format(arquivo, sizeof(arquivo), Pasta_BanidosTemp,PlayerName(playerid));
    getdate(Ano, Mes, Dia);
    format(tmp, 20, "%02d/%02d/%02d", Dia, Mes, Ano);
    gettime(Hora, Minuto, Segundo);
    format(tmp2, 20, "%02d:%02d:%02d", Hora, Minuto, Segundo);
    format(tHora, 20, "%d", Hora);
    format(tMinuto, 20, "%d", Minuto);
    format(tSegundo, 20, "%d", Segundo);
    format(tDia, 20, "%d", PlayerInfo[playerid][pDiaBanTemp]);
    format(tMes, 20, "%d", PlayerInfo[playerid][pMesBanTemp]);
    format(tAno, 20, "%d", PlayerInfo[playerid][pAnoBanTemp]);
    if(DOF2_FileExists(arquivo))
    {
        DOF2_SetString(arquivo,"Motivo",string);
        DOF2_SetString(arquivo,"Admin",string2);
        DOF2_SetString(arquivo,"Data",tmp);
        DOF2_SetString(arquivo,"Hora",tmp2);
        DOF2_SetString(arquivo,"DiaBanTemp",tDia);
        DOF2_SetString(arquivo,"MesBanTemp",tMes);
        DOF2_SetString(arquivo,"AnoBanTemp",tAno);
        DOF2_SetString(arquivo,"HoraBanTemp",tHora);
        DOF2_SetString(arquivo,"MinutoBanTemp",tMinuto);
        DOF2_SetString(arquivo,"SegundoBanTemp",tSegundo);
        DOF2_SaveFile();
        Kick(playerid);
    }
    else
    {
        DOF2_CreateFile(arquivo);
        DOF2_SetString(arquivo,"Motivo",string);
        DOF2_SetString(arquivo,"Admin",string2);
        DOF2_SetString(arquivo,"Data",tmp);
        DOF2_SetString(arquivo,"Hora",tmp2);
        DOF2_SetString(arquivo,"DiaBanTemp",tDia);
        DOF2_SetString(arquivo,"MesBanTemp",tMes);
        DOF2_SetString(arquivo,"AnoBanTemp",tAno);
        DOF2_SetString(arquivo,"HoraBanTemp",tHora);
        DOF2_SetString(arquivo,"MinutoBanTemp",tMinuto);
        DOF2_SetString(arquivo,"SegundoBanTemp",tSegundo);

        format(stri, sizeof(stri), Pasta_IPBanidosTemp,ip);
        DOF2_CreateFile(stri);
        DOF2_SetString(stri,"Motivo",string);
        DOF2_SetString(stri,"Admin",string2);
        DOF2_SetString(stri,"Data",tmp);
        DOF2_SetString(stri,"Hora",tmp2);
        DOF2_SetString(stri,"Nick",PlayerName(playerid));

        DOF2_SetString(stri,"DiaBanTemp",tDia);
        DOF2_SetString(stri,"MesBanTemp",tMes);
        DOF2_SetString(stri,"AnoBanTemp",tAno);
        DOF2_SetString(stri,"HoraBanTemp",tHora);
        DOF2_SetString(stri,"MinutoBanTemp",tMinuto);
        DOF2_SetString(stri,"SegundoBanTemp",tSegundo);
        DOF2_SaveFile();

        GameTextForPlayer(playerid, "~r~CONTA BANIDA", 10000, 3);
        format(Dialog, sizeof(Dialog),"{818689}Conta: %s\nIP: %d\nAdmin: %s\nMotivo: %s\nDia do Desban:%02d/%02d/%02d\n\n{ffffff}Acha isso um erro? Faca Revisao!\n\n******* {df5454}https://discord.gg/9QP6UnS6xd *******",PlayerName(playerid),ip,BanInfo[playerid][pAdmBan],BanInfo[playerid][pMotivo],PlayerInfo[playerid][pDiaBanTemp],PlayerInfo[playerid][pMesBanTemp],PlayerInfo[playerid][pAnoBanTemp]);
        ShowPlayerDialog(playerid,DSFUNCAO,DIALOG_STYLE_MSGBOX, "Informacoes do Banimento",Dialog, "Fechar","");
        NaoPodeLogar[playerid] = 1;
        //Kick(playerid);

        Kick(playerid);
    }
    return true;
}


