getNameLocalRoubo(number)
{
    new str[22];
    switch(number){
        //case 0: str = "do Banco LS";
        case 0: str = "do Cartorio";
        case 1: str = "da Loterica LS";
        case 2: str = "da Loja de Armas 1";
        case 3: str = "da Loja de Armas 2";
        case 4: str = "da Loja de Armas 3";
        case 5: str = "do Puteiro";
        case 6: str = "do Motel";
        case 7: str = "da Ilha";
        case 8: str = "do Navio";
        case 9: str = "do Casino";
        case 10: format(str, sizeof str, "da Fazenda %d", FazendaRoubada);
        default: str = "Desconhecido";
    }
    return str;
}
