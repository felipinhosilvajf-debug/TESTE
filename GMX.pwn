    CMD:desfixar(playerid, params[])
    {
        if(GetPlayerOrg(playerid) == 14)
        {
            new carro;
            if(sscanf(params, "d", carro))
            {
                SendClientMessage(playerid, COR_GRAD5, "{df5454}Ã—{ffffff} USE: /desfixar [id veiculo]");
                return 1;
            }
            if(PlayerToPoint(50.0, playerid,2808.7634,-1445.2111,16.2311) || PlayerToPoint(100.0, playerid,1086.5616,2161.3308,10.8203))
            {
                if(carro == INVALID_VEHICLE_ID)
                {
                    SendClientMessage(playerid, COR_GRAD1, "ID INVaLIDO !");
                    return true;
                }
                if(!ChecarveiculoBHC(10, playerid, carro))
                {
                     SendClientMessage(playerid, COR_GRAD1, "Voce precisa esta perto do carro.");
                     return 1;
                }
                if(DeslogandoSocio[playerid] == 1)
                {
                     SendClientMessage(playerid, COR_GRAD1, "Voce nao pode liberar o veiculo tendo usado o comando /entrarorg.");
                     return 1;
                }
                new arquivo[64];
                new Float:carropos[3];
                GetVehiclePos(carro, carropos[0],carropos[1],carropos[2]);
                format(arquivo, sizeof(arquivo), Pasta_CarrosFixados,carro);
                if(DOF2_FileExists(arquivo))
                {
                    DOF2_RemoveFile(arquivo);
                    SetVehicleToRespawn(carro);
                    RepairVehicle(carro);
                    if(IsAMoto(carro))
                    {
                        Vuln[carro] = 50;
                    }
                    else
                    {
                        Vuln[carro] = MaxVuln;
                    }
                    Gas[carro] = 100;
                    format(stringZCMD, sizeof(stringZCMD), "Mecanico: %s liberou o carro:[%d].", PlayerName(playerid), carro);
                    SendFamilyMessage(14, COR_DBLUE, stringZCMD);
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD1, "Este carro nao esta fixado, use /fixar !");
                    return 1;
                }
                return 1;
            }
            else
            {
                 SendClientMessage(playerid, COR_GRAD1, "Voce nao esta na hq mecanicos !");
                 return 1;
            }
        }
        return 1;
    }
    CMD:recuperar(playerid, params[])
    {
        if(GetPlayerOrg(playerid) > 0)
        {
            new carroid;
            if(sscanf(params, "d", carroid))
            {
                SendClientMessage(playerid, COR_GRAD5, "{df5454}Ã—{ffffff} USE: /recuperar [id veiculo]");
                return 1;
            }
            if(PlayerToPoint(50.0, playerid,2808.7634,-1445.2111,16.2311) || PlayerToPoint(100.0, playerid,1086.5616,2161.3308,10.8203))
            {
                if(carroid == INVALID_VEHICLE_ID)
                {
                    SendClientMessage(playerid, COR_GRAD1, "ID INVaLIDO !");
                    return true;
                }
                if(!ChecarveiculoBHC(10, playerid, carroid))
                {
                     SendClientMessage(playerid, COR_GRAD1, "Voce precisa esta perto do carro.");
                     return 1;
                }
                if(GetPlayerOrg(playerid) == 1 && !PmCarro(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
                    return 1;
                }
                if(GetPlayerOrg(playerid) == 2 && !BopeCarro(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
                    return 1;
                }
                if(GetPlayerOrg(playerid) == 3 && !ExercitoCarro(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
                    return 1;
                }
                if(GetPlayerOrg(playerid) == 4 && !SamuCarro(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
                    return 1;
                }
                if(GetPlayerOrg(playerid) == 5 && !AztecasCarro(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
                    return 1;
                }
                if(GetPlayerOrg(playerid) == 6 && !TalibanCarros(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
                    return 1;
                }
                if(GetPlayerOrg(playerid) == 7 && !GovernoCarros(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
                    return 1;
                }
                if(GetPlayerOrg(playerid) == 8 && !HitmansCarros(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
                    return 1;
                }
                if(GetPlayerOrg(playerid) == 9 && !GloboCarros(carroid))
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "Este veiculo nao e da sua organizacao.");
