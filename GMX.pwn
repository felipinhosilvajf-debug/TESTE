            {
                foreach(new i: Player)
                {
                    if(GetPlayerOrg(i) == 21 && GetPlayerOrg(i) != GetPlayerOrg(playerid))
                    {
                        if(ProxDetectorS(30.0, playerid, i))
                        {
                            SendClientMessage(playerid, COR_LIGHTRED, "*[Mercenarios] Voce nao pode usar este comando proximo a uma org rival !");
                            return 1;
                        }
