stock SoundToAll(soundid)
{
    foreach(new p: Player)
    {
        PlayerPlaySound(p, soundid, 0.0, 0.0, 0.0);
    }
    return 1;
}
stock SoundInRange(soundid, Float:range, Float:x, Float:y, Float:z)
{
    foreach(new p: Player)
    {
        if(IsPlayerInRangeOfPoint(p, range, x, y, z))
            PlayerPlaySound(p, soundid, x, y, z);
    }
}
stock StopSoundInRange(Float:range, Float:x, Float:y, Float:z)
{
    foreach(new p: Player)
    {
        if(IsPlayerInRangeOfPoint(p, range, x, y, z))
            PlayerPlaySound(p, 0, x, y, z);
    }
}
START::RoubarCaixa(playerid, caixa_id)
{

        if(!GetPlayerCaixa(playerid))
        {
            CaixaInfo[caixa_id][Caixa_Roubada] = false;
            return SendClientMessage(playerid, COR_GRAD1, "*Voce nao esta perto de um caixa eletronico.");
        }

        new Float:px, Float:py, Float:pz,
            Float:rx, Float:ry, Float:rz
            ;

        TendoRoubo = true;
        SetTimer(#LiberarRoubo, Temporoubo, 0);
        //PlayerInfo[playerid][pDina] --;
        GetDynamicObjectPos(CaixaInfo[caixa_id][Caixa_Object], px, py, pz);
        GetDynamicObjectRot(CaixaInfo[caixa_id][Caixa_Object], rx, ry, rz);
        GetXYInFrontOfCaixa(CaixaInfo[caixa_id][Caixa_Object], px, py, 0.3);
        RemovePlayerAttachedObject(playerid, Slot_Roubo);
        CaixaInfo[caixa_id][Caixa_ObjectBomba] = CreateDynamicObject(1252, px, py, pz, 0.0, 0.0, rz);
        SetTimerEx("ExplodirCaixa", 10000, 0, "d", caixa_id);
        TogglePlayerControllable(playerid, 1);
        new string[128];
        GetPlayerName(playerid,sendername,sizeof(sendername));
        format(string, sizeof(string), "* %s plantou um explosivo no caixa eletronico!", sendername);
        ProxDetector(20.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

        SendClientMessage(playerid, COR_LIGHTRED, "*Voce plantou uma bomba no caixa, agora afaste-se e espere explodir!");
        GameTextForPlayer(playerid, "~r~afaste-se do caixa", 5000, 1);
        showAlerta(playerid, "Afaste-se urgentemente do caixa, ele ira explodir daqui 10 segundos.");
        ClearAnimations(playerid, 1);
        return 0;
}
START::LiberarRoubo()
        return TendoRoubo = false;
START::AlarmCaixa(caixa_id)
{
    new Float:px, Float:py, Float:pz;
    if(!CaixaInfo[caixa_id][Caixa_Roubada])
    {
        SoundToAll(0);
        for(new i; i < MAX_CAIXAS; i ++)
        {
            if(CaixaInfo[i][Caixa_Roubada])
            {
                GetDynamicObjectPos(CaixaInfo[i][Caixa_Object], px, py, pz);
                SoundInRange(9200, 20.0, px, py, pz);
            }
        }
        return 1;
    }

    GetDynamicObjectPos(CaixaInfo[caixa_id][Caixa_Object], px, py, pz);
    SoundInRange(9200, 20.0, px, py, pz);

    SetTimerEx("AlarmCaixa", 5000, 0, "d", caixa_id);
    return 1;
}
START::ExplodirCaixa(caixa_id)
{
    new Float:px, Float:py, Float:pz,
        Float:rx, Float:ry, Float:rz;

    new str[200];

    new add = random(2000);
    CaixaInfo[caixa_id][Caixa_Dinheiro] = (MAX_PICKUPS_ROUBO*4549)+add;

    format(str, sizeof str, "{ffff00}Caixa Eletronico\nCAIXA DESTRUIDO\n{FFFFFF}Dinheiro despejado: R${33ff00}%d",CaixaInfo[caixa_id][Caixa_Dinheiro]);
    Update3DTextLabelText(CaixaInfo[caixa_id][Caixa_Text], 0xFFFF00F4, str);

    GetDynamicObjectPos(CaixaInfo[caixa_id][Caixa_Object], px, py, pz);
    GetDynamicObjectRot(CaixaInfo[caixa_id][Caixa_Object], rx, ry, rz);
    CreateExplosion(px, py, pz, 10, 2.0);
    DestroyDynamicObject(CaixaInfo[caixa_id][Caixa_ObjectBomba]);
    DestroyDynamicObject(CaixaInfo[caixa_id][Caixa_Object]);
    CaixaInfo[caixa_id][Caixa_Object] = CreateDynamicObject(2943, px, py, pz, rx, ry, rz);

    new StrR[250];
    new location[MAX_ZONE_NAME];
    format(StrR, sizeof(StrR), "{ffff00}[Rede Globo]: O caixa eletonico de %s acaba de ser explodido! - Reporter_Start[*****]", location);
    SendClientMessageToAll(COR_AMARELO, StrR);
    format(StrR, sizeof(StrR), "[Roubo]: Um caixa eletronico da cidade acaba de ser explodido com o valor de: {FFFF00}[%d]", CaixaInfo[caixa_id][Caixa_Dinheiro]);
    SendClientMessageToAll(COR_START, StrR);
    AlarmCaixa(caixa_id);

//--------- Jogar grana no chao --

    GetXYInFrontOfCaixa(CaixaInfo[caixa_id][Caixa_Object], px, py, 3.1);

    for(new i; i < MAX_PICKUPS_ROUBO; i++)
    {
        Pickups_Roubo[caixa_id][i] = CreateDynamicPickup(1212, 23, px+(RdonPickups[random(sizeof(RdonPickups))][0]),py-(RdonPickups[random(sizeof(RdonPickups))][0]),pz-0.3);
    }

    CaixaInfo[caixa_id][Caixa_Pickups] = MAX_PICKUPS_ROUBO;

    SetTimerEx("RestoreCaixa", 60000*20, 0, "d", caixa_id);

    return 1;
}
START::RestoreCaixa(caixa_id)
{
    if(CaixaInfo[caixa_id][Caixa_Roubada])
    {
        SendClientMessageToAll(COR_EXE, " Um caixa eletronico de Los Santos foi consertado pelo governo.");

        new Float:px, Float:py, Float:pz,
            Float:rx, Float:ry, Float:rz;

        CaixaInfo[caixa_id][Caixa_Roubada] = false;

        Update3DTextLabelText(CaixaInfo[caixa_id][Caixa_Text], 0xFFFF00F4, "{ffff00}Caixa Eletronico\nAperte '{0000ff}F{ffff00}' para acessar.");

        GetDynamicObjectPos(CaixaInfo[caixa_id][Caixa_Object], px, py, pz);
        GetDynamicObjectRot(CaixaInfo[caixa_id][Caixa_Object], rx, ry, rz);

        DestroyDynamicObject(CaixaInfo[caixa_id][Caixa_Object]);
        CaixaInfo[caixa_id][Caixa_Object] = CreateDynamicObject(2942, px, py, pz, rx, ry, rz);

        StopSoundInRange(20.0, px, py, pz);
        for(new i; i < MAX_PICKUPS_ROUBO; i++)
        {
            DestroyDynamicPickup(Pickups_Roubo[caixa_id][i]);
        }
    }
    return true;
}
START::RestoreCaixaADM(caixa_id)
{
    if(CaixaInfo[caixa_id][Caixa_Roubada])
    {
        new Float:px, Float:py, Float:pz,
            Float:rx, Float:ry, Float:rz;

        CaixaInfo[caixa_id][Caixa_Roubada] = false;

        Update3DTextLabelText(CaixaInfo[caixa_id][Caixa_Text], 0xFFFF00F4, "{ffff00}Caixa Eletronico\nAperte '{0000ff}F{ffff00}' para acessar.");

        GetDynamicObjectPos(CaixaInfo[caixa_id][Caixa_Object], px, py, pz);
        GetDynamicObjectRot(CaixaInfo[caixa_id][Caixa_Object], rx, ry, rz);

        DestroyDynamicObject(CaixaInfo[caixa_id][Caixa_Object]);
        CaixaInfo[caixa_id][Caixa_Object] = CreateDynamicObject(2942, px, py, pz, rx, ry, rz);


        for(new i; i < MAX_PICKUPS_ROUBO; i++)
        {
            DestroyPickup(Pickups_Roubo[caixa_id][i]);
        }
    }
    return true;
}
public OnGameModeExit()
{
    foreach(new i: Player)
    {
        if(IsPlayerConnected(i))
        {
            SetPVarInt(i, "laser", 0);
            RemovePlayerAttachedObject(i, 0);
            if(IsPlayerNPC(i)) Kick(i);
            SaveORGS();
            if(GetPVarInt(i, "ShowMap") == 1) SetPVarInt(i, "ShowMap", 0);
            KillTimer(ContagemVip[i]);
            OnPlayerSave(i);
            if(VeiculoInfo[i][vDono] == 1)
            {
                new DOF2[500];
                format(DOF2, sizeof(DOF2), "CarrosConce/%s.ini", PlayerName(i));
                DOF2_CreateFile(DOF2);
                DOF2_SetInt(DOF2, "Dono", VeiculoInfo[i][vDono]);
                DOF2_SetInt(DOF2, "Cor1", VeiculoInfo[i][vCor1]);
                DOF2_SetInt(DOF2, "Placa", VeiculoInfo[i][vPlaca]);
                DOF2_SetInt(DOF2, "Cor2", VeiculoInfo[i][vCor2]);
                DOF2_SetInt(DOF2, "Gasolina", VeiculoInfo[i][vGas]);
                DOF2_SetInt(DOF2, "Modelo", VeiculoInfo[i][vModelo]);
                DOF2_SetFloat(DOF2, "Pos1", VeiculoInfo[i][vPos1]);
                DOF2_SetFloat(DOF2, "Pos2", VeiculoInfo[i][vPos2]);
                DOF2_SetFloat(DOF2, "Pos3", VeiculoInfo[i][vPos3]);
                DOF2_SetInt(DOF2, "Trancado", VeiculoInfo[i][vTrancado]);
                DOF2_SetInt(DOF2, "Estacionou", VeiculoInfo[i][vEstacionou]);
                DOF2_SetFloat(DOF2, "Rot", VeiculoInfo[i][vRot]);
                DOF2_SaveFile();
            }
        }
    }
    salvarGrafites();
    SalvarPlantacao();
    SalvarEmpresas();
    estatisticasplayer2 = 0;
    estatisticasplayer = 0;
    SalvarSEmpresas();
    salvarPortoes();
    SalvarCofreOrg();
    for(new i; i < 500; i++)
    {
        salvarMoveis(i);
    }
    salvarPortoes();
    for(new i; i < sizeof(ColorMatchObjects); i++) DestroyObject(ColorMatchObjects[i]);

    #if defined CM_USEFENCES
    for(new i; i < sizeof(ColorMatchFences); i++) DestroyObject(ColorMatchFences[i]);
    #endif

    TextDrawDestroy(ColorMatchTD);

    for(new i, mp = GetPlayerPoolSize(); i <= mp; i++)
    {
        if(!IsPlayerConnected(i) || !InCMEvent[i]) continue;
        PlayerTextDrawDestroy(i, ColorText[i]);
        OnPlayerSave(i);
        SetPlayerVirtualWorld(i, 0);
        SpawnPlayer(i);
        Trash_ResetPlayer(i);
        Player_CleanUp(i, 1);
    }
    if (IsValidObject(LSPrisonWallsObject))
    {
        DestroyObject(LSPrisonWallsObject);
    }
    /*if (IsValidObject(LSPrisonGatesObject[0]))
    {
        DestroyObject(LSPrisonGatesObject[0]);
    }
    if (IsValidObject(LSPrisonGatesObject[1]))
    {
        DestroyObject(LSPrisonGatesObject[1]);
    }
    if (IsValidObject(LSPrisonGatesObject[2]))
    {
        DestroyObject(LSPrisonGatesObject[2]);
    }
    if (IsValidObject(LSPrisonGatesObject[3]))
    {
        DestroyObject(LSPrisonGatesObject[3]);
    }*/
    if (IsValidObject(LSApartments1Object))
    {
        DestroyObject(LSApartments1Object);
    }
    if (IsValidObject(LSApartments1CPObject))
    {
        DestroyObject(LSApartments1CPObject);
    }
    Elevator_Destroy2();
    Delete3DTextLabel(FactoryLabel[CarrosLixeiros[0]]);
    Delete3DTextLabel(FactoryLabel[CarrosLixeiros[1]]);
    Delete3DTextLabel(FactoryLabel[CarrosLixeiros[2]]);
    Delete3DTextLabel(FactoryLabel[CarrosLixeiros[3]]);
    Delete3DTextLabel(FactoryLabel[CarrosLixeiros[4]]);
    Delete3DTextLabel(FactoryLabel[CarrosLixeiros[5]]);
    Delete3DTextLabel(FactoryLabel[CarrosLixeiros[6]]);
    Delete3DTextLabel(FactoryLabel[CarrosLixeiros[7]]);
    Delete3DTextLabel(LabelGates[0]);
    Delete3DTextLabel(LabelGates[1]);
//  SaveFamilias();
    SalvarLogados();
    SaveCasas();
    SalvarSEmpresas();
    SalvarFEmpresas();
    SalvarEmpresas(); //Bern
    DOF2_Exit();
    TextDrawDestroy(Sprite0);
    Elevator_Destroy();
    getdate(v[0], v[1], v[2]);
    gettime(v[3], v[4], v[5]);
    db_close(Conexao);
    print("\n---------------------------------------------------------");
    printf("Server Desligado: [%02d/%02d/%d %02d:%02d:%02d]", v[2], v[1], v[0], v[3], v[4], v[5]);
    print("---------------------------------------------------------\n");
    return 1;
}
stock MaconhaPronta(playerid)
{
    new pronta = 0;
    for(new maconhaid = 0; maconhaid < MAX_MACONHA; maconhaid ++)
    {
        if(MaconhaInfo[maconhaid][PodeUsar] == false && MaconhaInfo[maconhaid][Crescida] >= Max_Crescida)
        {
            if(strcmp(MaconhaInfo[maconhaid][Dono], PlayerName(playerid), true) == 0)
            {
                pronta++;
            }
        }
    }
    if(pronta > 0){
        new string[128];
        if(pronta == 1)format(string, sizeof string, "Aviso: %d plantacao de maconha sua pode ser colhida, USE /maconhas",pronta);
        else format(string, sizeof string, "Aviso: %d plantacoes de maconha sua podem ser colhidas, USE /maconhas",pronta);
        return SendClientMessage(playerid, 0x2641FEAA, string);
    }
    return true;
}


stock SalvarPlantacao()
{
    new string[128];

    for(new m = 0; m < MAX_MACONHA; m++){
        format(string, sizeof string, "Plantacoes/PL%d.ini", m);
        if(DOF2_FileExists(string))DOF2_RemoveFile(string);
    }

    for(new m = 0; m < MAX_MACONHA; m++)
    {
        format(string, sizeof string, "Plantacoes/PL%d.ini", m);
        if(!MaconhaInfo[m][PodeUsar])
        {
            if(!DOF2_FileExists(string))DOF2_CreateFile(string);

            DOF2_SetString(string, "Dono", MaconhaInfo[m][Dono]);
            DOF2_SetInt(string, "Crescida", MaconhaInfo[m][Crescida]);
            DOF2_SetInt(string, "GramasProntas", MaconhaInfo[m][GramasProntas]);
            DOF2_SetFloat(string, "MacX", MaconhaInfo[m][mX]);
            DOF2_SetFloat(string, "MacY", MaconhaInfo[m][mY]);
            DOF2_SetFloat(string, "MacZ", MaconhaInfo[m][mZ]);
            DOF2_SaveFile();
        }
    }
}
stock CarregarPlantacao()
{
    new string[128];
    new cont=0;
    for(new maconhaid = 0; maconhaid < MAX_MACONHA; maconhaid++)
    {
        format(string, sizeof string, "Plantacoes/PL%d.ini", maconhaid);
        if(DOF2_FileExists(string))
        {
            format(MaconhaInfo[maconhaid][Dono], 24, DOF2_GetString(string, "Dono"));
            MaconhaInfo[maconhaid][Crescida] = DOF2_GetInt(string, "Crescida");
            MaconhaInfo[maconhaid][GramasProntas] = DOF2_GetInt(string, "GramasProntas");
            MaconhaInfo[maconhaid][mX] = DOF2_GetFloat(string, "MacX");
            MaconhaInfo[maconhaid][mY] = DOF2_GetFloat(string, "MacY");
            MaconhaInfo[maconhaid][mZ] = DOF2_GetFloat(string, "MacZ");
            if(MaconhaInfo[maconhaid][Crescida] >= 5)
            {
                MaconhaInfo[maconhaid][Object] = CreateObject(19300, MaconhaInfo[maconhaid][mX], MaconhaInfo[maconhaid][mY], MaconhaInfo[maconhaid][mZ]-1,0.0, 0.0, 0.0);
                UpdateDrogas();
            }
            format(string, sizeof string, "â€¢Plantacao de maconhaâ€¢\nDono: %s\nPlantacao NÂº: %d\nCrescida: %d/%d\nGramas: %dg",
            MaconhaInfo[maconhaid][Dono], maconhaid,MaconhaInfo[maconhaid][Crescida],Max_Crescida, MaconhaInfo[maconhaid][GramasProntas]);
            MaconhaInfo[maconhaid][TT] = Create3DTextLabel(string, 0x1FF61F99, MaconhaInfo[maconhaid][mX], MaconhaInfo[maconhaid][mY], MaconhaInfo[maconhaid][mZ], 10.0, 0);

            MaconhaInfo[maconhaid][PodeUsar]=false;
            cont++;
        }
    }
    printf("Plantacoes Carregado", cont);
}



START:: UpdateDrogas()
{
    new string[128];
    for(new maconhaid = 0; maconhaid < MAX_MACONHA; maconhaid++)
    {
        if(MaconhaInfo[maconhaid][PodeUsar] == false)
        {
            if(MaconhaInfo[maconhaid][Crescida] < Max_Crescida)
            {
                MaconhaInfo[maconhaid][GramasProntas] += random(10)+5;
                MaconhaInfo[maconhaid][Crescida]++;
            }
            if(MaconhaInfo[maconhaid][Crescida] == 5)
            {
                DestroyObject(MaconhaInfo[maconhaid][Object]);
                MaconhaInfo[maconhaid][Object] = CreateObject(3409, MaconhaInfo[maconhaid][mX], MaconhaInfo[maconhaid][mY], MaconhaInfo[maconhaid][mZ]-1.5,0.0, 0.0, 0.0);
