    CMD:protecao(playerid)
    {
        if(PlayerInfo[playerid][pSocio] > 0)
        {
             if(GetPlayerInterior(playerid) == 0 && !IsPlayerInAnyVehicle(playerid))
             {
                  SendClientMessage(playerid, COR_GRAD1, "Voce precisa estar dentro de algum interior ou veiculo para usar este comando.");
                  return 1;
             }
             if(tempoprotecao[playerid] == 0)
             {
                  protecao[playerid] = 5;
                  tempoprotecao[playerid] = 1;
                  SetTimerEx("ProtecaoSocio", 300000, 0, "i", playerid);
                  SendClientMessage(playerid,COR_VERMELHO,"Voce ativou a sua protecao !");
                  format(stringZCMD, sizeof(stringZCMD), "Socio: %s Ativou a protecao contra sniper/bazuca.", PlayerName(playerid));
                  ProxDetector(30.0, playerid, stringZCMD, COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE);
             }
             else
             {
                  SendClientMessage(playerid, COR_GRAD1, "Voce so pode usar este comando a cada 5 minutos, usou a pouco tempo ou entrou agora no serivodr!");
                  return 1;
             }
        }
        return 1;
    }
