stock Equipando(playerid)
{
    new string[128];
    new org = GetPlayerOrg(playerid);
    GetPlayerName(playerid, sendername,sizeof(sendername));
    if(Orgassa(playerid))
    {
        ResetPlayerWeapons(playerid);
        //TempDropArmasBody[playerid] = 0;
        new arquivo[24];
        format(arquivo, sizeof(arquivo), "ORG VIPS/Org%d.ini",GetPlayerOrg(playerid));
        if(DOF2_FileExists(arquivo) && DOF2_GetInt(arquivo, "Tipo") >= 1)
        {
