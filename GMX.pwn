START::ChecarAdmin(playerid)
{
    new idx = 0;
    while(idx < sizeof(AdmInfo))
    {
        if(strcmp(AdmInfo[idx][AdminNick],PlayerName(playerid), true ) == 0 )
        {
            return 1;
        }
        idx++;
    }
    return 0;
}
