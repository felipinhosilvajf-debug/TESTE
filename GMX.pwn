public OnPlayerConnect(playerid)
{
    // == [ Salvar IP do player (log) ] == //
    new ipstring[30];
    new connecting_ip[32+1];
    GetPlayerIp(playerid, connecting_ip, sizeof(connecting_ip));
    format(ipstring, 30, "%s IP: %s", PlayerName(playerid),connecting_ip);
    IPlog(ipstring);
    // == [ Salvar Serial do player (log) ] == //
    new serialstring[80];
    format(serialstring, sizeof(serialstring), "%s Serial: %s",PlayerName(playerid), GetPlayerSerial(playerid));
    SerialLog(serialstring);
    // anti-bot
    new num_players_on_ip = GetNumberOfPlayersOnThisIP(connecting_ip);
    if (num_players_on_ip > MAX_CONNECTIONS_FROM_IP)
    {
        printf("MAXIPs: Connecting player(%d) exceeded %d IP connections from %s.", playerid, MAX_CONNECTIONS_FROM_IP, connecting_ip);
        Kick(playerid);
    }
    VerBan(playerid);
    VerBanTemp(playerid);
    VerBanSerial(playerid);

    if(AccountExists(PlayerName(playerid)))
    {
        gPlayerAccount[playerid] = 1;
    }
    else
    {
        gPlayerAccount[playerid] = 0;
    }
    ColorMatch_InitPlayer(playerid);
    Trash_InitPlayer(playerid);
    Player_Init(playerid);
    // ==== TEXTDRAW LADO DIREITO BAIXO ==== //

    TextDrawShowForPlayer(playerid, loadTela1);
    for(new loadingIndex; loadingIndex < sizeof(loadTelaCard); loadingIndex++)
    {
        TextDrawShowForPlayer(playerid, loadTelaCard[loadingIndex]);
    }
    TextDrawShowForPlayer(playerid, loadTela2);
    TextDrawShowForPlayer(playerid, loadTela3);
    TextDrawShowForPlayer(playerid, loadTela4);
    TextDrawShowForPlayer(playerid, loadTela5);
    ClearChatbox(playerid, 100);
    SendClientMessage(playerid, COR_GREY, "* Carregando dados, aguarde alguns segundos...");



    MissionsTD[playerid] = CreatePlayerTextDraw(playerid, 63.750000, 170.166702, "Bonus:_R$10000_-_Registro");
    PlayerTextDrawLetterSize(playerid, MissionsTD[playerid], 0.180624, 0.969998);
    PlayerTextDrawAlignment(playerid, MissionsTD[playerid], 1);
    PlayerTextDrawColor(playerid, MissionsTD[playerid], -1);
    PlayerTextDrawSetShadow(playerid, MissionsTD[playerid], 0);
    PlayerTextDrawSetOutline(playerid, MissionsTD[playerid], 0);
    PlayerTextDrawBackgroundColor(playerid, MissionsTD[playerid], 255);
    PlayerTextDrawFont(playerid, MissionsTD[playerid], 1);
    PlayerTextDrawSetProportional(playerid, MissionsTD[playerid], 1);
    PlayerTextDrawSetShadow(playerid, MissionsTD[playerid], 0);

    ContagemPayday[playerid][0] = CreatePlayerTextDraw(playerid, 578.000122, 254.213394, "59:58");
    PlayerTextDrawLetterSize(playerid, ContagemPayday[playerid][0], 0.368399, 1.316266);
    PlayerTextDrawAlignment(playerid, ContagemPayday[playerid][0], 1);
    PlayerTextDrawColor(playerid, ContagemPayday[playerid][0], -1);
    PlayerTextDrawSetShadow(playerid, ContagemPayday[playerid][0], 0);
