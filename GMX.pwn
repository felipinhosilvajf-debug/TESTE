//=================================[ COMANDOS ]=================================//

    CMD:tirarinv(playerid, params[]) return ForT:retirarinv(playerid, params);
    CMD:tirariteminv(playerid, params[]) return ForT:retirarinv(playerid, params);
    CMD:tirariten(playerid, params[]) return ForT:retirarinv(playerid, params);
    CMD:retirariteminv(playerid, params[]) return ForT:retirarinv(playerid, params);
    CMD:rinv(playerid, params[]) return ForT:retirarinv(playerid, params);
    CMD:retirarinv(playerid, params[])
    {
        new stringdc;
        new id;
        if(PlayerInfo[playerid][pAdmin] >= 1337)
        {
            if(sscanf(params, "ud", id,stringdc))
            {
                SendClientMessage(playerid, COR_OBS, "ERRO, USE: {ffffff}/retirarinv [ ID ] [ Slot(Visto no /verinventario) ] | OBS: Some so -1 um item do Slot!");
            }
            if(stringdc >= 75 || stringdc <= 1) { SendClientMessage(playerid, COR_GREY, "Slots somente de 1 ate 74, /verinventario."); return 1; }
            DiminuirInv(stringdc,id);
            format(stringZCMD, sizeof stringZCMD, "INV: {ffffff}Voce retirou -1 item do slot %d do player: %s[%d].", stringdc, PlayerName(id), id);
            SendClientMessage(playerid, COR_START3, stringZCMD);
            format(stringZCMD, sizeof stringZCMD, "INV: {ffffff}O admin %s retirou um item do slot %d de seu Inventario.", PlayerName(playerid), stringdc);
            SendClientMessage(id, COR_START3, stringZCMD);
        }
        else
        {
            SendClientMessage(playerid, COR_OBS, "ERRO: {ffffff}Voce nao e um Administrador");
        }
        return 1;
    }


    CMD:concessionarias(playerid, params[])
    {
        ShowPlayerDialog(playerid,15657,DIALOG_STYLE_LIST,"Concessionarias","Carros LS\nCarros SF\nCarros LV\nAerea LV\nBarcos & Boates LS","Localizar","Fechar");
