                     SendClientMessage(playerid, COR_BRANCO,string);
                     format(string, sizeof(string), "Crime: %s", PlayerCrime[chosenpid][pAcusoCrime]);
                     SendClientMessage(playerid, COR_GRAD2,string);
                     format(string, sizeof(string), "Acusador: %s", PlayerCrime[chosenpid][pAcusador]);
                     SendClientMessage(playerid, COR_GRAD3,string);
                     format(string, sizeof(string), "Acusado: %s", PlayerCrime[chosenpid][pAcusado]);
                     SendClientMessage(playerid, COR_GRAD5,string);
                     SendClientMessage(playerid, COR_PM, "|______________________________________|");
                 }
                 else
                 {
                     SendClientMessage(playerid,COR_GREY,"O jogador nao esta online !");
                     return 1;
                 }
             }
             else
             {
                  SendClientMessage(playerid,COR_GREY,"O jogador nao esta online !");
                  return 1;
             }
        }
        else
        {
