                if(PlayerTazeTime[playerid] == 15)
                {
                    PlayerTazeTime[playerid] = 0;
                }
                else
                {

                    new Float:angle;
                    GetPlayerFacingAngle(playerid, angle);
                    SetPlayerFacingAngle(playerid, angle + 90);
                }
            }
            if(PlayerDrunk[playerid] >= 5)
            {
                PlayerDrunkTime[playerid] += 1;
                if(PlayerDrunkTime[playerid] == 8)
                {
                    PlayerDrunkTime[playerid] = 0;
                    PlayerDrunk[playerid] = 0;
                    new Float:angle;
                    GetPlayerFacingAngle(playerid, angle);
                    if(IsPlayerInAnyVehicle(playerid))
                    {
                        if(GetPlayerState(playerid) == 2)
                        {
                            SetVehicleZAngle(GetPlayerVehicleID(playerid), angle + 25);
                        }
                    }
                    else
                    {
                        ApplyAnimation(playerid,"PED", "WALK_DRUNK",4.0,0,1,0,0,0);
                    }
                }
            }
            if(PlayerStoned[playerid] >= 3)
            {
                PlayerStoned[playerid] += 1;
                if(PlayerStoned[playerid] == 3)
                {
                    PlayerStoned[playerid] = 0;
                    new Float:angle;
                    GetPlayerFacingAngle(playerid, angle);
                    if(IsPlayerInAnyVehicle(playerid))
                    {
                        if(GetPlayerState(playerid) == 2)
                        {
                            SetVehicleZAngle(GetPlayerVehicleID(playerid), angle + 25);
                        }
                    }
                    else
                    {
                        SetPlayerFacingAngle(playerid, angle + 90);
                    }
                }

            }
            if(TaxiCallTime[playerid] > 0)
            {
                if(TaxiAccepted[playerid] < 999)
                {
                    if(IsPlayerConnected(TaxiAccepted[playerid]))
                    {
                        new Float:X,Float:Y,Float:Z;
                        GetPlayerPos(TaxiAccepted[playerid], X, Y, Z);
                        SetPlayerCheckpoint(playerid, X, Y, Z, 5);
                    }
                }
            }
            if(BusCallTime[playerid] > 0)
            {
                if(BusAccepted[playerid] < 999)
                {
                    if(IsPlayerConnected(BusAccepted[playerid]))
                    {
                        new Float:X,Float:Y,Float:Z;
                        GetPlayerPos(BusAccepted[playerid], X, Y, Z);
                        SetPlayerCheckpoint(playerid, X, Y, Z, 5);
                    }
                }
            }
            if(PizzaCallTime[playerid] > 0)
            {
                if(PizzaAccepted[playerid] < 999)
                {
                    if(IsPlayerConnected(PizzaAccepted[playerid]))
                    {
                        new Float:X,Float:Y,Float:Z;
                        GetPlayerPos(PizzaAccepted[playerid], X, Y, Z);
                        SetPlayerCheckpoint(playerid, X, Y, Z, 5);
                    }
                }
            }
            if(MedicCallTime[playerid] > 0)
            {
                if(MedicAccepted[playerid] < 999)
                {
                    if(IsPlayerConnected(MedicAccepted[playerid]))
                    {
                        new Float:X,Float:Y,Float:Z;
                        GetPlayerPos(MedicAccepted[playerid], X, Y, Z);
                        SetPlayerCheckpoint(playerid, X, Y, Z, 5);
                    }
                }
            }
            if(CopsrondaCallTime[playerid] > 0)
            {
                if(CopsrondaAccepted[playerid] < 999)
                {
                    if(IsPlayerConnected(CopsrondaAccepted[playerid]))
                    {
                        new Float:X,Float:Y,Float:Z;
                        GetPlayerPos(CopsrondaAccepted[playerid], X, Y, Z);
                        SetPlayerCheckpoint(playerid, X, Y, Z, 5);
                    }
                }
            }
            if(MechanicCallTime[playerid] > 0)
            {
                if(MechanicAccepted[playerid] < 999)
                {
                    if(IsPlayerConnected(MechanicAccepted[playerid]))
                    {
                        new Float:X,Float:Y,Float:Z;
                        GetPlayerPos(MechanicAccepted[playerid], X, Y, Z);
                        SetPlayerCheckpoint(playerid, X, Y, Z, 5);
                    }
                }
            }
            if(Robbed[playerid] == 1)
            {
                if(RobbedTime[playerid] <= 0)
                {
                    RobbedTime[playerid] = 0;
                    Robbed[playerid] = 0;
                }
                else
                {
                    RobbedTime[playerid] -= 1;
                }
            }
            if(PlayerCuffed[playerid] == 1)
            {
                if(PlayerCuffedTime[playerid] <= 0)
                {
                    TogglePlayerControllable(playerid, 1);
                    PlayerCuffed[playerid] = 0;
                    PlayerCuffedTime[playerid] = 0;
                    PlayerTazeTime[playerid] = 1;
                }
                else
                {
                    PlayerCuffedTime[playerid] -= 1;
                }
            }
        }
        //Contagem WarZone
        if(IniciarContagemWarZone == 1)
        {
            new Surf = GetPlayerSurfingVehicleID(playerid);
            if(Surf != INVALID_VEHICLE_ID && MaletaAnexada[playerid] == 1)
            {
                GetPlayerPos(playerid,maletax,maletay,maletaz);
                maletaid = CreateDynamicObject(1210,maletax,maletay,maletaz-0.8,0,0,0.0);
                MaletaAnexada[playerid] = 0;
                StopPlayerHoldingObject(playerid);
                MaletaEmUso = 0;
            }
            if(MaletaAnexada[playerid] == 1)
            {
                GetPlayerPos(playerid, maletax, maletay, maletaz);
                SetPlayerArmedWeapon(playerid, 0);
            }
            SetPlayerCheckpoint(playerid, maletax,maletay,maletaz, 0.5); //localizar maleta
            if(TanoWarZone[playerid] == 1)
            {
                if(ContagemRed >= 100)
                {
                    RedWins();
                }
                if(ContagemGreen >= 100)
                {
                    GreenWins();
                }
                if(ContagemBlue >= 100)
                {
                        BlueWins();
                }
            }
            if(ContandoRed == 1) ContagemRed += 1;
            else if(ContandoBlue == 1) ContagemBlue += 1;
            else if(ContandoGreen == 1) ContagemGreen += 1;
        }
        //OtherTimer
        new Float:oldposx, Float:oldposy, Float:oldposz;
        if(IsPlayerConnected(playerid))
        {
            if(IsPlayerConnected(playerid) && IsPlayerInAnyVehicle(playerid) && !IsPlayerNPC(playerid))
            {   if(AntiXiterSis == true)
                {
                if(GetPlayerSpeed(playerid, true) > 300)
                {
                    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && !IsAAviao(GetPlayerVehicleID(playerid)) && !IsABarco(GetPlayerVehicleID(playerid)) && PlayerInfo[playerid][pAdmin] == 0 && PlayerInfo[playerid][pLevel] < 5)
                    {
                        format(gstring, 128, "ANTIXITER: %s[%d] estava correndo Ã  km/h = [%d] e foi banido automaticamente !",PlayerName(playerid),playerid,GetPlayerSpeed(playerid, true));
                        SendClientMessageToAll(COR_LIGHTRED,gstring);
                        BanBHC(playerid, "Xiter Velocidade", "Automatico");
                        AntiXiterLog(gstring);
                    }
                    else if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && !IsAAviao(GetPlayerVehicleID(playerid)) && !IsABarco(GetPlayerVehicleID(playerid)) && PlayerInfo[playerid][pAdmin] == 0)
                    {
                        format(gstring, 128, "[AdmAviso] %s ID:[%d] esta a %d KM/h, TV nele pode ser Speed Hack.",PlayerName(playerid),playerid,GetPlayerSpeed(playerid, true));
                        ABroadCast(COR_AMARELO,gstring,1);
                        AntiXiterLog(gstring);
                    }
                }
                }
            }
            if(!IsPlayerInVehicle(playerid, GetPlayerVehicleID(playerid)))
            {
                if(AntiXiterSis == true)
                {
                if(GetPlayerSpeed(playerid, true) >= 200)
                {
                    if(PlayerInfo[playerid][pAdmin] == 0)
                    {
                        if(GetPlayerState(playerid) == 1)
                        {
                            SendClientMessage(playerid, COR_START, "{df5454}* Voce foi sicronizado automaticamente!");
                            SetPlayerSpawn(playerid);
                            if(AntiXiterSis == true)
                            {
                                format(gstring, 128, "ANTIXITER: %s[%d] esta ape com km/h = [%d], /tvon nele rapido !",PlayerName(playerid),playerid,GetPlayerSpeed(playerid, true));
                                ABroadCast(COR_LIGHTRED,gstring,1);
                                AntiXiterLog(gstring);
                            }
                            else if(AntiXiterSis == false)
                            {

                            }
                        }
                    }
                }
                }
            }
            if(LocalAtual[playerid] != 255 && InteriorAtual[playerid] != 0)
            {
                new House = LocalAtual[playerid];
                GetPlayerPos(playerid, oldposx, oldposy, oldposz);
                if(oldposz != 0.0)
                {
                    if(oldposz < 600.0)
                    {
                        if(House > 10000)
                        {
                            new tmpcar = GetPlayerVehicleID(playerid);
                            if (!PlayerToPoint(6, playerid,1040.6,-1021.0,31.7) && House == 10001 ||!PlayerToPoint(6, playerid,-2720.5,217.5,4.1) && House == 10002 ||!PlayerToPoint(6, playerid,2644.6,-2044.9,13.3) && House == 10003)
                            {
                                if (GetPlayerState(playerid) == 2)
                                {
                                    SetVehiclePos(tmpcar, HouseInfo[tmpcar][hCarrox], HouseInfo[tmpcar][hCarroy], HouseInfo[tmpcar][hCarroz]);
                                    LinkVehicleToInterior(tmpcar, 0);
                                }
                                else
                                {
                                    SetPlayerPos(playerid, HouseInfo[tmpcar][hCarrox], HouseInfo[tmpcar][hCarroy], HouseInfo[tmpcar][hCarroz]);
                                }
                                gSpentCash[playerid] = 0;
                                TelePos[playerid][0] = 0.0;
                                TelePos[playerid][1] = 0.0;
                                LocalAtual[playerid] = 255;
                                SetPlayerInterior(playerid,0);
                                InteriorAtual[playerid] = 0;
                                Spectate[playerid] = 255;
                            }
                        }
                        if(House == 407)//City Hall
                        {
                            SetPlayerInterior(playerid,0);
                            SetPlayerPos(playerid,1480.9403,-1770.8481,18.7958);
                            InteriorAtual[playerid] = 0;
                            LocalAtual[playerid] = 999;
                        }
                        if(House >= 99 && House != 10000)
                        {
                            SetPlayerPos(playerid, BizzInfo[House-99][bEntranceX], BizzInfo[House-99][bEntranceY],BizzInfo[House-99][bEntranceZ]); // Warp the player
                            LocalAtual[playerid] = 255;
                            SetPlayerInterior(playerid,0);
                            InteriorAtual[playerid] = 0;
                        }
                        else if(House < 99 && House != 10000)
                        {
                            SetPlayerPos(playerid, HouseInfo[House][hEntrancex], HouseInfo[House][hEntrancey],HouseInfo[House][hEntrancez]); // Warp the player
                            LocalAtual[playerid] = 255;
                            SetPlayerInterior(playerid,0);
                            InteriorAtual[playerid] = 0;
                        }
                    }
                }
            }
            if(CellTime[playerid] > 0)
            {
                if (CellTime[playerid] == cchargetime)
                {
                    CellTime[playerid] = 1;
                    if(Mobile[Mobile[playerid]] == playerid)
                    {
                        CallCost[playerid] = CallCost[playerid]+callcost;
                    }
                }
                CellTime[playerid] = CellTime[playerid] +1;
                if (Mobile[Mobile[playerid]] == 255 && CellTime[playerid] == 5)
                {
                    if(IsPlayerConnected(Mobile[playerid]))
                    {
                        new called[MAX_PLAYER_NAME];
                        GetPlayerName(Mobile[playerid], called, sizeof(called));
                        format(gstring, sizeof(gstring), "* %s's Ligando.", called);
                        RingTone[Mobile[playerid]] = 10;
                        ProxDetector(30.0, Mobile[playerid], gstring, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    }
                }
            }
            if(CellTime[playerid] == 0 && CallCost[playerid] > 0)
            {
                format(gstring, sizeof(gstring), "~w~Custo da ligacao~n~~r~R$%d",CallCost[playerid]);
                GivePlayerMoneyEx(playerid, -CallCost[playerid]);
                SBizzInfo[7][sbTill] += CallCost[playerid];
                ExtortionSBiz(7, CallCost[playerid]);
                GameTextForPlayer(playerid, gstring, 5000, 1);
                CallCost[playerid] = 0;
            }
            if(TransportTime[playerid] > 0)
            {
                //Taxi driver and passenger only
                if(TransportTime[playerid] >= 20)
                {
                    TransportTime[playerid] = 1;
                    if(TransportDriver[playerid] < 999)
                    {
                        if(IsPlayerConnected(TransportDriver[playerid]))
                        {
                            TransportCost[playerid] += TransportValue[TransportDriver[playerid]];
                            TransportCost[TransportDriver[playerid]] = TransportCost[playerid];
                        }
                    }
                }
                TransportTime[playerid] += 1;
                format(gstring, sizeof(gstring), "~w~tempo: %d ~n~ ~r~Valor: ~g~R$[%d]",TransportTime[playerid],TransportCost[playerid]);
                GameTextForPlayer(playerid, gstring, 15000, 6);
            }
            if(gPlayerLogged[playerid] > 0)
            {
                VerificaTitulos(playerid);
            }
        }
        //Retirar acessorio do rosto quando estiver com sniper na mao
        if(GetPlayerWeapon(playerid) == 34)
        {
            //Retirar Acessorios da Cara
        }
        else if(GetPlayerWeapon(playerid) != 34 && TanoWarZone[playerid] == 0 && RetirouAcessorios[playerid] == 1)
        {
            CarregarItens(playerid);
            RetirouAcessorios[playerid] = 0;
        }
        //Sistema de missoes
        if(Missao[playerid] == 2 && PlayerToPoint(4.0,playerid,815.5666,-1103.1958,25.7901) && ObjetivoMissao[playerid] == 0)
        {
            PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
            RemovePlayerAttachedObject(playerid, 9);
            SetPlayerCheckpoint(playerid, 1143.1438,-1772.6785,16.5992, 6);
            ObjetivoMissao[playerid] = 1;
            SendClientMessage(playerid,COR_COSA, "[VBR Missoes]:{FFFFFF} Voce entregou o corpo, va ao traficante e finalize a missao!");
            return 1;
        }
        if(Missao[playerid] == 3)//1
        {
            if(EntregouMissao[playerid] == 1 && PlayerToPoint(4.0,playerid,1894.2678,-2133.2024,15.4663))
            {
                PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
                EntregouMissao[playerid] += 1;
                SendClientMessage(playerid,COR_COSA, "[VBR Missoes]:{FFFFFF} Voce entregou um tijolo ainda restam [1/7], siga para o proximo chekpoint!");
                SetPlayerCheckpoint(playerid, 969.6724,-1811.9244,13.8958, 6);
            }
            else if(EntregouMissao[playerid] == 2 && PlayerToPoint(4.0,playerid,969.6724,-1811.9244,13.8958))
            {
                PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
                EntregouMissao[playerid] += 1;
                SendClientMessage(playerid,COR_COSA, "[VBR Missoes]:{FFFFFF} Voce entregou um tijolo ainda restam [2/7], siga para o proximo chekpoint!");
                SetPlayerCheckpoint(playerid, 219.3916,-1250.6978,78.3342, 6);
            }
            else if(EntregouMissao[playerid] == 3 && PlayerToPoint(4.0,playerid,219.3916,-1250.6978,78.3342))
            {
                PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
                EntregouMissao[playerid] += 1;
                SendClientMessage(playerid,COR_COSA, "[VBR Missoes]:{FFFFFF} Voce entregou um tijolo ainda restam [3/7], siga para o proximo chekpoint!");
                SetPlayerCheckpoint(playerid, 768.6607,-504.0177,18.0129, 6);
            }
            else if(EntregouMissao[playerid] == 4 && PlayerToPoint(4.0,playerid,768.6607,-504.0177,18.0129))
            {
                PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
                EntregouMissao[playerid] += 1;
                SendClientMessage(playerid,COR_COSA, "[VBR Missoes]:{FFFFFF} Voce entregou um tijolo ainda restam [4/7], siga para o proximo chekpoint!");
                SetPlayerCheckpoint(playerid, 2373.8665,-8.7462,28.4416, 6);
            }
            else if(EntregouMissao[playerid] == 5 && PlayerToPoint(4.0,playerid,2373.8665,-8.7462,28.4416))
            {
                PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
                EntregouMissao[playerid] += 1;
                SendClientMessage(playerid,COR_COSA, "[VBR Missoes]:{FFFFFF} Voce entregou um tijolo ainda restam [5/7], siga para o proximo chekpoint!");
                SetPlayerCheckpoint(playerid, 1142.2699,-1093.9160,28.1875, 6);
            }
            else if(EntregouMissao[playerid] == 6 && PlayerToPoint(4.0,playerid,1142.2699,-1093.9160,28.1875))
            {
                PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
                EntregouMissao[playerid] += 1;
                SendClientMessage(playerid,COR_COSA, "[VBR Missoes]:{FFFFFF} Voce entregou um tijolo ainda restam [6/7], siga para o proximo chekpoint!");
                SetPlayerCheckpoint(playerid, 2044.5448,-965.9901,43.9348, 6);
            }
            else if(EntregouMissao[playerid] == 7 && PlayerToPoint(4.0,playerid,2044.5448,-965.9901,43.9348))
            {
                PlayerPlaySound(playerid, 183, 0.0, 0.0, 0.0);
                SetPlayerCheckpoint(playerid, 1143.1438,-1772.6785,16.5992, 6);
                ObjetivoMissao[playerid] = 1;
                EntregouMissao[playerid] = 0;
                RemovePlayerAttachedObject(playerid, 9);
                SendClientMessage(playerid,COR_COSA, "[VBR Missoes]:{FFFFFF} Voce entregou todos os tijolos de coca, va ao traficante e finalize a missao!");
            }
        }
    }
    if(gPlayerLogged[playerid] > 0)
    {
        if(TaNoQuarentena[playerid] == 1)
        {
            format(string,sizeof(string),"HUMANOS WIN %d", ContagemQuarentena[playerid]);
            TextDrawSetString(TextDrawCQ, string);
        }
    }
    return 1;
}

START::AtualizarFomeSede(playerid)
{
    if(WatchingTV[playerid] == 0)
    {
        if(PlayerInfo[playerid][pFome] > 100) PlayerInfo[playerid][pFome] = 100;
