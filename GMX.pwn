            {
                 if(PlayerInfo[i][pChatRoubo] == 0)
                 {
                      format(gstring, sizeof(gstring), "[Org %s] {FFFFFF}%s[%d]: Evitou um roubo %s e recebeu R$ 40.000 e 1 de respeito!", NomeORG(killerid), NomePlayerMatou,killerid, getNameLocalRoubo(LocalDeRoubo[playerid]));
                      SendClientMessage(i, COR_DBLUE, gstring);
                      format(gstring, sizeof(gstring), "[Roubo %s] {FFFFFF}%s[%d]: nao conseguiram roubar o cofre %s!", NomeORG(playerid), PlayerName(playerid) , playerid, getNameLocalRoubo(LocalDeRoubo[playerid]));
                      SendClientMessage(i, GetPlayerColor(playerid), gstring);
                 }
            }
            Roubando[playerid] = 0;
            KillTimer(TimerRoubando[playerid]);
            TempoRoubo_[playerid] = 0;
            RemovePlayerAttachedObject(playerid,9);
            TogglePlayerControllable(playerid, 1);
            ClearAnimations(playerid);
            GivePlayerMoneyEx(killerid, 40000);
            PlayerInfo[killerid][pExp] += 1;//
            PlayerInfo[killerid][pRoubosEvitados] ++;
            if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
        }
        if(ProvocoInvasao[playerid] == 1)
        {
            foreach(new i: Player)
            {
                 if(PlayerInfo[i][pChatRoubo] == 0)
                 {
                      format(gstring, sizeof(gstring), "[Invasao Sistema] %s[%d]: nao conseguiu invadir o sistema da penitenciaria!",PlayerName(playerid),playerid);
                      SendClientMessage(i, GetPlayerColor(playerid), gstring);
                      format(gstring, sizeof(gstring), "[Org %s] {FFFFFF}%s[%d]:Evitou uma invasao a prefeitura e recebeu R$15.000 e 1 respeito!", NomeORG(killerid), NomePlayerMatou,killerid);
                      SendClientMessage(i, COR_DBLUE, gstring);
                 }
            }
            ProvocoInvasao[playerid] = 0; invasaopenitenciaria = 0; KillTimer(tempoinvasao); tempoinvasaosistema = 0;
            RemovePlayerAttachedObject(playerid,9);
            TogglePlayerControllable(playerid, 1);
            ClearAnimations(playerid);
            KillTimer(TempoContagem[playerid]);
            GivePlayerMoneyEx(killerid, 15000);
            PlayerInfo[killerid][pExp] += 1;
            PlayerInfo[killerid][pRoubosEvitados] ++;
            if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
        }
    }
    if(ProvocoCasarao[playerid] == 1)
    {
        GangZoneStopFlashForAll(GZCasarao);
        GangZoneShowForAll(GZCasarao, 0xFFFFFF96);
        GuerranoCasarao = 0;
        ProvocoCasarao[playerid] = 0;
        donocasarao = 0;
        Dominando[playerid] = 0;
        KillTimer(TempoGuerraCasarao);
    }
    if(ProvocoMotelA[playerid] == 1)
    {
        GangZoneStopFlashForAll(GZMotel);
        GangZoneShowForAll(GZMotel, 0xFFFFFF96);
        GuerranoMotel = 0;
