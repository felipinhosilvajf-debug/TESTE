START::IsACop(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        new lider = PlayerInfo[playerid][pLider];
        new member = PlayerInfo[playerid][pMembro];
        if(member == 1 || member == 2 || member == 3 || member == 12 || member == 13 || member == 17 || member == 25 || member == 14)
        {
            return 1;
        }
        else if(lider == 1 || lider == 2 || lider == 3 || lider == 12 || lider == 13 || lider == 17 || lider == 25 || lider == 14)
        {
            return 1;
        }
    }
    return 0;
}
START::IsAtClothShop(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        if(PlayerToPoint(25.0,playerid,207.5627,-103.7291,1005.2578) || PlayerToPoint(25.0,playerid,203.9068,-41.0728,1001.8047))
        {//Binco & Suburban
            return 1;
        }
        else if(PlayerToPoint(30.0,playerid,214.4470,-7.6471,1001.2109) || PlayerToPoint(50.0,playerid,161.3765,-83.8416,1001.8047) || PlayerToPoint(50.0,playerid,162.6288,-86.3102,1001.8047) || PlayerToPoint(50.0,playerid,215.1300,-127.6002,1003.5078))
        {//Zip & Victim
            return 1;
        }
    }
    return 0;
}
START::IsAGOV(playerid)
{
    if (IsPlayerConnected(playerid))
    {
        new lider = PlayerInfo[playerid][pLider];
        new member = PlayerInfo[playerid][pMembro];
        if (member == 7 || lider == 7)
        {
            return true;
        }
    }
    return 0;
}
START::IsAGangster(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        new lider = PlayerInfo[playerid][pLider];
        new member = PlayerInfo[playerid][pMembro];
        if(member==5 || member==11 || member==15 || member==18 || member==19 || member==23)
        {
            return 1;
        }
        else if(lider==5 || lider==11 || lider==15 || lider==18 || lider==19 || lider==23)
        {
            return 1;
        }
    }
    return 0;
}
START::IsAMafia(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        new lider = PlayerInfo[playerid][pLider];
        new member = PlayerInfo[playerid][pMembro];
        if(member==20 || member==22)
        {
            return 1;
        }
        else if(lider==20 || lider==22)
        {
            return 1;
        }
    }
    return 0;
}
START::IsAtGasStation(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        if(PlayerToPoint(15.0,playerid,1941.9850,-1774.6639,19.7006))
        {
            if(IsAAviao(GetPlayerVehicleID(playerid)))
            {
                return 1;
            }
        }
        if(PlayerToPoint(6.0,playerid,1004.0070,-939.3102,42.1797) || PlayerToPoint(6.0,playerid,1944.3260,-1772.9254,13.3906))
        {//LS
            return 1;
        }
        else if(PlayerToPoint(8.0,playerid,-90.5515,-1169.4578,2.4079) || PlayerToPoint(8.0,playerid,-1609.7958,-2718.2048,48.5391) || PlayerToPoint(8.0,playerid,-1604.8998,-2711.1104,48.9453))
        {//LS
            return 1;
        }
        else if(PlayerToPoint(8.0,playerid,-2029.4968,156.4366,28.9498) || PlayerToPoint(8.0,playerid,-2408.7590,976.0934,45.4175))
        {//SF
            return 1;
        }
        else if(PlayerToPoint(8.0,playerid,655.3879,-564.3586,16.3359) || PlayerToPoint(10.0,playerid,2639.5940,1106.6432,10.8203) || PlayerToPoint(10.0,playerid,1596.8081,2199.0686,10.8203))
        {//SF
            return 1;
        }
        else if(PlayerToPoint(8.0,playerid,1380.4712,462.7467,20.1107) || PlayerToPoint(8.0,playerid,1385.0475,460.5417,20.1068))
        {//PC
            return 1;
        }
        else if(PlayerToPoint(10.0,playerid,1383.5532,457.1286,19.9561) || PlayerToPoint(10.0,playerid,1379.1952,459.1295,19.9587))
        {//PC
            return 1;
        }
        else if(PlayerToPoint(6.0,playerid,-2243.9629,-2560.6477,31.8841) || PlayerToPoint(10.0,playerid,-1676.6323,414.0262,6.9484))
        {//Between LS and SF
            return 1;
        }
        else if(PlayerToPoint(8.0,playerid,2202.2349,2474.3494,10.5258) || PlayerToPoint(7.0,playerid,614.9333,1689.7418,6.6968) || PlayerToPoint(10.0,playerid,2147.0803,2747.8940,10.8203))
        {//LV
            return 1;
        }
        else if(PlayerToPoint(8.0,playerid,-1328.8250,2677.2173,49.7665) || PlayerToPoint(6.0,playerid,70.3882,1218.6783,18.5165))
        {//LV
            return 1;
        }
        else if(PlayerToPoint(8.0,playerid,2113.7390,920.1079,10.5255) || PlayerToPoint(6.0,playerid,-1327.7218,2678.8723,50.0625))
        {//LV
            return 1;
        }
    }
    return 0;
}
START::IsAtBar(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        if(PlayerToPoint(2.0,playerid,495.7801,-76.0305,998.7578) || PlayerToPoint(2.0,playerid,499.9654,-20.2515,1000.6797) || PlayerToPoint(2.0,playerid,1551.4578,-1717.0885,13.5469) || PlayerToPoint(2.0,playerid,1254.0154,-792.7376,1084.2344) || PlayerToPoint(2.0,playerid,942.4760,4.9500,1000.9297) || PlayerToPoint(2.0,playerid,1207.2354,-29.5153,1000.9531) || PlayerToPoint(2.0,playerid,499.7647,-20.7059,1000.6797) || PlayerToPoint(2.0,playerid,-2654.0054,1407.1222,906.2734)
        || PlayerToPoint(2.0,playerid,451.3561,-83.6522,999.5547) || PlayerToPoint(2.0,playerid,251.8864,-56.2812,1.5703) || PlayerToPoint(2.0,playerid,-224.7850,1404.5426,27.7734) || PlayerToPoint(2.0,playerid,1139.7213,-3.8612,1000.6719)
        || PlayerToPoint(2.0,playerid,373.6971,-65.5253,1001.5078) || PlayerToPoint(2.0,playerid,499.9893,-76.0406,998.7578))
        {//In Groove street bar (with girlfriend), and in Havanna
            return 1;
        }
        else if(PlayerToPoint(2.0,playerid,1215.9480,-13.3519,1000.9219) || PlayerToPoint(2.0,playerid,1548.6384,-1717.0481,13.5546) || PlayerToPoint(2.0,playerid,-2658.9749,1407.4136,906.2734) || PlayerToPoint(2.0,playerid,969.3788,-45.2261,1001.1172) || PlayerToPoint(2.0,playerid,2372.4138,-1133.9048,1050.8750))
        {//PIG Pen
            return 1;
        }
    }
    return 0;
}
START::IsInPiching(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        if(PlayerToPoint(0.6,playerid,2196.0759,-1741.0487,13.2835))
        {
            MuroID[playerid] = 0;
            if(Pichado[0][GetPlayerOrg(playerid)] == 1)
            {
                if(IsAPishing(playerid))
                {
                    GameTextForPlayer(playerid, "~r~Muro Ja Pichado", 1000, 1);
                }
