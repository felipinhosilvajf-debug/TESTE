                    }
                    else
                    {
                        format(tdialog,sizeof(tdialog),"Recuperando Veiculo [%d]", carroid);
                        ShowPlayerDialog(playerid,197,DIALOG_STYLE_MSGBOX, tdialog,"Voce deseja recupera-lo por R$4.000 ?","Sim","nao");
                    }
                    carrorecuperar[playerid] = carroid;
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD1, "Este carro nao esta fixado !");
                    return 1;
                }
                return 1;
            }
            else
            {
                 SendClientMessage(playerid, COR_GRAD1, "Voce nao esta na hq mecanicos !");
                 return 1;
            }
        }
        return 1;
    }
    CMD:flip(playerid)
    {
        if(PlayerInfo[playerid][pAdmin] >= 2)
        {
            if(IsPlayerInAnyVehicle(playerid))
            {
                new currentveh;
                new Float:angle;
                currentveh = GetPlayerVehicleID(playerid);
                GetVehicleZAngle(currentveh, angle);
                SetVehicleZAngle(currentveh, angle);
                SendClientMessage(playerid, -1,"Voce desvirou seu veiculo.");
                return 1;
            }
            else return SendClientMessage(playerid, -1, "Voce nao esta em um veiculo.");
        }
        return 1;
    }
    CMD:darmoedas(playerid, params[])return ForT:setarmoedas(playerid,params);
    CMD:setarmoedas(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] > 1341)
        {
            new playa;
            new moedas;
            if(sscanf(params, "ud", playa, moedas))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /setarmoedas [ id ] [ Moedas ]");
                return 1;
            }
            if (IsPlayerConnected(playerid))
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(playa))
                {
                    if(playa != INVALID_PLAYER_ID)
                    {
                        PlayerInfo[playa][pReceberCoins] += moedas;
                        //format(stringZCMD, 256, "O Admin %s lhe deu [%d] Moedas, Va ao menu vip mais proximo para resgata-las.",PlayerName(playerid), moedas, PlayerName(playa));
                        //SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, 256, "Voce deu [%d] Moedas para o jogador [%s].", moedas, PlayerName(playa));
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, 256, "O Admin %s deu [%d] Moedas para o jogador [%s].", PlayerName(playerid), moedas, PlayerName(playa));
                        MoedaLog(stringZCMD);

                    }
                }
            }
        }
        else
        {
             return 1;
        }
        return 1;
    }
