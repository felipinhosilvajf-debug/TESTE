    CMD:ver(playerid, params[])  return ForT:verrg(playerid, params);
    CMD:verrg(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if (PlayerInfo[playerid][pAdmin] >= 1)
            {
                if(sscanf(params, "u", sscanfid))
                {
                    SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /ver [id]");
                    return 1;
                }
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        ShowStats(playerid,sscanfid);
                        format(stringZCMD, sizeof(stringZCMD), "Adm-Cmd: %s esta vizualizando o RG de %s.",PlayerName(playerid), PlayerName(sscanfid));
                        ABroadCast(COR_OBS,stringZCMD,1);
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD1, "Este Jogador nao esta ativo!");
                }
            }
            else
