                if(panunciogang == 1)
                {
                    SendClientMessage(playerid,COR_GRAD2,"Anunciaram a pouco tempo.. aguarde e tente em breve.!");
                    return 1;
                }
                if(PlayerInfo[playerid][pJailed] != 0)
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao pode anunciar agora!");
                    return 1;
                }
                if(isnull(result))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/gov)erno [texto]");
                    return 1;
                }
                if(TentouDivulgar(result))
                {
                    GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                    format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                    DivulgouLog(stringZCMD);
