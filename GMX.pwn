                        DOF2_CreateFile(File); // Se nao existir, cria
                    }
                    DOF2_SetFloat(File, "PosX", GBInfo[x][gbX]); // Escreve dentro do Arquivo: "PosX = pPosX (posicao que pegamos antes, lembra ?)
                    DOF2_SetFloat(File, "PosY", GBInfo[x][gbY]); // Escreve dentro do Arquivo: "PosY = pPosY (posicao que pegamos antes, lembra ?)
                    DOF2_SetFloat(File, "PosZ", GBInfo[x][gbZ]-1.2); // Escreve dentro do Arquivo: "PosZ = pPosZ (posicao que pegamos antes, lembra ?)
                    DOF2_SetFloat(File, "0", GBInfo[x][gbRX]);
                    DOF2_SetFloat(File, "0", GBInfo[x][gbRY]);
                    DOF2_SetFloat(File, "PosRZ", GBInfo[x][gbRZ]); // Escreve dentro do Arquivo: "Interior = pInterior (interior que pegamos antes, lembra ?)
                    strmid(GBInfo[x][gbNick],PlayerName(playerid),0,strlen(PlayerName(playerid)), MAX_PLAYER_NAME);
                    DOF2_SetString(File, "CaixaNick", GBInfo[x][gbNick]);
                    DOF2_SaveFile(); // Salva o arquivo.
                    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
                    GBInfo[x][gbObject] = CreateDynamicObject(964,GBInfo[x][gbX],GBInfo[x][gbY],GBInfo[x][gbZ]-1.2, 0.0, 0.0, GBInfo[x][gbRZ]);
                    format(String, 120, "{df5454}Â»{FFFFFF} Caixa De Armas\n\nDono: {df5454}%s\n{FFFFFF}Pressione {df5454}H{FFFFFF} para abrir!", GBInfo[x][gbNick]);
                    GBInfo[x][gbText] = CreateDynamic3DTextLabel(String,0xFFFFFFFF,GBInfo[x][gbX],GBInfo[x][gbY],GBInfo[x][gbZ],40.0);
                    GBInfo[x][gbCreated] = true;
                    SendClientMessage(playerid,COR_GREEN,"Caixa de armas no chao! Para usar aperte 'H'");
                    //BoxAberto[playerid] = 0;
                    DiminuirInv(slot,playerid);
                    //FecharInventario(playerid);
                    break;
                }
            }
        }
    }
    if(item == 1654)
    {
        DinamiteMaos[playerid] = 1;
        //BoxAberto[playerid] = 0;
        DiminuirInv(slot,playerid);
        //FecharInventario(playerid);
        SetPlayerAttachedObject(playerid, 9, 1654, 4, 0.226000, -0.277000, 0.126999, 9.200012, -11.000000, -88.799995);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
    }
    if(item == 2922)
    {
        PegouDecod[playerid] = 1;
        //BoxAberto[playerid] = 0;
        DiminuirInv(slot,playerid);
        //FecharInventario(playerid);
        SetPlayerAttachedObject(playerid, 9, 2922, 4, 0.252999, -0.289999, 0.093999, 11.500003, -7.400002, 99.600067, 1.000000, 0.994000, 1.074999);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
    }
    if(item > 399 && item < 610)
    {
        new Float:X,Float:Y,Float:Z;
        GetPlayerPos(playerid, X,Y,Z);
        new arquivo[64];
        new arquivo2[64];
        for(new x = 1200; x != MAX_VEHICLES; ++x)
        {
            format(arquivo, sizeof(arquivo), Pasta_CarrosVIP,x);
            format(arquivo2, sizeof(arquivo2), Pasta_CarrosFixo,x);
            if(!DOF2_FileExists(arquivo) && !DOF2_FileExists(arquivo2))
            {
                CarroInventario[playerid] = AddStaticVehicleEx(item,X,Y,Z, 1,1,0,-1);
                PutPlayerInVehicle(playerid, CarroInventario[playerid], 0);
                break;
            }
        }
        if(item == 441 || item == 464 || item == 465 || item == 501 || item == 564 || item == 594)
        {
            SendClientMessage(playerid, COR_LIGHTBLUE, "Carrinho: Voce pegou seu brinquedo, quando quiser guarda-lo pressione F ou N");
            format(gstring, sizeof(gstring), "[BRINQUEDO]: %s Pegou um(a) %s de brinquedo.", PlayerName(playerid), Nomedosveiculos[item - 400]);
            ProxDetector(30.0, playerid, gstring, COR_AZUL,COR_AZUL,COR_AZUL,COR_PURPLE,COR_PURPLE);
        }
        else
        {
            SendClientMessage(playerid, COR_LIGHTBLUE, "Voce pegou seu veiculo de inventario, para guarda-lo, pressione a tecla F ou N.");
            format(gstring, sizeof(gstring), "[Veiculo de Inventario]: %s Pegou um(a) %s em seu inventario.", PlayerName(playerid), Nomedosveiculos[item - 400]);
            ProxDetector(30.0, playerid, gstring, COR_AZUL,COR_AZUL,COR_AZUL,COR_PURPLE,COR_PURPLE);
        }
        //BoxAberto[playerid] = 0;
        GetVehicleParamsEx(CarroInventario[playerid],engineZCMD,lightsZCMD,alarmZCMD,doorsZCMD,bonnetZCMD,bootZCMD,objectiveZCMD);
        SetVehicleParamsEx(CarroInventario[playerid],VEHICLE_PARAMS_ON,lightsZCMD,alarmZCMD,doorsZCMD,bonnetZCMD,bootZCMD,objectiveZCMD);
        SendClientMessage(playerid, 0xFFFFFFFF, "Motor do Veiculo: {228B22}Ligado!");
        EngineCarro[CarroInventario[playerid]] = 1;
        Gas[CarroInventario[playerid]] = GasMax;
        //FecharInventario(playerid);
    }
    if(ObjetoArma(item))
    {
        new Arma = IdDoItem(item);
        format(gstring, sizeof gstring, "{FFFFFF} Voce pegou uma {df5454}%s{FFFFFF} com {df5454}%d{FFFFFF} municoes de seu inventario.", NomeDaArma(item), InventarioInfo[playerid][ItemSelecionado[playerid]][iUnidades]);
        SendClientMessage(playerid, COR_VERDE, gstring);
        GivePlayerWeaponEx(playerid, Arma, InventarioInfo[playerid][ItemSelecionado[playerid]][iUnidades]);
        InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot] = 19382;
        InventarioInfo[playerid][ItemSelecionado[playerid]][iUnidades] = 0;
        //AtualizarInventario(playerid);
    }
    if(item == 1650)
    {
            if(!IsPlayerInAnyVehicle(playerid))
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta em um veiculo !");
                return 1;
            }
            new vehicle = GetPlayerVehicleID(playerid);
            if(Gas[vehicle] > 70)
            {
                SendClientMessage(playerid, COR_LIGHTBLUE, "Voce possui + de 70 por cento de gasolina, ainda nao pode usar o galao !");
                return 1;
            }
            Gas[vehicle] += 30;
            GetPlayerName(playerid,playernameZCMD,sizeof(playernameZCMD));
            SendClientMessage(playerid, COR_GRAD1, "Voce usou o seu galao de gasolina,encheu + 30 por cento de gasolina!");
            DiminuirInv(slot,playerid);
            //AtualizarInventario(playerid);
    }
    if(item == 2749)
    {
        DiminuirInv(slot,playerid);
        //FecharInventario(playerid);
        ShowPlayerDialog(playerid, 1998, DIALOG_STYLE_MSGBOX, "Sistema de Grafite", "Voce deseja pixar uma parede?", "Sim", "nao");
    }
    if(item == 3096)
    {
            new Float:vida;
            new vid = GetPlayerVehicleID(playerid);
            GetVehicleHealth(vid, vida);
            if(!IsPlayerInAnyVehicle(playerid))
            {
                SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao esta em um veiculo !");
                return 1;
            }
            if(GetPlayerState(playerid) == 2 && Quebrado[vid] == 0)
            {
                SendClientMessage(playerid, COR_LIGHTBLUE, "Seu carro nao esta quebrado, nao pode usar o kit !");
                return 1;
            }
            GetPlayerName(playerid,playernameZCMD,sizeof(playernameZCMD));
            RepairCar[playerid] = GetPlayerVehicleID(playerid);
            SetVehicleHealth(RepairCar[playerid], 500.0);
            EngineCarro[playerid] = 1;
            Quebrado[vid] = 0;
            GetVehicleParamsEx(vid,engineZCMD,lightsZCMD,alarmZCMD,doorsZCMD,bonnetZCMD,bootZCMD,objectiveZCMD);
            SetVehicleParamsEx(vid,VEHICLE_PARAMS_ON,lightsZCMD,alarmZCMD,doorsZCMD,bonnetZCMD,bootZCMD,objectiveZCMD);
            SendClientMessage(playerid, COR_GRAD1, "Voce usou seu o kit reparo, o veiculo esta com 50 por cento de vida!");
            DiminuirInv(slot,playerid);
            //AtualizarInventario(playerid);
    }
    if(item == 980){
        ShowPlayerDialog(playerid, 25812, DIALOG_STYLE_INPUT, "Criacao de Objeto",
        "{FFFFFF}Voce esta preste a criar um portao\nVoce devera inserir uma {df5454}senha.\n\n{818689}Digite a senha do portao:", "Confirmar", "");
        DiminuirInv(slot,playerid);
        //AtualizarInventario(playerid);
    }
    if(item == 11736){
        if(MedKitDados[playerid][MedPlayer] == true) return SendClientMessage(playerid, -1, "Voce ja criou um medkit");
        GetPlayerPos(playerid, MedKitDados[playerid][PosPlayerX],MedKitDados[playerid][PosPlayerY], MedKitDados[playerid][PosPlayerZ]);
        MedKitDados[playerid][MedKits] = CreateDynamicPickup(19605,1, MedKitDados[playerid][PosPlayerX], MedKitDados[playerid][PosPlayerY], MedKitDados[playerid][PosPlayerZ]-1.5), MedKitDados[playerid][MedKitObject] = CreateObject(11736, MedKitDados[playerid][PosPlayerX], MedKitDados[playerid][PosPlayerY], MedKitDados[playerid][PosPlayerZ]-1, 0.0, 0.0, 0.0);
        MedKitDados[playerid][VidaMedKit] = 10;
        format(stringZCMD, sizeof(stringZCMD), "[MedKit]: {FFFFFF}%s {33AA33}Jogou um MedKit no chao!", PlayerName(playerid));
        ProxDetector(30.0, playerid, stringZCMD, COR_GREEN,COR_GREEN,COR_GREEN,COR_GREEN,COR_GREEN);
        format(str,35,"MedKit\n de %s", PlayerName(playerid));
        PlayerPlaySound(playerid, 32000, 0.0, 0.0, 0.0), MedKitDados[playerid][MedPlayer] = true;
        MedKitDados[playerid][LabelMed] = Create3DTextLabel(stringZCMD, 0xEDE6E6AA, MedKitDados[playerid][PosPlayerX],MedKitDados[playerid][PosPlayerY],MedKitDados[playerid][PosPlayerZ], 25.0, 0);
        DiminuirInv(slot,playerid);
        //AtualizarInventario(playerid);
        return 1;
    }
    //ACESSoRIOS
    if(ObjetoAcessorio(item))
    {
        if(PlayerMobile[playerid] == true)
        {
            ItemProibido(playerid);
            return 1;
        }


        AcessorioSelecionado[playerid] = item;
        ShowPlayerDialog(playerid, 25481, DIALOG_STYLE_LIST, "Local Do Corpo","Espinha\nCabeca\nBraco esquerdo\nBraco direito\nMao esquerda\nMao direita\nCoxa esquerda\nCoxa direita\nPe esquerdo\nPe direito\nPanturrilha esquerda\nPanturrilha direita\nAntebraco esquerdo\nAntebraco direito\nClavicula esquerda\nClavicula direita\nPescoco\nMendibula","Selecionar", "Cancelar");
        //DiminuirInv(slot,playerid);
        itemacessorio[playerid] = item;
        AtualizarInventario(playerid);
        FecharInventario(playerid);
    }
    if(item > -1 && item < 312 ){

        new skin = GetPlayerSkin(playerid);
        SetPlayerSkin(playerid, item);
        for(new i = 0; i < 75; i++)
        {
            if(InventarioInfo[playerid][i][iSlot] == 19382)
            {
                format(str, 100, "* Voce colocou a skin %d", item);
                SendClientMessage(playerid, 0x00ccccFF, str);
                format(str, 100, "* %s Trocou de roupa.", PlayerName(playerid));
                PlayerInfo[playerid][pSkin] = item;
                ProxDetector(30.0, playerid, str, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                if(InventarioInfo[playerid][slot][iUnidades] > 1)
                return InventarioInfo[playerid][slot][iUnidades] --;
                if(InventarioInfo[playerid][slot][iUnidades] == 1){

                    InventarioInfo[playerid][slot][iUnidades] = 0;
                    InventarioInfo[playerid][slot][iSlot] = 19382;
                }

                InventarioInfo[playerid][slot][iSlot] = skin;
                InventarioInfo[playerid][slot][iUnidades] = 1;

                //AtualizarInventario(playerid);
                //BoxAberto[playerid] = 0;
                return 1;
            }
        }
        SendClientMessage(playerid, 0xFF6347AA, "* Seu inventario esta cheio!");
        return 1;
    }
    return 1;
}

// ======================= fim by cleyson inventario



stock AbrirInventario(playerid)
{
    format(gstring, sizeof(gstring), "* %s Abriu seu inventario.", PlayerName(playerid));
    ProxDetector(30.0, playerid, gstring, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

    for(new i = 0; i != 7; i++)
    {
        PlayerTextDrawShow(playerid, invText[playerid][i]);
    }

    SelectTextDraw(playerid, 0xFFFF00AA);

    new str[256];

    format(str,300,"______________________________________________________________~w~Pagina %d-5",InventarioPagina[playerid]);
    PlayerTextDrawSetString(playerid,invText[playerid][4],str);

    new itens;
    for(new i = 0; i < 75; i++)
    {
        if(InventarioInfo[playerid][i][iSlot] != 19382) itens++;
        format(str, sizeof str, "Inventaio_de:_%s_Itens:_~h~%d/75", PlayerName(playerid), itens);
        PlayerTextDrawSetString(playerid, invText[playerid][5], str);
        //PlayerTextDrawShow(playerid, invText[playerid][16]);
    }

    InventarioAberto[playerid] = 1;

    if(InventarioPagina[playerid] == 1){

        for(new i=0; i < 15; i++){

            if(InventarioInfo[playerid][i][iUnidades] > 0){

                format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                PlayerTextDrawShow(playerid, invName[playerid][i]);
            }
            PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
            PlayerTextDrawShow(playerid, invPreview[playerid][i]);

            if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
            if(InventarioInfo[playerid][i][iSlot] == 19382){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
        }
    }

    if(InventarioPagina[playerid] == 2){

        for(new i = 15; i < 30; i++){

            if(InventarioInfo[playerid][i][iUnidades] > 0){

                format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                PlayerTextDrawShow(playerid, invName[playerid][i]);
            }
            PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
            PlayerTextDrawShow(playerid, invPreview[playerid][i]);

            if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
            if(InventarioInfo[playerid][i][iSlot] == 19382){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
        }
    }

    if(InventarioPagina[playerid] == 3){

        for(new i=30; i != 45; i++){

            if(InventarioInfo[playerid][i][iUnidades] > 0){

                format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                PlayerTextDrawShow(playerid, invName[playerid][i]);
            }
            PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
            PlayerTextDrawShow(playerid, invPreview[playerid][i]);

            if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
            if(InventarioInfo[playerid][i][iSlot] == 19382){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
        }
    }

    if(InventarioPagina[playerid] == 4){

        for(new i=45; i != 60; i++){

            if(InventarioInfo[playerid][i][iUnidades] > 0){

                format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                PlayerTextDrawShow(playerid, invName[playerid][i]);
            }
            PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
            PlayerTextDrawShow(playerid, invPreview[playerid][i]);

            if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
            if(InventarioInfo[playerid][i][iSlot] == 19382){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
        }
    }
    if(InventarioPagina[playerid] == 5){

        for(new i=60; i != 75; i++){

            if(InventarioInfo[playerid][i][iUnidades] > 0){

                format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                PlayerTextDrawShow(playerid, invName[playerid][i]);
            }
            PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
            PlayerTextDrawShow(playerid, invPreview[playerid][i]);

            if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
            if(InventarioInfo[playerid][i][iSlot] == 19382){

                PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                PlayerTextDrawShow(playerid, invPreview[playerid][i]);
            }
        }
    }
    return 1;
}

stock FecharInventario(playerid)
{
    format(gstring, sizeof(gstring), "* %s Fechou seu inventario.", PlayerName(playerid));
    ProxDetector(30.0, playerid, gstring, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

    InventarioAberto[playerid] = 0;
    CancelSelectTextDraw(playerid);

    for(new i = 0; i != 16; i++)
    {
        PlayerTextDrawHide(playerid, invText[playerid][i]);
    }
    for(new i; i != 75; i++){

        PlayerTextDrawHide(playerid, invPreview[playerid][i]);
        PlayerTextDrawHide(playerid, invName[playerid][i]);
    }
}
