          }
     }
     else
     {
          HidePlayerVelocimetro(playerid) ;
          RemovePlayerAttachedObject(playerid, SLOT);
          return 1;
     }
     if(newstate == PLAYER_STATE_ONFOOT)
     {
          if(TransportDuty[playerid] > 0)
          {
               if(TransportDuty[playerid] == 1)
               {
                    TaxiDrivers -= 1;
               }
               else if(TransportDuty[playerid] == 2)
               {
                    BusDrivers -= 1;
               }
               TransportDuty[playerid] = 0;
               format(gstring, sizeof(gstring), "* esta fora de servico, ganhou R$[%d].", TransportMoney[playerid]);
               SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
               GivePlayerMoneyEx(playerid, TransportMoney[playerid]);
               PLO += TransportMoney[playerid];
               DepositarOrgGrana(7,TransportMoney[playerid]);
               ConsumingMoney[playerid] = 1; TransportValue[playerid] = 0; TransportMoney[playerid] = 0;
          }
          TelePos[playerid][0] = 0.0;
          TelePos[playerid][1] = 0.0;
     }
     if(newstate == PLAYER_STATE_PASSENGER)
     {
        for(new vX; vX != sizeof(CarrosOnibus); vX++)
        {
            if(GetPlayerVehicleID(playerid) == CarrosOnibus[vX])
            {
                if(GetPlayerMoneyEx(playerid) >= 75)
                {
                    if(PlayerInfo[playerid][pEmprego] != 4)
                    {
                        SendClientMessage(playerid, -1, "___________________________________________________________________________");
                        format(gstring, sizeof gstring, "* Voce pagou {FF8A00}R$ 75 {FFFFFF}para entrar neste onibus.");
                        SendClientMessage(playerid, -1, gstring);
                        SendClientMessage(playerid, -1, "___________________________________________________________________________");
                        GivePlayerMoneyEx(playerid, -75);
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_LIGHTRED, "* Voce nao tem dinheiro suficiente para pegar um onibus!");
                    RemovePlayerFromVehicle(playerid);
                }
            }
        }
     }
