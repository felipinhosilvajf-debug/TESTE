    CMD:seditar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] == 0)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um admin !");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] < 1337)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao tem autorizacao para usar esse comando!");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new x_Emprego[32], proplev;
            if(sscanf(params, "s[25]d", x_Emprego, proplev))
            {
                SendClientMessage(playerid, COR_BRANCO, "|____________ Editar ____________|");
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /seditar [nome] [quantidade] (Use para casas e empresas)");
                SendClientMessage(playerid, COR_GREY, "Casas: Level, Preco, carro, descricao, chave(0 aberto - 1 fechado)");
                SendClientMessage(playerid, COR_GREY, "Empresas: Level, Preco, fundos, descricao, chave(0 aberto - 1 fechado)");
                SendClientMessage(playerid, COR_GREY, "Fazendas: Level, Preco, fundos, descricao, chave(0 aberto - 1 fechado)");
                return 1;
            }
            for(new i = 0; i < sizeof(HouseInfo); ++i)
            {
                if (PlayerToPoint(3, playerid,HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
                {
                    format(stringZCMD, sizeof(stringZCMD), "Casa: %d", i);
                    SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                    if(strcmp(x_Emprego,"level",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        HouseInfo[i][hLevel] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou o Level Minimo da Casa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SaveCasa(i);
                    }
                    else if(strcmp(x_Emprego,"preco",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        HouseInfo[i][hValue] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou o Preco Minimo da Casa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SaveCasa(i);
                    }
                    else if(strcmp(x_Emprego,"carro",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        HouseInfo[i][hVec] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou o Carro da Casa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SaveCasa(i);
                    }
                    if(strcmp(x_Emprego,"chave",true) == 0)
                    {
                        if(proplev < 0 || proplev > 1) { SendClientMessage(playerid, COR_GRAD1, "Voce so pode Abrir(0) ou Fechar(1) a Empresa."); return 1; }
                        HouseInfo[i][hLock] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou a Chave da Casa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SaveCasa(i);
                    }
                }
            }
            for(new i = 0; i < sizeof(BizzInfo); ++i)
            {
                if (PlayerToPoint(3, playerid,BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ]))
                {
                    format(stringZCMD, sizeof(stringZCMD), "Bizz: %d (Empresa com interior)", i);
                    SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                    if(strcmp(x_Emprego,"level",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        BizzInfo[i][bLevelNeeded] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou o Level Minimo da Empresa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SalvarEmpresa(i);
                    }
                    else if(strcmp(x_Emprego,"preco",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        BizzInfo[i][bBuyPrice] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou o Preco Minimo da Empresa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SalvarEmpresa(i);
                    }
                    else if(strcmp(x_Emprego,"fundos",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        BizzInfo[i][bTill] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou os Fundos da Empresa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SalvarEmpresa(i);
                    }
                    else if(strcmp(x_Emprego,"chave",true) == 0)
                    {
                        if(proplev < 0 || proplev > 1) { SendClientMessage(playerid, COR_GRAD1, "Voce so pode Abrir(0) ou Fechar(1) a Empresa."); return 1; }
                        BizzInfo[i][bLocked] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou a Chave da Empresa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SalvarEmpresa(i);
                    }
                }
            }
            for(new i = 0; i < sizeof(SBizzInfo); ++i)
            {
                if (PlayerToPoint(3, playerid,SBizzInfo[i][sbEntranceX], SBizzInfo[i][sbEntranceY], SBizzInfo[i][sbEntranceZ]))
                {
                    format(stringZCMD, sizeof(stringZCMD), "Sbizz: %d (Empresa sem interior)", i);
                    SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                    if(strcmp(x_Emprego,"level",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        SBizzInfo[i][sbLevelNeeded] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou o Level Minimo da Empresa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SalvarSEmpresa(i);
                    }
                    else if(strcmp(x_Emprego,"preco",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        SBizzInfo[i][sbBuyPrice] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou o Preco Minimo da Empresa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SalvarSEmpresa(i);
                    }
                    else if(strcmp(x_Emprego,"fundos",true) == 0)
                    {
                        if(proplev < 1) { return 1; }
                        SBizzInfo[i][sbTill] = proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou os Fundos da Empresa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SalvarSEmpresa(i);
                    }
                    else if(strcmp(x_Emprego,"chave",true) == 0)
                    {
                        if(proplev < 0 || proplev > 1) { SendClientMessage(playerid, COR_GRAD1, "Voce so pode Abrir(0) ou Fechar(1) a Empresa."); return 1; }
                        SBizzInfo[i][sbLocked] =  proplev;
                        format(stringZCMD, sizeof(stringZCMD), "Voce Ajustou a Chave da Empresa para: %d", proplev);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        SalvarSEmpresa(i);
                    }
                }
            }
            for(new i = 0; i < sizeof(FBizzInfo); i++)
            {
                if (PlayerToPoint(3, playerid,FBizzInfo[i][fbEntranceX], FBizzInfo[i][fbEntranceY], FBizzInfo[i][fbEntranceZ]))
                {
                    format(stringZCMD, sizeof(stringZCMD), "Fazenda: %d", i);
                    SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                    if(proplev > 0)
                    {
                        if(strcmp(x_Emprego,"level",true) == 0)
                        {
                            FBizzInfo[i][fbLevelNeeded] = proplev;
                            SalvarFEmpresa(i);
                        }
                        else if(strcmp(x_Emprego,"preco",true) == 0)
                        {
                            FBizzInfo[i][fbBuyPrice] = proplev;
                            SalvarFEmpresa(i);
                        }
                        else if(strcmp(x_Emprego,"fundos",true) == 0)
                        {
                            FBizzInfo[i][fbTill] = proplev;
                            SalvarFEmpresa(i);
                        }
                        else if(strcmp(x_Emprego,"tipo",true) == 0)
                        {
                            FBizzInfo[i][fbDiscription] = proplev;
                            SalvarFEmpresa(i);
                        }
                        else if(strcmp(x_Emprego,"chave",true) == 0)
                        {
                            FBizzInfo[i][fbLocked] =  proplev;
                            SalvarFEmpresa(i);
                        }
                        else if(strcmp(x_Emprego,"produto",true) == 0)
                        {
                            FBizzInfo[i][fbProducts] =  proplev;
                            SalvarFEmpresa(i);
                        }
                        else if(strcmp(x_Emprego,"precoproduto",true) == 0)
                        {
                            FBizzInfo[i][fbPriceProd] =  proplev;
                            SalvarFEmpresa(i);
                        }
                        else if(strcmp(x_Emprego,"maxproduto",true) == 0)
                        {
                            FBizzInfo[i][fbMaxProducts] =  proplev;
                            SalvarFEmpresa(i);
                        }
                        else if(strcmp(x_Emprego,"produtoreq",true) == 0)
                        {
                            FBizzInfo[i][fbProductsReq] =  proplev;
                            SalvarFEmpresa(i);
                        }
                    }
                }
            }
            Atualizar3Dtexts();
        }
        return 1;
    }
    CMD:entrarRS(playerid, params[])
    {
        if (GetPlayerState(playerid) == 1)
        {
            VerificarEntradas(playerid);
        }
        return 1;
    }
    CMD:entrar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            for(new i = 0; i < sizeof(HouseInfo); ++i)
            {
                if (PlayerToPoint(2, playerid,HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
                {
                    if(PlayerInfo[playerid][pLevel] == 2)
                    {
                        SendClientMessage(playerid, -1, "Voce nao tem level necessario para entrar em casa !");
                        return 1;
                    }
                    if(PlayerInfo[playerid][pPHousekey] == i || HouseInfo[i][hLock] == 0)
                    {
                        SetPlayerInterior(playerid,HouseInfo[i][hInt]);
                        SetPlayerVirtualWorld(playerid,HouseInfo[i][hWorld]);
                        SetPlayerPos(playerid,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]);
                        GameTextForPlayer(playerid, "~w~Bem vindo em casa", 5000, 6);
                        InteriorAtual[playerid] = HouseInfo[i][hInt];
                        LocalAtual[playerid] = i;
                        HouseEntered[playerid] = i;
                    }
                    else
                    {
                        GameTextForPlayer(playerid, "~r~Fechado", 5000, 3);
                    }
                }
            }
            for(new i = 0; i < sizeof(BizzInfo); ++i)
            {
                if (PlayerToPoint(2, playerid,BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ]))
                {
                    if(PlayerInfo[playerid][pPbiskey] == i || GetPlayerMoneyEx(playerid) >= BizzInfo[i][bEntranceCost])
                    {
                        if(PlayerInfo[playerid][pPbiskey] != i)
                        {
                            if(BizzInfo[i][bLocked] == 1)
                            {
                                GameTextForPlayer(playerid, "~r~Fechado", 5000, 3);
                                return 1;
                            }
                            GivePlayerMoneyEx(playerid,-BizzInfo[i][bEntranceCost]);
                            format(stringZCMD, sizeof(stringZCMD), "~r~-R$%d", BizzInfo[i][bEntranceCost]);
                            GameTextForPlayer(playerid, stringZCMD, 5000, 3);
                            BizzInfo[i][bTill] += BizzInfo[i][bEntranceCost];
                            ExtortionBiz(i, BizzInfo[i][bEntranceCost]);
                        }
                        SetPlayerInterior(playerid,BizzInfo[i][bInterior]);
                        if(PlayerToPoint(2, playerid,1412.078979,-1700.173583,13.539500))
                        {
                            InteriorAtual[playerid] = 47;
                        }
                        else if(PlayerToPoint(2, playerid,2085.6714,2066.7856,11.0579))
                        {
                            InteriorAtual[playerid] = 48;
                        }
                        else if(PlayerToPoint(2, playerid,1791.2120,-1164.6317,23.8281))
                        {
                            InteriorAtual[playerid] = 40;
                        }
                        else if(PlayerToPoint(2, playerid,1069.8628,-1873.4392,13.5469))
                        {
                            InteriorAtual[playerid] = 41;
                        }
                        else if(PlayerToPoint(2, playerid,1498.3601,-1583.0319,13.5469))
                        {
                            InteriorAtual[playerid] = 49;
                        }
                        else if(PlayerToPoint(2, playerid,2177.5850,961.3901,10.8203))
                        {
                            InteriorAtual[playerid] = 50;
                        }
                        else if(PlayerToPoint(2, playerid,1631.8335,-1172.7843,24.0843))
                        {
                            InteriorAtual[playerid] = 51;
                        }
                        if (PlayerToPoint(2, playerid,BizzInfo[4][bEntranceX], BizzInfo[4][bEntranceY], BizzInfo[4][bEntranceZ]))
                        {
                            InteriorAtual[playerid] = 52;
                            LoadObjects(playerid);
                        }
                        SetPlayerPos(playerid,BizzInfo[i][bExitX],BizzInfo[i][bExitY],BizzInfo[i][bExitZ]);
                        LocalAtual[playerid] = i+99;
                        new dood[MAX_PLAYER_NAME];
                        GetPlayerName(playerid, dood, sizeof(dood));
                        format(stringZCMD, sizeof(stringZCMD), "%s pagou R$%d para entrar na empresa %d", dood, BizzInfo[i][bEntranceCost], i);
                        printf("%s", stringZCMD);
                    }
                    else
                    {
                        GameTextForPlayer(playerid, "~r~Voce nao tem dinheiro suficiente", 5000, 1);
                    }
                }
            }
            for(new i = 0; i < sizeof(FBizzInfo); i++)
            {
                if (PlayerToPoint(3, playerid,FBizzInfo[i][fbEntranceX], FBizzInfo[i][fbEntranceY], FBizzInfo[i][fbEntranceZ]))
                {
                    if(PlayerInfo[playerid][pPFazkey] == i || GetPlayerMoney(playerid) >= FBizzInfo[i][fbEntranceCost])
                    {
                        if(PlayerInfo[playerid][pPFazkey] != i)
                        {
                            if(FBizzInfo[i][fbProducts] < 1)
                            {
                                GameTextForPlayer(playerid, "~r~Fazenda sem produtos", 5000, 1);
                                return true;
                            }
                            if(FBizzInfo[i][fbLocked] == 1)
                            {
                                GameTextForPlayer(playerid, "~r~Fazenda fechada", 5000, 1);
                                return 1;
                            }
                        }
                        SetPlayerInterior(playerid,3);
                        InteriorAtual[playerid] = 52+i;
                        GivePlayerMoneyEx(playerid,-FBizzInfo[i][fbEntranceCost]);
                        format(stringZCMD, sizeof(stringZCMD), "~r~-R$%d", FBizzInfo[i][fbEntranceCost]);
                        GameTextForPlayer(playerid, stringZCMD, 5000, 3);
                        FBizzInfo[i][fbTill] += FBizzInfo[i][fbEntranceCost];
                        SetPlayerPos(playerid, 284.1897,309.8873,1003.3928);
                        SetPlayerVirtualWorld(playerid, i);
                        format(stringZCMD, sizeof(stringZCMD), "%s pagou R$%d para entrar na fazenda %d", PlayerName(playerid), FBizzInfo[i][fbEntranceCost], i);
                        printf("%s", stringZCMD);
                        return true;
                    }
                    else
                    {
                        GameTextForPlayer(playerid, "~r~Voce nao possui dinheiro suficiente", 5000, 1);
                        return true;
                    }
                }
            }
        }
        return 1;
    }
    CMD:sair(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            for(new i = 0; i <  sizeof(HouseInfo); ++i)
            {
                if(PlayerToPoint(1, playerid,HouseInfo[i][hExitx], HouseInfo[i][hExity], HouseInfo[i][hExitz]))
                {
                    if(HouseEntered[playerid] == i)
                    {
                        SetPlayerInterior(playerid,0);
                        SetPlayerVirtualWorld(playerid,0);
                        SetPlayerPos(playerid,HouseInfo[i][hEntrancex],HouseInfo[i][hEntrancey],HouseInfo[i][hEntrancez]);
                        InteriorAtual[playerid] = 0;
                        SetPlayerVirtualWorld(playerid, 0);
                        LocalAtual[playerid] = 255;
                        HouseEntered[playerid] = 999;
                        return 1;
                    }
                }
            }
            if(PlayerToPoint(2, playerid,316.3746,-169.6989,999.6010) ||  PlayerToPoint(2, playerid,285.8286,-85.2722,1001.5156)
            || PlayerToPoint(2, playerid, -794.9362,490.6324,1376.1953) || PlayerToPoint(2, playerid,315.7019,-142.9840,999.6016)
            || PlayerToPoint(2, playerid,1846.6278,-1721.8167,5202.5859) || PlayerToPoint(2, playerid, 832.6270,7.2666,1004.1797))
            {
                InteriorAtual[playerid] = 0;
            }
            for(new i = 0; i <  sizeof(BizzInfo); ++i)
            {
                if(PlayerToPoint(2, playerid,BizzInfo[i][bExitX], BizzInfo[i][bExitY], BizzInfo[i][bExitZ]))
                {
                    ctlicencasls[playerid] = 0;
                    ctlicencaslv[playerid] = 0;
                    SetPlayerInterior(playerid,0);
                    InteriorAtual[playerid] = 0;
                    SetPlayerVirtualWorld(playerid, 0);
                    SetPlayerPos(playerid,BizzInfo[i][bEntranceX],BizzInfo[i][bEntranceY],BizzInfo[i][bEntranceZ]);
                    LocalAtual[playerid] = 255;
                    return 1;
                }
            }
            if(PlayerToPoint(2, playerid, 284.1897,309.8873,1003.3928))
            {
                SetPlayerInterior(playerid,0);
                InteriorAtual[playerid] = 0;
                SetPlayerPos(playerid,FBizzInfo[GetPlayerVirtualWorld(playerid)][fbEntranceX],FBizzInfo[GetPlayerVirtualWorld(playerid)][fbEntranceY],FBizzInfo[GetPlayerVirtualWorld(playerid)][fbEntranceZ]);
                SetPlayerVirtualWorld(playerid, 0);
                LocalAtual[playerid] = 255;
                return 1;
            }
            if(IsPlayerInAnyVehicle(playerid))
            {
                TogglePlayerControllable(playerid, 1);
                RemovePlayerFromVehicleEx(playerid);
            }
        }
        return 1;
    }
    CMD:home(playerid, params[])  return ForT:mapacasa(playerid, params);
    CMD:mapacasa(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pPHousekey] != 999)
            {
                SetPlayerCheckpoint(playerid,HouseInfo[PlayerInfo[playerid][pPHousekey]][hEntrancex], HouseInfo[PlayerInfo[playerid][pPHousekey]][hEntrancey], HouseInfo[PlayerInfo[playerid][pPHousekey]][hEntrancez], 4.0);
                GameTextForPlayer(playerid, "~r~mapa da casa marcado", 5000, 1);
                gPlayerCheckpointStatus[playerid] = CHECKPOINT_HOME;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao possui uma empresa !");
                return 1;
            }
        }
        return 1;
    }
    CMD:mapaemp(playerid, params[])
    {
        for(new h = 0; h < sizeof(SBizzInfo); h++)
