                 SetPlayerRaceCheckpoint(playerid, 0, TruckTeste[CPorder5[playerid]+1][0],TruckTeste[CPorder5[playerid]+1][1],TruckTeste[CPorder5[playerid]+1][2],TruckTeste[CPorder5[playerid]+2][0],TruckTeste[CPorder5[playerid]+2][1],TruckTeste[CPorder5[playerid]+2][2],4.0);
             }
             CPorder5[playerid] += 1;
             PlayerPlaySound(playerid,1058,X,Y,Z);
         }
     }
     return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
     ColorMatch_Eliminate(playerid);
     new oldnew;
     if(IsPlayerNPC(playerid))
     {
          return 1;
     }
     if(oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER)
    {
        if(GetPVarInt(playerid, "VarFPS"))
        {
            if(IsValidObject(dcObject[playerid])==1)DestroyObject(dcObject[playerid]);
            SetCameraBehindPlayer(playerid);
            SetPVarInt(playerid, "VarFPS", 0);
        }
    }
     if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
     {
          ShowPlayerVelocimetro(playerid) ;
