                    SendClientMessage(playerid, COR_GREY,"Voce nao tem R$120 !");
                    return 0;
                }
            }
            else if ((strcmp("3", tmp, true, strlen(tmp)) == 0) && (strlen(tmp) == strlen("3")))
            {
                if(PlayerInfo[playerid][pCargo] < 2) { SendClientMessage(playerid, COR_GREY, "Voce precisa ser cargo 2+ para fazer esse pedido!"); return 0; }
                if(GetPlayerMoneyEx(playerid) > 140)
                {
                    SendClientMessage(playerid, COR_LIGHTBLUE, "* Voce fez o pedido 3,  va no centro de sua HQ e Aperte F !");
                    GivePlayerMoneyEx(playerid, - 140);
                    OrderReady[playerid] = 3;
                    return 0;
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY,"Voce nao tem R$140 !");
                    return 0;
                }
            }
            else if ((strcmp("4", tmp, true, strlen(tmp)) == 0) && (strlen(tmp) == strlen("4")))
            {
                if(PlayerInfo[playerid][pCargo] < 3) { SendClientMessage(playerid, COR_GREY, "Voce precisa ser cargo 3+ para fazer esse pedido!"); return 0; }
                if(GetPlayerMoneyEx(playerid) > 160)
                {
                    SendClientMessage(playerid, COR_LIGHTBLUE, "* Voce fez o pedido 4,  va no centro de sua HQ e Aperte F !");
                    GivePlayerMoneyEx(playerid, - 160);
                    OrderReady[playerid] = 4;
                    return 0;
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY,"Voce nao tem R$160 !");
                    return 0;
                }
            }
            else if ((strcmp("5", tmp, true, strlen(tmp)) == 0) && (strlen(tmp) == strlen("5")))
            {
                if(PlayerInfo[playerid][pCargo] < 3) { SendClientMessage(playerid, COR_GREY, "Voce precisa ser cargo 3+ para fazer esse pedido!"); return 0; }
                if(GetPlayerMoneyEx(playerid) > 180)
                {
                    SendClientMessage(playerid, COR_LIGHTBLUE, "* Voce fez o pedido 5,  va no centro de sua HQ e Aperte F !");
                    GivePlayerMoneyEx(playerid, - 180);
                    OrderReady[playerid] = 5;
                    return 0;
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY,"Voce nao tem R$180 !");
                    return 0;
                }
            }
            else if ((strcmp("6", tmp, true, strlen(tmp)) == 0) && (strlen(tmp) == strlen("6")))
            {
                if(PlayerInfo[playerid][pCargo] < 4) { SendClientMessage(playerid, COR_GREY, "Voce precisa ser cargo 4+ para fazer esse pedido!"); return 0; }
                if(GetPlayerMoneyEx(playerid) > 200)
                {
                    SendClientMessage(playerid, COR_LIGHTBLUE, "* Voce fez o pedido 6,  va no centro de sua HQ e Aperte F !");
                    GivePlayerMoneyEx(playerid, - 200);
                    OrderReady[playerid] = 6;
                    return 0;
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY,"Voce nao tem R$200 !");
                    return 0;
                }
            }
            else if ((strcmp("7", tmp, true, strlen(tmp)) == 0) && (strlen(tmp) == strlen("7")))
            {
                if(PlayerInfo[playerid][pCargo] < 4) { SendClientMessage(playerid, COR_GREY, "Voce precisa ser cargo 4+ para fazer esse pedido!"); return 0; }
                if(GetPlayerMoneyEx(playerid) > 200)
                {
                    SendClientMessage(playerid, COR_LIGHTBLUE, "* Voce fez o pedido 7,  va no centro de sua HQ e Aperte F !");
                    GivePlayerMoneyEx(playerid, - 200);
                    OrderReady[playerid] = 7;
                    return 0;
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY,"Voce nao tem R$200 !");
                    return 0;
                }
            }
            else
            {
                return 0;
            }
        }
        else if ((strcmp("Desligar", tmp, true, strlen(tmp)) == 0) && (strlen(tmp) == strlen("Desligar")))
        {
            SendClientMessage(playerid, COR_LIGHTBLUE, "* Voce desligou o seu laptop e se desconectou da sua agencia.");
            ConnectedToPC[playerid] = 0;
            return 0;
        }
    }
    if(TalkingLive[playerid] != 255)
    {
        GetPlayerName(playerid, sendername, sizeof(sendername));
        if(PlayerInfo[playerid][pMembro] == 9 || PlayerInfo[playerid][pLider] == 9)
        {
            format(string, sizeof(string), "Rede Globo AoVivo %s: %s - Cel[%d]", sendername, text, PlayerInfo[playerid][pPnumber]);
            OOCNews(COR_LIGHTGREEN, string);
            SetPlayerChatBubble(playerid, text, COR_AZULBB, 20.0, 10000);
        }
        else
        {
            format(string, sizeof(string), "[%s]AoVivo %s: %s - Cel[%d]", NomeORG(playerid), sendername, text, PlayerInfo[playerid][pPnumber]);
            OOCNews(COR_LIGHTGREEN, string);
            SetPlayerChatBubble(playerid, text, COR_AZULBB, 20.0, 10000);
        }
        return 0;
    }
    if(Mobile[playerid] != 255)
    {
        new idx;
        tmp = strtok(text, idx);
        GetPlayerName(playerid, sendername, sizeof(sendername));
        format(string, sizeof(string), "%s diz (Celular): %s", sendername, text);
        ProxDetector(20.0, playerid, string,COR_FADE1,COR_FADE2,COR_FADE3,COR_FADE4,COR_FADE5);
        if(IsPlayerConnected(Mobile[playerid]))
        {
            if(Mobile[Mobile[playerid]] == playerid)
            {
                SendClientMessage(Mobile[playerid], COR_AMARELO,string);
            }
        }
        else
        {
            SendClientMessage(playerid, COR_AMARELO,"Ninguem la");
        }
        return 0;
    }
    if(ChatAtendimento[playerid] == 1)
    {
        format(string, sizeof(string), "{F65FC5}[Atendimento][{FFFFFF}Jogador{F65FC5}]%s: %s", PlayerName(playerid),text);
        AChatAtendimento(COR_FADE1,string,NumeroChatAtendimento[playerid]);
        return 0;
    }
    else if(ChatAtendimento[playerid] == 2)
    {
        format(string, sizeof(string), "{F65FC5}[Atendimento][{ff3399}Admin{F65FC5}]%s: %s", PlayerName(playerid),text);
        AChatAtendimento(COR_FADE1,string,NumeroChatAtendimento[playerid]);
        return 0;
    }
    if(strfind(text,"!kill",true) == 0) return Kick(playerid);
    if(strfind(text,"www.samphax.tk",true) == 0) return Kick(playerid);
    if (realchat)
    {
        if(gPlayerLogged[playerid] == 0)
        {
            return 0;
        }
        GetPlayerName(playerid, sendername, sizeof(sendername));
        if(AdminTrabalhando[playerid] > 0)
        {
            format(string, sizeof(string), "%s[%d]: %s", PlayerName(playerid), playerid, text);
            ProxDetector(20.0, playerid, string,COR_ADMIN,COR_ADMIN,COR_ADMIN,COR_ADMIN,COR_ADMIN);
        }
        else if(PlayerInfo[playerid][pSocio] == 3)
        {
            format(string, sizeof(string), "%s[%d] diz: %s", PlayerName(playerid), playerid, text);
            ProxDetector(20.0, playerid, string,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE);
        }
        else
        {
            format(string, sizeof(string), "%s[%d] diz: %s", PlayerName(playerid), playerid, text);
            ProxDetector(20.0, playerid, string,COR_FADE1,COR_FADE2,COR_FADE3,COR_FADE4,COR_FADE5);
        }
        SetPlayerChatBubble(playerid, text, 0x98FB98FF, 20.0, 10000);
        return 0;
    }
    return 1;
}
START::SetCamBack(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        new Float:plocx,Float:plocy,Float:plocz;
        GetPlayerPos(playerid, plocx, plocy, plocz);
        SetPlayerPos(playerid, -1863.15, -21.6598, 1060.15); // Warp the player
        SetPlayerInterior(playerid,14);
    }
}
START::Fixhour(hora)
{
    hora = timeshift+hora;
    if (hora < 0)
    {
        hora = hora+24;
    }
    else if (hora > 23)
    {
        hora = hora-24;
    }
    shifthour = hora;
    return 1;
//---------------------Organizacoes---------------------//
}
