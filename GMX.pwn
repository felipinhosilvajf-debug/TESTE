                        ExtortionSBiz(7,150);
                        format(stringZCMD,sizeof(stringZCMD),"Anuncio: Vendo Drogas,interesados me liguem !,Jogador: %s - Telefone(%d) - ID[%d]",sendername,cel,playerid);
                        SendClientMessageToAll(0x00FF00FF,stringZCMD);
