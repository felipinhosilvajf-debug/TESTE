    CMD:setarmat(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1340)
        {
            for(new x = 1; x < MAX_ORGS; x++)
            {
                if(!OrgsCOP(x))
                {
                    CofreOrg[x][Materiais] = CofreOrg[x][Materiais]+=100000; //
                }
            }
            SendClientMessage(playerid, COR_LIGHTBLUE," Voce setou 100000 de materiais para todas as gangs");
        }
        return true;
    }

    CMD:setardrogas(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1340)
        {
            for(new x = 1; x < MAX_ORGS; x++)
            {
                if(!OrgsCOP(x))
                {
                    CofreOrg[x][Maconha] = CofreOrg[x][Maconha]+100000; //
                }
            }
            SendClientMessage(playerid, COR_BRANCO,"Voce setou 100000 de drogas para todas as gangs.");
            return true;
        }
        return true;
    }
    CMD:guerramorro(playerid)
    {
        if(PlayerInfo[playerid][pAdmin] < 1337)return SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando!");
        if(!GuerraMorro[gGuerra])
        {
            gIniciarGuerraMorro();
        }
        else
        {
            gTerminarGuerraMorro();
        }
        return 1;
    }
    CMD:martelinhoadmin(playerid)
    {
        if(PlayerInfo[playerid][pAdmin] == 1342)
        {
            new martelinhomessage[49+MAX_PLAYER_NAME];
            if(UmMartelinho[playerid] == false)
            {
                UmMartelinho[playerid] = true;
                SetPlayerAttachedObject(playerid, 9, 18635, 6, -0.211000, -0.093999, 0.000000, 4.699998, 8.100019, -0.500001, 3.759002, 4.369003, 2.290000); //We attach the martelinho object in the player's right hand.
                GivePlayerWeapon(playerid,5,1);
                format(martelinhomessage,sizeof(martelinhomessage),"{FF0000}O admin %s pegou seu martelinho do ban.",PlayerName(playerid));
                SendClientMessageToAll(-1,martelinhomessage);
            }
            else
            {
                UmMartelinho[playerid] = false;
                RemovePlayerAttachedObject(playerid, 9);
                format(martelinhomessage,sizeof(martelinhomessage),"{FF0000}O admin %s guardou seu martelinho do ban.",PlayerName(playerid));
                SendClientMessageToAll(-1,martelinhomessage);
            }
        }
        return 1;
    }
