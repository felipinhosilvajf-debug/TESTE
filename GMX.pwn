    CMD:editarmeugrafite(playerid){
        for(new x; x != MAX_PORTAO; x++){
            if(GrafiteInfo[x][grafiteCreated] &&
               !strcmp(PlayerName(playerid), GrafiteInfo[x][grafiteNick], true) &&
               IsPlayerInRangeOfPoint(playerid, 8.0, GrafiteInfo[x][grafiteX], GrafiteInfo[x][grafiteY], GrafiteInfo[x][grafiteZ])){
                SendClientMessage(playerid, TEAM_BALLAS_COR, " Voce esta editando este grafite !");
                EditandoGrafite[playerid] = 1;
                EditObject(playerid, GrafiteInfo[x][grafiteObject]);
                return 1;
            }
        }
        SendClientMessage(playerid, COR_GREY, " Voce nao e o Dono Do Grafite !");
        return 1;
    }
    CMD:editargrafite(playerid){
        if(PlayerInfo[playerid][pAdmin] < 1340)
            return SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO:{ffffff} Voce nao e um Administrador!");
        for(new x; x != MAX_GRAFTEXT; x++){
            if(GrafiteInfo[x][grafiteCreated] && IsPlayerInRangeOfPoint(playerid, 5.0, GrafiteInfo[x][grafiteX], GrafiteInfo[x][grafiteY], GrafiteInfo[x][grafiteZ])){
                SendClientMessage(playerid, TEAM_BALLAS_COR, " Voce esta editando este grafite !");
                EditandoGrafite[playerid] = 1;
                EditObject(playerid, GrafiteInfo[x][grafiteObject]);
                return 1;
            }
        }
        SendClientMessage(playerid, COR_GREY, " Voce nao esta perto de nenhum grafite !");
        return 1;
    }
