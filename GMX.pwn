START::SetPlayerSpawn(playerid)
{
    new rand;
    if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
    {
        if(PlayerInfo[playerid][pSex] == 0)
        {
            PlayerInfo[playerid][pSex] = 1;
        }
        if(sincronizando[playerid] == 1)
        {
            return 1;
        }
        if(MedicBill[playerid] >= 2 && PlayerInfo[playerid][pJailed] == 0)
        {

        }
        if(PlayerInfo[playerid][pVIP] > 0)
        {
            SetPlayerHealth(playerid, 100.0);
        }
        else
        {
            SetPlayerHealth(playerid, 100+PlayerInfo[playerid][pSHealth]);
        }
        MenuTR[playerid] = 0;
        headshot[playerid] = 0;
        spawnado[playerid] = 1;
        MedicBill[playerid] ++;
        SetPlayerToTeamColor(playerid);
        protecao[playerid] = 0;
        RemovePlayerAttachedObject(playerid,9);
        // -------------------------------------------------//
        if(AindaTemConta[playerid] == 1)
        {
             CarregarDados(playerid);
             format(stringZCMD, 100, "Players/%s.ini", PlayerName(playerid));
             strmid(PlayerInfo[playerid][pEmail], DOF2_GetString(stringZCMD, "Email"), 0, strlen(DOF2_GetString(stringZCMD, "Email")), 255);
             logouagora[playerid] = 1;
             ChecarDonob(playerid);
             ChecarDonoh(playerid);
             OnPlayerSave(playerid);
             AindaTemConta[playerid] = 0;
        }
        if(PlayerInfo[playerid][pTutorial] == 0 && AindaTemConta[playerid] == 0)
        {
