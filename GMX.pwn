        PlayerInfo[playerid][pConqSocio] = 1;*/

        new Cont;
        new Titulo[800];

        MEGAString[0] = EOS;
        format(stringZCMD, sizeof(stringZCMD), "{ffffff}Conquista\t{ffffff}Recompensa\n");
        strcat(MEGAString,stringZCMD);

        if(PlayerInfo[playerid][pConqRegistro] == 1)
        {
            format(stringZCMD, sizeof(stringZCMD), "{ffffff}Conquistas: {818689}Registro no Servidor\t{ffffff}R${df5454}200\n");
            strcat(MEGAString,stringZCMD);
            Cont++;
        }

        if(PlayerInfo[playerid][pConqSocio] == 1)
        {
            format(stringZCMD, sizeof(stringZCMD), "{ffffff}Conquistas: {818689}Conta Socio\t{ffffff}R${df5454}7.000\n");
            strcat(MEGAString,stringZCMD);
            Cont++;
        }

        if(PlayerInfo[playerid][pConqCasa] == 1)
        {
            format(stringZCMD, sizeof(stringZCMD), "{ffffff}Conquistas: {818689}Primeira Casa\t{ffffff}R${df5454}20.000\n");
            strcat(MEGAString,stringZCMD);
            Cont++;
        }

        if(PlayerInfo[playerid][pConqEmp] == 1)
        {
            format(stringZCMD, sizeof(stringZCMD), "{ffffff}Conquistas: {818689}Primeira Empresa\t{ffffff}R${df5454}20.000\n");
            strcat(MEGAString,stringZCMD);
            Cont++;
        }


        format(Titulo, sizeof(Titulo), "{ffffff}(Suas Conquistas): {818689}Progresso: ({df5454}%d/4{818689})", Cont);
        ShowPlayerDialog(playerid, 999, DIALOG_STYLE_TABLIST_HEADERS, Titulo, MEGAString, "Fechar", "");
        return 1;
    }

    CMD:verlogs(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1)
        {
            ShowPlayerDialog(playerid, 15859, DIALOG_STYLE_LIST, "{ffffff}Escolha uma das opcoes", "{df5454}Ver logs: {ffffff}Casas(**)\n{df5454}Ver logs: {ffffff}Ban(Ban)\n{df5454}Ver logs: {ffffff}Desban(**)\n{df5454}Ver logs: {ffffff}Cadeia Agendado(CarandiruAgendado)\n{df5454}Ver logs: {ffffff}GMX/Salvamento de Dados(Gmx)\n{df5454}Ver logs: {ffffff}Anti Xiter(AntiXiter)\n{df5454}Ver logs: {ffffff}Kick(kick)\n{df5454}Ver logs: {ffffff}sms(sms)\n{df5454}Ver logs: {ffffff}Divulgou(Divulgou)\n{df5454}Ver logs: {ffffff}Loja VIP(Loja VIP)", "Vizualizar", "Fechar");
        }
        else
        {
            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao e um Administrador!");
        }
        return 1;
    }



    CMD:admin(playerid, params[])  return ForT:a(playerid, params);
    CMD:cadmin(playerid, params[])  return ForT:a(playerid, params);
    CMD:ah(playerid, params[])  return ForT:a(playerid, params);
    CMD:a(playerid, result[])
    {
        if(PlayerMutado[playerid] == 1)
        {
            SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao pode falar, pois foi calado !");
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(isnull(result))
            {
                SendClientMessage(playerid, COR_OBS, "INFO, USE: {818689}(/a)dmin [CHAT ADMIN]");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 1)
            {
                new lolz[120];
                if(PlayerInfo[playerid][pAdmin] == 1)lolz = "{ffffff}Aprendiz";
                if(PlayerInfo[playerid][pAdmin] == 2)lolz = "{df5454}estagiario";
                if(PlayerInfo[playerid][pAdmin] == 3)lolz = "{00ffff}Auxiliar";
                if(PlayerInfo[playerid][pAdmin] == 4)lolz = "{0000ff}Tecnico";
                if(PlayerInfo[playerid][pAdmin] == 349)lolz = "{df5454}Helper";
                if(PlayerInfo[playerid][pAdmin] == 1337)lolz = "{df5454}Administrador";
                if(PlayerInfo[playerid][pAdmin] == 1338)lolz = "{df5454}Master";
                if(PlayerInfo[playerid][pAdmin] == 1339)lolz = "{ffff00}Gerente";
                if(PlayerInfo[playerid][pAdmin] == 1340)lolz = "{df5454}Sub-Dono";
                if(PlayerInfo[playerid][pAdmin] == 1341)lolz = "{df5454}Dono";
                if(PlayerInfo[playerid][pAdmin] == 1342)lolz = "{aa00ff}Fundador";
                if(strcmp(PlayerName(playerid),"VBSTAFF", true) == 0)
                {
                    lolz = "{aa00ff}Fundador";
                }
                format(stringZCMD, sizeof(stringZCMD), "{bababa}*%d* [%s{BABABA}] %s: %s",PlayerInfo[playerid][pAdmin], lolz, PlayerName(playerid), result);
                ABroadCast(0xBABABABA, stringZCMD, 1);// chat admin
                //ChatAdminLog(stringZCMD);
            }
        }
        return 1;
    }
    CMD:sireneon(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(!IsPlayerInAnyVehicle(playerid))
            {
                SendClientMessage(playerid, COR_BALLAS, "Voce nao esta em um veiculo !");
                return 1;
            }
            new vehicleid = GetPlayerVehicleID(playerid);
            if(IsACop(playerid) && Sireneon[playerid] == 0)
            {
                new Subaru = GetVehicleModel(vehicleid);
                if(Subaru == 560)
                {
                    new Float:x,Float:y,Float:z;
                    GetPlayerPos(playerid,x,y,z);
                    Sireneon[playerid] = 1;
                    sirene[GetPlayerVehicleID(playerid)] = CreateDynamicObject(19419,x,y,z,0,0,0,0);
                    sirene2[GetPlayerVehicleID(playerid)] = CreateDynamicObject(19288,x,y,z,0,0,0,0);
                    AttachDynamicObjectToVehicle(sirene[GetPlayerVehicleID(playerid)],GetPlayerVehicleID(playerid),0.0,0,0.82,0,0,0);
