            new giveplayer[MAX_PLAYER_NAME];
            GetPlayerName(CuraOffer[playerid], giveplayer, sizeof(giveplayer));
            GetPlayerName(playerid, sendername, sizeof(sendername));
            format(string, sizeof(string), "* Voce nao aceitou a proposta do Advogado %s.", giveplayer);
            SendClientMessage(playerid, COR_BRANCO, string);
            //format(string, sizeof(string), "* preso %s nao aceitou a sua proposta !", giveplayer);
            //SendClientMessage(giveplayer, COR_BRANCO, string);
            JaTemAdvogado[playerid] = 0;
        }
        if(response)
        {
             new giveplayer[MAX_PLAYER_NAME];
             if(CuraOffer[playerid] < 999)
             {
                  if(GetPlayerMoneyEx(playerid) > CuraPrice[playerid])
                  {
                       if (IsPlayerConnected(CuraOffer[playerid]))
                       {
                            GetPlayerName(CuraOffer[playerid], giveplayer, sizeof(giveplayer));
                            GetPlayerName(playerid, sendername, sizeof(sendername));
                            format(string, sizeof(string), "* Voce pagou R$[%d] para o Advogado: %s e foi solto.", CuraPrice[playerid], giveplayer);
                            SendClientMessage(playerid, COR_BRANCO, string);
                            format(string, sizeof(string), "* Preso %s foi solto pelo advogado: %s, por: R$[%d].", PlayerName(playerid), giveplayer, CuraPrice[playerid]);
                            ProxDetector(30.0, playerid, string, COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE);
                            JaTemAdvogado[CuraOffer[playerid]] = 0;
                            LicencaAdvogado[CuraOffer[playerid]] -= 1;
                            CallAdvogado[playerid] = 0;
                            PlayerInfo[playerid][pJailTime] = 1;
                            PlayerInfo[CuraOffer[playerid]][pLawSkill] ++;
                            GivePlayerMoneyEx(CuraOffer[playerid], CuraPrice[playerid]);
                            CuraOffer[playerid] = 999;
                            CuraPrice[playerid] = 0;
                            return 1;
                       }
                  }
                  else
                  {
                       SendClientMessage(playerid, COR_BRANCO, "O preso nao tinha dinheiro o suficiente !");
                       return 1;
                  }
             }
        }
    }
