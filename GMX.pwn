                        return 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao esta em um territorio de drogas! /gps");
                    return 1;
                }
            }
            if(strcmp(x_Emprego,"materiais",true) == 0)
            {
                if(PlayerToPoint(2.0, playerid, 1173.2739,-2037.0060,69.1413) || PlayerToPoint(2.0, playerid, 1757.1095,-1943.4386,13.5703) || PlayerToPoint(2.0, playerid, -718.2471,-1938.9644,8.3187) || PlayerToPoint(5.0, playerid, -13.5814, -2502.1829, 36.6555))
                {
                    if(quantia < 1 || quantia > 10000)
                    {
                        SendClientMessage(playerid, COR_GRAD2, "nao pode pegar menos de 1 e nem mais de 10000");
                        return 1;
                    }
                    if(PlayerInfo[playerid][pMats] >= quantia)
                    {
                        PlayerInfo[playerid][pMats] = PlayerInfo[playerid][pMats]-quantia;
                        PlayerInfo[playerid][psMats] = PlayerInfo[playerid][psMats]+quantia;
                        format(gstring, sizeof(gstring), "* Voce escondeu %d materiais!",quantia);
                        SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                        return 1;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao tem tudo isso !");
                        return 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao esta na caixa de materiais !");
                    return 1;
                }
            }
        }
        return 1;
    }



    CMD:veiculo(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new x_Emprego[80];
            if(sscanf(params, "s[34]", x_Emprego))
            {
                SendClientMessage(playerid, COR_START, "{df5454}x {818689}Use: (/veiculo ajuda) para ver os comandos do seu carro permanente:");
                return 1;
            }
            if(strcmp(x_Emprego,"ajuda",true) == 0)
            {
                new Str[5220];
                strcat(Str, "{ffffff}USE: /veiculo [Nome]\n\nNomes Disponiveis:\n{df5454}-> /veiculo {ffffff}ajuda - {df5454}Ver a lista de comandos disponivel.\n{df5454}-> /veiculo {ffffff}vender - {df5454}Vender o seu Veiculo.\n{df5454}-> /veiculo {ffffff}estacionar - {df5454}Estacionar o veiculo em um local.\n{df5454}-> /veiculo {ffffff}revender - {df5454}Em Breve.\n{df5454}-> /veiculo {ffffff}alarme -{df5454} Ativar o alarme do veiculo.\n{df5454}-> /veiculo {ffffff}trancar (ou apenas /trancar) - {df5454}Trancar o veiculo\n{df5454}-> /veiculo {ffffff}localizar - {df5454}Localizar seu veiculo.\n{df5454}-> /veiculo {ffffff}placa - {df5454}Mostra a Placa e o ID de seus Veiculos no CHAT\n\n{df5454}Informacoes:\n\n{00ff00}Sair do jogo: {ffffff}Toda vez que Voce sair do jogo, seu veiculo ira sumir junto, e sera carregado novamente\nonde estacionou, caso tenha comprado e nao estacionado, ele ficara na ultima posicao onde ficou pela ultima vez.\n\n{00ff00}Estacionamento: {ffffff}Ao uilizar o comando ({df5454}/veiculo estacionar{ffffff}) definira a posicao onde ele ficara\ntoda vez que ele explodir(ou quando relogar).");
                ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX,"{ffffff}Comandos de Veiculo Propio", Str, "Fechar","");
                return 1;
            }
            if(strcmp(x_Emprego,"estacionar",true) == 0)
            {
                    new vehicle = GetPlayerVehicleID(playerid);
                    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && CarrosConcePlayer(vehicle) && VeiculoInfo[playerid][vDono] == 1)
                    {
                        //GetVehicleModel(vehicle);
                        //DestruirVehConce(playerid);
                        //CriarVeiculo(playerid);
                        EstacionarVeh(playerid);
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_START, "ERRO, INFO: {818689}Voce precisa esta em seu veiculo, ou de motorista dele{ffffff}!");
                    }
                    return 1;
            }
            if(strcmp(x_Emprego,"trancar",true) == 0)
            {
                if(VeiculoInfo[playerid][vDono] == 1)
                {
                    TrancarCarroConce(playerid);
                }
                return 1;
            }
            if(strcmp(x_Emprego,"localizar",true) == 0)
            {
                if(VeiculoInfo[playerid][vDono] == 1)
                {
                    new Float:Pos[5];
                    GetVehiclePos(VeiculoPessoal[playerid], Pos[0], Pos[1], Pos[2]);
                    SetPlayerCheckpoint(playerid, Pos[0], Pos[1], Pos[2], 6);
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}INFO: {ffffff}A Localizacao de seu veiculo foi inserida no mapa!");

                /*  MEGAString[0] = EOS;
                    format(stringZCMD, sizeof(stringZCMD), "{ffffff}ID Veiculo\tPlaca\tDistancia\tLocal\n");
                    strcat(MEGAString,stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "{ffffff}%d %s\tBPS-0001\t%s\t**\n", GetVehID(playerid), Nomedosveiculos[GetVehID(playerid)]);
                    strcat(MEGAString,stringZCMD);
                    ShowPlayerDialog(playerid, 15869, DIALOG_STYLE_TABLIST_HEADERS, "Localizar Veiculo", MEGAString, "Localizar", "Fechar");*/
                }
                else
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao tem nenhum Veiculo!");
                }
                return 1;
            }
            if(strcmp(x_Emprego,"placa",true) == 0)
            {
                if(VeiculoInfo[playerid][vDono] == 1)
                {
                    new Str2[800];
                    format(Str2, sizeof(Str2), "{ffffff}Placa: {df5454}%s {ffffff}| ID: {df5454}%d", VeiculoInfo[playerid][vPlaca],GetVehID(playerid));
                    SendClientMessage(playerid, COR_START, Str2);
                }
                return 1;
            }
            if(strcmp(x_Emprego,"vender",true) == 0)
            {
                VenderVeiculo(playerid);
                return 1;
            }
        }
        return 1;
    }
