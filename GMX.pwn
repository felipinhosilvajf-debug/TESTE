START::ShowStats(playerid,targetid)
{
    if(IsPlayerConnected(playerid)&&IsPlayerConnected(targetid))
    {
        new cash =  GetPlayerMoneyEx(targetid);
        new atext[20];
        if(PlayerInfo[targetid][pSex] == 1) {atext = "Masculino";}
        else if(PlayerInfo[targetid][pSex] == 2) { atext = "Feminino"; }
        new dtext[20];
        if(PlayerInfo[targetid][pDoenca] == 1) { dtext = "Mongolismo"; }
        else if(PlayerInfo[targetid][pDoenca] == 2) { dtext = "AIDS"; }
        else if(PlayerInfo[targetid][pDoenca] == 3) { dtext = "Herpes Genital"; }
        else if(PlayerInfo[targetid][pDoenca] == 4) { dtext = "Cirrose"; }
        else if(PlayerInfo[targetid][pDoenca] == 5) { dtext = "Cancer de Pulmao"; }
        else { dtext = "Nenhuma"; }

        new xtextt[5], textdecod[5], textdina[5], jetperm[5], textkitcarro[5], textgalao[5], kitperm[5];

        if(TemTituloPersonalizado[targetid] == 1) xtextt = "Sim";
        else if(TemTituloPersonalizado[targetid] == 0)xtextt = "nao";
        jetperm = "nao";
        textdecod = "nao";
        textgalao = "nao";
        textkitcarro = "nao";
        kitperm = "nao";
        textdina = "nao";
        new jtext[30];
        if(PlayerInfo[targetid][pEmprego] == 0) { jtext = "Nenhum"; }
        else if(PlayerInfo[targetid][pEmprego] == 1) { jtext = "Detetive"; }
        else if(PlayerInfo[targetid][pEmprego] == 2) { jtext = "Advogado"; }
        else if(PlayerInfo[targetid][pEmprego] == 3) { jtext = "Seguranca"; }
        else if(PlayerInfo[targetid][pEmprego] == 4) { jtext = "Motorista de Onibus"; }
        else if(PlayerInfo[targetid][pEmprego] == 5) { jtext = "Mendigo"; }
        else if(PlayerInfo[targetid][pEmprego] == 6) { jtext = "Caminhoneiro"; }
        else if(PlayerInfo[targetid][pEmprego] == 7) { jtext = "Agente Penitenciario"; }
        else if(PlayerInfo[targetid][pEmprego] == 8) { jtext = "Lixeiro"; }
        else if(PlayerInfo[targetid][pEmprego] == 9) { jtext = "Ladrao de Carros"; }
        else if(PlayerInfo[targetid][pEmprego] == 10) { jtext = "Fazendeiro"; }
        else if(PlayerInfo[targetid][pEmprego] == 11) { jtext = "Coveiro"; }
        else if(PlayerInfo[targetid][pEmprego] == 12) { jtext = "Carteiro"; }
        else if(PlayerInfo[targetid][pEmprego] == 13) { jtext = "Vendedor De Drogas"; }
        else if(PlayerInfo[targetid][pEmprego] == 14) { jtext = "Vendedor De Armas"; }
        else if(PlayerInfo[targetid][pEmprego] == 15) { jtext = "PizzaBoy"; }
        else { jtext = "Nenhum"; }
        new drank[98];
        if(PlayerInfo[targetid][pVIP] == 0 && PlayerInfo[targetid][pSocio] == 0) { drank = "{ffffff}Gratis"; }
        else if(PlayerInfo[targetid][pSocio] == 1) { drank = "{ffff00}Socio Comum"; }
        else if(PlayerInfo[targetid][pSocio] == 2) { drank = "{ffff00}Socio Premium"; }
        else if(PlayerInfo[targetid][pSocio] == 3) { drank = "{ffff00}Socio Diamante"; }
        else if(PlayerInfo[targetid][pVIP] == 1) { drank = "{ffff00}Vip Comum"; }
        else if(PlayerInfo[targetid][pVIP] == 2) { drank = "{ffff00}Vip Premium"; }
        new titulo[100];
        if(strfind(PlayerInfo[playerid][pATitulo],"", true) != -1)
        {
            titulo = "{ffffff}Nenhum";
        }
        else { strmid(titulo, PlayerInfo[playerid][pATitulo],0,strlen(PlayerInfo[playerid][pATitulo]), 30); }
        new skintext[20];
        if(TemSkinPermanente[targetid] == 1) skintext = "Sim";
        else if(TemSkinPermanente[targetid] == 0)skintext = "nao";
        new married[20];
        if(PlayerInfo[targetid][pMarriedTo] == 0) { married = "Ninguem"; }
        else strmid(married, PlayerInfo[targetid][pMarriedTo], 0, strlen(PlayerInfo[targetid][pMarriedTo]), 255);
        new ptime = PlayerInfo[targetid][pConnectTime];
        new crimes = PlayerInfo[targetid][pCrimes];
        new matou = PlayerInfo[targetid][pKills];
        new morreu = PlayerInfo[targetid][pDeaths];
        new Drogas; // maconha
        new Drogas2; // cocaina
        new Drogas3; // crack
        new Drogas4; // lsd
        for(new i=0; i<75; i++) // Inventario
        {
            if(InventarioInfo[playerid][i][iSlot] == 1578)
            {
                Drogas++;
            }
            if(InventarioInfo[playerid][i][iSlot] == 1279)
            {
                Drogas2++;
            }
            if(InventarioInfo[playerid][i][iSlot] == 1575)
            {
                Drogas3++;
            }
            if(InventarioInfo[playerid][i][iSlot] == 1576)
            {
                Drogas4++;
            }
            if(InventarioInfo[playerid][i][iSlot] == 2922)
            {
                textdecod = "Sim";
            }
            if(InventarioInfo[playerid][i][iSlot] == 1650)
            {
                textgalao = "Sim";
            }
            if(InventarioInfo[playerid][i][iSlot] == 3096)
            {
                textkitcarro = "Sim";
            }
            if(InventarioInfo[playerid][i][iSlot] == 3016)
            {
                kitperm = "Sim";
            }
            if(InventarioInfo[playerid][i][iSlot] == 370)
            {
                kitperm = "Sim";
            }
            if(InventarioInfo[playerid][i][iSlot] == 1654)
            {
                textdina = "Sim";
            }
        }
        new SafeDrogas = PlayerInfo[targetid][pSafeDrogas]; // maconha
        new SafeDrogas2 = PlayerInfo[targetid][pSafeDrogas2]; // cocaina
        new SafeDrogas3 = PlayerInfo[targetid][pSafeDrogas3]; // crack
        new SafeDrogas4 = PlayerInfo[targetid][pSafeDrogas4]; // lsd
        new mats = PlayerInfo[targetid][pMats];
        new smats = PlayerInfo[targetid][psMats];
        new level = PlayerInfo[targetid][pLevel];
        new exp = PlayerInfo[targetid][pExp];
        new pnumber = PlayerInfo[targetid][pPnumber];
        new Conta = PlayerInfo[targetid][pConta];
        new nxtlevel = PlayerInfo[targetid][pLevel]+1;
        new Housekey = PlayerInfo[targetid][pPHousekey];
        new bizkey = PlayerInfo[targetid][pPbiskey];
        new fazkey = PlayerInfo[targetid][pPFazkey];
        new expquantidade = nxtlevel*levelexp;
        new Float:health;
        new creditos = PlayerInfo[targetid][pCreditos];
        new diasvip = PlayerInfo[targetid][pDiaVIP];
        new Veiculos;
        if(PlayerInfo[targetid][pCarKey] != 0) Veiculos++;
        if(PlayerInfo[targetid][pCarFixo] != 0) Veiculos++;
        new name[MAX_PLAYER_NAME];
        GetPlayerName(targetid, name, sizeof(name));
        GetPlayerHealth(targetid,health);
        new Float:px,Float:py,Float:pz;
        GetPlayerPos(targetid, px, py, pz);
        new Android[80];
        if(PlayerMobile[targetid] == true) Android = "{df5454}Android{ffffff}.";
        else if(PlayerMobile[targetid] == false) Android = "{228B22}PC{ffffff}.";
        MEGAString[0] = EOS;
        new string[140];
        new xgstring[500];
        // Limpa a string antes de montar o Dialog
        MEGAString[0] = EOS;

        if(targetid == playerid)
        {
            GetPlayerName(playerid, sendername, MAX_PLAYER_NAME);
        }
        else
        {
            GetPlayerName(targetid, sendername, MAX_PLAYER_NAME);
        }
        format(xgstring, sizeof(xgstring), "{00E5FF}Identidade {ffffff}- Virtual {aaacae}Boost{ffffff} RPG");

        // --- CABEÇALHO DO PERSONAGEM ---
        format(string, sizeof(string), "{00E5FF}» DADOS DO CIDADÃO\n");
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Personagem: {00E5FF}%s \t{ffffff}Plataforma: {b0bec5}%s\n", sendername, Android);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Nível: {00E5FF}%d {ffffff}(Respeito: %d/%d) \t{ffffff}Sexo: {b0bec5}%s\n", level, exp, expquantidade, atext);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Casado com: {b0bec5}%s \t\t{ffffff}Horas Jogadas: {b0bec5}%d\n", married, ptime);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Celular: {b0bec5}%d {ffffff}(Créditos: %d) \t{ffffff}Membro Desde: {b0bec5}Indisponível\n\n", pnumber, creditos);
        strcat(MEGAString, string);

        // --- FINANÇAS E CONTA VIP ---
        format(string, sizeof(string), "{00E5FF}» FINANÇAS & CONTA\n");
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Carteira: {4caf50}%s \t\t{ffffff}Banco: {4caf50}%s\n", ConvertMoney(cash), ConvertMoney(Conta));
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Tipo de Conta: {ffd54f}%s{ffffff} \t\t{ffffff}Dias VIP: {ffd54f}%d\n", drank, diasvip);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Moedas VIP: {ffd54f}%s \t\t{ffffff}Caixas RS: {ffd54f}%d\n\n", ConvertMoney(PlayerInfo[targetid][pCoins]), PlayerInfo[playerid][pCaixaRS]);
        strcat(MEGAString, string);

        // --- PROFISSÃO E FICHA CRIMINAL ---
        format(string, sizeof(string), "{00E5FF}» PROFISSÃO & FICHA\n");
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Organização: {b0bec5}%s {ffffff}(Cargo: %d) \t{ffffff}Emprego: {b0bec5}%s\n", NomeORG(targetid), PlayerInfo[targetid][pCargo], jtext);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Procurado: {ef5350}%d {ffffff}| Crimes: {ef5350}%d \t{ffffff}Pontos CNH: {b0bec5}%d/20\n", WantedLevel[targetid], crimes, PlayerInfo[targetid][pPontos]);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Matou: {b0bec5}%d {ffffff}| Morreu: {b0bec5}%d \t\t{ffffff}Doença: {b0bec5}%s\n", matou, morreu, dtext);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Avisos: {ef5350}%d {ffffff}| Troca Nick: {b0bec5}%d \t\t{ffffff}Título: {b0bec5}%s{ffffff}\n\n", PlayerInfo[targetid][pAvisos], MudarNick[playerid], titulo);
        strcat(MEGAString, string);

        // --- PATRIMÔNIO ---
        format(string, sizeof(string), "{00E5FF}» PATRIMÔNIO\n");
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Casa: {b0bec5}%d {ffffff}| Empresa: {b0bec5}%d {ffffff}| Fazenda: {b0bec5}%d\n", Housekey, bizkey, fazkey);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Veículos: {b0bec5}0%d/02 {ffffff}| Aluguel ID: {b0bec5}%d \t{ffffff}Título Pers.: {b0bec5}%s\n\n", Veiculos, HireCar[targetid], xtextt);
        strcat(MEGAString, string);

        // --- MOCHILA, COFRE E PERMANENTES ---
        format(string, sizeof(string), "{00E5FF}» INVENTÁRIO & PERMANENTES\n");
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Bolso: {b0bec5}Maconha(%d) Cocaína(%d) Crack(%d) LSD(%d) Mats(%d)\n", Drogas, Drogas2, Drogas3, Drogas4, mats);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Cofre: {b0bec5}Maconha(%d) Cocaína(%d) Crack(%d) LSD(%d) Mats(%d)\n", SafeDrogas, SafeDrogas2, SafeDrogas3, SafeDrogas4, smats);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Itens: {b0bec5}Dinamites[%s] Decod.[%s] Galão[%s] Reparo[%s]\n", textdina, textdecod, textgalao, textkitcarro);
        strcat(MEGAString, string);
        format(string, sizeof(string), "{ffffff}Permanentes: {00e5ff}Jetpack[%s] Equip.[%s] Skin[%s]\n", jetperm, kitperm, skintext);
        strcat(MEGAString, string);

        ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX, xgstring, MEGAString, "Fechar", "");
    }
}


START::SetPlayerToTeamColor(playerid)
{
    if(AdminTrabalhando[playerid] == 1 && admhide[playerid] != 1)
    {
        SetPlayerColor(playerid, COR_ADMIN);
    }
    else if (PlayerInfo[playerid][pTeam] == 3)//Civis
    {
       SetPlayerColor(playerid, COR_BRANCO);
    }
    else if (PlayerInfo[playerid][pMembro] == 4 || PlayerInfo[playerid][pLider] == 4)//SA:MU
    {
       SetPlayerColor(playerid, COR_SAMU);
    }
    else if (PlayerInfo[playerid][pMembro] == 5 || PlayerInfo[playerid][pLider] == 5)//Aztecas
    {
       SetPlayerColor(playerid, COR_AZTECAS);
    }
    else if (PlayerInfo[playerid][pMembro] == 6 || PlayerInfo[playerid][pLider] == 6)//Taliban
    {
       SetPlayerColor(playerid, COR_TAL);
    }
    else if (PlayerInfo[playerid][pMembro] == 7 || PlayerInfo[playerid][pLider] == 7)//Governo
    {
       SetPlayerColor(playerid, COR_GOV);
    }
    else if (PlayerInfo[playerid][pMembro] == 8 || PlayerInfo[playerid][pLider] == 8)//Hitmans
    {
       SetPlayerColor(playerid, COR_HITMAN);
    }
    else if (PlayerInfo[playerid][pMembro] == 9 || PlayerInfo[playerid][pLider] == 9)//Rede Globo
    {
       SetPlayerColor(playerid, COR_REP);
    }
    else if (PlayerInfo[playerid][pMembro] == 10 || PlayerInfo[playerid][pLider] == 10)//Taxistas
    {
       SetPlayerColor(playerid, COR_TAXI);
    }
    else if (PlayerInfo[playerid][pMembro] == 22 || PlayerInfo[playerid][pLider] == 22)//Mafia Cosa Nostra
    {
       SetPlayerColor(playerid, COR_COSA);
    }
    else if (PlayerInfo[playerid][pMembro] == 20 || PlayerInfo[playerid][pLider] == 20)//Mafia Yakuza
    {
       SetPlayerColor(playerid, COR_YAK);
    }
    else if (PlayerInfo[playerid][pMembro] == 15 || PlayerInfo[playerid][pLider] == 15)//Groove
    {
       SetPlayerColor(playerid, COR_GRO);
    }
    else if (PlayerInfo[playerid][pMembro] == 16 || PlayerInfo[playerid][pLider] == 16)//AL'QAEDA
    {
       SetPlayerColor(playerid, COR_AL);
    }
    else if (PlayerInfo[playerid][pMembro] == 18 || PlayerInfo[playerid][pLider] == 18)//BALLAS
    {
       SetPlayerColor(playerid, COR_BALLAS);
    }
    else if (PlayerInfo[playerid][pMembro] == 19 || PlayerInfo[playerid][pLider] == 19)//vagos
    {
       SetPlayerColor(playerid, COR_VAGOS);
    }
    else if (PlayerInfo[playerid][pMembro] == 23 || PlayerInfo[playerid][pLider] == 23)//CV
    {
       SetPlayerColor(playerid, COR_CV);
    }
    else if (PlayerInfo[playerid][pMembro] == 11 || PlayerInfo[playerid][pLider] == 11)//PCC
    {
       SetPlayerColor(playerid, COR_PCC);
    }
    else if (PlayerInfo[playerid][pMembro] == 21 || PlayerInfo[playerid][pLider] == 21)//Sons of Anarchy
    {
       SetPlayerColor(playerid, COR_SONS);
    }
    else if (PlayerInfo[playerid][pMembro] == 24 || PlayerInfo[playerid][pLider] == 24)//Mayans
    {
       SetPlayerColor(playerid, COR_MAYANS);
    }
    else if (PlayerInfo[playerid][pMembro] == 14 || PlayerInfo[playerid][pLider] == 14)//DETRAN
    {
       SetPlayerColor(playerid, COR_MECANICO);
    }
    else if (PlayerInfo[playerid][pMembro] == 26 || PlayerInfo[playerid][pLider] == 26)//Triads
    {
       SetPlayerColor(playerid, COR_Triads);
    }
    else if(OnDuty[playerid] == 1)//POLICIAS
    {
       if(PlayerInfo[playerid][pLider] == 1) { SetPlayerColor(playerid, COR_PM); }
       if(PlayerInfo[playerid][pLider] == 2) { SetPlayerColor(playerid, COR_BOPE); }
       if(PlayerInfo[playerid][pLider] == 3) { SetPlayerColor(playerid, COR_EXE); }
       if(PlayerInfo[playerid][pLider] == 12) { SetPlayerColor(playerid, COR_ROTA); }
       if(PlayerInfo[playerid][pLider] == 13) { SetPlayerColor(playerid, COR_GATE); }
       if(PlayerInfo[playerid][pLider] == 17) { SetPlayerColor(playerid, COR_PC); }
       if(PlayerInfo[playerid][pLider] == 25) { SetPlayerColor(playerid, COR_PF); }
       //Membros
       if(PlayerInfo[playerid][pMembro] == 1) { SetPlayerColor(playerid, COR_PM); }
       if(PlayerInfo[playerid][pMembro] == 2) { SetPlayerColor(playerid, COR_BOPE); }
       if(PlayerInfo[playerid][pMembro] == 3) { SetPlayerColor(playerid, COR_EXE); }
       if(PlayerInfo[playerid][pMembro] == 12) { SetPlayerColor(playerid, COR_ROTA); }
       if(PlayerInfo[playerid][pMembro] == 13) { SetPlayerColor(playerid, COR_GATE); }
       if(PlayerInfo[playerid][pMembro] == 17) { SetPlayerColor(playerid, COR_PC); }
       if(PlayerInfo[playerid][pMembro] == 25) { SetPlayerColor(playerid, COR_PF); }

    }
    else if(OnDuty[playerid] == 0)//POLICIAS
    {
       SetPlayerColor(playerid, COR_BRANCO);

    }
    else //caso de algum bug
    {
       SetPlayerColor(playerid, COR_BRANCO);
    }
}
START::GameModeInitExitFunc()
{
    foreach(new i: Player)
    {
        if(IsPlayerConnected(i))
        {
            DisablePlayerCheckpoint(i);
            gPlayerCheckpointStatus[i] = CKPOINT_NENHUM;
            GameTextForPlayer(i, "GMX...", 4000, 5);
            SetPlayerCameraPos(i,1460.0, -1324.0, 287.2);
            SetPlayerCameraLookAt(i,1374.5, -1291.1, 239.0);
            gPlayerLogged[i] = 0;
        }
    }
    KillTimer(faztime);
    KillTimer(GuerraTime);
    KillTimer(cartimer);
    KillTimer(tempokit);
    KillTimer(TempoDisputa);
    SetTimer("GameModeExitFunc", 4000, 0);
    return 1;
}
START::GameModeExitFunc()
{
    for(new i; i < MAX_TEXT_DRAWS; ++i)
    {
        TextDrawDestroy(Text:i);
        DestroyProgressBar(Bar:i);
    }
    for(new objectid; objectid < MAX_OBJECTS; objectid++)
    {
        DestroyDynamicObject(objectid);
    }
    KillTimer(TempoEmboscada);
    KillTimer(TimeQuarentena3);
    KillTimer(GuerraTime);
    KillTimer(TempoAnGang);
    KillTimer(TempoDormir);
    KillTimer(TempoCmdEsc);
    KillTimer(TempoAnuncioReporter);
    KillTimer(tempocmdemprego);
    KillTimer(TempoRecarga);
    KillTimer(TempoGetarrace);
    KillTimer(TempoAnPrefeito);
    KillTimer(cartimer);
    KillTimer(TempoAn);
    KillTimer(TempoCorrida);
    KillTimer(TempoSequestrar);
    KillTimer(TempoServicoTaxi);
    KillTimer(TempoServicoOnibus);
    KillTimer(TempoServicoPolicia);
    KillTimer(TempoServicoMedico);
    KillTimer(TempoServicoMecanico);
    KillTimer(tempokit);
    KillTimer(TempoMecanico);
    KillTimer(TempoMedico);
    KillTimer(TempoCorridaOni);
    KillTimer(TempoAnGov);
    KillTimer(TempoAnReporter);
    KillTimer(TempoSincronizar);
    KillTimer(Tempohbomba);
    KillTimer(Tempocbomba);
    SalvarPlantacao();
    GameModeExit();
}
START::LoadStuff()
{
    new arrCoords[19][64];
    new strFromFile2[128];
    new File: file = fopen("Configs/Stuff.ini", io_read);
    if (file)
    {
        fread(file, strFromFile2);
        split(strFromFile2, arrCoords, ',');
        Jackpot = strval(arrCoords[0]);
        Tax = strval(arrCoords[1]);
        TaxValue = strval(arrCoords[2]);
        /*HV = strval(arrCoords[3]);
        CH = strval(arrCoords[4]);
        CM = strval(arrCoords[5]);
        CS = strval(arrCoords[6]);*/
        PLE = strval(arrCoords[7]);
        PLO = strval(arrCoords[8]);
        PLPG = strval(arrCoords[9]);
        PMA = strval(arrCoords[10]);
        PTC = strval(arrCoords[11]);
        PLV = strval(arrCoords[12]);
        PMC = strval(arrCoords[13]);
        PMH = strval(arrCoords[14]);
        PME = strval(arrCoords[15]);
        PRE = strval(arrCoords[16]);
        PCE = strval(arrCoords[17]);
        PDU = strval(arrCoords[18]);
        fclose(file);
    }
    return 1;
}
START::SaveStuff()
{
    new coordsstring[128];
    format(coordsstring, sizeof(coordsstring), "%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
    Jackpot,
    Tax,
    TaxValue,
/*  HV,
    CH,
    CM,
    CS,*/
    PLE,
    PLO,
    PLPG,
    PMA,
    PTC,
    PLV,
    PMC,
    PMH,
    PME,
    PRE,
    PCE,
    PDU);
    new File: file2 = fopen("Configs/Stuff.ini", io_write);
    fwrite(file2, coordsstring);
    fclose(file2);
    return 1;
}

START::AtualizarRank()
{
    foreach(new i: Player)
    {
        if(gPlayerLogged[i])
        {
            new Drogas, Drogas2, Drogas3, Drogas4;
            for(new inv=0; inv<75; inv++) // Inventario
            {
                if(InventarioInfo[i][inv][iSlot] == 1578)
                {
                    Drogas++;
                }
                if(InventarioInfo[i][inv][iSlot] == 1279)
                {
                    Drogas2++;
                }
                if(InventarioInfo[i][inv][iSlot] == 1575)
                {
                    Drogas3++;
                }
                if(InventarioInfo[i][inv][iSlot] == 1576)
                {
                    Drogas4++;
                }
            }
            checkrank("nivel",              PlayerName(i), PlayerInfo[i][pLevel]);
            checkrank("horasjogadas",       PlayerName(i), PlayerInfo[i][pConnectTime]);
            checkrank("kills",              PlayerName(i), PlayerInfo[i][pKills]);
            checkrank("mortes",             PlayerName(i), PlayerInfo[i][pDeaths]);
            checkrank("banco",              PlayerName(i), PlayerInfo[i][pConta]+GetPlayerMoney(i)+(PlayerInfo[i][pCoins]*10000000));
            checkrank("crimes",             PlayerName(i), PlayerInfo[i][pCrimes]);
            checkrank("materiais",          PlayerName(i), PlayerInfo[i][pMats]+PlayerInfo[i][psMats]);
            checkrank("maconha",            PlayerName(i), Drogas+PlayerInfo[i][pSafeDrogas]);
            checkrank("cocaina",            PlayerName(i), Drogas2+PlayerInfo[i][pSafeDrogas2]);
            checkrank("crack",              PlayerName(i), Drogas3+PlayerInfo[i][pSafeDrogas3]);
            checkrank("lsd",                PlayerName(i), Drogas4+PlayerInfo[i][pSafeDrogas4]);
            checkrank("maisativo",          PlayerName(i), TempoOnline[i]);
            checkrank("contratos",          PlayerName(i), PlayerInfo[i][pCacador]);
        }
    }

    SendClientMessageToAll(COR_START2, "[TOP LISTA]: As informacoes do rank(Top Player) esta sendo atualizada..");
    SendClientMessageToAll(COR_START, "{df5454}[Ranking] {ffffff}Rank atualizado, para ver a lista digite: ({00ff00}/rank{ffffff})!");
    return 1;
}
public OnPlayerSuspectedForAimbot(playerid,hitid,weaponid,warnings)
{
    new str[144],nme[MAX_PLAYER_NAME],wname[32],Float:Wstats[BUSTAIM_WSTATS_SHOTS];
    ids[playerid]++;
    GetPlayerName(playerid,nme,sizeof(nme));
    GetWeaponName(weaponid,wname,sizeof(wname));
    if(warnings & WARNING_OUT_OF_RANGE_SHOT)
    {
        format(str,256,"ANTIXITER: |AVISO[%d]| %s(%d) esta com suspeita de AIMBOT, faixa de tiro: %s(faixa normal:%f)",ids[playerid],nme,playerid,wname,BustAim::GetNormalWeaponRange(weaponid));
        ABroadCast(COR_LIGHTRED,str,1);
        AntiXiterLog(str);
        BustAim::GetRangeStats(playerid,Wstats);
        format(str,256,"Atirador para distancia de vitima(SA Units): 1)%f 2)%f 3)%f",Wstats[0],Wstats[1],Wstats[2]);
        ABroadCast(COR_LIGHTBLUE,str,1);
    }
    if(warnings & WARNING_PROAIM_TELEPORT)
    {
        format(str,256,"ANTIXITER: |AVISO[%d]| %s(%d) esta possivelmente usando PRO-AIM (Teleport Detectedo)",ids[playerid],nme,playerid);
        ABroadCast(COR_LIGHTRED,str,1);
        AntiXiterLog(str);
        AntiXiterLog(str);
        BustAim::GetTeleportStats(playerid,Wstats);
        format(str,256,"Bala a distancia de vitima(SA Units): 1)%f 2)%f 3)%f",Wstats[0],Wstats[1],Wstats[2]);
        ABroadCast(COR_LIGHTBLUE,str,1);
    }
    if(warnings & WARNING_RANDOM_AIM)
    {
        format(str,256,"ANTIXITER: |AVISO[%d]| (%d) esta com suspeita de Aimbot(Hit with Random Aim with %s)",ids[playerid],nme,playerid,wname);
        ABroadCast(COR_LIGHTRED,str,1);
        AntiXiterLog(str);
        BustAim::GetRandomAimStats(playerid,Wstats);
        format(str,256,"Random Aim Offsets: 1)%f 2)%f 3)%f",Wstats[0],Wstats[1],Wstats[2]);
        ABroadCast(COR_LIGHTBLUE,str,1);
    }
    if(warnings & WARNING_CONTINOUS_SHOTS)
    {
        format(str,256,"ANTIXITER: |AVISO[%d]| %s(%d) disparou 10 tiros continuamente com a arma: %s(%d)",ids[playerid],nme,playerid,wname,weaponid);
        ABroadCast(COR_LIGHTRED,str,1);
        AntiXiterLog(str);
    }
    return 0;
}
Trash_ResetPlayer(playerid)
{
    if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACHMENT_INDEX)) RemovePlayerAttachedObject(playerid, ATTACHMENT_INDEX);
    if(IsValidDynamicPickup(TrashCP[playerid])) DestroyDynamicPickup(TrashCP[playerid]);
    if(IsValidDynamicPickup(TrashCP2[playerid])) DestroyDynamicPickup(TrashCP2[playerid]);
    HasTrash[playerid] = false;
    new id = ArmazenarID[playerid];
    if(gMlixo[id][TrashLevel] < 1)
    {
        Mlixo[playerid] = 1;
        SendClientMessage(playerid, 0x2ECC71FF, "[Lixeiro]:{ffffff} Va ate o proximo local que foi marcado em seu mapa para coletar mais lixos !");
        SBizzInfo[13][sbTill] += 700;
        ExtortionSBiz(13, 700);
        Mlixo[playerid] = 1;
        new rand;
        rand = random(sizeof(gMlixo));
        TrashCP2[playerid] = CreateDynamicPickup(1264, 24,  gMlixo[rand][TrashX], gMlixo[rand][TrashY], gMlixo[rand][TrashZ]); // Warp the player
        SetPlayerCheckpoint(playerid, gMlixo[rand][TrashX], gMlixo[rand][TrashY], gMlixo[rand][TrashZ], 3);
        FillTrash(rand);
    }
    else
    {
        TogglePlayerDynamicCP(playerid, TrashCP2[playerid], 0);
        TrashCP2[playerid] = CreateDynamicPickup(1264, 24,  gMlixo[id][TrashX], gMlixo[id][TrashY], gMlixo[id][TrashZ]); // Warp the player
        SetPlayerCheckpoint(playerid, gMlixo[id][TrashX], gMlixo[id][TrashY], gMlixo[id][TrashZ], 3);
    }
    return 1;
}


Trash_Closest(playerid)
{
    new closest_id = -1, Float: dist = 3.0, Float: tempdist;
    for(new i; i < sizeof(gMlixo); i++)
    {
        tempdist = GetPlayerDistanceFromPoint(playerid, gMlixo[i][TrashX], gMlixo[i][TrashY], gMlixo[i][TrashZ]);
        if(tempdist > 3.0) continue;
        if(tempdist <= dist)
        {
            dist = tempdist;
            closest_id = i;
        }
    }
    return closest_id;
}
// Player Functions
Player_Init(playerid)
{
    MiningVein[playerid] = -1;
    MiningTimer[playerid] = -1;
    CarryingOre[playerid] = -1;
    for(new i; i < sizeof(DropPoints); i++)
    {
        PointIcons[playerid][i] = -1;
    }
    return 1;
}

Player_CleanUp(playerid, ore = 0)
{
    if(MiningVein[playerid] != -1)
    {
        VeinData[ MiningVein[playerid] ][BeingMined] = false;
        Vein_Update(MiningVein[playerid]);
        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, 1);
        MiningVein[playerid] = -1;
    }
    if(MiningTimer[playerid] != -1)
    {
        KillTimer(MiningTimer[playerid]);
        MiningTimer[playerid] = -1;
    }
    if(ore && CarryingOre[playerid] != -1)
    {
        CarryingOre[playerid] = -1;
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
    }
    if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_INDEX)) RemovePlayerAttachedObject(playerid, ATTACH_INDEX);
    return 1;
}

Player_GetClosestVein(playerid, Float: range = 3.0)
{
    new id = -1, Float: dist = range, Float: tempdist, Float: pos[3];
    for(new i; i < MAX_VEINS; i++)
    {
        if(!VeinData[i][VeinExists]) continue;
        GetDynamicObjectPos(VeinData[i][VeinObject], pos[0], pos[1], pos[2]);
        tempdist = GetPlayerDistanceFromPoint(playerid, pos[0], pos[1], pos[2]);
        if(tempdist > range) continue;
        if(tempdist <= dist)
        {
            dist = tempdist;
            id = i;
        }
    }
    return id;
}

Player_GetClosestOre(playerid, Float: range = 3.0)
{
    new id = -1, Float: dist = range, Float: tempdist, Float: pos[3];
    for(new i; i < MAX_ORES; i++)
    {
        if(!DroppedOres[i][OreExists]) continue;
        GetDynamicObjectPos(DroppedOres[i][OreObject], pos[0], pos[1], pos[2]);
        tempdist = GetPlayerDistanceFromPoint(playerid, pos[0], pos[1], pos[2]);
        if(tempdist > range) continue;
        if(tempdist <= dist)
        {
            dist = tempdist;
            id = i;
        }
    }
    return id;
}

Player_GiveOre(playerid, type, cooldown = 0)
{
    CarryingOre[playerid] = type;
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
    SetPlayerAttachedObject(playerid, ATTACH_INDEX, 2936, 5, 0.105, 0.086, 0.22, -80.3, 3.3, 28.7, 0.35, 0.35, 0.35, RGBAToARGB(OreData[type][Color]));
    SetPVarInt(playerid, "LoadingCooldown", gettime() + cooldown);
    SendClientMessage(playerid, 0x2ECC71FF, "MINEIRADOR: {FFFFFF}Voce pode pressionar N para soltar o minerio.");
    return 1;
}

// Vein Functions
Vein_Update(id)
{
    new label[64], type = VeinData[id][Type], bool: is_red = false;
    if(VeinData[id][BeingMined] || VeinData[id][AmountOres] < 1) is_red = true;
    format(label, sizeof(label), "%s\n%d/%d%s\n\n/infominerio - /minerar", OreData[type][NameOres], VeinData[id][AmountOres], OreData[type][AmountOres], (is_red) ? ("{E74C3C}") : ("{FFFFFF}"));
    UpdateDynamic3DTextLabelText(VeinData[id][VeinLabel], OreData[type][Color], label);
    return 1;
}

Float: Vein_CalculateTime(id)
    return (BAR_MAX / OreData[ VeinData[id][Type] ][Modifier]) * UPDATE_RATE;

// Ore Functions
Ore_VBSTAFFFreeID()
{
    new id = -1;
    for(new i; i < MAX_ORES; i++)
    {
        if(!DroppedOres[i][OreExists])
        {
            id = i;
            break;
        }
    }

    return id;
}


