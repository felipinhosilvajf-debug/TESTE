    CMD:criarroubo(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] == 1342)
        {
            new Float: x, Float: y, Float: z, Float: a;
            GetPlayerPos(playerid, x, y, z);
            GetPlayerFacingAngle(playerid, a);
            x += (1.25 * floatsin(-a, degrees));
            y += (1.25 * floatcos(-a, degrees));
            CreateDynamicObject(19618, x, y, z-0.55, 0.0, 0.0, a, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
            printf("%f, %f, %f, 0.0, 0.0, %f, %d, %d",x, y, z-0.55,a, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
            a += 90.0;
            x += (0.42 * floatsin(-a, degrees)) + (-0.22 * floatsin(-(a - 90.0), degrees));
            y += (0.42 * floatcos(-a, degrees)) + (-0.22 * floatcos(-(a - 90.0), degrees));
            CreateDynamicObject(19619, x, y, z-0.55, 0.0, 0.0, a + 270.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
            printf("%f, %f, %f, 0.0, 0.0, %f, %d, %d",x, y, z-0.55,a + 270.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
        }
        return 1;
    }
    CMD:criargaragem(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] == 1342)
        {
            for(new g=0; g<MAX_GARAGENS; g++)
            {
                new Float:x, Float:y, Float:z;
                GetPlayerPos(playerid, x, y, z);
                EditandoGaragem[playerid] = g;
                if(!GarageToPoint(7.0, EditandoGaragem[playerid], x, y, z))
                {
                    ShowPlayerDialog(playerid, 4002, DIALOG_STYLE_MSGBOX, "Criar Garagem","Clique em 'Meu Nome' para Voce ser o Dono ou em 'Editar' para mudar o Dono", "Meu Nome", "Editar");
                    CriarGaragem("", g, x, y, z, "", true);
                    break;
                }
            }
        }
        return true;
    }
    CMD:deletargaragem(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] == 1342)
        {
            for(new g=0; g<MAX_GARAGENS; g++)
            {
                if(PlayerToPointG(3.0, playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]))
                {
                    if(Deletado[g] == false)
                    {
                        DeletarGaragem(g);
                    }
                }
            }
        }
        return true;
    }
    CMD:fechargaragem(playerid, params[])
    {
        new string[256];
        new playername[MAX_PLAYER_NAME];
        for(new g=0; g<MAX_GARAGENS; g++)
        {
            if(PlayerToPointG(3.0, playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]) || PlayerToPointG(3.0, playerid, COORDENADASGARAGEM) && g == GetPlayerVirtualWorld(playerid)-10)
            {
                GetPlayerName(playerid,playername,24);
                if(!strcmp(NameString[g],playername,true) || PlayerInfo[playerid][pAdmin] == 1342)
                {
                    if(Deletado[g] == false)
                    {
                        if(Garagem[g][cnLock] == 0)
                        {
                            SetTimerEx("FecharGaragem", 5000, false, "ii", playerid, g);
                            Garagem[g][cnLock] = 3;
                            SendClientMessage(playerid, 0x00AB00AA, "O Portao esta {F6F600}Fechando{00AB00}.");
                            format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Entrada\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", g, LabelString[g], GetLockGaragem(g), NameString[g]);
                            UpdateDynamic3DTextLabelText(LabelEntrada[g], 0xFFFFFFFF, string);
                            format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Saida\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", g, LabelString[g], GetLockGaragem(g), NameString[g]);
                            UpdateDynamic3DTextLabelText(LabelSaida[g], 0xFFFFFFFF, string);
                            break;
                        }
                        else
                        {
                            format(string, sizeof(string), "O Portao ja esta %s{AD0000}.", GetLockGaragem(g));
                            SendClientMessage(playerid, 0xAD0000AA, string);
                        }
                    }
                }
                else
                {
                    SendClientMessage(playerid, 0xAD0000AA, "Voce nao e Dono desta Garagem.");
                }
            }
        }
        return true;
    }
    CMD:abrirgaragem(playerid, params[])
    {
        new string[256];
        new playername[MAX_PLAYER_NAME];
        for(new g=0; g<MAX_GARAGENS; g++)
        {
            if(PlayerToPointG(3.0, playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]) || PlayerToPointG(3.0, playerid, COORDENADASGARAGEM) && g == GetPlayerVirtualWorld(playerid)-10)
            {
                GetPlayerName(playerid,playername,24);
                if(!strcmp(NameString[g],playername,true) || PlayerInfo[playerid][pAdmin] == 1342)
                {
                    if(Deletado[g] == false)
                    {
                        if(Garagem[g][cnLock] == 1)
                        {
                            SetTimerEx("AbrirGaragem", 5000, false, "ii", playerid, g);
                            Garagem[g][cnLock] = 2;
                            SendClientMessage(playerid, 0x00AB00AA, "O Portao esta {F6F600}Abrindo{00AB00}.");
                            format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Entrada\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s%s", g, LabelString[g], GetLockGaragem(g), NameString[g]);
                            UpdateDynamic3DTextLabelText(LabelEntrada[g], 0xFFFFFFFF, string);
                            format(string, sizeof(string), "{00FF00}GARAGEM ID: {FFFFFF}%d\n{00FF00}%s\n{00FF00}Saida\n{00FF00}Status: {FFFFFF}%s\n{00FF00}Dono: {FFFFFF}%s", g, LabelString[g], GetLockGaragem(g), NameString[g]);
                            UpdateDynamic3DTextLabelText(LabelSaida[g], 0xFFFFFFFF, string);
                            break;
                        }
                        else
                        {
                            format(string, sizeof(string), "O Portao ja esta %s{AD0000}.", GetLockGaragem(g));
                            SendClientMessage(playerid, 0xAD0000AA, string);
                        }
                    }
                }
                else
                {
                    SendClientMessage(playerid, 0xAD0000AA, "Voce nao e Dono desta Garagem.");
                }
            }
        }
        return true;
    }
    CMD:entrargaragem(playerid, params[])
    {
        new string[64];
        for(new g=0; g<MAX_GARAGENS; g++)
        {
            if(PlayerToPointG(3.0, playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]))
            {
                if(Garagem[g][cnLock] == 0)
                {
                    if(Deletado[g] == false)
                    {
                        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                        {
                            SetPlayerPos(playerid, COORDENADASGARAGEM);
                            SetPlayerVirtualWorld(playerid, g+10);
                            SetPlayerInterior(playerid, 2);
                            format(string, sizeof(string), "Bem Vindo a Garagem %d.", g);
                            SendClientMessage(playerid, 0x00AB00AA, string);
                        }
                        else
                        {
                            if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                            {
                                if(Garagem[g][cnCar] <= MAX_CARS)
                                {
                                    foreach(new i: Player)
                                    {
                                        new tmpcar = GetPlayerVehicleID(playerid);
                                        if(IsPlayerInVehicle(i, tmpcar))
                                        {
                                            SetPlayerVirtualWorld(i, g+10);
                                            SetPlayerInterior(playerid, 2);
                                            Garagem[g][cnCar] ++;
                                            SetVehicleVirtualWorld(tmpcar, g+10);
                                            LinkVehicleToInterior(tmpcar, 2);
                                            SetVehiclePos(tmpcar, COORDENADASGARAGEM);
                                            //SetVehicleVirtualWorld(tmpcar, GetPlayerVirtualWorld(playerid));
                                            format(string, sizeof(string), "Bem Vindo a Garagem %d.", g);
                                            SendClientMessage(i, 0x00AB00AA, string);
                                        }
                                    }
                                }
                                else
                                {
                                    SendClientMessage(playerid, 0xAD0000AA, "ja tem o maximo de Veiculos aceitos dentro desta Garagem.");
                                }
                            }
                            else
                            {
                                SendClientMessage(playerid, 0xAD0000AA, "Apenas Motoristas podem Entrar e Sair da Garagem.");
                            }
                        }
                    }
                }
                else
                {
                    format(string, sizeof(string), "O Portao esta %s{AD0000}.", GetLockGaragem(g));
                    SendClientMessage(playerid, 0xAD0000AA, string);
                    break;
                }
            }
        }
        return true;
    }
    CMD:sairgaragem(playerid, params[])
    {
        new string[128];
        for(new g=0; g<MAX_GARAGENS; g++)
        {
            if(g == GetPlayerVirtualWorld(playerid)-10)
            {
                if(PlayerToPointG(3.0, playerid, COORDENADASGARAGEM))
                {
                    if(Garagem[g][cnLock] == 0)
                    {
                        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
                        {
                            SetPlayerPos(playerid, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]);
                            SetPlayerVirtualWorld(playerid, 0);
                            SetPlayerInterior(playerid, 0);
                            format(string, sizeof(string), "Volte Sempre a Garagem %d.", g);
                            SendClientMessage(playerid, 0x00AB00AA, string);
                        }
                        else
                        {
                            if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
                            {
                                foreach(new i: Player)
                                {
                                    new tmpcar = GetPlayerVehicleID(playerid);
                                    if(IsPlayerInVehicle(i, tmpcar))
                                    {
                                        SetPlayerVirtualWorld(i, 0);
                                        SetPlayerInterior(playerid, 0);
                                        Garagem[g][cnCar] --;
                                        SetVehicleVirtualWorld(tmpcar, 0);
                                        LinkVehicleToInterior(tmpcar, 0);
                                        SetVehiclePos(tmpcar, Garagem[g][cnX], Garagem[g][cnY], Garagem[g][cnZ]);
                                        format(string, sizeof(string), "Volte Sempre a Garagem %d.", g);
                                        SendClientMessage(i, 0x00AB00AA, string);
                                    }
                                }
                            }
                            else
                            {
                                SendClientMessage(playerid, 0xAD0000AA, "Apenas Motoristas podem Entrar e Sair da Garagem.");
                            }
                        }
                    }
                    else
                    {
                        format(string, sizeof(string), "O Portao esta %s{AD0000}.", GetLockGaragem(g));
                        SendClientMessage(playerid, 0xAD0000AA, string);
                        break;
                    }
                }
            }
        }
        return true;
    }
