                    if(GetPlayerOrg(i) == 8 && GetPlayerOrg(i) != GetPlayerOrg(playerid))
                    {
                        if(ProxDetectorS(30.0, playerid, i))
                        {
                            SendClientMessage(playerid, COR_LIGHTRED, "*[Assassinos] Voce nao pode usar este comando proximo a uma org rival !");
                            return 1;
                        }
                    }
                }
            }
            if(WantedLevel[playerid] != 0)
            {
                foreach(new i: Player)
                {
                    if(IsACop(i) && !IsACop(playerid))
                    {
                        if(ProxDetectorS(30.0, playerid, i))
                        {
                            SendClientMessage(playerid, COR_LIGHTRED, "* Voce nao pode equipar procurado enquanto estiver perto de um cop!");
                            return 1;
                        }
                    }
                }
            }
            new drank[20];
            if(PlayerInfo[playerid][pSocio] == 1) { drank = "Socio Comum"; }
            else if(PlayerInfo[playerid][pSocio] == 2) { drank = "Socio Premium"; }
            else if(PlayerInfo[playerid][pSocio] == 3) { drank = "Socio Diamante"; }
            SendClientMessage(playerid,COR_GREEN,"Voce usou o seu kit socio para alternar o kit, use /kit!");
            SendClientMessage(playerid,COR_LIGHTRED,"Lembre-se,Voce nao pode estar em batalha! ou levara carandiru!");
            if(PlayerInfo[playerid][pSocio] > 0 && PlayerInfo[playerid][pSocio] < 3)
            {
                format(stringZCMD, sizeof(stringZCMD), "[%s]: %s Pegou Seu KitSocio.", drank, PlayerName(playerid));
                ProxDetector(30.0, playerid, stringZCMD, 0x33aa33ff,0x33aa33ff,0x33aa33ff,0x33aa33ff,0x33aa33ff);
            }
            else if(PlayerInfo[playerid][pSocio] == 3)
