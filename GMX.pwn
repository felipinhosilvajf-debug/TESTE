public OnPlayerSelectedMenuRow(playerid, row)
{
    new Menu:current;
    current = GetPlayerMenu(playerid);
    if(current == Camera)
    {
        switch(row)
        {
            case 0: // Penitenciaria LS
            {
                ResetPlayerWeaponsEx(playerid);
                interiorcamera[playerid] = GetPlayerInterior(playerid);
                Monitorando[playerid] = 1;
                SetPlayerInterior(playerid, 0);
                InteriorAtual[playerid] = 0;
                TogglePlayerControllable(playerid, 1);
                GetPlayerPos(playerid, camerax,cameray,cameraz);
                TogglePlayerSpectating(playerid, 1);
                InterpolateCameraLookAt(playerid, 1435.922363, -1497.712768, 24.590126, 1435.922363, -1497.712768, 24.590126, 10000, CAMERA_MOVE);
                InterpolateCameraPos(playerid, 1433.845993, -1497.534282, 24.590126, 1433.922289, -1497.534282, 24.590126, 10000, CAMERA_MOVE);

            }
            case 1: // Prefeitura
            {
                ResetPlayerWeaponsEx(playerid);
                interiorcamera[playerid] = GetPlayerInterior(playerid);
                Monitorando[playerid] = 1;
                TogglePlayerControllable(playerid, 1);
                SetPlayerInterior(playerid, 0);
                InteriorAtual[playerid] = 0;//-2.+76370,  0.+178486 0.0, -2.+74,  0.178486,  0.0
                GetPlayerPos(playerid, camerax,cameray,cameraz);
                TogglePlayerSpectating(playerid, 1);
                InterpolateCameraLookAt(playerid, 1470.887329, -1728.804077, 38.505455, 1470.887329, -1728.804077, 38.505455, 1000, CAMERA_MOVE);
                InterpolateCameraPos(playerid, 1468.929077, -1728.579853, 38.505455, 1468.929151, -1728.625591, 38.505455, 1000, CAMERA_MOVE);
            }
            case 2: // Mercado 24-7
            {
                ResetPlayerWeaponsEx(playerid);
                interiorcamera[playerid] = GetPlayerInterior(playerid);
                Monitorando[playerid] = 1;
                TogglePlayerControllable(playerid, 1);
                SetPlayerInterior(playerid, 0);
                InteriorAtual[playerid] = 0;
                GetPlayerPos(playerid, camerax,cameray,cameraz);
                TogglePlayerSpectating(playerid, 1);
                InterpolateCameraPos(playerid, 1351.027221, -1722.500000, 38.934612, 1351.027221, -1722.500000, 38.934612, 1000, CAMERA_MOVE);
                InterpolateCameraLookAt(playerid, 1350.881469, -1726.924194, 36.609794, 1350.881469, -1726.924194, 36.609794, 1000, CAMERA_MOVE);
            }
            case 3: // Spawn Civil
            {
                ResetPlayerWeaponsEx(playerid);
                interiorcamera[playerid] = GetPlayerInterior(playerid);
                Monitorando[playerid] = 1;
                TogglePlayerControllable(playerid, 1);
                SetPlayerInterior(playerid, 0);
                InteriorAtual[playerid] = 0;
