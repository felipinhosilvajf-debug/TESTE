    CMD:setarint(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao tem autorizacao para usar esse comando.");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new para1;
            new intid;
            if(sscanf(params, "ud", para1, intid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /setarint [playerid] [intid]");
                return 1;
            }
            if(IsPlayerConnected(para1))
            {
                if(para1 != INVALID_PLAYER_ID)
                {
                    format(stringZCMD, sizeof(stringZCMD), "* Voce colocou o(a) %s no interior [%d].", PlayerName(para1), intid);
                    SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "Admin %s setou o interior [%d] em Voce.",PlayerName(playerid), intid);
                    SendClientMessage(para1, COR_LIGHTRED, stringZCMD);
                    SetPlayerInterior(playerid,intid);
                    InteriorAtual[playerid] = intid;
                }
            }
        }
        return 1;
    }
    CMD:meavalie(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem permissao para usar esse comando!");
                return 1;
            }
            new para1;
            if(sscanf(params, "u", para1))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /meavalie [playerid/Parte-do-Nick]");
                return 1;
            }
            if(ChatAtendimento[playerid] == 0)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao pode mandar avaliacao sem estar em um atendimento");
                return 1;
            }
            if(para1 == playerid)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao pode se avaliar");
                return 1;
            }
            if(PlayerInfo[para1][pAdmin] > 0 && PlayerInfo[para1][pAdmin] < 1343)
            {
                SendClientMessage(playerid, COR_GRAD2, "Administradores nao podem se avaliar!");
                return 1;
            }
            if(IDAvaliou[playerid] == para1)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce ja avaliou este player aguarde terminar o seu atendimento.");
                return 1;
            }
            if(para1 != INVALID_PLAYER_ID)
            {
                IDAvaliou[playerid] = para1;
                SendClientMessage(playerid, COR_GRAD2, "ATENcao ADM! nao abuse desse comando, ou Voce sera punido severamente!");
                PedirAvaliar[para1] = playerid;
                format(stringZCMD, sizeof stringZCMD, "Voce pediu para o player %s lhe avaliar, aguarde respostas.",PlayerName(para1));
                SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                ShowPlayerDialog(para1, 9282, DIALOG_STYLE_LIST, "Avaliar","Nota 1\nNota 2\nNota 3\nNota 4\nNota 5\nNota 6\nNota 7\nNota 8\nNota 9\nNota 10","Avaliar", "Cancelar");
            }
        }
        return 1;
    }
    CMD:desconvidar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new para1;
            if(sscanf(params, "u", para1))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /desconvidar [playerid/Parte-do-Nick]");
                return 1;
            }
            if (PlayerInfo[playerid][pLider] >= 1 || PlayerInfo[playerid][pCargo] == 5)
            {
                if(IsPlayerConnected(para1))
                {
                    if(PlayerInfo[para1][pMembro] != 0 || PlayerInfo[para1][pLider] != 0)
                    {
                        SendClientMessage(playerid, COR_GREY, "Este player ja participa de Org/Gang/Mafia.");
                        return 1;
                    }
                    if(convidado[para1] == 0)
                    {
                        SendClientMessage(playerid, COR_AMARELO, "Voce nao convidou este jogador para a sua organizacao!");
                        return 1;
                    }
                    if(para1 != INVALID_PLAYER_ID)
                    {
                        GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce foi desconvidado da organizacao: %s", NomeORG(playerid));
                        SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* Voce desconvidou %s para sua organizacao.", giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        convidado[para1] = 0;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Somente lideres podem usar este comando !");
            }
        }
        return 1;
    }
    //-----------------------------------{ IP }-----------------------------------------------------
    CMD:ip(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] >= 4)
            {
                if(sscanf(params, "u", sscanfid))
                {
                    SendClientMessage(playerid, COR_AMARELO, "{df5454}Ã—{ffffff} USE: /ip [ID]");
                    SendClientMessage(playerid, COR_AMARELO, "Comando Para Ver o Ip Do Jogador.");
                    return 1;
                }
                if(PlayerInfo[sscanfid][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] != 1342)
                {
                    SendClientMessage(playerid, COR_GRAD1, "Voce nao pode ver o ip de um Admin Dono !");
                    return 1;
                }
                GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        new ip[128];
                        GetPlayerIp(sscanfid,ip,128);
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        format(gstring, sizeof(gstring), "Jogador: %s | IP: %s", giveplayerZCMD,ip);
                        SendClientMessage(playerid,COR_LIGHTBLUE, gstring);
                    }
                }
                else
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
                    return 1;
                }
            }
            else
            {
                SendClientMessage(playerid, COR_VERMELHO, "Voce nao tem permissao para usar esse comando.");
                return 1;
            }
        }
        return 1;
    }
    CMD:ultimologin(playerid, params[])
    {
        if (IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1337)
            {
                return  1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new Nome[64];
            if(sscanf(params, "s[64]", Nome))
            {
                SendClientMessage(playerid,COR_GRAD1,"{df5454}Ã—{ffffff} USE: /ultimologin [Nome do Jogador]");
                return 1;
            }
            format(stringZCMD, sizeof(stringZCMD), "[VBR LOGIN]:{FFFFFF} O ultimo login de %s, foi em %s.", Nome, getUltimoLogin(Nome));
            SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
        }
        return true;
    }
    CMD:desbanip(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1)
        {
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            if(sscanf(params, "s[24]", params))
            {
                SendClientMessage(playerid,COR_GRAD1,"{df5454}Ã—{ffffff} USE: /desbanip [Ip do Jogador]");
                return 1;
            }
            new gstring2[264];
            format(gstring, 128, Pasta_IPBanidos, params);
            format(gstring2, 128, Pasta_IPBanidosTemp, params);
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(DOF2_FileExists(gstring))
            {
                //desban rcon(samp.ban).
                format(stringZCMD, 30, "unbanip %s", params);
                SendRconCommand(stringZCMD);
                SendRconCommand("reloadbans");
                //
                fremove(gstring);
                format(stringZCMD, sizeof(stringZCMD), "AdmCmd: O admin %s desbaniu o IP %s", sendername,params);
                ABroadCast(COR_AMARELO,stringZCMD,1);
                Desbanlog(stringZCMD);
                return 1;
            }
            else if(DOF2_FileExists(gstring2))
            {
                //desban rcon(samp.ban).
                format(stringZCMD, 30, "unbanip %s", params);
                SendRconCommand(stringZCMD);
                SendRconCommand("reloadbans");
                //
                fremove(gstring2);
                format(stringZCMD, sizeof(stringZCMD), "AdmCmd: O admin %s desbaniu o IP (temporariamente banido) %s", sendername,params);
                ABroadCast(COR_AMARELO,stringZCMD,1);
                Desbanlog(stringZCMD);
                return 1;
            }
            else
            {
                //desban rcon(samp.ban).
                format(stringZCMD, 30, "unbanip %s", params);
                SendRconCommand(stringZCMD);
                SendRconCommand("reloadbans");
                //
                format(stringZCMD, sizeof(stringZCMD), "IP:[%d] nao encontrado no banco de dados, ou acabou de ser desban pelo rcon!", params);
                SendClientMessage(playerid, COR_GRAD1, stringZCMD);
                return 1;
            }
        }
        return 1;
    }
    CMD:desbanconta(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 4)
        {
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            if(isnull(params))
            {
                SendClientMessage(playerid,COR_GRAD1,"{df5454}Ã—{ffffff} USE: /desbanir [Nick do Jogador]");
                return 1;
            }
            new arquivo[64];
            format(arquivo, sizeof(arquivo), Pasta_Banidos, params);
            new arquivo2[64];
            format(arquivo2, sizeof(arquivo2), Pasta_BanidosTemp,params);
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(DOF2_FileExists(arquivo))
            {
                format(stringZCMD, sizeof(stringZCMD), "AdminAviso: O admin %s desbaniu %s.", sendername,params);
                ABroadCast(COR_AMARELO,stringZCMD,1);
                DOF2_RemoveFile(arquivo);
                Desbanlog(stringZCMD);
            }
            else if(DOF2_FileExists(arquivo2))
            {
                format(stringZCMD, sizeof(stringZCMD), "AdmCmd: %s desbaniu (temporariamente banido) %s.", sendername,params);
                ABroadCast(COR_AMARELO,stringZCMD,1);
                DOF2_RemoveFile(arquivo2);
                Desbanlog(stringZCMD);
            }
            else
            {
                format(stringZCMD, sizeof(stringZCMD), "Nick:[%s] nao encontrado no banco de dados !", params);
                SendClientMessage(playerid, COR_GRAD1, stringZCMD);
                return 1;
            }
        }
        return 1;
    }

	CMD:darlider(playerid, params[])
	{
		if(!IsPlayerConnected(playerid))
			return 1;

		if(PlayerInfo[playerid][pAdmin] < 1339)
		{
			SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando!");
			return 1;
		}

		if(AdminTrabalhando[playerid] < 1 &&
			PlayerInfo[playerid][pAdmin] != 1340 &&
			PlayerInfo[playerid][pAdmin] != 1341 &&
			PlayerInfo[playerid][pAdmin] != 1342)
		{
			SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
			return 1;
		}

		new id, level;

		if(sscanf(params, "dd", id, level))
		{
			SendClientMessage(playerid, COR_GRAD2, "{df5454}×{ffffff} USE: /darlider [id] [org]");
			return 1;
		}

		if(!IsPlayerConnected(id))
		{
			SendClientMessage(playerid, COR_GREY, "Jogador nao encontrado ou desconectado!");
			return 1;
		}

		if(level < 1 || level > 26)
		{
			SendClientMessage(playerid, COR_GREY, "Lideres de 1 a 26.");
			return 1;
		}

		// Verifica se o jogador ja participa de alguma organizacao
		if(PlayerInfo[id][pLider] != 0 || PlayerInfo[id][pMembro] != 0)
		{
			SendClientMessage(playerid, COR_GRAD1, "Esse player ja participa de uma organizacao!");
			return 1;
		}

		// Guarda a skin atual do jogador promovido
		skincop[id] = GetPlayerSkin(id);

		// Define a skin de acordo com a organizacao
		if(level == 1) PlayerInfo[id][pSkin] = 265;       // Policia Militar
		else if(level == 2) PlayerInfo[id][pSkin] = 285;  // BOPE
		else if(level == 3) PlayerInfo[id][pSkin] = 73;   // Exercito
		else if(level == 4) PlayerInfo[id][pSkin] = 70;   // SA:MU
		else if(level == 5) PlayerInfo[id][pSkin] = 115;  // Los Aztecas
		else if(level == 6) PlayerInfo[id][pSkin] = 249;  // Taliban
		else if(level == 7) PlayerInfo[id][pSkin] = 147;  // Prefeito
		else if(level == 8) PlayerInfo[id][pSkin] = 294;  // Hitmans
		else if(level == 9) PlayerInfo[id][pSkin] = 227;  // Rede Globo
		else if(level == 10) PlayerInfo[id][pSkin] = 61;  // Taxistas
		else if(level == 11) PlayerInfo[id][pSkin] = 143; // PCC
		else if(level == 12) PlayerInfo[id][pSkin] = 17;  // Rota
		else if(level == 13) PlayerInfo[id][pSkin] = 285; // GATE
		else if(level == 14) PlayerInfo[id][pSkin] = 50;  // DETRAN
		else if(level == 15) PlayerInfo[id][pSkin] = 270; // Groove
		else if(level == 16) PlayerInfo[id][pSkin] = 123; // AlQaeda
		else if(level == 17) PlayerInfo[id][pSkin] = 186; // Policia Civil
		else if(level == 18) PlayerInfo[id][pSkin] = 104; // Ballas
		else if(level == 19) PlayerInfo[id][pSkin] = 108; // Vagos
		else if(level == 20) PlayerInfo[id][pSkin] = 120; // Mafia Yakuza
		else if(level == 21) PlayerInfo[id][pSkin] = 100; // Sons of Anarchy
		else if(level == 22) PlayerInfo[id][pSkin] = 113; // Mafia Cosa Nostra
		else if(level == 23) PlayerInfo[id][pSkin] = 19;  // CV
		else if(level == 24) PlayerInfo[id][pSkin] = 261; // Mayans
		else if(level == 25) PlayerInfo[id][pSkin] = 295; // Policia Federal
		else if(level == 26) PlayerInfo[id][pSkin] = 294; // Triads

		// Promove o jogador
		PlayerInfo[id][pLider] = level;
		PlayerInfo[id][pCargo] = 6;

		// Registra o lider na organizacao
		InfoOrg[level][Lider] = PlayerName(id);
		SaveORGS();

		MedicBill[id] = 0;
		gTeam[id] = 11;
		PlayerInfo[id][pTeam] = 11;

		liderhide[id] = 1;
		lideradmin[id] = 1;

		SetPlayerSkin(id, PlayerInfo[id][pSkin]);
		SetPlayerSpawn(id);

		SendClientMessage(playerid, COR_LIGHTBLUE, "Voce promoveu o jogador para lider com sucesso!");
		SendClientMessage(id, COR_LIGHTBLUE, "Voce foi promovido com sucesso para lider!");

		return 1;
	}

    CMD:plider(playerid, params[])return ForT:pegarlider(playerid, params);
    CMD:pegarlider(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1339)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando !");
