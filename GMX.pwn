        NoTuto[playerid] = 1;
        PlayerTextDrawSetString(playerid,TituloTuto[playerid], "Loja de Roupas");
        PlayerTextDrawShow(playerid, TituloTuto[playerid]);
        TextDrawShowForPlayer(playerid, BTTUTO[0]);
        TextDrawSetString(BTTUTO[0], "Terminar ~>~");
        TextDrawShowForPlayer(playerid, BTTUTO[1]);
        TextDrawShowForPlayer(playerid, BaseTuto[0]);
        SelectTextDraw(playerid, 0x00FF00FF);
        strcat(MEGAString, "    ~w~Por fim, temos tambem as lojas de Roupas para voce mudar o visual.~n~");
        strcat(MEGAString, "  ~w~Lembre-se que as Empresas da cidade podem ser compradas por jogadores~n~");
        strcat(MEGAString, "   ~w~e temos diversos sistemas exclusivos para voce explorar. Em caso de~n~");
        strcat(MEGAString, "    ~w~duvidas, acompanhe sempre todos os comandos usando o ~y~/ajuda~w~.~n~");
        strcat(MEGAString, "              ~g~Desejamos a voce uma otima diversao e um bom RolePlay!~n~");
        BalaoTuto(playerid, MEGAString);
        //if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
        //if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid,"http://brasilperfectlife.com");
        tempotutorial[playerid] = SetTimerEx("TempoTut", 3000, 1, "i", playerid);
        ClearChatbox(playerid, 100);
    }
    return true;
}
