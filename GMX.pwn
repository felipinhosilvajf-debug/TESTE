    if(dialogid == 1743)
    {
        if(!response)
        {
            new arquivo[64];
            new ystring[20];
            format(arquivo, sizeof(arquivo), Pasta_CAcessorio,PlayerName(playerid));
            format(ystring, sizeof(ystring), "modelid%d", ArmazenarSlot[playerid]);
            new IDObjeto = DOF2_GetInt(arquivo, ystring);
            for(new i=0; i<75; i++)
            {
                if(InventarioInfo[playerid][i][iSlot] == 19382)
                {
                    InventarioInfo[playerid][i][iSlot] = IDObjeto;
                    InventarioInfo[playerid][i][iUnidades] = 1;
                    break;
                }
            }
            RemovePlayerAttachedObject(playerid, ArmazenarSlot[playerid]);
            format(string, sizeof(string), "Voce guardou um(a) {df5454}%s{FFFFFF} em seu inventario.", NomeDoAcessorio(IDObjeto));
            SendClientMessage(playerid, -1, string);
            DOF2_SetInt(arquivo, ystring, 0);
        }
        if(response)
        {
            if(PlayerMobile[playerid] == true)
            {
                SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}No momento pessoas que jogam no Android nao pode editar acessorios!");
                //SendClientMessage(playerid, -1, "{fa4c4c}OBS: {ffffff}O scripter do Sv ja sabe do Problema, e ja estamos desenvolvento um editor de Acc mobile.");
            }
            if(PlayerMobile[playerid] == false)
            {
                EditAttachedObject(playerid, ArmazenarSlot[playerid]);
            }
        }
    }
