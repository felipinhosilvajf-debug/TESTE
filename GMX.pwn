START::DeletarTunamento(vehicleid)
{
    new FormatoTunamento[256];
    format(FormatoTunamento,sizeof(FormatoTunamento),Pasta_CarrosTunados,vehicleid);
    if(DOF2_FileExists(FormatoTunamento))
    {
        DOF2_RemoveFile(FormatoTunamento);
    }
    else
    {
        DOF2_RemoveFile(FormatoTunamento);
    }
    return 0;
}
stock GetPishBoss(orgid)
{

    if(orgid == 0)return 0;

    new quant=0;
    for(new tr; tr != MAX_PISH; tr++)
    {
        if(Pichado[tr][orgid] == 1)
        {
            quant++;
        }
    }
    return quant;

}
//Guerra Morro
stock gSendMessage(color, message[]){

    for(new gOrgs; gOrgs < MAX_ORGS; gOrgs++)
    {
        if(OrgMorro(gOrgs)){

            SendFamilyMessage(gOrgs, color, message);
        }
    }

    return 1;
}
gIniciarGuerraMorro(){
    SendClientMessageToAll(COR_GREY, "{818689}| ----------------------------- | {df5454}GUERRA NO MORRO {818689}| ----------------------------- |");
    SendClientMessageToAll(COR_GREY, ">         {df5454}ATENCAO: A Guerra no Morro iniciou!");
    SendClientMessageToAll(COR_GREY, ">         {818689}Boa sorte para todas as organizacoes participantes!");
    SendClientMessageToAll(COR_GREY, ">         {ffffff}OBS: Para informacoes sobre a guerra digite: {818689}/infoguerra{ffffff}!");
    SendClientMessageToAll(COR_GREY, "----------------------------------------------------------------------------------------");
    //SendClientMessageToAll(-1, "{FFFF00}[GUERRA MORRO]:{FFFFFF} A guerra no morro comecou, boa sorte as Orgs Participantes");
    SoundToAll(1133);
    for(new gOrgs; gOrgs < MAX_ORGS; gOrgs++){
        if(OrgMorro(gOrgs)){
            SendFamilyMessage(gOrgs, COR_AMARELO2, "ATENcao: Sua organizacao e uma das concorrentes da guerra no morro, reuna os membros e maos a obra!");
        }
    }
    GuerraMorro[gGuerra]    = true;
    GuerraMorro[gPontosDono]= 0;
    GuerraMorro[gTempo]     = 60 * 30;
    GuerraMorro[gDono]      = 0;
    GuerraMorro[gDinheiro]  = 0;
    GuerraMorro[gMortes]    = 0;
    GuerraMorro[gCash]      = 0;
    GuerraMorro[gColor]     = 0xAAAAAAAA;
    gCriarTextdraws();
    GuerraMorro[gTimer] = SetTimer("UpdateMorro", 1000, 1);
    for(new gOrgs; gOrgs < MAX_ORGS; gOrgs++){
        MorroPontos[gOrgs] = 0;
    }

}
gFlashGZ(){
        GangZoneShowForAll(GZMorro, 0x000000AA);
        GangZoneFlashForAll(GZMorro, GuerraMorro[gColor]);
}
gStopFlash(){
        GangZoneStopFlashForAll(GZMorro);
        GangZoneShowForAll(GZMorro, GuerraMorro[gColor]);
}

gCriarTextdraws(){

    gTextdraw1 = TextDrawCreate(3.000000, 151.000000, "_");
    TextDrawBackgroundColor(gTextdraw1, 80);
    TextDrawFont(gTextdraw1, 1);
    TextDrawLetterSize(gTextdraw1, 0.189999, 0.899999);
    TextDrawColor(gTextdraw1, -1);
    TextDrawSetOutline(gTextdraw1, 1);
    TextDrawSetProportional(gTextdraw1, 1);
    TextDrawSetSelectable(gTextdraw1, 0);

    gTextdraw2 = TextDrawCreate(3.000000, 134.000000, "~b~Pontos~h~~h~ Guerra");
    TextDrawBackgroundColor(gTextdraw2, 255);
    TextDrawFont(gTextdraw2, 0);
    TextDrawLetterSize(gTextdraw2, 0.359999, 1.499999);
    TextDrawColor(gTextdraw2, 16777215);
    TextDrawSetOutline(gTextdraw2, 1);
    TextDrawSetProportional(gTextdraw2, 1);
    TextDrawSetSelectable(gTextdraw2, 0);
}
gDestruirTextdraws(){

    TextDrawDestroy(gTextdraw1);
    TextDrawDestroy(gTextdraw2);
}
gTerminarGuerraMorro(){

    KillTimer(GuerraMorro[gTimer]);

    gDestruirTextdraws();
    gStopFlash();
    GuerraMorro[gGuerra] = false;

    new gStr[128];
    //SendClientMessageToAll(-1, "Â»-----------------------------{FFFF00}[GUERRA NO MORRO]{FFFFFF}-----------------------------Â«");

    switch(GuerraMorro[gDono]){

        case 0:
        {
            SendClientMessageToAll(COR_START, "{df5454}[Guerra Morro]: {ffffff}Nenhuma organizacao venceu a guerra no morro, boa tentativa!");

            format(gStr, sizeof(gStr), "{df5454}[Guerra Morro]: {ffffff}Numero total de mortes na guerra: {df5454}%d MORTES{FFFFFF}.", GuerraMorro[gMortes]);
            SendClientMessageToAll(COR_START, gStr);

            //SendClientMessageToAll(-1, "Mais sorte da proxima vez!!");
        }
        default:
        {

            SendClientMessageToAll(-1, "-----------------------------{df5454}[Guerra no Morro]{FFFFFF}-----------------------------");

            format(gStr, sizeof(gStr), "{df5454}[Guerra no Morro]:{FFFFFF} A Organizacao: {FFFF00}%s {FFFFFF}saiu como vencedora da guerra no morro!!", (GuerraMorro[gDono]));
            SendClientMessageToAll(COR_START, gStr);

            format(gStr, sizeof(gStr), "{df5454}[Guerra no Morro]:{FFFFFF} A Organizacao foi resposavel por {df5454}%d{ffffff} das {df5454}%d{FFFFFF} mortes da guerra!", MorroPontos[GuerraMorro[gDono]], GuerraMorro[gMortes]);
            SendClientMessageToAll(COR_START, gStr);

            format(gStr, sizeof(gStr), "[Guerra no Morro]:{FFFFFF} Cada player da organizacao ganhou {df5454}R$%s{FFFFFF} por terem vencido a guerra", ConvertMoney(GuerraMorro[gDinheiro]));
            SendClientMessageToAll(COR_START, gStr);

            foreach(new i: Player){

                if(GuerraMorro[gDono] == 1) {
                    if(GetPlayerOrg(i) == 1 || GetPlayerOrg(i) == 2 || GetPlayerOrg(i) == 17)
                    {
                        GivePlayerMoneyEx(i, GuerraMorro[gDinheiro]);
                    }
                }
                else {
                    if(GetPlayerOrg(i) == GuerraMorro[gDono])
                    {
                        GivePlayerMoneyEx(i, GuerraMorro[gDinheiro]);
                    }
                }
            }

        }
    }

    //SendClientMessageToAll(-1, "Â»-----------------------------{FFFF00}[GUERRA NO MORRO]{FFFFFF}-----------------------------Â«");
    SoundToAll(1133);
}
gCheckPontos(playerid, killerid){

    if((PlayerInfo[killerid][pAdmin]&&AdminTrabalhando[killerid]))return 1;
    if(!gPlayerInGuerra(killerid) && !gPlayerInGuerra(playerid))return 0;
    new oplayer = GetPlayerOrg(playerid);
    new okiller = GetPlayerOrg(killerid);
    if(okiller == 1 || okiller == 2 || okiller == 16) okiller = 1;
    if(oplayer == 1 || oplayer == 2 || oplayer == 13) oplayer = 1;
    new gStr[128];
    if(OrgMorro(oplayer) && OrgMorro(okiller) && oplayer != okiller){

        GuerraMorro[gMortes]        ++;
        GuerraMorro[gDinheiro]      += 3000+random(3524);

        MorroPontos[okiller] ++;

        format(gStr, 128, "**[Guerra Morro]: %s matou %s[%s] e pontuou para a organizacao [%s].", PlayerName(killerid), PlayerName(playerid), GetOrgName(oplayer), (okiller));
        gSendMessage(GetPlayerColor(killerid), gStr);

        if(MorroPontos[okiller] > GuerraMorro[gPontosDono]){


            if(GuerraMorro[gDono] != okiller){

                format(gStr, 128, "{df5454}[Guerra Morro]: {FFFFFF}A ORG %s acaba de assumir a lideranca com %d mortes.", (okiller), MorroPontos[okiller]);
                SendClientMessageToAll(COR_START, gStr);
                if(okiller == 1) {
                   // SendFamilyMessage(1, COR_LIGHTBLUE, "***Voces agora estao na lideranca da guerra no morro, nao deixem que a tomem de Voces***");
                   // SendFamilyMessage(2, COR_LIGHTBLUE, "***Voces agora estao na lideranca da guerra no morro, nao deixem que a tomem de Voces***");
                   // SendFamilyMessage(16, COR_LIGHTBLUE, "***Voces agora estao na lideranca da guerra no morro, nao deixem que a tomem de Voces***");
                }
                else{

                }
                    //SendFamilyMessage(okiller, COR_LIGHTBLUE, "***Voces agora estao na lideranca da guerra no morro, nao deixem que a tomem de Voces***");
            }

            GuerraMorro[gPontosDono] = MorroPontos[okiller];
            GuerraMorro[gDono]       = okiller;
            GuerraMorro[gColor]      = GetPlayerColor(killerid)+75;
        }
    }
    return 1;
}

START::UpdateMorro(){

    if(GuerraMorro[gTempo])
        GuerraMorro[gTempo]--;

    GuerraMorro[gDinheiro] += 50+random(10);

    gFlashGZ();
    new gStr[500], gPontos[100];

    foreach(new gPlayer: Player)
    {
        if(gPlayerInGuerra(gPlayer)){

            TextDrawShowForPlayer(gPlayer, gTextdraw1);
            TextDrawShowForPlayer(gPlayer, gTextdraw2);
        }
        else{

            TextDrawHideForPlayer(gPlayer, gTextdraw1);
            TextDrawHideForPlayer(gPlayer, gTextdraw2);
        }
    }

    gStr[0]=EOS;
    format(gStr,sizeof gStr, "Dinheiro: ~g~R$%d~n~~w~Tempo: ~p~%03d", GuerraMorro[gDinheiro], GuerraMorro[gTempo]);
    for(new gOrgs; gOrgs < MAX_ORGS; gOrgs++)
    {
        if(OrgMorro(gOrgs))
        {
            if(GuerraMorro[gDono] == gOrgs){

                format(gPontos,sizeof gPontos, "~n~~g~~h~[L]~y~%s~w~ pts: %02d", GetOrgName(gOrgs), MorroPontos[gOrgs]);
            }else{

                format(gPontos,sizeof gPontos, "~n~~y~%s~w~ pts: %02d", GetOrgName(gOrgs), MorroPontos[gOrgs]);
            }

            strcat(gStr, gPontos);
        }
    }
    TextDrawSetString(gTextdraw1, gStr);

    if(GuerraMorro[gTempo] < 1){

        gTerminarGuerraMorro();
    }
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
        NovaCamera[playerid] = 0;
        new arquivo[64];
        new carvip[64];
        new carfixo[64];
        new Float:Pos[3];
        format(arquivo, sizeof(arquivo), Pasta_CarrosFixados, vehicleid);
        if(DOF2_FileExists(arquivo))
        {
             RemovePlayerFromVehicleEx(playerid);
             SendClientMessage(playerid, 0xffc801FF, "Voce nao pode entrar em um veiculo que esteja fixado na hq mecanicos !");
             return 1;
        }
        format(carvip, sizeof(carvip), Pasta_CarrosVIP, vehicleid);
        if(DOF2_FileExists(carvip))
        {
             CarregarCarrosTunados(vehicleid);
             CarrosTunadosBHC(vehicleid);
        }
        format(carfixo, sizeof(carfixo), Pasta_CarrosFixo, vehicleid);
        if(DOF2_FileExists(carfixo))
        {
             CarregarCarrosTunados(vehicleid);
             CarrosTunadosBHC(vehicleid);
        }
        if(PlayerInfo[playerid][pJailed] != 0)
        {
             RemovePlayerFromVehicleEx(playerid);
             SendClientMessage(playerid, COR_BALLAS, "Voce esta preso,nao pode entrar em veiculos!");
             return 1;
        }
        if(PlayerInfo[playerid][pEmprego] == 9 && ispassenger)
        {
            SetVehicleParamsForPlayer(vehicleid,playerid, 0,0);
            foreach(new i: Player)
            {
                if(i == playerid) continue;
                SetVehicleParamsForPlayer(GetPlayerVehicleID(playerid),i,0,1);
            }
            //new Bern [100]
            //format(Bern , sizeof(Bern ), "Carro id %i foi destrancado !",vehicleid);
            //SendClientMessage(playerid, -1, Bern );
            return 1;
        }
        if(AztecasCarro(vehicleid) && !ispassenger)
        {
             if(GetPlayerOrg(playerid) != 5)
             {
                 SendClientMessage(playerid, COR_BALLAS, "Voce nao e um Azteca !");
                 GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
