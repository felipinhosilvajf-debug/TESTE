    CMD:logar(playerid, params[])
    {
        if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
        {
            new tmppass;
            //new loginstring[255];
            if(gPlayerLogged[playerid] == 1)
            {
                SendClientMessage(playerid, COR_DBLUE, "[VBR]: Voce ja esta logado.");
                //SetPlayerPos(playerid, 1153.4733,-1771.0773,16.5992);
                return 1;
            }
            if(sscanf(params, "d", tmppass))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /logar [Senha]");
                SendClientMessage(playerid, COR_START, "{df5454}ALERTA: {ffffff}Use somente numeros.");
                format(stringZCMD,sizeof(stringZCMD),"{ffffff}Bem Vindo ao {ffffff}{ffffff}Virtual {aaacae}Boost{ffffff} {ffffff}RPG!\n\nSua conta: {df5454}%s{ffffff}.\n{ffffff}Status: {818689}Registrada{ffffff}.\n\n{818689}Insira a Senha Abaixo para logar:",PlayerName(playerid));
                ShowPlayerDialog(playerid, 1, DIALOG_STYLE_PASSWORD," ",stringZCMD,"Logar","Ajuda");
                //format(loginstring,sizeof(loginstring),"{00F200}Voce e Registrado!\n\n{FFFFFF}Ola {07C3F7}%s,\n {FFFFFF}Voce ja e membro cadastrado do nosso servidor.\n\n{FFFFFF}Digite sua senha correta para logar!\n\nVisite nosso site: {00F200}{df5454}https://discord.gg/9QP6UnS6xd", PlayerName(playerid));
                //ShowPlayerDialog(playerid, 1, DIALOG_STYLE_PASSWORD,"Login Necessario",loginstring,"Logar","Ajuda");
                return 1;
            }
            if(plogando[playerid] == 3)
            {
                 plogando[playerid] = 0;
                 Kick(playerid);
            }
            plogando[playerid] += 1;
            SetPlayerPos(playerid, 1153.4733,-1771.0773,16.5992);
            //Encrypt(tmppass);
            OnPlayerLogin(playerid,tmppass);
            //PlayerInfo[playerid][pSenha2] = tmppass;
        }
        return 1;
    }
    CMD:tirarbugs(playerid)
