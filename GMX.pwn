    CMD:extorcaofaz(playerid, params[])
    {
            new forse = PlayerInfo[playerid][pPFazkey];
            if (forse == 255)
            {
                SendClientMessage(playerid, COR_GRAD2, "  Voce nao tem uma Fazenda!");
                return true;
            }
            new giveplayerid;
            if(sscanf(params, "d", giveplayerid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /extorcaofaz [ID do Player] (ou 555 para Ninguem)");
                return true;
            }
            new string[128];
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(giveplayerid == 555)
            {
                if (forse < 255)
                {
                    format(string, sizeof(string), "Ninguem");
                    strmid(FBizzInfo[forse][fbExtortion], string, 0, sizeof(string), 255);
                    format(string, sizeof(string), "Novo dono da Extorsao: %s",FBizzInfo[forse][fbExtortion]);
                    SalvarFEmpresa(forse);
                }
                Atualizar3Dtexts();
                SendClientMessage(playerid, COR_BRANCO, string);
                return 1;
            }
            if(IsPlayerConnected(giveplayerid))
            {
                if(giveplayerid != INVALID_PLAYER_ID)
                {
                    format(string, sizeof(string), "* %s esta na extorsao de sua fazenda.",PlayerName(giveplayerid));
                    SendClientMessage(playerid, COR_LIGHTBLUE, string);
                    format(string, sizeof(string), "* Agora Voce esta na Extorsao da fazenda de %s.",PlayerName(playerid));
                    SendClientMessage(giveplayerid, COR_LIGHTBLUE, string);
                    if (forse < 255)
                    {
                        format(string, sizeof(string), "%s",PlayerName(giveplayerid));
                        strmid(FBizzInfo[forse][fbExtortion], string, 0, sizeof(string), 255);
                        format(string, sizeof(string), "Novo dono da Extorsao: %s",FBizzInfo[forse][fbExtortion]);
                        SalvarFEmpresa(forse);
                    }
                    Atualizar3Dtexts();
                    SendClientMessage(playerid, COR_BRANCO, string);
                }
            }
            else
            {
                SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
                return true;
            }
            return true;
    }
    CMD:sacarfazenda(playerid, params[])
    {
            new borse = PlayerInfo[playerid][pPFazkey];
            if (borse == 255)
            {
                SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}Voce nao tem nenhuma empresa!");
                return true;
            }
            new quant;
            new string[128];
            if(sscanf(params, "d", quant))
            {
                if (borse < 255)
                {
                    format(string, sizeof(string), "  Voce tem R$%d no cofre da fazenda.", FBizzInfo[borse][fbTill]);
                    SendClientMessage(playerid, COR_GRAD3, string);
                }
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /sacarfazenda [quantidade]");
                return true;
            }
            new cashdeposit = quant;
            if (borse < 255)
            {
                if(cashdeposit > FBizzInfo[borse][fbTill] || cashdeposit < 1)
                {
                    SendClientMessage(playerid, COR_GRAD2, "   Voce nao tem essa quantia em sua Fazenda.");
                    return true;
                }
            }
            if (borse < 255)
            {
                if(!PlayerToPoint(100, playerid,FBizzInfo[borse][fbEntranceX],FBizzInfo[borse][fbEntranceY],FBizzInfo[borse][fbEntranceZ]))
                {
                    SendClientMessage(playerid, COR_GRAD2, "  Sua Fazenda esta longe de Voce.");
                    return true;
                }
                else
                {
                    GivePlayerMoneyEx(playerid,cashdeposit);
                    FBizzInfo[borse][fbTill] -= cashdeposit;
                    format(string, sizeof(string), "  Voce retirou R$%d de sua fazenda - restante: R$%d ", cashdeposit,FBizzInfo[borse][fbTill]);
                    SendClientMessage(playerid, COR_AMARELO, string);
                    SalvarFEmpresa(borse);
                }
            }
            Atualizar3Dtexts();
            return true;
    }
    CMD:depositarfazenda(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new borse = PlayerInfo[playerid][pPFazkey];
            if (borse == 255)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem uma fazenda.");
                return 1;
            }
            new cashdeposit;
            if(sscanf(params, "d", cashdeposit))
            {
                format(stringZCMD, sizeof(stringZCMD), "Voce tem R$%d de saldo em sua fazenda.", FBizzInfo[borse][fbTill]);
                SendClientMessage(playerid, COR_GRAD3, stringZCMD);
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /depositarfazenda [quantidade]");
                return 1;
            }
            if (cashdeposit > GetPlayerMoneyEx(playerid) || cashdeposit < 1)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem tanto");
                return 1;
            }
            if(!PlayerToPoint(100, playerid,FBizzInfo[borse][fbEntranceX],FBizzInfo[borse][fbEntranceY],FBizzInfo[borse][fbEntranceZ]))
            {
                SendClientMessage(playerid, COR_GRAD2, "  Sua Fazenda esta longe de Voce.");
                return true;
            }
            else
            {
                GivePlayerMoneyEx(playerid,-cashdeposit);
                FBizzInfo[borse][fbTill] += cashdeposit;
                ExtortionBiz(borse, cashdeposit);
                format(stringZCMD, sizeof(stringZCMD), "Voce depositou $%d no cofre de sua fazenda Total: $%d", cashdeposit,FBizzInfo[borse][fbTill]);
                SendClientMessage(playerid, COR_AMARELO, stringZCMD);
                return 1;
            }
        }
        return 1;
    }
