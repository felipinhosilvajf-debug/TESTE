                                    {
                                        strmid(InfoOrg[GetPlayerOrg(playerid)][Membro36], "Ninguem", 0, strlen("Ninguem"), 255);
                                    }
                                    if(strcmp(InfoOrg[GetPlayerOrg(playerid)][Membro37], PlayerName(playerid), true) == 0)
                                    {
