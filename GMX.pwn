            new UrlSom[256];
            if(DOF2_FileExists(files))
            {
                strmid(UrlSom, DOF2_GetString(files,"UrlSom"), 0, strlen(DOF2_GetString(files,"UrlSom")), 255);
                if(IsPlayerInRangeOfPoint(playerid, DOF2_GetFloat(files, "DistanciaSom"), DOF2_GetFloat(files, "SomX"), DOF2_GetFloat(files, "SomY"), DOF2_GetFloat(files, "SomZ")))
                {
