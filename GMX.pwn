    CMD:arrombar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(gTeam[playerid] == 2  || IsACop(playerid) || GetPlayerOrg(playerid) == 8 || GetPlayerOrg(playerid) == 26)
            {
                for(new i = 0; i < sizeof(HouseInfo); ++i)
                {
                    if (PlayerToPoint(3, playerid,HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
                    {
                        SetPlayerInterior(playerid,HouseInfo[i][hInt]);
                        SetPlayerPos(playerid,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]);
                        SetPlayerVirtualWorld(playerid,HouseInfo[i][hWorld]);
                        GameTextForPlayer(playerid, "~r~Arrombou a Porta", 5000, 1);
                        InteriorAtual[playerid] = HouseInfo[i][hInt];
                        LocalAtual[playerid] = i;
                        HouseEntered[playerid] = i;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um Oficial ou um Hitman !");
                return 1;
            }
        }
        return 1;
    }
    CMD:divorcio(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(!PlayerToPoint(5, playerid,2232.9705,-1333.0361,23.9815) || !PlayerToPoint(5, playerid,2491.1990,918.4307,11.0234))
            {
                SendClientMessage(playerid, COR_GREY, "   Voce nao esta na Igreja !");
                return 1;
            }
            if(PlayerInfo[playerid][pMarried] == 0)
            {
                SendClientMessage(playerid, COR_GREY, "   Voce nao esta casado !");
                return 1;
            }
            if(sscanf(params, "u", sscanfid)) {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /divorcio [id]");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if (ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se pedir em divorcio!"); return 1; }
                        new dstring[MAX_PLAYER_NAME];
                        new wstring[MAX_PLAYER_NAME];
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "%s", giveplayerZCMD);
                        strmid(wstring, stringZCMD, 0, strlen(stringZCMD), 255);
                        format(stringZCMD, sizeof(stringZCMD), "%s", PlayerInfo[playerid][pMarriedTo]);
                        strmid(dstring, stringZCMD, 0, strlen(stringZCMD), 255);
                        if(strcmp(dstring ,wstring, true ) == 0 )
                        {
                            format(stringZCMD, sizeof(stringZCMD), "* Voce enviou papeis de divorcio para %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "* %s pediu papeis de divorcio (Digite /aceitar divorcio) para aceitar.", sendername);
                            SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                            DivorceOffer[sscanfid] = playerid;
                            return 1;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_GREY, "  Esse jogador nao esta casado com Voce !");
                            return 1;
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}O jogador esta muito longe de Voce!");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
                return 1;
            }
        }
        return 1;
    }
    CMD:pediremcasamento(playerid, params[])
    {
        if(PlayerToPoint(5, playerid,2233.8225,-1333.2725,23.9816) || PlayerToPoint(5, playerid,2491.1990,918.4307,11.0234))
        {
            if(GetPlayerMoneyEx(playerid) < 25000)
            {
                SendClientMessage(playerid, COR_GREY, "Para se Casar Custa R$25000 !");
                return 1;
            }
            if(PlayerInfo[playerid][pMarried] > 0)
            {
                SendClientMessage(playerid, COR_GREY, "Voce ja e casado !");
                return 1;
            }
            if(sscanf(params, "u", sscanfid)) {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /pediremcasamento [id]");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(PlayerInfo[sscanfid][pMarried] > 0)
                    {
                        SendClientMessage(playerid, COR_GREY, "Este jogador(a) ja e casado(a) !");
                        return 1;
                    }
                    if (ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode propor a si mesmo!"); return 1; }
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce propos casamento a %s.", giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* %s Voce foi pedida em casamento (Digite /aceitar casamento) para aceitar.", sendername);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        ProposeOffer[sscanfid] = playerid;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}O jogador esta muito longe de Voce!");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
                return 1;
            }
        }
        return 1;
    }
    CMD:padrinho(playerid, params[])
    {
        if(PlayerToPoint(5, playerid,2233.8225,-1333.2725,23.9816) || PlayerToPoint(5, playerid,2491.1990,918.4307,11.0234))
        {
            if(sscanf(params, "u", sscanfid)) {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /padrinho [id]");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if (ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode ser marido e padrinho do casamento!"); return 1; }
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce chamou %s para ser seu padrinho de casamento.", giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* %s chamou Voce para ser Padrinho do Casamento (Digite /aceitar padrinho) para aceitar.", sendername);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        MarryWitnessOffer[sscanfid] = playerid;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}O jogador esta muito longe de Voce!");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
                return 1;
            }
        }
        return 1;
    }
    CMD:setartaxa(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pLider] != 7)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e o Governador !");
                return 1;
            }
            if(sscanf(params, "d", moneysZCMD)) {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /setartaxa [quantidade]");
                return 1;
            }
            if(moneysZCMD < 1 || moneysZCMD > 1000) { SendClientMessage(playerid, COR_GREY, "O Dinheiro da Taxa nao pode ser menor que 1 ou maior que 1000 !"); return 1; }
            Tax = moneysZCMD;
            SaveStuff();
            format(stringZCMD, sizeof(stringZCMD), "* Cada Jogador vai pagar uma taxa de R$[%d], apartir de agora!", Tax);
            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
            format(stringZCMD, sizeof(stringZCMD), "Noticias: O Governador acaba de mudar a Taxa por Pessoa para: R$[%d].", Tax);
            SendClientMessageToAll(COR_LIGHTBLUE, stringZCMD);
        }
        return 1;
    }
    CMD:dartaxa(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pLider] != 7)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e o Governador !");
                return 1;
            }
            if(Tax < 1)
            {
                SendClientMessage(playerid, COR_GREY, "nao ha Dinheiro suficiente no banco de Impostos !");
                return 1;
            }
            new Cops = 0;
            foreach(new i: Player)
            {
                if(IsPlayerConnected(i))
                {
                    if(IsACop(i))
                    {
                        Cops += 1;
                    }
                }
            }
            if(Cops >= 1)
            {
                new price = Tax / Cops;
                if(CofreOrg[7][Dinheiro] < Tax)return SendClientMessage(playerid, COR_GRAD1, "O cofre da prefeitura nao tem esse dinheiro todo!");
                SacarOrgGrana(7,Tax);
                PLV += Tax;
                foreach(new i: Player)
                {
                    if(IsPlayerConnected(i))
                    {
                        if(IsACop(i))
                        {
                            SendClientMessage(playerid, COR_GREY, "Voce deu a taxa para todos os policiais online!");
                            format(stringZCMD, sizeof(stringZCMD), "* Voce recebeu R$[%d] do banco de Impostos pelo Governador.",price);
                            SendClientMessage(i, COR_LIGHTBLUE, stringZCMD);
                            GivePlayerMoneyEx(i, price);
                            Tax = 0;
                        }
                    }
                }
                SaveStuff();
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "nao ha nenhum Policial Online no Momento !");
                return 1;
            }
        }
        return 1;
    }
    CMD:spawnguerra(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(GetPlayerOrg(playerid) == 3 || GetPlayerOrg(playerid) == 6 || GetPlayerOrg(playerid) == 16 || GetPlayerOrg(playerid) == 30)
            {
                if(TendoGuerra == 1)
                {
                    if(SpawnGuerra[playerid] == 1)
                    {
                        SendClientMessage(playerid, COR_GRAD1, "Voce ira nascer em sua barraca durante essa guerra !");
                        SpawnGuerra[playerid] = 0;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GRAD1, "Voce ira nascer em sua hq durante essa guerra !");
                        SpawnGuerra[playerid] = 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD1, "nao esta ocorrendo uma guerra !");
                    return 1;
                }
            }
        }
        return 1;
    }
    CMD:duvida(playerid, result[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(gPlayerLogged[playerid] == 0)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta logado!");
                return 1;
            }
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(isnull(result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /Duvida [Pergunta]");
                return 1;
            }
            if(TentouDivulgar(result))
            {
                GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                ABroadCast(COR_AMARELO,stringZCMD,1);
                DivulgouLog(stringZCMD);
                return 1;
            }
            format(stringZCMD, sizeof(stringZCMD), "Duvida De %s(ID:%d): %s", sendername, playerid, (result));
            ABroadCast(0x33AA33AA,stringZCMD,1);
            SendClientMessage(playerid, 0x228B22FF, "Sua duvida foi enviada aos Admins Presentes. (/n Chat duvida global)");
            DuvidaLog(stringZCMD);
        }
        return 1;
    }
    CMD:retirar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
