stock IntLen(iNum)
    return floatround(floatlog(floatabs(iNum) + 1), floatround_ceil);
stock getUltimoLogin(Nick[])
{
    new lastLogin[50];
    new Query[65];
    //new DBResult:Resultado;
    format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(Nick));
    Resultado = db_query(Conexao,Query);
    if(db_num_rows(Resultado) > 0)
    {
        db_get_field_assoc(Resultado, "LU", lastLogin, sizeof(lastLogin));
    }
    db_free_result(Resultado);
    return lastLogin;
}
