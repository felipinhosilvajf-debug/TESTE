            {
                if(HouseInfo[h][hOwned] == 0)
                {
                    format(stringZCMD, sizeof(stringZCMD), "Casa Livre, ID:[%d], Level Necessario:[%d], Valor:[%d]", h,HouseInfo[h][hLevel],HouseInfo[h][hValue]);
                    SendClientMessage(playerid, Cores[random2], stringZCMD);
                }
            }
        }
        return 1;
    }
    CMD:casalivreprox(playerid, params[])
    {
        new h = PegarCasaProximo(playerid);
        new Float:x, Float:y, Float:z;
        x = HouseInfo[h][hEntrancex];
        y = HouseInfo[h][hEntrancey];
        z = HouseInfo[h][hEntrancez];
        SetPlayerCheckpoint(playerid, x, y, z, 5.0);
        format(stringZCMD, sizeof stringZCMD, "[GPS]: Foi marcado no mapa a casa a venda mais proxima de Voce (%s)", GetPoint2DZone(x, y, z));
        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
        return 1;
    }
