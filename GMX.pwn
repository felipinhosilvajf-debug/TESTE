     {
          SetPlayerPos(playerid, 315.7357,1034.7726,1948.8062);
          SetPlayerFacingAngle(playerid, 0);
          SetCameraBehindPlayer(playerid);
          SetPlayerInterior(playerid, 9);
          SetPlayerVirtualWorld(playerid, 0);
          Incargobob[playerid] = GetPlayerVehicleID(playerid);
          if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid, "http://dl.dropboxusercontent.com/s/1vwj0xmoqdmcqi3/shamal.mp3");
     }
     if(newstate == PLAYER_STATE_PASSENGER && GetPlayerVehicleID(playerid) == CarrosTaliban[11] && GetPlayerOrg(playerid) == 6)
     {
          SetPlayerPos(playerid, 315.7357,1034.7726,1948.8062);
          SetPlayerFacingAngle(playerid, 0);
          SetCameraBehindPlayer(playerid);
          SetPlayerInterior(playerid, 9);
          SetPlayerVirtualWorld(playerid, 1);
