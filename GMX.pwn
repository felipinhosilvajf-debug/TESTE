            }
            ShowPlayerDialog(playerid, 25812, DIALOG_STYLE_INPUT, "Criando Portao",
            "{ffffff}Digite a senha que ira colocar no portao\n\n{df5454}OBS: {818689}A senha deve der no minimo 1 caracter,\ne no maximo 24 caracteres.", "Criar", "");
            DiminuirInv(slot,playerid);
            AtualizarInventario(playerid);
        }
        if(item == 11736){
            if(MedKitSis == true)
            {
                if(MedKitDados[playerid][MedPlayer] == true) return SendClientMessage(playerid, -1, "Voce ja criou um medkit");
                GetPlayerPos(playerid, MedKitDados[playerid][PosPlayerX],MedKitDados[playerid][PosPlayerY], MedKitDados[playerid][PosPlayerZ]);
                MedKitDados[playerid][MedKits] = CreateDynamicPickup(19605,1, MedKitDados[playerid][PosPlayerX], MedKitDados[playerid][PosPlayerY], MedKitDados[playerid][PosPlayerZ]-1.5), MedKitDados[playerid][MedKitObject] = CreateObject(11736, MedKitDados[playerid][PosPlayerX], MedKitDados[playerid][PosPlayerY], MedKitDados[playerid][PosPlayerZ]-1, 0.0, 0.0, 0.0);
                MedKitDados[playerid][VidaMedKit] = 10;
                format(stringZCMD, sizeof(stringZCMD), "[MedKit]: {FFFFFF}%s {33AA33}Jogou um MedKit no chao!", PlayerName(playerid));
                ProxDetector(30.0, playerid, stringZCMD, COR_GREEN,COR_GREEN,COR_GREEN,COR_GREEN,COR_GREEN);
                format(str,35,"MedKit\n de %s", PlayerName(playerid));
                PlayerPlaySound(playerid, 32000, 0.0, 0.0, 0.0), MedKitDados[playerid][MedPlayer] = true;
                MedKitDados[playerid][LabelMed] = Create3DTextLabel(stringZCMD, 0xEDE6E6AA, MedKitDados[playerid][PosPlayerX],MedKitDados[playerid][PosPlayerY],MedKitDados[playerid][PosPlayerZ], 25.0, 0);
                DiminuirInv(slot,playerid);
                AtualizarInventario(playerid);
            }
            else if(MedKitSis == false)
            {
                SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O uso de MedKit esta bloqueado no {df5454}/menusistema{ffffff}!");
            }
            return 1;
        }
        //ACESSoRIOS
        if(ObjetoAcessorio(item)){
            AcessorioSelecionado[playerid] = item;
            ShowPlayerDialog(playerid, 25481, DIALOG_STYLE_LIST, "Local Do Corpo","Espinha\nCabeca\nBraco esquerdo\nBraco direito\nMao esquerda\nMao direita\nCoxa esquerda\nCoxa direita\nPe esquerdo\nPe direito\nPanturrilha esquerda\nPanturrilha direita\nAntebraco esquerdo\nAntebraco direito\nClavicula esquerda\nClavicula direita\nPescoco\nMendibula","Selecionar", "Cancelar");
            DiminuirInv(slot,playerid);
            itemacessorio[playerid] = item;
            AtualizarInventario(playerid);
            FecharInventario(playerid);
        }
        if(item > -1 && item < 312 ){

            new skin = GetPlayerSkin(playerid);
            SetPlayerSkin(playerid, item);
            for(new i = 0; i < 75; i++)
            {
                if(InventarioInfo[playerid][i][iSlot] == 19382)
                {
                    format(str, 100, "* Voce colocou a skin %d", item);
                    SendClientMessage(playerid, 0x00ccccFF, str);
                    format(str, 100, "* %s Trocou de roupa.", PlayerName(playerid));
                    PlayerInfo[playerid][pSkin] = item;
                    ProxDetector(30.0, playerid, str, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    if(InventarioInfo[playerid][slot][iUnidades] > 1)
                        return InventarioInfo[playerid][slot][iUnidades] --;
                    if(InventarioInfo[playerid][slot][iUnidades] == 1){

                        InventarioInfo[playerid][slot][iUnidades] = 0;
                        InventarioInfo[playerid][slot][iSlot] = 19382;
                    }

                    InventarioInfo[playerid][slot][iSlot] = skin;
                    InventarioInfo[playerid][slot][iUnidades] = 1;

                    AtualizarInventario(playerid);
                    BoxAberto[playerid] = 0;
                    return 1;
                }
            }
            SendClientMessage(playerid, 0xFF6347AA, "* Seu inventario esta cheio!");
            return 1;
        }
    }
    if(playertextid == invText[playerid][12]){

        if(InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot] == 19382){

            //SendClientMessage(playerid, 0xFF6347AA, "* nao ha itens suficientes para ser movido!");
            GameTextForPlayer(playerid, "~r~Selecione um Item", 5000, 1);
            for(new i = 7; i < 16; i++){

            PlayerTextDrawHide(playerid, invText[playerid][i]);
            }
            BoxAberto[playerid] = 0;
            return 1;
        }
        //SelectTextDraw(playerid, 0xCD0400FF);
        MovendoInv[playerid] = 1;
        CombinandoInv[playerid] = 0;
        BoxAberto[playerid] = 0;
        for(new i = 7; i < 16; i++){

            PlayerTextDrawHide(playerid, invText[playerid][i]);
        }
    }
    if(playertextid == invText[playerid][14]){

        new str[180];

        if(InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot] == 19382){
            GameTextForPlayer(playerid, "~r~Selecione um Item", 5000, 1);
            //SendClientMessage(playerid, 0xFF6347AA, "* nao ha itens suficientes para ser descartado!");

            for(new i = 7; i < 16; i++){

            PlayerTextDrawHide(playerid, invText[playerid][i]);
            }
            BoxAberto[playerid] = 0;
            return 1;
        }
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        CreateDroppedItem(InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot], InventarioInfo[playerid][ItemSelecionado[playerid]][iUnidades], x, y, z);
        format(str, 280, "* Voce largou um item %s, com %d unidade(s)", NomeItemInv(InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot]), InventarioInfo[playerid][ItemSelecionado[playerid]][iUnidades]);
        SendClientMessage(playerid, 0x00ccccFF, str);
        InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot] = 19382;
        InventarioInfo[playerid][ItemSelecionado[playerid]][iUnidades] = 0;
        BoxAberto[playerid] = 0;
        FecharInventario(playerid);
        AbrirInventario(playerid);
        SetTimerEx("AbrirInventario", 200, false, "i", playerid);
    }
    if(playertextid == invText[playerid][11]){

        if(InventarioInfo[playerid][ItemSelecionado[playerid]][iSlot] == 19382){
            GameTextForPlayer(playerid, "~w~Selecione um ~b~Item", 5000, 1);
            //SendClientMessage(playerid, 0xFF6347AA, "* nao ha itens suficientes para ser combinado!");

            for(new i = 7; i < 16; i++){

            PlayerTextDrawHide(playerid, invText[playerid][i]);
            }
            BoxAberto[playerid] = 0;
            return 1;
        }

        CombinandoInv[playerid] = 1;
        MovendoInv[playerid] = 0;
        BoxAberto[playerid] = 0;
        SelectTextDraw(playerid, 0xAFAFAFAA);
    }
    if(playertextid == invText[playerid][15]){

        ShowPlayerDialog(playerid, 1515, DIALOG_STYLE_INPUT, "Separar item",
        "{FFFFFF}Digite a quantidade que Voce deseja separar:\n\n\
        {fa4c4c}OBS:{aaacae} O valor deve ser acima de zero!", "Separar", "Cancelar");
    }
    if(playertextid == invText[playerid][13]){
        SendClientMessage(playerid, COR_OBS, "[Troca de Item] {ffffff}Ainda nao e possivel trocar item com jogadores!");
        return 1;
    }
    if(playertextid == invText[playerid][3])
    {
                SelectTextDraw(playerid, 0xAFAFAFAA);
                ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX," ", "{fa4c4c}Alerta: {ffffff}Inventario Organizado!", "Fechar", "");
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                new MS = 999;
                for(new i=0; i<75; i++)
                {
                    for(new x=0; i<75; x++)
                    {
                        if(InventarioInfo[playerid][x][iSlot] == 19382)
                        {
                            MS = x;
                            break;
                        }
                    }
                    if(InventarioInfo[playerid][i][iSlot] != 19382)
                    {
                        if(i > MS)
                        {
                            InventarioInfo[playerid][MS][iSlot] = InventarioInfo[playerid][i][iSlot];
                            InventarioInfo[playerid][MS][iUnidades] = InventarioInfo[playerid][i][iUnidades];
                            InventarioInfo[playerid][i][iSlot] = 19382;
                            InventarioInfo[playerid][i][iUnidades] = 0;
                            AtualizarInventario(playerid);
                        }
                    }
                }
                return 1;
    }
    return 1;
}

public OnObjectMoved(objectid)
{
    new Float:x, Float:y, Float:z;
    for(new i; i < sizeof(Obj_FloorDoors); i ++)
    {
        if(objectid == Obj_FloorDoors[i][0])
        {
            GetObjectPos(Obj_FloorDoors[i][0], x, y, z);
            if (y < Y_DOOR_L_OPENED - 0.5)
            {
                Elevator_MoveToFloor(ElevatorQueue[0]);
                RemoveFirstQueueFloor();
            }
        }
    }
    if(objectid == Obj_Elevator)
    {
        KillTimer(ElevatorBoostTimer);

        FloorRequestedBy[ElevatorFloor] = INVALID_PLAYER_ID;

        Elevator_OpenDoors();
        Floor_OpenDoors(ElevatorFloor);

        GetObjectPos(Obj_Elevator, x, y, z);
        Label_Elevator  = Create3DTextLabel("{CCCCCC}Aperte '{FFFFFF}H{CCCCCC}' para usar o elevador", 0xCCCCCCAA, X_ELEVATOR_POS + 1.6, Y_ELEVATOR_POS - 1.85, z - 0.4, 4.0, 0, 1);

        ElevatorState   = ELEVATOR_STATE_WAITING;
        SetTimer("Elevator_TurnToIdle", ELEVATOR_WAIT_TIME, 0);
    }
    for(new i; i < sizeof(Obj_FloorDoors2); i ++)
    {
        if(objectid == Obj_FloorDoors2[i][0])
        {
            GetObjectPos(Obj_FloorDoors2[i][0], x, y, z);
            if (y < Y_DOOR_L_OPENED2 - 0.5)
            {
                Elevator_MoveToFloor2(ElevatorQueue2[0]);
                RemoveFirstQueueFloor2();
            }
        }
    }
    if(objectid == Obj_Elevator2)   // The elevator reached the specified floor.
    {
        KillTimer(ElevatorBoostTimer2);  // Kills the timer, in case the elevator reached the floor before boost.
        FloorRequestedBy2[ElevatorFloor2] = INVALID_PLAYER_ID;
        Elevator_OpenDoors2();
        Floor_OpenDoors2(ElevatorFloor2);
        GetObjectPos(Obj_Elevator2, x, y, z);
        Label_Elevator2 = Create3DTextLabel("{CCCCCC}Pressione '{FFFFFF}~k~~Y{CCCCCC}' Para Usar o Elevador", 0xCCCCCCAA, X_ELEVATOR_POS2 - 1.7, Y_ELEVATOR_POS2 - 1.75, z - 0.4, 4.0, 0, 1);
        ElevatorState2  = ELEVATOR_STATE_WAITING;
        SetTimer("Elevator_TurnToIdle2", ELEVATOR_WAIT_TIME, 0);
    }

    return 1;
}
public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(strfind(inputtext,"%s", true) != -1)
    {
        return 1;
    }
    TogglePlayerControllable(playerid, 1);
    new string[128];
    new playername[MAX_PLAYER_NAME];
    GetPlayerName(playerid,playername,sizeof(playername));

    if(dialogid == 15584)
    {
        if(response)
        {
            new veiculoidb = GetPlayerVehicleID(playerid);
            if(listitem == 0)
            {
                if(playermoney[playerid] < 3000)
                {
                    return 1;
                }
                Vuln[veiculoidb] = 80;
                GivePlayerMoneyEx(playerid, -3000);
                DepositarOrgGrana(14,3000);
                foreach(new i: Player)
                {
                    if(GetPlayerOrg(i) == 14)
                    {
                        new tvstring[500];
                        format(tvstring, sizeof(tvstring), "~w~VEICULO BLINDADO~n~~g~R$~r~%s", ConvertMoney(3000));
                        GameTextForPlayer(i, tvstring, 2500, 3);
                        GivePlayerMoneyEx(i, 3000);
                    }
                }
            }
            if(listitem == 1)
            {
                if(playermoney[playerid] < 3000)
                {
                    return 1;
                }
                SetVehicleHealth(RepairCar[playerid], 1000.0);
                GivePlayerMoneyEx(playerid, -3000);
                DepositarOrgGrana(14,3000);
                foreach(new i: Player)
                {
                    if(GetPlayerOrg(i) == 14)
                    {
                        new tvstring[500];
                        format(tvstring, sizeof(tvstring), "~w~VEICULO REPARADO~n~~g~R$~r~%s", ConvertMoney(3000));
                        GameTextForPlayer(i, tvstring, 2500, 3);
                        GivePlayerMoneyEx(i, 3000);
                    }
                }
            }

            if(listitem == 2)
            {
                if(playermoney[playerid] < 5000)
                {
                    return 1;
                }
                Gas[veiculoidb] = 100;
                GivePlayerMoneyEx(playerid, -5000);
                DepositarOrgGrana(14,5000);
                foreach(new i: Player)
                {
                    if(GetPlayerOrg(i) == 14)
                    {
                        new tvstring[500];
                        format(tvstring, sizeof(tvstring), "~w~VEICULO ABASTECIDO~n~~g~R$~r~%s", ConvertMoney(5000));
                        GameTextForPlayer(i, tvstring, 2500, 3);
                        GivePlayerMoneyEx(i, 5000);
                    }
                }
            }
        }
        return 1;
    }

    if(dialogid == 15657)
    {
        //ShowPlayerDialog(playerid,15657,DIALOG_STYLE_LIST,"Concessionarias","Carros LS\nCarros SF\nCarros LV\nAerea LV","Localizar","Fechar");
        if(response)
        {
            if(listitem == 0)
            {
                SetPlayerCheckpoint(playerid, 2271.3750,-2355.0818,13.5469, 6); //ls
                SendClientMessage(playerid, COR_OBS, "[GPS]: {ffffff}Voce marcou a concessionaria 1 de Los Santos, o Checkpoint foi marcado em seu mapa!");
            }
            if(listitem == 1)
            {
                SetPlayerCheckpoint(playerid, -1649.1866,1209.1746,7.2500, 6); //sf
                SendClientMessage(playerid, COR_OBS, "[GPS]: {ffffff}Voce marcou a concessionaria de San Fierro, o Checkpoint foi marcado em seu mapa!");
            }
            if(listitem == 2)
            {
                SetPlayerCheckpoint(playerid, 2763.5852,-2008.7629,13.5547, 6); //ls aztecas
                SendClientMessage(playerid, COR_OBS, "[GPS]: {ffffff}Voce marcou a concessionaria 2 de Los Santos, o Checkpoint foi marcado em seu mapa!");
            }
            if(listitem == 3)
            {
                SetPlayerCheckpoint(playerid, 2200.8086,1394.8070,11.0625, 6); //lv
                SendClientMessage(playerid, COR_OBS, "[GPS]: {ffffff}Voce marcou a concessionaria de Las Venturas, o Checkpoint foi marcado em seu mapa!");
            }
            if(listitem == 4)
            {
                SetPlayerCheckpoint(playerid, 2200.8086,1394.8070,11.0625, 6); //barcos e boates ls
                SendClientMessage(playerid, COR_OBS, "[GPS]: {ffffff}Voce marcou a concessionaria de Las Venturas, o Checkpoint foi marcado em seu mapa!");
            }
        }
        return 1;
    }

    if(dialogid == 9648)
    {
        if(response)
        {
            if(listitem == 0)
            {
                SelectTextDraw(playerid, 0xAFAFAFAA);
                ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX," ", "{fa4c4c}Alerta: {ffffff}Inventario Organizado!", "Fechar", "");
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                new MS = 999;
                for(new i=0; i<75; i++)
                {
                    for(new x=0; i<75; x++)
                    {
                        if(InventarioInfo[playerid][x][iSlot] == 19382)
                        {
                            MS = x;
                            break;
                        }
                    }
                    if(InventarioInfo[playerid][i][iSlot] != 19382)
                    {
                        if(i > MS)
                        {
                            InventarioInfo[playerid][MS][iSlot] = InventarioInfo[playerid][i][iSlot];
                            InventarioInfo[playerid][MS][iUnidades] = InventarioInfo[playerid][i][iUnidades];
                            InventarioInfo[playerid][i][iSlot] = 19382;
                            InventarioInfo[playerid][i][iUnidades] = 0;
                            AtualizarInventario(playerid);
                        }
                    }
                }
            }
            if(listitem == 1)
            {
                    SendClientMessage(playerid, COR_OBS, "ERRO: {ffffff}O sistema de Trade ainda nao esta sendo desenvolvido, de uma sugestao do trade em nosso discord!");
            }
        }
        if(!response)
        {
            for(new i = 0; i != 7; i++){
                PlayerTextDrawShow(playerid, invText[playerid][i]);
            }
            SelectTextDraw(playerid, 0xAFAFAFAA); //0x00FFFFFF //0xAFAFAFAA

            new str[256];

            format(str,300,"______________________________________________________________~w~Pagina %d-5",InventarioPagina[playerid]);
            PlayerTextDrawSetString(playerid,invText[playerid][4],str);

            new itens;
            for(new i = 0; i < 75; i++){

                if(InventarioInfo[playerid][i][iSlot] != 19382) itens++;
                format(str, sizeof str, "Inventaio_de:_%s_Itens:_~h~%d/75", PlayerName(playerid), itens);
                PlayerTextDrawSetString(playerid, invText[playerid][5], str);
                //PlayerTextDrawShow(playerid, invText[playerid][16]);
            }

            InventarioAberto[playerid] = 1;

            if(InventarioPagina[playerid] == 1){

                for(new i=0; i < 15; i++){

                    if(InventarioInfo[playerid][i][iUnidades] > 0){

                        format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                        PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                        PlayerTextDrawShow(playerid, invName[playerid][i]);
                    }
                    PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
                    PlayerTextDrawShow(playerid, invPreview[playerid][i]);

                    if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                    if(InventarioInfo[playerid][i][iSlot] == 19382){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                }
            }

            if(InventarioPagina[playerid] == 2){

                for(new i = 15; i < 30; i++){

                    if(InventarioInfo[playerid][i][iUnidades] > 0){

                        format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                        PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                        PlayerTextDrawShow(playerid, invName[playerid][i]);
                    }
                    PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
                    PlayerTextDrawShow(playerid, invPreview[playerid][i]);

                    if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                    if(InventarioInfo[playerid][i][iSlot] == 19382){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                }
            }

            if(InventarioPagina[playerid] == 3){

                for(new i=30; i != 45; i++){

                    if(InventarioInfo[playerid][i][iUnidades] > 0){

                        format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                        PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                        PlayerTextDrawShow(playerid, invName[playerid][i]);
                    }
                    PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
                    PlayerTextDrawShow(playerid, invPreview[playerid][i]);

                    if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                    if(InventarioInfo[playerid][i][iSlot] == 19382){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                }
            }

            if(InventarioPagina[playerid] == 4){

                for(new i=45; i != 60; i++){

                    if(InventarioInfo[playerid][i][iUnidades] > 0){

                        format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                        PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                        PlayerTextDrawShow(playerid, invName[playerid][i]);
                    }
                    PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
                    PlayerTextDrawShow(playerid, invPreview[playerid][i]);

                    if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                    if(InventarioInfo[playerid][i][iSlot] == 19382){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                }
            }
            if(InventarioPagina[playerid] == 5){

                for(new i=60; i != 75; i++){

                    if(InventarioInfo[playerid][i][iUnidades] > 0){

                        format(str, sizeof str, "%s ~b~~h~%d", NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
                        PlayerTextDrawSetString(playerid, invName[playerid][i], str);
                        PlayerTextDrawShow(playerid, invName[playerid][i]);
                    }
                    PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], InventarioInfo[playerid][i][iSlot]);
                    PlayerTextDrawShow(playerid, invPreview[playerid][i]);

                    if(InventarioInfo[playerid][i][iSlot] == 11738 || InventarioInfo[playerid][i][iSlot] == 11739){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 11736);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                    if(InventarioInfo[playerid][i][iSlot] == 19382){

                        PlayerTextDrawSetPreviewModel(playerid, invPreview[playerid][i], 18631);
                        PlayerTextDrawShow(playerid, invPreview[playerid][i]);
                    }
                }
            }
        }
        return 1;
    }

    if(dialogid == 15569)
    {
        if(response)
        {
            if(acontecendotrade == false)
            {
                foreach(new i: Player)
                {
                    if(strfind(inputtext,PlayerName(i), true) != -1)
                    {
                        TradeInfo[1][tPlayer] = i;
                    }
                }
                TradeInfo[1][tPlayer2] = playerid;
                idplayertrade = playerid;
                MEGAString[0] = EOS;
