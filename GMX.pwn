                    SendClientMessage(playerid, COR_LIGHTRED, "e PROIBIDO XINGAR NO CHAT DE DuVIDAS,Voce PERDEU 3000 REAIS !");
                    return 1;
                }
                strmid(VarChatDuvida[playerid], result, 0, strlen(result), 255);
                new Dialog[300];
                format(stringZCMD, sizeof(stringZCMD), "{0000FF}Â» {2EFEF7}%s{FFFFFF}, Esse chat e exclusivo para perguntar / responder duvidas,\n\ncaso seja usado para algo nao relacionado, sera punido imediatamente!\n\n\n\n",PlayerName(playerid));
                strcat(Dialog,stringZCMD);
                format(stringZCMD, sizeof(stringZCMD), "\nSua duvida: {F7FE2E}%s \n{0000FF}deseja enviar essa mensagem ?",VarChatDuvida[playerid]);
                strcat(Dialog,stringZCMD);
                ShowPlayerDialog(playerid, 8725, DIALOG_STYLE_MSGBOX, "{0000FF}Â» {FFFFFF}Chat Duvida", Dialog, "Enviar", "Cancelar");
            }
            else if(ChatNoobSis == false)
            {
                SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O /n esta desativado! Consulte no {df5454}/menusistema{ffffff}!!!");
            }
            /*if(isnull(result))
                return SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/n [chat duvida]");
            if(TentouDivulgar(result))
