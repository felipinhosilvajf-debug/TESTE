    CMD:pegarpizza(playerid)
    {
         if(PlayerInfo[playerid][pEmprego] == 15)
         {
              if(PlayerToPoint(1, playerid,376.6709,-117.2787,1001.4922) || PlayerToPoint(1,playerid,372.6528,-117.2788,1001.4922) || PlayerToPoint(1,playerid,378.9566,-62.6248,1001.5078) || PlayerToPoint(1, playerid,375.8797,-62.6190,1001.5078))
              {
                   if(EmpregoDuty[playerid] == 1)
                   {
                        for(new i=0; i<75; i++)
                        {
                            if(InventarioInfo[playerid][i][iSlot] == 19382)
                            {
                                InventarioInfo[playerid][i][iSlot] = 2881;
                                InventarioInfo[playerid][i][iUnidades] = 10;
                                SendClientMessage(playerid, COR_AMARELO, "[Pizzaria]:{ffffff} 10 Pizzas foram adicionadas ao seu inventario, use /inventario para vende-las.");
                                break;
                            }
                        }
                        for(new i=0; i<75; i++)
                        {
                            if(InventarioInfo[playerid][i][iSlot] == 19382)
                            {
                                InventarioInfo[playerid][i][iSlot] = 1668;
                                InventarioInfo[playerid][i][iUnidades] = 10;
                                SendClientMessage(playerid, COR_AZUL, "[Pizzaria]:{ffffff} 10 Garrafas d'agua foram adicionadas ao seu inventario, use /inventario para vende-las.");
                                break;
                            }
                        }
                   }
                   else
                   {
                        SendClientMessage(playerid, COR_GRAD1, "Voce precisa bater o cartao para pegar pizzas!");
                   }
              }
              else
              {
                   SendClientMessage(playerid, COR_GRAD1, "Voce nao esta no local para pegar suas pizzas.");
                   return 1;
              }
         }
         else
         {
              SendClientMessage(playerid, COR_GRAD1, "Voce nao e um pizzaboy.");
              return 1;
         }
         return 1;
    }
    CMD:stopmp3(playerid)
    {
         if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
         return 1;
    }
    CMD:infoconta(playerid, params[])
    {
         new arquivobanido[128];
         new stringemp[128];
         new stringvip[128];
         new stringcasa[128];
         new stringfazenda[128];
         new stringbanido[128];
         new ultimolog[20];
         if(PlayerInfo[playerid][pAdmin] >= 1338)
         {
              new pName[MAX_PLAYER_NAME];
              if(sscanf(params, "s[24]", pName))
              {
                   SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /infoconta [NOME_JOGADOR]");
                   return true;
              }
              new Query[65];
              format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(PlayerName(playerid)));
              Resultado = db_query(Conexao,Query);
              if(db_num_rows(Resultado) == 0)
              {
                   SendClientMessage(playerid, COR_GRAD1, "Este jogador nao esta registrado no servidor.");
                   return true;
              }
              new casa, empresa, fazenda, VIP, result[10];
              db_get_field_assoc(Resultado, "ChaveCasa", result, sizeof(result));
              casa = strval(result);
              db_get_field_assoc(Resultado, "ChaveEmpresa", result, sizeof(result));
              empresa = strval(result);
              db_get_field_assoc(Resultado, "ChaveFazenda", result, sizeof(result));
              fazenda = strval(result);
              db_get_field_assoc(Resultado, "DiaVIP", result, sizeof(result));
              VIP = strval(result);
              db_get_field_assoc(Resultado, "LU", ultimolog, 20);
              if(empresa == 255)
              {
                   format(stringemp, sizeof(stringemp), "Empresa: {CC0000}nao");
              }
              else
              {
                   format(stringemp, sizeof(stringemp), "Empresa: {00FF00}Sim");
              }
              if(casa == 999)
              {
                   format(stringcasa, sizeof(stringcasa), "Casa: {CC0000}nao");
              }
              else
              {
                   format(stringcasa, sizeof(stringcasa), "Casa: {00FF00}Sim");
              }
              if(fazenda == 255)
              {
                   format(stringfazenda, sizeof(stringfazenda), "Fazenda: {CC0000}nao");
              }
              else
              {
                   format(stringfazenda, sizeof(stringfazenda), "Fazenda: {00FF00}Sim");
              }
              if(VIP == 0)
              {
                   format(stringvip, sizeof(stringvip), "VIP/Socio: {CC0000}nao");
              }
              else
              {
                   format(stringvip, sizeof(stringvip), "VIP/Socio: {00FF00}Sim");
              }
              format(arquivobanido, sizeof(arquivobanido), Pasta_Banidos,pName);
              if(!DOF2_FileExists(arquivobanido))
              {
                   format(stringbanido, sizeof(stringbanido), "Banido: {CC0000}nao");
              }
              else
              {
                   format(stringbanido, sizeof(stringbanido), "Banido: {00FF00}Sim");
              }
              SendClientMessage(playerid, COR_BRANCO, stringemp);
              SendClientMessage(playerid, COR_BRANCO, stringfazenda);
              SendClientMessage(playerid, COR_BRANCO, stringcasa);
              SendClientMessage(playerid, COR_BRANCO, stringvip);
              SendClientMessage(playerid, COR_BRANCO, stringbanido);
              format(stringZCMD, sizeof(stringZCMD), "ultimo Login do %s: [%s]", pName, ultimolog);
              format(stringemp, sizeof(stringemp), "Empresa ID:[%d]", empresa);
              format(stringcasa, sizeof(stringcasa),"Casa ID:[%d]", casa);
              format(stringcasa, sizeof(stringcasa), "Fazenda ID:[%d]", fazenda);
              format(stringvip, sizeof(stringvip),  "Tempo VIP/SoCIO: %d.", VIP);
              SendClientMessage(playerid, COR_BRANCO, stringZCMD);
              SendClientMessage(playerid, COR_BRANCO, stringemp);
              SendClientMessage(playerid, COR_BRANCO, stringfazenda);
              SendClientMessage(playerid, COR_BRANCO, stringcasa);
              SendClientMessage(playerid, COR_BRANCO, stringvip);
              SendClientMessage(playerid, COR_BRANCO, stringbanido);
              return true;
         }
         else
         {
              SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado para usar este comando!");
         }
         return true;
    }
    CMD:orelhas(playerid)
    {
         if(IsPlayerConnected(playerid))
         {
              if(PlayerInfo[playerid][pAdmin] >= 1340)
              {
                   if(AdminTrabalhando[playerid] < 1)
                   {
                        SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                        return 1;
                   }
                   if (!BigEar[playerid])
                   {
                        BigEar[playerid] = 1;
                        SendClientMessage(playerid, COR_GRAD2, "Suas orelhas cresceram");
                   }
                   else if (BigEar[playerid])
                   {
                        BigEar[playerid] = 0;
                        SendClientMessage(playerid, COR_GRAD2, "Suas orelhas encolheram");
                   }
              }
              else
              {
                   SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando !");
                   return 1;
              }
         }
         return 1;
    }
    CMD:novatos(playerid)
    {
         if(IsPlayerConnected(playerid))
         {
              if(PlayerInfo[playerid][pAdmin] >= 1)
              {
                   if(AdminTrabalhando[playerid] < 1)
                   {
                        SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                        return 1;
                   }
                   SendClientMessage(playerid, COR_VERDE, "Novatos Online(Horas Menor que 12):" );
                   foreach(new i: Player)
                   {
                        if(PlayerInfo[i][pConnectTime] < 12)
                        {
                            new local[MAX_ZONE_NAME];
                            GetPlayer2DZone(sscanfid, local, MAX_ZONE_NAME);
                            if(IsPlayerInSF(i))
                            {
                                GetPlayerName(i, sendername, sizeof(sendername));
                                format(stringZCMD, 256, "%s: ID[%d] - Horas Jogadas[%d] - Cidade[SF] - Bairro[%s]", sendername,i,PlayerInfo[i][pConnectTime],local);
                                SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                                return 1;
                            }
                            else if(IsPlayerInLS(i))
                            {
                                GetPlayerName(i, sendername, sizeof(sendername));
                                format(stringZCMD, 256, "%s: ID[%d] - Horas Jogadas[%d] - Cidade[LS] - Bairro[%s]", sendername,i,PlayerInfo[i][pConnectTime],local);
                                SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                                return 1;
                            }
                            else if(IsPlayerInLV(i))
                            {
                                GetPlayerName(i, sendername, sizeof(sendername));
                                format(stringZCMD, 256, "%s: ID[%d] - Horas Jogadas[%d] - Cidade[LV] - Bairro[%s]", sendername,i,PlayerInfo[i][pConnectTime],local);
                                SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                                return 1;
                            }
                            else if(IsPlayerInLSSF(i))
                            {
                                GetPlayerName(i, sendername, sizeof(sendername));
                                format(stringZCMD, 256, "%s: ID[%d] - Horas Jogadas[%d] - Cidade[LS/SF] - Bairro[%s]", sendername,i,PlayerInfo[i][pConnectTime],local);
                                SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                                return 1;
                            }
                            else if(IsPlayerInLSLV(i))
                            {
                                GetPlayerName(i, sendername, sizeof(sendername));
                                format(stringZCMD, 256, "%s: ID[%d] - Horas Jogadas[%d] - Cidade[LS/LV] - Bairro[%s]", sendername,i,PlayerInfo[i][pConnectTime],local);
                                SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                                return 1;
                            }
                            else if(IsPlayerInSFLV(i))
                            {
                                GetPlayerName(i, sendername, sizeof(sendername));
                                format(stringZCMD, 256, "%s: ID[%d] - Horas Jogadas[%d] - Cidade[SF/LV] - Bairro[%s]", sendername,i,PlayerInfo[i][pConnectTime],local);
                                SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                                return 1;
                            }
                            return 1;
                        }

                   }
              }
              else
              {
                   SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando !");
                   return 1;
              }
         }
         return 1;
    }
