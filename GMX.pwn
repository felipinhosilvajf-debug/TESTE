                    DOF2_SetString(arquivo,"Denuncia",iddenuncia);
                    DOF2_SetInt(arquivo,"Avisos",avisos);
                    format(stringZCMD,sizeof(stringZCMD), "{df5454}[Punicao Agendada] %s agendou no player OFF %s: %d minutos de carandiru e %d avisos!", sendername, playa, tempo, avisos);
                    SendClientMessageToAll(COR_START,stringZCMD);
                    CarandiruAgendado(stringZCMD);
                }
                else
                {
                    DOF2_CreateFile(arquivo);
                    DOF2_SetString(arquivo,"Admin",PlayerName(playerid));
                    DOF2_SetInt(arquivo,"Tempo",tempo);
                    DOF2_SetString(arquivo,"Motivo",iddenuncia);
                    DOF2_SetInt(arquivo,"Avisos",avisos);
                    format(stringZCMD,sizeof(stringZCMD), "{df5454}[Punicao Agendada] %s agendou no player OFF %s: %d minutos de carandiru e %d avisos!", sendername, playa, tempo, avisos);
                    SendClientMessageToAll(COR_START,stringZCMD);
                    CarandiruAgendado(stringZCMD);
