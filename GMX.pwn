    CMD:ajudafazenda(playerid, params[])
    {
        MEGAString[0] = EOS;
        strcat(MEGAString, "{a4a4a4}Comandos:\n\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /infofazenda{a4a4a4}          Ver informacoes de sua fazenda\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /nomefazenda{a4a4a4}          Mudar o nome de sua fazenda\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /extorcaofaz{a4a4a4}          Selecionar alguem para extorcao, ele lucrara R$30 por minutro.\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /precoprodutofaz{a4a4a4}      O preco que pagara por produtos na fazenda.\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /pedirprodutosfaz{a4a4a4}     Premitir que um 'Vendedor de Produtos' venda produtos para sua fazenda.\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /chave{a4a4a4}                Para abrir ou fechar sua fazenda.\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /venderfazenda{a4a4a4}        Vender sua fazenda.\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /sacarfazenda{a4a4a4}         Depositar nos fundos de sua fazenda.\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /entradafazenda{a4a4a4}       Valor cobrado ao entrar no interior da sua fazenda.\n");
        strcat(MEGAString, "{33ff00}Â»{ffffff} /gps > fazendas{a4a4a4}       Localizar fazendas.\n\n");
        strcat(MEGAString, "{a4a4a4}Como funciona?\n");
        strcat(MEGAString, "{ffffff}A cada 1 minuto sua fazenda lucrara R$800 + R$1.000 Aleatorio no cofre.\n");
        strcat(MEGAString, "A cada minuta que sua fazenda lucrar, retirara de 0 a 6 de produtos aleatorio.\n");
        strcat(MEGAString, "Sem produtos sua fazenda nao lucrara.\n\n");
        strcat(MEGAString, "{a4a4a4}Dicas:\n");
        strcat(MEGAString, "{ffffff}Sempre que precisas de produtos, use /anl para anunciar para os Vendedores de Produtos ou Voce\n");
        strcat(MEGAString, "mesmo pega o emprego e vende produtos para sua fazenda. Exemplo de anuncio global abaixo:\n");
        strcat(MEGAString, "(/anl Fazenda 'Dipirona Farm's' pagando R$100 por produtos!).\n");
        strcat(MEGAString, "Quando achar que sua fazenda possui produtos necessario para Voce lucrar, retire os produtos\n");
        strcat(MEGAString, "Requeridos, so assim nenhum caminhoneiro consiguira vender produtos, ou coloque o preco por produtos\n");
        strcat(MEGAString, "a 1 real, ai, se alguem vender Voce vai sair na vantagem.\n\n");
        strcat(MEGAString, "{FFFF00}O Sistema de fazenda esta em fase de beta, tera novidades na proxima versao!\n\n");
        strcat(MEGAString, "{a4a4a4}Informacoes:\n");
        strcat(MEGAString, "{FFFFFF}Produtos requeridos: A quantidade de produtos pedidos (se definido como 0 Ninguem consguira vender).\n");
        strcat(MEGAString, "Produtos> Os produtos que fazera sua fazenda lucrar, ao chegar 0 sua fazenda nao lucrara mais.\n\n");
        strcat(MEGAString, "Fundos> A quantidade de grana que Voce possui no cofre de sua fazenda.\n\n");
        strcat(MEGAString, "Nome: O nome de sua fazenda.\n\n");
        strcat(MEGAString, "Preco por produtos: O Valor que o 'Vendedor de Produtos' Recebera dos fundos(cofre) pro produtos.\n");
        ShowPlayerDialog(playerid, DSFUNCAO, DIALOG_STYLE_MSGBOX, "Ajuda Fazenda", MEGAString, "Fechar", "");
        return 1;
    }
    CMD:irfazenda(playerid, params[])
    return ForT:irfaz(playerid,params);
    CMD:irfaz(playerid, params[])
    {
            if(PlayerInfo[playerid][pAdmin] < 1337)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao tem autorizacao para usar esse comando!");
                return true;
            }
            if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] < 1340)
            {
                SendClientMessage(playerid, COR_GRAD1, " Voce nao esta em modo trabalho USE: /trabalhar");
                return true;
            }
            new Emp;
            if(sscanf(params, "d", Emp))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/irfaz)enda [id]");
                return true;
            }
            SetPlayerPos(playerid,FBizzInfo[Emp][fbEntranceX],FBizzInfo[Emp][fbEntranceY],FBizzInfo[Emp][fbEntranceZ]);
            return true;
    }
    CMD:trazerfazenda(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] < 1340)
        {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando!");
                return 1;
        }
        new idemp;
        if(sscanf(params, "d", idemp))
        {
            SendClientMessage(playerid,COR_GREY,"{df5454}Ã—{ffffff} USE: /trazerfazenda [ID]");
            return true;
        }
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        FBizzInfo[idemp][fbEntranceX] = x;
        FBizzInfo[idemp][fbEntranceY] = y;
        FBizzInfo[idemp][fbEntranceZ] = z;
        SalvarFEmpresa(idemp);
        return true;
    }
    CMD:resetarfazendas(playerid, params[])
    {
            if(PlayerInfo[playerid][pAdmin] < 1342)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando!");
                return 1;
            }
            new string[256];
            for(new b = 0; b < sizeof(FBizzInfo); b++)
            {
                format(string, sizeof string, "Fazenda %d", b);
                FBizzInfo[b][fbLocked] = 1;
                FBizzInfo[b][fbOwned] = 0;
                strmid(FBizzInfo[b][fbOwner], "The State", 0, strlen("The State"), 255);
                strmid(FBizzInfo[b][fbExtortion], "Ninguem", 0, strlen("Ninguem"), 255);
                strmid(FBizzInfo[b][fbMessage], string,0,strlen(string), 255);
                FBizzInfo[b][fbBuyPrice] = 5000000;
                FBizzInfo[b][fbEntranceCost] = 5000;
                FBizzInfo[b][fbProducts] = 200000;
                FBizzInfo[b][fbMaxProducts] = 200000;
                FBizzInfo[b][fbPriceProd] = 1000;
                FBizzInfo[b][fbProductsReq] = 0;
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                SalvarFEmpresa(b);
            }
            format(string, 128, "Voce resetou todas as Fazendas !");
            SendClientMessage(playerid, COR_GRAD2, string);
            Atualizar3Dtexts();
            return true;
    }
    CMD:admvfaz(playerid, params[]) return ForT:avenderfazenda(playerid, params);
    CMD:avenderfazenda(playerid, params[])
    {
            new playername[MAX_PLAYER_NAME];
            GetPlayerName(playerid, playername, sizeof(playername));
            new fbiz;
            if(sscanf(params, "d", fbiz))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /avenderfazenda [fazenda id]");
                return true;
            }
            if (PlayerInfo[playerid][pAdmin] >= 1337)
            {
                if(AdminTrabalhando[playerid] < 1 && PlayerInfo[playerid][pAdmin] < 1340)
                {
                    SendClientMessage(playerid, COR_GRAD1, " Voce nao esta em modo trabalho USE: /trabalhar");
                    return true;
                }
                new string[128];
                FBizzInfo[fbiz][fbLocked] = 1;
                FBizzInfo[fbiz][fbOwned] = 0;
                strmid(FBizzInfo[fbiz][fbOwner], "The State", 0, strlen("The State"), 255);
                strmid(FBizzInfo[fbiz][fbExtortion], "Ninguem", 0, strlen("Ninguem"), 255);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                format(string, sizeof(string), "~w~Voce vendeu a empresa ID:%d", fbiz);
                GameTextForPlayer(playerid, string, 10000, 3);
                Atualizar3Dtexts();
                SalvarFEmpresa(fbiz);
                return true;
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao tem permissao para usar esse comando !");
            }
            return true;
    }
    CMD:comprarfazenda(playerid, params[])
    {
            new playername[MAX_PLAYER_NAME];
            new Float:oldposx, Float:oldposy, Float:oldposz;
            GetPlayerName(playerid, playername, sizeof(playername));
            GetPlayerPos(playerid, oldposx, oldposy, oldposz);
            if(PlayerInfo[playerid][pVIP] < 2)
            {
                SendClientMessage(playerid, COR_GREY, "Apenas players S-VIPs podem comprar uma fazenda");
                return true;
            }
            if(PlayerInfo[playerid][pPFazkey] != 255)
            {
                SendClientMessage(playerid, COR_GREY, "   Voce ja tem uma fazenda, Digite /venderfazenda ou para comprar outra.");
                return true;
            }
            new string[128];
            for(new b = 0; b < sizeof(FBizzInfo); b++)
            {
                if(PlayerToPoint(2.0, playerid, FBizzInfo[b][fbEntranceX], FBizzInfo[b][fbEntranceY], FBizzInfo[b][fbEntranceZ]) && FBizzInfo[b][fbOwned] == 0)
                {
                    if(PlayerInfo[playerid][pLevel] < FBizzInfo[b][fbLevelNeeded])
                    {
                        format(string, sizeof(string), "Voce precisa ser nivel %d para comprar essa fazenda",FBizzInfo[b][fbLevelNeeded]);
                        SendClientMessage(playerid, COR_GRAD5, string);
                        return true;
                    }
                    if(GetPlayerMoney(playerid) > FBizzInfo[b][fbBuyPrice])
                    {
                        PlayerInfo[playerid][pPFazkey] = b;
                        FBizzInfo[b][fbOwned] = 1;
                        FBizzInfo[b][fbLocked] = 0;
                        FBizzInfo[b][fbTill] = 0;
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        strmid(FBizzInfo[b][fbOwner], sendername, 0, strlen(sendername), 255);
                        GivePlayerMoneyEx(playerid,-FBizzInfo[b][fbBuyPrice]);
                        PlayerPlayMusic(playerid);
                        SendClientMessage(playerid, COR_BRANCO, "Parabens, Voce comprou uma Fazenda.");
                        SendClientMessage(playerid, COR_BRANCO, "Digite /ajudafazenda para ver os comandos de sua Fazenda.");
                        Atualizar3Dtexts();
                        SalvarFEmpresa(b);
                        DateProp(playerid);
                        return true;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao tem grana suficiente");
                        return true;
                    }
                }
            }
            return true;
    }
    CMD:venderfazenda(playerid, params[])
    {
            new playername[MAX_PLAYER_NAME];
            GetPlayerName(playerid, playername, sizeof(playername));
            if(PlayerInfo[playerid][pPFazkey] == 255)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao possui uma fazenda.");
                return true;
            }
            new string[128];
            if(PlayerInfo[playerid][pPFazkey] < 255 && strcmp(playername, FBizzInfo[PlayerInfo[playerid][pPFazkey]][fbOwner], true) == 0)
            {
                new borse = PlayerInfo[playerid][pPFazkey];
                GivePlayerMoneyEx(playerid,FBizzInfo[borse][fbBuyPrice]);
                FBizzInfo[borse][fbLocked] = 0;
                FBizzInfo[borse][fbOwned] = 0;
                GetPlayerName(playerid, sendername, sizeof(sendername));
                strmid(FBizzInfo[borse][fbOwner], "The State", 0, strlen("The State"), 255);
                strmid(FBizzInfo[borse][fbExtortion], "Ninguem", 0, strlen("Ninguem"), 255);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                format(string, sizeof(string), "~w~Parabens~n~ Voce vendeu terrenos por ~n~~g~R$%d", FBizzInfo[borse][fbBuyPrice]);
                GameTextForPlayer(playerid, string, 10000, 3);
                PlayerInfo[playerid][pPFazkey] = 255;
                Atualizar3Dtexts();
                SalvarFEmpresa( borse );
                return true;
            }
            if(PlayerInfo[playerid][pPFazkey] != 255)
            {
                PlayerInfo[playerid][pPFazkey] = 255;
                return true;
            }
            else
            {
                SendClientMessage(playerid, COR_BRANCO, "Voce nao tem uma Fazenda.");
            }
            return true;
    }
    CMD:infofazenda(playerid, params[])
    {
            new borse = PlayerInfo[playerid][pPFazkey];
            if(borse == 255)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao tem uma Fazenda.");
                return true;
            }
            if (borse < 255)
            {
                PrintFBizInfo(playerid,borse);
            }
            return true;
    }
    CMD:entradafazenda(playerid, params[])
    {
            new quant;
            new borse = PlayerInfo[playerid][pPFazkey];
            if (borse == 255)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem uma Fazenda !");
                return true;
            }
            if(sscanf(params, "d", quant))
            {
                return SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /entradadafazenda [preco]");
            }
            if(quant < 1 || quant > 5000)
            {
                SendClientMessage(playerid, COR_BRANCO, "Preco da entrada minimo R$1, maximo R$5000.");
                return true;
            }
            new string[55];
            if (borse < 255)
            {
                FBizzInfo[borse][fbEntranceCost] = quant;
                SalvarFEmpresa(borse);
                format(string, sizeof(string), "Entrada Definida Para: R$%d.", FBizzInfo[borse][fbEntranceCost]);
            }
            Atualizar3Dtexts();
            SendClientMessage(playerid, COR_BRANCO, string);
            return true;
    }
    CMD:rank(playerid)
    {
        if(!gPlayerLogged[playerid])return SendClientMessage(playerid, COR_GRAD1, "Voce precisa estar logado!");
        MEGAString[0]=EOS;
        strcat(MEGAString, "{df5454} Â»{ffffff} Nivel\n");
        strcat(MEGAString, "{df5454} Â»{ffffff} Horas jogadas\n");
        strcat(MEGAString, "{df5454} Â»{ffffff} Kills\n");
