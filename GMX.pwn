    CMD:report(playerid, params[])return ForT:reportar(playerid, params);
    CMD:reportar(playerid, params[]){

        new
            id,
            motivo[128]
        ;

        if(gettime() < GetPVarInt(playerid, #VarFlood1))
            return SendClientMessage(playerid, COR_GRAD1, #Voce nao pode usar este comando com tanta frequencia);
        SetPVarInt(playerid, #VarFlood1, gettime()+5);

        if(sscanf(params, "us[128]", id, motivo))return SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /report [id] [motivo]");

        if(!IsPlayerConnected(id))return SendClientMessage(playerid, COR_GRAD1, "Este player esta off-line!");

        if(gPlayerLogged[playerid]){

            new Str[226];

            format(Str, sizeof Str, "{df5454}REPORT: {ffff00}%s[%d] reportou: %s[%d] (Level %d) de: {df5454}%s.", PlayerName(playerid), playerid, PlayerName(id), id, PlayerInfo[id][pLevel], motivo);
            ABroadCast(COR_START, Str, 1);
            SendClientMessage(playerid, COR_LIGHTGREEN, "Seu report foi enviado para os admins...");
        }
        return 1;
    }
    CMD:atendimento(playerid, params[])  return ForT:relato(playerid, params);
    CMD:relato(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(isnull(params))
                return SendClientMessage(playerid, COR_START, "{df5454}USE: {ffffff}/atendimento [Assunto] - Maximo 30 digitos!");
            new Dialog[300];
            format(stringZCMD, sizeof(stringZCMD), "{FFFFFF}Voce esta prestes a solicitar um atendimento administrativo\n\nSeu Nome: {df5454}%s\n{FFFFFF}Assunto do Atendimento: {df5454}%s\n\n",PlayerName(playerid), params);
            strcat(Dialog,stringZCMD);
            format(stringZCMD, sizeof(stringZCMD), "{FF6347}OBS:{BFC0C2} Solicite atendimento para assuntos serios, para duvidas use /duvida ou /reportar,\ncaso contrario Voce sera devidamente punido pela administracao do servidor.");
            strcat(Dialog,stringZCMD);
            strmid(ArmazenarString[playerid], params, 0, strlen(params), 255);
            ShowPlayerDialog(playerid, 8726, DIALOG_STYLE_MSGBOX, "{df5454}Solicitar Atendimento", Dialog, "Continuar", "Cancelar");
        }
        return 1;
    }
    CMD:daradmin(playerid, params[])
    {
        if (gPlayerLogged[playerid] == 0)
        {
            SendClientMessage(playerid, COR_GREY, "Voce nao esta logado!");
            return 1;
        }
        if (PlayerInfo[playerid][pAdmin] < 1)
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao tem autorizacao para usar esse comando.");
            return true;
        }
        else
        {
            if (PlayerInfo[playerid][pAdmin] >= 1342)
            {
                new para1;
                new level;
                if(sscanf(params, "ud", para1, level))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /daradmin [ id ] [Level 0 a 1342]");
                    return true;
                }
/*              VagaAdmins();
                if(VagasLivresAdm == 0)
                {
                    SendClientMessage(playerid, COR_GRAD1, "nao ha mais vagas na lista use /limparadmin primeiro.");
                    return 1;
                }
                if (level == 0)
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /limparadmin para limpar uma vaga");
                    return 1;
                }*/
                GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
                GetPlayerName(playerid, sendername, sizeof(sendername));
                if (IsPlayerConnected(para1))
                {
                    if (para1 != INVALID_PLAYER_ID)
                    {
                        if (PlayerInfo[para1][pAdmin] >= 1342)
                        {
                            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode promover um admin!");
                            /*format(stringZCMD, sizeof(stringZCMD), "O admin %s tentou te promover a nivel %d", sendername, level);
                            SendClientMessage(para1, COR_SONS, stringZCMD);*/
                            return 1;
                        }
                        if (PlayerInfo[playerid][pAdmin] == 1341)
                        {
                            if (level < 0 || level > 1338)
                            {
                                SendClientMessage(playerid, COR_GRAD1, "Voce so pode promover ate level 1337(Admin) por enquanto");
                                return 1;
                            }
                        }
                        format(stringZCMD, sizeof(stringZCMD), "Voce teve o level de admin promovido para %d, pelo admin: %s", level, sendername);
                        SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "   Voce promoveu o(a) %s para o level %d de Admin.", giveplayerZCMD, level);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        getdate(year, month, day);
                        gettime(hour, minute, second);
                        format(stringZCMD, sizeof(stringZCMD), "%s deu admin nivel %d para %s [%02d/%02d/%02d] as [%02d:%02d:%02d].", sendername, level, giveplayerZCMD, day, month, year, hour, minute, second);
                        PAdminsLog(stringZCMD);
                        PlayerInfo[para1][pAvaliacoes] += 1;
                        PlayerInfo[para1][pAFinal] += 10;
                        for (new i = 0; i < sizeof(AdmInfo); i++)
                        {
                            if (PlayerInfo[para1][pAdmin] > 0)
                            {
                                PlayerInfo[para1][pAdmin] = level;
                                break;
                            }
                            else if (AdmInfo[i][AdminVaga] == 0)
                            {
                                PlayerInfo[para1][pAdmin] = level;
                                AdmInfo[i][AdminNick] = giveplayerZCMD;
                                AdmInfo[i][AdminVaga] = 1;
                                SalvarAdmins();
                                break;
                            }
                        }
                    }
                }
            }
        }
        return 1;
    }
    CMD:fila(playerid, params[])  return ForT:atendimentodsda(playerid, params);
    CMD:atendimentodsda(playerid, params[])
    {
        if (PlayerInfo[playerid][pAdmin] < 1)
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao tem autorizacao para usar esse comando.");
            return true;
        }
        new lol = 0;
        MEGAString[0]=EOS;
        new prioridade[20];
        format(stringZCMD, sizeof(stringZCMD), "Jogador\tAssunto\tPrioridade\n");
        strcat(MEGAString, stringZCMD);
        while (lol < MAX_PLAYERS)
        {
            new arquivo[64];
            format(arquivo, sizeof(arquivo), Pasta_Relatorios,lol);
            if(DOF2_FileExists(arquivo))
            {
                new NomeFila[MAX_PLAYER_NAME];
                new AssuntoFila[64];
                strmid(NomeFila, DOF2_GetString(arquivo,"Jogador"), 0, strlen(DOF2_GetString(arquivo,"Jogador")), 255);
                strmid(AssuntoFila, DOF2_GetString(arquivo,"Assunto"), 0, strlen(DOF2_GetString(arquivo,"Assunto")), 255);
                DOF2_CreateFile(arquivo);
                DOF2_GetString(arquivo, "Jogador");
                DOF2_GetString(arquivo, "Assunto");
                if(DOF2_GetInt(arquivo, "Prioridade") == 2)
                {
                    prioridade = "{FF0000}ALTA";
                }
                else if(DOF2_GetInt(arquivo, "Prioridade") == 1)
                {
                    prioridade = "{00ffff}BAIXA";
                }
                format(stringZCMD, sizeof(stringZCMD), "%s[%d]\t%s\t%s\n", NomeFila,lol, AssuntoFila, prioridade);
                strcat(MEGAString, stringZCMD);
            }
            lol++;
        }
        ShowPlayerDialog(playerid, 5409, DIALOG_STYLE_TABLIST_HEADERS, "{FFFF00}Clique 2x para atender", MEGAString, "Atender","Cancelar");
        return true;
    }
