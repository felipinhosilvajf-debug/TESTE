             }
             return 1;
}


START::CarregarRegistro(playerid)
{
    if(ModoSavSis == true)
    {
        new DOF2[500];
        format(DOF2, sizeof(DOF2), "Contas/%s.ini", PlayerName(playerid));
        gPlayerAccount[playerid] = DOF2_GetInt(DOF2, "Registrado");
    }
    else if(ModoSavSis == false)
    {
        new DOF2[500];
        format(DOF2, sizeof(DOF2), "Players/%s.ini", PlayerName(playerid));
        gPlayerAccount[playerid] = DOF2_GetInt(DOF2, "Registrado");
        PlayerInfo[playerid][pSenha] = DOF2_GetInt(DOF2, "Senha");
        PlayerInfo[playerid][pMudouSenha] = DOF2_GetInt(DOF2, "MSenha");

    //  strmid(PlayerInfo[playerid][pAntiBug], DOF2_GetString(DOF2, "AntiBug"), 0, strlen(DOF2_GetString(DOF2, "AntiBug")), 255);

    }
    return 1;
}


