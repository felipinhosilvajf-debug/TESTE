                                format(string, sizeof(string), "Voce recebeu R$[8000] por manter esta area sobre controle.");
                                SendClientMessage(i, GetPlayerColor(i), string);
                                DepositarGranaOrg(GetPlayerOrg(i),GranadoPark);
                             }
                        }
                   }
              }
              if(PlayerInfo[i][pMembro] == 25 || PlayerInfo[i][pLider] == 25) //Policia Federal
              {
                   if(donoestacao == 3)
                   {
                        if(IsPlayerInEstacao(i))
                        {
                             if(BonusBPS == false)
                             {
                                GivePlayerMoneyEx(i, GranadaEstacao);
                                format(string, sizeof(string), "Voce recebeu R$[%d] por manter esta area sobre controle.",GranadaEstacao);
                                SendClientMessage(i, GetPlayerColor(i), string);
                                DepositarGranaOrg(GetPlayerOrg(i),GranadoPark);
                             }
                             else if(BonusBPS == true)
                             {
                                GivePlayerMoneyEx(i, 8000);
                                format(string, sizeof(string), "Voce recebeu R$[8000] por manter esta area sobre controle.");
                                SendClientMessage(i, GetPlayerColor(i), string);
                                DepositarGranaOrg(GetPlayerOrg(i),GranadoPark);
                             }
                        }
                   }
              }
         }
    }
    return 1;
}
