    CMD:v(playerid, result[])
    {
        if(IsPlayerConnected(playerid) && PlayerInfo[playerid][pVIP] >= 1)
        {
            if(ChatvSis == true)
            {
                if(PlayerInfo[playerid][pChatVipDesativado] == 0)
                {
                    GetPlayerName(playerid, sendername, sizeof(sendername));
                    if(isnull(result))
                        return SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /v [Chat Vip]");
                    if(GetTickCount() - TempoChatVip[playerid] < 3000 && PlayerInfo[playerid][pAdmin] == 0)
                    {
                        SendClientMessage(playerid,COR_GRAD1,"Voce so pode escrever uma mensagem a cada 3 segundos.");
                        return 1;
                    }
                    if(PlayerMutado[playerid] == 1)
                    {
                        SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao poder falar, Voce foi calado");
                        return 1;
                    }
                    if(Palavrao(result))
                    {
                        GivePlayerMoneyEx(playerid, -500);
                        SendClientMessage(playerid, COR_LIGHTRED, "e PROIBIDO XINGAR NO CHAT VIP,Voce PERDEU 500 REAIS !");
                        return 1;
                    }
                    if (PlayerInfo[playerid][pVIP] >= 1)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "** VIP %s: %s", sendername, result);
                        SendVIPMessage(COR_VIP, stringZCMD);
                        foreach(new i: Player)
                        {
                            if(IsPlayerConnected(i))
                            {
                                if(PlayerInfo[i][pVIP] == 0 && PlayerInfo[playerid][pSocio] == 0)
                                {
                                    SendClientMessage(i, COR_VIP,stringZCMD);
                                }
                            }
                        }
                        ChatVipLog(stringZCMD);
                        TempoChatVip[playerid] = GetTickCount();
                    }
                }
                else if(ChatVIP == false)
                {

                }
            }
            /*else
            {
                SendClientMessage(playerid, COR_GREY, "O Chat Vip esta desativado !");
                return 1;
            }*/
        }
        return 1;
    }
