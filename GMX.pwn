    CMD:revistar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(!IsACop(playerid))
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um Oficial!");
                return 1;
            }
            if(OnDuty[playerid] != 1 && GetPlayerOrg(playerid) != 7)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao Bateu o cartao!");
                return 1;
            }
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /revistar [id]");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if (ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se Revistar!"); return 1; }
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        new text1[20], text2[20], text3[20], text4[20], text5[20], text6[20];
                        text1 = "| Vazio.";
                        text2 = "| Vazio.";
                        text3 = "| Vazio.";
                        text4 = "| Vazio.";
                        new ContarMaconha, ContarCrack, ContarCoca, ContarLSD;
                        for(new i=0; i<75; i++)
                        {
                            if(InventarioInfo[sscanfid][i][iSlot] == 1578)
                            {
                                text1 = "| Maconha.";
                                ContarMaconha++;
                            }
                            if(InventarioInfo[sscanfid][i][iSlot] == 1279)
                            {
                                text2 = "| Cocaina.";
                                ContarCoca++;
                            }
                            if(InventarioInfo[sscanfid][i][iSlot] == 1575)
                            {
                                text3 = "| Crack.";
                                ContarCrack++;
                            }
                            if(InventarioInfo[sscanfid][i][iSlot] == 1576)
                            {
                                text4 = "| Lsd.";
                                ContarLSD++;
                            }
                        }
                        if(PlayerInfo[sscanfid][pMats] > 0) { text5 = "| Materiais."; } else { text5 = "| Vazio."; }
                        if(PlayerInfo[sscanfid][pAgendaT] > 0) { text6 = "| Lista Telefonica."; } else { text6 = "| Vazio."; }
                        format(stringZCMD, sizeof(stringZCMD), "|__________ Itens %s __________|", giveplayerZCMD);
                        SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text1, ContarMaconha);
                        SendClientMessage(playerid, COR_GREY, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text2, ContarCoca);
                        SendClientMessage(playerid, COR_GREY, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text3, ContarCrack);
                        SendClientMessage(playerid, COR_GREY, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text4, ContarLSD);
                        SendClientMessage(playerid, COR_GREY, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "%s [Quantidade: %d].", text5, PlayerInfo[sscanfid][pMats]);
                        SendClientMessage(playerid, COR_GREY, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "%s.", text6);
                        SendClientMessage(playerid, COR_GREY, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* %s revistou %s para ver se tem qualquer item ilegal.", sendername ,giveplayerZCMD);
                        ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "O Jogador esta longe de Voce !");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "O Jogador esta Offline !");
                return 1;
            }
        }
        return 1;
    }
    CMD:presos(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            SendClientMessage(playerid, 0xf5deb3FF, "PRESOS:");
            foreach(new i: Player)
            {
                if(IsPlayerConnected(i))
                {
                    if(PlayerInfo[i][pJailed] == 1)
                    {
                        GetPlayerName(i, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "ID: %d Preso: %s Local: Penitenciaria LS - Tempo: %d seg.", i, sendername, PlayerInfo[i][pJailTime]);
                        SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                    }
                    if(PlayerInfo[playerid][pAdmin] > 0)
                    {
                        if(PlayerInfo[i][pJailed] == 2)
                        {
                            GetPlayerName(i, sendername, sizeof(sendername));
                            format(stringZCMD, sizeof(stringZCMD), "ID: %d Preso: %s Local: Carandiru Tempo: %d seg.", i, sendername, PlayerInfo[i][pJailTime]);
                            SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                        }
                        if(PlayerInfo[i][pJailed] == 3)
                        {
                            GetPlayerName(i, sendername, sizeof(sendername));
                            format(stringZCMD, sizeof(stringZCMD), "ID : %d Preso: %s Local: Cela Admin Tempo: %d seg.", i, sendername, PlayerInfo[i][pJailTime]);
                            SendClientMessage(playerid, COR_GRAD2, stringZCMD);
                        }
                    }
                }
            }
        }
        return 1;
    }
    CMD:procurados(playerid, params[])
    {
        if(IsPlayerConnected(playerid) )
        {
            if(!IsACop(playerid) && PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um Oficial/Administrador!");
                return 1;
            }
            if(OnDuty[playerid] != 1 && GetPlayerOrg(playerid) != 7 && PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao Bateu o cartao!");
                return 1;
            }
            new x;
            new string[128];
            SendClientMessage(playerid, COR_GREEN, "Suspeitos:");
            foreach(new i: Player)
            {
                if(IsPlayerConnected(i))
                {
                    if(WantedLevel[i] > 0)
                    {
                        GetPlayerName(i, giveplayerZCMD, sizeof(giveplayerZCMD));
                        format(string, sizeof(string), "%s%s(%d): %d", string,giveplayerZCMD,i,WantedLevel[i]);
                        x++;
                        if(x > 3)
                        {
                            SendClientMessage(playerid, COR_AMARELO, string);
                            x = 0;
                            format(string, sizeof(string), "");
                        }
                        else
                        {
                            format(string, sizeof(string), "%s, ", string);
                        }
                    }
                }
            }
            if(x <= 3 && x > 0)
            {
                string[strlen(string)-2] = '.';
                SendClientMessage(playerid, COR_AMARELO, string);
            }
        }//not connected
        return 1;
    }
    CMD:sairdoemprego(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            tempocolheita[playerid] = 0;
            KillTimer(colheitapickup[playerid]);
            if(PlayerInfo[playerid][pEmprego] > 0)
            {
                if(GetPlayerInterior(playerid) > 0)
                {
                    rouboucarro[playerid] = 0;
                    tempocolheita[playerid] = 0;
                    StopPlayerHoldingObject(playerid);
                    if(PlayerInfo[playerid][pVIP] > 0)
                    {
                        if(PlayerInfo[playerid][pContractTime] >= 0)
                        {
                            TransportDuty[playerid] = 0;
                            ConsumingMoney[playerid] = 1; TransportValue[playerid] = 0; TransportMoney[playerid] = 0;
                            SendClientMessage(playerid, COR_LIGHTBLUE, "Voce saiu do seu emprego!");
                            PlayerInfo[playerid][pEmprego] = 0;
                            PlayerInfo[playerid][pContractTime] = 0;
                            ResetPlayerWeaponsEx(playerid);
                            OnPlayerSave(playerid);
                            SalvarDados(playerid);
                        }
                    }
                    else
                    {
                        if(PlayerInfo[playerid][pContractTime] >= 0)
                        {
                            TransportDuty[playerid] = 0;
                            ConsumingMoney[playerid] = 1; TransportValue[playerid] = 0; TransportMoney[playerid] = 0;
                            SendClientMessage(playerid, COR_LIGHTBLUE, "Voce saiu do seu emprego!");
                            PlayerInfo[playerid][pEmprego] = 0;
                            PlayerInfo[playerid][pContractTime] = 0;
                            ResetPlayerWeaponsEx(playerid);
                            OnPlayerSave(playerid);
                            SalvarDados(playerid);
                        }
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_AMARELO, "Voce precisa estar dentro de um interior para usar este comando!");
                }
            }
            else
            {
                SendClientMessage(playerid, COR_VAGOS, "Voce nao esta em nenhum emprego!");
            }
        }//not connected
        return 1;
    }
    CMD:limpar(playerid, params[])  return ForT:limparficha(playerid, params);
    CMD:limparficha(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new result[64];
            if(sscanf(params, "us[64]", sscanfid, result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /limparficha [id] [Motivo]");
                return 1;
            }
            if(IsACop(playerid))
            {
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        if(OnDuty[playerid] != 1) { return SendClientMessage(playerid, COR_GREY, "Voce nao Bateu o cartao !"); }
                        if(sscanfid == playerid) { return SendClientMessage(playerid, COR_GREY, "Voce nao pode limpar sua propria ficha !"); }
                        if(!IsACop(playerid)) { return SendClientMessage(playerid, COR_GREY, "Voce nao e um policial !"); }
                        if(PlayerInfo[playerid][pCargo] < 4) { return SendClientMessage(playerid, COR_GREY, "Voce precisa ser cargo 4+ para poder limpar fichas !"); }
                        if(DeslogandoSocio[playerid] == 1) { return SendClientMessage(playerid, COR_GREY, "Voce nao pode limpar ficha tendo usado o comando /entrarorg."); }
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce limpou a ficha de %s.", giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* Oficial %s limpou sua ficha.", sendername);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* Oficial %s limpou a ficha de: %s,Motivo: %s.",PlayerName(playerid),giveplayerZCMD,(result));
                        SendFamilyMessage(1, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(2, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(3, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(11, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(16, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(23, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(25, COR_LIGHTBLUE, stringZCMD);
                        WantedLevel[sscanfid] = 0;
                        SetPlayerChatBubble(sscanfid, "*", COR_VERMELHO, 1, 1);
                        SetPlayerWantedLevelEx(sscanfid, 0);
                        ClearCrime(sscanfid);
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "ID/Nick! Invalido");
                }
            }

        }//not connected
        return 1;
    }
    CMD:limparcrime(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new result[64];
            if(sscanf(params, "us[64]", sscanfid, result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /limparcrime [id] [Motivo]");
                return 1;
            }
            if(DeslogandoSocio[playerid] == 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce entrou como socio na org, nao pode limpar crimes !");
                return 1;
            }
            if(IsACop(playerid))
            {
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        if(PlayerToPoint(2, playerid,252.5212,69.6307,1003.6406) || PlayerToPoint(2,playerid,255.0129,76.0857,1003.6406) || PlayerToPoint(2,playerid,240.6702,112.7933,1003.2188) || PlayerToPoint(2, playerid,302.6840,-1529.6685,24.9219) || PlayerToPoint(2, playerid,2688.4722,-2443.8438,13.4729) || PlayerToPoint(2, playerid,326.4964,306.9705,999.1484) || PlayerToPoint(1, playerid,914.5157,-1235.1240,17.2109)
                        || PlayerToPoint(2, playerid,229.7716,165.0986,1003.0234) || PlayerToPoint(2, playerid,1709.7360,-1642.6481,20.2188) || PlayerToPoint(2, playerid,2497.8533,2389.3938,4.2109) || PlayerToPoint(2, playerid,2080.9387,-1376.1432,300.5588) || PlayerToPoint(2, playerid,2251.4067,2490.9138,10.9908))
                        {
                            if(OnDuty[playerid] != 1) { SendClientMessage(playerid, COR_GREY, "Voce nao Bateu o cartao !"); return 1; }
                            if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode limpar seu proprio crime !"); return 1; }
                            if(!IsACop(playerid)) { SendClientMessage(playerid, COR_GREY, "Voce nao e um Oficial !"); return 1; }
                            if(PlayerInfo[playerid][pCargo] < 3) { SendClientMessage(playerid, COR_GREY, "Voce precisa ser cargo 3+ para poder limpar fichas !"); return 1; }
                            if(WantedLevel[sscanfid] == 0) { SendClientMessage(playerid, COR_GREY, "Este jogador nao esta procurado !"); return 1; }
                            if(DeslogandoSocio[playerid] == 1) { SendClientMessage(playerid, COR_GRAD1, "Voce entrou como socio na org, nao pode limpar crimes !"); return 1;}
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            GetPlayerName(playerid, sendername, sizeof(sendername));
                            format(stringZCMD, sizeof(stringZCMD), "* Voce limpou um crime de %s,  Motivo: %s.", giveplayerZCMD,(result));
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "* Oficial %s um crime seu, Motivo: %s.", sendername,(result));
                            SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "* Oficial %s limpou um crime de: %s,Motivo: %s",PlayerName(playerid),giveplayerZCMD,(result));
                            SendFamilyMessage(1, COR_LIGHTBLUE, stringZCMD);
                            SendFamilyMessage(2, COR_LIGHTBLUE, stringZCMD);
                            SendFamilyMessage(3, COR_LIGHTBLUE, stringZCMD);
                            SendFamilyMessage(11, COR_LIGHTBLUE, stringZCMD);
                            SendFamilyMessage(16, COR_LIGHTBLUE, stringZCMD);
                            SendFamilyMessage(23, COR_LIGHTBLUE, stringZCMD);
                            SendFamilyMessage(25, COR_LIGHTBLUE, stringZCMD);
                            if(WantedLevel[sscanfid] == 1)
                            {
                                WantedLevel[sscanfid] = 0;
                                return 1;
                            }
                            WantedLevel[sscanfid] -= 1;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_GRAD1, "Voce nao esta em um icone de equipamento dos cops!");
                            return 1;
                        }
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "ID/Nick! Invalido");
                }
            }

        }//not connected
        return 1;
    }
    CMD:multar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(!IsACop(playerid) && GetPlayerOrg(playerid) != 7)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um Oficial da Justica !");
                return 1;
            }
            if(OnDuty[playerid] != 1 && GetPlayerOrg(playerid) != 7 || CartaoBatidoDetran[playerid] == false)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao Bateu o cartao!");
                return 1;
            }
            new result[64];
            if(sscanf(params, "us[64]", sscanfid, result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /multar [ID] [Multa]");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(OnDuty[sscanfid] != 0)
                {
                    SendClientMessage(playerid, COR_GRAD1, "Voce nao pode multar Policiais!");
                    return 1;
                }
                if(PlayerInfo[sscanfid][pJailed] > 0)
                {
                    SendClientMessage(playerid, COR_GRAD1, "Voce nao pode multar jogadores que estejam presos!");
                    return 1;
                }
                if(GetPlayerState(sscanfid) != PLAYER_STATE_DRIVER)
                {
                    SendClientMessage(playerid, -1, "Este jogador nao esta dirigindo um veiculo!");
                    return 1;
                }
                if(PlayerInfo[sscanfid][pConnectTime] <  5)
                {
                    SendClientMessage(playerid, COR_GRAD1, "Voce nao pode multar jogadores com menos de 5 horas de jogadas !");
                    return 1;
                }
                if(GetTickCount() - TempoMulta[sscanfid] < 4000)
                {
                    SendClientMessage(playerid, COR_GRAD5, "Usaram este comando a pouco tempo,aguarde um pouco !");
                    return 1;
                }
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if (ProxDetectorS(25.0, playerid, sscanfid))
                    {
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        if(!MultasServidor(result))
                        {
                            SendClientMessage(playerid, COR_LIGHTRED, "Esta multa que Voce digitou nao existe, digite /multas para ver as multas existentes!");
                            return 1;
                        }
                        if(sscanfid == playerid)
                        {
                            SendClientMessage(playerid, COR_GREY, "Voce nao pode se multar!");
                            return 1;
                        }
                        if(strcmp(result,"CM",true) == 0) { result = "Dirigindo na Contra-Mao"; MultadoCM[sscanfid] = 1; }
                        if(strcmp(result,"DB",true) == 0) { result = "Dirigindo Embreagado"; MultadoDB[sscanfid] = 1; }
                        if(strcmp(result,"DP",true) == 0) { result = "Direcao Perigosa"; MultadoDP[sscanfid] = 1; }
                        if(strcmp(result,"EI",true) == 0) { result = "Estacionamento Indevido"; MultadoEI[sscanfid] = 1; }
                        if(strcmp(result,"FD",true) == 0) { result = "Farol Desligado"; MultadoFD[sscanfid] = 1; }
                        if(strcmp(result,"VD",true) == 0) { result = "Veiculo Danificado"; MultadoVD[sscanfid] = 1; }
                        if(strcmp(result,"TNC",true) == 0) { result = "Trafegando na Calcada"; MultadoTNC[sscanfid] = 1; }
                        //talvez colocar aki as variavels do setamento dos valores das multas.
                        format(stringZCMD, sizeof(stringZCMD), "[MULTAS] %s multou %s por R$[%d], Razao:[%s] Speed:[%d]", PlayerName(playerid), giveplayerZCMD, moneysZCMD, (result), GetPlayerSpeed(sscanfid, true));
                        SendFamilyMessage(1, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(2, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(3, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(7, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(12, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(13, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(17, COR_LIGHTBLUE, stringZCMD);
                        SendFamilyMessage(25, COR_LIGHTBLUE, stringZCMD);
                        PMA++;
                        format(stringZCMD, sizeof(stringZCMD), "* Voce multou %s por R$[%d], Razao:[%s]", giveplayerZCMD, moneysZCMD, (result));
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "Oficial %s lhe multou no valor R$[%d], Razao:[%s] Speed:[%d], +2 Pontos !", PlayerName(playerid), moneysZCMD, (result), GetPlayerSpeed(sscanfid, true));
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        SendClientMessage(sscanfid, COR_VERMELHO, "* Use /aceitar multa, para aceita-la, pague em 5 minutos ou ficara procurado(OBS: se deslogar vai preso).");
                        GameTextForPlayer(sscanfid,"~r~MULTADO !", 5000, 1);
                        TicketOffer[sscanfid] = playerid;
                        TicketMoney[sscanfid] = moneysZCMD;
                        DeslogandoMulta[sscanfid] = 1;
                        SetTimerEx("PresoMulta", 300000, false, "i", sscanfid);
                        PlayerInfo[playerid][pMultas] ++;
                        TempoMulta[sscanfid] = GetTickCount();
                        return 1;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "O jogador esta longe !");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "O jogador esta Offline !");
                return 1;
            }
        }
        return 1;
    }
    CMD:incendiar(playerid, params[])  return ForT:in(playerid, params);
    CMD:in(playerid, params[])
    {
        if(IsAGangster(playerid) || GetPlayerOrg(playerid) == 8 || GetPlayerOrg(playerid) == 6 || GetPlayerOrg(playerid) == 16 || GetPlayerOrg(playerid) == 30)
        {
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_GRAD5,"Voce nao pode criar incendios neste local !");
                return 1;
            }
            new carid = GetPlayerVehicleID(playerid);
            if(IsAAviao(carid))
            {
                SendClientMessage(playerid, COR_GRAD5, "Voce nao pode usar este comando dentro de uma aeronave !");
                return 1;
            }
            if(IsPlayerInAnyVehicle(playerid))
            {
                SendClientMessage(playerid, COR_GRAD5, "Voce nao pode usar este comando dentro de um veiculo !");
                return 1;
            }
            if(IsPlayerInWater(playerid))
            {
                SendClientMessage(playerid, COR_GRAD5, "Voce nao pode usar este comando na agua !");
                return 1;
            }
            if(GetPlayerInterior(playerid) > 0)
            {
                SendClientMessage(playerid,COR_GRAD5,"Voce nao pode usar este comando em interiores !");
                return 1;
            }
            if(PlayerToPoint(20.0,playerid,2034.3182,-1300.1826,20.9183) || PlayerToPoint(20.0,playerid,-76.4639,-1130.5845,1.0781) || PlayerToPoint(20.0,playerid,1790.4182,-2363.9722,13.5455) || PlayerToPoint(20.0,playerid,1685.8202,-2239.2795,-2.6701) || PlayerToPoint(20.0,playerid,592.4020,-1508.6193,15.2718) || PlayerToPoint(20.0,playerid,218.5479,69.4251,1005.0391) || PlayerToPoint(20.0,playerid,592.4020,-1508.6193,15.2718)
            || PlayerToPoint(20.0,playerid,218.5479,69.4251,1005.0391)
            || PlayerToPoint(20.0,playerid,240.7362,112.7886,1003.2188)
            || PlayerToPoint(20.0,playerid,-1346.9358,492.0078,11.2027)
            || PlayerToPoint(20.0,playerid,2034.5068,-1402.1460,17.2980) || PlayerToPoint(20.0,playerid,2817.3291,-1167.0033,1029.1719) || PlayerToPoint(20.0,playerid,248.4990,302.1800,999.1484) || PlayerToPoint(20.0,playerid,354.8267,154.4102,1025.7964) || PlayerToPoint(20.0,playerid,2338.2690,-1272.4103,22.5080) || PlayerToPoint(20.0,playerid,735.3049,-1350.8284,13.5000) || PlayerToPoint(20.0,playerid,2495.3083,-1690.5221,14.7656)
            || PlayerToPoint(20.0,playerid,2451.5259,-1686.4034,1013.5078)
            || PlayerToPoint(20.0,playerid,918.6924,-1253.7435,120.0351)
            || PlayerToPoint(20.0,playerid,2260.7551,-1222.4244,1049.0234)
            || PlayerToPoint(20.0,playerid,2808.3562,-1176.4606,25.3687)|| PlayerToPoint(20.0,playerid,-2160.4102,638.5344,1057.5861) || PlayerToPoint(20.0,playerid,-2648.0791,1397.2968,906.4609) || PlayerToPoint(20.0,playerid,-515.8712,-539.2990,25.5234) || PlayerToPoint(20.0,playerid,2319.5225,-1211.7998,1049.0234) || PlayerToPoint(20.0,playerid,-2221.9097,134.4590,1035.6328) || PlayerToPoint(20.0,playerid,508.7702,-87.8531,998.9683)
            || PlayerToPoint(20.0,playerid,-223.2280,1396.1266,28.3595)
            || PlayerToPoint(20.0,playerid,1712.2338,-1640.0950,20.2239)
            || PlayerToPoint(20.0,playerid,1031.0197,-1442.5164,13.5546)
            || PlayerToPoint(20.0,playerid,1685.8202,-2239.2795,-2.6701))
            {
                SendClientMessage(playerid,COR_GRAD5,"Voce nao pode criar incendios neste local !");
                return 1;
            }
            if(PlayerInfo[playerid][pJailed] == 1 || PlayerInfo[playerid][pJailed] == 2 || PlayerInfo[playerid][pJailed] == 3 || PlayerInfo[playerid][pJailed] == 4) return SendClientMessage(playerid, COR_VERMELHO, "[VBR] Voce nao pode usar esse comando na prisao.");
            if(IncendioAcontecendo == true) return SendClientMessage(playerid, COR_AMARELO, "[ERRO] Alguem ja incendiou algum lugar !");
            SendClientMessage(playerid, COR_AMARELO, "[AVISO] O Local a sua frente pegara fogo em 10 segundos, saia de perto !");
            new location[MAX_ZONE_NAME];
            GetPlayer2DZone(playerid, location, MAX_ZONE_NAME);
            new Float:PlayerX, Float:PlayerY, Float:PlayerZ;
            GetPlayerPos(playerid,PlayerX,PlayerY,PlayerZ);
            FogoX[0]=PlayerX+-1.9826;   FogoY[0]=PlayerY+-1.5052;   FogoZ[0]=PlayerZ-2;
            FogoX[1]=PlayerX+-1.9816;   FogoY[1]=PlayerY+-0.1017;   FogoZ[1]=PlayerZ-2;
            FogoX[2]=PlayerX+-3.2436;   FogoY[2]=PlayerY+-1.5876;   FogoZ[2]=PlayerZ-2;
            FogoX[3]=PlayerX+-1.9826;   FogoY[3]=PlayerY+-1.5052;   FogoZ[3]=PlayerZ-2;
            FogoX[4]=PlayerX+-1.7868;   FogoY[4]=PlayerY+-2.4806;   FogoZ[4]=PlayerZ-2;
            FogoX[5]=PlayerX+-1.1713;   FogoY[5]=PlayerY+-0.6008;   FogoZ[5]=PlayerZ-2;
            FogoX[6]=PlayerX+-2.4602;   FogoY[6]=PlayerY+0.0455;    FogoZ[6]=PlayerZ-2;
            FogoX[7]=PlayerX+-2.7717;   FogoY[7]=PlayerY+-0.6095;   FogoZ[7]=PlayerZ-2;
            FogoX[8]=PlayerX+-2.4602;   FogoY[8]=PlayerY+0.0455;    FogoZ[8]=PlayerZ-2;
            IncendioAcontecendo = true;
            SetTimerEx("Incendio", 10000, false, "i", playerid);
            PlayerInfo[playerid][pIncendio] += 1;
            return 1;

        }
        else
        {
            SendClientMessage(playerid, COR_GREY,"Voce nao tem autorizacao para usar esse comando !");
            return 1;
        }
    }
    CMD:localincendio(playerid, params[])
    {
        if(PlayerInfo[playerid][pLider] == 4 || PlayerInfo[playerid][pMembro] == 4)
        {
            if(IncendioAcontecendo != true) return SendClientMessage(playerid, COR_AMARELO, "[ERRO] nao esta acontecendo nenhum incendio !");
            new Float:PlayerX, Float:PlayerY, Float:PlayerZ, Float:PlayerA;
            GetPlayerPos(playerid,PlayerX,PlayerY,PlayerZ);
            GetPlayerFacingAngle(playerid, PlayerA);
            SetPlayerCheckpoint(playerid, FogoX[1],FogoY[1],FogoZ[1],8.0);
            SendClientMessage(playerid, COR_VAGOS, "[VBR]: Incendio encontrado, siga o checkpoint !");
            SendClientMessage(playerid, COR_VAGOS, "[VBR]: Para apagar o fogo Voce precisa de um caminhao de agua ou extintor!.");
            return 1;
        }
        else
        {
            SendClientMessage(playerid, COR_GREY,"Voce nao e dos SA:MU.");
            return 1;
        }
    }
    CMD:destruirneon(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1339)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando !");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            foreach(new i: Player)
            {
                if(IsPlayerConnected(i))
                {
                    DestroyDynamicObject(GetPVarInt(i, "neon"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon1"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon2"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon3"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon4"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon5"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon6"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon7"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon8"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon9"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon10"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon11"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon12"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "neon13"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "interior"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "interior1"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "back"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "back1"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "front"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "front1"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "undercover"));
                    DeletePVar(i, "Status");
                    DestroyDynamicObject(GetPVarInt(i, "undercover1"));
                    DeletePVar(i, "Status");
                    NeonCarro[i] = 0;
                    GetPlayerName(i,playernameZCMD,sizeof(playernameZCMD));
                    format(stringZCMD,sizeof(stringZCMD),"ADMIN CMD: %s Retirou todos Neon dos Veiculos Vips!",PlayerName(playerid));
                    SendClientMessage(i,COR_LIGHTRED,stringZCMD);
                }
            }
        }
