            Limpar Manutencao de Hidreletricas\n\
            Limpar Manutencao de Encanamentos\n\
            Limpar Reparo de Estradas\n\
            Limpar Conserto de Estragos\n\
            Limpar Dinheiro Usado\n", #Selecionar, #Voltar);
            return true;
    }
    CMD:limparvaga(playerid, vaga[])
    {
        if(PlayerInfo[playerid][pLider] < 1)
        {
            SendClientMessage(playerid, COR_GRAD2, "Somente lideres podem usar este comando!");
            return true;
        }
        if(sscanf(vaga, "s[24]", vaga))
        {
            SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /limparvaga [Vaga]");
            return true;
        }
        new Vaga2 = strval(vaga);
        new org = GetPlayerOrg(playerid);
        new arquivo[128], id;
