    CMD:3(playerid, params[])
    {
        if (PlayerInfo[playerid][pAdmin] >= 2)
        {
            GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
            format(stringZCMD, sizeof(stringZCMD), "~p~| ~y~3 ~p~|");
            GameTextForAll(stringZCMD, 1000, 5);
        }
        return 1;
    }
    CMD:go(playerid, params[])
    {
        if (PlayerInfo[playerid][pAdmin] >= 2)
        {
            GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
            format(stringZCMD, sizeof(stringZCMD), "~p~| ~g~Go Go Go ~p~|");
            GameTextForAll(stringZCMD, 1000, 5);
        }
        return 1;
    }



	CMD:minhaslicencas(playerid, params[])
	{
		if(!IsPlayerConnected(playerid))
			return 1;

		new Str[1800];

		strcat(Str, "{00D9FF}VIRTUAL BOOST {FFFFFF}| {00D9FF}MINHAS LICENCAS\n");
		strcat(Str, "{818689}Confira abaixo a situacao das suas habilitacoes:\n\n");

		if(PlayerInfo[playerid][pCarLic] == 1)
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Motorista: {00FF00}Habilitado {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeCarro]);
		}
		else
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Motorista: {FFCC99}Sem permissao {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeCarro]);
		}
		strcat(Str, stringZCMD);
		strcat(Str, "\n");

		if(PlayerInfo[playerid][pMotoLic] == 1)
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Motocicleta: {00FF00}Habilitado {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeMoto]);
		}
		else
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Motocicleta: {FFCC99}Sem permissao {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeMoto]);
		}
		strcat(Str, stringZCMD);
		strcat(Str, "\n");

		if(PlayerInfo[playerid][pCamOniLic] == 1)
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Caminhao/Onibus: {00FF00}Habilitado {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeOnibus]);
		}
		else
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Caminhao/Onibus: {FFCC99}Sem permissao {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeOnibus]);
		}
		strcat(Str, stringZCMD);
		strcat(Str, "\n");

		if(PlayerInfo[playerid][pFlyLic] == 1)
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Aerea: {00FF00}Habilitado {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeAviao]);
		}
		else
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Aerea: {FFCC99}Sem permissao {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeAviao]);
		}
		strcat(Str, stringZCMD);
		strcat(Str, "\n");

		if(PlayerInfo[playerid][pBoatLic] == 1)
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Navegacao: {00FF00}Habilitado {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeBarco]);
		}
		else
		{
			format(stringZCMD, sizeof(stringZCMD), "{00D9FF}* {FFFFFF}Navegacao: {FFCC99}Sem permissao {818689}| Validade: {FFFFFF}%d", PlayerInfo[playerid][pValidadeBarco]);
		}
		strcat(Str, stringZCMD);
		strcat(Str, "\n");

		if(PlayerInfo[playerid][pGunLic] == 1)
		{
			strcat(Str, "{00D9FF}* {FFFFFF}Porte de Armas: {00FF00}Habilitado\n");
		}
		else
		{
			strcat(Str, "{00D9FF}* {FFFFFF}Porte de Armas: {FFCC99}Sem permissao\n");
		}

		strcat(Str, "\n{fa4c4c}OBSERVACAO:\n");
		strcat(Str, "{818689}A cada PayDay, um ponto sera descontado de cada licenca.\n");
		strcat(Str, "{818689}Quando a validade chegar a zero, sera necessario renovar a habilitacao.");

		ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX, "{00D9FF}Minhas Licencas", Str, "Fechar", "");

		return 1;
	}
    CMD:mostrarlicencas(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /mostrarlicencas [ id ]");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(AdminTrabalhando[sscanfid] > 0)
                    {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode mostrar licencas para admins em modo trabalho !");
                        return 1;
                    }
                    if (ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Para ver suas licencas Use: /minhaslicencas!"); return 1; }
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "|________________________________ Licencas Do:%s ________________________________|", PlayerName(playerid));
                        SendClientMessage(sscanfid, COR_BRANCO, stringZCMD);
                        if(PlayerInfo[playerid][pCarLic] == 1)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Carro: Positivo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        else
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Carro: Negativo.", PlayerInfo[playerid]);
                            SendClientMessage(playerid, COR_GREY, stringZCMD);
                        }
                        if(PlayerInfo[playerid][pMotoLic] == 1)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Moto: Positivo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        else
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Moto: Negativo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        if(PlayerInfo[playerid][pCamOniLic] == 1)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Caminhao/onibus: Positivo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        else
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Caminhao/onibus: Negativo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        if(PlayerInfo[playerid][pFlyLic] == 1)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Aerea: Positivo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        else
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Aerea: Negativo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        if(PlayerInfo[playerid][pBoatLic] == 1)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Navegacao: Positivo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        else
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Navegacao: Negativo.", PlayerInfo[playerid]);
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        if(PlayerInfo[playerid][pGunLic] == 1)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Armas: Positivo.");
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        else
                        {
                            format(stringZCMD, sizeof(stringZCMD), "** Armas: Negativo.");
                            SendClientMessage(sscanfid, COR_GREY, stringZCMD);
                        }
                        SendClientMessage(sscanfid, COR_BRANCO, "|___________________________________________________________________________|");
                        format(stringZCMD, sizeof(stringZCMD), "* %s mostrou as licencas para Voce.", sendername);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* Voce mostrou suas licencas para %s.", giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "O Jogador esta longe de Voce !");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "O Jogador esta offline !");
                return 1;
            }
        }
        return 1;
    }
    CMD:mostrarmoedas(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /mostrarmoedas [ id ]");
                return 1;
            }
            if(AdminTrabalhando[sscanfid] > 0)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao pode mostrar nada para um admin em modo trabalho !");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {

                    if (ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(PlayerInfo[playerid][pCoins] == 0)
                        {
                            SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao possui Moedas para mostrar !");
                            return 1;
                        }
                        if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Para ver suas Moedas, use /rg!"); return 1; }
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        {
                            format(stringZCMD, sizeof(stringZCMD), "[Moedas] %s mostrou para Voce que possui: [%d Moedas]",sendername,PlayerInfo[sscanfid][pCoins]);
                            SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "* Voce mostrou suas Moedas para %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        }

                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "O Jogador esta longe de Voce !");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "O Jogador esta offline !");
                return 1;
            }
        }
        return 1;
    }
    CMD:armamentos(playerid, params[])
    {
        if(PlayerToPoint(1.0, playerid,217.2318,1251.1764,1082.1481) || PlayerToPoint(1.0, playerid,2263.2544,-1133.3362,1050.6328) || PlayerToPoint(1.0, playerid,20.0156,1416.0397,1084.4297))
        {
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(PlayerInfo[playerid][pMembro] == 16 || PlayerInfo[playerid][pLider] == 16 || PlayerInfo[playerid][pMembro] == 6 || PlayerInfo[playerid][pLider] == 6)//tr
            {
                if(PlayerInfo[playerid][pGunLic] == 0)
                {
                    SendClientMessage(playerid, COR_GRAD1, "Voce nao possui a licenca de armas, compre no Centro de Licencas.");
                    return 1;
                }
                if(Equipado[playerid] == 1)
                {
                    ResetPlayerWeapons(playerid);
                    SetTimerEx("ResetPlayerWeapons", 1000, 0, "i", playerid);
                    Equipado[playerid] = 0;
                    return 1;
                }
                if (PlayerInfo[playerid][pLider] == 16 || PlayerInfo[playerid][pMembro] == 16 || PlayerInfo[playerid][pLider] == 6 || PlayerInfo[playerid][pMembro] == 6) //tr
                {
                    if (PlayerInfo[playerid][pCargo] == 1)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "* %s %s pegou seus equipamentos de cargo 1.",NomeORG(playerid), sendername);
                        ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        ResetPlayerWeaponsEx(playerid);
                        GivePlayerWeaponEx(playerid, 24, 100); //granadas
                        GivePlayerWeaponEx(playerid, 30, 150); //Mp4
                        GivePlayerWeaponEx(playerid, 29, 150); //Mp5
                        GivePlayerWeaponEx(playerid, 35, 1); //12
                        GivePlayerWeaponEx(playerid, 16, 4); //eagle
                        GivePlayerWeaponEx(playerid, 35, 1); //eagle
                        SetPlayerArmour(playerid, 100);
                        SetPlayerHealth(playerid, 100);
                        Equipado[playerid] = 1;
                        return 1;
                    }
                    if (PlayerInfo[playerid][pCargo] == 2)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "* %s %s pegou seus equipamentos de cargo 2.",NomeORG(playerid), sendername);
                        ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        ResetPlayerWeaponsEx(playerid);
                        GivePlayerWeaponEx(playerid, 24, 100); //granadas
                        GivePlayerWeaponEx(playerid, 30, 150); //Mp4
                        GivePlayerWeaponEx(playerid, 29, 150); //Mp5
                        GivePlayerWeaponEx(playerid, 35, 1); //12
                        GivePlayerWeaponEx(playerid, 16, 4); //eagle
                        GivePlayerWeaponEx(playerid, 35, 1); //eagle
                        SetPlayerArmour(playerid, 100);
                        SetPlayerHealth(playerid, 100);
                        Equipado[playerid] = 1;
                        return 1;
                    }
