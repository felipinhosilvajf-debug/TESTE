                          if(GetPlayerOrg(killerid) == 17)
                          {
                               if(GetPlayerOrg(i) == 17)
                               {
                                   format(gstring, sizeof(gstring), "~w~Suspeito ~r~Morto~n~ Bonus~g~R$%d", price);
                                   GameTextForPlayer(i, gstring, 5000, 1);
                                   ConsumingMoney[i] = 1;
                                   GivePlayerMoneyEx(i, price/2);
                                   PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
                               }
                          }
                          if(GetPlayerOrg(killerid) == 25)
                          {
                               if(GetPlayerOrg(i) == 25)
                               {
                                   format(gstring, sizeof(gstring), "~w~Suspeito ~r~Morto~n~ Bonus~g~R$%d", price);
                                   GameTextForPlayer(i, gstring, 5000, 1);
                                   ConsumingMoney[i] = 1;
                                   GivePlayerMoneyEx(i, price/2);
                                   PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
                               }
                          }
                          if(PlayerInfo[killerid][pEmprego] == 7)
                          {
                               format(gstring, sizeof(gstring), "~w~Suspeito ~r~Morto~n~ Bonus~g~R$%d", price);
                               GameTextForPlayer(killerid, gstring, 5000, 1);
                               ConsumingMoney[killerid] = 1;
                               GivePlayerMoneyEx(killerid, price/2);
                               PlayerPlaySound(killerid, 1058, 0.0, 0.0, 0.0);
                          }
                     }
                }
                if(ProcuraOffer[killerid] == playerid)
                {
                    ProcuraOffer[killerid] = 999;
                    format(gstring, sizeof(gstring), "[Procurando] %s[%d] que Voce estava procurado foi preso, para cancelar a busca, use /procuraroff.", PlayerName(playerid), playerid);
                    SendClientMessage(killerid, COR_AMARELO, gstring);
                }
                GivePlayerMoneyEx(playerid, - price);
                PlayerInfo[playerid][pJailed] = 1;
                PlayerInfo[playerid][pJailTime] = (WantedLevel[playerid])*(180);
                if(IsACop(killerid))
                {
                    PLO += 100;
                    DepositarOrgGrana(7,100);
                    format(gstring, sizeof(gstring), "[%s] %s lhe prendeu por %d segundos com %d crimes e Voce perdeu R$:[%d] por trocar tiros e tentar fugir.",NomeORG(killerid),PlayerName(killerid), PlayerInfo[playerid][pJailTime],WantedLevel[playerid], price);
                    SendClientMessage(playerid, COR_LIGHTRED, gstring);
                    CofreOrg[GetPlayerOrg(killerid)][Dinheiro] += price;
                }
                else if(PlayerInfo[killerid][pEmprego] == 7)
                {
                    PLO += 100;
                    DepositarOrgGrana(7,100);
                    format(gstring, sizeof(gstring), "* [Agente Penitenciario] Voce esta preso por %d segundos,perdeu R$[50] por trocar tiros e fugir dos policiais.", PlayerInfo[playerid][pJailTime], price);
                    SendClientMessage(playerid, COR_LIGHTRED, gstring);
                }
