    CMD:chatduvida(playerid, result[])
    {
        if(PlayerMutado[playerid] == 1)
        return SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao pode falar, pois foi calado !");
        if(GetTickCount() - TempoChatNoob[playerid] < 15000)
        return SendClientMessage(playerid,COR_GRAD1,"Voce so pode usar o chat duvida a cada 15 segundos.");
        if(ChatNoob == true)
        return SendClientMessage(playerid, COR_GRAD1, "Chat de duvida esta desatiado!");
        if(PlayerInfo[playerid][pBloqueadoChatDuvida] > 0)
        return SendClientMessage(playerid, COR_GRAD1, "Voce nao pode falar, esta com o chat bloqueado.");



        if(IsPlayerConnected(playerid))
        {
            if(ChatNoobSis == true)
            {
                if(isnull(result))
                return SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/n [chat duvida]");
                if(TentouDivulgar(result))
                {
                    GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                    format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                    ABroadCast(COR_AMARELO,stringZCMD,1);
