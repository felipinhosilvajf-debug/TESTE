START::CarrosTunadosBHC(vehicleid)
{
    new arquivo[64];
    format(arquivo, sizeof(arquivo), Pasta_CarrosVIP, vehicleid);
    if(DOF2_FileExists(arquivo))
    {
        if(CarrosTunados[vehicleid][Tunamento1] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento1]); }
        if(CarrosTunados[vehicleid][Tunamento2] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento2]); }
        if(CarrosTunados[vehicleid][Tunamento3] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento3]); }
        if(CarrosTunados[vehicleid][Tunamento4] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento4]); }
        if(CarrosTunados[vehicleid][Tunamento5] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento5]); }
        if(CarrosTunados[vehicleid][Tunamento6] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento6]); }
        if(CarrosTunados[vehicleid][Tunamento7] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento7]); }
        if(CarrosTunados[vehicleid][Tunamento8] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento8]); }
        if(CarrosTunados[vehicleid][Tunamento9] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento9]); }
        if(CarrosTunados[vehicleid][Tunamento10] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento10]); }
        if(CarrosTunados[vehicleid][Tunamento11] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento11]); }
        if(CarrosTunados[vehicleid][Tunamento12] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento12]); }
        if(CarrosTunados[vehicleid][Tunamento13] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento13]); }
        if(CarrosTunados[vehicleid][Tunamento14] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento14]); }
        if(CarrosTunados[vehicleid][Tunamento15] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento15]); }
        if(CarrosTunados[vehicleid][Tunamento16] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento16]); }
        if(CarrosTunados[vehicleid][Tunamento17] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento17]); }
        if(CarrosTunados[vehicleid][COR1] != 0 || CarrosTunados[vehicleid][COR2]!=0)
        {
            ChangeVehicleColor(vehicleid,CarrosTunados[vehicleid][COR1],CarrosTunados[vehicleid][COR2]);
        }
        if(CarrosTunados[vehicleid][Pintura]!=0)
        {
            ChangeVehiclePaintjob(vehicleid,CarrosTunados[vehicleid][Pintura]);
        }
    }
    new arquivo2[64];
    format(arquivo2, sizeof(arquivo2), Pasta_CarrosFixo, vehicleid);
    if(DOF2_FileExists(arquivo2))
    {
        if(CarrosTunados[vehicleid][Tunamento1] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento1]); }
        if(CarrosTunados[vehicleid][Tunamento2] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento2]); }
        if(CarrosTunados[vehicleid][Tunamento3] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento3]); }
        if(CarrosTunados[vehicleid][Tunamento4] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento4]); }
        if(CarrosTunados[vehicleid][Tunamento5] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento5]); }
        if(CarrosTunados[vehicleid][Tunamento6] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento6]); }
        if(CarrosTunados[vehicleid][Tunamento7] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento7]); }
        if(CarrosTunados[vehicleid][Tunamento8] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento8]); }
        if(CarrosTunados[vehicleid][Tunamento9] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento9]); }
        if(CarrosTunados[vehicleid][Tunamento10] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento10]); }
        if(CarrosTunados[vehicleid][Tunamento11] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento11]); }
        if(CarrosTunados[vehicleid][Tunamento12] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento12]); }
        if(CarrosTunados[vehicleid][Tunamento13] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento13]); }
        if(CarrosTunados[vehicleid][Tunamento14] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento14]); }
        if(CarrosTunados[vehicleid][Tunamento15] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento15]); }
        if(CarrosTunados[vehicleid][Tunamento16] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento16]); }
        if(CarrosTunados[vehicleid][Tunamento17] != 0) { AddVehicleComponent(vehicleid,CarrosTunados[vehicleid][Tunamento17]); }
        if(CarrosTunados[vehicleid][COR1] != 0 || CarrosTunados[vehicleid][COR2]!=0)
        {
            ChangeVehicleColor(vehicleid,CarrosTunados[vehicleid][COR1],CarrosTunados[vehicleid][COR2]);
        }
        if(CarrosTunados[vehicleid][Pintura]!=0)
        {
            ChangeVehiclePaintjob(vehicleid,CarrosTunados[vehicleid][Pintura]);
        }
    }
    return 1;
}

ComponemtesBHC(componentid)
{
    new i;
    for(i = 0; i < 20; ++i)
    {
        if(spoiler[i][0] == componentid) { return 1; }
    }
    for(i = 0; i < 3; ++i)
    {
        if(nitro[i][0] == componentid) { return 2; }
    }
    for(i = 0; i < 23; ++i)
    {
        if(BumperF[i][0] == componentid) { return 3; }
    }
    for(i = 0; i < 22; ++i)
    {
        if(BumperR[i][0] == componentid) { return 4; }
    }
    for(i = 0; i < 28; ++i)
    {
        if(Nitro[i][0] == componentid) { return 5; }
    }
    for(i = 0; i < 2; ++i)
    {
        if(EntradaR[i][0] == componentid) { return 6; }
    }
    for(i = 0; i < 2; ++i)
    {
        if(EntradaL[i][0] == componentid) { return 7; }
    }
    for(i = 0; i < 4; ++i)
    {
        if(BSTeto[i][0] == componentid) { return 8; }
    }
    for(i = 0; i < 13; ++i)
    {
        if(RSTeto[i][0] == componentid) { return 9; }
    }
    for(i = 0; i < 21; ++i)
    {
        if(LSkirt[i][0] == componentid) { return 10; }
    }
    for(i = 0; i < 21; ++i)
    {
        if(RSkirt[i][0] == componentid) { return 11; }
    }
    if(Hidraulica[0][0] == componentid) { return 12; }
    if(Base[0][0] == componentid) { return 13; }
    for(i = 0; i < 2; ++i)
    {
        if(RBBarras[i][0] == componentid) { return 14; }
    }
    for(i = 0; i < 2; ++i)
    {
        if(FBBarras[i][0] == componentid) { return 15; }
    }
    for(i = 0; i < 17; ++i)
    {
        if(Rodas[i][0] == componentid) { return 16; }
    }
    for(i = 0; i < 2; ++i)
    {
        if(Luzes[i][0] == componentid) { return 17; }
    }
    return 0;
}

START::CarregarCarrosTunados(vehicleid)
{
    new FormatoTunamento[256];
    format(FormatoTunamento,sizeof(FormatoTunamento),Pasta_CarrosTunados,vehicleid);
    if(DOF2_FileExists(FormatoTunamento))
    {
        CarrosTunados[vehicleid][Tunamento1] = DOF2_GetInt(FormatoTunamento, "Tunamento1");
        CarrosTunados[vehicleid][Tunamento2] = DOF2_GetInt(FormatoTunamento, "Tunamento2");
        CarrosTunados[vehicleid][Tunamento3] = DOF2_GetInt(FormatoTunamento, "Tunamento3");
        CarrosTunados[vehicleid][Tunamento4] = DOF2_GetInt(FormatoTunamento, "Tunamento4");
        CarrosTunados[vehicleid][Tunamento5] = DOF2_GetInt(FormatoTunamento, "Tunamento5");
        CarrosTunados[vehicleid][Tunamento6] = DOF2_GetInt(FormatoTunamento, "Tunamento6");
        CarrosTunados[vehicleid][Tunamento7] = DOF2_GetInt(FormatoTunamento, "Tunamento7");
        CarrosTunados[vehicleid][Tunamento8] = DOF2_GetInt(FormatoTunamento, "Tunamento8");
        CarrosTunados[vehicleid][Tunamento9] = DOF2_GetInt(FormatoTunamento, "Tunamento9");
        CarrosTunados[vehicleid][Tunamento10] = DOF2_GetInt(FormatoTunamento, "Tunamento10");
        CarrosTunados[vehicleid][Tunamento11] = DOF2_GetInt(FormatoTunamento, "Tunamento11");
        CarrosTunados[vehicleid][Tunamento12] = DOF2_GetInt(FormatoTunamento, "Tunamento12");
        CarrosTunados[vehicleid][Tunamento13] = DOF2_GetInt(FormatoTunamento, "Tunamento13");
        CarrosTunados[vehicleid][Tunamento14] = DOF2_GetInt(FormatoTunamento, "Tunamento14");
        CarrosTunados[vehicleid][Tunamento15] = DOF2_GetInt(FormatoTunamento, "Tunamento15");
        CarrosTunados[vehicleid][Tunamento16] = DOF2_GetInt(FormatoTunamento, "Tunamento16");
        CarrosTunados[vehicleid][Tunamento17] = DOF2_GetInt(FormatoTunamento, "Tunamento17");
        CarrosTunados[vehicleid][Pintura] = DOF2_GetInt(FormatoTunamento, "Pintura");
        CarrosTunados[vehicleid][COR1] = DOF2_GetInt(FormatoTunamento, "COR1");
        CarrosTunados[vehicleid][COR2] = DOF2_GetInt(FormatoTunamento, "COR2");
    }
    else
