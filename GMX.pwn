    CMD:vaca(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new arquivo[64],arquivo2[64];
            new vehicle = GetPlayerVehicleID(playerid);
            new keycar = PlayerInfo[playerid][pCarKey];
            if(IsPlayerInVehicle(playerid, keycar))
            {
                format(arquivo, sizeof(arquivo), Pasta_CarrosVIP, keycar);
                format(arquivo2, sizeof(arquivo2), Pasta_CarrosFixo, keycar);
                if(DOF2_FileExists(arquivo) || DOF2_FileExists(arquivo2))
                {
                    if(!strcmp(DOF2_GetString(arquivo, "Dono"), PlayerName(playerid)) || !strcmp(DOF2_GetString(arquivo2, "Dono"), PlayerName(playerid)))
                    {
                        if(cowit[playerid] == 0)
                        {
                            LinkVehicleToInterior(vehicle,1);
                            SetPlayerInterior(playerid,0);
                            cow[playerid] = CreateDynamicObject(16442,0,0,0,0,0,0,100);
                            new Float:x, Float:y, Float:z;
                            cowit[playerid] = 1;
                            AttachDynamicObjectToVehicle(cow[playerid], GetPlayerVehicleID(playerid), x,y +0.5,z +0.8,0.0,0.0, 90.0);
                            SendClientMessage(playerid, -1, "Vaca instalada !");
                            return 1;
                        }
                        else if(cowit[playerid] == 1)
                        {
                            cowit[playerid] = 0;
                            DestroyDynamicObject(cow[playerid]);
                            LinkVehicleToInterior(vehicle,0);
                            SendClientMessage(playerid, -1, "Vaca Removida !");
                        }
                    }
                }
            }
        }
        return 1;
    }
    CMD:cameraman(playerid, params[])
    {
        if(PlayerInfo[playerid][pMembro] == 9 || PlayerInfo[playerid][pLider] == 9)
        {
            if(CameraInfo[cameraman] != playerid)
            {
                if(CameraInfo[cameraman] != INVALID_PLAYER_ID)
                {
                    SendClientMessage(playerid, COR_GREY, "Alguem esta de Camera-Man!Peca que ele saia.");
                    return 1;
                }
            }
            OnAir(playerid,0);
        }
        return 1;
    }
    CMD:audiencia(playerid, params[])
    {
        if(GetPlayerOrg(playerid) == 9)
        {
            format(stringZCMD, sizeof(stringZCMD), "Audiencia de Pessoas Assistindo Televisao: %d", CameraInfo[audience]);
            SendClientMessage(playerid, COR_LIGHTGREEN, stringZCMD);
        }
        else
        {
            SendClientMessage(playerid, COR_GREY, "   Voce nao e um Reporter !");
            return 1;
        }
        return true;
    }
    CMD:noar(playerid, params[])
    {
        if(PlayerInfo[playerid][pMembro] == 9 || PlayerInfo[playerid][pLider] == 9)
        {
            if(CameraInfo[cameraman] == playerid)
            {
                format(stringZCMD, sizeof(stringZCMD), "Reporter %s: Ligou sua Camera e esta no Ar Agora!Use /assistir", PlayerName(playerid));
                SendFamilyMessage(GetPlayerOrg(playerid), COR_REP, stringZCMD);
                OnAir(playerid,1);
            }
        }
        return 1;
    }
    CMD:assistir(playerid)
    {
        if(playerid != CameraInfo[cameraman])
        {
            if(PlayerInfo[playerid][pTelevisao] == 0)
                return SendClientMessage(playerid, COR_GRAD1, " Voce nao tem uma Televisao, compre um na 24/7!");

            Assistindo(playerid);
            return 1;
        }
        else
        {
            SendClientMessage(playerid,COR_VERMELHO,"Voce e o Camera Man, Voce nao pode assistir a TV!");
        }
        return 1;
    }
    CMD:desligartv(playerid)
    {
        if(player_viewer[playerid] && playerid != CameraInfo[cameraman])
        {
            RemovePlayer(playerid);
            return 1;
        }
        SendClientMessage(playerid,COR_VERMELHO,"Voce nao esta assistindo TV!");
        return 1;
    }
    CMD:foradoar(playerid)
    {
        if(PlayerInfo[playerid][pMembro] == 9 || PlayerInfo[playerid][pLider] == 9)
        {
            if(CameraInfo[cameraman] == playerid)
            {
                OffAir();
                format(stringZCMD, sizeof(stringZCMD), "Reporter %s: Desligou sua Camera e guardou seus Equipamentos.", PlayerName(playerid));
                SendFamilyMessage(GetPlayerOrg(playerid), COR_REP, stringZCMD);
            }
        }
        return 1;
    }
    CMD:setchuck(playerid, params[])return ForT:setarchuck(playerid,params);
    CMD:setarchuck(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /setarchuck [ id ]");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 3)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        if(PlayerInfo[sscanfid][pTrazerChuck] == 1)
                        {
                              PlayerInfo[sscanfid][pTrazerChuck] = 0;
                              PrimeiroChuck[sscanfid] = 1;
                              GivePlayerWeaponEx(sscanfid, 38, 9999999);
                              GivePlayerWeaponEx(sscanfid, 24, 9999999);
                              GivePlayerWeaponEx(sscanfid, 8, 1);
                              SetPlayerSkin(sscanfid, 264);
                              SetPlayerArmour(sscanfid, 100);
                              SetPlayerHealth(sscanfid, 100);
                              SetPlayerColor(sscanfid, 0xFF0000FF);
                              GivePlayerMoneyEx(sscanfid, 5000);
                              NaPorraDoEvento[sscanfid] = true;
                              SendClientMessage(sscanfid, COR_LIGHTBLUE, "Voce foi transformado o novo chuck do evento pelo ADMIN!");
                        }
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Esse nao e um jogador ativo.");
            }
        }
        return 1;
    }
    CMD:multas(playerid)
    {
         if(IsPlayerConnected(playerid))
         {
              if(IsACop(playerid))
              {
                   ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX, "Multas do Servidor", "CM - Contra Mao\n\nDB - Dirigindo Bebado\n\nDP - Direcao Perigosa\n\nEI - Estacionamento Indevido\n\nFD - Farol Desligado\n\nVD - Veiculo Danificado\n\nTNC - Trafegando na Calcada", "Fechar", "");
                   return 1;
              }
         }
         return 1;
    }
    CMD:setarevento(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /setarevento [ id ]");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 3)
            {
                if(PlayerInfo[sscanfid][pJailed] != 0)
                {
                    return SendClientMessage(playerid, COR_GREY, "Este jogador esta preso, Voce nao pode setar ele no evento !");
                }
                if(TipoEvento == 0 && TendoQuarentena == 0)
                {
                    return SendClientMessage(playerid, COR_GREY, "nao esta tendo evento !");
                }
                if(gPlayerLogged[sscanfid] == 0)
                {
                    return SendClientMessage(playerid, COR_GREY, "Este jogador nao esta logado !");
                }
                if(NaPorraDoEvento[sscanfid] == true)
                {
                    return SendClientMessage(playerid, COR_GREY, "Este jogador ja esta em um evento !");
                }
                if(PlayerInfo[sscanfid][pGunLic] == 0)
                {
                    return SendClientMessage(playerid, COR_GREY, "Este jogador nao possui licenca de arma !");
                }
                if(WantedLevel[sscanfid] != 0)
                {
                    return SendClientMessage(playerid, COR_GREY, "Este jogador esta procurado !");
                }
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        if(TipoEvento == 1)
                        {
                            PlayerInfo[sscanfid][pTrazerChuck] = 1;
                            PrimeiroChuck[sscanfid] = 1;
                            NaPorraDoEvento[sscanfid] = true;
                            if(PlayerInfo[sscanfid][pTrazerChuck] == 1)
                            {
                                 PrimeiroChuck[sscanfid] = 0;
                                 PlayerInfo[sscanfid][pTrazerChuck] = 1;
                                 SpawnPlayer(sscanfid);
                            }
                        }
                        else if(TipoEvento == 2)
                        {
                             eventofloresta[sscanfid] = 1;
                             PlayerInfo[sscanfid][pTiroteio] = 1;
                             SendClientMessage(sscanfid, COR_LIGHTBLUE, "Tiroteio na Floresta iniciado, tempo de duracao = 20 minutos, para sair, digite /sairevento !");
                        }
                        else if(TipoEvento == 3)
                        {
