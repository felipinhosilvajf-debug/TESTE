                SetPlayerCheckpoint(playerid, SBizzInfo[h][sbEntranceX], SBizzInfo[h][sbEntranceY], SBizzInfo[h][sbEntranceZ], 4.0);
                GameTextForPlayer(playerid, "~r~mapa da empresa marcado", 5000, 1);
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao possui uma empresa !");
                return 1;
            }
        }
        return 1;
    }
    CMD:acharcarro(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pPHousekey] != 999)
            {
                new House = PlayerInfo[playerid][pPHousekey];
                SetPlayerCheckpoint(playerid, HouseInfo[House][hCarrox], HouseInfo[House][hCarroy], HouseInfo[House][hCarroz], 4.0);
                GameTextForPlayer(playerid, "~r~mapa do carro marcado!", 5000, 1);
            }
            else
            {
                GameTextForPlayer(playerid, "~w~Voce nao tem casa", 5000, 1);
            }
        }
        return 1;
    }
    CMD:compraremp(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new Float:oldposx, Float:oldposy, Float:oldposz;
            GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
            GetPlayerPos(playerid, oldposx, oldposy, oldposz);
            if(PlayerInfo[playerid][pPbiskey] != 255)
            {
                SendClientMessage(playerid, COR_GREY, "Voce ja tem uma empresa!");
                return 1;
            }
            if(PlayerInfo[playerid][pSocio] < 1)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um Socio, digite: /lojavip!");
                return 1;
            }
            for(new b = 0; b < sizeof(SBizzInfo); ++b)
            {
                if(PlayerToPoint(2.0, playerid, SBizzInfo[b][sbEntranceX], SBizzInfo[b][sbEntranceY], SBizzInfo[b][sbEntranceZ]) && SBizzInfo[b][sbOwned] == 0)
                {
                    /*if(PlayerToPoint(2.0, playerid, SBizzInfo[6][sbEntranceX], SBizzInfo[6][sbEntranceY], SBizzInfo[6][sbEntranceZ]) && PlayerInfo[playerid][pSocio] < 3)
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao e o Socio Diamante!");
                        return 1;
                    }*/
                    if(PlayerInfo[playerid][pLevel] < SBizzInfo[b][sbLevelNeeded])
                    {
                        format(stringZCMD, sizeof(stringZCMD), "Voce precisa ser nivel %d para comprar essa empresa",SBizzInfo[b][sbLevelNeeded]);
                        SendClientMessage(playerid, COR_GRAD5, stringZCMD);
                        return 1;
                    }
                    if(GetPlayerMoneyEx(playerid) > SBizzInfo[b][sbBuyPrice])
                    {
                        PlayerInfo[playerid][pPbiskey] = b+100;
                        SBizzInfo[b][sbOwned] = 1;
                        SBizzInfo[b][sbLocked] = 0;
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        strmid(SBizzInfo[b][sbOwner], sendername, 0, strlen(sendername), 255);
                        GivePlayerMoneyEx(playerid,-SBizzInfo[b][sbBuyPrice]);
                        PlayerPlayMusic(playerid);
                        SendClientMessage(playerid, COR_BRANCO, "Parabens, Voce comprou uma empresa.");
                        SendClientMessage(playerid, COR_BRANCO, "Digite /ajudaemp para ver os comandos de sua empresa.");
                        SendClientMessage(playerid, COR_LIGHTRED, "Obs: Empresas Consomem 2200 reais por dia do cofre (Imposto). Mantenha o dinheiro ou perdera sua empresa!");


                        if(PlayerInfo[playerid][pConqEmp] == 0)
                        {
                            showConq(playerid, "$20000_-_Primeira Empresa");
                            showAlerta(playerid, "Parabens, Voce conseguiu cumprir mais uma conquista, para ver suas conquistas, digite: /conquistas!");
                            PlayerInfo[playerid][pConqEmp] = 1;
                        }


                        SalvarSEmpresa(b);
                        OnPlayerSave(playerid);
                        Atualizar3Dtexts();
                        return 1;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao tem grana suficiente");
                        return 1;
                    }
                }
            }
            for(new b = 0; b < sizeof(BizzInfo); b++)
            {
                if(PlayerToPoint(2.0, playerid, BizzInfo[b][bEntranceX], BizzInfo[b][bEntranceY], BizzInfo[b][bEntranceZ]) && BizzInfo[b][bOwned] == 0)
                {
                    if(PlayerInfo[playerid][pLevel] < BizzInfo[b][bLevelNeeded])
                    {
                        format(stringZCMD, sizeof(stringZCMD), "Voce precisa ser nivel %d para comprar essa empresa",BizzInfo[b][bLevelNeeded]);
                        SendClientMessage(playerid, COR_GRAD5, stringZCMD);
                        return 1;
                    }
                    if(GetPlayerMoneyEx(playerid) > BizzInfo[b][bBuyPrice])
                    {
                        PlayerInfo[playerid][pPbiskey] = b;
                        BizzInfo[b][bOwned] = 1;
                        BizzInfo[b][bLocked] = 0;
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        strmid(BizzInfo[b][bOwner], sendername, 0, strlen(sendername), 255);
                        GivePlayerMoneyEx(playerid,-BizzInfo[b][bBuyPrice]);
                        PlayerPlayMusic(playerid);
                        //SetPlayerInterior(playerid,BizzInfo[b][bInterior]);
                        //InteriorAtual[playerid] = BizzInfo[b][bInterior];
                        //SetPlayerPos(playerid,BizzInfo[b][bExitX],BizzInfo[b][bExitY],BizzInfo[b][bExitZ]);
                        GameTextForPlayer(playerid, "~w~Bem Vindo~n~Voce pode sair da sua empresa digitando /sair", 5000, 3);
                        InteriorAtual[playerid] = BizzInfo[b][bInterior];
                        LocalAtual[playerid] = b ;
                        SendClientMessage(playerid, COR_BRANCO, "Parabens, Voce comprou esta empresa.");
                        SendClientMessage(playerid, COR_BRANCO, "Digite /ajudaemp para ver os comandos de sua empresa.");


                        if(PlayerInfo[playerid][pConqEmp] == 0)
                        {
                            showConq(playerid, "$20000_-_Primeira Empresa");
                            showAlerta(playerid, "Parabens, Voce conseguiu cumprir mais uma conquista, para ver suas conquistas, digite: /conquistas!");
                            PlayerInfo[playerid][pConqEmp] = 1;
                        }

                        SalvarEmpresa(b);
                        SalvarEmpresas();
                        OnPlayerSave(playerid);
                        Atualizar3Dtexts();
                        return 1;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao tem grana o suficiente");
                        return 1;
                    }
                }
            }
        }
        return 1;
    }
    CMD:venderemp(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
            if(PlayerInfo[playerid][pPbiskey] == 255)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao possui uma empresa.");
                return 1;
            }
            if(PlayerInfo[playerid][pMarried] > 0)
            {
                SendClientMessage(playerid, COR_GREY, "Voce e casado(a), nao pode vender a empresa!");
                return 1;
            }
            if(PlayerInfo[playerid][pPbiskey] >= 100 && strcmp(playernameZCMD, SBizzInfo[PlayerInfo[playerid][pPbiskey]-100][sbOwner], true) == 0)
            {
                new borse = PlayerInfo[playerid][pPbiskey]-100;
                GivePlayerMoneyEx(playerid,SBizzInfo[borse][sbTill]);
                SBizzInfo[borse][sbLocked] = 0;
                SBizzInfo[borse][sbOwned] = 0;
                GetPlayerName(playerid, sendername, sizeof(sendername));
                strmid(SBizzInfo[borse][sbOwner], "The State", 0, strlen("The State"), 255);
                strmid(SBizzInfo[borse][sbExtortion], "Nenhum", 0, strlen("Nenhum"), 255);
                ConsumingMoney[playerid] = 1;
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                format(stringZCMD, sizeof(stringZCMD), "~w~Parabens~n~ Voce vendeu imoveis para ~n~~g~R$%d", SBizzInfo[borse][sbTill]);
                GameTextForPlayer(playerid, stringZCMD, 10000, 3);
                SBizzInfo[borse][sbTill] = 0;
                PlayerInfo[playerid][pPbiskey] = 255;
                Atualizar3Dtexts();
                OnPlayerSave(playerid);
                return 1;
            }
            if(strcmp(playernameZCMD, BizzInfo[PlayerInfo[playerid][pPbiskey]][bOwner], true) == 0)
            {
                new borse = PlayerInfo[playerid][pPbiskey];
                BizzInfo[borse][bLocked] = 0;
                BizzInfo[borse][bOwned] = 0;
                GetPlayerName(playerid, sendername, sizeof(sendername));
                strmid(BizzInfo[borse][bOwner], "The State", 0, strlen("The State"), 255);
                strmid(BizzInfo[borse][bExtortion], "Nenhum", 0, strlen("Nenhum"), 255);
                ConsumingMoney[playerid] = 1;
                GivePlayerMoneyEx(playerid,BizzInfo[borse][bTill]);
                PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
                format(stringZCMD, sizeof(stringZCMD), "~w~Parabens~n~ Voce vendeu imoveis para ~n~~g~R$%d", BizzInfo[borse][bTill]);
                GameTextForPlayer(playerid, stringZCMD, 10000, 3);
                BizzInfo[borse][bTill] = 0;
                PlayerInfo[playerid][pPbiskey] = 255;
                Atualizar3Dtexts();
                OnPlayerSave(playerid);
                return 1;
            }
            if(PlayerInfo[playerid][pPbiskey] != 255)
            {
                new borse = PlayerInfo[playerid][pPbiskey];
                format(stringZCMD, sizeof(stringZCMD), "~w~Parabens~n~ Voce vendeu imoveis para ~n~~g~R$%d", BizzInfo[borse][bTill]);
                GameTextForPlayer(playerid, stringZCMD, 10000, 3);
                ConsumingMoney[playerid] = 1;
                PlayerInfo[playerid][pPbiskey] = 255;
                OnPlayerSave(playerid);
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_BRANCO, "Voce nao tem uma Empresa.");
            }
        }
        return 1;
    }
    CMD:infoempresa(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new borse = PlayerInfo[playerid][pPbiskey];
            if(borse == 255)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao tem uma empresa.");
                return 1;
            }
            if (borse >= 100)
            {
                PrintSBizInfo(playerid,borse-100);
            }
            else
            {
                PrintBizInfo(playerid,borse);
            }
        }
        return 1;
    }
    CMD:entradadaempresa(playerid, params[])  return ForT:precoentradaemp(playerid, params);
    CMD:entradaemp(playerid, params[])  return ForT:precoentradaemp(playerid, params);
    CMD:precoentradaemp(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new borse = PlayerInfo[playerid][pPbiskey];
            if (borse == 255)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem uma Empresa !");
                return 1;
            }
            new precoentrada;
            if(sscanf(params, "d", precoentrada))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /entradadaempresa [preco]");
            }
            if(precoentrada < 25 || precoentrada > 45)
            {
                SendClientMessage(playerid, COR_BRANCO, "Preco da entrada minimo R$25, maximo R$45.");
                return 1;
            }
            if (borse >= 100)
            {
                SBizzInfo[borse-100][sbEntranceCost] = precoentrada;
                format(stringZCMD, sizeof(stringZCMD), "Entrada Definida Para: R$%d.", SBizzInfo[borse-100][sbEntranceCost]);
            }
            else
            {
                BizzInfo[borse][bEntranceCost] = precoentrada;
                format(stringZCMD, sizeof(stringZCMD), "Entrada Definida Para: R$%d.", BizzInfo[borse][bEntranceCost]);
            }
            Atualizar3Dtexts();
            SendClientMessage(playerid, COR_BRANCO, stringZCMD);
        }
        return 1;
    }
    CMD:extorcao(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new borse = PlayerInfo[playerid][pPbiskey];
            if (borse == 255)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem uma Empresa");
                return 1;
            }
            if(sscanf(params, "d", sscanfid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /extorcao [id] (ou 0 para Nenhum)");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    GetPlayerName(playerid, sendername, sizeof(sendername));
                    GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                    format(stringZCMD, sizeof(stringZCMD), "* %s esta na extorcao de sua empresa.",giveplayerZCMD);
                    SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "* Agora Voce esta na extorcao da empresa de %s.",sendername);
                    SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                    if (borse >= 100)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "%s",giveplayerZCMD);
                        strmid(SBizzInfo[borse-100][sbExtortion], stringZCMD, 0, sizeof(stringZCMD), 255);
                        format(stringZCMD, sizeof(stringZCMD), "Novo dono da Extorcao: %s",SBizzInfo[borse-100][sbExtortion]);
                    }
                    else
                    {
                        format(stringZCMD, sizeof(stringZCMD), "%s",giveplayerZCMD);
                        strmid(BizzInfo[borse][bExtortion], stringZCMD, 0, sizeof(stringZCMD), 255);
                        format(stringZCMD, sizeof(stringZCMD), "Novo dono da Extorcao: %s",BizzInfo[borse][bExtortion]);
                    }
                    Atualizar3Dtexts();
                    SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                }
            }
            else if(sscanfid == 555)
            {
                if (borse >= 100)
                {
                    format(stringZCMD, sizeof(stringZCMD), "Nenhum");
                    strmid(SBizzInfo[borse-100][sbExtortion], stringZCMD, 0, sizeof(stringZCMD), 255);
                    format(stringZCMD, sizeof(stringZCMD), "Novo dono da Extorcao: %s",SBizzInfo[borse-100][sbExtortion]);
                }
                else
                {
                    format(stringZCMD, sizeof(stringZCMD), "Nenhum");
                    strmid(BizzInfo[borse][bExtortion], stringZCMD, 0, sizeof(stringZCMD), 255);
                    format(stringZCMD, sizeof(stringZCMD), "Novo dono da Extorcao: %s",BizzInfo[borse][bExtortion]);
                }
                Atualizar3Dtexts();
                SendClientMessage(playerid, COR_BRANCO, stringZCMD);
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "O Jogador esta offline !");
                return 1;
            }
        }
        return 1;
    }
    CMD:nomeempresa(playerid, params[])  return ForT:nomeemp(playerid, params);
    CMD:nomeemp(playerid, result[])
    {
        if(IsPlayerConnected(playerid) && PlayerInfo[playerid][pAdmin] >= 1341)
        {
            new borse = PlayerInfo[playerid][pPbiskey];
            if (borse == 255)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem uma Empresa");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao esta trabalhando! (/trabalhar)");
                return 1;
            }
            if(isnull(result))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /nomeempresa [Nome]");
            }
            if (borse >= 100)
            {
                strmid(SBizzInfo[borse-100][sbMessage], result, 0, 64, 255);
                format(stringZCMD, sizeof(stringZCMD), "Nome da Empresa Mudada Para: %s",SBizzInfo[borse-100][sbMessage]);
            }
            else
            {
                strmid(BizzInfo[borse][bMessage], result, 0, 64, 255);
                format(stringZCMD, sizeof(stringZCMD), "Nome da Empresa Mudada Para: %s",BizzInfo[borse][bMessage]);
            }
            Atualizar3Dtexts();
            SendClientMessage(playerid, COR_BRANCO, stringZCMD);
        }
        return 1;
    }
    CMD:sacarempresa(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new borse = PlayerInfo[playerid][pPbiskey];
            if (borse == 255)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem uma Empresa");
                return 1;
            }
            new cashdeposit;
            if(sscanf(params, "d", cashdeposit))
            {
                if (borse >= 100)
                {
                    format(stringZCMD, sizeof(stringZCMD), "Voce tem R$%d no cofre da empresa.", SBizzInfo[borse-100][sbTill]);
                    SendClientMessage(playerid, COR_GRAD3, stringZCMD);
                }
                else
                {
                    format(stringZCMD, sizeof(stringZCMD), "Voce tem R$%d no cofre da empresa.", BizzInfo[borse][bTill]);
                    SendClientMessage(playerid, COR_GRAD3, stringZCMD);
                }
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /sacarempresa [quantidade]");
                return 1;
            }
            if (borse > 100)
            {
                if (cashdeposit > SBizzInfo[borse - 100][sbTill] || cashdeposit < 1)
                {
                    SendClientMessage(playerid, COR_GRAD2, "Sua empresa nao possui essa quantia.");
                    return true;
                }
                if(PlayerToPoint(100, playerid,SBizzInfo[borse-100][sbEntranceX],SBizzInfo[borse-100][sbEntranceY],SBizzInfo[borse-100][sbEntranceZ]))
                {
                    GivePlayerMoneyEx(playerid,cashdeposit);
                    SBizzInfo[borse-100][sbTill] -= cashdeposit;
                    format(stringZCMD, sizeof(stringZCMD), "  Voce retirou R$%d de sua empresa - restante: R$%d ", cashdeposit,SBizzInfo[borse-100][sbTill]);
                    SendClientMessage(playerid, COR_GRAD1, stringZCMD);
                    SalvarSEmpresa(borse-100);
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD1, "  Sua empresa esta longe de Voce.");
                    return true;
                }
            }
            if (borse < 100)
            {
                if (cashdeposit > BizzInfo[borse][bTill] || cashdeposit < 1)
                {
                    SendClientMessage(playerid, COR_GRAD2, " Voce nao tem essa quantia.");
                    return true;
                }
                if (PlayerToPoint(100, playerid,BizzInfo[borse][bExitX],BizzInfo[borse][bExitY],BizzInfo[borse][bExitZ]))
                {
                    SendClientMessage(playerid, COR_GRAD1, "Entre na sua empresa.");
                    return true;
                }
                else
                {
                    GivePlayerMoneyEx(playerid,cashdeposit);
                    BizzInfo[borse][bTill] -= cashdeposit;
                    format(stringZCMD, sizeof(stringZCMD), "   Voce retirou R$%d de sua empresa - restante: R$%d ", cashdeposit,BizzInfo[borse][bTill]);
                    SendClientMessage(playerid, COR_GRAD1, stringZCMD);
                    SalvarEmpresa(borse);
                }
            }
        }
        return 1;
    }
    CMD:depositarempresa(playerid, params[])  return ForT:depositaremp(playerid, params);
    CMD:depositaremp(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new borse = PlayerInfo[playerid][pPbiskey];
            if (borse == 255)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem uma empresa.");
                return 1;
            }
            new cashdeposit;
            if(sscanf(params, "d", cashdeposit))
            {
                if (borse >= 100)
                {
                    format(stringZCMD, sizeof(stringZCMD), "Voce tem R$%d de saldo em sua empresa.", SBizzInfo[borse-100][sbTill]);
                    SendClientMessage(playerid, COR_GRAD3, stringZCMD);
                }
                else
                {
                    format(stringZCMD, sizeof(stringZCMD), "Voce tem R$%d de saldo em sua empresa.", BizzInfo[borse][bTill]);
                    SendClientMessage(playerid, COR_GRAD3, stringZCMD);
                }
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /depositarempresa [quantidade]");
                return 1;
            }
            if (cashdeposit > GetPlayerMoneyEx(playerid) || cashdeposit < 1)
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao tem tanto");
                return 1;
            }
            if (borse >= 100)
            {
                if(PlayerToPoint(100, playerid,SBizzInfo[borse-100][sbEntranceX],SBizzInfo[borse-100][sbEntranceY],SBizzInfo[borse-100][sbEntranceZ]))
                {
                    GivePlayerMoneyEx(playerid,-cashdeposit);
                    SBizzInfo[borse-100][sbTill] += cashdeposit;
                    ExtortionSBiz(borse-100, cashdeposit);
                    format(stringZCMD, sizeof(stringZCMD), "Voce guardou R$%d no cofre de sua empresa. O saldo de sua empresa: R$%d", cashdeposit,SBizzInfo[borse-100][sbTill]);
                    SendClientMessage(playerid, COR_AMARELO, stringZCMD);
                    return 1;
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD2, "Voce esta longe de sua empresa");
                    return 1;
                }
            }
            else
            {
                if (!PlayerToPoint(100, playerid,BizzInfo[borse][bExitX],BizzInfo[borse][bExitY],BizzInfo[borse][bExitZ]))
                {
                    SendClientMessage(playerid, COR_GRAD1, "Entre na sua empresa.");
                    return 1;
                }
                else
                {
                    GivePlayerMoneyEx(playerid,-cashdeposit);
                    BizzInfo[borse][bTill] += cashdeposit;
                    ExtortionBiz(borse, cashdeposit);
                    format(stringZCMD, sizeof(stringZCMD), "Voce depositou $%d no cofre de sua empresa Total: $%d", cashdeposit,BizzInfo[borse][bTill]);
                    SendClientMessage(playerid, COR_AMARELO, stringZCMD);
                    return 1;
                }
            }
        }
        return 1;
    }
    CMD:tvon(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GREEN, "Voce nao e um Administrador");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] >= 1)
            {
                if(WatchingTV[playerid] < 1)
                {
                    GetPlayerPos(playerid, Unspec[playerid][Coords][0],Unspec[playerid][Coords][1],Unspec[playerid][Coords][2]);
                }
            }
            if(Spectate[playerid] == 255 && PlayerInfo[playerid][pAdmin] >= 1)
            {
                GetPlayerPos(playerid, Unspec[playerid][sPx], Unspec[playerid][sPy], Unspec[playerid][sPz]);
                Unspec[playerid][sPint] = InteriorAtual[playerid];
                Unspec[playerid][sLocal] = LocalAtual[playerid];
                LocalAtual[playerid] = 255;
                gTeam[playerid] = 0;
            }
            if(sscanf(params, "u", sscanfid)) return SendClientMessage(playerid, COR_BRANCO, "Use /tvon [playerid]");
            if(PlayerInfo[playerid][pAdmin] >= 1)
            {
                new world;
                world = GetPlayerVirtualWorld(sscanfid);
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        if(PlayerInfo[sscanfid][pAdmin] >= 1340 && PlayerInfo[playerid][pAdmin] < 1340)
                        {
                            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode ficar de TV em um Admin Dono !");
                            return 1;
                        }
                        Spectate[playerid] = sscanfid;
                        new Float:health;
                        GetPlayerHealth(Spectate[playerid], health);
                        GetPlayerName(Spectate[playerid], giveplayerZCMD, sizeof(giveplayerZCMD));
                        new cash =  GetPlayerMoneyEx(Spectate[playerid]);
                        if (PlayerInfo[playerid][pAdmin] >= 1)
                        {
                            SetPlayerToTeamColor(playerid);
                            SetPlayerVirtualWorld(playerid,world);
                            PlayerInfo[playerid][pSpawn] = 0;
                            format(stringZCMD, sizeof(stringZCMD), "Info: (%d) %s R$%d H:%.0f",Spectate[playerid],giveplayerZCMD,cash,health);
                            TogglePlayerSpectating(playerid, 1);
                            if(IsPlayerInAnyVehicle(sscanfid))
                            {
                                PlayerSpectateVehicle(playerid, GetPlayerVehicleID(sscanfid));
                            }
                            else
                            {
                                PlayerSpectatePlayer(playerid, sscanfid);
                            }
                        }
                        SendClientMessage(playerid, COR_AMARELO2, stringZCMD);
                        WatchingTV[playerid] = 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_BRANCO, "Use /tvon [playerid]");
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREEN, "Voce nao tem permissao para usar esse comando!");
                return 1;
            }
        }
        return 1;
    }
    CMD:tvoff(playerid, params[])
    {
        new nome[24];
        GetPlayerName(playerid, nome, sizeof nome);
        if(PlayerInfo[playerid][pAdmin] >= 1)
        {
            if(WatchingTV[playerid] > 0)
            {
                if(AdminTrabalhando[playerid] == 1)
                {
                    SetPlayerSkin(playerid,217);
                }
                WatchingTV[playerid] = 0;
                Spectate[playerid] = 253;
                GameTextForPlayer(playerid, "~n~~n~~n~~n~~w~TV OFF", 5000, 3);
                MedicBill[playerid] = 0;
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta de TV em Ninguem !");
                return 1;
            }
        }
        return 1;
    }
    CMD:lchat(playerid, result[])
    {
        if(PlayerMutado[playerid] == 1)
        {
            SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao pode falar, pois foi calado !");
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(isnull(result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /lchat [Texto]");
                return 1;
            }
            if(TentouDivulgar(result))
            {
                GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                ABroadCast(COR_AMARELO,stringZCMD,1);
                DivulgouLog(stringZCMD);
                return 1;
            }
            if(PlayerInfo[playerid][pCargo] == 6)
            {
                format(stringZCMD, sizeof(stringZCMD), "[Lider %s] %s: %s", NomeORG(playerid),PlayerName(playerid),result);
                ChatLider(COR_AMARELO, stringZCMD, 1);
                return 1;
            }
            else if(PlayerInfo[playerid][pCargo] == 5)
            {
                format(stringZCMD, sizeof(stringZCMD), "[Sub-Lider %s] %s: %s", NomeORG(playerid),PlayerName(playerid),result);
                ChatLider(COR_AMARELO, stringZCMD, 1);
                return 1;
            }
        }
        return 1;
    }
    CMD:echat(playerid, result[])
    {
        if(PlayerMutado[playerid] == 1)
        {
            SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao pode falar, pois foi calado ! !");
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
                GetPlayerName(playerid, sendername, sizeof(sendername));
                if(isnull(result))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/echat) [Chat Emprego]");
                    return 1;
                }
                if(TentouDivulgar(result))
                {
                    GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                    format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                    DivulgouLog(stringZCMD);
                    return 1;
                }
                if(Palavrao(result))
                {
                    GivePlayerMoneyEx(playerid, -50);
                    SendClientMessage(playerid, COR_LIGHTRED, "e PROIBIDO CHINGAR NO CHAT DE EMPREGO,Voce PERDEU 50 REAIS !");
                    return 1;
                }
                new jtext[30];
                if(PlayerInfo[playerid][pEmprego] == 1) { jtext = "Detetive"; }
                else if(PlayerInfo[playerid][pEmprego] == 2) { jtext = "Advogado"; }
                else if(PlayerInfo[playerid][pEmprego] == 3) { jtext = "Seguranca"; }
                else if(PlayerInfo[playerid][pEmprego] == 4) { jtext = "Motorista de Onibus"; }
                else if(PlayerInfo[playerid][pEmprego] == 5) { jtext = "Mendigo"; }
                else if(PlayerInfo[playerid][pEmprego] == 6) { jtext = "Caminhoneiro"; }
                else if(PlayerInfo[playerid][pEmprego] == 7) { jtext = "Agente Penitenciario"; }
                else if(PlayerInfo[playerid][pEmprego] == 8) { jtext = "Lixeiro"; }
                else if(PlayerInfo[playerid][pEmprego] == 9) { jtext = "Ladrao de Carros"; }
                else if(PlayerInfo[playerid][pEmprego] == 10) { jtext = "Fazendeiro"; }
                else if(PlayerInfo[playerid][pEmprego] == 11) { jtext = "Coveiro"; }
                else if(PlayerInfo[playerid][pEmprego] == 12) { jtext = "Carteiro"; }
                else if(PlayerInfo[playerid][pEmprego] == 13) { jtext = "Vendedor De Drogas"; }
                else if(PlayerInfo[playerid][pEmprego] == 14) { jtext = "Vendedor De Armas"; }
                else if(PlayerInfo[playerid][pEmprego] == 15) { jtext = "PizzaBoy"; }
                else if(PlayerInfo[playerid][pEmprego] == 16) { jtext = "Minerador"; }
                if (PlayerInfo[playerid][pEmprego] != 0)
                {
                    format(stringZCMD, sizeof(stringZCMD), "** %s %s: %s **", jtext, PlayerName(playerid), result);
                    SendEmpregoMessage(PlayerInfo[playerid][pEmprego], 0xBEBEBEFF, stringZCMD);
                    foreach(new i: Player)
                    {
                        if(IsPlayerConnected(i))
                        {
                            if(PlayerInfo[i][pVIP] == 0 && PlayerInfo[playerid][pSocio] == 0)
                            {
                                SendClientMessage(i, 0xba55d3FF,stringZCMD);
                            }
                        }
                    }
                }
                format(stringZCMD, sizeof(stringZCMD), "* %s usou o radio para falar com o seu emprego(/echat).", PlayerName(playerid));
                ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
        }
        return 1;
    }
    CMD:cs(playerid, params[])  return ForT:cq(playerid, params);
    CMD:cq(playerid, result[])
    {
        if(PlayerMutado[playerid] == 1)
        {
            SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao pode falar, pois foi calado ! !");
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
            if(TendoQuarentena == 1 || TanoWarZone[playerid] == 1)
            {
                GetPlayerName(playerid, sendername, sizeof(sendername));
                if(isnull(result))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/cs) [Chat CS]");
                    return 1;
                }
                if(TentouDivulgar(result))
                {
                    GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                    format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                    DivulgouLog(stringZCMD);
                    return 1;
                }
                if (EquipeQuarentena[playerid] == 1)
                {
                    format(stringZCMD, sizeof(stringZCMD), "[Humano] %s: %s", PlayerName(playerid), result);
                    SendCSMessage(1, COR_DBLUE, stringZCMD);
                }
                if (EquipeQuarentena[playerid] == 2)
                {
                    format(stringZCMD, sizeof(stringZCMD), "[Infectado] %s: %s", PlayerName(playerid), result);
                    SendCSMessage(2, COR_VERMELHO, stringZCMD);
                }
                if (EquipeWarZone[playerid] == 3)
                {
                    format(stringZCMD, sizeof(stringZCMD), "[Green] %s: %s", PlayerName(playerid), result);
                    SendCSMessage(1, COR_GREEN, stringZCMD);
                }
                if (EquipeWarZone[playerid] == 2)
                {
                    format(stringZCMD, sizeof(stringZCMD), "[Blue] %s: %s", PlayerName(playerid), result);
                    SendCSMessage(2, COR_AZTECAS, stringZCMD);
                }
                if (EquipeWarZone[playerid] == 1)
                {
                    format(stringZCMD, sizeof(stringZCMD), "[Red] %s: %s", PlayerName(playerid), result);
                    SendCSMessage(3, COR_VERMELHO, stringZCMD);
                }
                //TempoChatEmprego[playerid] = GetTickCount();
            }
            else
            {
                SendClientMessage(playerid, COR_BALLAS, "Voce nao pode usar este comando agora!");
            }
        }
        return 1;
    }
    CMD:noob(playerid, params[])  return ForT:chatduvida(playerid, params);
