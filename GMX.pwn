    CMD:rsom(playerid)
    {
        if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
        EscutandoSom[playerid] = 0;
        SomID[playerid] = 999;
        SendClientMessage(playerid, COR_AMARELO, "[AVISO]: Voce reconectou o som!");
        return 1;
    }
    CMD:festas(playerid)
    {
         if(PlayerInfo[playerid][pVIP] > 0 && PlayerInfo[playerid][pSocio] > 0)
         {
              SendClientMessage(playerid, COR_VERDE, "Festas Ocorrendo:");
              for(new i = 0; i <= MAX_PLAYERS; i++)
              {
                   if(DonoFesta[i] == 1)
                   {
                        new location[MAX_ZONE_NAME];
                        GetPlayer2DZone(i, location, MAX_ZONE_NAME);
                        GetPlayerName(i, sendername, sizeof(sendername));
                        if(IsPlayerInLS(i))
                        {
                            format(stringZCMD, sizeof(stringZCMD), "Deejay: %s: ID[%d] - Cidade:[LS] - Bairro:[%s]", sendername, i, location);
                            SendClientMessage(playerid, COR_GRAD1, stringZCMD);
                        }
                        else if(IsPlayerInSF(i))
                        {
                             format(stringZCMD, sizeof(stringZCMD), "Deejay: %s: ID[%d] - Cidade:[SF] - Bairro:[%s]", sendername, i, location);
                             SendClientMessage(playerid, COR_GRAD1, stringZCMD);
                        }
                        else if(IsPlayerInLV(i))
                        {
                             format(stringZCMD, sizeof(stringZCMD), "Deejay: %s: ID[%d] - Cidade:[LV] - Bairro:[%s]", sendername, i, location);
                             SendClientMessage(playerid, COR_GRAD1, stringZCMD);
                        }
                        return 1;
                   }
              }
         }
         else
         {
              SendClientMessage(playerid, COR_GREEN, "Voce precisa ser jogador VIP para visualizar as festas que estao ocorrendo !");
              return 1;
         }
         return 1;
    }
    CMD:ligarsom(playerid)
    {
         if(PlayerInfo[playerid][pSocio] == 3)
         {
              new vid = GetPlayerVehicleID(playerid);
              if(!IsPlayerInAnyVehicle(playerid) || GetVehicleModel(vid) != 535 && GetVehicleModel(vid) != 556 && GetVehicleModel(vid) != 557 && GetVehicleModel(vid) != 560 && GetVehicleModel(vid) != 561 && GetVehicleModel(vid) != 579)
              {
                   SendClientMessage(playerid, COR_GRAD1, "Voce so pode ligar o som nos veiculos id: 535,556,557,560,561 ou 579.");
                   return 1;
              }
              if(IsPlayerInVehicle(playerid, PlayerInfo[playerid][pCarKey]))
              {
                   if(DonoFesta[playerid] == 0)
                   {
                       new arquivo[64];
                       format(arquivo, sizeof(arquivo), Pasta_CarrosVIP, PlayerInfo[playerid][pCarKey]);
                       if(DOF2_FileExists(arquivo))
                       {
                           if(!strcmp(DOF2_GetString(arquivo, "Dono"), PlayerName(playerid)))
                           {
                               SendClientMessage(playerid, COR_LIGHTBLUE, "Voce esta ligando o som, so continue se estiver em um local RPG, se estiver no meio da rua sera devidamente punido.");
                               ShowPlayerDialog(playerid, 163, DIALOG_STYLE_INPUT, "VBR MP3 Players", "Determine a distancia do som(10 a 70 metros).", "Iniciar", "Cancelar");
                           }
                           else
                           {
                               SendClientMessage(playerid, COR_GRAD1, "Voce nao e o dono deste veiculo vip !");
                               return 1;
                           }
                       }
                   }
                   else if(DonoFesta[playerid] == 1)
                   {
                        new files[MAX_PLAYER_NAME];
                        format(files, sizeof files, "DJ/%s.ini", PlayerName(playerid));
                        foreach(new x: Player)
                        {
                            if(IsPlayerInRangeOfPoint(x, DOF2_GetFloat(files, "DistanciaSom"), DOF2_GetFloat(files, "SomX"), DOF2_GetFloat(files, "SomY"), DOF2_GetFloat(files, "SomZ")))
                            {
                                if(DonoFesta[playerid] == 1 && EscutandoSom[x] == playerid)
                                {
                                    EscutandoSom[x] = 0;
                                    StopAudioStreamForPlayer(x);
                                    SomID[x] = 999;
                                }
                            }
                        }
                        if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
                        somligado[vid] = 0;
                        TemSomLigado--;
                        if(TemSomLigado < 0)
                        {
                            TemSomLigado = 0;
                        }
                        DestroyObject(som1[vid]);
                        DestroyObject(som2[vid]);
                        DestroyObject(som3[vid]);
                        DestroyObject(som4[vid]);
                        DestroyObject(som5[vid]);
                        DestroyObject(som6[vid]);
                        DestroyObject(som7[vid]);
                        DestroyObject(som8[vid]);
                        SendClientMessage(playerid, COR_GRAD6, "Som Desligado !");
                        DonoFesta[playerid] = 0;
                        SomID[playerid] = 999;
                        if(DOF2_FileExists(files))
                        {
                            DOF2_RemoveFile(files)
                        }
                        return 1;
                   }
              }
         }
         return 1;
    }
    CMD:mala(playerid)
    {
         new mot, lu, alar, por, cap, porma, ob;
         new carro = GetPlayerVehicleID(playerid);
         if(carro != INVALID_VEHICLE_ID)
         {
              if(portamalas[playerid] == 0)
              {
                  GetVehicleParamsEx(carro, mot, lu, alar, por, cap, porma, ob);
                  SetVehicleParamsEx(carro, mot, lu, alar, por, cap, VEHICLE_PARAMS_ON, ob);
                  portamalas[playerid] = 1;
                  SendClientMessage(playerid, COR_BRANCO, "Porta Malas: {228B22}Aberto!");
              }
              else if(portamalas[playerid] == 1)
              {
                   GetVehicleParamsEx(carro, mot, lu, alar, por, cap, porma, ob);
                   SetVehicleParamsEx(carro, mot, lu, alar, por, cap, VEHICLE_PARAMS_OFF, ob);
                   portamalas[playerid] = 0;
                   SendClientMessage(playerid, COR_BRANCO, "Porta Malas: {FF0000}Fechado!");
              }
         }
    }
    CMD:doar(playerid, result[])
    {
         new para1;
         new tipo;
         new quantidade;
         if(sscanf(result, "udd", para1, tipo, quantidade))
         {
              SendClientMessage(playerid, COR_LIGHTBLUE, "{df5454}Ã—{ffffff} USE: /doar [id] [tipo] [quantidade]");
              SendClientMessage(playerid, COR_GRAD6, "Tipos: 1(material) 2(credito cel)");
              return 1;
         }
         if(tipo < 1 || tipo > 2) { return 1; }
         if(IsPlayerConnected(para1))
         {
              if(para1 != INVALID_PLAYER_ID)
              {
                   if(PlayerInfo[para1][pLevel] <= 2)
                   {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode doar nada para jogadores level 2 !");
                        return 1;
                   }
                   if(AdminTrabalhando[para1] > 0)
                   {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode doar nada para um admin em modo trabalho !");
                        return 1;
                   }
                   if(tipo == 1)
                   {
                        if(strval(result) > PlayerInfo[playerid][pMats])
                        {
                             SendClientMessage(playerid, COR_GRAD1, "Voce nao tem materiais suficiente para poder doar !");
                             return 1;
                        }
                        PlayerInfo[playerid][pMats] -= quantidade;
                        PlayerInfo[para1][pMats] += quantidade;
                        format(stringZCMD, sizeof(stringZCMD), "Jogador: %s doou [%d] materiais de seus materiais para %s.", PlayerName(playerid), quantidade, PlayerName(para1));
                        ProxDetector(30.0, playerid, stringZCMD, COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE);
                   }
                   if(tipo == 2)
                   {
                        if(strval(result) > PlayerInfo[playerid][pCreditos])
                        {
                             SendClientMessage(playerid, COR_GRAD1, "Voce nao tem creditos suficiente para poder doar !");
                             return 1;
                        }
                        PlayerInfo[playerid][pCreditos] -= quantidade;
                        PlayerInfo[para1][pCreditos] += quantidade;
                        format(stringZCMD, sizeof(stringZCMD), "Jogador: %s doou [%d] creditos de seu celular para %s.", PlayerName(playerid), quantidade, PlayerName(para1));
                        ProxDetector(30.0, playerid, stringZCMD, COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE);
                   }
              }
         }
         return 1;
    }
    CMD:voar(playerid)
    {
         if(PlayerInfo[playerid][pAdmin] < 1)
         {
              SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando !");
              return 1;
         }
         if(AdminTrabalhando[playerid] < 1)
         {
              SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
              return 1;
         }
         if(flying[playerid] == false)
         {
              flying[playerid] = true;
              StartFly(playerid);
              format(stringZCMD, sizeof(stringZCMD), "ADMCMD: %s ativou o modo voar.", PlayerName(playerid));
              ABroadCast(COR_AMARELO,stringZCMD,1);
         }
         else
         {
              flying[playerid] = false;
              StopFly(playerid);
              format(stringZCMD, sizeof(stringZCMD), "ADMCMD: %s desativou o modo voar.", PlayerName(playerid));
              ABroadCast(COR_AMARELO,stringZCMD,1);
         }
         return 1;
    }
    CMD:laseron(playerid)
    {
         if(PlayerInfo[playerid][pSocio] == 0)
         {
              SendClientMessage(playerid, COR_GRAD1, "Voce nao e um jogador Socio !");
              return 1;
         }
         if(GetPlayerWeapon(playerid) == 0)
         {
              SendClientMessage(playerid, COR_GRAD1, "Voce nao esta utilizando uma arma para colocar o laser !");
              return 1;
         }
         SetPVarInt(playerid, "laser", 1);
         SetPVarInt(playerid, "color", GetPVarInt(playerid, "color"));
         SendClientMessage(playerid, COR_GRAD1, "Voce ativou o laser na arma, digite /lasercor [cor] para mudar a cor ou /laseroff para retirar !");
         return 1;
    }
    CMD:laseroff(playerid)
    {
          if(PlayerInfo[playerid][pSocio] == 0)
          {
               SendClientMessage(playerid, COR_GRAD1, "Voce nao e um jogador Socio !");
               return 1;
          }
          SetPVarInt(playerid, "laser", 0);
          RemovePlayerAttachedObject(playerid, 9);
          SendClientMessage(playerid, COR_GRAD1, "Voce retirou o laser na arma !");
          return 1;
    }
    CMD:lasercor(playerid, params[])
    {
          if(PlayerInfo[playerid][pSocio] == 0)
          {
               SendClientMessage(playerid, COR_GRAD1, "Voce nao e um jogador Socio !");
               return 1;
          }
          if(isnull(params))
          {
               SendClientMessage(playerid, COR_VERDE, "Usage: /lasercor [cor] (vermelho,azul,rosa,laranja,verde e amarelo)");
               return 1;
          }
          if (!strcmp(params, "Vermelho", true))
          {
               SetPVarInt(playerid, "color", 18643);
          }
          else if(!strcmp(params, "Azul", true))
          {
               SetPVarInt(playerid, "color", 19080);
          }
          else if (!strcmp(params, "Rosa", true))
          {
               SetPVarInt(playerid, "color", 19081);
          }
          else if (!strcmp(params, "Laranja", true))
          {
               SetPVarInt(playerid, "color", 19082);
          }
          else if (!strcmp(params, "Verde", true))
          {
               SetPVarInt(playerid, "color", 19083);
          }
          else if (!strcmp(params, "Amarelo", true))
          {
               SetPVarInt(playerid, "color", 19084);
          }
          else
          {
               SendClientMessage(playerid, 0x00E800FF, "[ERRO] - nao Tem Essa Cor No Banco de Dados Do VBR!");
               return 1;
          }
          return 1;
    }
    CMD:irobjeto(playerid, params[])return ForT:iro(playerid,params);
    CMD:iro(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] != 1342) return 1;
        new obid;
        if(sscanf(params, "d", obid))
        {
            SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /irobjeto [ id ]");
            return 1;
        }
        new Float:oX, Float:oY, Float:oZ;
        GetObjectPos(obid, oX, oY, oZ);
        SetPlayerPos(playerid, oX, oY, oZ+3);
        SendClientMessage(playerid, COR_GRAD2, "Voce foi ate o objeto");
        return 1;
    }
