    CMD:dcarro(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new carroid;
            if(sscanf(params, "d", carroid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /dcarro [carro id]");
                return 1
            }
            if(PlayerInfo[playerid][pAdmin] >= 2)
            {
                foreach(new i: Player)
                {
                    if(IsPlayerConnected(i))
                    {
                        SetVehicleParamsForPlayer(carroid,i,0,0);
                    }
                }
                GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                format(stringZCMD, sizeof(stringZCMD), "AdmAviso: %s destrancou o carro %d.",playernameZCMD, carroid);
                ABroadCast(COR_AMARELO,stringZCMD,1);
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
                return 1;
            }
        }
        return 1;
    }
    CMD:trazercarro(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new plo;
            if(sscanf(params, "d", plo))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /trazercarro [carro id]");
                return 1;
            }
            new Float:plocx,Float:plocy,Float:plocz;
            if (PlayerInfo[playerid][pAdmin] >= 2)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                GetPlayerPos(playerid, plocx, plocy, plocz);
                SetVehiclePos(plo,plocx,plocy+4, plocz);
                LinkVehicleToInterior(plo, 0);
                SetVehicleVirtualWorld(plo, 0);
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
                return 1;
            }
        }
        return 1;
    }
