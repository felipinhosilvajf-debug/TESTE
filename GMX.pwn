    CMD:licencas(playerid, params[])
    {
        if(WantedLevel[playerid] > 0)
        {
            SendClientMessage(playerid, COR_AMARELO, "Voce esta procurado pela policia, nao pode iniciar testes de licenca !");
            return 1;
        }
        if (PlayerToPoint(1, playerid, 1489.9749,1307.1294,1093.2891) || PlayerToPoint(1, playerid, -2033.7506,-116.0411,1035.1719))
        {
            if(PlayerInfo[playerid][pMultado] > 0)
            {
                format(stringZCMD, sizeof(stringZCMD), "Voce so pode tirar licencas depois a %d Paydays", PlayerInfo[playerid][pMultado]);
                SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                return 1
            }
            TogglePlayerControllable(playerid, 0);
            ShowPlayerDialog(playerid,105,DIALOG_STYLE_LIST,"RS - Licencas","Iniciar Teste de Direcao(Carro) - R$ 5.000\nIniciar Teste de Direcao(Moto) - R$ 5.000\nIniciar Teste de Direcao(Aereo) - R$ 8.000\nIniciar Teste de Direcao(Barco) - R$ 4.000\nIniciar Teste de Direcao(Caminhao/onibus) - R$ 4.000\nComprar Licenca de Armas - R$ 50.000","Confirmar","Cancelar");
        }
