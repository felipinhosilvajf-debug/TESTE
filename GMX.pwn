    CMD:menucasa(playerid, params[])
    {

        if(PlayerInfo[playerid][pPHousekey] == 999)
        {
            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao possui uma residencia!");
            return 1;
        }
        else if(PlayerInfo[playerid][pPHousekey] < 999)
        {
                new str[7000];
                new Status[800];
                new Moradorcasa;
                foreach(new i: Player)
                {
                    if(PlayerInfo[i][pPHousekey] == PlayerInfo[playerid][pPHousekey])
                    {
                        Moradorcasa++;
                    }
                }
                new borse = PlayerInfo[playerid][pPHousekey];
                format(stringZCMD, sizeof(stringZCMD), "Sistema\tStatus\n");
                strcat(str,stringZCMD);
                if(HouseInfo[borse][hRentabil] == 1) Status = "{00ffff}SIM";
                else if(HouseInfo[borse][hRentabil] == 0) Status = "{FF0000}nao";
                format(stringZCMD, sizeof(stringZCMD), "{ffffff}Permitir ser Alugada\t%s\n", Status);
                strcat(str,stringZCMD);

                if(HouseInfo[playerid][hLock] == 1) Status = "{FFCC99}Trancado";
                else if(HouseInfo[playerid][hLock] == 0) Status = "{33ff00}Aberto";
                format(stringZCMD, sizeof(stringZCMD), "{ffffff}Portas (Residencia)\t%s\n", Status);
                strcat(str,stringZCMD);

                format(stringZCMD, sizeof(stringZCMD), "{ffffff}Valor do Aluguel\t{ffffff}R${33ff00}%d\n", HouseInfo[borse][hRent]);
                strcat(str,stringZCMD);

                format(stringZCMD, sizeof(stringZCMD), "{ffffff}Descricao da Residencia\t{818689}%s\n", HouseInfo[borse][hDiscription]);
                strcat(str,stringZCMD);

                if(PlayerInfo[playerid][pSpawnCity] == 0) Status = "Spawn Civil/Emprego/ORG";
                else if(PlayerInfo[playerid][pSpawnCity] == 1) Status = "Casa";
                format(stringZCMD, sizeof(stringZCMD), "{ffffff}Definir Nascimento\t{818689}%s\n", Status);
                strcat(str,stringZCMD);

                format(stringZCMD, sizeof(stringZCMD), "{ffffff}Mudar Interior\t{818689}**\n");
                strcat(str,stringZCMD);

                format(stringZCMD, sizeof(stringZCMD), "{ffffff}Expulsar Todos da Casa\t{df5454}%d {818689}moradores\n", Moradorcasa-1);
                strcat(str,stringZCMD);

                format(stringZCMD, sizeof(stringZCMD), "{ffffff}Transferir Imovel\t{818689}Clique para Gerenciar\n");
                strcat(str,stringZCMD);
                ShowPlayerDialog(playerid, 230, DIALOG_STYLE_TABLIST_HEADERS, "Definicoes do Imovel", str, "Alterar", "Sair");
        }
        return 1;
    }

