                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou p.negativos na carteira:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
