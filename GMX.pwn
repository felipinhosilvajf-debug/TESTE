    }
    if(ProvocoPark[playerid] == 1)
    {
        GangZoneStopFlashForAll(GZPark);
        GangZoneShowForAll(GZPark, 0xFFFFFF96);
        GuerranoPark = 0;
        ProvocoPark[playerid] = 0;
        DonoPark = 0;
        Dominando[playerid] = 0;
        KillTimer(TempoGuerraPark);
    }
    if(ProvocoEstacao[playerid] == 1)
    {
        GangZoneStopFlashForAll(GZEstacao);
        GangZoneShowForAll(GZEstacao, 0xFFFFFF96);
        GuerranaEstacao = 0;
        ProvocoEstacao[playerid] = 0;
        donoestacao = 0;
        Dominando[playerid] = 0;
        KillTimer(TempoGuerraEstacao);
    }
    if (gPlayerCheckpointStatus[playerid] > 4 && gPlayerCheckpointStatus[playerid] < 11)
    {
        DisablePlayerCheckpoint(playerid);
        gPlayerCheckpointStatus[playerid] = CKPOINT_NENHUM;
    }
    new caller = Mobile[playerid];
    if(caller != 255)
    {
        if(caller < 255)
        {
            SendClientMessage(caller,  COR_GRAD2, "Morreram do outro lado da linha....");
            CellTime[caller] = 0;
            CellTime[playerid] = 0;
            Mobile[caller] = 255;
        }
        Mobile[playerid] = 255;
        CellTime[playerid] = 0;
    }
    if(PlayerInfo[playerid][pHeadValue] > 0)
    {
        if(IsPlayerConnected(killerid))
        {
            if(gTeam[killerid] == 10 || PlayerInfo[killerid][pLider] == 8  || PlayerInfo[killerid][pMembro] == 8 || PlayerInfo[killerid][pLider] == 26  || PlayerInfo[killerid][pMembro] == 26)
            {
                if(GoChase[killerid] == playerid)
                {
                    ConsumingMoney[killerid] = 1;
                    GivePlayerMoneyEx(killerid, PlayerInfo[playerid][pHeadValue]);
                    SendClientMessage(playerid, COR_VERDE, "<<<<<<<<< Voce Foi Morto Por 1 Contrato,Portanto,nao FOI DM! >>>>>>>>>");
                    SendClientMessage(playerid, COR_LIGHTRED, "Voce perdeu R$100 por morrer com um contrato !");
                    format(gstring,128,"* Voce cumpriu o contrato no jogador: %s, e recebeu R$[%d]",PlayerName(playerid),PlayerInfo[playerid][pHeadValue]);
                    SendClientMessage(killerid, COR_LIGHTRED, gstring);
                    if(GetPlayerOrg(killerid) == 8)
                    {
                         DepositarGranaOrg(8,PlayerInfo[playerid][pHeadValue]);
                         format(gstring,128,"<< Algum Hitman cumpriu o contrato em %s e recebeu R$[%d] >>",PlayerName(playerid),PlayerInfo[playerid][pHeadValue]);
                         SendClientMessageToAll(COR_AMARELO, gstring);
                         CHitman++;
                    }
                    else if(GetPlayerOrg(killerid) == 26)
                    {
                         DepositarGranaOrg(26,PlayerInfo[playerid][pHeadValue]);
                         format(gstring,128,"<< Algum Triad cumpriu o contrato em %s e recebeu R$[%d] >>",PlayerName(playerid),PlayerInfo[playerid][pHeadValue]);
                         SendClientMessageToAll(COR_AMARELO, gstring);
                         CTriads++;
                    }
                    GameTextForPlayer(killerid, "~r~contrato cumprido", 5000, 1);
                    SendClientMessage(playerid, COR_OBS, "Alerta: {ffffff}Voce ganhou mais um ponto do titulo cacador de recompensas.");
                    PlayerInfo[playerid][pHeadValue] = 0;
                    GivePlayerMoneyEx(playerid, -100);
                    GotHit[playerid] = 0;
                    GetChased[playerid] = 999;
                    GoChase[killerid] = 999;
                    PlayerInfo[killerid][pCacador] ++;
                }
            }
        }
    }
    if (PlayerInfo[killerid][pHeadValue] > 0)
    {
        if (IsPlayerConnected(playerid))
        {
            if (GetPlayerOrg(playerid) == 8 || GetPlayerOrg(playerid) == 26)
            {
                if (GoChase[playerid] == killerid)
                {
                    ConsumingMoney[playerid] = 1;
                    format(gstring, 128, "<< O Matador %s foi morto por %s, e perdeu o seu contrato >>", PlayerName(playerid), PlayerName(killerid));
                    SendFamilyMessage(8, COR_AMARELO, gstring);
                    SendFamilyMessage(26, COR_AMARELO, gstring);
                    PlayerInfo[killerid][pHeadValue] = 0;
                    GotHit[killerid] = 0;
                    GetChased[killerid] = 999;
                    GoChase[playerid] = 999;
                }
            }
        }
    }
    if(!strcmp(cActor[playerid][cName], ""))
    {
        DestroyActor(cActor[playerid][cActorID]);
        Delete3DTextLabel(cActor[playerid][cLabelID]);
    }
    if(DroparArmSis == true)
    {
        new playerweapons[13][2];
        new Float:x,Float:y,Float:z;
        GetPlayerPos(playerid, x, y, z);
        for(new i=0;i<13;i++){
            GetPlayerWeaponData(playerid, i, playerweapons[i][0], playerweapons[i][1]);
            new model=GetWeaponModel(playerweapons[i][0]);
            new Float:X=x+(random(3)-random(3));
            new Float:Y=y+(random(3)-random(3));
            if(playerweapons[i][1]!=0)
            {
                CreateDroppedItem(model, playerweapons[i][1], X, Y, z);
            }
        }
    }
    if(NaPorraDoEvento[playerid] == false)
    {
        GetPlayerName(playerid, cActor[playerid][cName], 24);
        GetPlayerPos(playerid, cActor[playerid][cPos][0],cActor[playerid][cPos][1], cActor[playerid][cPos][2]);
        GetPlayerFacingAngle(playerid, cActor[playerid][cPos][3]);
        cActor[playerid][cSkinID] = GetPlayerSkin(playerid);
        cActor[playerid][cInterior] = GetPlayerInterior(playerid);
        cActor[playerid][cWorld] = GetPlayerVirtualWorld(playerid);
        format(string, sizeof(string), "{818689}Corpo de {ffffff}%s\n{818689}Assassino: {ffffff}%s", cActor[playerid][cName], PlayerName(killerid));
        cActor[playerid][cLabelID] = Create3DTextLabel(string, 0xFFFFFFFF, cActor[playerid][cPos][0], cActor[playerid][cPos][1], cActor[playerid][cPos][2], 10.0, cActor[playerid][cWorld], 1);
        AtirouCorpo[playerid] = 0;
        //SetTimerEx("CriarCorpo", 3000, false, "i", playerid);
    }
    return 1;
}

