    if(idx == 354) format( nomedoitem, 50, "Charuto Do VBSTAFF");
    if(idx == 2749) format( nomedoitem, 50, "Grafite Personalizado");
    if(idx == 2886) format( nomedoitem, 50, "Decodificador");
    if(idx == 2976) format( nomedoitem, 50, "Bomba Nuclear");
    if(idx == 3096) format( nomedoitem, 50, "Kit De Reparo");
    if(idx == 2647) format( nomedoitem, 50, "Coca-Cola");
    if(idx == 1668) format( nomedoitem, 50, "Garrafa d'agua");
    if(idx == 19878) format( nomedoitem, 50, "Skate");
    if(idx == 19582) format( nomedoitem, 50, "Carne");
    if(idx == 19630) format( nomedoitem, 50, "Peixe");
    if(idx == 2702) format( nomedoitem, 50, "Fatia de Pizza");
    if(idx == 2880) format( nomedoitem, 50, "Hamburguer");
    if(idx == 1650) format( nomedoitem, 50, "Galao de combustivel");
    if(idx == 19382) format( nomedoitem, 50, "Nenhum Item");
    if(ObjetoArma(idx))  format(nomedoitem, 50, "%s", NomeDaArma(idx));
    if(ObjetoAcessorio(idx))  format(nomedoitem, 50, "%s", NomeDoAcessorio(idx));
    if(idx == 964) format( nomedoitem, 50, "Caixa De Armas");
    if(idx == 2922) format( nomedoitem, 50, "Decodificador");
    if(idx == 1252) format( nomedoitem, 50, "CB");
    if(idx == 1578) format( nomedoitem, 50, "Maconha");
    if(idx == 1575) format( nomedoitem, 50, "Crack");
    if(idx == 1576) format( nomedoitem, 50, "LSD");
    if(idx == 1279) format( nomedoitem, 50, "Cocaina");
    if(idx == 1654) format( nomedoitem, 50, "Dinamite");
    if(idx == 2993) format( nomedoitem, 50, "Respawn Carros");
    if(idx == 19421) format( nomedoitem, 50, "iPad");
    if(idx == 3016) format( nomedoitem, 50, "Kit Socio");
    if(idx >= 0 && idx < 312) format(nomedoitem, 50, "Skin %d",idx); // se for skin
    if(idx > 399 && idx < 612) format(nomedoitem, 50, "%s",Nomedosveiculos[idx - 400]); //  se for veiculo
    return nomedoitem;
}
stock NomeItemInvInventario(id,playerid){

    new str[100];
    new idx = InventarioInfo[playerid][id][iSlot];
    format(str,100,NomeItemInv(idx));
    return str;
}




stock DiminuirInv(slot, playerid)
{
    if(InventarioInfo[playerid][slot][iUnidades] > 1) return InventarioInfo[playerid][slot][iUnidades] --;

    if(InventarioInfo[playerid][slot][iUnidades] == 1){

        InventarioInfo[playerid][slot][iUnidades] = 0;
        InventarioInfo[playerid][slot][iSlot] = 19382;
    }
    return 1;
}
stock NumerosInventario(const string[])
{
    new length = strlen(string);
    if(!length) return false;
    for(new i = 0; i < length; i++)
    {
        if(string[i] > '9' || string[i] <'0') return false;
    }
    return true;
}
