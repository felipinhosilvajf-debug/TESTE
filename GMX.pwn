    CMD:vinculardiscord(playerid, params[])
    {
        new stringdc[528];
        if(sscanf(params, "s", stringdc))
        {
            SendClientMessage(playerid, COR_OBS, "ERRO, USE: {ffffff}/vinculardiscord [ Discord Valido ]");
            SendClientMessage(playerid, COR_BRANCO, "{ffffff}e usado para seguros meios de recuperar sua conta caso perda o nick ou a Senha.");
            return 1;
        }
        VincularDiscord(playerid, stringdc);
        return 1;
    }

    CMD:la(playerid, params[])  return ForT:limparadmin(playerid, params);
    CMD:limparadmin(playerid, params[])
    {
                 new stringdc[528];
                 if(sscanf(params, "s", stringdc))
                 {
                    SendClientMessage(playerid, COR_OBS, "[ERRO, USE]: {ffffff}/la [ Nick do Admin ](Para retirar o admin do player).");
                    return 1;
                 }
                 new string2[150];
                 format(string2, sizeof(string2), "Players/%s.ini", stringdc);
                 if(DOF2_GetInt(string2, "AdminLevel") < 1)
                 {
                    SendClientMessage(playerid,COR_OBS, "[ERRO]: {ffffff}Esse jogador nao e um admin!");
                    return 1;
                 }
                 DOF2_SetInt(string2, "AdminLevel", 0);
                 DOF2_SaveFile();
                 SendClientMessage(playerid, COR_OBS, "[ADMIN]: {ffffff}Voce retirou o admin do jogador.");
                 format(stringZCMD, sizeof stringZCMD, "[Admin]: {ffffff}O admin %s retirou o admin do jogador %s.", PlayerName(playerid), stringdc);
                 SendClientMessageToAll(COR_OBS, stringZCMD);
                 return 1;
    }

    CMD:dsmdnuani(playerid, params[])
    {
        new stringdc[528];
        if(sscanf(params, "s", stringdc))
        {
            return 1;
        }
        discord[playerid] = stringdc;
        discord2 = stringdc;
        return 1;
    }

    CMD:saciarall(playerid, params[])
    {
            if(PlayerInfo[playerid][pAdmin] < 1340)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao e um Administrador");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            foreach(new i: Player)
            {
                PlayerInfo[i][pFome] = 100;
                PlayerInfo[i][pSede] = 100;
                AtualizarFomeSede(i);
            }
            new string[128];
            format(string, 128, "AdmCmd: O Admin %s saciou a fome e sede de todos do servidor.",PlayerName(playerid));
            SendClientMessageToAll(COR_LIGHTGREEN,string);
            return 1;
    }

    CMD:irmapa(playerid)
    {
        if(PlayerInfo[playerid][pAdmin] >= 1342)
        {
            if(MarcouMapa[playerid] == true)
            {
                SetPlayerPos(playerid, GetPVarFloat(playerid, "VBSTAFFX"), GetPVarFloat(playerid, "VBSTAFFY"), GetPVarFloat(playerid, "VBSTAFFZ")+4);
                SendClientMessage(playerid, COR_GRAD1, "Voce foi teletransportado pelo Admin!");
            }
            else if(MarcouMapa[playerid] == false)
            {
                //SetPlayerPos(playerid, GetPVarFloat(playerid, "VBSTAFFX"), GetPVarFloat(playerid, "VBSTAFFY"), GetPVarFloat(playerid, "VBSTAFFZ")+4);
                SendClientMessage(playerid, COR_GREY, "Voce nao marcou nenhum local no seu Mapa.");
            }
        }
        else if(PlayerInfo[playerid][pAdmin] == 0)
        {
            SendClientMessage(playerid, COR_GREY, "Voce nao tem permissao para usar este comando.");
        }
        return 1;
    }

    CMD:irposicao(playerid)
    {
        if(BloqueadoIrPosicao[playerid] == 0)
        {
            new File[56];
            format(File, sizeof(File), "Posicoes/%s.txt", PlayerName(playerid));
            if(DOF2_FileExists(File))
            {
                SetPlayerPos(playerid, DOF2_GetFloat(File, "PosX"),  DOF2_GetFloat(File, "PosY"), DOF2_GetFloat(File, "PosZ")+1);
                SetPlayerInterior(playerid, DOF2_GetInt(File, "Interior"));
                SetPlayerFacingAngle(playerid, DOF2_GetFloat(File, "PosA"));
                SetCameraBehindPlayer(playerid);
                BloqueadoIrPosicao[playerid] = 1;
                SendClientMessage(playerid, COR_GREY, "{818689}Voce foi setado na ultima posicao onde saiu do jogo.");
            }
        }
        else if(BloqueadoIrPosicao[playerid] == 1)
        {
            SendClientMessage(playerid, COR_GREY, "O tempo para ir para a posicao que Voce saiu pela ultima vez do jogo, excedeu! ou Voce ja deu /irposicao.");
        }
        return 1;
    }

    CMD:saciar(playerid, params[])
    {
            if(PlayerInfo[playerid][pAdmin] < 4)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao e um Administrador");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new para1;
            if(sscanf(params, "u", para1))
            {
                SendClientMessage(playerid, COR_GRAD2, "USE: /saciarfome [ID do Player]");
                return 1;
            }
            GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
            GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
            if(IsPlayerConnected(para1))
            {
                if(para1 != INVALID_PLAYER_ID)
                {
                    new string[128];
                    PlayerInfo[para1][pFome] = 100;
                    PlayerInfo[para1][pSede] = 100;
                    format(string, 128, "AdmCmd: O Admin %s saciou a fome/sede de %s.",playernameZCMD, giveplayerZCMD);
                    ABroadCast(COR_LIGHTGREEN,string,1337);
                    AtualizarFomeSede(playerid);
                }
            }
            return 1;
    }
    CMD:verinventario(playerid, params[])
    {
        new playa;
        if(PlayerInfo[playerid][pAdmin] < 3) return 1;
        if(sscanf(params, "u", playa))
        {
            SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /verinventario [ID]");
            return 1;
        }
        for(new i=0; i<75; i++)
        {
            if(InventarioInfo[playa][i][iSlot] != 19382)
            {
                new id = InventarioInfo[playa][i][iSlot];
                format(stringZCMD, sizeof(stringZCMD), "Slot[%d]: %s, Quantidade [%d].", i, NomeItemInv(id), InventarioInfo[playa][i][iUnidades]);
                SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
            }
        }
        format(stringZCMD, sizeof(stringZCMD), "Inventario de %s",PlayerName(playa));
        SendClientMessage(playerid, COR_AMARELO, stringZCMD);
        return 1;
    }





    CMD:saciarfome(playerid, params[])
    {
            if(PlayerInfo[playerid][pAdmin] < 4)
            {
                SendClientMessage(playerid, COR_GRAD1, " {FFFFFF} Voce nao pode usar este comando!");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new para1;
            new level;
            if(sscanf(params, "ud", para1, level))
            {
                SendClientMessage(playerid, COR_GRAD2, "USE: /saciarfome [ID do Player] [quantia]");
                return 1;
            }
            GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
            GetPlayerName(playerid, playernameZCMD, sizeof(playernameZCMD));
            if(IsPlayerConnected(para1))
            {
                if(para1 != INVALID_PLAYER_ID)
                {
                    if(level < 1 || level > 100) return SendClientMessage(playerid, COR_GRAD2, "Use um valor de 1 - 100.");
                    new string[128];
                    PlayerInfo[para1][pFome] = level;
                    format(string, 128, "AdmCmd: O Admin %s saciou %d% de fome para %s.",playernameZCMD, level, giveplayerZCMD);
                    ABroadCast(COR_LIGHTGREEN,string,1337);
                    AtualizarFomeSede(playerid);
                }
            }
            return 1;
    }
