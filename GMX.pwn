                        SendClientMessageToAll(GetPlayerColor(playerid), stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "[%s] colocou dinamites na porta, ira explodir em 10 segundos, afaste-se um pouco.", PlayerName(playerid));
                        ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        format(stringZCMD, sizeof(stringZCMD), "[ALERTA COPS] %s[%d] DINAMITOU A PORTA E esta TENTANDO INVADIR A SALA DE CONTROLE DA PREFEITURA !", playernameZCMD, playerid);
