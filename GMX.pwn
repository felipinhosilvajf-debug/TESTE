    CMD:acessorios(playerid)
    {
        if(PlayerMobile[playerid] == true)
        {
            SendClientMessage(playerid, -1, "{df5454}Erro: {ffffff}O Editor de Acessorios mobile esta em desenvolvimento!");
        }
        else if(PlayerMobile[playerid] == false)
        {
            MEGAString[0]=EOS;
            new string[128];
            new arquivo[64];
            format(arquivo, sizeof(arquivo), Pasta_CAcessorio,PlayerName(playerid));
            new xstring[20];
            new ystring[20];
            strcat(MEGAString, "Slot Nome\tLocal do Corpo\n");
            for(new x;x<MAX_PLAYER_ATTACHED_OBJECTS-1;x++)
            {
                if(IsPlayerAttachedObjectSlotUsed(playerid, x))
                {
                    format(xstring, sizeof(xstring), "boneid%d", x);
                    new LocalCorpo = DOF2_GetInt(arquivo, xstring);
                    new NomeLocal[21];
                    switch(LocalCorpo)
                    {
                        case 1: NomeLocal = "Espinha";
                        case 2: NomeLocal = "Cabeca";
                        case 3: NomeLocal = "Braco Esquerdo";
                        case 4: NomeLocal = "Braco Direto";
                        case 5: NomeLocal = "Mao Esquerda";
                        case 6: NomeLocal = "Mao Direita";
                        case 7: NomeLocal = "Coxa esquerda";
                        case 8: NomeLocal = "Coxa Direita";
                        case 9: NomeLocal = "Pe Esquerdo";
                        case 10: NomeLocal = "Pe Direito";
                        case 11: NomeLocal = "Panturrilha Direita";
                        case 12: NomeLocal = "Panturrilha Esquerda";
                        case 13: NomeLocal = "Antebraco Esquerdo";
                        case 14: NomeLocal = "Antebraco Direito";
                        case 15: NomeLocal = "Clavicula Esquerda";
                        case 16: NomeLocal = "Clavicula Direita";
                        case 17: NomeLocal = "Pescoco";
                        case 18: NomeLocal = "Mandibula";
                    }
                    format(ystring, sizeof(ystring), "modelid%d", x);
                    new IDObjeto = DOF2_GetInt(arquivo, ystring);
                    format(string, sizeof(string), "{FFFFFF}%d {df5454}%s\t{df5454}%s\n", x, NomeDoAcessorio(IDObjeto), NomeLocal);
                    strcat(MEGAString, string);
                }
                else
                {
                 //   format(string, sizeof(string), "{FFFFFF}%d {df5454}Nenhum\t{df5454}Nenhum\n", x);
                 //   strcat(MEGAString, string);
                }
            }
            ShowPlayerDialog(playerid, 1742, 5, \
            "Seus Acessorios", MEGAString, "Editar", "Cancelar");
        }
        return 1;
    }

    CMD:config(playerid, params[]) return ForT:configuracoes(playerid, params);
