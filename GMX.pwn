        if(IsPlayerConnected(playerid))
        {
            if(IsACop(playerid) || GetPlayerOrg(playerid) == 7 || PlayerInfo[playerid][pEmprego] == 7)
            {
                if(OnDuty[playerid] != 1 && PlayerInfo[playerid][pEmprego] != 7 && GetPlayerOrg(playerid) != 7)
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao Bateu o cartao!");
                    return 1;
                }
                GetPlayerName(playerid, sendername, sizeof(sendername));
                if(isnull(result))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/m)egafone [megafone chat]");
                    return 1;
                }
                if(GetTickCount() - TempoChatMegaFone[playerid] < 3000)
                {
                    SendClientMessage(playerid,COR_GRAD1,"Voce so pode escrever uma mensagem a cada 3 segundos.");
                    return 1;
                }
                if(TentouDivulgar(result))
                {
                    GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                    format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                    DivulgouLog(stringZCMD);
                    return 1;
                }
                if(IsACop(playerid) || PlayerInfo[playerid][pEmprego] == 7 || GetPlayerOrg(playerid) == 7)
                {
                    if(IsACop(playerid))
                    {
                        format(stringZCMD, sizeof(stringZCMD), "[%s]%s: %s",NomeORG(playerid), sendername, result);
                        ProxDetector(60.0, playerid, stringZCMD,COR_AMARELO,COR_AMARELO,COR_AMARELO,COR_AMARELO,COR_AMARELO);
                    }
                    else if(GetPlayerOrg(playerid) == 7)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "[Governo]%s: %s", sendername, result);
                        ProxDetector(60.0, playerid, stringZCMD,COR_AMARELO,COR_AMARELO,COR_AMARELO,COR_AMARELO,COR_AMARELO);
                    }
                    else if(PlayerInfo[playerid][pEmprego] == 7)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "[Agente Penitenciario]%s: %s", sendername, result);
                        ProxDetector(60.0, playerid, stringZCMD,COR_AMARELO,COR_AMARELO,COR_AMARELO,COR_AMARELO,COR_AMARELO);
                    }
                    TempoChatMegaFone[playerid] = GetTickCount();
                    printf("%s", stringZCMD);
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD2, "Voce nao faz parte de nenhuma equipe !");
                    return 1;
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um Oficial !");
                return 1;
            }
        }
        return 1;
    }
