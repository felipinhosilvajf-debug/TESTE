    CMD:bug(playerid, params[])
    {
            new Str[6000];
            format(Str, sizeof Str, "{818689}Voce esta preste a relatar um bug para a equipe de desenvolvimento que ira avaliar\no relatorio e caso contatado resolvera o bug na proxima renicializacao(GMX).\n\n{ffffff}Seja objetivo a hora de relatar a falha/erro encontrado, para que podemos\nresolver o mais rapido possivel.\n\nCom o seu relatorio, Voce estara contribuindo com o que e nosso servidor melhore a cada dia mais.\nProporcionando aos usuarios a melhor experiencia possivel em nossa comunidade :)\n\n{fa4c4c}OBS: {818689}O Seu relatorio devera conter no maximo {df5454}528 {818689}digitos.\nO seu nick ficara salvo junto com o seu relatorio e data em Banco de Dadoss, portanto\ncaso haja o mal uso deste sistema como por exemplo: xingamento, difamacao o qualquer\noutra coisa que nao seja o descrevimento de uma falha/erro no servidor, recebera punicao!\n\n{df5454}Recompensa: {ffffff}Caso encontre um bug com alto nivel de gravidade (exemplo: duplicacao de itens)\no player recebera uma recompensa pela contribuicao.\nBasta chamar no Discord: VBSTAFF#0001.\n\n{818689}Descriva abaixo o bug que encontrou no servidor:");
            ShowPlayerDialog(playerid, 8912, DIALOG_STYLE_INPUT, "{ffffff}Virtual {aaacae}Boost {ffffff}RPG - Relatorio de Bugs",Str,"Reportar","Fechar");
            return true;
    }


    CMD:rbug(playerid, result[])
    {
            if(!strlen(result))
            {
                return true;
            }
            getdate(Ano, Mes, Dia);
            gettime(Hora, Minuto, Segundo);
            SendClientMessage(playerid, COR_LIGHTRED, "Seu relato foi salvo em um arquivo interno do servidor, logo que o VBSTAFF ver, corrigira. Obrigado!");
            new File:filebug;
            MEGAString[0] = EOS;
            filebug = fopen(Pasta_BUGS,io_append);
            format(MEGAString, 256, "//>================= [ %02d/%02d/%04d as %02d:%02d:%02d ] =================<\n\n//Por: %s\nBUG: %s\n\n",
            Dia, Mes, Ano,
            Hora, Minuto, Segundo,
            PlayerName(playerid),
            result);
            fwrite(filebug,MEGAString);
            fclose(filebug);
            return true;
    }
    CMD:vozdeprisao(playerid, params[])return ForT:vdp(playerid,params);
    CMD:vdp(playerid, params[])
    {
            if(!IsACop(playerid) || ModoTrabalhoDetran[playerid] != 1)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um policial ou um DETRAN(Guarda), ou simplesmente nao deve esta com cartao batido em modo Rocam!");
                return true;
            }
            if(PlayerInfo[playerid][pJailed] == 9)
            {
                SendClientMessage(playerid,COR_GRAD1," Voce nao pode usar este comando nas Celas da Administracao!");
                return true;
            }
            new giveplayerid;
            if(sscanf(params, "u", giveplayerid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /vozdeprisao [ID do Player]");
                return true;
            }
            if(IsPlayerConnected(giveplayerid))
            {
                if(giveplayerid != INVALID_PLAYER_ID)
                {
                    if(WantedLevel[giveplayerid] == 0)
                    {
                        SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}Este jogador nao esta sendo procurado!");
                        return true;
                    }
                    if(PlayerInfo[giveplayerid][pAdmin] && AdminTrabalhando[giveplayerid])
                    {
                        SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}Voce nao pode dar /VDP em admins em modo Trabalho!");
                        return true;
                    }
                    if(VozDePrisao[giveplayerid] == 1)
                    {
                        SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}Alguem ja deu voz de prisao a este Jogador!");
                        return true;
                    }
                    if (ProxDetectorS(9.0, playerid, giveplayerid))
                    {
                        new string[128];
                        format(string, sizeof(string), "[Policia]%s: Temos um mandado de prisao, se renda digitando /hd ou levara /ssu DOP e RP!", PlayerName(playerid));
                        SendClientMessage(giveplayerid, COR_AMARELO, string);
            //          format(string, sizeof(string), "OBS: Se Voce desconectar agora, sera preso automaticamente, faca com que o policial perca-o de vista!!!", PlayerName(playerid));
            //          SendClientMessage(giveplayerid, COR_AMARELO2, string);
                        format(string, sizeof(string), "* Voce deu voz de prisao a %s.", PlayerName(giveplayerid));
                        SendClientMessage(playerid, COR_SHOX, string);
                        SendClientMessage(playerid, COR_LIGHTRED, "Se o jogador se desconectar agora, sera preso automaticamente, nao perca-o de vista!!!");
                        PutaGorda[giveplayerid] = SetTimerEx("VozDePrisaoo", 1000, 1, "ii", giveplayerid, playerid);
                        VozDePrisao[giveplayerid] = 1;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_START,  "{df5454}ERRO: {ffffff}O jogador esta muito longe de Voce!");
                        return true;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "   O Jogador esta Offline !");
                return true;
            }
            return true;
    }

    CMD:aentradafemp(playerid, params[])
    {
            if (PlayerInfo[playerid][pAdmin] < 1337)
            {
                SendClientMessage(playerid, COR_GRAD2, "  Voce nao pode usar este comando");
                return true;
            }
            new quant, id;
            if(sscanf(params, "dd", id, quant))
            {
                return SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /aentradafemp [id] [preco]");
            }
            new string[50];
            FBizzInfo[id][fbEntranceCost] = quant;
            SalvarFEmpresa(id);
            format(string, sizeof(string), "Entrada Definida Para: R$%d.", FBizzInfo[id][fbEntranceCost]);
            Atualizar3Dtexts();
            SendClientMessage(playerid, COR_BRANCO, string);
            return true;
    }


    CMD:infoguerra(playerid, params[])
    {
        ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX, "{ffffff}Informacoes detalhada sobre as Guerras:", "{00ff00}Guerra Morro:\n\n{ffffff}Informacoes: {818689}e iniciada automaticamente nos horarios: [{ffffff}7h, 8h, 13h, 14h, 19h, 20h, 1h e 2h{818689}]\n{ffffff}Participantes: {818689}Gangsters e COP (Policiais)\n{ffffff}Funcionamento: {818689}Conseguir o maximo de pontos possiveis matando rivais.\n\n\n{00ffff}Guerra Casarao:\n\n{ffffff}Informaacoes: {818689}e iniciada a qualquer momento por COPs ou Gangsters, abrindo o menu do territorio\n{ffffff}Participantes: {818689}Mafias, Mercenarios e COP: [{ffffff}R.O.T.A e Policia Ferdeal etc...]\n{ffffff}Funcionamento: {818689}Uma Guerra + Dominacao de Territorio com Mafias, merc. e COPs\n{ffcc99}OBS: nao tem pontuacoes, somente bonus com dinheiro de ate 50.000(50k).\n\n\n{FA4C4C}Guerra Terroristas:\n\n{ffffff}Informacoes {818689}nao e iniciada automaticamente, devera digitar: [{ffffff}/guerra{818689}]\n{ffffff}Participantes: {818689}Apenas Terroristas e COP: [{3300ff}Exercito{818689}]\n{ffffff}Funcionamento: {818689}Conseguir o maximo de pontos possiveis matando rivais.\n{ffcc99}OBS: Podera itilizar tanque de guerra, Avioes de combates.", "Fechar", "");
        return 1;
    }

