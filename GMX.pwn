                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou socio:[%d] em: %s.", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 17:
                            {
                                PlayerInfo[sscanfid][pCrimes] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou crimes cometidos:[%d] em: %s.", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 18:
                            {
                                if(PlayerInfo[playerid][pAdmin] != 1342) return 1;
                                PlayerInfo[sscanfid][pDiaVIP] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou dias vip:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 19://
                            {
                                if(PlayerInfo[playerid][pAdmin] != 1342) return 1;
                                MudarNick[sscanfid] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou mudancas de nick:[%d] em: %s.", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
