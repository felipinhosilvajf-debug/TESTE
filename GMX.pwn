    CMD:carandiru(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new tempo2;
            new result[64];
            if(PlayerInfo[playerid][pAdmin] < 3)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado para usar este comando!");
                return 1;
            }
            if(PlayerInfo[sscanfid][pJailed] != 0 && PlayerInfo[playerid][pAdmin] <= 4)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao pode prender quem ja esta Preso!"); // nivel 4 +
                return 1;
            }
            if(sscanf(params, "uds[64]", sscanfid, tempo2, result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /carandiru [ ID ] [ Tempo ] [ Motivo ]");
                return 1;
            }
            if(PlayerInfo[sscanfid][pAdmin] == 1340  && PlayerInfo[sscanfid][pAdmin] == 1341 && PlayerInfo[sscanfid][pAdmin] == 1342)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao pode dar Carandiru em um Admin Dono/Scripter,Voce e UM MERDA HUAHUAHUA!");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(PlayerInfo[sscanfid][pSex] == 1)
                    {
                        SetPlayerSkin(sscanfid, 42);
                    }
                    else
                    {
                        SetPlayerSkin(sscanfid, 69);
                    }
                    SetPlayerSkin(sscanfid, 268);
                    SetPlayerInterior(sscanfid, 0);
                    if(PlayerInfo[sscanfid][pSex] == 2) {  SetPlayerSkin(sscanfid, 69); }
                    if(PlayerInfo[sscanfid][pSocio] >= 1) {  SetPlayerSkin(sscanfid, 42); }
                    GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                    GetPlayerName(playerid, sendername, sizeof(sendername));
                    format(stringZCMD, sizeof(stringZCMD), "* Voce colocou o(a) %s no carandiru, motivo: %s.", giveplayerZCMD, (result));
                    SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "ADMCMD: %s Colocou %s por [%d] Minutos no Carandiru. Motivo: %s.", sendername, giveplayerZCMD, tempo2, (result));
                    SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
                    GameTextForPlayer(sscanfid, "~b~Bem Vindo ao ~n~~r~Carandiru", 5000, 3);
                    ResetPlayerWeaponsEx(sscanfid);
                    WantedLevel[sscanfid] = 0;
                    SetPlayerWantedLevelEx(sscanfid, 0);
                    PlayerInfo[sscanfid][pJailed] = 2;
                    PlayerInfo[sscanfid][pJailTime] = tempo2 * 60;
                    SetPlayerPos(sscanfid, 268.58, 1857.94, 9.81);
                    SetPlayerWorldBounds(sscanfid, 337.5694,101.5826,1940.9759,1798.7453);
                    SetPlayerChatBubble(sscanfid, ".", COR_VERMELHO, 1, 1);

                    format(stringZCMD, sizeof(stringZCMD), "%s lhe colocou no carandiru, minutos: %d, motivo: %s", sendername, tempo2, (result));
                    pCadeiaLog(sscanfid, stringZCMD);
                    if(tempo2 > 0)
                    {
                        if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(sscanfid, "https://dl.dropboxusercontent.com/s/yaa9h7amuw89qj2/carandiru.mp3");
                    }
                    else
                    {
                        StopAudioStreamForPlayer(sscanfid);
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "O jogador esta offline !");
                return 1;
            }
        }
        return 1;
    }
    CMD:removerorgvip(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new org;
            if(sscanf(params, "d", org))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /removerorgvip [org]");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] >= 1341)
            {

                new arquivo[64];
                format(arquivo, sizeof(arquivo), Pasta_ORGVIP, org);
                if(DOF2_FileExists(arquivo))
                {

                    DOF2_SetInt(arquivo,"Tipo",0);
                    DOF2_SetInt(arquivo,"Dias",0);
                    DOF2_SetInt(arquivo,"Data",0);
                    format(stringZCMD, sizeof(stringZCMD), "AdmCmd: %s Desativou uma ORG VIP da ORG:[%s].",PlayerName(playerid),GetOrgName(org));
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                }
                DOF2_SaveFile();
                LoadOrgs();
                return 1;
            }
            else
            {

                SendClientMessage(playerid, COR_GRAD1, "Voce nao tem permissao para usar esse comando !");
            }
        }
        return 1;
    }
    CMD:setarorgvip(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new org, tipo, dias;
            if(sscanf(params, "ddi", org, tipo, dias))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /setarorgvip [org] [tipo] [dias]");
                return 1;
            }
            if(org < 1 || org > 26)
            {
                SendClientMessage(playerid, COR_GRAD2, "Orgs 1 a 26.");
                return 1;
            }
            if(tipo < 1 || tipo > 3)
            {
                SendClientMessage(playerid, COR_GRAD2, "Tipos: 1 (Bronze), 2 (Prata), 3 (Ouro).");
                return 1;
            }
            new lolz[7];
            if(tipo == 1)
            {
                lolz = "Bronze";
            }
            if(tipo == 2)
            {
                lolz = "Prata";
            }
            if(tipo == 3)
            {
                lolz = "Ouro";
            }
            if(PlayerInfo[playerid][pAdmin] >= 1341)
            {

                new arquivo[64];
                getdate(year, month, day);
                format(arquivo, sizeof(arquivo), Pasta_ORGVIP, org);
                if(DOF2_FileExists(arquivo))
                {
                    DOF2_SetInt(arquivo,"Tipo",tipo);
                    DOF2_SetInt(arquivo,"Dias",dias);
                    DOF2_SetInt(arquivo,"Data",day);
                    format(stringZCMD, sizeof(stringZCMD), "AdmCmd: %s Ativou uma ORG VIP para a ORG:[%s], Tipo[%s], Dias[%d].",PlayerName(playerid),GetOrgName(org),lolz,dias);
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                }
                else
                {
                    DOF2_CreateFile(arquivo);
                    DOF2_SetInt(arquivo,"Tipo",tipo);
                    DOF2_SetInt(arquivo,"Dias",dias);
                    DOF2_SetInt(arquivo,"Data",day);
                    format(stringZCMD, sizeof(stringZCMD), "AdmCmd: %s Ativou uma ORG VIP para a ORG:[%s], Tipo[%s], Dias[%d].",PlayerName(playerid),GetOrgName(org),lolz,dias);
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                }
                DOF2_SaveFile();
                LoadOrgs();
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao tem permissao para usar esse comando !");
            }
        }
        return 1;
    }
