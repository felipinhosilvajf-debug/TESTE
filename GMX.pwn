    CMD:spysms(playerid, params[])
    {
         if(PlayerInfo[playerid][pAdmin] >= 2)
         {
              if(AdminTrabalhando[playerid] < 1)
              {
                   SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                   return 1;
              }
              new player1;
              if(sscanf(params, "u", player1))
              {
                   SmsOffer[playerid] = 999;
                   SendClientMessage(playerid, COR_GRAD5, "{df5454}Ã—{ffffff} USE: /spysms [id], Voce desativou seu /spysms.");
                   return 1;
              }
              if(IsPlayerConnected(player1))
              {
                   SmsOffer[playerid] = player1;
                   format(stringZCMD, sizeof(stringZCMD), "Agora Voce esta espionando os sms do jogador: %s[%d]!", PlayerName(player1), player1);
                   SendClientMessage(playerid, COR_GRAD1, stringZCMD);
              }
         }
         else
         {
              SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando !");
              return 1;
         }
         return 1;
    }
    CMD:spypar(playerid, params[])
    {
         if(PlayerInfo[playerid][pAdmin] >= 1340)
         {
              new player1;
              if(sscanf(params, "u", player1))
              {
                   ParOffer[playerid] = 999;
                   SendClientMessage(playerid, COR_GRAD5, "{df5454}Ã—{ffffff} USE: /spypar [id], Voce desativou seu /spypar.");
                   return 1;
              }
              if(IsPlayerConnected(player1))
              {
                   if(PlayerInfo[player1][pAdmin] == 1342 && PlayerInfo[playerid][pAdmin] != 1342)
                   {
                       SendClientMessage(playerid, COR_GRAD1, "Voce nao pode espiar o particular do dono/scripter!");
                       return 1;
                   }
                   ParOffer[playerid] = player1;
                   format(stringZCMD, sizeof(stringZCMD), "Agora Voce esta espionando os particulares do admin: %s[%d]!", PlayerName(player1), player1);
                   SendClientMessage(playerid, COR_GRAD1, stringZCMD);
              }
         }
         else
         {
              SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando !");
              return 1;
         }
         return 1;
    }
    CMD:spyparall(playerid)
    {
         if(PlayerInfo[playerid][pAdmin] >= 1340)
         {
              if(IsPlayerConnected(playerid))
