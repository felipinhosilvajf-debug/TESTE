                             SendClientMessage(sscanfid, COR_LIGHTBLUE, "Tiroteio na Arena iniciado, tempo de duracao = 20 minutos, para sair, digite /sairevento !");
                        }
                        else if(TipoEvento == 4)
                        {
                             eventomansao[sscanfid] = 1;
                             PlayerInfo[sscanfid][pTiroteio] = 3;
                             SendClientMessage(sscanfid, COR_LIGHTBLUE, "Tiroteio na Mansao iniciado, tempo de duracao = 20 minutos, para sair, digite /sairevento !");
                        }
                        else if(TipoEvento == 5)
                        {
                             eventocarandiru[sscanfid] = 1;
                             PlayerInfo[sscanfid][pTiroteio] = 4;
                             SendClientMessage(sscanfid, COR_LIGHTBLUE, "Tiroteio no Carandiru iniciado, tempo de duracao = 20 minutos, para sair, digite /sairevento !");
                        }
                        else if(TipoEvento == 6)
                        {
                             eventoconst[sscanfid] = 1;
                             PlayerInfo[sscanfid][pTiroteio] = 5;
                             SendClientMessage(sscanfid, COR_LIGHTBLUE, "Tiroteio na Construcao iniciado, tempo de duracao = 20 minutos, para sair, digite /sairevento !");
                        }
                        else if(TipoEvento == 7)
                        {
                             eventodp[sscanfid] = 1;
                             PlayerInfo[sscanfid][pTiroteio] = 6;
                             SendClientMessage(sscanfid, COR_LIGHTBLUE, "Tiroteio no Departamento iniciado, tempo de duracao = 20 minutos, para sair, digite /sairevento !");
                        }
                        else if(TendoQuarentena == 1)
                        {
                            new QuantidadeHumanos, QuantidadeInfectados;
                            foreach(new i: Player)
                            {
                                if(EquipeQuarentena[i] == 1) QuantidadeHumanos++;
                                if(EquipeQuarentena[i] == 2) QuantidadeInfectados++;
                            }
                            if(QuantidadeHumanos < QuantidadeInfectados)
                            {
                                new vid = GetPlayerVehicleID(sscanfid);
                                SetVehicleToRespawn(vid);
                                new world;
                                world = GetPlayerVirtualWorld(sscanfid);
                                SetPlayerVirtualWorld(sscanfid,world);
                                ResetPlayerWeaponsEx(sscanfid);
                                SetPlayerArmour(sscanfid, 100);
                                SetPlayerHealth(sscanfid, 100);
                                SetPlayerInterior(sscanfid,0);
                                SetPlayerPos(sscanfid,1254.9434,2836.7817,11.9947);
                                LimiteEvento += 1;
                                EquipeQuarentena[sscanfid] = 1;
                                SetPlayerWeather(sscanfid, 9);
                                NaPorraDoEvento[sscanfid] = true;
                                TaNoQuarentena[sscanfid] = 1;
                                pClassiQuarentena[sscanfid] = 0;
                                ContagemQuarentena[sscanfid] = 41;
                                SetPlayerSkin(sscanfid, 23);
                                SetPlayerColor(sscanfid, COR_CV);
                                SendClientMessage(sscanfid, COR_LIGHTBLUE, "Voce foi teletransportado pelo ADMIN, para participar do evento, para sair, digite: /sairevento !");
                                if(LiberarInfectar == true)
                                {
                                    TextDrawShowForPlayer(sscanfid, TextDrawCQ);
                                }
                            }
                            else if(QuantidadeInfectados < QuantidadeHumanos)
                            {
                                new vid = GetPlayerVehicleID(sscanfid);
                                SetVehicleToRespawn(vid);
                                new world
                                world = GetPlayerVirtualWorld(sscanfid);
                                SetPlayerVirtualWorld(sscanfid,world);
                                ResetPlayerWeaponsEx(sscanfid);
                                SetPlayerArmour(sscanfid, 100);
                                SetPlayerHealth(sscanfid, 100);
                                SetPlayerInterior(sscanfid,0);
                                SetPlayerPos(sscanfid,1254.9434,2836.7817,11.9947);
                                LimiteEvento += 1;
                                EquipeQuarentena[sscanfid] = 2;
                                SetPlayerWeather(sscanfid, 9);
                                NaPorraDoEvento[sscanfid] = true;
                                TaNoQuarentena[sscanfid] = 1;
                                pClassiQuarentena[sscanfid] = 0;
                                ContagemQuarentena[sscanfid] = 41;
                                SetPlayerSkin(sscanfid, 162);
                                SetPlayerColor(sscanfid, COR_CV);
                                SendClientMessage(sscanfid, COR_LIGHTBLUE, "Voce foi teletransportado pelo ADMIN, para participar do evento, para sair, digite: /sairevento !");
                                if(LiberarInfectar == true)
                                {
                                    TextDrawShowForPlayer(sscanfid, TextDrawCQ);
                                }
                            }
                        }
                        NaPorraDoEvento[sscanfid] = true;
                        SpawnPlayer(sscanfid);
                        SendClientMessage(sscanfid, COR_VERMELHO, "Voce foi teletransportado pelo ADMIN, para participar do evento, para sair, digite: /sairevento !");
                        format(stringZCMD, sizeof(stringZCMD), "Jogador: %s foi colocado no evento que esta acontecendo, pelo admin: %s", PlayerName(sscanfid), PlayerName(playerid));
                        ABroadCast(COR_LIGHTRED,stringZCMD,1);
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Esse nao e um jogador ativo.");
            }
        }
        return 1;
    }
