            ShowPlayerDialog(playerid,100,DIALOG_STYLE_LIST,"Bar: {ffffff}RS","Dose de Absolut - R$30\nDose de BlueLabel - R$50\nMojito - R$30\nSexOnTheBeach - R$30\nIce - R$20\nRedBull - R$20\nCoca-Cola - R$10\nAgua - R$10","Confirmar","Cancelar");
