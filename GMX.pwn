START::RemoverAviao(playerid)
{
    if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
    DestroyObject(ObjetoAviao[playerid]);
    SetPlayerVirtualWorld(playerid, 0);
    TogglePlayerSpectating(playerid, false);
    SetTimerEx("SetPlayerSpawn", 1000, false, "i", playerid);
    SetPlayerSpawn(playerid);
    SetPlayerCheckpoint(playerid, 1480.8490,-1765.7736,18.7958, 8.0);
    /*SendClientMessage(playerid, COR_GRO, "|____________ | BHC Info |____________|");
    SendClientMessage(playerid, COR_GRO, "{FFFFFF}Adicione IP aos favoritos: {9acd32}");
    SendClientMessage(playerid, COR_GRO, "{FFFFFF}Donos: {9acd32}VBSTAFF & VBSTAFF_");
    SendClientMessage(playerid, COR_GRO, "{33aa33}---------------------------------------------------------------------------------");
    SendClientMessage(playerid, COR_CV, "[Aviso]  Siga o icone vermelho marcado no mapa!");*/
    if(BonusBPS == true)
    {
        PlayerInfo[playerid][pLevel] = 4;
        ResetPlayerMoneyEx(playerid);
        GivePlayerMoneyEx(playerid, 80000);
        SendClientMessage(playerid, 0x3FCFFFFF, "Voce foi bonificado com 4 Leveis e R$80.000");
    }
    else if(BonusBPS == false)
    {
        PlayerInfo[playerid][pLevel] = 2;
        ResetPlayerMoneyEx(playerid);
        GivePlayerMoneyEx(playerid, 6000);
        SendClientMessage(playerid, 0x3FCFFFFF, "Voce foi bonificado com 2 Leveis e R$6.000");
    }
    PlayerInfo[playerid][pPayDay] = 0;
    PlayerInfo[playerid][pMinutos] = 30;
    PlayerInfo[playerid][pSegundos] = 59;
    format(gstring, sizeof(gstring), "[TUTORIAL] %s concluiu o tutorial, de as boas vindas !", PlayerName(playerid));
    ABroadCast(COR_LIGHTRED,gstring,1);
    MEGAString[0] = EOS;
    PlayerInfo[playerid][pFome] = 100;
    PlayerInfo[playerid][pSede] = 100;
    MEGAString[0] = EOS;
    strcat(MEGAString, "{fa4c4c}Alerta: {818689}Deseja deixar o sistema de Fome e Sede {00ff00}ATIVO {ffffff}?\n\n{00ffff}Obs: {ffffff}Com o sistema ativo Voce recebe mais experiencias por Cada Salario(Pay Day).\nVoce podera inverter essa configuracao posteriomente utilizando o comando\n(/configuracoes).\n\n{818689}Escolha uma Opcao Abaixo:");
    ShowPlayerDialog(playerid, 170, DIALOG_STYLE_MSGBOX, "Sistema de Fome e Sede:", MEGAString, "Ativado","Desativado");
}
