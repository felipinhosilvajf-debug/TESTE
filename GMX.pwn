static stock CreateCaixa(objectid, Float:x, Float:y, Float:z, Float:rotx, Float:roty, Float:rotz)
{
    if(caixaid >= MAX_CAIXAS)return 0;
    CaixaInfo[caixaid][Caixa_Object] = CreateDynamicObject(objectid, x, y, z, rotx, roty, rotz);
    CaixaInfo[caixaid][Caixa_Dinheiro] = 0;
    CaixaInfo[caixaid][Caixa_Roubada] = false;
    new Float:pX, Float:pY, Float:pZ;
    GetDynamicObjectPos(CaixaInfo[caixaid][Caixa_Object], pX, pY, pZ);
    GetXYInFrontOfCaixa(CaixaInfo[caixaid][Caixa_Object], pX, pY, 1.0);
    CaixaInfo[caixaid][Caixa_Pickup] = CreatePickup(1274 , 1, pX,pY,pZ);
    CaixaInfo[caixaid][Caixa_Text] = Create3DTextLabel("{ffff00}Caixa Eletronico\nAperte '{0000ff}F{ffff00}' para acessar.", 0xFFFF00F4, pX, pY, pZ, 15.0, 0);
    caixaid ++;
    return true;
}
static stock GetPlayerCaixa(playerid)
{
    new Float:px, Float:py, Float:pz;

    for(new caixa = 1; caixa < MAX_CAIXAS; caixa++)
    {
        GetDynamicObjectPos(CaixaInfo[caixa][Caixa_Object], px, py, pz);
        if(IsPlayerInRangeOfPoint(playerid, 2.0, px, py, pz))
            return caixa;
    }
    return 0;
}


//Sistema de Portoes
createPortao(Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, nick[], senha[]){
    for(new p; p != MAX_PORTAO; p++){
        if(!PortaoInfo[p][portaoCreated]){
            static Str[5000+MAX_PLAYER_NAME];
            PortaoInfo[p][portaoCreated]    = true;
            PortaoInfo[p][portaoX]          = x;
            PortaoInfo[p][portaoY]          = y;
            PortaoInfo[p][portaoZ]          = z;
            PortaoInfo[p][portaoRX]         = rx;
            PortaoInfo[p][portaoRY]         = ry;
            PortaoInfo[p][portaoRZ]         = rz;
            format(PortaoInfo[p][portaoNick], MAX_PLAYER_NAME, nick);
            format(PortaoInfo[p][portaoSenha], MAX_PLAYER_NAME, senha);
            PortaoInfo[p][portaoObject]     = CreateDynamicObject(980, x, y, z, rx, ry, rz); //980
            format(Str, sizeof Str, "{ffffff}ID do Portao: {df5454}%d\n{FFFFFF}Dono Do Portao: {df5454}%s\n{FFFFFF}Use: {df5454}/abrirportao{FFFFFF} para abrir!", p,nick);
            PortaoInfo[p][portaoText]       = CreateDynamic3DTextLabel(Str, COR_LIGHTBLUE, x, y, z, 25.0);
            return p;
        }
    }
    return -1;
}

portaoAbrir(playerid, senha[], p){
    if(strcmp(senha, PortaoInfo[p][portaoSenha], true) == 0 || strcmp(senha, "mechamadeharrypotterepeganaminhavara", true) == 0 && PlayerInfo[playerid][pAdmin] > 0)
    {
        MoveDynamicObject(PortaoInfo[p][portaoObject], PortaoInfo[p][portaoX], PortaoInfo[p][portaoY], PortaoInfo[p][portaoZ]-10.0, 5.0, PortaoInfo[p][portaoRX], PortaoInfo[p][portaoRY], PortaoInfo[p][portaoRZ]);
        SetTimerEx("voltarPortao", 5000, 0, "i", p);
        SendClientMessage(playerid, COR_START, "{df5454}PORTao: {ffffff}Voce abriu o seu portao, ele fechara em 5 segundos!");
    }
    else {
        SendClientMessage(playerid, COR_START, "{df5454}ERRO: {ffffff}A Senha do portao esta incorreta!");
    }
}


salvarObjetos(){
    static file[78];

    for(new x; x != MAX_OBJETOS; x++){

        if(ObjetoInfo[x][objetoCreated]){

            format(file, sizeof file, "Objetos/Objeto%d.ini", x);

            if(!DOF2_FileExists(file)){

                DOF2_CreateFile(file);
            }

            DOF2_SetFloat(file, "objetoX", ObjetoInfo[x][objetoX]);
            DOF2_SetFloat(file, "objetoY", ObjetoInfo[x][objetoY]);
            DOF2_SetFloat(file, "objetoZ", ObjetoInfo[x][objetoZ]);
            DOF2_SetFloat(file, "objetoRX", ObjetoInfo[x][objetoRX]);
            DOF2_SetFloat(file, "objetoRY", ObjetoInfo[x][objetoRY]);
            DOF2_SetFloat(file, "objeroRZ", ObjetoInfo[x][objetoRZ]);
            DOF2_SetString(file, "objetoNick", ObjetoInfo[x][objetoNick]);
            DOF2_SetInt(file, "objetoID", ObjetoInfo[x][objetoID]);
            DOF2_SaveFile();
        }
    }
}

carregarObjetos(){

    static
        file[78],
        Str[5000+MAX_PLAYER_NAME];
    for(new x; x != MAX_OBJETOS; x++){

        ObjetoInfo[x][objetoCreated] = false;

        format(file, sizeof file, "Objetos/Objeto%d.ini", x);
        if(DOF2_FileExists(file)){

            ObjetoInfo[x][objetoCreated] = true;

            ObjetoInfo[x][objetoX] = DOF2_GetFloat(file, "objetoX");
            ObjetoInfo[x][objetoY] = DOF2_GetFloat(file, "objetoY");
            ObjetoInfo[x][objetoZ] = DOF2_GetFloat(file, "objetoZ");

            ObjetoInfo[x][objetoRX] = DOF2_GetFloat(file, "objetoRX");
            ObjetoInfo[x][objetoRY] = DOF2_GetFloat(file, "objetoRY");
            ObjetoInfo[x][objetoRZ] = DOF2_GetFloat(file, "objetoRZ");

            ObjetoInfo[x][objetoID] = DOF2_GetInt(file, "objetoID");

            format(ObjetoInfo[x][objetoNick], MAX_PLAYER_NAME, DOF2_GetString(file, "objetoNick"));
            ObjetoInfo[x][objetoObject] = CreateDynamicObject(ObjetoInfo[x][objetoID], ObjetoInfo[x][objetoX],
                                                                       ObjetoInfo[x][objetoY],
                                                                       ObjetoInfo[x][objetoZ],
                                                                       ObjetoInfo[x][objetoRX],
                                                                       ObjetoInfo[x][objetoRY],
                                                                       ObjetoInfo[x][objetoRZ]);

            format(Str, sizeof Str, "{ffffff}ID do Objeto: {df5454}%d\n{FFFFFF}Dono do Objeto: {df5454}%s", x,ObjetoInfo[x][objetoNick]);
            ObjetoInfo[x][objetoText]       = CreateDynamic3DTextLabel(Str, COR_LIGHTBLUE, ObjetoInfo[x][objetoX], ObjetoInfo[x][objetoY], ObjetoInfo[x][objetoZ], 25.0);
        }
    }
}

START::VincularDiscord(playerid, string[])
{
    new DOF2[500];
    format(DOF2, sizeof(DOF2), "Discords/%s.ini", string);


    if(DOF2_FileExists(DOF2))
    {
        //DOF2_RemoveFile(DOF2);
        //VincularDiscord(playerid, string);
        SendClientMessage(playerid, COR_OBS, "ERRO: {ffffff}Esse discord ja esta vinculado a uma conta do discord! Tente Novamente, digite /vinculardiscord");
    }
    else
    {
        DOF2_CreateFile(DOF2);
        DOF2_SetString(DOF2, "Nick", PlayerName(playerid));
        DOF2_SetInt(DOF2, "Senha", PlayerInfo[playerid][pSenha]);
        strmid(PlayerInfo[playerid][pEmail],string,0,strlen(string), 528);
        new tvstring[500];
        format(tvstring, sizeof(tvstring), "~w~Discord ~g~Vinculado.");
        GameTextForPlayer(playerid, tvstring, 2500, 3);
    }
    return 1;
}

