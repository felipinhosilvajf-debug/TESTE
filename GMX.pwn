stock TentouDivulgar(string[])
{
    new x=0;
    for (new i = 0, j = strlen(string); i <= j; ++i)
    {
        if (string[i] >= 46 && string[i] <= 58)
        {
            x+=1;
        }
    }
    if(x >= 8) return 1;
    if(strfind(string, "67", true) != -1 || strfind(string, "75", true) != -1 || strfind(string, "91", true) != -1 || strfind(string, "109", true) != -1
    || strfind(string, "112", true) != -1 || strfind(string, "120", true) != -1 || strfind(string, "121", true) != -1 || strfind(string, "124", true) != -1|| strfind(string, "157", true) != -1 || strfind(string, "157", true) != -1 || strfind(string, "167", true) != -1 ||  strfind(string, "168", true) != -1
    || strfind(string, "168", true) != -1 || strfind(string, "1 6 8", true) != -1 || strfind(string, "169", true) != -1 ||  strfind(string, "1 6 9", true) != -1|| strfind(string, "172", true) != -1 || strfind(string, "175", true) != -1 || strfind(string, "178", true) != -1 ||  strfind(string, "189", true) != -1
    || strfind(string, "1 8 9", true) != -1 || strfind(string, "192", true) != -1 || strfind(string, "199", true) != -1 ||  strfind(string, "201", true) != -1|| strfind(string, "2 0 1", true) != -1 || strfind(string, "205", true) != -1 || strfind(string, "211", true) != -1 ||  strfind(string, "212", true) != -1
    || strfind(string, "232", true) != -1 || strfind(string, "238", true) != -1 || strfind(string, "242", true) != -1 ||  strfind(string, "254", true) != -1|| strfind(string, "BPF", true) != -1 || strfind(string, "B P F", true) != -1 || strfind(string, "BPG", true) != -1 || strfind(string, "VBR", true) != -1 ||  strfind(string, "B P G", true) != -1
    || strfind(string, "BPF", true) != -1 || strfind(string, "B PF", true) != -1 || strfind(string, "BP G", true) != -1 ||  strfind(string, "B PG", true) != -1|| strfind(string, "BPF", true) != -1 || strfind(string, "BPU", true) != -1 || strfind(string, "B P U", true) != -1 ||  strfind(string, "playultimate", true) != -1
    || strfind(string, "7717", true) != -1 || strfind(string, "7777", true) != -1 || strfind(string, "B P U", true) != -1 ||  strfind(string, "BPC", true) != -1|| strfind(string, "STOOOPFLOOD", true) != -1 || strfind(string, "7779", true) != -1 || strfind(string, "Brasil Play", true) != -1 ||  strfind(string, "Brasilplay", true) != -1)
