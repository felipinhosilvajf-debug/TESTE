   // == [ Carregar Itens Comprados ] == //
    new arquivo[64];
    new string[20];
    format(arquivo, sizeof(arquivo), Pasta_CAcessorio,PlayerName(playerid));
    if(DOF2_FileExists(arquivo))
    {
        for(new x;x<MAX_PLAYER_ATTACHED_OBJECTS-1;x++)
        {
                format(string, sizeof(string), "modelid%d",x);
                new modelid = DOF2_GetInt(arquivo, string);
                if(modelid != 0)
                {
                    format(string, sizeof(string), "boneid%d",x);
                    new bone = DOF2_GetInt(arquivo, string);
                    format(string, sizeof(string), "fOffsetX%d",x);
                    new Float:fOffsetX = DOF2_GetFloat(arquivo, string);
                    format(string, sizeof(string), "fOffsetY%d",x);
                    new Float:fOffsetY = DOF2_GetFloat(arquivo, string);
                    format(string, sizeof(string), "fOffsetZ%d",x);
                    new Float:fOffsetZ = DOF2_GetFloat(arquivo, string);
                    format(string, sizeof(string), "fRotX%d",x);
                    new Float:fRotX = DOF2_GetFloat(arquivo, string);
                    format(string, sizeof(string), "fRotY%d",x);
                    new Float:fRotY = DOF2_GetFloat(arquivo, string);
                    format(string, sizeof(string), "fRotZ%d",x);
                    new Float:fRotZ = DOF2_GetFloat(arquivo, string);
                    format(string, sizeof(string), "fScaleX%d",x);
                    new Float:fScaleX = DOF2_GetFloat(arquivo, string);
                    format(string, sizeof(string), "fScaleY%d",x);
                    new Float:fScaleY = DOF2_GetFloat(arquivo, string);
                    format(string, sizeof(string), "fScaleZ%d",x);
                    new Float:fScaleZ = DOF2_GetFloat(arquivo, string);
                    SetPlayerAttachedObject(playerid, x, modelid, bone, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ, 0xffffffff, 0xffffffff);
                }
        }
    }
    if(TaEscutando[playerid] > 0) SetPlayerAttachedObject(playerid, 9, 19421, 2, 0.050000, -0.014999, 0.000000, 95.000000, 183.000000, 89.000000, 1, 1, 1, 0xffffffff);
    if(AdminTrabalhando[playerid] > 0) ColocarAureola(playerid);
    SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
}

START:: mostrarTelaMobile(playerid)
{
    showTelaLogin(playerid);
    return 1;
}

START:: mostrarTelaLogin(playerid)
{
    if(CarregandoTelaLogin[playerid] < 101)
    {
        new StringHH[500];
        format(StringHH, 250, "Contas/%s.ini", PlayerName(playerid));
        PlayerInfo[playerid][pLogouVezHora] = DOF2_GetInt(StringHH, "Logou Vez");
        TogglePlayerSpectating(playerid, 1);
        if(PlayerInfo[playerid][pLogouVezHora] == 0)
        {
            if(MusicaLogin == true)
            {
                PlayAudioStreamForPlayer(playerid, "http://dl.dropboxusercontent.com/s/kk9e6t6qwg9npxb/Intro_11.mp3");
            }
            InterpolateCameraPos(playerid, 1153.7322, -1740.5629, 13.4129, 1153.7322, -1740.5629, 13.4129, 9000);
			InterpolateCameraLookAt(playerid, 1153.7322, -1740.5629, 13.4129, 1153.7322, -1740.5629, 13.4129, 9000);
        }
        else if(PlayerInfo[playerid][pLogouVezHora] == 1)
        {
            if(MusicaLogin == true)
            {
                PlayAudioStreamForPlayer(playerid, "http://dl.dropboxusercontent.com/s/95ogee9cd6tsghz/prefeitura.mp3");
            }
            InterpolateCameraPos(playerid, -1413.795043, -991.277465, 210.395874, -1423.937744, -958.565490, 202.312347, 9000);
            InterpolateCameraLookAt(playerid, -1415.236206, -986.629516, 209.247283, -1425.378906, -953.917541, 201.163757, 9000);
        }
        CarregandoTelaLogin[playerid]++;
        new newtext[80];
        format(newtext, sizeof(newtext), "Progresso:_%d%", CarregandoTelaLogin[playerid]);
        PlayerTextDrawSetString(playerid, loadTela6[playerid], newtext);
    }
    if(CarregandoTelaLogin[playerid] >= 101)
    {
        TextDrawHideForPlayer(playerid, loadTela1);
        TextDrawHideForPlayer(playerid, loadTela2);
        TextDrawHideForPlayer(playerid, loadTela3);
        TextDrawHideForPlayer(playerid, loadTela4);
        TextDrawHideForPlayer(playerid, loadTela5);
        PlayerTextDrawHide(playerid, loadTela6[playerid]);
        TogglePlayerSpectating(playerid, 1);
        ClearChatbox(playerid, 10);
        SendClientMessage(playerid, COR_GREY, "* Dados Carregados com sucesso, pressione em 'Fazer Login' ou digite: /logar !");
        KillTimer(TimerLogin[playerid]);
        if(PlayerInfo[playerid][pLogouVezHora] == 0)
        {
            InterpolateCameraPos(playerid, 1153.7322, -1740.5629, 13.4129, 1153.7322, -1740.5629, 13.4129, 9000);
			InterpolateCameraLookAt(playerid, 1153.7322, -1740.5629, 13.4129, 1153.7322, -1740.5629, 13.4129, 9000);
            if(MusicaLogin == true)
            {
                PlayAudioStreamForPlayer(playerid, "http://dl.dropboxusercontent.com/s/kk9e6t6qwg9npxb/Intro_11.mp3");
            }
            PlayerInfo[playerid][pLogouVezHora] = 1;
            PlayerPlaySound(playerid, 1134, 0.0, 0.0, 0.0);
        }
        else if(PlayerInfo[playerid][pLogouVezHora] == 1)
        {
            InterpolateCameraPos(playerid, -1413.795043, -991.277465, 210.395874, -1423.937744, -958.565490, 202.312347, 9000);
            InterpolateCameraLookAt(playerid, -1415.236206, -986.629516, 209.247283, -1425.378906, -953.917541, 201.163757, 9000);
            PlayerInfo[playerid][pLogouVezHora] = 0;
            PlayerPlaySound(playerid, 1134, 0.0, 0.0, 0.0);
            if(MusicaLogin == true)
            {
                PlayAudioStreamForPlayer(playerid, "http://dl.dropboxusercontent.com/s/95ogee9cd6tsghz/prefeitura.mp3");
            }
            PlayerInfo[playerid][pLogouVezHora] = 0;
        }
        CarregarRegistro(playerid);
        mostrarTelaMobile(playerid);
    }
    return 1;
}

static stock CreateTextDraws(playerid)
{



    Conquistas[0] = TextDrawCreate(7.013214, 132.499603, "box");
    TextDrawLetterSize(Conquistas[0], 0.000000, 4.612007);
    TextDrawTextSize(Conquistas[0], 230.000000, 0.000000);
