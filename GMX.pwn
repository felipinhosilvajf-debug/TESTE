    CMD:mervarma(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(!IsPlayerInMotel(playerid))
            {
                return 1;
            }
            if(PlayerInfo[playerid][pMats] == 0)
            {
                return 1;
            }
            if (PlayerInfo[playerid][pMembro] != 21 && PlayerInfo[playerid][pLider] != 21 && PlayerInfo[playerid][pMembro] != 24 && PlayerInfo[playerid][pLider] != 24 && PlayerInfo[playerid][pMembro] != 29 && PlayerInfo[playerid][pLider] != 29)
            {
                SendClientMessage(playerid,COR_GREY,"Voce nao e de nenhuma Organizacao Mercenaria!");
                return 1;
            }
            new x_weapon[32],weapon[MAX_PLAYERS],ammo[MAX_PLAYERS],price[MAX_PLAYERS];
            if(sscanf(params, "us[32]", sscanfid, x_weapon))
            {
                SendClientMessage(playerid,COR_EXE,"_________________________________________________");
                SendClientMessage(playerid,COR_BRANCO,"*** Vender Armas - Mercenarios ***");
                SendClientMessage(playerid,COR_GRAD1,"{df5454}Ã—{ffffff} USE: /mervarma [ID do Player] [nome da arma]");
                SendClientMessage(playerid,COR_GREY,"Armas: cargaexplosiva(2000 materiais) -  5 balas");
                SendClientMessage(playerid,COR_GREY,"Armas: faca(4000 materiais)");
                SendClientMessage(playerid,COR_EXE,"_________________________________________________");
                return 1;
            }
            if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se vender armas !"); return 1; }
            if (IsPlayerConnected(sscanfid))
            {
                if(IsACop(sscanfid))
                {
                    SendClientMessage(playerid,COR_GRAD1,"Voce nao pode vender armas para policiais !");
                    return 1;
                }
                if(!PlayerInfo[sscanfid][pGunLic])
                {
                    SendClientMessage(playerid,COR_GRAD1,"Este jogador nao possui licenca de armas !");
                    return 1;
                }
                if(GetPlayerOrg(sscanfid) == 21 || GetPlayerOrg(playerid) == 24 || GetPlayerOrg(playerid) == 29)
                {
                    SendClientMessage(playerid,COR_GRAD1,"Voce nao pode vender armas para outros mercenarios !");
                    return 1;
                }
                if(strcmp(x_weapon,"cargaexplosiva",true) == 0) { if(PlayerInfo[playerid][pMats] > 2000) { weapon[playerid] = 39; price[playerid] = 2000; ammo[playerid] = 5; PlayerInfo[sscanfid][pGun2] = 39; PlayerInfo[sscanfid][pAmmo2] = 5; } else { SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender esta arma!"); return 1; } }
                else if(strcmp(x_weapon,"faca",true) == 0) { if(PlayerInfo[playerid][pMats] > 4000) { weapon[playerid] = 4; price[playerid] = 1500; ammo[playerid] = 1; PlayerInfo[sscanfid][pGun2] = 4; PlayerInfo[sscanfid][pAmmo2] = 1; } else { SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender esta arma!"); return 1; } }
                else { SendClientMessage(playerid,COR_GREY,"Nome da arma invalida!"); return 1; }
                if (ProxDetectorS(5.0,playerid,sscanfid))
                {
                    ConsumingMoney[playerid] = 1;
                    GetPlayerName(sscanfid,giveplayerZCMD,sizeof(giveplayerZCMD));
                    GetPlayerName(playerid,sendername,sizeof(sendername));
                    format(stringZCMD,sizeof(stringZCMD),"Voce vendeu uma %s com %d municoes, e custou %d Materiais .",x_weapon,ammo[playerid],price[playerid]);
                    PlayerPlaySound(playerid,1052,0.0,0.0,0.0);
                    SendClientMessage(playerid,COR_LIGHTBLUE,stringZCMD);
                    format(stringZCMD,sizeof(stringZCMD),"Voce recebeu uma %s com %d municoes do Mercenario %s.",x_weapon,ammo[playerid],sendername);
                    SendClientMessage(sscanfid,COR_LIGHTBLUE,stringZCMD);
                    PlayerPlaySound(sscanfid,1052,0.0,0.0,0.0);
                    format(stringZCMD,sizeof(stringZCMD),"* %s vendeu armas para %s.",sendername ,giveplayerZCMD);
                    ProxDetector(30.0,playerid,stringZCMD,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    GivePlayerWeaponEx(sscanfid,weapon[playerid],ammo[playerid]);
                    PlayerInfo[playerid][pMats] -= price[playerid];
                    //SaveVendas();
                }
                else
                {
                    SendClientMessage(playerid,COR_GRAD1,"O cliente nao esta proximo de Voce.");
                    return 1;
                }
            }
            else
            {
                format(stringZCMD,sizeof(stringZCMD),"%d nao esta online este player.",sscanfid);
                SendClientMessage(playerid,COR_GRAD1,stringZCMD);
            }
        }
        return 1;
    }
