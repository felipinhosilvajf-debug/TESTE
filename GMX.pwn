                        if(quantia < 1 || quantia > 10000)
                        {
                            SendClientMessage(playerid, COR_GRAD2, "nao pode pegar menos de 1 e nem mais de 10000");
                            return 1;
                        }
                        if(PlayerInfo[playerid][pSafeDrogas2] >= quantia)
                        {
                            for(new i=0; i<75; i++)
                            {
                                if(InventarioInfo[playerid][i][iSlot] == 19382)
                                {
                                    InventarioInfo[playerid][i][iSlot] = 1279;
                                    InventarioInfo[playerid][i][iUnidades] = quantia;
                                    break;
                                }
                            }
                            PlayerInfo[playerid][pSafeDrogas2] = PlayerInfo[playerid][pSafeDrogas2]-quantia;
                            format(gstring, sizeof(gstring), "* Voce pegou %d gramas de cocaina no esconderijo!",quantia);
                            SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                            return 1;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_GRAD2, "Voce nao tem tudo isso!");
                            return 1;
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao e um Gangster!");
                        return 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao esta em um territorio de drogas! /gps");
                    return 1;
                }
            }
            if(strcmp(item,"slsd",true) == 0)
            {
                if(PlayerToPoint(2.0, playerid, 2151.7317,-1014.5330,62.7614) || PlayerToPoint(2.0, playerid, 1916.9713,-1415.4165,13.8283) || PlayerToPoint(2.0, playerid, 1971.4496,-1198.3518,20.5492))
                {
                    if(IsAGangster(playerid) || PlayerInfo[playerid][pEmprego] == 13)
                    {
                        if(quantia < 1 || quantia > 10000)
                        {
                            SendClientMessage(playerid, COR_GRAD2, "nao pode pegar menos de 1 e nem mais de 10000");
                            return 1;
                        }
                        if(PlayerInfo[playerid][pSafeDrogas4] >= quantia)
                        {
                            for(new i=0; i<75; i++)
                            {
                                if(InventarioInfo[playerid][i][iSlot] == 19382)
                                {
                                    InventarioInfo[playerid][i][iSlot] = 1576;
                                    InventarioInfo[playerid][i][iUnidades] = quantia;
                                    break;
                                }
                            }
                            PlayerInfo[playerid][pSafeDrogas4] = PlayerInfo[playerid][pSafeDrogas4]-quantia;
                            format(gstring, sizeof(gstring), "* Voce pegou %d gramas de lsd no esconderijo!",quantia);
                            SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                            return 1;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_GRAD2, "Voce nao tem tudo isso!");
                            return 1;
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao e um Gangster!");
                        return 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao esta em um territorio de drogas! /gps");
                    return 1;
                }
            }
            if(strcmp(item,"smateriais",true) == 0)
            {
                if(PlayerToPoint(2.0, playerid, 1173.2739,-2037.0060,69.1413) || PlayerToPoint(2.0, playerid, 1757.1095,-1943.4386,13.5703) || PlayerToPoint(2.0, playerid, -718.2471,-1938.9644,8.3187) || PlayerToPoint(5.0, playerid, -13.5814, -2502.1829, 36.6555))
                {
                    if(quantia < 1 || quantia > 10000)
                    {
                        SendClientMessage(playerid, COR_GRAD2, "nao pode pegar menos de 1 e nem mais de 10000");
                        return 1;
                    }
                    if(PlayerInfo[playerid][psMats] >= quantia)
                    {
                        PlayerInfo[playerid][pMats] = PlayerInfo[playerid][pMats]+quantia;
                        PlayerInfo[playerid][psMats] = PlayerInfo[playerid][psMats]-quantia;
                        format(gstring, sizeof(gstring), "* Voce pegou %d materiais no esconderijo!",quantia);
                        SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                        return 1;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao tem tudo isso !");
                        return 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao esta na caixa de materiais !");
                    return 1;
                }
            }
        }
        return 1;
    }
    CMD:kitvip(playerid, params[])  return ForT:kitivip(playerid, params);
    CMD:kitivip(playerid, x_kitvip[])
    {
        if(PlayerToPoint(8.0,playerid,312.6666,-165.8033,999.6010) || PlayerToPoint(8.0, playerid,295.9569,-80.4102,1001.5156) || PlayerToPoint(8.0, playerid,308.3599,-141.0120,999.6016))
        {
            if(Roubando[playerid] == 1)
            {
                SendClientMessage(playerid, -1, "Voce nao pode usar este comando estando roubando!");
            }
            if(PlayerInfo[playerid][pGunLic] == 0)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao possui licencas de armas por isso nao pode ir equipar !");
                return 1;
            }
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(PlayerInfo[playerid][pVIP] > 0)
            {
                if(isnull(x_kitvip))
                {
                    SendClientMessage(playerid, COR_BRANCO, "|__________________ KitVIP. __________________|");
                    SendClientMessage(playerid, COR_BRANCO, "|Use: /kitvip [Numero]");
                    SendClientMessage(playerid, COR_GREY, "| 1 - VIP Comum");
                    SendClientMessage(playerid, COR_GREY, "| 2 - VIP Premium");
                    SendClientMessage(playerid, COR_BRANCO, "|____________________________________________|");
                    return 1;
                }
                if(strcmp(x_kitvip,"1",true) == 0)
                {
                    if(PlayerInfo[playerid][pVIP] >= 1)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "* O Vip Comum %s Pegou Seu Kit Comum.", sendername);
                        ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        ResetPlayerWeaponsEx(playerid);
                        GivePlayerWeaponEx(playerid, 46, 1);//paraquedas
                        GivePlayerWeaponEx(playerid, 18, 2); //Molotov
                        GivePlayerWeaponEx(playerid, 34, 30); //Sniper
                        GivePlayerWeaponEx(playerid, 31, 140);//m-4
                        GivePlayerWeaponEx(playerid, 29, 140);//mp5
                        GivePlayerWeaponEx(playerid, 25, 70); //12
                        GivePlayerWeaponEx(playerid, 24, 70); //eagle
                        GivePlayerWeaponEx(playerid, 1, 1); //soqueira
                        SetPlayerArmour(playerid, 100);
                        SetPlayerHealth(playerid, 100);
                        SendClientMessage(playerid,COR_GREEN,"Voce pegou o seu Kit Comum!");
                    }
                    return 1;
                }
                if(strcmp(x_kitvip,"2",true) == 0)
                {
                    if(PlayerInfo[playerid][pVIP] >= 2)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "* O Vip Premium %s Pegou Seu Kit Premium.", sendername);
                        ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        ResetPlayerWeaponsEx(playerid);
                        GivePlayerWeaponEx(playerid, 46, 1);//paraquedas
                        GivePlayerWeaponEx(playerid, 18, 3); //Molotov
                        GivePlayerWeaponEx(playerid, 34, 40); //Sniper
                        GivePlayerWeaponEx(playerid, 31, 160);//m-4
                        GivePlayerWeaponEx(playerid, 29, 160);//mp5
                        GivePlayerWeaponEx(playerid, 25, 80); //12
                        GivePlayerWeaponEx(playerid, 24, 80); //eagle
                        GivePlayerWeaponEx(playerid, 1, 1); //soqueira
                        SetPlayerArmour(playerid, 100);
                        SetPlayerHealth(playerid, 100);
                        SendClientMessage(playerid,COR_GREEN,"Voce pegou o seu Kit Premium!");
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_LIGHTBLUE, "Esse comando so pode ser usado por jogadores Vips");
                return 1;
            }
        }
        else
        {
            SendClientMessage(playerid, COR_LIGHTRED, "Voce nao esta em uma loja de armas.");
            return 1;
        }
        return 1;
    }
    CMD:kit(playerid, params[])
    {
        if(PlayerInfo[playerid][pSocio] > 0)
        {
            if(PlayerInfo[playerid][pKitAlternado] == 0)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce alternou para o kit 2(lanca chamas, molotov e ak-47)!");
                PlayerInfo[playerid][pKitAlternado] = 1;
                return 1;
            }
            if(PlayerInfo[playerid][pKitAlternado] > 0)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce alternou para o kit 1(bazuca, granada e m4)!");
                PlayerInfo[playerid][pKitAlternado] = 0;
                return 1;
            }
        }
        else
        {
            return SendClientMessage(playerid, COR_AMARELO, "Voce nao e um socio");
        }
        return 1;
    }
    CMD:destruirmedkit(playerid, params[])
    {
        if(MedKitDados[playerid][MedPlayer] != true) return SendClientMessage(playerid, -1, "Voce nao criou um medkit");
        DestruirMedKit(playerid);
        return 1;
    }
    CMD:kitsocio(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pSocio] == 0)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce nao e um socio!");
                return true;
            }
            if(GetTickCount() - TempoEquiparSocio[playerid] < 4000)
            {
                SendClientMessage(playerid,COR_GRAD1,"Voce so pode usar este comando a cada 4 segundos.");
                return 1;
            }
            if(Algemado[playerid] == 1)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce nao pode usar seu kit algemado!");
                return 1;
            }
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_AMARELO,"Voce nao pode usar seu kit neste local!");
                return 1;
            }
            if(Roubando[playerid] == 1)
            {
                SendClientMessage(playerid,COR_GRAD1,"Voce nao pode utilizar seu kit durante o roubo.");
                return 1;
            }
            if(PlayerToPoint(80.0,playerid,-2312.8008,-1642.6188,483.7031) || PlayerToPoint(80.0,playerid,-2339.3459,-1645.2610,483.7031) ||PlayerToPoint(80.0,playerid,-2326.0491,-1579.8934,483.3037)
            || PlayerToPoint(80.0,playerid,-2346.4478,-1582.4911,484.6091) || IsPlayerInChuck(playerid))
            {
                SendClientMessage(playerid,COR_AMARELO,"Voce nao pode usar seu kit neste local!");
