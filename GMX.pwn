    CMD:acarro(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando !");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new vid = GetPlayerVehicleID(playerid);
            if(IsPlayerInVehicle(playerid, vid))
            {
                format(stringZCMD, sizeof(stringZCMD), "Adm-Cmd: Veiculo %s(ID: **) foi abastecido por: %s!", getVehicleName(GetPlayerVehicleID(playerid)), PlayerName(playerid));
                ABroadCast(COR_OBS,stringZCMD,1);
                Gas[vid] = 100;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta dentro de nenhum carro!");
            }
        }
        return 1;
    }
    CMD:bcarro(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando !");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new vid = GetPlayerVehicleID(playerid);
            if(IsPlayerInVehicle(playerid, vid))
            {
                format(stringZCMD, sizeof(stringZCMD), "Adm-Cmd: %s(ID: **) foi blindado por: %s!", getVehicleName(GetPlayerVehicleID(playerid)), PlayerName(playerid));
                ABroadCast(COR_OBS,stringZCMD,1);
                Quebrado[vid] = 0;
                Vuln[vid] = MaxVuln;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta dentro de nenhum carro!");
            }
        }
        return 1;
    }
    CMD:rcarro(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando !");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new vid = GetPlayerVehicleID(playerid);
            if(IsPlayerInVehicle(playerid, vid))
            {
                format(stringZCMD, sizeof(stringZCMD), "Adm-Cmd: %s(ID: **) foi reparado por: %s!", getVehicleName(GetPlayerVehicleID(playerid)), PlayerName(playerid));
                ABroadCast(COR_OBS,stringZCMD,1);
                Quebrado[vid] = 0;
                RepairVehicle(vid);
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta dentro de nenhum carro!");
            }
        }
        return 1;
    }
