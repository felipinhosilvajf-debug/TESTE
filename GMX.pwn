                            {
                                PlayerInfo[sscanfid][pDrogasSkill] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou nivel de drogas:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 13:
                            {
                                PlayerInfo[sscanfid][pAvisos] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou avisos:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
