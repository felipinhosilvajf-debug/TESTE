                            {
                                pCheckInfoOrg[playerid] = 0;
                                return 1;
                            }
                        }
                    }
                }
            }
        }
        if(pCheckInfoOrg[playerid] >= 1)
        {
            if(PlayerInfo[playerid][pMembro] > 0 || PlayerInfo[playerid][pLider] > 0)
            {
                if(DeslogandoSocio[playerid] == 1) { return 1; }
                if(lideradmin[playerid] == 1) { return 1; }
                if(PlayerInfo[playerid][pLider] > 0) { SendClientMessage(playerid, COR_LIGHTRED, "Voce foi demitido de lider por um admin ou Voce pediu contas, agora Voce e um Civil !"); }
                else { SendClientMessage(playerid, COR_LIGHTRED, "O Seu lider lhe demitiu. Voce agora e um Civil !"); }
                PlayerInfo[playerid][pEmprego] = 0;
                gTeam[playerid] = 3;
                MedicBill[playerid] = 0;
                PlayerInfo[playerid][pTeam] = 3;
                PlayerInfo[playerid][pMembro] = 0;
                PlayerInfo[playerid][pLider] = 0;
                PlayerInfo[playerid][pCargo] = 0;
                if(PlayerInfo[playerid][pSex] == 1) { SetPlayerSkin(playerid, 23); } else { SetPlayerSkin(playerid, 41); }
                pCheckInfoOrg[playerid] = 0;
                SpawnPlayer(playerid);
                liderhide[playerid] = 0;
                return 1;
            }
        }
    }
    return 1;
}


START::LoadOrgs()
{
    new idx = 1;
    while (idx < sizeof(InfoOrg))
    {
            new DOF2[500];
            format(DOF2, sizeof(DOF2), "OrgsSV/%d.ini", idx);
            strmid(InfoOrg[idx][Lider],DOF2_GetString(DOF2, "Lider"),0,strlen(DOF2_GetString(DOF2, "Lider")), 255);
            strmid(InfoOrg[idx][SubLider],DOF2_GetString(DOF2, "SubLider"),0,strlen(DOF2_GetString(DOF2, "SubLider")), 255);

