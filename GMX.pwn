stock GetOrgName2(Orgid)
{
    new Orgname[50];
    switch(Orgid)
    {
        case 0:  Orgname = "Nenhuma";
        case 1:  Orgname = "{7491f6}Policia Militar";
        case 2:  Orgname = "{27408B}BOPE";
        case 3:  Orgname = "{006400}Exercito";
