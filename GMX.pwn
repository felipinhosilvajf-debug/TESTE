    CMD:cg(playerid, result[])
    {
        if(TendoGuerra == 0)
        {
            SendClientMessage(playerid, COR_GRAD1, "nao esta ocorrendo uma guerra.");
            return 1;
        }
        if(PlayerMutado[playerid] == 1)
        {
            SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao pode falar, pois foi calado.");
            return 1;
        }
        if(PlayerInfo[playerid][pJailed] == 2)
        {
            SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao pode usar este comando agora!");
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
            GetPlayerName(playerid, sendername, sizeof(sendername));
            if(isnull(result))
            {
                SendClientMessage(playerid, COR_RAD, "{df5454}Ã—{ffffff} USE: /cg [texto]");
                return 1;
            }
            if(GetTickCount() - TempoChatCop[playerid] < 3000)
            {
                SendClientMessage(playerid,COR_GRAD1,"Voce so pode escrever uma mensagem a cada 3 segundos.");
                return 1;
            }
            if(TentouDivulgar(result))
            {
                GetPlayerName(playerid, playernameZCMD, MAX_PLAYER_NAME);
                format(stringZCMD, sizeof(stringZCMD), "AdmAviso: [%d]%s tentou divulgar: %s.",playerid,playernameZCMD,result);
                ABroadCast(COR_AMARELO,stringZCMD,1);
                DivulgouLog(stringZCMD);
                return 1;
            }
            if(IsACop(playerid))
            {
                printf("%s", stringZCMD);
                format(stringZCMD, sizeof(stringZCMD), "[Chat Guerra %s] %s: %s **", NomeORG(playerid), PlayerName(playerid), result);
                SendFamilyMessage(3,COR_EXE,stringZCMD);
                TempoChatCop[playerid] = GetTickCount();
            }
            if(GetPlayerOrg(playerid) == 6)
            {
                printf("%s", stringZCMD);
