                                    }
                                    ConviteInfoOrg(giveplayerZCMD, org, level);
                                }
                            }
                            return 1;
                        }
                        if(PlayerInfo[para1][pMembro] != PlayerInfo[playerid][pLider])
                        {
                            SendClientMessage(playerid, COR_GREY, "nao pode promover quem nao e da sua org.");
                            return 1;
                        }
                        SaveORGS();
                    }
                }//not connected
            }
