    CMD:identidade(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if (gPlayerLogged[playerid] != 0)
            {
                ShowStats(playerid,playerid);
                GetPlayerName(playerid, sendername, sizeof(sendername));
                format(stringZCMD, sizeof(stringZCMD), "* %s Abre a carteira e confere sua Identidade(RG).", sendername);
                ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta logado !");
            }
        }
        return 1;
    }

