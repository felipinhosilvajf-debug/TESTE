        }
        if(RandomCaixa == 1 && PlayerInfo[playerid][pDiaVIP] == 0)
        {
            PlayerInfo[playerid][pDiaVIP] += randomVIP;
            PlayerInfo[playerid][pVIP] = 1;
            format(string, sizeof(string), "{ffffff}Os {df5454}itens {ffffff}que veio em sua caixa esta escrito abaixo ;)\n");
            strcat(MEGAString,string);
            format(string, sizeof(string), "\n{F7FE2E}Voce ganhou um VIP Comum de %d dias. Parabens.",randomVIP);
