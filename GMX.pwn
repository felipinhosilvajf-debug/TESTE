    CMD:congelar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new playa;
            if(sscanf(params, "u", playa))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /congelar [id]");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 2)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(playa))
                {
                    if(playa != INVALID_PLAYER_ID)
                    {
                        if(PlayerInfo[sscanfid][pAdmin] >= 1340)
                        {
                            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode congelar um Admin Dono !");
                            return 1;
                        }
                        if(strcmp(PlayerName(playa),"VBSTAFF", true) == 0 && playerid != sscanfid)
                        {
                            return 1;
                        }
                        GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Congelou %s",sendername,  giveplayerZCMD);
                        printf("%s",stringZCMD);
                        TogglePlayerControllable(playa, 0)
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Foi congelado por %s",giveplayerZCMD ,sendername);
                        ABroadCast(COR_LIGHTRED,stringZCMD,1);
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
            }
        }
        return 1;
    }
    CMD:descongelar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new playa;
            if(sscanf(params, "u", playa))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /descongelar [id]");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 2)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(playa))
                {
                    if(playa != INVALID_PLAYER_ID)
                    {
                        PlayerMutado[playa] = 0;
                        GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        TogglePlayerControllable(playa, 1);
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Descongelou %s",sendername,  giveplayerZCMD);
                        printf("%s",stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Foi descongelado por %s",giveplayerZCMD ,sendername);
                        ABroadCast(COR_LIGHTRED,stringZCMD,1);
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
            }
        }
        return 1;
    }
    CMD:desbugarcam(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if (PlayerInfo[playerid][pAdmin] >= 1)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                CameraInfo[cameraman] = INVALID_PLAYER_ID;
                ABroadCast(COR_AMARELO,"AdmCmd: Camera-man Desbugado!", 1);
                return 1;
            }
        }
        return 1;
    }
    CMD:desbugar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new playa;
            if(sscanf(params, "u", playa))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /desbugar [playerid]");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 1)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(playa))
                {
                    if(playa != INVALID_PLAYER_ID)
                    {
                        desbugando[playa] = 1;
                        PlayerMutado[playa] = 0;
                        GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        TogglePlayerControllable(playa, 1);
                        SetPlayerVirtualWorld(playerid,0);
                        MedicBill[playa] = 0;
                        NeedMedicTime[playa] = 0;
                        SetCameraBehindPlayer(playa);
                        sincronizando[playa] = 1;
                        virt[playa] = GetPlayerVirtualWorld(playa);
                        interior[playa] = GetPlayerInterior(playa);
                        skinneg[playa] = GetPlayerSkin(playa);
                        GetPlayerArmour(playa,APP[playa]);
                        GetPlayerHealth(playa,PlayerHPP[playa]);
                        GetPlayerFacingAngle(playa,FaceAngle[playa]);
                        GetPlayerPos(playa,xx[playa],yy[playa],zz[playa]);
                        GetPlayerWeaponData(playa,1,gunsinc[1][playa],ammoo[1][playa]);
                        GetPlayerWeaponData(playa,2,gunsinc[2][playa],ammoo[2][playa]);
                        GetPlayerWeaponData(playa,3,gunsinc[3][playa],ammoo[3][playa]);
                        GetPlayerWeaponData(playa,4,gunsinc[4][playa],ammoo[4][playa]);
                        GetPlayerWeaponData(playa,5,gunsinc[5][playa],ammoo[5][playa]);
                        GetPlayerWeaponData(playa,6,gunsinc[6][playa],ammoo[6][playa]);
                        GetPlayerWeaponData(playa,7,gunsinc[7][playa],ammoo[7][playa]);
                        GetPlayerWeaponData(playa,8,gunsinc[8][playa],ammoo[8][playa]);
                        GetPlayerWeaponData(playa,9,gunsinc[9][playa],ammoo[9][playa]);
                        GetPlayerWeaponData(playa,10,gunsinc[10][playa],ammoo[10][playa]);
                        GetPlayerWeaponData(playa,11,gunsinc[11][playa],ammoo[11][playa]);
                        GetPlayerWeaponData(playa,12,gunsinc[12][playa],ammoo[12][playa]);
                        SpawnPlayer(playa);
                        TempoSinc = SetTimerEx("Sincronizar", 500, 0, "i", playa);
                        if(IsPlayerInAnyVehicle(playa))
                        {
                            vehicledd[playa] = 1;
                            VehicleIDD[playa] = GetPlayerVehicleID(playa);
                        }
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Desbugou %s",sendername,  giveplayerZCMD);
                        printf("%s",stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Foi desbugado por %s",giveplayerZCMD ,sendername);
                        ABroadCast(COR_LIGHTRED, stringZCMD, 1);
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
            }
        }
        return 1;
    }
    CMD:setemprego(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new para1;
            new jobid;
            if(sscanf(params, "ud", para1, jobid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /setemprego [playerid/ParteDoNome] [empregoid)]");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 4)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(para1))
                {
                    if(para1 != INVALID_PLAYER_ID)
                    {
                        GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        PlayerInfo[para1][pEmprego] = jobid;
                        SendClientMessage(playerid, COR_GRAD1, "Emprego setado com sucesso !");
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar esse comando!");
            }
        }
        return 1;
    }
    CMD:sumirfc(playerid, params[])
    {
        if (PlayerInfo[playerid][pAdmin] >= 1342)
        {
            for(new car; car != MAX_VEHICLES; ++car)
            {
                new Float:Distancia = GetVehicleDistanceFromPoint(car, 1.5343,-0.8107,3.1172); // Essa Funcao e a Mais Importante, Veja Sobre ela no final do code.
                if(Distancia <= 20)
                {
                    foreach(new viado: Player)
                    {
                        if(!IsPlayerInVehicle(viado, car))
                        {
                            SetVehicleVirtualWorld(car, 1);
                        }
                    }
                }
            }
            SendClientMessage(playerid,COR_GREY,"* Voce sumiu com todos carros VIP's/Fixos da fazenda!");
            return 1;
        }
        return 1;
    }

    CMD:consultarlogcad(playerid, params[])
    {
        new index[880];
        format(index, sizeof index, "PlayerLog/cadeias/%s.log", PlayerName(playerid));
        if(DOF2_FileExists(index))
        {
            MEGAString[0] = EOS;
            new str[128], readString[128], File:logFile;
            logFile = fopen(index, io_read);
            while(fread(logFile, readString)) {
                format(str, sizeof str, "%s", readString);
                strcat(MEGAString,str);
            }
            ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX, "{ffffff}LOGS Cadeia Admin", MEGAString, "Fechar", "");
        }
        else
        {
            SendClientMessage(playerid, COR_START, "{df5454}[LOG] nao ha logs em nossso Banco de Dados Referente a isso!");
        }
        return 1;
    }

