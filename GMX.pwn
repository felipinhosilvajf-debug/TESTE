START::VenderVeiculo(playerid)
{
    if(VeiculoInfo[playerid][vDono] == 1)
    {
            DestruirVeiculoConce(playerid);
            VeiculoInfo[playerid][vDono] = 0;
            VeiculoInfo[playerid][vCor1] = 1;
            VeiculoInfo[playerid][vPlaca] = 0;
            VeiculoInfo[playerid][vCor2] = 1;
            VeiculoInfo[playerid][vGas] = 0;
            VeiculoInfo[playerid][vModelo] = 0;
            VeiculoInfo[playerid][vPos1] = 0;
            VeiculoInfo[playerid][vPos2] = 0;
            VeiculoInfo[playerid][vPos3] = 0;
            VeiculoInfo[playerid][vTrancado] = 0;
            VeiculoInfo[playerid][vEstacionou] = 0;
            VeiculoInfo[playerid][vRot] = 0;
            SendClientMessage(playerid, COR_OBS, "INFO: {ffffff}Voce vendeu o seu Veiculo, Voce ainda recebeu R$20.000!");
            GivePlayerMoneyEx(playerid, 20000);
            new DOF2[500];
            format(DOF2, sizeof(DOF2), "CarrosConce/%s.ini", PlayerName(playerid));
            DOF2_CreateFile(DOF2);
            DOF2_SetInt(DOF2, "Dono", VeiculoInfo[playerid][vDono]);
            DOF2_SetInt(DOF2, "Cor1", VeiculoInfo[playerid][vCor1]);
            DOF2_SetInt(DOF2, "Placa", VeiculoInfo[playerid][vPlaca]);
            DOF2_SetInt(DOF2, "Cor2", VeiculoInfo[playerid][vCor2]);
            DOF2_SetInt(DOF2, "Gasolina", VeiculoInfo[playerid][vGas]);
            DOF2_SetInt(DOF2, "Modelo", VeiculoInfo[playerid][vModelo]);
            DOF2_SetFloat(DOF2, "Pos1", VeiculoInfo[playerid][vPos1]);
            DOF2_SetFloat(DOF2, "Pos2", VeiculoInfo[playerid][vPos2]);
            DOF2_SetFloat(DOF2, "Pos3", VeiculoInfo[playerid][vPos3]);
            DOF2_SetInt(DOF2, "Trancado", VeiculoInfo[playerid][vTrancado]);
            DOF2_SetInt(DOF2, "Estacionou", VeiculoInfo[playerid][vEstacionou]);
            DOF2_SetFloat(DOF2, "Rot", VeiculoInfo[playerid][vRot]);
            DOF2_SaveFile();
            DOF2_RemoveFile(DOF2);
    }
    return 1;
}






START::DestruirVeiculoConce(playerid)
{
    if(VeiculoInfo[playerid][vDono] == 1)
    {
        if(VeiculoInfo[playerid][vEstacionou] == 0)
        {
            new idveh = VeiculoPessoal[playerid];
            new Float:Pos[5], Cor1, Cor2;
            //new PosPlayer[3];
            //GetPlayerPos(playerid, PosPlayer[0], PosPlayer[1], PosPlayer[2]-1);
            //SetPlayerPos(playerid, PosPlayer[0], PosPlayer[1], PosPlayer[2]+2);
            GetVehiclePos(idveh, Pos[0], Pos[1], Pos[2]);
            GetPlayerFacingAngle(playerid, Pos[3]);
            GetVehicleColor(idveh, Cor1, Cor2);


            VeiculoInfo[playerid][vPos1] = Pos[0];
            VeiculoInfo[playerid][vPos2] = Pos[1];
            VeiculoInfo[playerid][vPos3] = Pos[2];
            VeiculoInfo[playerid][vRot] = Pos[3];
            VeiculoInfo[playerid][vCor1] = Cor1;
            VeiculoInfo[playerid][vCor2] = Cor2;
        }

        DestroyVehicle(VeiculoPessoal[playerid]);
        SalvarVeiculosConce(playerid);
    }
    return 1;
}

START::CarregarVeiculosConce(playerid)
{
    new StringHH[250];
    format(StringHH, 250, "CarrosConce/%s.ini", PlayerName(playerid));
    VeiculoInfo[playerid][vDono] = DOF2_GetInt(StringHH, "Dono");
    if(VeiculoInfo[playerid][vDono] == 1)
    {
        format(StringHH, 250, "CarrosConce/%s.ini", PlayerName(playerid));
        VeiculoInfo[playerid][vDono] = DOF2_GetInt(StringHH, "Dono");
        VeiculoInfo[playerid][vCor1] = DOF2_GetInt(StringHH, "Cor1");
        VeiculoInfo[playerid][vCor2] = DOF2_GetInt(StringHH, "Cor2");
        VeiculoInfo[playerid][vPlaca] = DOF2_GetInt(StringHH, "Placa");
        VeiculoInfo[playerid][vGas] = DOF2_GetInt(StringHH, "Gasolina");
        VeiculoInfo[playerid][vPos1] = DOF2_GetFloat(StringHH, "Pos1");
        VeiculoInfo[playerid][vPos2] = DOF2_GetFloat(StringHH, "Pos2");
        VeiculoInfo[playerid][vPos3] = DOF2_GetFloat(StringHH, "Pos3");
        VeiculoInfo[playerid][vRot] = DOF2_GetFloat(StringHH, "Rot");
        VeiculoInfo[playerid][vTrancado] = DOF2_GetInt(StringHH, "Trancado");
        VeiculoInfo[playerid][vEstacionou] = DOF2_GetInt(StringHH, "Estacionou");
        VeiculoInfo[playerid][vModelo] = DOF2_GetInt(StringHH, "Modelo");
        TrancarCarroConce2(playerid);

//      new Str[800];
//      format(Str, sizeof(Str), "%d, %f, %f, %f, %f, %d, %d, 8000000", VeiculoInfo[playerid][vModelo], VeiculoInfo[playerid][vPos1], VeiculoInfo[playerid][vPos2], VeiculoInfo[playerid][vPos3], VeiculoInfo[playerid][vRot], VeiculoInfo[playerid][vCor1], VeiculoInfo[playerid][vCor2]);
        CriarVeiculo(playerid);
    }
    return 1;
}

GetVehID(playerid)
{
    new ID = GetVehicleModel(VeiculoPessoal[playerid]);
    return ID;
}

TrancarCarroConce(playerid)
{
    if(VeiculoInfo[playerid][vDono] == 1)
    {
        new idveh = VeiculoPessoal[playerid];
        new Str[800];
        new Float:Pos[5];
        GetVehiclePos(VeiculoPessoal[playerid], Pos[0], Pos[1], Pos[2]);
        if(PlayerToPoint(5.0, playerid, Pos[0], Pos[1], Pos[2]))
        {
            if(VeiculoInfo[playerid][vTrancado] == 0)
            {
                foreach(new i: Player)
                {
                    LockCar(idveh);
                }
                format(Str, sizeof(Str), "~w~Veiculo~r~ Fechado");
                GameTextForPlayer(playerid, Str, 3000, 3);
                VeiculoInfo[playerid][vTrancado] = 1;
            }
            else if(VeiculoInfo[playerid][vTrancado] == 1)
            {
                foreach(new i: Player)
                {
                    UnLockCar(idveh);
                }
                format(Str, sizeof(Str), "~w~Veiculo~g~ Aberto");
                GameTextForPlayer(playerid, Str, 3000, 3);
                VeiculoInfo[playerid][vTrancado] = 0;
            }
        }
        else
        {
            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao tem a Chave desse veiculo!");
        }
    }
    else
    {
            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao tem a Chave desse veiculo!");
    }
    return 1;
}

TrancarCarroConce2(playerid)
{
    new idveh = VeiculoPessoal[playerid];
    if(VeiculoInfo[playerid][vTrancado] == 0)
    {
        foreach(new i: Player)
        {
            LockCar(idveh);
        }
    }
    else if(VeiculoInfo[playerid][vTrancado] == 1)
    {
        foreach(new i: Player)
        {
            UnLockCar(idveh);
        }
    }
    return 1;
}

EstacionarVeh(playerid)
{
    new idveh = GetPlayerVehicleID(playerid);
    new Float:Pos[5], Cor1, Cor2;
    new Float:pPos[5];
    GetPlayerPos(playerid, pPos[0], pPos[1], pPos[2]);
    SetPlayerPos(playerid, pPos[0], pPos[1], pPos[2]);
    GetVehiclePos(idveh, Pos[0], Pos[1], Pos[2]);
    GetVehicleZAngle(idveh, Pos[3]);
    GetVehicleColor(idveh, Cor1, Cor2);
    VeiculoInfo[playerid][vEstacionou] = 1;
    VeiculoInfo[playerid][vPos1] = Pos[0];
    VeiculoInfo[playerid][vPos2] = Pos[1];
    VeiculoInfo[playerid][vPos3] = Pos[2];
    VeiculoInfo[playerid][vRot] = Pos[3];
    VeiculoInfo[playerid][vCor1] = Cor1;
    VeiculoInfo[playerid][vCor2] = Cor2;
    SendClientMessage(playerid, COR_START, "{df5454}Veiculo: {ffffff}O seu veiculo foi estacionado nesse local.");
    format(stringZCMD, sizeof(stringZCMD), "ANTI-ABUSO: %s[%d] estacionou seu veiculo propio, fique de olho!", PlayerName(playerid), playerid);
    ABroadCast(COR_OBS,stringZCMD,1);
    return 1;
}

CriarVeiculo(playerid)
{
    if(VeiculoInfo[playerid][vDono] == 1)
    {
        DestroyVehicle(VeiculoPessoal[playerid]);
        VeiculoPessoal[playerid] = AddStaticVehicleEx(VeiculoInfo[playerid][vModelo], VeiculoInfo[playerid][vPos1], VeiculoInfo[playerid][vPos2], VeiculoInfo[playerid][vPos3], VeiculoInfo[playerid][vRot], VeiculoInfo[playerid][vCor1], VeiculoInfo[playerid][vCor2], 80000000); //Cinquentinha
        Gas[VeiculoPessoal[playerid]] = VeiculoInfo[playerid][vGas];
        SetVehicleZAngle(VeiculoPessoal[playerid], VeiculoInfo[playerid][vRot]);
        SetVehicleNumberPlate(VeiculoPessoal[playerid], VeiculoInfo[playerid][vPlaca]);
    }
    return 1;
}


START::EfetuarBackup()
{
    foreach(new i: Player)
    {
            new File[56],Float:pPosX[MAX_PLAYERS], Float:pPosY[MAX_PLAYERS], Float:pPosZ[MAX_PLAYERS], Float:pPosA[MAX_PLAYERS],pInterior[MAX_PLAYERS];
            format(File, 56, "Posicoes/%s.txt", PlayerName(i)); // Cria o "caminho" ate o local onde sera salvo o Arquivo com a posicao do Player
            GetPlayerPos(i, pPosX[i], pPosY[i], pPosZ[i]); // Pega a Posicao do Player em X, Y e Z, e converte para "pPosX", "pPosY" e "pPosZ", respectivamente.
            GetPlayerFacingAngle(i, pPosA[i]); // Pega o angulo do Player em A e converte para pPosA, logo pPosA = angulo do Player
            pInterior[i] = GetPlayerInterior(i); // Pega o interior do Player, que fica armazenado em pInterior.
            if(!DOF2_FileExists(File)) // Checa se a File existe
            {
                DOF2_CreateFile(File); // Se nao existir, cria
            }
            DOF2_SetFloat(File, "PosX", pPosX[i]); // Escreve dentro do Arquivo: "PosX = pPosX (posicao que pegamos antes, lembra ?)
            DOF2_SetFloat(File, "PosY", pPosY[i]); // Escreve dentro do Arquivo: "PosY = pPosY (posicao que pegamos antes, lembra ?)
            DOF2_SetFloat(File, "PosZ", pPosZ[i]); // Escreve dentro do Arquivo: "PosZ = pPosZ (posicao que pegamos antes, lembra ?)
            DOF2_SetFloat(File, "PosA", pPosA[i]); // Escreve dentro do Arquivo: "PosA = pPosA (posicao que pegamos antes, lembra ?)
            DOF2_SetInt(File, "Interior", pInterior[i]); // Escreve dentro do Arquivo: "Interior = pInterior (interior que pegamos antes, lembra ?)
            DOF2_SaveFile(); // Salva o arquivo.
            SalvarInventario(i);
            OnPlayerSave(i);
            SalvarVeiculosConce(i);
    }
    salvarGrafites();
    SalvarPlantacao();
    SalvarEmpresas();
    SalvarSEmpresas();
    salvarPortoes();
    SalvarCofreOrg();
    for(new i; i < 500; i++)
    {
        salvarMoveis(i);
        SalvarEmpresa(i);
    }
    FinalizarBackup();
    return 1;
}

START::FinalizarBackup()
{
    SendClientMessageToAll(COR_VERDE, "{33ff00}[Backup Diario Conluido] Todos os dados de contas, orgs, fazendas, empresas, foram salvos na MySQL.");
    SendClientMessageToAll(COR_VERDE, "{33ff00}[Backup Diario Conluido] E os backups na DOF2 para entrar em analise e ver oque/quem perdeu dados depois da GMX.");
    return 1;
}


START::BloquearIrPosicao(playerid)
{
    BloqueadoIrPosicao[playerid] = 1;
}

START:: voltarPortao(p){

    MoveDynamicObject(PortaoInfo[p][portaoObject], PortaoInfo[p][portaoX], PortaoInfo[p][portaoY], PortaoInfo[p][portaoZ], 5.0, PortaoInfo[p][portaoRX], PortaoInfo[p][portaoRY], PortaoInfo[p][portaoRZ]);
    return 1;
}
carregarGrafites(){

    static
        file[78],
        Str[105+MAX_PLAYER_NAME];
    for(new x; x != MAX_GRAFTEXT; x++){

        GrafiteInfo[x][grafiteCreated] = false;

        format(file, sizeof file, "Grafites/Grafite%d.ini", x);
        if(DOF2_FileExists(file)){

            GrafiteInfo[x][grafiteCreated] = true;
            GrafiteInfo[x][grafiteX] = DOF2_GetFloat(file, "GrafiteX");
            GrafiteInfo[x][grafiteY] = DOF2_GetFloat(file, "GrafiteY");
            GrafiteInfo[x][grafiteZ] = DOF2_GetFloat(file, "GrafiteZ");
            GrafiteInfo[x][grafiteRX] = DOF2_GetFloat(file, "GrafiteRX");
            GrafiteInfo[x][grafiteRY] = DOF2_GetFloat(file, "GrafiteRY");
            GrafiteInfo[x][grafiteRZ] = DOF2_GetFloat(file, "GrafiteRZ");
            GrafiteInfo[x][grafiteCor] = DOF2_GetInt(file, "GrafiteCor");
            GrafiteInfo[x][grafiteFonte] = DOF2_GetInt(file, "GrafiteFonte");
            format(GrafiteInfo[x][grafiteNick], MAX_PLAYER_NAME, DOF2_GetString(file, "GrafiteNick"));
            format(GrafiteInfo[x][grafiteTexto],MAX_PLAYER_NAME, DOF2_GetString(file, "GrafiteTexto"));
            GrafiteInfo[x][grafiteObject]     = CreateObject(19482, GrafiteInfo[x][grafiteX],
                                                                       GrafiteInfo[x][grafiteY],
                                                                       GrafiteInfo[x][grafiteZ],
                                                                       GrafiteInfo[x][grafiteRX],
                                                                       GrafiteInfo[x][grafiteRY],
                                                                       GrafiteInfo[x][grafiteRZ]);
            format(Str, sizeof Str, "{ffffff}Grafite ID: {df5454}%d\n{ffffff}Dono do Grafite: {df5454}%s", x,GrafiteInfo[x][grafiteNick]);
            GrafiteInfo[x][grafiteText]       = CreateDynamic3DTextLabel(Str, COR_LIGHTBLUE, GrafiteInfo[x][grafiteX], GrafiteInfo[x][grafiteY], GrafiteInfo[x][grafiteZ]+1, 25.0);
            new Cor;
            if(GrafiteInfo[x][grafiteCor] == 1) Cor = -256;
            if(GrafiteInfo[x][grafiteCor] == 2) Cor = -16468988;
            if(GrafiteInfo[x][grafiteCor] == 3) Cor = -16730675;
            if(GrafiteInfo[x][grafiteFonte] == 1)
            {
                SetObjectMaterialText(GrafiteInfo[x][grafiteObject], GrafiteInfo[x][grafiteTexto],0,OBJECT_MATERIAL_SIZE_256x256,"Arial",24,1,Cor,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
            }
            if(GrafiteInfo[x][grafiteFonte] == 2)
            {
                SetObjectMaterialText(GrafiteInfo[x][grafiteObject], GrafiteInfo[x][grafiteTexto],0,OBJECT_MATERIAL_SIZE_256x256,"Comic Sans MS",24,1,Cor,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
            }
            if(GrafiteInfo[x][grafiteFonte] == 3)
            {
                SetObjectMaterialText(GrafiteInfo[x][grafiteObject], GrafiteInfo[x][grafiteTexto],0,OBJECT_MATERIAL_SIZE_256x256,"Italic",24,1,Cor,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
            }
            if(GrafiteInfo[x][grafiteFonte] == 4)
            {
                SetObjectMaterialText(GrafiteInfo[x][grafiteObject], GrafiteInfo[x][grafiteTexto],0,OBJECT_MATERIAL_SIZE_256x256,"Copperplate Gothic Bold",24,1,Cor,0,OBJECT_MATERIAL_TEXT_ALIGN_CENTER);
            }

        }
    }
}


salvarGrafites(){

    static file[78];
    for(new x; x != MAX_GRAFTEXT; x++){
        if(GrafiteInfo[x][grafiteCreated]){
            format(file, sizeof file, "Grafites/Grafite%d.ini", x);
            if(!DOF2_FileExists(file)){
                DOF2_CreateFile(file);
            }
            DOF2_SetFloat(file, "GrafiteX", GrafiteInfo[x][grafiteX]);
            DOF2_SetFloat(file, "GrafiteY", GrafiteInfo[x][grafiteY]);
            DOF2_SetFloat(file, "GrafiteZ", GrafiteInfo[x][grafiteZ]);
            DOF2_SetFloat(file, "GrafiteRX", GrafiteInfo[x][grafiteRX]);
            DOF2_SetFloat(file, "GrafiteRY", GrafiteInfo[x][grafiteRY]);
            DOF2_SetFloat(file, "GrafiteRZ", GrafiteInfo[x][grafiteRZ]);
            DOF2_SetInt(file, "GrafiteCor", GrafiteInfo[x][grafiteCor]);
            DOF2_SetInt(file, "GrafiteFonte", GrafiteInfo[x][grafiteFonte]);
            DOF2_SetString(file, "GrafiteNick", GrafiteInfo[x][grafiteNick]);
            DOF2_SetString(file, "GrafiteTexto", GrafiteInfo[x][grafiteTexto]);
            DOF2_SaveFile();
        }
    }
}
grafiteDestruir(g){
