                MaconhaInfo[maconhaid][Object] = CreateObject(3409, MaconhaInfo[maconhaid][mX], MaconhaInfo[maconhaid][mY], MaconhaInfo[maconhaid][mZ]-0.2,0.0, 0.0, 0.0);
            }
            else if(MaconhaInfo[maconhaid][Crescida] == 34)
            {
                DestroyObject(MaconhaInfo[maconhaid][Object]);
                MaconhaInfo[maconhaid][Object] = CreateObject(3409, MaconhaInfo[maconhaid][mX], MaconhaInfo[maconhaid][mY], MaconhaInfo[maconhaid][mZ]-0.1,0.0, 0.0, 0.0);
            }
            else if(MaconhaInfo[maconhaid][Crescida] == 35)
            {
                DestroyObject(MaconhaInfo[maconhaid][Object]);
                MaconhaInfo[maconhaid][Object] = CreateObject(3409, MaconhaInfo[maconhaid][mX], MaconhaInfo[maconhaid][mY], MaconhaInfo[maconhaid][mZ],0.0, 0.0, 0.0);
            }
            format(string, sizeof string, "â€¢Maconhaâ€¢\nDono: %s\nPlantacao NÂº: %d\nCrescida: %d/%d\nGramas: %dg",
            MaconhaInfo[maconhaid][Dono], maconhaid,MaconhaInfo[maconhaid][Crescida],Max_Crescida, MaconhaInfo[maconhaid][GramasProntas]);
            Update3DTextLabelText(MaconhaInfo[maconhaid][TT], 0x1FF61F99, string);
        }
    }
    foreach(new i: Player)
    {
        if(gPlayerLogged[i])MaconhaPronta(i);
    }
    return true;
}
START::MostrarPlayers(playerid)
{
    new PlayerConectado;
    foreach(new i: Player)
    {
        if(IsPlayerConnected(i))
        {
            PlayerConectado++;
        }
    }
    format(stringZCMD, sizeof stringZCMD, "Server: %d Players Online", ContarJogadores(), PlayerComputador[playerid], PlayerCelular[playerid]);
    SendClientMessageToAll(COR_SHOX, stringZCMD);
    return 1;
}
START::IniciarSDados4()
{
    foreach(new i: Player)
    {
        SalvarInventario(i);
        SalvarVeiculosConce(i);
    }
    return 1;
}
START::IniciarSDados3()
{
    SaveCasas();
    SetTimer("IniciarSDados4", 9000, 0);
    return 1;
}
START::IniciarSDados2()
{
    foreach(new i: Player)
    {
        SalvarDados(i);
    }
    SetTimer("IniciarSDados3", 7000, 0);
    return 1;
}
START::IniciarSDados()
{
    SaveORGS();
    SendClientMessageToAll(0x00ff00ff, "[Salvamento] Dados do servidor salvo com sucesso!");
    SetTimer("IniciarSDados2", 6000, 0);
    return 1;
}
START::Clock()
{
    new str[128], str2[128];
    new ano, mes, dia;
    new hora, minuto, segundo;
    getdate(ano, mes, dia);
    gettime(hora, minuto, segundo);

    new myeggtext[20];
    if(mes == 1) { myeggtext = "Janeiro"; }
    else if(mes == 2) { myeggtext = "Fevereiro"; }
    else if(mes == 3) { myeggtext = "Marco"; }
    else if(mes == 4) { myeggtext = "Abril"; }
    else if(mes == 5) { myeggtext = "Maio"; }
    else if(mes == 6) { myeggtext = "Junho"; }
    else if(mes == 7) { myeggtext = "Julho"; }
    else if(mes == 8) { myeggtext = "Agosto"; }
    else if(mes == 9) { myeggtext = "Setembro"; }
    else if(mes == 10) { myeggtext = "Outubro"; }
    else if(mes == 11) { myeggtext = "Novembro"; }
    else if(mes == 12) { myeggtext = "Dezembro"; }
    format(str, sizeof(str), "%02d de %s", dia, myeggtext);
    TextDrawSetString(TextDrawdeData, str);
    format(str2, sizeof(str2), "_%02d:%02d:%02d", hora-3, minuto, segundo);
    TextDrawSetString(TextDrawdeHora, str2);



    new myeggtext2[20];
    if(mes == 1) { myeggtext2 = "Janeiro"; }
    else if(mes == 2) { myeggtext2 = "Fevereiro"; }
    else if(mes == 3) { myeggtext2 = "Marco"; }
    else if(mes == 4) { myeggtext2 = "Abril"; }
    else if(mes == 5) { myeggtext2 = "Maio"; }
    else if(mes == 6) { myeggtext2 = "Junho"; }
    else if(mes == 7) { myeggtext2 = "Julho"; }
    else if(mes == 8) { myeggtext2 = "Agosto"; }
    else if(mes == 9) { myeggtext2 = "Setembro"; }
    else if(mes == 10) { myeggtext2 = "Outubro"; }
    else if(mes == 11) { myeggtext2 = "Novembro"; }
    else if(mes == 12) { myeggtext2 = "Dezembro"; }
    format(str, sizeof(str), "%02d de %s", dia, myeggtext2);
    TextDrawSetString(textDrawRelogioAndroid[1], str);
    format(str2, sizeof(str2), "%s", GetWeekDay());
    TextDrawSetString(textDrawRelogioAndroid[0], str2);

    format(str2, sizeof(str2), "%s", GetWeekDay());
    TextDrawSetString(TextDrawDeDiaDaSemana, str2);

    format(str2, sizeof(str2), "%02d:%02d:%02d", hora-3, minuto, segundo);
    TextDrawSetString(textDrawRelogioAndroid[2], str2);

    if(hora == 7 && minuto == 55 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "[Aviso] Faltam 5 minutos para a Guerra do Morro Comecar!"); }
    if(hora == 8 && minuto == 0 && segundo == 1) { gIniciarGuerraMorro(); }
    if(hora == 13 && minuto == 55 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "[Aviso] Faltam 5 minutos para a Guerra do Morro Comecar!"); }
    if(hora == 14 && minuto == 0 && segundo == 1) { gIniciarGuerraMorro(); }
    if(hora == 19 && minuto == 55 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "[Aviso] Faltam 5 minutos para a Guerra do Morro Comecar!"); }
    if(hora == 20 && minuto == 0 && segundo == 1) { gIniciarGuerraMorro(); }
    if(hora == 1 && minuto == 55 && segundo == 1) { SendClientMessageToAll(COR_AMARELO, "[Aviso] Faltam 5 minutos para a Guerra do Morro Comecar!"); }
    if(hora == 2 && minuto == 0 && segundo == 1) { gIniciarGuerraMorro(); }
    if(minuto == 55 && segundo == 0) { SendClientMessageToAll(COR_AMARELO, "Faltam 5 minutos pra comecar a loteria, compre um bilhete na loterica"); }
    if(minuto == 56 && segundo == 0) { SendClientMessageToAll(COR_AMARELO, "Faltam 4 minutos pra comecar a loteria, compre um bilhete na loterica"); }
    if(minuto == 57 && segundo == 0) { SendClientMessageToAll(COR_AMARELO, "Faltam 3 minutos pra comecar a loteria, compre um bilhete na loterica"); }
    if(minuto == 58 && segundo == 0) { SendClientMessageToAll(COR_AMARELO, "Faltam 2 minutos pra comecar a loteria, compre um bilhete na loterica"); }
    if(minuto == 59 && segundo == 0) { SendClientMessageToAll(COR_AMARELO, "Falta 1 minuto pra comecar a loteria, compre um bilhete na loterica"); }

    if(hora == 0 && minuto == 0 && segundo == 0)
    {
        for(new i; i < 580; i++)
        {
            HouseInfo[i][hTakings]--;
            CobrarImposto();
        }
    }


    if(hora == 1 && minuto == 59 && segundo == 0)
    {
        SendClientMessageToAll(0x00ff00ff, "[Salvamento] Salvando dados do servidor ..");
        SetTimer("IniciarSDados", 80, 0);
    }

    if(hora == 2 && minuto == 59 && segundo == 0)
