START::RemoveBarraca(playerid)
{
//  DestroyDynamicObject(TemBarraca[playerid]);
    DestroyDynamicObject(TemBarraca[playerid]);
    TemBarraca[playerid] = 0;
}
START::RemoveParedao(playerid)
{
    DestroyDynamicObject(Paredao[playerid]);
    PlantouParedao[playerid] = 0;
}
START::RemoveGangue(playerid)
{
     LixoInfo[playerid][lCreated] = 0;
     LixoInfo[playerid][lX] = 0.0;
     LixoInfo[playerid][lY] = 0.0;
     LixoInfo[playerid][lZ] = 0.0;
     if(PlayerInfo[playerid][pMembro] == 5 || PlayerInfo[playerid][pLider] == 5)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoAztecas]);
     }
     if(PlayerInfo[playerid][pMembro] == 6 || PlayerInfo[playerid][pLider] == 6)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoTaliban]);
     }
     if(PlayerInfo[playerid][pMembro] == 8 || PlayerInfo[playerid][pLider] == 8)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoHitmans]);
     }
     if(PlayerInfo[playerid][pMembro] == 11 || PlayerInfo[playerid][pLider] == 11)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoPCC]);
     }
     if(PlayerInfo[playerid][pMembro] == 15 || PlayerInfo[playerid][pLider] == 15)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoGroove]);
     }
     if(PlayerInfo[playerid][pMembro] == 16 || PlayerInfo[playerid][pLider] == 16)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoAlqaeda]);
     }
     if(PlayerInfo[playerid][pMembro] == 18 || PlayerInfo[playerid][pLider] == 18)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoBallas]);
     }
     if(PlayerInfo[playerid][pMembro] == 19 || PlayerInfo[playerid][pLider] == 19)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoVagos]);
     }
     if(PlayerInfo[playerid][pMembro] == 20 || PlayerInfo[playerid][pLider] == 20)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoYakuza]);
     }
     if(PlayerInfo[playerid][pMembro] == 21 || PlayerInfo[playerid][pLider] == 21)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoSons]);
     }
     if(PlayerInfo[playerid][pMembro] == 22 || PlayerInfo[playerid][pLider] == 22)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoMCN]);
     }
     if(PlayerInfo[playerid][pMembro] == 23 || PlayerInfo[playerid][pLider] == 23)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoCV]);
     }
     if(PlayerInfo[playerid][pMembro] == 24 || PlayerInfo[playerid][pLider] == 24)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoMayans]);
     }
     if(PlayerInfo[playerid][pMembro] == 26 || PlayerInfo[playerid][pLider] == 26)
     {
          DestroyDynamicObject(LixoInfo[playerid][LixoTriads]);
     }
}
START::ObjectPixar(playerid)
{
    ShowPlayerDialog(playerid, 1997, DIALOG_STYLE_INPUT, "Sistema de Grafite", "Digite o texto que deseja grafitar.", "Confirmar", "");
    return 1;
}
START::RemoveBloqueio(playerid)
{
    BloqueioInfo[playerid][bqCreated]=0;
    BloqueioInfo[playerid][bqX]=0.0;
    BloqueioInfo[playerid][bqY]=0.0;
    BloqueioInfo[playerid][bqZ]=0.0;
    if(PlayerInfo[playerid][pMembro] == 1 || PlayerInfo[playerid][pLider] == 1)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioPM]);
    }
    else if(PlayerInfo[playerid][pMembro] == 2 || PlayerInfo[playerid][pLider] == 2)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioBOPE]);
    }
    else if(PlayerInfo[playerid][pMembro] == 3 || PlayerInfo[playerid][pLider] == 3)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioEXE]);
    }
    else if(PlayerInfo[playerid][pMembro] == 12 || PlayerInfo[playerid][pLider] == 12)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioIP]);
    }
    else if(PlayerInfo[playerid][pMembro] == 13 || PlayerInfo[playerid][pLider] == 13)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioGATE]);
    }
    else if(PlayerInfo[playerid][pMembro] == 17 || PlayerInfo[playerid][pLider] == 17)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioPC]);
    }
    else if(PlayerInfo[playerid][pMembro] == 25 || PlayerInfo[playerid][pLider] == 25)
    {
         DestroyDynamicObject(BloqueioInfo[playerid][BloqueioPF]);
    }
}
START::RemoveBarreira(playerid)
{
    BarreiraInfo[playerid][brCreated]=0;
    BarreiraInfo[playerid][brX]=0.0;
    BarreiraInfo[playerid][brY]=0.0;
    BarreiraInfo[playerid][brZ]=0.0;
    if(PlayerInfo[playerid][pMembro] == 1 || PlayerInfo[playerid][pLider] == 1)
    {
         DestroyDynamicObject(BarreiraInfo[playerid][BarreiraPM]);
    }
    else if(PlayerInfo[playerid][pMembro] == 2 || PlayerInfo[playerid][pLider] == 2)
    {
         DestroyDynamicObject(BarreiraInfo[playerid][BarreiraBOPE]);
    }
    else if(PlayerInfo[playerid][pMembro] == 3 || PlayerInfo[playerid][pLider] == 3)
    {
         DestroyDynamicObject(BarreiraInfo[playerid][BarreiraEXE]);
    }
    else if(PlayerInfo[playerid][pMembro] == 12 || PlayerInfo[playerid][pLider] == 12)
    {
