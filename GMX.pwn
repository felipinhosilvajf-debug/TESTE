    CMD:dc(playerid, params[])return ForT:deletarconta(playerid,params);
    CMD:deletarconta(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] != 1342) return 1;
        if(isnull(params))  return SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /deletarconta [Nick]");
        if (PlayerInfo[playerid][pAdmin] < 1341)
        {
            SendClientMessage(playerid, COR_GREY,"Voce nao tem permissao para usar esse comando!");
            return 1;
        }
        getdate(v[0], v[1], v[2]);
        gettime(v[3], v[4], v[5]);
        new Query[200];
        format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(params));
        Resultado = db_query(Conexao,Query);
        if(db_num_rows(Resultado) > 0)
        {
            format(stringZCMD, sizeof stringZCMD, "[%02d/%02d/%02d] [%02d:%02d:%02d] %s deletou a conta: %s", v[2], v[1], v[0], v[3], v[4], v[5], PlayerName(playerid), params);
            ABroadCast(COR_SHOX,stringZCMD,1);
            format(Query, sizeof(Query), "DELETE FROM `contas` WHERE `Nome`='%s'",DB_Escape(params));
            Resultado = db_query(Conexao,Query);

            if(ModoSavSis == true)
            {
                format(stringZCMD, sizeof stringZCMD, Pasta_Contas, params);
                DOF2_RemoveFile(stringZCMD);
            }
            if(ModoSavSis == false)
            {
                format(stringZCMD, sizeof stringZCMD, Pasta_Contas2, params);
                DOF2_RemoveFile(stringZCMD);
            }
            //mysql_store_result();
        }
        else
        {
            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Este usuario nao foi encontrado no nosso Banco de Dados!");
            return 1;
        }
        return 1;
    }

    CMD:mudarnick(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(NickSis == true)
            {
                if(PodeMudarNick[playerid] == 0 && MudarNick[playerid] == 0)
                    return SendClientMessage(playerid, COR_GRAD1, "Voce nao tem troca de nick disponivel, adquina no /menuvip ou peca um admin para autorizar.");

                new x_Nick[128];
                if(sscanf(params, "s[28]", x_Nick))
                    return SendClientMessage(playerid, COR_OBS, "ERRO, USE: {ffffff}/mudarnick [ Novo Nick ]");
                format(stringZCMD, sizeof stringZCMD, "Players/%s.ini", x_Nick);
                if(DOF2_FileExists(stringZCMD))
                    return SendClientMessage(playerid, COR_OBS,"ERRO: {ffffff}Este nick ja esta sendo usado por outro player, escolha outro nick!");

                if(mudandonick[playerid] == 1)
                    return SendClientMessage(playerid, COR_OBS,"ERRO: {ffffff}Algo deu errado, tente novamente em alguns segundos.");

                mudandonick[playerid] = 1;
                playernameZCMD = PlayerName(playerid);

                new nickantigo[MAX_PLAYERS][128];
                nickantigo[playerid] = PlayerName(playerid);

                new emp = PlayerInfo[playerid][pPbiskey];


                if(PlayerInfo[playerid][pPbiskey] != 355)
                {
                    if(strcmp(playernameZCMD,BizzInfo[emp][bOwner],true)==0)
                    {
                            format(stringZCMD, sizeof(stringZCMD), Pasta_Empresas, emp);
                            if(DOF2_FileExists(stringZCMD))
                            {
                                DOF2_SetString(stringZCMD, "Dono", x_Nick);
                                DOF2_SaveFile();
                                strmid(BizzInfo[PlayerInfo[playerid][pPbiskey]][bOwner],DOF2_GetString(stringZCMD, "Dono"),0, strlen(DOF2_GetString(stringZCMD, "Dono")), 255);
                                Delete3DTextLabel(BizzLabel[emp]);
                                format(gstring, sizeof(gstring), TextEmpresa,BizzInfo[emp][bMessage],x_Nick,BizzInfo[emp][bExtortion],BizzInfo[emp][bEntranceCost]);
                                BizzLabel[emp] = Create3DTextLabel(gstring,0x00FF00FF,BizzInfo[emp][bEntranceX], BizzInfo[emp][bEntranceY], BizzInfo[emp][bEntranceZ]+0.5,20.0, 0);
                            }
                    }


                    else if(strcmp(playernameZCMD,SBizzInfo[emp][sbOwner],true)==0)
                    {
                            new semp[255];
                            format(semp, sizeof(semp), Pasta_SEmpresas, emp);
                            if(DOF2_FileExists(semp))
                            {
                                DOF2_SetString(semp, "Dono", x_Nick);
                                DOF2_SaveFile();
                                strmid(SBizzInfo[emp][sbOwner],DOF2_GetString(semp, "Dono"),0, strlen(DOF2_GetString(semp, "Dono")), 255);
                                Delete3DTextLabel(SBizzLabel[emp]);
                                format(gstring, sizeof(gstring), TextMEmpresa,SBizzInfo[emp][sbMessage],x_Nick,SBizzInfo[emp][sbExtortion],SBizzInfo[emp][sbEntranceCost]);
                                SBizzLabel[emp] = Create3DTextLabel(gstring,0x00FF00FF,SBizzInfo[emp][sbEntranceX], SBizzInfo[emp][sbEntranceY], SBizzInfo[emp][sbEntranceZ]+0.5,20.0, 0);
                            }
                    }
                }
                if(PlayerInfo[playerid][pPHousekey] != 999)
                {
                    if(strcmp(playernameZCMD,HouseInfo[PlayerInfo[playerid][pPHousekey]][hOwner],true)==0)
                    {
                            new house[255];
                            format(house, sizeof(house), Pasta_Casas, PlayerInfo[playerid][pPHousekey]);
                            if(DOF2_FileExists(house))
                            {
                                DOF2_SetString(house, "Dono", x_Nick);
                                DOF2_SaveFile();
                                strmid(HouseInfo[PlayerInfo[playerid][pPHousekey]][hOwner],DOF2_GetString(house, "Dono"),0, strlen(DOF2_GetString(house, "Dono")), 255);
                                Delete3DTextLabel(HouseLabel[PlayerInfo[playerid][pPHousekey]]);
                                format(gstring, sizeof(gstring), TextCasa,x_Nick,HouseInfo[PlayerInfo[playerid][pPHousekey]][hRentabil],HouseInfo[PlayerInfo[playerid][pPHousekey]][hDiscription]);
                                HouseLabel[PlayerInfo[playerid][pPHousekey]] = Create3DTextLabel(gstring,0x00FF00FF,HouseInfo[PlayerInfo[playerid][pPHousekey]][hEntrancex], HouseInfo[PlayerInfo[playerid][pPHousekey]][hEntrancey], HouseInfo[PlayerInfo[playerid][pPHousekey]][hEntrancez]+0.5,13.0, 0);
                            }
                    }
                }
                new novo[255];
                new borse = PlayerInfo[playerid][pPFazkey];
                format(novo, sizeof(novo), Pasta_FEmpresas, borse);
                if(PlayerInfo[playerid][pPFazkey] < 255)
                {
                    strmid(FBizzInfo[borse][fbOwner], novo, 0, strlen(novo), 255);
                    Atualizar3Dtexts();
                    SalvarFEmpresa(borse);
                }
                for(new i = 0; i < sizeof(AdmInfo); ++i)
                {
                    if(strcmp(playernameZCMD,AdmInfo[i][AdminNick],true)==0)
                    {
                        strmid(AdmInfo[i][AdminNick], x_Nick, 0, strlen(x_Nick), 999);
                    }
                }
                if(GetPlayerOrg(playerid) != 0)
                {
                                    RemoveGangue(playerid);
                                    RemoveBloqueio(playerid);
                                    RemoveBarreira(playerid);
                                    RemoveParedao(playerid);
                                    RemoveBarraca(playerid);
                                    ResetPlayerWeaponsEx(playerid);
                                    SetPlayerArmour(playerid, 0);
                                    DeslogandoSocio[playerid] = 0;
                                    MedicBill[playerid] = 0;
                                    MedicBill[playerid] = 0;
                                    SetPlayerToTeamColor(playerid);
                                    if(strcmp(InfoOrg[GetPlayerOrg(playerid)][Lider], PlayerName(playerid), true) == 0)
                                    {
                                        strmid(InfoOrg[GetPlayerOrg(playerid)][Lider], x_Nick, 0, strlen(x_Nick), 255);
                                    }
                                    if(strcmp(InfoOrg[GetPlayerOrg(playerid)][SubLider], PlayerName(playerid), true) == 0)
                                    {
                                        strmid(InfoOrg[GetPlayerOrg(playerid)][SubLider], x_Nick, 0, strlen(x_Nick), 255);
                                    }
                                    if(strcmp(InfoOrg[GetPlayerOrg(playerid)][Membro1], PlayerName(playerid), true) == 0)
                                    {
                                        strmid(InfoOrg[GetPlayerOrg(playerid)][Membro1], x_Nick, 0, strlen(x_Nick), 255);
                                    }
                                    if(strcmp(InfoOrg[GetPlayerOrg(playerid)][Membro2], PlayerName(playerid), true) == 0)
                                    {
