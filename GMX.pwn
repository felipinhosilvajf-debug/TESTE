                                    }
                                    if(strcmp(InfoOrg[GetPlayerOrg(playerid)][Membro38], PlayerName(playerid), true) == 0)
                                    {
                                        strmid(InfoOrg[GetPlayerOrg(playerid)][Membro38], "Ninguem", 0, strlen("Ninguem"), 255);
                                    }
                                    if(strcmp(InfoOrg[GetPlayerOrg(playerid)][Membro39], PlayerName(playerid), true) == 0)
