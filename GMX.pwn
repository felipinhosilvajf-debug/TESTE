    CMD:retirarvip(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new para1;
            if(sscanf(params, "u", para1))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /retirarvip [id]");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] >= 1338)
            {
                if(IsPlayerConnected(para1))
                {
                    if(para1 != INVALID_PLAYER_ID)
                    {
                        GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        if(PlayerInfo[playerid][pSocio] == 1)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "Voce retirou o status de Socio [Comum] de %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Seu Status de Socio [Comum] foi retirado pelo Administrador: %s.", sendername);
                            SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                        }
                        else if(PlayerInfo[playerid][pSocio] == 2)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "Voce retirou o status de Socio [Premium] de %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Seu Status de Socio [Premium] foi retirado pelo Administrador: %s.", sendername);
                            SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                        }
                        else if(PlayerInfo[playerid][pSocio] == 3)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "Voce retirou o status de Socio [Diamante] de %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Seu Status de Socio [Diamante] foi retirado pelo Administrador: %s.", sendername);
                            SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                        }
                        else if(PlayerInfo[para1][pVIP] == 1 && PlayerInfo[playerid][pSocio] == 0)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "Voce retirou o status de Vip [Comum] de %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Seu Status de Vip [Comum] foi retirado pelo Administrador: %s.", sendername);
                            SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                        }
                        else if(PlayerInfo[para1][pVIP] == 2 && PlayerInfo[playerid][pSocio] == 0)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "Voce retirou o status de Vip [Premium] de %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "Seu Status de Vip [Premium] foi retirado pelo Administrador: %s.", sendername);
                            SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                        }
                    }
                    if(PlayerInfo[para1][pVIP] > 0 && PlayerInfo[playerid][pSocio] == 0)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "* Voce retirou o vip level %d de %s (%02d/%02d/%02d - %d:%d)",PlayerInfo[para1][pVIP],giveplayerZCMD,day, month, year,hour, minute);
                    }
                    else if(PlayerInfo[para1][pVIP] > 0 && PlayerInfo[playerid][pSocio] > 0)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "* Voce retirou o socio level %d de %s (%02d/%02d/%02d - %d:%d)",PlayerInfo[para1][pVIP],giveplayerZCMD,day, month, year,hour, minute);
                    }
                    SendClientMessage(playerid, COR_AMARELO, stringZCMD);
                    PlayerInfo[para1][pVIP] = 0;
                    PlayerInfo[para1][pSocio] = 0;
                    PlayerInfo[para1][pDiaVIP] = 0;
                    VipRetirado(stringZCMD);
                }
            }
        }
        else
        {
            SendClientMessage(playerid, COR_GRAD1, "   Voce nao esta autorizado a usar este comando!");
            return 1;
        }
        return 1;
    }
    CMD:mudarluta(playerid, params[])
    {
        if(IsPlayerInRangeOfPoint(playerid, 2.0, 768.0477,-3.8720,1000.7199) || IsPlayerInRangeOfPoint(playerid, 2.0, 775.9683,-58.2766,1000.7184))
        {
            TogglePlayerControllable(playerid, 0);
            ShowPlayerDialog(playerid, 74, DIALOG_STYLE_LIST, "RS Estilos De Luta", "Cotoveladas\nBoxe\nRua\nKickBoxing\nKarate\nNormal","Confirmar", "Cancelar");
        }
        else
        {
            SendClientMessage(playerid, COR_GREY, " Voce nao esta no ginasio de luta de LS.");
        }
        return 1;
    }
    CMD:assaltar(playerid, params[])
    {
        if(PlayerInfo[playerid][pJailed] != 0)
        {
            return 1;
        }
        if(IsACop(playerid))
        {
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
            if(UsouComando[playerid] == 1)
            {
                SendClientMessage(playerid, COR_VERMELHO, "Voce ja usou esse comando uma vez, espere mais 5 minutos!");
                return 1;
            }
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /assaltar [id]");
                return 1;
            }
            if (IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(PlayerInfo[sscanfid][pLevel] == 2)
                    {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode assaltar novatos!");
                        return 1;
                    }
                    if (ProxDetectorS(5.0, playerid, sscanfid))
                    {
                        new dinheiro;
                        dinheiro = GetPlayerMoneyEx(sscanfid);
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce esta assaltando R$[%d] de %s.", dinheiro, giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "* %s: Isso e um assalto, Digite: /aceitar assalto.", sendername);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        //SendClientMessage(sscanfid, COR_LIGHTBLUE, "/aceitar assalto para aceitar");
                        format(stringZCMD, sizeof(stringZCMD), "*%s esta assaltando %s!", sendername,giveplayerZCMD);
                        ProxDetector(20.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                        OfAssalto[sscanfid] = playerid;
                        precoassalto[sscanfid] = dinheiro;
                        SetPlayerCriminal(playerid,255, "Tentativa de Assalto");
                        UsouComando[playerid] = 1;
                        PlayerInfo[playerid][pAssaltante] ++;
                        SetTimerEx("UsarNovamente",300000,0,"d",playerid);
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "Esse jogador nao esta perto de Voce!");
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "ID/Nome Invalido !");
                    return 1;
                }
            }
        }
        return 1;
    }
    CMD:localizar(playerid, params[])
    {
        if(sscanf(params, "u", sscanfid))
        {
            SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /localizar [id]");
            return 1;
        }
        if(IsPlayerConnected(sscanfid))
        {
            if(sscanfid != INVALID_PLAYER_ID)
            {
                new Nome[MAX_PLAYER_NAME];
                GetPlayerName(sscanfid, Nome, sizeof(Nome));
                new location[MAX_ZONE_NAME];
                GetPlayer2DZone(sscanfid, location, MAX_ZONE_NAME);
                format(stringZCMD, sizeof(stringZCMD), "%s foi visto pela ultima vez aos arredores de %s", Nome,location);
                SendClientMessage(playerid, COR_AMARELO, stringZCMD);
                return 1;
            }
        }
        else
        {
            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
        }
        return 1;
    }
    CMD:dinamitar(playerid, params[])
    {
            if(!IsACop(playerid))
            {
