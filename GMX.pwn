            DOF2_RemoveFile(file);
        }
        GrafiteInfo[g][grafiteCreated] = false;
        DestroyObject(GrafiteInfo[g][grafiteObject]);
        DestroyDynamic3DTextLabel(GrafiteInfo[g][grafiteText]);
    }
}

