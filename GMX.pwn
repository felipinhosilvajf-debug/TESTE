                GivePlayerWeapon(playerid, 29, 150);
                GivePlayerWeapon(playerid, 31, 150);
                return 1;
            }
            if (PlayerInfo[playerid][pCargo] == 4)
            {
                format(string, sizeof(string), "[%s]: %s pega seus equipamentos de [C4]." ,NomeORG(playerid), sendername);
                ProxDetector(30.0, playerid, string, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                SetPlayerHealth(playerid, 100.0);
                SetPlayerArmour(playerid, 100.0);
                GivePlayerWeapon(playerid, 24, 200);
