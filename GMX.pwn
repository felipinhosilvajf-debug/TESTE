    CMD:guardargrafite(playerid){

        for(new x; x != MAX_GRAFTEXT; x++){

            if(GrafiteInfo[x][grafiteCreated] &&
               !strcmp(PlayerName(playerid), GrafiteInfo[x][grafiteNick], true) &&
               IsPlayerInRangeOfPoint(playerid, 8.0, GrafiteInfo[x][grafiteX], GrafiteInfo[x][grafiteY], GrafiteInfo[x][grafiteZ])){
                SendClientMessage(playerid, TEAM_BALLAS_COR, "Seu grafite foi guardado no inventario.");
                grafiteDestruir(x);
                for(new i=0; i<75; i++)
                {
                    if(InventarioInfo[playerid][i][iSlot] == 19382)
                    {
                        InventarioInfo[playerid][i][iSlot] = 2749;
                        InventarioInfo[playerid][i][iUnidades] = 1;
                        break;
                    }
                }
                return 1;
            }
        }
        SendClientMessage(playerid, COR_GREY, " Voce nao e o Dono Do Grafite.");
        return 1;
    }
    CMD:destruiritens(playerid){
        if(PlayerInfo[playerid][pAdmin] < 1340)
            return SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO:{ffffff} Voce nao e um Administrador!");
        for(new f = 0; f < MAX_OBJ; f++)
        {
            DestroyDroppedObject(f);
        }
        new string[128];
        format(string, 128, "AdmCmd: O Admin %s destruiu todos os itens spawnados no servidor.",PlayerName(playerid));
        SendClientMessageToAll(COR_LIGHTRED,string);
        return 1;
    }
    CMD:destruirgrafite(playerid){
        if(PlayerInfo[playerid][pAdmin] < 1340)
            return SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO:{ffffff} Voce nao e um Administrador!");
        for(new x; x != MAX_GRAFTEXT; x++){
            if(GrafiteInfo[x][grafiteCreated] && IsPlayerInRangeOfPoint(playerid, 5.0, GrafiteInfo[x][grafiteX], GrafiteInfo[x][grafiteY], GrafiteInfo[x][grafiteZ])){
                SendClientMessage(playerid, TEAM_BALLAS_COR, " Voce destruiu este grafite !");
                grafiteDestruir(x);
                return 1;
            }
        }
        SendClientMessage(playerid, COR_GREY, " Voce nao esta perto de nenhum grafite !");
        return 1;
    }
    CMD:irgrafite(playerid, params[]){
        if(PlayerInfo[playerid][pAdmin] < 1)
            return SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO:{ffffff} Voce nao e um Administrador!");
        static id,Str[54];
        if(sscanf(params, "i", id))
            return SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /irgrafite [Grafite ID]");
        if(id < 0 || id >= MAX_GRAFTEXT){
            format(Str, sizeof Str, "Numero de grafites de 0 - %d", MAX_GRAFTEXT-1);
            return SendClientMessage(playerid, COR_GREY, Str);
        }
        if(!GrafiteInfo[id][grafiteCreated])
            return SendClientMessage(playerid, COR_GREY, "  Este grafite nao esta criado !");
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerPos(playerid, GrafiteInfo[id][grafiteX], GrafiteInfo[id][grafiteY], GrafiteInfo[id][grafiteZ]);
        format(Str, sizeof Str, " Voce foi teleportado ate o grafite %d.", id);
        SendClientMessage(playerid, TEAM_BALLAS_COR, Str);
        return 1;
    }
    CMD:abrirportao(playerid, params[]){
        for(new x; x != MAX_PORTAO; x++){
            if(PortaoInfo[x][portaoCreated] && IsPlayerInRangeOfPoint(playerid, 8.0, PortaoInfo[x][portaoX], PortaoInfo[x][portaoY], PortaoInfo[x][portaoZ])){
                new senha[MAX_PLAYER_NAME];
                if(sscanf(params, "s[20]", senha))
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce deve digitar /abrirportao [senha].");
                    return 1;
                }
                portaoAbrir(playerid, senha, x);
                return 1;
            }
        }
        SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao tem um portao ou nao esta perto dele!");
        return 1;
    }
    CMD:editarmeuportao(playerid){
        for(new x; x != MAX_PORTAO; x++){
            if(PortaoInfo[x][portaoCreated] &&
               !strcmp(PlayerName(playerid), PortaoInfo[x][portaoNick], true) &&
               IsPlayerInRangeOfPoint(playerid, 8.0, PortaoInfo[x][portaoX], PortaoInfo[x][portaoY], PortaoInfo[x][portaoZ])){
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}INFO: {ffffff}Voce esta editando este portao.");
                SetPVarInt(playerid, "editPortao", x);
                EditDynamicObject(playerid, PortaoInfo[x][portaoObject]);
                SetPVarInt(playerid, "editando", 999);
                return 1;
            }
        }
        SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao tem um portao ou nao esta perto dele!");
        return 1;
    }
