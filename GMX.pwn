                   if(PlayerInfo[playerid][pCoins] < 3)
                        return SendClientMessage(playerid, COR_AMARELO, "Voce precisa ter 3 Moedas para adquirir advogado nivel 5 !");
                   if(PlayerInfo[playerid][pLawSkill] >= 301)
                        return SendClientMessage(playerid, COR_AMARELO, "Voce ja possui advogado nivel 5 !");

                   PlayerInfo[playerid][pLawSkill] = 400;
                   PlayerInfo[playerid][pCoins] -= 3;
                   format(string, sizeof(string),"{F4FA58}[Loja VIP] {2ECCFA}O Jogador %s comprou {2EFE2E}Habilidade advogado nivel 5{2ECCFA} para adquirir use: /menuvip.",PlayerName(playerid));
                   SendClientMessageToAll(-1, string);
                   LojaVipLog(string);
              }
              if(listitem == 2)
              {
                   if(PlayerInfo[playerid][pCoins] < 2)
                        return SendClientMessage(playerid, COR_AMARELO, "Voce precisa ter 2 Moedas para adquirir vendedor de drogas nivel 5 !");
