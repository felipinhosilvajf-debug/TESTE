    CMD:resetduel(playerid)
    {
         if(PlayerInfo[playerid][pAdmin] == 1342)
         {
              DueloAcontecendo = 0;
              SendClientMessage(playerid, COR_GRAD1, "Voce resetou a quantidade de duelos acontecendo no servidor");
         }
    }
    CMD:duelar(playerid)
    {
        if(PlayerInfo[playerid][pVIP] >= 1 || PlayerInfo[playerid][pSocio] >= 1)
        {
            if(!PlayerToPoint(1, playerid,1214.0134,-1748.3759,13.5947))
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta no icone de duelo.");
                return 1;
            }
            format(gstring,sizeof(gstring),"Digite o ID de seu oponente.");
            ShowPlayerDialog(playerid, 174, DIALOG_STYLE_INPUT,"Desafiando 1x1 !", gstring,"Confirmar","Cancelar");
        }
        else
        {
             SendClientMessage(playerid, COR_GRAD1, "Voce nao e um socio.");
             return 1;
        }
        return 1;
    }
    CMD:deagle(playerid)
    {
        if(PlayerInfo[playerid][pSocio] >= 1)
        {
            new Float:Vida;
            GetPlayerHealth(playerid, Vida);
            if(WantedLevel[playerid] != 0)
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce nao pode entrar na arena com niveis de procura !");
                return 1;
            }
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_AMARELO,"Voce nao entrar no duelo preso !");
                return 1;
            }
            if(Vida <= 50)
            {
                 SendClientMessage(playerid, COR_AMARELO, "Voce deve ter mais da metade da vida para entrar na arena deagle !");
                 return 1;
            }
            if(PlayerInfo[playerid][pGunLic] == 0)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao possui licencas de armas !");
                return 1;
            }
            if(!PlayerToPoint(2, playerid,1211.6652,-1750.1676,13.5942))
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta no icone de duelo.");
                return 1;
            }
            new rand;
            TDM[playerid] = 1;
            SetPlayerInterior(playerid, 1);
            SetPlayerVirtualWorld(playerid, 200);
            rand = random(sizeof(SpawnArena12));
            SetPlayerPos(playerid, SpawnArena12[rand][0], SpawnArena12[rand][1], SpawnArena12[rand][2]);
            SetPlayerFacingAngle(playerid, SpawnArena12[rand][3]);
            format(stringZCMD, sizeof(stringZCMD), "(DEAGLE ARENA):{FFFFFF} %s entrou na arena de Desert Eagle.", PlayerName(playerid));
            ProxDetector(100.0, playerid, stringZCMD,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE,COR_LIGHTBLUE);
            SendClientMessage(playerid, -1, "Â» Voce entrou na arena de Desert Eagle. Para sair, digite /sairarena.");
            ResetPlayerWeapons(playerid);
            GivePlayerWeaponEx(playerid, 24, 9999);
            SetPlayerArmour(playerid,100);
            SetPlayerHealth(playerid,100);
        }
        else
        {
             SendClientMessage(playerid, COR_GRAD1, "Voce nao e um socio.");
             return 1;
        }
        return 1;
    }
