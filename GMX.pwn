START::Encrypt(string[])
{
    for(new x=0; x < strlen(string); x++)
    {
        string[x] += (3^x) * (x % 15);
        if(string[x] > (0xff))
        {
            string[x] -= 256;
        }
    }
    return 1;
}
START::MoverPeni(playerid, giveplayerid)
{
     if(DeslogandoEnforcer[playerid] == 1)
     {
          new string[256];
          format(string, sizeof(string), "<< [%s] %s prendeu o suspeito %s na Penitenciaria. >>", NomeORG(giveplayerid), PlayerName(giveplayerid), PlayerName(playerid));
          SendClientMessageToAll(COR_LIGHTRED, string);
          SetPlayerSkin(playerid, 268);
          if(PlayerInfo[playerid][pSex] == 2) {  SetPlayerSkin(playerid, 69); }
          if(PlayerInfo[playerid][pSocio] >= 1) {  SetPlayerSkin(playerid, 42); }
          SetPlayerInterior(playerid, 6);
          new rand;
          rand = random(sizeof(PenitenciariaSpawn));
          SetPlayerPos(playerid, PenitenciariaSpawn[rand][0], PenitenciariaSpawn[rand][1], PenitenciariaSpawn[rand][2]); // Warp the player
          SetPlayerFacingAngle(playerid, PenitenciariaSpawn[rand][3]);
          PlayerInfo[playerid][pJailTime] = WantedLevel[playerid] * 60;
          PlayerCuffed[playerid] = 0;
          PlayerMutado[playerid] = 0;
          RemovePlayerAttachedObject(playerid, 4);
          SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE); DinamiteMaos[playerid] = 0;
          SetPlayerChatBubble(playerid, "*", COR_VERMELHO, 1, 1);
          format(string, sizeof(string), "Voce foi preso por %d segundos. Precisa de um advogado? /servico advogado", PlayerInfo[playerid][pJailTime]);
          SendClientMessage(playerid, COR_LIGHTBLUE, string);
          PlayerInfo[playerid][pJailed] = 1;
          WantedLevel[playerid] = 0;
          SetPlayerWantedLevelEx(playerid, 0);
          PlayerMutado[playerid] = 0;
          TogglePlayerControllable(playerid, 1);
          for(new i=0; i<75; i++)
          {
                if(InventarioInfo[playerid][i][iSlot] == 1578)
                {
                    InventarioInfo[playerid][i][iSlot] = 19382;
                    InventarioInfo[playerid][i][iUnidades] = 0;
                }
                if(InventarioInfo[playerid][i][iSlot] == 1279)
                {
                    InventarioInfo[playerid][i][iSlot] = 19382;
                    InventarioInfo[playerid][i][iUnidades] = 0;
                }
                if(InventarioInfo[playerid][i][iSlot] == 1575)
                {
                    InventarioInfo[playerid][i][iSlot] = 19382;
                    InventarioInfo[playerid][i][iUnidades] = 0;
                }
                if(InventarioInfo[playerid][i][iSlot] == 1576)
                {
                    InventarioInfo[playerid][i][iSlot] = 19382;
                    InventarioInfo[playerid][i][iUnidades] = 0;
                }
          }
          PlayerInfo[playerid][pMats] = 0;
          //PlayerInfo[playerid][pDina] = 0;
          PlayerInfo[giveplayerid][pCarcereiro] ++;
          KillTimer(tempomover[playerid]);
     }
}
