                else if(strcmp(x_weapon,"mp5",true) == 0) {if(PlayerInfo[playerid][pMats] > 149) { weapon[playerid] = 29; price[playerid] = 100; ammo[playerid] = 360; PlayerInfo[sscanfid][pGun2] = 29; PlayerInfo[sscanfid][pAmmo2] = 360; } else { SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender esta Arma!"); return 1; } }
                else if(strcmp(x_weapon,"shotgun",true) == 0) {if(PlayerInfo[playerid][pMats] > 149) { weapon[playerid] = 25; price[playerid] = 200; ammo[playerid] = 190; PlayerInfo[sscanfid][pGun2] = 25; PlayerInfo[sscanfid][pAmmo2] = 190; } else { SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender esta Arma!"); return 1; } }
                else if(strcmp(x_weapon,"ak47",true) == 0) { if(PlayerInfo[playerid][pMats] > 199) { weapon[playerid] = 30; price[playerid] = 200; ammo[playerid] = 360; PlayerInfo[sscanfid][pGun2] = 30; PlayerInfo[sscanfid][pAmmo2] = 360; } else { SendClientMessage(playerid,COR_GREY,"   Materiais insuficientes para vender esta Arma!"); return 1; } }
                else if(strcmp(x_weapon,"m4",true) == 0) { if(PlayerInfo[playerid][pMats] > 199) { weapon[playerid] = 31; price[playerid] = 200; ammo[playerid] = 360; PlayerInfo[sscanfid][pGun2] = 31; PlayerInfo[sscanfid][pAmmo2] = 360; } else { SendClientMessage(playerid,COR_GREY,"   Materiais insuficientes para vender esta Arma!"); return 1; } }
                else if(strcmp(x_weapon,"rifle",true) == 0) { if(PlayerInfo[playerid][pMats] > 199) { weapon[playerid] = 33; price[playerid] = 200; ammo[playerid] = 230; PlayerInfo[sscanfid][pGun2] = 33; PlayerInfo[sscanfid][pAmmo2] = 230; } else { SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender esta Arma!"); return 1; } }
                else if(strcmp(x_weapon,"faca",true) == 0) { if(PlayerInfo[playerid][pMats] > 49) { weapon[playerid] = 4; price[playerid] = 50; ammo[playerid] = 1; PlayerInfo[sscanfid][pGun1] = 4; PlayerInfo[sscanfid][pAmmo1] = 1; } else { SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender esta Arma!"); return 1; } }
                else if(strcmp(x_weapon,"sniper",true) == 0) { if(PlayerInfo[playerid][pMats] > 199) { weapon[playerid] = 34; price[playerid] = 200; ammo[playerid] = 100; PlayerInfo[sscanfid][pGun2] = 34; PlayerInfo[sscanfid][pAmmo2] = 100; } else { SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender esta Arma!"); return 1; } }
                else { SendClientMessage(playerid,COR_GREY,"Nome da arma invalida!"); return 1; }
                if (ProxDetectorS(5.0,playerid,sscanfid))
                {
                    ConsumingMoney[playerid] = 1;
                    GetPlayerName(sscanfid,giveplayerZCMD,sizeof(giveplayerZCMD));
                    GetPlayerName(playerid,sendername,sizeof(sendername));
                    format(stringZCMD,sizeof(stringZCMD),"Voce vendeu uma %s com %d municoes, e custou %d materiais.",x_weapon,ammo[playerid],price[playerid]);
                    PlayerPlaySound(playerid,1052,0.0,0.0,0.0);
                    SendClientMessage(playerid,COR_GRAD1,stringZCMD);
                    format(stringZCMD,sizeof(stringZCMD),"Voce recebeu uma %s com %d municoes do mafioso %s.",x_weapon,ammo[playerid],sendername);
                    SendClientMessage(sscanfid,COR_GRAD1,stringZCMD);
                    PlayerPlaySound(sscanfid,1052,0.0,0.0,0.0);
                    format(stringZCMD,sizeof(stringZCMD),"* %s vendeu armas para %s.",sendername ,giveplayerZCMD);
                    ProxDetector(30.0,playerid,stringZCMD,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    GivePlayerWeaponEx(sscanfid,weapon[playerid],ammo[playerid]);
                    PlayerInfo[playerid][pMats] -= price[playerid];
                    //SaveVendas();
                }
                else
                {
                    SendClientMessage(playerid,COR_GRAD1,"O cliente nao esta proximo de Voce.");
                    return 1;
                }
            }
            else
            {
                format(stringZCMD,sizeof(stringZCMD),"%d nao esta online este player.",sscanfid);
                SendClientMessage(playerid,COR_GRAD1,stringZCMD);
            }
        }
        return 1;
    }
    CMD:abastecer(playerid, params[])
    {
        if(IsPlayerInAnyVehicle(playerid))
        {
            if(IsAtGasStation(playerid))
            {
                if(GetPlayerState(playerid) == 2)
                {
                    ShowPlayerDialog(playerid, 73, DIALOG_STYLE_LIST,"Voce deseja abastecer seu veiculo?","Abastecer+20 Por Centro - R$ 100\nAbastecer+50 Por Centro - R$ 250\nAbastecer 100 Por Cento - R$ 350\nAbastecer Orgs Especiais - R$ 50","Aceitar","Cancelar");
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta em um posto de Gasolina");
                return 1;
            }
        }
        return 1;
    }
    CMD:algemar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(!IsACop(playerid) && PlayerInfo[playerid][pMembro] != 7 && PlayerInfo[playerid][pLider] != 7 && PlayerInfo[playerid][pEmprego] != 7)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao e um Oficial !");
                return 1;
            }
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /algemar [id]");
                return true;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(gTeam[sscanfid] == 2 || IsACop(sscanfid) || ModoTrabalhoDetran[playerid] == 1)
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao pode algemar COPs !");
                        return true;
                    }
                    if(Algemado[sscanfid] == 1)
                    {
                        SendClientMessage(playerid, COR_GREY, "O Jogador ja esta algemado !");
                        return true;
                    }
                    if(WantedLevel[sscanfid] == 0)
                    {
                        SendClientMessage(playerid, COR_GREY, "O Jogador nao esta procurado !");
                        return 1;
                    }
                    if(GetPlayerState(sscanfid) == 2)
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce nao pode algemar o motorista do veiculo!");
                        return 1;
                    }
                    if(GetPlayerState(playerid) == 2 && !IsPlayerInAnyVehicle(sscanfid))
                    {
                        SendClientMessage(playerid, COR_GREY, "Voce esta dentro de um veiculo, e por isso Voce nao pode alguemar que esta fora !");
                        return 1;
                    }
                    else if(SeRendeu[sscanfid] == 0)
                    {
                        SendClientMessage(playerid, COR_GREY, "Esse jogador nao se rendeu ! (Mandar /hd ou /hi)");
                        return 1;
                    }
                    if(PlayerInfo[playerid][pEmprego] == 7)
                    {
                        if(!PlayerToPoint(30.0,playerid,1770.6527,-1573.1688,1734.9430))
                        {
                            SendClientMessage(playerid, COR_GREY, "Voce so pode algemar jogadores dentro da penitenciaria !");
                            return 1;
                        }
                    }
                    if (ProxDetectorS(2.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se algemar!"); return true; }
                        {
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            GetPlayerName(playerid, sendername, sizeof(sendername));
                            format(stringZCMD, sizeof(stringZCMD), "* Voce foi algemado por: %s.", PlayerName(playerid));
                            SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "* Voce algemou %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "* Oficial: %s algemou o suspeito: %s.", sendername ,giveplayerZCMD);
                            ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                            GameTextForPlayer(sscanfid, "~r~Algemado", 2500, 3);
                            PlayerCuffed[sscanfid] = 2;
                            SetPlayerAttachedObject(sscanfid, 9, 19418, 6, -0.031999, 0.024000,-0.024000,-7.900000,-32.000011,-72.299987, 1.115998, 1.322000, 1.406000);
                            SetPlayerSpecialAction(sscanfid, 24);
                            Algemado[sscanfid] = 1;
                            SeRendeu[sscanfid] = 0;
                            if(ProcuraOffer[sscanfid] == playerid)
                            {
                                ProcuraOffer[sscanfid] = 999;
                                format(gstring, sizeof(gstring), "[Procurando] %s[%d] que Voce estava procurando foi algemado, para cancelar a busca, use: /procuraroff.", PlayerName(playerid), playerid);
                                SendClientMessage(sscanfid, COR_AMARELO, gstring);
                            }
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, " O Jogador esta longe de Voce !");
                        return true;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "Esse nao e um jogador ativo !");
                    return true;
                }
            }
        }
        return true;
    }
    CMD:desalgemar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(!IsACop(playerid) && PlayerInfo[playerid][pEmprego] != 7)
            {
                SendClientMessage(playerid, COR_GREY, "* Voce nao e um Oficial!");
                return 1;
            }
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /desalgemar [id]");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if (ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid)
                        {
                            SendClientMessage(playerid, COR_GREY, "Voce nao pode se desalgemar!");
                            return 1;
                        }
                        if(PlayerCuffed[sscanfid])
                        {
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            GetPlayerName(playerid, sendername, sizeof(sendername));
                            format(stringZCMD, sizeof(stringZCMD), "* Voce foi desalgemado pelo: %s.", sendername);
                            SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                            format(stringZCMD, sizeof(stringZCMD), "* Voce desalgemou %s.", giveplayerZCMD);
                            SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                            GameTextForPlayer(sscanfid, "~g~Desalgemado", 2500, 3);
                            RemovePlayerAttachedObject(sscanfid, 9);
                            SetPlayerSpecialAction(sscanfid, SPECIAL_ACTION_NONE);
                            PlayerCuffed[sscanfid] = 0;
                            PlayerMutado[sscanfid] = 0;
                            Algemado[sscanfid] = 0;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_GREY, " Este jogador nao esta algemado !");
                            return 1;
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, " O Jogador esta longe de Voce !");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, " O Jogador esta Off-Line !");
                return 1;
            }
        }
        return 1;
    }
    CMD:procuraroff(playerid, params[])
    {
        KillTimer(timer[playerid]);
        DisablePlayerCheckpoint(playerid);
        SendClientMessage(playerid, COR_GRAD1, "Voce retirou o seu checkpoint !");
        return 1;
    }
    CMD:acharcasa(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new CasaBern;
            if(sscanf(params, "u", CasaBern))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /acharcasa [ID]");
                return true;
            }
            SetPlayerCheckpoint(playerid, HouseInfo[CasaBern][hEntrancex], HouseInfo[CasaBern][hEntrancey], HouseInfo[CasaBern][hEntrancez], 5.0);
        }
        return 1;
    }
    CMD:pchuck(playerid, params[])
    {
        if(sscanf(params, "u", sscanfid))
        {
            SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /pchuck [ id ]");
            return true;
        }
        if(PlayerInfo[playerid][pTrazerChuck] == 1)
        {
            if(PrimeiroChuck[sscanfid] == 1)
            {
                new Float:pX,Float:pY,Float:pZ;
                DisablePlayerCheckpoint(playerid);
                GetPlayerPos(sscanfid, pX,pY,pZ);
                SetPlayerCheckpoint(playerid, pX,pY,pZ, 6);
                GameTextForPlayer(playerid, "~r~siga o checkpoint !",5000, 6);
                timer[playerid] = SetTimerEx("Procurando",500,true,"ii",playerid, sscanfid);
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce so pode procurar pelo id do Chuck Norris !");
                return 1;
            }
        }
        else
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao esta no evento paintball !");
            return 1;
        }
        return 1;
    }
    CMD:localizaradm(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] <= 1339)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e tem permissao para usar esse comando !");
                return true;
            }
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /procurar [id]");
                return true;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                    format(stringZCMD, sizeof stringZCMD, "%s[%d] esta no interior: [%s].", giveplayerZCMD,sscanfid, GetNomeInterior(InteriorAtual[sscanfid]));
                    SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                    return true;
                }
            }
            else
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
            }
        }
        return true;
    }
    CMD:procurar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(ProcurarSis == true)
            {
                if((PlayerInfo[playerid][pEmprego] != 1) && (PlayerInfo[playerid][pEmprego] != 3))
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao e Detetive/Seguranca !");
                    return true;
                }
                if(UsedVBSTAFF[playerid] != 0 && PlayerInfo[playerid][pDetSkill] < 201)
                {
                    SendClientMessage(playerid, COR_GREY, "Voce so pode procurar novamente, daqui a 2 Minutos !");
                    return true;
                }
                if(sscanf(params, "u", sscanfid))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /procurar [id]");
                    return true;
                }

                if(AdminTrabalhando[sscanfid] != 0)
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao pode procurar admins em modo trabalho !");
                    return 1;
                }
                if(NaPorraDoEvento[sscanfid] == true)
                {
                    SendClientMessage(playerid, COR_GREY, "Voce nao pode procurar jogadores que estejam em algum evento!");
                    return 1;
                }
                if(PlayerInfo[sscanfid][pAdmin] >= 1340)
                {
                    SendClientMessage(playerid, COR_GRAD2, "Voce nao pode procurar por Admins Donos!");
                    return 1;
                }
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        static Float:X,Float:Y,Float:Z;
                        ProcuraOffer[playerid] = sscanfid;
                        if(PlayerInfo[sscanfid][pJailed] != 0)
                        {
                            DisablePlayerCheckpoint(playerid);
                            if(PlayerInfo[sscanfid][pPenitenciaria] == 1)
                            {
                                format(stringZCMD, sizeof stringZCMD, "O Jogador esta preso na Penitenciaria LS!");
                                SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                            }
                            else if(PlayerInfo[sscanfid][pPenitenciaria] == 2)
                            {
                                format(stringZCMD, sizeof stringZCMD, "O Jogador %s esta preso no carandiru!", giveplayerZCMD);
                                SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                            }
                            SetPlayerCheckpoint(playerid, X,Y,Z, 6);
                            return true;
                        }
                        if(emduelo[sscanfid] == 1)
                        {
                            SendClientMessage(playerid, COR_LIGHTRED, "O Jogador esta em um duelo na arena de duelos!");
                            DisablePlayerCheckpoint(playerid);
                            SetPlayerCheckpoint(playerid, X,Y,Z, 6);
                            return true;
                        }
                        if(InteriorAtual[playerid] != 0)
                        {
                            DisablePlayerCheckpoint(playerid);
                            format(stringZCMD, sizeof stringZCMD, "%s[%d] esta no interior: [%s].", giveplayerZCMD,sscanfid, GetNomeInterior(InteriorAtual[sscanfid]));
                            SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                            SetPlayerCheckpoint(playerid, X,Y,Z, 6);
                            return true;
                        }
                        if(HouseEntered[sscanfid] != 999)
                        {
                            DisablePlayerCheckpoint(playerid);
                            format(stringZCMD, sizeof stringZCMD, "%s[%d] esta dentro da casa [%d], digite /info e procure-a no mapa !", giveplayerZCMD,sscanfid,HouseEntered[sscanfid]);
                            SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                            SetPlayerCheckpoint(playerid, X,Y,Z, 6);
                            return true;
                        }
                        if(Inenforcer[sscanfid] != 0)
                        {
                            DisablePlayerCheckpoint(playerid);
                            format(stringZCMD, sizeof stringZCMD, "%s[%d] esta dentro da cela do enforcer [%d] !", Inenforcer[sscanfid]);
                            SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                            SetPlayerCheckpoint(playerid, X,Y,Z, 6);
                            return true;
                        }
                        DisablePlayerCheckpoint(playerid);
                        KillTimer(timer[playerid]);
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerPos(sscanfid, X,Y,Z);
                        SetPlayerCheckpoint(playerid, X,Y,Z, 6);
                        GameTextForPlayer(playerid, "~p~siga o checkpoint !",5000, 6);
                        timer[playerid] = SetTimerEx("Procurando",500,true,"ii",playerid,sscanfid);
                        PlayerInfo[playerid][pDetSkill] ++;
                        UsedVBSTAFF[playerid] = 1;
                        if(PlayerInfo[playerid][pDetSkill] == 50)
                        {
                            SendClientMessage(playerid, COR_AMARELO, "* Seu nivel de detetive agora e 2, Voce pode procurar mais rapido e encontrar mais rapido.");
                        }
                        else if(PlayerInfo[playerid][pDetSkill] == 100)
                        {
                            SendClientMessage(playerid, COR_AMARELO, "* Seu nivel de detetive agora e 3, Voce pode procurar mais rapido e encontrar mais rapido.");
                        }
                        else if(PlayerInfo[playerid][pDetSkill] == 150)
                        {
                            SendClientMessage(playerid, COR_AMARELO, "* Seu nivel de detetive agora e 4, Voce pode procurar mais rapido e encontrar mais rapido.");
                        }
                        else if(PlayerInfo[playerid][pDetSkill] == 200)
                        {
                            SendClientMessage(playerid, COR_AMARELO, "* Seu nivel de detetive agora e 5, Voce pode procurar mais rapido e encontrar mais rapido.");
                        }
                    }
                }
                else
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
                }
            }
        }
        return true;
    }
    CMD:id(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /id [ nick ]");
                return true;
            }
            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
            if(IsPlayerConnected(sscanfid))
