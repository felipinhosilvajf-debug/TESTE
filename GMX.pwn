    CMD:particular(playerid, params[])  return ForT:par(playerid, params);
    CMD:par(playerid, params[])
    {
        if(PlayerMutado[playerid] == 1)
        {
            SendClientMessage(playerid, TEAM_CYAN_COR, "Voce nao pode falar, pois foi calado !");
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um admin!");
                return 1;
            }
            if(AdminTrabalhando[playerid] < 1)
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                return 1;
            }
            new result[128];
            if(sscanf(params, "us[128]", sscanfid, result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: (/par)ticular [id] [texto]");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] >= 1 || PlayerInfo[sscanfid][pAdmin] >= 1)
            {
                SendClientMessage(playerid, COR_OBS, "ERRO: {ffffff}Voce nao e um admin ou o player que Voce digitou nao e admin!");
                return 1;
            }
            if(BlockPar == 1)
            {
                SendClientMessage(playerid, COR_GREY, "O envio de particulares esta desativado, fale com um admin 1340+ para desbloquear!");
                return 1;
            }
            if (IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    GetPlayerName(playerid, sendername, sizeof(sendername));
                    GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                    format(stringZCMD, sizeof(stringZCMD), "%s[%d] particular: %s", sendername, playerid, (result));
                    SendClientMessage(sscanfid, COR_VAGOS, stringZCMD);
                    if(sscanfid != playerid)
                    {
                        new gmsg[255];
                        format(gmsg, sizeof(gmsg), "Admin(%s[%d]) - Para(%s[%d]) particular: (%s)", PlayerName(playerid), playerid, PlayerName(sscanfid), sscanfid, (result));
                        SpyAll(COR_AMARELO, gmsg);
                    }
                    ParticularLog(stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "PM enviada para %s[%d]: (%s)", PlayerName(sscanfid), sscanfid, result);
                    SendClientMessage(playerid, COR_SHOX, stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "[Spy Particular]: %s[%d], enviou: %s - Para: %s[%d]",sendername,playerid,(result),PlayerName(sscanfid),sscanfid);
                    SpyPAR(COR_AMARELO, playerid, stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "AvisoAdmin: %s respondeu com um particular o Jogador: %s.",sendername,PlayerName(sscanfid));
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                    return 1;
                }
            }
            else
            {
                SendClientMessage(playerid, 0xfa4c4cff, "ERRO: {ffffff}nao ha nenhum jogador on-line com esse ID/Nick!");
                return 1;
            }
        }
        return 1;
    }
