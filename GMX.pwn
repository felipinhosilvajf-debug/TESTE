    CMD:mudarcela(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pEmprego] != 7 && !IsACop(playerid))
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um Oficial / Agente Penitenciario  !");
                return true;
            }
            if(sscanf(params, "u", sscanfid))
                return SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /mudarcela [id]");
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_AMARELO," Voce nao pode usar este comando agora !");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if (ProxDetectorS(8.0, playerid, sscanfid))
                    {
                        if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se mudar de cela!"); return 1; }
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce trocou %s de cela.", giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "Voce foi trocado de cela por %s. ", sendername);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        new rand;
                        rand = random(sizeof(PenitenciariaSpawn));
                        LoadObjects(playerid);
                        SetPlayerPos(sscanfid, PenitenciariaSpawn[rand][0], PenitenciariaSpawn[rand][1], PenitenciariaSpawn[rand][2]);
                        format(stringZCMD, sizeof(stringZCMD), "* %s trocou %s para outra cela.", sendername ,giveplayerZCMD);
                        ProxDetector(30.0, playerid, stringZCMD, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "O Jogador esta longe de Voce !");
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "O Jogador esta Offline !");
                return 1;
            }
        }
        return 1;
    }
