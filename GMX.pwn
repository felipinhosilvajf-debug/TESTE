    CMD:sethora(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new hour2;
            if(sscanf(params, "d", hour2))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /sethora [hora do dia] (0-23)");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 3)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                SetWorldTime(hour2);
                format(stringZCMD, sizeof(stringZCMD), "Tempo Definido Para %d Horas.", hour2);
                SendClientMessageToAll(COR_GRAD1, stringZCMD);
            }
            else
            {
                SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao e um Administrador");
            }
        }
        return 1;
    }
    CMD:iniciarloteria(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] >= 1337)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                format(stringZCMD, sizeof(stringZCMD), "Loteria: Ja comecou a loteria.");
                SendClientMessageToAll(COR_BRANCO, stringZCMD);
                new rand = random(80);
                if(rand < 77) { rand += 3; }
                Lotto(rand);
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um admin !");
                return 1;
            }
        }
        return 1;
    }
    CMD:iniciarhay(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] < 1337)return SendClientMessage(playerid, COR_GRAD1, " Voce nao pode usar este comando!");
        if(hayiniciado)
        return SendClientMessage(playerid, COR_GRAD1, "Hay ja iniciado, use /destruirhay primeiro!");
        moneyHay = 100000;
        GivePlayerMoneyEx(playerid, -moneyHay);
        hayiniciado = 1;
        RestartEveryThing();
        for(new i; i != MAX_PLAYERS; i++)
        {
            JoinedHay[i] = 0;
            ShowPlayerDialog(i, 335, DIALOG_STYLE_MSGBOX, "Evento Hay", "Voce deseja ir ao evento ?", "Sim", "Nao");
            SendClientMessage(i, COR_LIGHTBLUE, "Admin esta chamando todos para um evento de Hay!");
            SendClientMessage(i, COR_LIGHTBLUE, "Clique em Sim para ir ou nao Para Continuar aonde esta !");
        }
        return 1;
    }
    CMD:destruirhay(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] < 1337)return SendClientMessage(playerid, COR_GRAD1, " Voce nao pode usar este comando!");
        hayiniciado = 0;
        DestroyHay();
        for(new i; i != MAX_PLAYERS; i++)
        {
            JoinedHay[i] = 0;
        }
        return 1;
    }
    CMD:criarfall(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] >= 1337)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(falliniciado)return SendClientMessage(playerid, COR_GRAD1, " Fallout ja criado,  destrua ou /iniciarfall para iniciar!");
                loadFall();
                falliniciado = 1;
                foreach(new i: Player)
                {
                    SetPVarInt(i, "inFall", 0);
                    ShowPlayerDialog(i, 333, DIALOG_STYLE_MSGBOX, "Evento FallOut", "Voce deseja ir ao evento ?", "Sim", "Nao");
                    SendClientMessage(i, COR_LIGHTBLUE, "Admin esta chamando todos para um evento de Parkour!");
                    SendClientMessage(i, COR_LIGHTBLUE, "Clique em Sim para ir ou nao Para Continuar aonde esta !");
                }
                fallstart = 0;
                SetTimer("IniciarFalloutA", 15000, false);
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao tem permissao para usar esse comando!");
                return 1;
            }
        }
        return 1;
    }
    CMD:iniciarfall(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] >= 1337)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(!falliniciado)return SendClientMessage(playerid, COR_GRAD1, " Fallout nao criado, digite /criarfall para criar!");

                KillTimer(fallTimer);

                fallTimer = SetTimer("fallfunc", 3000, 1);

                GameTextForAll("~p~Fallout iniciado!", 5000, 1);

                new Stri[128];

                format(Stri, sizeof Stri, "O admin %s iniciou o FallOut, Boa Sorte aos participantes!", PlayerName(playerid));
                SendClientMessageToAll(COR_AMARELO, Stri);

                fallCount = totalo;

                fallstart = 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao tem permissao para usar esse comando!");
                return 1;
            }
        }
        return 1;
    }
    CMD:destruirfall(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] >= 1337)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                fallDestroy();
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao tem permissao para usar esse comando!");
                return 1;
            }
        }
        return 1;
    }
    CMD:editar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new editarnome[MAX_PLAYER_NAME];
            new editarnome2[MAX_PLAYER_NAME];
            new stat, quantidade;
            if(sscanf(params, "udd", sscanfid, stat, quantidade))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /editar [ ID ] [STATUS] [QUANTIDADE]");
                SendClientMessage(playerid, COR_GRAD4, "|1 Level |2 Horas Jogadas |3 Conta Bancaria |4 NÂº Telefone |5 Respeito");
                SendClientMessage(playerid, COR_GRAD3, "|6 Chave Casa |7 ChaveBizz |8 ChaveFazenda |9 Detetive |10 Advogado |11 Mecanico");
                SendClientMessage(playerid, COR_GRAD2, "|12 V.Drogas|13 Avisos |14 P.Neg Carteira |15 VIP |16 Socio");
                SendClientMessage(playerid, COR_GRAD2, "|17 Crimes Cometidos |18 Dias VIP |19 Mudancas de Nick");
                SendClientMessage(playerid, COR_GRAD2, "|20 Carro VIP |21 Carro Fixo |22 Moedas |23 Materias |24 Caixa RS Pontos");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                GetPlayerName(playerid,editarnome,sizeof(editarnome));
                GetPlayerName(sscanfid,editarnome2,sizeof(editarnome2));
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if (PlayerInfo[playerid][pAdmin] >= 1337)
                    {
                        if(AdminTrabalhando[playerid] < 1)
                        {
                            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                            return 1;
                        }
                        if(PlayerInfo[sscanfid][pAdmin] == 1342 && PlayerInfo[playerid][pAdmin] != 1342)
                        {
                            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode editar o Dono/Scripter !");
                            return 1;
                        }
                        if(sscanfid == playerid && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
                        {
                            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode se editar");
                            return 1;
                        }
                        switch (stat)
                        {
                            case 1:
                            {
                                PlayerInfo[sscanfid][pLevel] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou level:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                ScoreLevel(sscanfid);
                                EditarLog(stringZCMD);
                            }
                            case 2:
                            {
                                PlayerInfo[sscanfid][pConnectTime] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou horas jogadas:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 3:
                            {
                                if(PlayerInfo[playerid][pAdmin] < 1340)
                                {
                                    if(quantidade > 500000)
                                    {
                                        SendClientMessage(playerid, COR_GRAD1, "Apenas um Administrador Dono, pode editar um valor mais alto que 500000 !");
                                        return 1;
                                    }
                                }
                                new ValorAntigo;
                                ValorAntigo = PlayerInfo[sscanfid][pConta];
                                PlayerInfo[sscanfid][pConta] = quantidade;
                                new logs[256];
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou conta bancaria:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                format(logs, sizeof(logs), "[EDITAR] Admin %s editou a conta bancaria:[%d] em: %s(Valor bancario antigo era de %d)",PlayerName(playerid), quantidade, ValorAntigo);
                                EditarLog(logs);
                            }
                            case 4:
                            {
                                PlayerInfo[sscanfid][pPnumber] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou numero:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 5:
                            {
                                PlayerInfo[sscanfid][pExp] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou respeito:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 6:
                            {
                                PlayerInfo[sscanfid][pPHousekey] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou chave da casa:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 7:
                            {
                                PlayerInfo[sscanfid][pPbiskey] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou chave da empresa:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 8:
                            {
                                PlayerInfo[sscanfid][pPFazkey] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou chave da fazenda:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 9:
                            {
                                PlayerInfo[sscanfid][pDetSkill] = quantidade;
                                format(stringZCMD, sizeof(stringZCMD), "[EDITAR] Admin %s editou detetive:[%d] em: %s", PlayerName(playerid), quantidade, PlayerName(sscanfid));
                                EditarLog(stringZCMD);
                            }
                            case 10:
                            {
