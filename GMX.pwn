    CMD:banirserial(playerid, params[])
    {
        new targetid;
        new playernameZCMDxD[MAX_PLAYER_NAME],targetname[MAX_PLAYER_NAME];
        GetPlayerName(playerid,playernameZCMDxD,sizeof(playernameZCMDxD));
        GetPlayerName(targetid,targetname,sizeof(targetname));
        if(PlayerInfo[playerid][pAdmin] < 1341 )
        {
            return SendClientMessage(playerid,0xC20000FF,"Voce nao esta autorizado a usar este comando !");
        }
        if(sscanf(params, "u", targetid))
        {
            return SendClientMessage(playerid, COR_GRAD5, "{df5454}Ã—{ffffff} USE: /banirserial [ ID ]");
        }
        if(IsPlayerNPC(targetid)) return 1;
        if(!IsPlayerConnected(targetid))
        {
            return SendClientMessage(playerid,0xC20000FF,"Voce nao esta autorizado a usar este comando.");
        }
        if(strcmp(PlayerName(targetid),"VBSTAFF", true) == 0 )
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao pode banir o serial do VBSTAFF kkkk seu Otario");
            format(gstring, sizeof(gstring), "%d AUTOMATICO, [Tentou Banir o Serial].", playerid);
            ForT:kick(sscanfid, gstring);
            return 1;
        }
        new serialini[512];
        format(serialini,sizeof(serialini),"Banido Serial/%s.cfg", GetPlayerSerial(targetid));
        if(!DOF2_FileExists(serialini))
        {
            DOF2_CreateFile(serialini);
            DOF2_SetString(serialini, "Nick", PlayerName(targetid));
            DOF2_SetInt(serialini, "Banido", 1);
            DOF2_SaveFile();
        }
        format(stringZCMD, sizeof(stringZCMD), "AvisoAdmin: %s baniu o serial do jogador %s.",PlayerName(playerid),PlayerName(targetid));
        ABroadCast(COR_AMARELO,stringZCMD,1);
        BanLog(stringZCMD);
        return 1;
    }
    CMD:desbanirserial(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] < 1342)
        {
            return SendClientMessage(playerid,0xC20000FF,"Voce nao esta autorizado a usar este comando !");
        }
        new serialbanido[512];
        if(sscanf(params, "s[512]", serialbanido))
        {
            return SendClientMessage(playerid, COR_GRAD5, "{df5454}Ã—{ffffff} USE: /desbanirserial [ Nome ]");
        }
        new serialini[512];
        new NomeDoViado[MAX_PLAYER_NAME];
        format(serialini,sizeof(serialini),"Banido Serial/%s.cfg",serialbanido);
        strmid(NomeDoViado, DOF2_GetString(serialini,"Nick"), 0, strlen(DOF2_GetString(serialini,"Nick")), 255);
        if(DOF2_FileExists(serialini))
        {
            DOF2_RemoveFile(serialini);
            printf("chegou niin");
        }
        else if(!DOF2_FileExists(serialini))
        {
            SendClientMessage(playerid, COR_GRAD5, "Serial invalido!");
            return 1;
        }
        format(stringZCMD, sizeof(stringZCMD), "AvisoAdmin: %s desbaniu o serial do jogador %s.",PlayerName(playerid),NomeDoViado);
        ABroadCast(COR_AMARELO,stringZCMD,1);
        BanLog(stringZCMD);
        return 1;
    }
    CMD:banirip(playerid, params[])  return ForT:ban(playerid, params);
    CMD:banip(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new dias, mes, ano;
            new result[64];
            if(sscanf(params, "uddis[64]", sscanfid, dias, mes, ano, result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /banirip [ID] [Dia] [Mes] [Ano] [Motivo]");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] >= 2)
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(IsPlayerNPC(sscanfid)) return 1;
                    if(PlayerInfo[sscanfid][pAdmin] >= 1 && PlayerInfo[playerid][pAdmin] != 1340 && PlayerInfo[playerid][pAdmin] != 1341 && PlayerInfo[playerid][pAdmin] != 1342)
                    {
                        if(sscanfid != playerid)
                        {
                            return 1;
                        }
                    }
                    if(AdminTrabalhando[playerid] < 1)
                    {
                        SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                        return 1;
                    }
                    if(strcmp(PlayerName(sscanfid),"VBSTAFF", true) == 0 )
                    {
                        format(gstring, sizeof(gstring), "/kick %d AUTOMATICO [Tentou banir VBSTAFF].", playerid);
                        ForT:kick(playerid, gstring);
                        return 1;
                    }
                    GetPlayerName(playerid, sendername, sizeof(sendername));
                    if(pban[playerid] >= 3 && PlayerInfo[playerid][pAdmin] < 1339)
                    {
                        BanBHCNORMAL(playerid, "Baniu mais de 3", "Automatico");
                        return 1;
                    }
                    if(dias == 0 && mes == 0 && ano == 0)
                    {
                        getdate(year, month, day);
                        pban[playerid] += 1;
                        format(stringZCMD, sizeof(stringZCMD), "[BAN]: %s foi banido permanentemente por %s, Motivo[%s]", PlayerName(sscanfid), sendername, (result),day,month,year);
                        BanLog(stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "[BAN]: %s foi banido permanentemente por %s, Motivo[%s]", PlayerName(sscanfid), sendername, (result));
                        SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
                        printf("[BAN]: %s foi banido permanentemente por %s, Motivo: %s", PlayerName(sscanfid), sendername, (result));
                        SendClientMessage(sscanfid, COR_AMARELO, "|________________Instrucoes para Revisao de Ban________________|");
                        SendClientMessage(sscanfid, COR_AL, "Tire uma SS da tela apertando F8 imediatamente apos ser banido");
                        SendClientMessage(sscanfid, COR_AL, "E acesse o nosso discord: {df5454}https://discord.gg/9QP6UnS6xd");
                        SendClientMessage(sscanfid, COR_LIGHTRED, "Atencao: Voce so sera desbanido se for inocente !");
                        PlayerInfo[sscanfid][pDiaBanTemp] = dias;
                        PlayerInfo[sscanfid][pMesBanTemp] = mes;
                        PlayerInfo[sscanfid][pAnoBanTemp] = ano;
                        OnPlayerSave(sscanfid);
                        BanBHC(sscanfid, result, sendername);
                    }
                    else if(dias > 0 && mes > 0 && ano > 0)
                    {
                        getdate(year, month, day);
                        pban[playerid] += 1;
                        format(stringZCMD, sizeof(stringZCMD), "[BAN]: %s foi banido temporariamente por %s, Motivo[%s], Desban[%02d/%02d/%02d]", PlayerName(sscanfid), sendername, (result), dias, mes, ano);
                        BanTempLog(stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "[BAN]: %s foi banido temporariamente por %s, Motivo[%s], Desban[%02d/%02d/%02d]", PlayerName(sscanfid), sendername, (result), dias, mes, ano);
                        SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
                        printf("[BAN]: %s foi banido temporariamente por %s, Motivo[%s] Desban[%02d/%02d/%02d]", PlayerName(sscanfid), sendername, (result), dias, mes, ano);
                        SendClientMessage(sscanfid, COR_AMARELO, "|________________Instrucoes para Revisao de Ban________________|");
                        SendClientMessage(sscanfid, COR_AL, "Tire uma SS da tela apertando F8 imediatamente apos ser banido");
                        SendClientMessage(sscanfid, COR_AL, "E acesse o nosso discord: {df5454}https://discord.gg/9QP6UnS6xd");
                        SendClientMessage(sscanfid, COR_LIGHTRED, "Atencao: Voce so sera desbanido se for inocente !");
                        PlayerInfo[sscanfid][pDiaBanTemp] = dias;
                        PlayerInfo[sscanfid][pMesBanTemp] = mes;
                        PlayerInfo[sscanfid][pAnoBanTemp] = ano;
                        OnPlayerSave(sscanfid);
                        BanTemp(sscanfid, result, PlayerName(playerid));
                    }
                    return 1;
                }
            }
            else
            {
                return 1;
            }
        }
        return 1;
    }


