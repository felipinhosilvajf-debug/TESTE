            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /settime [id]");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] >= 1)
            {
                if(IsPlayerConnected(para1))
                {
                    GetPlayerName(para1, giveplayerZCMD, sizeof(giveplayerZCMD));
                    GetPlayerName(playerid, sendername, sizeof(sendername));
                    SetPlayerSpawn(para1);
                    ClearCrime(para1);
                    if(GetPlayerState(para1) == PLAYER_STATE_DRIVER) { SetVehicleToRespawn(GetPlayerVehicleID(para1)); }
                    format(stringZCMD, sizeof(stringZCMD), "O Admin %s colocou Voce em seu spawn.",sendername);
                    SendClientMessage(para1, COR_LIGHTBLUE, stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "Voce colocou %s em seu spawn.",giveplayerZCMD);
                    SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "AvisoAdmin: %s colocou o Jogador: %s para seu spawn.",sendername,giveplayerZCMD);
                    ABroadCast(COR_AMARELO,stringZCMD,1);
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
            }
        }
        return 1;
    }
