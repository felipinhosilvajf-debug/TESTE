//  VagasLivresAdm = 0;
    return 0;
}
START:: SalvarAdmins()
{
    new idx;
    new File: file2;
    while (idx < sizeof(AdmInfo))
    {
        new coordsstring[256];
        format(coordsstring, sizeof(coordsstring), "%s,%d\n", AdmInfo[idx][AdminNick], AdmInfo[idx][AdminVaga]);
        if (idx == 0)
        {
            file2 = fopen("Configs/Admins.cfg", io_write);
