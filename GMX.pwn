    CMD:dance(playerid, params[])
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            if(isnull(params))
            {
                SendClientMessage(playerid,0xFF0000FF,">USE /dance [1-4]");
                return 1;
            }
            animationplayed = strval(params);
            if(animationplayed < 1 || animationplayed > 4)
            {
                SendClientMessage(playerid,0xFF0000FF,">USE /dance [1-4]");
                return 1;
            }
            if(animationplayed == 1)
            {
                SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE1);
                ComAnim[playerid] = true;
            }
            else if(animationplayed == 2)
            {
                SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE2);
                ComAnim[playerid] = true;
            }
            else if(animationplayed == 3)
            {
                SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE3);
                ComAnim[playerid] = true;
            }
            else if(animationplayed == 4)
            {
                SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DANCE4);
                ComAnim[playerid] = true;
            }
        }
        return 1;
    }
    CMD:descricao(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(isnull(params))
            {
                SendClientMessage(playerid, COR_OBS, "ERRO: {ffffff}/descricao [ TEXTO ]");
                return 1;
            }
            for(new i = 0; i < sizeof(HouseInfo); ++i)
            {
                if (PlayerToPoint(3, playerid,HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez]))
                {
                    if(PlayerInfo[playerid][pPHousekey] != 999)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "INFO: {ffffff}Descricao da sua Casa mudado para: %s", params);
                        SendClientMessage(playerid, COR_OBS, stringZCMD);
                        strmid(HouseInfo[PlayerInfo[playerid][pPHousekey]][hDiscription], params, 0, strlen(params), 999);
                        SaveCasa(PlayerInfo[playerid][pPHousekey]);
                    }
                }
                else
                {
                    //SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao tem uma casa ou nao esta na entrada dela!");
                }
            }

            Atualizar3Dtexts();
        }
        return 1;
    }
    CMD:trazercasa(playerid, params[])
    {
        new idcasa;
        if(sscanf(params, "d", idcasa))
        {
            SendClientMessage(playerid,COR_GREY,"{df5454}Ã—{ffffff} USE: /trazercasa [ID]");
            return 1;
        }
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        HouseInfo[idcasa][hEntrancex] = x;
        HouseInfo[idcasa][hEntrancey] = y;
        HouseInfo[idcasa][hEntrancez] = z;
        ForT:atualizar3dtext(playerid);
        SaveCasa(idcasa);
        return 1;
    }
