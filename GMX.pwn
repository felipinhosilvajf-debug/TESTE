                GivePlayerWeapon(playerid, 29, 200);
                GivePlayerWeapon(playerid, 31, 200);
                return 1;
            }
            if (PlayerInfo[playerid][pCargo] == 5)
            {
                format(string, sizeof(string), "[%s]: %s pega seus equipamentos de [Sub-Lider]." ,NomeORG(playerid), sendername);
