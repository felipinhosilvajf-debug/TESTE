    CMD:rparedao(playerid, params[])
    {
        if (!PlayerInfo[playerid][pAdmin])
        {
            SendClientMessage(playerid, COR_ADMIN, "Voce nao e um Admin!");
            return 1;
        }
        if (PlantouParedao[playerid] == 0)
