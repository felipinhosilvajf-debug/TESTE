// ======================== by cleyson inventario

AbrirInventarioDialog(playerid)
{
    InventarioAberto[playerid] = 1;

    format(gstring, sizeof(gstring), "* %s Abriu seu inventario.", PlayerName(playerid));
    ProxDetector(30.0, playerid, gstring, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);

    MostrarInventarioDialog(playerid);
    return 1;
}

MostrarInventarioDialog(playerid)
{
    new str[100], strtitulo[70], strtotal[4000];

    format(strtitulo, sizeof(strtitulo), "Inventario de: %s", PlayerName(playerid));

    format(str, sizeof(str), "Slot\tItem\tQuantidade\n");
    strcat(strtotal, str);

    for(new i = 0; i < 75; i++)
    {
        //if(InventarioInfo[playerid][i][iSlot] != 19382) continue;

        format(str, sizeof(str), "{3786ba}%d\t{df5454}%s\t{ffffff}%d\n", i, NomeItemInvInventario(i, playerid), InventarioInfo[playerid][i][iUnidades]);
        strcat(strtotal, str);
    }

    ShowPlayerDialog(playerid, DIALOG_INVENTARIO, DIALOG_STYLE_TABLIST_HEADERS, strtitulo, strtotal, "Confirmar", "Fechar");
    return 1;
}

stock MenuItemInventario(playerid, item)
{
    new str[50];
    format(str, sizeof(str), "%s", NomeItemInvInventario(item, playerid));
    ShowPlayerDialog(playerid, DIALOG_INVENTARIO_MENU, DIALOG_STYLE_LIST, str, "Usar\nVender\nDescartar\nSeparar", "Ir", "Voltar");
    return 1;
}

stock FecharInventarioDialog(playerid)
{
    format(gstring, sizeof(gstring), "* %s Fechou seu inventario.", PlayerName(playerid));
    ProxDetector(30.0, playerid, gstring, COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
    InventarioAberto[playerid] = 0;
    //PlayerTextDrawHide(playerid, invText[playerid][16]);
    CancelSelectTextDraw(playerid);
    return 1;
}

stock ItemProibido(playerid)
{
    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Huumm.. Algo de errado nao esta certo, isso pode ser proibido no android!\n\n{fa4c4c}OBS: {ffffff}O seu item foi devolvido.");
    //ShowPlayerDialog(playerid, 5256, DIALOG_STYLE_MSGBOX, "Acessorios Desabilitado", "\n{ff0000}Alerta: {ffffff}Voce nao pode colocar acessorios estando logado no servidor pelo Android.\n\n{c7c7c7}Por enquanto ainda nao e possivel carregar acessorios pelo SA-MP Android.\n", "Fechar", "");
    return 1;
}

stock UsarItemInventario(playerid, item)
{
    new slot = SlotEscolhido[playerid];
    new str[256];
    if(item == 19382)
    {
        //SendClientMessage(playerid, 0xFF6347AA, "* nao ha itens suficientes para ser utilizado!");
        //return 1;
    }

    if(item == 3016)//Kitsocio Perm
    {

        GivePlayerWeaponEx(playerid, 46, 1);
        GivePlayerWeaponEx(playerid, 43, 999);
        GivePlayerWeaponEx(playerid, 34, 300);
        GivePlayerWeaponEx(playerid, 29, 800);
        GivePlayerWeaponEx(playerid, 25, 400);
        GivePlayerWeaponEx(playerid, 24, 400);
        GivePlayerWeaponEx(playerid, 4, 1);
        GivePlayerWeaponEx(playerid, 1, 1);

        if(PlayerInfo[playerid][pKitAlternado] == 0)
        {
            GivePlayerWeaponEx(playerid, 31, 800); // m4
            GivePlayerWeaponEx(playerid, 16, 10); //granada
        }
        else if(PlayerInfo[playerid][pKitAlternado] == 1)
        {
            GivePlayerWeaponEx(playerid, 37,20); //lanca chamas
            GivePlayerWeaponEx(playerid, 30,800); // AK-47
            GivePlayerWeaponEx(playerid, 20,5);// Molotov
        }
        SetPlayerArmour(playerid, 150);
        SetPlayerHealth(playerid, 100);

        TempoEquiparSocio[playerid] = GetTickCount();
    }

    if(item == 1212) // dinheiro
    {
        //new str[300];
        format(str,300,"* Voce pegou $%d do seu inventario!",InventarioInfo[playerid][slot][iUnidades]);
        SendClientMessage(playerid,0x00ccccFF,str);
        GivePlayerMoneyEx(playerid, InventarioInfo[playerid][slot][iUnidades]  );//
        InventarioInfo[playerid][slot][iSlot] = 19382;
        InventarioInfo[playerid][slot][iUnidades] = 0;
        //AtualizarInventario(playerid);
        return 1;
    }
    if(item == 19941) // respeito
    {
        DiminuirInv(slot,playerid);
        SendClientMessage(playerid, COR_START,"{df5454}* {FFCC99}Voce usou +1 respeito");
        PlayerInfo[playerid][pExp] += 1;//
        //AtualizarInventario(playerid);
        return 1;
    }
    if(item == 19054) //  Caixa Bronze
    {
        //new it[2];
//          new tem;
        //new str[300];
        SetPVarInt(playerid, "amountMoney", 5000+random(10000));
        SetPVarInt(playerid, "amountRespeito", 1);
        SendClientMessage(playerid, 0x00ccccFF, "* Voce abriu uma Caixa Bronze!");
        DiminuirInv(slot,playerid);
        //AtualizarInventario(playerid);
        new Float: X, Float: Y, Float: Z;
        GetPlayerPos(playerid, X, Y, Z);
        CreateDroppedItem(1212, GetPVarInt(playerid, "amountMoney"), X, Y, Z);
        CreateDroppedItem(19941, 1, X, Y+0.5, Z);
        SetPlayerPos(playerid, X, Y+0.1, Z);
        //BoxAberto[playerid] = 0;
        return 1;
    }
    if(item == 19055)// Caixa Prata
    {
        //new it[2];
      //  new tem;
        //new str[300];
        SetPVarInt(playerid, "amountMoney", 8000+random(20000));
        SetPVarInt(playerid, "amountRespeito", 2);
        SendClientMessage(playerid, 0x00ccccFF, "* Voce abriu uma Caixa Prata!");
        DiminuirInv(slot,playerid);
        //AtualizarInventario(playerid);
        new Float: X, Float: Y, Float: Z;
        GetPlayerPos(playerid, X, Y, Z);
        CreateDroppedItem(1212, GetPVarInt(playerid, "amountMoney"), X, Y, Z);
        CreateDroppedItem(19941, GetPVarInt(playerid, "amountRespeito"), X, Y+0.5, Z);
        SetPlayerPos(playerid, X, Y+0.1, Z);
        //BoxAberto[playerid] = 0;
        return 1;
    }

    if(item == 19056)// Caixa Ouro
    {
        SetPVarInt(playerid, "amountMoney", 9000+random(30000));
        SetPVarInt(playerid, "amountRespeito", 3);
        SendClientMessage(playerid, 0x00ccccFF, "* Voce abriu uma Caixa Ouro!");
        DiminuirInv(slot,playerid);
        //AtualizarInventario(playerid);
        new Float: X, Float: Y, Float: Z;
        GetPlayerPos(playerid, X, Y, Z);
        CreateDroppedItem(1212, GetPVarInt(playerid, "amountMoney"), X, Y, Z);
        CreateDroppedItem(19941, GetPVarInt(playerid, "amountRespeito"), X, Y+0.5, Z);
        SetPlayerPos(playerid, X, Y+0.1, Z);
        //BoxAberto[playerid] = 0;
        return 1;
    }
    if(item == 19057) //caixa platina
    {
        new Float: X, Float: Y, Float: Z;
        GetPlayerPos(playerid, X, Y, Z);
        MEGAString[0] = EOS;
