                            SendClientMessage(playerid, COR_LIGHTRED, "*[Mafiosos] Voce nao pode usar este comando proximo a uma mafia rival !");
                            return 1;
                        }
                    }
                }
            }
            if(GetPlayerOrg(playerid) == 29)
            {
