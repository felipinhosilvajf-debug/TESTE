                return SendClientMessage(playerid, COR_LIGHTRED, "O Valor deve ser entre 1 a 999.999.999 !");
            }
            Armazenar[Armazenar[playerid]] = playerid;
            MEGAString[0] = EOS;
            format(string, sizeof(string), "Voce esta prestes a negociar um item com o jogador %s.\n\n", PlayerName(playerid));
