//===================Sistema de carros das casas trancados======================
public OnVehicleStreamIn(vehicleid, forplayerid)
{
    if (VTrancado[vehicleid] >= 1)
    {
        SetVehicleParamsForPlayer(vehicleid,forplayerid,0,1);
    }
    else
    {
        SetVehicleParamsForPlayer(vehicleid,forplayerid,0,0);
    }
    return 1;
}
START::LockCar(carid)
{
    foreach(new i: Player)
    {
        if(IsPlayerConnected(i))
        {
            SetVehicleParamsForPlayer(carid,i,0,1);
            gCarLock[carid] = 1;
        }
    }
}
START::UnLockCar(carid)
{
    foreach(new i: Player)
    {
        if(IsPlayerConnected(i))
        {
            SetVehicleParamsForPlayer(carid,i,0,0);
            gCarLock[carid] = 0;
        }
    }
}
//===================Sistema de InfoOrg=========================================

START::UpdateMembroOrg(org, cargo, nome[])
{
    if(cargo >= 6)
    {
        strmid(InfoOrg[org][Lider], nome, 0, strlen(nome), MAX_PLAYER_NAME);
        SaveORGS();
        return 1;
    }
    if(cargo == 5)
    {
        if(strcmp(InfoOrg[org][SubLider],"Ninguem",true)==0)
        {
            strmid(InfoOrg[org][SubLider], nome, 0, strlen(nome), MAX_PLAYER_NAME);
            SaveORGS();
            return 1;
        }
    }
    new arquivo[800];
    format(arquivo, sizeof(arquivo), Pasta_ORGVIP, org);
    if(strcmp(InfoOrg[org][Membro1],"Ninguem",true)==0)
