            {
                Sireneon[playerid] = 0;
                DestroyDynamicObject(sirene[GetPlayerVehicleID(playerid)]);
                DestroyDynamicObject(sirene2[GetPlayerVehicleID(playerid)]);
                SendClientMessage(playerid, COR_BRANCO, "Sirene Removida !");
            }
        }
        return 1;
    }
    CMD:cnn(playerid, result[])
    {
        if(IsPlayerConnected(playerid))
        {
            if (PlayerInfo[playerid][pAdmin] >= 1)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                GetPlayerName(playerid, sendername, sizeof(sendername));
                if(isnull(result))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /cnn [cnn formato ~n~=NovaLinha ~r~=Vermelho ~g~=Verde ~b~=Azul ~w~=Branco ~y~=Amarelo ~l~=Preto]");
                    return 1;
                }
                if(AdminTrabalhando[playerid] == 1 && admhide[playerid] == 1)
                {
                    format(stringZCMD, sizeof(stringZCMD), "~b~Anonimo: ~w~%s",result);
                }
                else
                {
                    format(stringZCMD, sizeof(stringZCMD), "~b~%s: ~w~%s",sendername,result);
                }
                cnnlog(stringZCMD);
                foreach(new i: Player)
                {
                    if(IsPlayerConnected(i))
                    {
                        GameTextForPlayer(i, stringZCMD, 5000, 3);
                    }
                }
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
                return 1;
            }
        }
        return 1;
    }
    CMD:cnnn(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if (PlayerInfo[playerid][pAdmin] >= 1340)
            {
                new txtid;
                new result[64];
                if(sscanf(params, "ds[64]", txtid, result))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /cnnn <Digite> [cnnc formato ~n~=NovaLinha ~r~=Vermelho ~g~=Verde ~b~=Azul ~w~=Branco ~y~=Amarelo ~l~=Preto]");
                    return 1;
                }
                format(stringZCMD, sizeof(stringZCMD), "~w~%s",result);
                foreach(new i: Player)
                {
                    if(IsPlayerConnected(i) == 1)
                    {
                        GameTextForPlayer(i, stringZCMD, 5000, txtid);
                    }
                }
                format(stringZCMD, sizeof(stringZCMD), "%s : %s", PlayerName(playerid), result);
                cnnlog(stringZCMD);
                return 1;
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
                return 1;
            }
        }
        return 1;
    }
    CMD:cadeia(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new playa, tempo, result[64];
            if(sscanf(params, "uds[64]", playa, tempo, result))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /cadeia [id] [tempo] [motivo]");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] < 2)
            {
                return 1;
            }
            if(PlayerInfo[playa][pJailed] != 0 && PlayerInfo[playerid][pAdmin] < 4)
            {
                SendClientMessage(playerid,COR_AMARELO,"Voce nao pode soltar presos,so admins nivel 4 + !");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 2)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(playa))
                {
                    if(playa != INVALID_PLAYER_ID)
                    {
                        PlayerInfo[playa][pSkin] = GetPlayerSkin(playa);
                        if(PlayerInfo[playa][pSex] == 1)
                        {
                            SetPlayerSkin(playa, 42);
                        }
                        else
                        {
                            SetPlayerSkin(playa, 69);
                        }
                        SetPlayerSkin(playa, 268);
                        if(PlayerInfo[playa][pSex] == 2) {  SetPlayerSkin(playa, 69); }
                        if(PlayerInfo[playa][pSocio] >= 1) {  SetPlayerSkin(playa, 42); }
                        GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        ResetPlayerWeaponsEx(playa);
                        WantedLevel[playa] = 0;
                        PlayerInfo[playa][pJailed] = 3;
                        PlayerInfo[playa][pJailTime] = tempo*60;
                        SetPlayerInterior(playa, 0);
                        SetPlayerPos(playa, 1175.5886,-1182.0431,87.0254);
                        format(stringZCMD, sizeof(stringZCMD), "* Voce prendeu %s,Motivo: %s.", PlayerName(playa),(result));
                        SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "ADMCMD: %s colocou %s por [%d] minutos na cadeia. Motivo: %s.", PlayerName(playerid), PlayerName(playa) ,tempo,(result));
                        SendClientMessageToAll(COR_LIGHTRED, stringZCMD);
                        if(AdminTrabalhando[playerid] < 1 && admhide[playerid] == 1)
                        {
                            format(stringZCMD, sizeof(stringZCMD), "* Voce foi preso por [%d] minutos por algum Administrador.", tempo);
                            SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
                        }
                        else
                        {
                            format(stringZCMD, sizeof(stringZCMD), "* Voce foi preso por [%d] minutos por %s.", tempo,sendername);
                            SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
                        }
                        SetPlayerChatBubble(playa, ".", COR_VERMELHO, 1, 1);
                        return 1;
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
            }
        }
        return 1;
    }
    CMD:cadeiaoculta(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] < 1340)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado para usar este comando!");
                return 1;
            }
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /cadeiaoculta [ ID ]");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    if(PlayerInfo[sscanfid][pSex] == 1)
                    {
                        SetPlayerSkin(sscanfid, 42);
                    }
                    else
                    {
                        SetPlayerSkin(sscanfid, 69);
                    }
                    GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                    GetPlayerName(playerid, sendername, sizeof(sendername));
                    format(stringZCMD, sizeof(stringZCMD), "* Voce retirou o player %s da cadeia.", giveplayerZCMD);
                    SendClientMessage(playerid, COR_LIGHTRED, stringZCMD);
                    SetPlayerWorldBounds(sscanfid,20000.0000,-20000.0000,20000.0000,-20000.0000); //Reset world to player
                    PlayerInfo[sscanfid][pJailed] = 0;
                    SetPlayerSkin(sscanfid, PlayerInfo[sscanfid][pSkin]);
                    if(gTeam[sscanfid] == 4) { gTeam[sscanfid] = 3; }
                    ClearCrime(sscanfid);
                    SetPlayerToTeamColor(sscanfid);
                    ResetPlayerWeaponsEx(sscanfid);
                    WantedLevel[sscanfid] = 0;
                    SetPlayerWantedLevelEx(sscanfid, 0);
                    StopAudioStreamForPlayer(sscanfid);
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "O jogador esta offline !");
                return 1;
            }
        }
        return 1;
    }
