    CMD:mafia(playerid, params[])
    {
        if(PlayerInfo[playerid][pMembro] == 20 || PlayerInfo[playerid][pLider] == 20 || PlayerInfo[playerid][pMembro] == 22 || PlayerInfo[playerid][pLider] == 22)
        {
            new x_nr[150];
            if(sscanf(params, "s[150]", x_nr)) {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /mafia [nome]");
                SendClientMessage(playerid, COR_BRANCO, "Nomes validos: pegar, trocar.");
                return 1;
            }
            if(strcmp(x_nr,"pegar",true) == 0)
            {
                if(PlayerToPoint(3.0,playerid,1738.6844,-1944.9553,13.5647))
                {
                    if(MatsHolding[playerid] >= 55)
                    {
                        SendClientMessage(playerid, COR_GREY, " Voce ja tem Pacotes !");
                        return 1;
                    }
                    if(sscanf(params, "d", moneysZCMD))
                    {
                        SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /mafia pegar [quantidade]  *Max p/ Vez = 55*");
                        return 1;
                    }
                    if(moneysZCMD < 1 || moneysZCMD > 55) { SendClientMessage(playerid, COR_GREY, "   O Numeros de Pacotes Ã  ser pegos tem que ser mais que 1 e menos que 50 !"); return 1; }
                    new price = moneysZCMD * 100;
                    if(GetPlayerMoneyEx(playerid) > price)
                    {
                        format(stringZCMD, sizeof(stringZCMD), "* Voce recebeu %d Materiais por R$[%d].", moneysZCMD, price);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        GivePlayerMoneyEx(playerid, - price);
                        MatsHolding[playerid] = moneysZCMD;
                    }
                    else
                    {
                        format(stringZCMD, sizeof(stringZCMD), "Voce nao tem R$[%d] !", price);
                        SendClientMessage(playerid, COR_GREY, stringZCMD);
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, " Voce nao esta nas caixas de Materiais na Estacao Unity !");
                    return 1;
                }
            }
            else if(strcmp(x_nr,"trocar",true) == 0)
            {
                if(PlayerToPoint(3.0,playerid,1173.2739,-2037.0060,69.1413))
                {
                    if(MatsHolding[playerid] > 0)
                    {
                        new payout = (100)*(MatsHolding[playerid]);
                        format(stringZCMD, sizeof(stringZCMD), "* Voce pagou [%d] para o Armazen pelos seus %d pacotes.", payout, MatsHolding[playerid]);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        PlayerInfo[playerid][pMats] += payout;
                        MatsHolding[playerid] = 0;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "   Voce nao tem nenhum pacote !");
                        return 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "   Voce nao esta nas caixas de Materiais no Casarao !");
                    return 1;
                }
            }
        }
        return 1;
    }
    CMD:VenderArma(playerid, params[])
    {
        if(PlayerInfo[playerid][pJailed] != 0)
        {
            SendClientMessage(playerid,COR_AMARELO," Voce nao pode vender armas na cadeia!");
            return 1;
        }
        if(IsPlayerConnected(playerid))
        {
            if (PlayerInfo[playerid][pEmprego] != 14)
            {
                SendClientMessage(playerid,COR_GREY,"Voce nao e um Vendendor de Armas !");
                return 1;
            }
            new x_weapon[32],weapon[MAX_PLAYERS],ammo[MAX_PLAYERS],price[MAX_PLAYERS];
            if(sscanf(params, "us[32]", sscanfid, x_weapon))
            {
                SendClientMessage(playerid,COR_GRAD1,"{df5454}Ã—{ffffff} USE: /VenderArma [ID do Player] [Arma]");
                SendClientMessage(playerid,COR_GREY,"Armas: flowers(25) spistola(100) pistola(150) mp5(200) shotgun(200)");
                SendClientMessage(playerid,COR_GREY,"Armas: rifle (600) ak47(600) m4(600)");
                return 1;
            }
            if (sscanfid == playerid)
            {
                SendClientMessage(playerid,COR_GREY,"Voce nao pode vender armas pra si mesmo!");
                return 1;
            }
            if (IsPlayerConnected(sscanfid))
            {
                if(strcmp(x_weapon,"spistola",true) == 0) { if(PlayerInfo[playerid][pMats] > 99) { weapon[playerid] = 23; price[playerid] = 100; ammo[playerid] = 50; PlayerInfo[sscanfid][pGun2] = 23; PlayerInfo[sscanfid][pAmmo2] = 50; } else { SendClientMessage(playerid,COR_GREY,"Materiais insulficiente para Arma!"); return 1; } }
                else if(strcmp(x_weapon,"flowers",true) == 0) { if(PlayerInfo[playerid][pMats] > 24) { weapon[playerid] = 14; price[playerid] = 25; ammo[playerid] = 1; PlayerInfo[sscanfid][pGun1] = 14; PlayerInfo[sscanfid][pAmmo1] = 1; } else { SendClientMessage(playerid,COR_GREY,"Materiais insulficiente para Arma!"); return 1; } }
                else if(strcmp(x_weapon,"pistola",true) == 0) { if(PlayerInfo[playerid][pMats] > 199) { weapon[playerid] = 22; price[playerid] = 150; ammo[playerid] = 50; PlayerInfo[sscanfid][pGun2] = 22; PlayerInfo[sscanfid][pAmmo2] = 50; } else { SendClientMessage(playerid,COR_GREY,"Materiais insulficiente para Arma!"); return 1; } }
                else if(strcmp(x_weapon,"mp5",true) == 0) {if(PlayerInfo[playerid][pMats] > 199) { weapon[playerid] = 29; price[playerid] = 200; ammo[playerid] = 200; PlayerInfo[sscanfid][pGun2] = 29; PlayerInfo[sscanfid][pAmmo2] = 200; } else { SendClientMessage(playerid,COR_GREY,"Materiais insulficiente para Arma!"); return 1; } }
                else if(strcmp(x_weapon,"shotgun",true) == 0) {if(PlayerInfo[playerid][pMats] > 199) { weapon[playerid] = 25; price[playerid] = 200; ammo[playerid] = 50; PlayerInfo[sscanfid][pGun2] = 25; PlayerInfo[sscanfid][pAmmo2] = 50; } else { SendClientMessage(playerid,COR_GREY,"Materiais insulficiente para Arma!"); return 1; } }
                //else if(strcmp(x_weapon,"spas12",true) == 0) { if(PlayerInfo[playerid][pMats] > 599) { weapon[playerid] = 27; price[playerid] = 600; ammo[playerid] = 50; PlayerInfo[sscanfid][pGun2] = 27; PlayerInfo[sscanfid][pAmmo2] = 50; } else { SendClientMessage(playerid,COR_GREY,"Not enough Materials for that Weapon!"); return 1; } }
                else if(strcmp(x_weapon,"ak47",true) == 0) { if(PlayerInfo[playerid][pMats] > 599) { weapon[playerid] = 30; price[playerid] = 600; ammo[playerid] = 250; PlayerInfo[sscanfid][pGun2] = 30; PlayerInfo[sscanfid][pAmmo2] = 250; } else { SendClientMessage(playerid,COR_GREY,"   Voce nao tem Materiais para essa arma!"); return 1; } }
                else if(strcmp(x_weapon,"m4",true) == 0) { if(PlayerInfo[playerid][pMats] > 599) { weapon[playerid] = 31; price[playerid] = 600; ammo[playerid] = 250; PlayerInfo[sscanfid][pGun2] = 31; PlayerInfo[sscanfid][pAmmo2] = 250; } else { SendClientMessage(playerid,COR_GREY,"   Voce nao tem Materiais para essa arma!"); return 1; } }
                else if(strcmp(x_weapon,"rifle",true) == 0) { if(PlayerInfo[playerid][pMats] > 599) { weapon[playerid] = 33; price[playerid] = 600; ammo[playerid] = 50; PlayerInfo[sscanfid][pGun2] = 33; PlayerInfo[sscanfid][pAmmo2] = 50; } else { SendClientMessage(playerid,COR_GREY,"Materiais insulficiente para Arma!"); return 1; } }
                else { SendClientMessage(playerid,COR_GREY,"Nome da arma invalida!"); return 1; }
                if (ProxDetectorS(5.0,playerid,sscanfid))
                {
                    if(sscanfid == playerid)
                    {
                        SendClientMessage(playerid,COR_GRAD1,"Voce nao esta numa loja de armas!");
                        return 1;
                    }
                    ConsumingMoney[playerid] = 1;
                    GetPlayerName(sscanfid,giveplayerZCMD,sizeof(giveplayerZCMD));
                    GetPlayerName(playerid,sendername,sizeof(sendername));
                    format(stringZCMD,sizeof(stringZCMD),"Voce vendeu %s,um %s com %d ammo,para %d Materiais .",giveplayerZCMD,x_weapon,ammo[playerid],price[playerid]);
                    PlayerPlaySound(playerid,1052,0.0,0.0,0.0);
                    SendClientMessage(playerid,COR_GRAD1,stringZCMD);
                    format(stringZCMD,sizeof(stringZCMD),"Voce recebeu uma %s com %d a partir de municao %s.",x_weapon,ammo[playerid],sendername);
                    SendClientMessage(sscanfid,COR_GRAD1,stringZCMD);
                    PlayerPlaySound(sscanfid,1052,0.0,0.0,0.0);
                    format(stringZCMD,sizeof(stringZCMD),"* %s vendeu armas para %s.",sendername ,giveplayerZCMD);
                    ProxDetector(30.0,playerid,stringZCMD,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    GivePlayerWeaponEx(sscanfid,weapon[playerid],ammo[playerid]);
                    PlayerInfo[playerid][pMats] -= price[playerid];
                }
                else
                {
                    SendClientMessage(playerid,COR_GRAD1,"O cliente nao esta proximo de Voce.");
                    return 1;
                }
            }
            else
            {
                format(stringZCMD,sizeof(stringZCMD),"%d nao esta online.",sscanfid);
                SendClientMessage(playerid,COR_GRAD1,stringZCMD);
            }
        }
        return 1;
    }
