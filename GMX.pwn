START::GuerraTerrorista(playerid)
{
    new string[128];
    new plname[MAX_PLAYER_NAME];
    GetPlayerName(playerid, plname, MAX_PLAYER_NAME);
    TendoGuerra = 0;
    KillTimer(TempoGuerra);
    BernInfo[playerid][InicioGuerra] = 0;
    GangZoneHideForAll(GZGuerra);
    GangZoneDestroy(GZGuerra);
    for(new i; i != MAX_VEHICLES; ++i)
    {
        if(IsPlayerInTerritorio(CarrosExe[i]) || IsPlayerInTerritorio(CarrosTaliban[i]) || IsPlayerInTerritorio(CarrosAlqaeda[i]))
        {
            SetVehicleToRespawn(i);
        }
    }
    SendClientMessageToAll(0x33ccffFF, "__________Final Guerra Terrorista__________");
    format(string, sizeof(string), "Placar: {f4005b}Taliban[%d] {FFFFFF}X {33aa33}Exercito[%d] {FFFFFF}X {ffcc99}Al'Qaeda[%d] !",Territorio[talibankill], Territorio[exercitokill] , Territorio[alqaedakill]);
    SendClientMessageToAll(COR_AMARELO, string);
    SendClientMessageToAll(0x33ccffFF, "__________Final Guerra Terrorista__________");
    if(Territorio[exercitokill] > Territorio[talibankill] && Territorio[exercitokill] > Territorio[alqaedakill])
    {
        DepositarGranaOrg(3, 1000000);
    }
    else if(Territorio[talibankill] > Territorio[exercitokill] && Territorio[talibankill] > Territorio[alqaedakill])
    {
        DepositarGranaOrg(6, 1000000);
    }
    else if(Territorio[alqaedakill] > Territorio[exercitokill] && Territorio[alqaedakill] > Territorio[talibankill])
    {
        DepositarGranaOrg(16, 1000000);
    }
    return 1;
}
