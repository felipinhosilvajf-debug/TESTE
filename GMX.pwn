//--------------------------------------- Tela login
new Text:textTelaLogin[15];
new CarregandoTelaLogin[MAX_PLAYERS];
new TimerLogin[MAX_PLAYERS];
new Text:loadTela1;
new Text:loadTela2;
new Text:loadTela3;
new Text:loadTela4;
new Text:loadTela5;
new Text:loadTelaCard[4];
new PlayerText:loadTela6[MAX_PLAYERS];

stock hideTelaCarregamento(playerid)
{
    TextDrawHideForPlayer(playerid, loadTela1);
    TextDrawHideForPlayer(playerid, loadTela2);
    TextDrawHideForPlayer(playerid, loadTela3);
    TextDrawHideForPlayer(playerid, loadTela4);
    TextDrawHideForPlayer(playerid, loadTela5);
    for(new loadingIndex; loadingIndex < sizeof(loadTelaCard); loadingIndex++)
    {
        TextDrawHideForPlayer(playerid, loadTelaCard[loadingIndex]);
    }
    PlayerTextDrawHide(playerid, loadTela6[playerid]);
}

showTelaLogin(playerid){
    hideTelaCarregamento(playerid);
    new Str[700];
    for(new i; i < sizeof(VirtualBoost); i++){
        TextDrawShowForPlayer(playerid, VirtualBoost[i]);
    }
    format(Str, sizeof(Str), "RESUMO_DO_SERVIDOR~n~~n~REGISTROS:_%d~n~ACESSOS:_%d", estatisticasplayer2, estatisticasplayer);
    TextDrawSetString(VirtualBoost[5], Str);
    SelectTextDraw(playerid,0xa4a4a4FF);
}

hideTelaLogin(playerid){

    for(new i; i < sizeof(VirtualBoost); i++){
        TextDrawHideForPlayer(playerid, VirtualBoost[i]);
    }
    CancelSelectTextDraw(playerid);
}
stock Text:VBLoginBox(Float:x, Float:y, Float:w, Float:h, color)
{
    new Text:td = TextDrawCreate(x, y, "_");
    TextDrawLetterSize(td, 0.0, h / 10.0);
    TextDrawTextSize(td, x + w, 0.0);
    TextDrawAlignment(td, 1);
    TextDrawColor(td, 0xFFFFFFFF);
    TextDrawUseBox(td, 1);
    TextDrawBoxColor(td, color);
    TextDrawSetShadow(td, 0);
    TextDrawSetOutline(td, 0);
    TextDrawBackgroundColor(td, 0);
    TextDrawFont(td, 1);
    TextDrawSetProportional(td, 1);
    return td;
}

stock Text:VBLoginLabel(Float:x, Float:y, text[], Float:letterX, Float:letterY, color, font = 2)
{
    new Text:td = TextDrawCreate(x, y, text);
    TextDrawLetterSize(td, letterX, letterY);
    TextDrawAlignment(td, 1);
    TextDrawColor(td, color);
    TextDrawSetShadow(td, 0);
    TextDrawSetOutline(td, 0);
    TextDrawBackgroundColor(td, 0);
    TextDrawFont(td, font);
    TextDrawSetProportional(td, 1);
    return td;
}

stock CreateTelaLogin()
{
    // LOADING VIRTUAL BOOST - painel escuro com identidade ciano.
    loadTela1 = VBLoginBox(0.0, 0.0, 640.0, 448.0, 0x050B16EE);

    // Camadas do card: sombra, painel, detalhe superior e divisor.
    loadTelaCard[0] = VBLoginBox(174.0, 124.0, 292.0, 190.0, 0x000000AA);
    loadTelaCard[1] = VBLoginBox(168.0, 118.0, 292.0, 190.0, 0x101A2CEE);
    loadTelaCard[2] = VBLoginBox(168.0, 118.0, 292.0, 3.0, 0x00D9FFFF);
    loadTelaCard[3] = VBLoginBox(198.0, 250.0, 232.0, 1.0, 0x00D9FF66);

    loadTela2 = VBLoginLabel(314.0, 157.0, "VIRTUAL~w~BOOST", 0.52, 2.05, 0xFFFFFFFF, 2);
    TextDrawAlignment(loadTela2, 2);

    loadTela3 = VBLoginLabel(314.0, 194.0, "ROLEPLAY  |  SUA SEGUNDA VIDA", 0.19, 0.88, 0x00D9FFFF, 2);
    TextDrawAlignment(loadTela3, 2);

    loadTela4 = VBLoginLabel(314.0, 229.0, "PREPARANDO SUA EXPERIENCIA...", 0.17, 0.82, 0xEAF4FFFF, 2);
    TextDrawAlignment(loadTela4, 2);

    loadTela5 = VBLoginLabel(320.0, 431.0, "VIRTUALBOOST.ONLINE  |  DESENVOLVIDO POR VBSTAFF", 0.14, 0.65, 0x8FA4BFFF, 2);
    TextDrawAlignment(loadTela5, 2);

    // CARD PRINCIPAL DO LOGIN - indices de clique preservados.
    VirtualBoost[0] = VBLoginBox(27.0, 48.0, 286.0, 374.0, 0x00000099);
    VirtualBoost[1] = VBLoginBox(22.0, 43.0, 286.0, 374.0, 0x101A2CEE);
    VirtualBoost[2] = VBLoginBox(22.0, 43.0, 4.0, 374.0, 0x00CFFFFF);
    VirtualBoost[3] = VBLoginLabel(43.0, 62.0, "VIRTUAL~w~BOOST", 0.39, 1.65, 0xFFFFFFFF, 2);
    VirtualBoost[4] = VBLoginLabel(44.0, 88.0, "ROLEPLAY | SUA_SEGUNDA_VIDA_COMECA_AQUI", 0.135, 0.72, 0x00D9FFFF, 2);
    VirtualBoost[5] = VBLoginLabel(44.0, 119.0, "RESUMO_DO_SERVIDOR~n~~n~REGISTROS: 0~n~ACESSOS: 0", 0.17, 0.90, 0xEAF4FFFF, 2);
    VirtualBoost[6] = VBLoginBox(43.0, 184.0, 244.0, 1.0, 0x00D9FF66);

    // ACOES DO MENU
    VirtualBoost[7]  = VBLoginBox(43.0, 199.0, 244.0, 34.0, 0x007FAFFF);
    VirtualBoost[8]  = VBLoginBox(43.0, 240.0, 244.0, 34.0, 0x1D3047EE);
    VirtualBoost[9]  = VBLoginBox(43.0, 281.0, 244.0, 34.0, 0x1D3047EE);
    VirtualBoost[10] = VBLoginBox(43.0, 322.0, 244.0, 34.0, 0x1D3047EE);
    VirtualBoost[11] = VBLoginBox(43.0, 363.0, 244.0, 29.0, 0x873B49EE);

    // INDICES 12 A 17 PRESERVADOS PARA O CALLBACK DE CLIQUE EXISTENTE.
    VirtualBoost[12] = VBLoginLabel(165.0, 207.0, "FAZER_LOGIN", 0.22, 0.95, 0xFFFFFFFF, 2);
    TextDrawAlignment(VirtualBoost[12], 2);
    TextDrawSetSelectable(VirtualBoost[12], true);
    VirtualBoost[13] = VBLoginLabel(165.0, 248.0, "RECUPERAR_SENHA", 0.20, 0.90, 0xFFFFFFFF, 2);
    TextDrawAlignment(VirtualBoost[13], 2);
    TextDrawSetSelectable(VirtualBoost[13], true);
    VirtualBoost[14] = VBLoginLabel(165.0, 289.0, "INFORMACOES", 0.22, 0.95, 0xFFFFFFFF, 2);
    TextDrawAlignment(VirtualBoost[14], 2);
    TextDrawSetSelectable(VirtualBoost[14], true);
    VirtualBoost[15] = VBLoginLabel(165.0, 330.0, "CREDITOS", 0.22, 0.95, 0xFFFFFFFF, 2);
    TextDrawAlignment(VirtualBoost[15], 2);
    TextDrawSetSelectable(VirtualBoost[15], true);
    VirtualBoost[16] = VBLoginLabel(165.0, 397.0, "LEIA_AS_REGRAS_E_EVITE_PUNICOES", 0.125, 0.65, 0x00D9FFFF, 2);
    TextDrawAlignment(VirtualBoost[16], 2);
    VirtualBoost[17] = VBLoginLabel(165.0, 369.0, "SAIR_DO_SERVIDOR", 0.19, 0.85, 0xFFFFFFFF, 2);
