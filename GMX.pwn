                    PlayerPlaySound(playerid,1052,0.0,0.0,0.0);
                    SendClientMessage(playerid,COR_LIGHTBLUE,stringZCMD);
                    format(stringZCMD,sizeof(stringZCMD),"Voce recebeu uma %s com %d municoes do Terrorista %s.",x_weapon,ammo[playerid],sendername);
                    SendClientMessage(sscanfid,COR_LIGHTBLUE,stringZCMD);
                    PlayerPlaySound(sscanfid,1052,0.0,0.0,0.0);
                    format(stringZCMD,sizeof(stringZCMD),"* %s vendeu armas para %s.",sendername ,giveplayerZCMD);
                    ProxDetector(30.0,playerid,stringZCMD,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                    GivePlayerWeaponEx(sscanfid,weapon[playerid],ammo[playerid]);
                    PlayerInfo[playerid][pMats] -= price[playerid];
                    //SaveVendas();
                }
                else
                {
                    SendClientMessage(playerid,COR_GRAD1,"O cliente nao esta proximo de Voce.");
                    return 1;
                }
            }
            else
            {
                format(stringZCMD,sizeof(stringZCMD),"%d nao esta online !",sscanfid);
                SendClientMessage(playerid,COR_GRAD1,stringZCMD);
            }
        }
        return 1;
    }
    CMD:mafiavkit(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(!IsPlayerInCasarao(playerid))
            {
                SendClientMessage(playerid,COR_GRAD1,"Voce precisa estar no Casarao e dentro do BoxVille !");
                return 1;
            }
            if(PlayerInfo[playerid][pJailed] != 0)
            {
                SendClientMessage(playerid,COR_AMARELO," Voce nao pode vender armas na cadeia!");
                return 1;
            }
            new carid = GetPlayerVehicleID(playerid);
            if(!IsABoxCar(carid))
            {
                SendClientMessage(playerid,COR_GRAD1,"Voce precisa estar dentro do BoxVille !");
                return 1;
            }
            if(GetPlayerOrg(playerid) == 20 && donocasarao != 2)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce e da Mafia Yakuza, precisa estar dominando algum territorio para usar este comando !");
                return 1;
            }
            if(GetPlayerOrg(playerid) == 22 && donocasarao != 1)
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce e da Mafia Yakuza, precisa estar dominando algum territorio para usar este comando !");
                return 1;
            }
            if (PlayerInfo[playerid][pMembro] == 20 || PlayerInfo[playerid][pLider] == 20 || PlayerInfo[playerid][pMembro] == 22 || PlayerInfo[playerid][pLider] == 22)
            {
                new x_nr[32];
                if(sscanf(params, "s[32]u", x_nr, sscanfid))
                {
                    SendClientMessage(playerid,COR_EXE,"________________________________________________________________");
                    SendClientMessage(playerid,COR_BRANCO,"*** Vender Armas - Mafiosos ***");
                    SendClientMessage(playerid,COR_GREY,"{df5454}Ã—{ffffff} USE: /mafiavkit [1 a 3] [ID do Player] ");
                    SendClientMessage(playerid,COR_GREY,"Kit 1: Shotgun, m4, mp5 - (399 Materiais)");
                    SendClientMessage(playerid,COR_GREY,"Kit 2: Eagle, Shotgun, m4, mp5 - (499 Materiais)");
                    SendClientMessage(playerid,COR_GREY,"Kit 3: Eagle, Shotgun, m4, mp5, Sniper, Faca - (599 Materiais)");
                    SendClientMessage(playerid,COR_EXE,"_________________________________________________________________");
                    return 1;
                }
                else if(strcmp(x_nr,"1",true) == 0)
                {
                    if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se vender armas!"); return 1; }
                    new carid1 = GetPlayerVehicleID(sscanfid);
                    if(IsACop(sscanfid))
                    {
                        SendClientMessage(playerid,COR_GRAD1,"Voce nao pode vender kit para policiais");
                        return 1;
                    }
                    if(!PlayerInfo[sscanfid][pGunLic])
                    {
                        SendClientMessage(playerid,COR_GRAD1,"Este jogador nao possui licenca de armas !");
                        return 1;
                    }
                    if(!IsABoxCar(carid1))
                    {
                        SendClientMessage(playerid,COR_GRAD1,"O player para quem Voce vai vender precisa estar dentro do BoxVille !");
                        return 1;
                    }
                    if(IsPlayerConnected(sscanfid))
                    {
                        if(sscanfid != INVALID_PLAYER_ID)
                        {
                            GetPlayerName(playerid, sendername, sizeof(sendername));
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            if(PlayerInfo[playerid][pMats] > 399)
                            {
                                GivePlayerMoneyEx(sscanfid, -10000);
                                GivePlayerMoneyEx(playerid, 10000);
                                PlayerInfo[playerid][pMats] -= 399;
                                GivePlayerWeaponEx(sscanfid, 31, 300);
                                GivePlayerWeaponEx(sscanfid, 29, 200);
                                GivePlayerWeaponEx(sscanfid, 25, 100);
                                format(stringZCMD,sizeof(stringZCMD),"Voce vendeu o kit 1,para %s.",giveplayerZCMD);
                                SendClientMessage(playerid,COR_GRAD1,stringZCMD);
                                format(stringZCMD,sizeof(stringZCMD),"* %s vendeu kits para %s.",sendername ,giveplayerZCMD);
                                ProxDetector(30.0,playerid,stringZCMD,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                                return 1;
                            }
                            else
                            {
                                SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender este kit!");
                                return 1;
                            }
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "   O Jogador esta Offline !");
                        return 1;
                    }
                }
                else if(strcmp(x_nr,"2",true) == 0)
                {
                    if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se vender armas!"); return 1; }
                    new carid2 = GetPlayerVehicleID(sscanfid);
                    if(IsACop(sscanfid))
                    {
                        SendClientMessage(playerid,COR_GRAD1,"Voce nao pode vender kit para policiais");
                        return 1;
                    }
                    if(!IsABoxCar(carid2))
                    {
                        SendClientMessage(playerid,COR_GRAD1,"O player para quem Voce vai vender precisa estar dentro do BoxVille");
                        return 1;
                    }
                    if(IsPlayerConnected(sscanfid))
                    {
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        if(PlayerInfo[playerid][pMats] > 499)
                        {
                            GivePlayerMoneyEx(sscanfid, -12000);
                            GivePlayerMoneyEx(playerid, 12000);
                            PlayerInfo[playerid][pMats] -= 499;
                            GivePlayerWeaponEx(sscanfid, 31, 300);
                            GivePlayerWeaponEx(sscanfid, 29, 200);
                            GivePlayerWeaponEx(sscanfid, 25, 100);
                            GivePlayerWeaponEx(sscanfid, 24, 100);
                            format(stringZCMD,sizeof(stringZCMD),"Voce vendeu o kit 2,para %s.",giveplayerZCMD);
                            SendClientMessage(playerid,COR_GRAD1,stringZCMD);
                            format(stringZCMD,sizeof(stringZCMD),"* %s vendeu kits para %s.",sendername ,giveplayerZCMD);
                            ProxDetector(30.0,playerid,stringZCMD,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                            return 1;
                        }
                        else
                        {
                            SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender este kit!");
                            return 1;
                        }
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "   O Jogador esta Offline !");
                        return 1;
                    }
                }
                else if(strcmp(x_nr,"3",true) == 0)
                {
                    if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se vender armas!"); return 1; }
                    new carid3 = GetPlayerVehicleID(sscanfid);
                    if(IsACop(sscanfid))
                    {
                        SendClientMessage(playerid,COR_GRAD1,"Voce nao pode vender kit para policiais !");
                        return 1;
                    }
                    if(!IsABoxCar(carid3))
                    {
                        SendClientMessage(playerid,COR_GRAD1,"O player para quem Voce vai vender precisa estar dentro do BoxVille !");
                        return 1;
                    }
                    if(IsPlayerConnected(sscanfid))
                    {
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        if(PlayerInfo[playerid][pMats] > 599)
                        {
                            GivePlayerMoneyEx(sscanfid, -15000);
                            GivePlayerMoneyEx(playerid, 15000);
                            PlayerInfo[playerid][pMats] -= 599;
                            GivePlayerWeaponEx(sscanfid, 31, 300);
                            GivePlayerWeaponEx(sscanfid, 29, 200);
                            GivePlayerWeaponEx(sscanfid, 24, 100);
                            GivePlayerWeaponEx(sscanfid, 25, 100);
                            GivePlayerWeaponEx(sscanfid, 34, 80);
                            GivePlayerWeaponEx(sscanfid, 4, 1);
                            format(stringZCMD,sizeof(stringZCMD),"Voce vendeu o kit 3,para %s.",giveplayerZCMD);
                            SendClientMessage(playerid,COR_GRAD1,stringZCMD);
                            format(stringZCMD,sizeof(stringZCMD),"* %s vendeu kits para %s.",sendername ,giveplayerZCMD);
                            ProxDetector(30.0,playerid,stringZCMD,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE,COR_PURPLE);
                            return 1;
                        }
                        else
                        {
                            SendClientMessage(playerid,COR_GREY,"Materiais insuficientes para vender este kit!");
                            return 1;
                        }
                    }
