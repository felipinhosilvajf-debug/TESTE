                new segundo;
                getdate(year, month, day);
                gettime(hour,minute,segundo);

                format(stringZCMD, sizeof(stringZCMD), "[Mudar Nick] %s mudou o nick para %s (%02d/%02d/%02d - %02d:%02d:%02d)",playernameZCMD,x_Nick, day, month, year,hour, minute, segundo);
                SendClientMessageToAll(COR_LIGHTRED,stringZCMD);

                format(stringZCMD, sizeof(stringZCMD), "Voce mudou o nick para %s as (%02d/%02d/%02d - %02d:%02d:%02d)",x_Nick, day, month, year,hour, minute, segundo);
                pLogMudarNick(playerid, stringZCMD);

                format(stringZCMD, sizeof(stringZCMD), "[ANTI-ABUSO - MUDANcA DE NICK - AVISO ADMINS] %s mudou o nick para %s (%02d/%02d/%02d - %02d:%02d:%02d)",playernameZCMD,x_Nick, day, month, year,hour, minute, segundo);
                ABroadCast(COR_OBS,stringZCMD,1);
                NickLog(stringZCMD);
                format(stringZCMD, sizeof(stringZCMD), "Voce mudou seu nick para %s",x_Nick );
                SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                SendClientMessage(playerid, COR_AMARELO,"Tire uma SS(Aperte F8) para nao esquecer o novo nick!");
                mudandonick[playerid] = 0;
                SalvarAdmins();
                OnPlayerSave(playerid);
                if(PodeMudarNick[playerid] == 1) return PodeMudarNick[playerid] = 0;
                if(MudarNick[playerid] > 0) MudarNick[playerid] -= 1;
                else MudarNick[playerid] = 0;
                SetPlayerName(playerid,x_Nick);
                new novapasta[128];
                format(novapasta, sizeof novapasta, "Players/%s.ini", x_Nick);
                format(stringZCMD, sizeof stringZCMD, "Players/%s.ini", nickantigo[playerid]);
                DOF2_RenameFile(stringZCMD, novapasta);

                format(stringZCMD, sizeof stringZCMD, "PlayerLog/avisos/%s.ini", nickantigo[playerid]);
                if(DOF2_FileExists(stringZCMD))
                {
                    format(novapasta, sizeof novapasta, "PlayerLog/avisos/%s.ini", x_Nick);
                    format(stringZCMD, sizeof stringZCMD, "PlayerLog/avisos/%s.ini", nickantigo[playerid]);
                    DOF2_RenameFile(stringZCMD, novapasta);
                }

                format(stringZCMD, sizeof stringZCMD, "PlayerLog/cadeias/%s.ini", nickantigo[playerid]);
                if(DOF2_FileExists(stringZCMD))
                {
                    format(novapasta, sizeof novapasta, "PlayerLog/cadeias/%s.ini", x_Nick);
                    format(stringZCMD, sizeof stringZCMD, "PlayerLog/cadeias/%s.ini", nickantigo[playerid]);
                    DOF2_RenameFile(stringZCMD, novapasta);
                }

                format(stringZCMD, sizeof stringZCMD, "PlayerLog/kicks/%s.ini", nickantigo[playerid]);
                if(DOF2_FileExists(stringZCMD))
                {
                    format(novapasta, sizeof novapasta, "PlayerLog/kicks/%s.ini", x_Nick);
                    format(stringZCMD, sizeof stringZCMD, "PlayerLog/kicks/%s.ini", nickantigo[playerid]);
                    DOF2_RenameFile(stringZCMD, novapasta);
                }

                format(stringZCMD, sizeof stringZCMD, "PlayerLog/mudarnick/%s.ini", nickantigo[playerid]);
                if(DOF2_FileExists(stringZCMD))
                {
                    format(novapasta, sizeof novapasta, "PlayerLog/mudarnick/%s.ini", x_Nick);
                    format(stringZCMD, sizeof stringZCMD, "PlayerLog/mudarnick/%s.ini", nickantigo[playerid]);
                    DOF2_RenameFile(stringZCMD, novapasta);
                }
                OnPlayerSave(playerid);
                return 1;
            }
            else if(NickSis == false)
            {
                return 1;
            }
        }
        return 1;
    }
    CMD:onmudarn(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new playa;
            if(sscanf(params, "u", playa))
            {
                SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /onmudarn [ id ]");
                return 1;
            }
            if (PlayerInfo[playerid][pAdmin] >= 1337)
            {
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(playa))
                {
                    if(playa != INVALID_PLAYER_ID)
                    {
                        PodeMudarNick[playa] = 1;
                        GetPlayerName(playa, giveplayerZCMD, sizeof(giveplayerZCMD));
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        format(stringZCMD, sizeof(stringZCMD), "Admin %s: Liberou Voce a mudar o nick,digite /mudarnick.", sendername);
                        SendClientMessage(playa, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s Liberou %s a mudar o nick !",sendername,giveplayerZCMD);
                        ABroadCast(COR_LIGHTRED,stringZCMD,1);
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao esta autorizado a usar este comando!");
                return 1;
            }
        }
        return 1;
    }
    CMD:offmudarn(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pAdmin] >= 4)
            {
                if(sscanf(params, "u", sscanfid))
                {
                    SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /offmudarn [ id ]");
                    return 1;
                }
                if(AdminTrabalhando[playerid] < 1)
                {
                    SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
                    return 1;
                }
                if(IsPlayerConnected(sscanfid))
                {
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        PodeMudarNick[sscanfid] = 0;
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                        format(stringZCMD, sizeof(stringZCMD), "Admin %s : Tirou sua permissao para mudar de nick.", sendername);
                        SendClientMessage(sscanfid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "ADMIN CMD: %s tirou a permissao de %s para mudar o nick !",sendername,giveplayerZCMD);
                        ABroadCast(COR_LIGHTRED,stringZCMD,1);
                        return 1;
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GREY, "O Jogador esta Offline !");
                    return 1;
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar este comando !");
                return 1;
            }
        }
        return 1;
    }
    CMD:votacao(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1337)
        {
            if(!votacao[iniciada])
            {
                if(isnull(params))return SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /votacao [pergunta]");
                SendClientMessageToAll(0xFFF000AA, "> Se Voce concorda clique: sim");
                SendClientMessageToAll(0xFFF000AA, "> Se Voce discorda clique: nao");
                votacao[iniciada] = true;
                votacao[sim] = 0;
                votacao[nao] = 0;
                foreach(new i: Player)
                {
                    format(gstring,sizeof(gstring),"Votacao: %s ?", params);
                    ShowPlayerDialog(i,12,DIALOG_STYLE_MSGBOX,"RS - Votacao",gstring,"Sim","nao");
                    votou[i] = false;
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY,"ja existe uma votacao em andamento!");
            }
        }
        else
        {
            SendClientMessage(playerid, COR_GREY,"Voce nao tem permissao para usar este comando!");
        }
        return 1;
    }
    CMD:sairevento(playerid, params[])  return ForT:sairdoevento(playerid, params);
    CMD:sairdoevento(playerid, params[])
    {
        new vid = GetPlayerVehicleID(playerid);
        if(NaPorraDoEvento[playerid] == true)
        {
            Trazervs[playerid] = 0;
            VoltasEvento[playerid] = 0;
            TimeCOPS[playerid] = 0;
            TimeZumbis[playerid] = 0;
            PrimeiroChuck[playerid] = 0;
            CorridaGanha[playerid] = 0;
            PlayerInfo[playerid][pTrazerChuck] = 0;
            PlayerInfo[playerid][pTiroteio] = 0;
            SetPlayerVirtualWorld(playerid, 0);
            EventoGalpao[playerid] = 0;
            EventoHotel[playerid] = 0;
            EventoAviao[playerid] = 0;
            iniciarrally[playerid] = 0;
            iniciarcross[playerid] = 0;
            iniciartrilha[playerid] = 0;
            TanoEventoJogosVorazes[playerid] = 0;
            CPEvento1[playerid] = 0;
            CPEvento2[playerid] = 0;
            CPEvento3[playerid] = 0;
            CPEvento4[playerid] = 0;
            CPEvento5[playerid] = 0;
            KillEvento[playerid] = 0;
            DeatEvento[playerid] = 0;
            pClassiQuarentena[playerid] = 0;
            NaPorraDoEvento[playerid] = false;
            TaNoQuarentena[playerid] = 0 ;
            TextDrawHideForPlayer(playerid, TextDrawCQ);
            //---//
            EquipeWarZone[playerid] = 0;
            TanoWarZone[playerid] = 0;
            TextDrawHideForPlayer(playerid, TextDrawGREEN);
            TextDrawHideForPlayer(playerid, TextDrawRED);
            TextDrawHideForPlayer(playerid, TextDrawBLUE);
            LimiteRed--;
            LimiteBlue--;
            LimiteGreen--;
            //---//

            TextDrawHideForPlayer(playerid, TextDrawCT);
            TextDrawHideForPlayer(playerid, TextdrawTR);
            KillEvento[playerid] = 0;
            MorteEvento[playerid] = 0;
            DeatEvento[playerid] = 0;
            eventofloresta[playerid] = 0;
            eventoarena[playerid] = 0;
            eventomansao[playerid] = 0;
            eventocarandiru[playerid] = 0;
            eventoconst[playerid] = 0;
            eventodp[playerid] = 0;
            NaPorraDoEvento[playerid] = false;
            ResetPlayerWeaponsEx(playerid);
            SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
            SetPlayerToTeamColor(playerid);
            DisablePlayerRaceCheckpoint(playerid);
            SetVehicleToRespawn(vid);
            if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
            SetHora();
            if(TanoEventoJogosVorazes[playerid] == 1)
            {
                QuantidadeEvento --;
                TanoEventoJogosVorazes[playerid] = 0;
                format(stringZCMD, sizeof(stringZCMD), "[Jogos Vorazes] %s Saiu do evento, restam [%d] sobreviventes.",PlayerName(playerid),QuantidadeEvento);
                SendClientMessageToAll(COR_VERDE,stringZCMD);
                SendClientMessage(playerid, COR_AMARELO, "Voce saiu do evento !");
                SetPlayerWorldBounds(playerid,20000.0000,-20000.0000,20000.0000,-20000.0000);
                TanoEventoJogosVorazes[playerid] = 0;
                NaPorraDoEvento[playerid] = false;
                VerificarGanhador(playerid);
                SetPlayerSpawn(playerid);
                return 1;
            }
            foreach(new i: Player)
            {
                if(PlayerInfo[i][pTiroteio] > 0)
                {
                    SetPlayerWeather(i, 42);
                }
            }
            if(MaletaAnexada[playerid] == 1)
            {
                GetPlayerPos(playerid,maletax,maletay,maletaz);
                maletaid = CreateDynamicObject(1210,maletax,maletay,maletaz-0.8,0,0,0.0);
                MaletaAnexada[playerid] = 0;
                StopPlayerHoldingObject(playerid);
            }
            KillTimer(TempoVida[playerid]);
            SendClientMessage(playerid, COR_AMARELO,"Voce saiu do evento !");
            SetPlayerWorldBounds(playerid,20000.0000,-20000.0000,20000.0000,-20000.0000);
            SetPlayerSpawn(playerid);
        }
        else
        {
            SendClientMessage(playerid, COR_GREEN, "Voce nao esta participando de nenhum evento !");
            return 1;
        }
        return 1;
    }
    CMD:encerrar(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1337)
        {
            if(votacao[iniciada])
            {
                SendClientMessageToAll(0xFFFFFFAA, "==> Votacao encerrada!");
                format(stringZCMD, sizeof stringZCMD, "> %d pessoas responderam sim;", votacao[sim]);
                SendClientMessageToAll(0xFFF000AA,stringZCMD);
                format(stringZCMD, sizeof stringZCMD, "> %d pessoas responderam nao;", votacao[nao]);
                SendClientMessageToAll(0xFFF000AA, stringZCMD);
                if(votacao[sim] == votacao[nao])
                {
                    SendClientMessageToAll(0xFF0000AA, "==> Houve um empate!");
                }
                else if(votacao[sim] > votacao[nao])
                {
                    SendClientMessageToAll(0xFF0000AA, "==> A maioria CONCORDA com a pergunta.");
                }
                else if(votacao[sim] < votacao[nao])
                {
                    SendClientMessageToAll(0xFF0000AA, "==> A maioria DISCORDA da pergunta.");
                }
                votacao[iniciada] = false;
                votacao[sim] = 0;
                votacao[nao] = 0;
                foreach(new i: Player)
                {
                    votou[i] = false;
                }
            }
            else
            {
                SendClientMessage(playerid, 0xFFFFFFAA, "Nenhuma votacao criada!");
            }
        }
        else
        {
            SendClientMessage(playerid, 0xFFFFFFAA, "Voce nao tem permissao para usar este comando!");
        }
        return 1;
    }
    CMD:online(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] < 1337)
        {
            SendClientMessage(playerid, COR_GRAD1, "Voce nao tem permissao para usar esse comando.");
            return 1;
        }
        if(AdminTrabalhando[playerid] < 1)
        {
            SendClientMessage(playerid, 0xfa4c4cff, "{fa4c4c}ERRO: {ffffff}Voce nao esta trabalhando, use /trabalhar!");
            return 1;
        }
        format(gstring, sizeof(gstring), "(Virtual Boost) %d Players Online | (Computadores %d | Androids %d)", ContarJogadores(), PlayerComputador[playerid], PlayerCelular[playerid]);
        SendClientMessageToAll(COR_LIGHTBLUE, gstring);
        return 1;
    }

    CMD:teleportes(playerid, params[])  return ForT:teles(playerid, params);
    CMD:teles(playerid, params[])
    {

        if(PlayerInfo[playerid][pAdmin] > 0)
        {
            ShowPlayerDialog(playerid,178,DIALOG_STYLE_LIST," ","Geral(Los Santos)\nEmpresas Com Interior\nEmpresas Sem Interior\nHQ Organizacoes(Los Santos)\nHQ Empregos\nTunnings\nTerritorios\nCativeiros\nLocais Pessoais\nLocais De Roubo\nMuros para Pichar","Aceitar","Cancelar");
        }
        return 1;
    }
    CMD:locationmuro(playerid, params[])
    {
        if(!gPlayerLogged[playerid])return 1;
        MEGAString[0] = EOS;
        new Float:x, Float:y, Float:z;
        strcat(MEGAString, "{FFFF00}Muro mais proximo\n");
        for(new i; i < MAX_MUROS; i++)
        {
            GetMuro(playerid,i);
            x = MuroPos[playerid][0];
            y = MuroPos[playerid][1];
            z = MuroPos[playerid][2];
            format(stringZCMD, sizeof stringZCMD, "Muro de %s\n", GetPoint2DZone(x, y, z));
            strcat(MEGAString, stringZCMD);
        }
        ShowPlayerDialog(playerid, 4903, DIALOG_STYLE_LIST, "Muros para Pichar", MEGAString, #Localizar, #Voltar);
        return true;
    }
