            {
                if(PlayerInfo[playerid][pCargo] < 1) { SendClientMessage(playerid, COR_GREY, "Voce precisa ser cargo 1+ para fazer esse pedido!"); return 0; }
                if(GetPlayerMoneyEx(playerid) > 120)
                {
                    SendClientMessage(playerid, COR_LIGHTBLUE, "* Voce fez o pedido 2,  va no centro de sua HQ e Aperte F !");
                    GivePlayerMoneyEx(playerid, - 120);
                    OrderReady[playerid] = 2;
                    return 0;
                }
                else
