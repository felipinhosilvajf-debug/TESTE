                    {
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        GetPlayerName(MechanicCall, giveplayerZCMD, sizeof(giveplayerZCMD));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce aceitou a chamada do(a) %s, A marca estara visivel ate Voce chegar.",giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "[Mecanico]: %s[%d] aceitou o seu pedido, aguarde no local solicitado, seja  RP!",sendername,playerid);
                        SendClientMessage(MechanicCall, COR_LIGHTRED, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "Mecanico: [%s] aceitou o pedido do cliente [%s] !", PlayerName(playerid), giveplayerZCMD);
                        SendFamilyMessage(24,0x6666ccFF,stringZCMD);
                        GameTextForPlayer(playerid, "~p~SIGA O CHECKPOINT", 5000, 1);
                        new Float:X,Float:Y,Float:Z;
                        GetPlayerPos(MechanicCall, X,Y,Z);
                        SetPlayerCheckpoint(playerid, X,Y,Z, 6);
                        MechanicCallTime[playerid] = 1;
                        MechanicAccepted[playerid] = MechanicCall;
                        PediuServicoMec[MedicCall] = 0;
                        MechanicCall = 999;
                        return 1;
                    }
                    else
                    {
                        SendClientMessage(playerid, COR_GREY, "* Este Jogador nao esta conectado !");
                        return 1;
                    }
                }
            }
            if(IsACop(playerid))
            {
                if(MechanicCall < 999)
                {
                    if(PediuServicoCop[CopsrondaCall] == 0)
                    {
                        SendClientMessage(playerid, COR_GRAD1, "* Este Jogador nao esta conectado !");
                        return 1;
                    }
                    if(IsPlayerConnected(CopsrondaCall))
                    {
                        GetPlayerName(playerid, sendername, sizeof(sendername));
                        GetPlayerName(CopsrondaCall, giveplayerZCMD, sizeof(giveplayerZCMD));
                        format(stringZCMD, sizeof(stringZCMD), "* Voce aceitou a chamada do(a) %s, A marca estara visivel ate Voce chegar.",giveplayerZCMD);
                        SendClientMessage(playerid, COR_LIGHTBLUE, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "[Policial]: %s[%d] aceitou o seu pedido, aguarde no local solicitado, seja RPG!",sendername,playerid);
                        SendClientMessage(CopsrondaCall, COR_LIGHTRED, stringZCMD);
                        format(stringZCMD, sizeof(stringZCMD), "Oficial: [%s] aceitou o pedido do cliente [%s] !", PlayerName(playerid), giveplayerZCMD);
                        SendFamilyMessage(1,0x6666ccFF,stringZCMD);
                        SendFamilyMessage(2,0x6666ccFF,stringZCMD);
                        SendFamilyMessage(3,0x6666ccFF,stringZCMD);
                        SendFamilyMessage(7,0x6666ccFF,stringZCMD);
                        SendFamilyMessage(11,0x6666ccFF,stringZCMD);
                        SendFamilyMessage(16,0x6666ccFF,stringZCMD);
                        SendFamilyMessage(23,0x6666ccFF,stringZCMD);
                        SendFamilyMessage(25,0x6666ccFF,stringZCMD);
                        GameTextForPlayer(playerid, "~p~SIGA O CHECKPOINT", 5000, 1);
                        new Float:X,Float:Y,Float:Z;
                        GetPlayerPos(CopsrondaCall, X,Y,Z);
                        SetPlayerCheckpoint(playerid, X,Y,Z, 6);
                        CopsrondaCallTime[playerid] = 1;
                        CopsrondaAccepted[playerid] = CopsrondaCall;
                        PediuServicoCop[CopsrondaCall] = 0;
