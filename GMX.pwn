START::CobrarImposto()
{
        new valorimposto;
        valorimposto = 2200;
        for(new i = 0; i < MAX_HOUSES; ++i)
        {
            if(HouseInfo[i][hOwned] == 1)
            {
                if(HouseInfo[i][hTakings] > 1)
                {
                    //HouseInfo[i][hTakings] = valorimposto;
                    DepositarGranaOrg(7, valorimposto);
                }
                else
                {
                    VenderCasa();
                    SaveCasas();
                }
            }
        }
        return 1;
}
START::VenderCasa()
{
     for(new i = 0; i < MAX_HOUSES; ++i)
     {
          if(HouseInfo[i][hOwned] == 1)
          {
               if(HouseInfo[i][hTakings] < 1)
               {
                    new File:hFile;
                    new string[128];
                    hFile = fopen("Logs/CasaVendida.log", io_append);
                    format(string, sizeof(string), "A casa de %s foi vendida por falta de dinheiro no cofre.\n", HouseInfo[i][hOwner]);
                    fwrite(hFile, string);
                    fclose(hFile);
                    HouseInfo[i][hTakings] = 0;
                    HouseInfo[i][hHel] = 0;
                    HouseInfo[i][hArm] = 0;
                    HouseInfo[i][hHealthx] = 0;
                    HouseInfo[i][hHealthy] = 0;
                    HouseInfo[i][hHealthz] = 0;
                    HouseInfo[i][hArmorrx] = 0;
                    HouseInfo[i][hArmorry] = 0;
                    HouseInfo[i][hArmorrz] = 0;
                    HouseInfo[i][hLock] = 1;
                    HouseInfo[i][hOwned] = 0;
                    HouseInfo[i][hVec] = 475;
                    HouseInfo[i][hVcol1] = -1;
                    HouseInfo[i][hVcol2] = -1;
                    strmid(HouseInfo[i][hOwner], "O estado", 0, strlen("O estado"), 999);
                    new casavendida[255];
                    format(casavendida, sizeof(casavendida), "[Imobiliaria] O imovel: ** | ID: %d foi vendido, motivo: nao pagou as despesas!", i);
                    SendClientMessageToAll(COR_START, casavendida);
                    Atualizar3Dtexts();
               }
         }
     }
     return 1;
}

