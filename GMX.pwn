START::InvasaoPenitenciaria(playerid)
{
    KillTimer(tempoinvasao);
    if(!IsACop(playerid))
    if(!PlayerToPoint(2.0,playerid,355.5270,212.1389,1008.3828))
    {
        foreach(new i: Player)
        {
             if(PlayerInfo[i][pChatRoubo] == 0)
             {
                  format(gstring, sizeof(gstring), "[Invasao Sistema] %s[%d]: nao conseguiu invadir o sistema da penitenciaria!",PlayerName(playerid),playerid);
                  SendClientMessage(i, GetPlayerColor(playerid), gstring);
             }
        }
        RemovePlayerAttachedObject(playerid,9);
        TogglePlayerControllable(playerid, 1);
        SendClientMessage(playerid, COR_GREY, "Voce nao esta no computador da prefeitura !");
        ProvocoInvasao[playerid] = 0; Roubando[playerid] = 0; invasaopenitenciaria = 0; KillTimer(tempoinvasao); tempoinvasaosistema = 0;
        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, 1)
        KillTimer(TempoContagem[playerid]);
        return 1;
    }
    foreach(new i: Player)
    {
        if(ProvocoInvasao[i] == 1)
        {
            if(PlayerInfo[i][pChatRoubo] == 0)
            {
                format(gstring, sizeof(gstring), "[Invasao Sistema] %s[%d]: Conseguiu invadir o sistema da penitenciaria e os presos foram solto!!",PlayerName(playerid),playerid);
                SendClientMessage(i, GetPlayerColor(playerid), gstring);
            }
            ProvocoInvasao[playerid] = 0; Roubando[playerid] = 0; invasaopenitenciaria = 0; KillTimer(tempoinvasao); tempoinvasaosistema = 0;
            RemovePlayerAttachedObject(playerid,9);
            TogglePlayerControllable(playerid, 1);
            ClearAnimations(playerid);
            PlayerInfo[i][pLadrao] ++;
            TogglePlayerControllable(i, 1)
            KillTimer(TempoContagem[playerid]);
        }
        if(PlayerInfo[i][pJailed] == 1)
        {
            if(PlayerInfo[i][pPenitenciaria] == 1)
            {
                 SetPlayerVirtualWorld(i, 0);
                 SetPlayerInterior(i, 0);
                 SetPlayerPos(i,1690.0768,-1326.8335,17.4288);
                 SetPlayerFacingAngle(i, 8.6342);
            }
            if(PlayerInfo[i][pJailTime] <= 300) WantedLevel[i] = 1;
            if(PlayerInfo[i][pJailTime] >= 301 || PlayerInfo[i][pJailTime] <= 600) WantedLevel[i] = 2;
            if(PlayerInfo[i][pJailTime] >= 601 || PlayerInfo[i][pJailTime] <= 900)WantedLevel[i] = 3;
            if(PlayerInfo[i][pJailTime] >= 901 || PlayerInfo[i][pJailTime] <= 1200)WantedLevel[i] = 4;
            if(PlayerInfo[i][pJailTime] >= 1201 || PlayerInfo[i][pJailTime] <= 1500)WantedLevel[i] = 5;
            if(PlayerInfo[i][pJailTime] >= 1501 || PlayerInfo[i][pJailTime] <= 1800)WantedLevel[i] = 6;
            if(PlayerInfo[i][pJailTime] >= 1801 || PlayerInfo[i][pJailTime] <= 2100)WantedLevel[i] = 7;
            if(PlayerInfo[i][pJailTime] >= 2101 || PlayerInfo[i][pJailTime] <= 2500)WantedLevel[i] = 8;

            RemovePlayerAttachedObject(i,4);
            PlayerInfo[i][pJailed] = 0;
            SetPlayerSkin(i, PlayerInfo[i][pSkin]);
            format(gstring, sizeof(gstring), "Invadiram o sistema da prefeitura ls e Voces foram soltos !");
            SendClientMessage(i, COR_AMARELO, gstring);
            //new DinheiroBanco = 45000 + random(10000);
          //  GivePlayerMoneyEx(i, DinheiroBanco);
        //  ClearAnimations(i);
        //  PlayerInfo[i][pExp] += 1;
            AbrirPortaPref[playerid] = 1;
            MoveDynamicObject(portapref,366.43143, 189.64662, 1005.60803, 20.0);
            rouboportas[playerid] = SetTimerEx("RouboPortas", 20000, 0, "i", playerid);
        }
    }
    return 1;
}
