        if(!PlayerToPoint(2.0,playerid,1165.3390,-1322.9261,-44.2836)) return SendClientMessage(playerid, -1, "Voce nao esta na farmacia hospitalar.");
        ShowPlayerDialog(playerid, 4114, DIALOG_STYLE_TABLIST_HEADERS, "Farmacia Hospitalar","Item\tCusto\tfuncao\nKit Medico\t{01DF01}$5000\t{FF0000}Curar de todas doencas e completar saude\n", "Escolher", "Cancelar");
        return 1;
    }
