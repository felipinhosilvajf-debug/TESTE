    strfind(string, "h", true) != -1 || strfind(string, "invasao", true) != -1 || strfind(string, "materiais", true) != -1 || strfind(string, "pia", true) != -1 || strfind(string, "racha", true) != -1 || strfind(string, "roubo", true) != -1 || strfind(string, "rp", true) != -1 || strfind(string, "seq", true) != -1 || strfind(string, "suborno", true) != -1 || strfind(string, "trafico", true) != -1 || strfind(string, "trote", true) != -1 || strfind(string, "dsc", true) != -1)
