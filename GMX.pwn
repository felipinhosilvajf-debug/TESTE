                                   GameTextForPlayer(i, gstring, 5000, 1);
                                   ConsumingMoney[i] = 1;
                                   GivePlayerMoneyEx(i, price/2);
                                   PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
                               }
                          }
                          if(GetPlayerOrg(killerid) == 3)
                          {
                               if(GetPlayerOrg(i) == 3)
                               {
                                   format(gstring, sizeof(gstring), "~w~Suspeito ~r~Morto~n~ Bonus~g~R$%d", price);
                                   GameTextForPlayer(i, gstring, 5000, 1);
                                   ConsumingMoney[i] = 1;
                                   GivePlayerMoneyEx(i, price/2);
                                   PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
                               }
                          }
                          if(GetPlayerOrg(killerid) == 12)
                          {
                               if(GetPlayerOrg(i) == 12)
                               {
                                   format(gstring, sizeof(gstring), "~w~Suspeito ~r~Morto~n~ Bonus~g~R$%d", price);
                                   GameTextForPlayer(i, gstring, 5000, 1);
                                   ConsumingMoney[i] = 1;
                                   GivePlayerMoneyEx(i, price/2);
                                   PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
                               }
                          }
                          if(GetPlayerOrg(killerid) == 13)
                          {
                               if(GetPlayerOrg(i) == 13)
                               {
                                   format(gstring, sizeof(gstring), "~w~Suspeito ~r~Morto~n~ Bonus~g~R$%d", price);
                                   GameTextForPlayer(i, gstring, 5000, 1);
                                   ConsumingMoney[i] = 1;
                                   GivePlayerMoneyEx(i, price/2);
                                   PlayerPlaySound(i, 1058, 0.0, 0.0, 0.0);
                               }
