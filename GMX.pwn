    CMD:infoarmas(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            if(sscanf(params, "u", sscanfid))
            {
                SendClientMessage(playerid, COR_BRANCO, "{df5454}Ã—{ffffff} USE: /infoarmas [id do player]");
                return 1;
            }
            if(PlayerInfo[playerid][pAdmin] < 1)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao esta autorizado a usar esse comando!");
                return 1;
            }
            if(IsPlayerConnected(sscanfid))
            {
                if(sscanfid != INVALID_PLAYER_ID)
                {
                    new weapons[13][2];
                    new playerck[MAX_PLAYER_NAME];
                    GetPlayerName(sscanfid, playerck, sizeof(playerck));
                    format(stringZCMD, sizeof(stringZCMD), "EXIBINDO AS INFORMAcoES DAS ARMAS DE: %s",playerck);
                    SendClientMessage(playerid, TEAM_BALLAS_COR, stringZCMD);
                    GetPlayerWeaponData(sscanfid, 2, weapons[2][0], weapons[2][1]);
                    format(stringZCMD, sizeof(stringZCMD), "Arma: %s,                Municao: %d",aNames[weapons[2][0]], weapons[2][1]);
                    SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                    GetPlayerWeaponData(sscanfid, 3, weapons[3][0], weapons[3][1]);
                    format(stringZCMD, sizeof(stringZCMD), "Arma: %s,                Municao: %d",aNames[weapons[3][0]], weapons[3][1]);
                    SendClientMessage(playerid, COR_BRANCO, stringZCMD);
                    GetPlayerWeaponData(sscanfid, 4, weapons[4][0], weapons[4][1]);
