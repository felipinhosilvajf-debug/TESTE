stock static PreloadActorAnimations(actorid)
{
        for(new i = 0; i < sizeof(s_AnimationLibraries); i ++)
        {
            ApplyActorAnimation(actorid, s_AnimationLibraries[i], "null", 0.0, 0, 0, 0, 0, 0);
        }
}

stock IniciarTutorial(playerid)
{
    SetPVarInt(playerid, "VarTutorial", gettime()+3);
    NumeroTutorial[playerid] = 1;
    STuto(playerid, NumeroTutorial[playerid]);
    //SendClientMessage(playerid, COR_BRANCO, "{00FFFF}â€¢ {FFFFFF}Ligue o som");
//  SendClientMessage(playerid, COR_BRANCO, "{00FFFF}â€¢ {FFFFFF}Clique em proximo quando acabar de ler, ou entao digite /passartutorial.");
    return true;
}
stock STuto(playerid, numero)
{
    MEGAString[0] = EOS;
    if(numero == 1)
    {
        SIntro(playerid, 1);
        SelectTextDraw(playerid, 0x0080FFC8);
        PulaTuto[playerid] = 1;
        NoTuto[playerid] = 1;
        PlayerTextDrawSetString(playerid,TituloTuto[playerid], "Segunda Vida");
        PlayerTextDrawShow(playerid, TituloTuto[playerid]);
        TextDrawShowForPlayer(playerid, BTTUTO[0]);
        TextDrawShowForPlayer(playerid, BaseTuto[0]);
        SelectTextDraw(playerid, 0x00FF00FF);
        strcat(MEGAString, "      ~w~Seja bem-vindo(a) ao Virtual Boost RPG! Voce esta prestes a jogar no~n~");
        strcat(MEGAString, " ~w~servidor raiz e divertido do SA-MP Brasileiro. Todos os detalhes foram pensados~n~");
        strcat(MEGAString, "  ~w~para que voce tenha uma experiencia unica de jogabilidade. Muitos sistemas~n~");
        strcat(MEGAString, "    ~w~Foram remodelados para promover uma experiencia diferenciada com equilibrio ao RP.~n~");
        BalaoTuto(playerid, MEGAString);
        if(TaEscutando[playerid] == 0)
        {
            StopAudioStreamForPlayer(playerid);
            PlayAudioStreamForPlayer(playerid, "https://www.dropbox.com/scl/fi/9eug4o12r4edmuidwknlr/brlx3.mp3?rlkey=xdm7ft1s9p5e57l0tgm3s3sz1&st=omxhdqnt&dl=1");
        }
        tempotutorial[playerid] = SetTimerEx("TempoTut", 3000, 1, "i", playerid);
        ClearChatbox(playerid, 100);
    }
    else if(numero == 2)
    {
        SIntro(playerid, 2);
        SelectTextDraw(playerid, 0x0080FFC8);
        PulaTuto[playerid] = 1;
        NoTuto[playerid] = 1;
        PlayerTextDrawSetString(playerid,TituloTuto[playerid], "A Cidade");
        PlayerTextDrawShow(playerid, TituloTuto[playerid]);
        TextDrawShowForPlayer(playerid, BTTUTO[0]);
        TextDrawShowForPlayer(playerid, BTTUTO[1]);
        TextDrawShowForPlayer(playerid, BaseTuto[0]);
        SelectTextDraw(playerid, 0x00FF00FF);
        strcat(MEGAString, "    ~w~Todas as cidades terao jogabilidades independentes: Organizacoes~n~");
        strcat(MEGAString, "  ~w~governamentais e terroristas, comercio,Banco,Loterica e Lojas. etc.~n~");
        strcat(MEGAString, "  ~w~Qualquer problema, erro, bugs ou sugestoes mande para nossa Equipe no Discord.,~n~");
        strcat(MEGAString, "  ~w~Nossa prioridade continua sendo a diversao, mas iremos garantir as ordens e cumprimento do RolePlay.~n~");
        BalaoTuto(playerid, MEGAString);
        //if(TaEscutando[playerid] == 0) StopAudioStreamForPlayer(playerid);
        //if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid,"http://brasilperfectlife.com/tutorial/tutorialparte2.mp3");
        tempotutorial[playerid] = SetTimerEx("TempoTut", 3000, 1, "i", playerid);
        ClearChatbox(playerid, 100);
    }
    else if(numero == 3)
    {
        SIntro(playerid, 3);
        SelectTextDraw(playerid, 0x0080FFC8);
        PulaTuto[playerid] = 1;
        NoTuto[playerid] = 1;
        PlayerTextDrawSetString(playerid,TituloTuto[playerid], "BANCO");
        PlayerTextDrawShow(playerid, TituloTuto[playerid]);
        TextDrawShowForPlayer(playerid, BTTUTO[0]);
        TextDrawShowForPlayer(playerid, BTTUTO[1]);
        TextDrawShowForPlayer(playerid, BaseTuto[0]);
        SelectTextDraw(playerid, 0x00FF00FF);
        strcat(MEGAString, "  ~w~Local onde ocorre a as transacoes financeiras: Compra e Venda~n~");
        strcat(MEGAString, "  ~w~de Moedas, Saques, Transferencias e Depositos. Tambem temos Caixas~n~");
