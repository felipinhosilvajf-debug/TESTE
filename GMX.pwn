START::IniciarContagemHumanos(playerid)
{
    new string[100];
    if(TaNoQuarentena[playerid] == 1)
    {
        SendClientMessage(playerid, -1, "{DE6811}[Quarentena] Os infectados foram escolhidos, o tempo do evento esta passando, objetivo = Sobreviver.");
        if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(playerid, "http://brasilplaygames.com.br/musicas/quarentena1.mp3");
        ContagemQuarentena[playerid] = 600;
        TextDrawShowForPlayer(playerid, TextDrawCQ);
        TogglePlayerControllable(playerid, 1);
        format(string,sizeof(string),"HUMANOS WIN %d", ContagemQuarentena[playerid]);
        TextDrawSetString(TextDrawCQ, string);
        //RandomSetarInfectados(playerid);
        AtualizarEquipe(playerid);
    }
    KillTimer(TimeQuarentena); //MATAR CONTAGEM.
    return 1;
}
START::PlacarQuarentena(playerid)
{
    new QuantidadeHumanos = 0;
    new QuantidadeInfectados = 0;
    foreach(new i: Player)
    {
        if(EquipeQuarentena[i] == 1) QuantidadeHumanos++;
        if(EquipeQuarentena[i] == 2) QuantidadeInfectados++;
    }
    if(QuantidadeHumanos == 0)TimeQuarentena2 = SetTimer("InfectadosGanharam", 2000, false);
    if(QuantidadeInfectados == 0)TimeQuarentena3 = SetTimer("HumanosGanharam", 2000, false)
    format(gstring, sizeof(gstring), "[Quarentena] Placar Atual: {21AB13}Humanos [%d] {FFFFFF}x {DE6811}[%d] Infectados.",QuantidadeHumanos, QuantidadeInfectados);
    MensagemQuarentena(COR_GREEN, gstring);
    return 1;
}
START::InfectadosGanharam(playerid)
{
    new QuantidadeHumanos;
    foreach(new i: Player)
    {
        if(EquipeQuarentena[i] == 1) QuantidadeHumanos++;

        if(QuantidadeHumanos == 0)
        {
            if(EquipeQuarentena[i] == 2)
            {
                format(gstring, sizeof(gstring), "[Quarentena] Voces infectaram todos no evento e venceram. Recebeu [20.000].");
                SendClientMessage(i, COR_VERMELHO, gstring);
                RemovePlayerAttachedObject(i,0);
                RemovePlayerAttachedObject(i,1);
                RemovePlayerAttachedObject(i,2);
                RemovePlayerAttachedObject(i,3);
                TextDrawHideForPlayer(i, TextDrawCQ);
                SetPlayerSkin(i, PlayerInfo[i][pSkin]);
                ContagemQuarentena[i] = 0;
                TaNoQuarentena[i] = 0;
                EquipeQuarentena[i] = 0;
                PlayerInfo[i][pWinner] += 1;
                NaPorraDoEvento[i] = false;
                KillTimer(TempoVida[i]);
                GivePlayerMoneyEx(i, 20000);
                PlayerInfo[i][pExp] += 2;
                pClassiQuarentena[i] = 0;
                TendoQuarentena = 0;
                TaNoQuarentena[playerid] = 0;
                SetPlayerSpawn(i);
                SetHora();
            }
            if(EquipeQuarentena[i] == 1)
            {
                TextDrawHideForPlayer(i, TextDrawCQ);
                SetPlayerSkin(i, PlayerInfo[i][pSkin]);
                ContagemQuarentena[i] = 0;
                TaNoQuarentena[i] = 0;
                EquipeQuarentena[i] = 0;
                NaPorraDoEvento[i] = false;
                KillTimer(TempoVida[i]);
                pClassiQuarentena[i] = 0;
                SetPlayerSpawn(i);
            }
        }
    }
    KillTimer(TimeQuarentena2);
    format(gstring, sizeof(gstring), "[Quarentena] Todos os humanos foram infectados. Os infectados ganharam: R$20.000.");
    SendClientMessageToAll(COR_AMARELO, gstring);
    return 1;
}
START::HumanosGanharam(playerid)
{
    new QuantidadeInfectados;
    foreach(new i: Player)
    {
        if(EquipeQuarentena[i] == 2) QuantidadeInfectados++;

        if(QuantidadeInfectados == 0)
        {
            if(EquipeQuarentena[i] == 1)
            {
                format(gstring, sizeof(gstring), "[Quarentena] Voces mataram todos os infectados e sobreviveram. Recebeu [30.000] e 1 respeito.");
                SendClientMessage(i, COR_VERMELHO, gstring);
                SetPlayerSkin(i, PlayerInfo[i][pSkin]);
                TextDrawHideForPlayer(i, TextDrawCQ);
                ContagemQuarentena[i] = 0;
                TaNoQuarentena[i] = 0;
                PlayerInfo[i][pWinner] += 1;
                NaPorraDoEvento[i] = false;
                KillTimer(TempoVida[i]);
                GivePlayerMoneyEx(i, 30000);
                NaPorraDoEvento[i] = false;
                pClassiQuarentena[i] = 0;
                EquipeQuarentena[i] = 0;
                TendoQuarentena = 0;
                TaNoQuarentena[playerid] = 0;
                SetPlayerSpawn(i);
                SetHora();
            }
            if(EquipeQuarentena[i] == 2)
            {
                TextDrawHideForPlayer(i, TextDrawCQ);
                SetPlayerSkin(i, PlayerInfo[i][pSkin]);
                ContagemQuarentena[i] = 0;
                TaNoQuarentena[i] = 0;
                EquipeQuarentena[i] = 0;
                NaPorraDoEvento[i] = false;
                KillTimer(TempoVida[i]);
                pClassiQuarentena[i] = 0;
                SetPlayerSpawn(i);
            }
        }
    }
    KillTimer(TimeQuarentena3);
    format(gstring, sizeof(gstring), "[Quarentena] Todos os infectados foram eliminados. Os humanos ganharam: R$30.000 e 1 respeito.");
    SendClientMessageToAll(COR_AMARELO, gstring);
    return 1;
}
START::EvitarFloodQuarentena()
{
    new string[105];
    if(LiberadoEnviar == 0)
    {
        format(string, sizeof(string), "[Quarentena] Os humanos sobreviveram 10 minutos contra os infectados, ganharam: R$40.000 e 2 respeitos.");
        SendClientMessageToAll(COR_AMARELO, string);
        LiberadoEnviar = 1;
    }
    return 1;
}
START::AtualizarEquipe(playerid)
{
    foreach(new i: Player)
    {
        if(EquipeQuarentena[i] == 1)
        {
            GivePlayerWeaponEx(i, 33, 250);
            GivePlayerWeaponEx(i, 25, 250);
            GivePlayerWeaponEx(i, 22, 2000);
            SetPlayerSkin(i, SkinRandomHumano[random(16)]);
        }
        else if(EquipeQuarentena[i] == 2)
        {
            SetPlayerColor(i, COR_CV);
            SetPlayerAttachedObject(i, 10, 2906, 5, -0.2, 0.0, 0.0, 0, 0.0, -90, 1.0, 1.0, 1.0);
            SetPlayerAttachedObject(i, 9, 2906, 6, -0.2, 0.0, 0.0, 0, 345, 270, 1.0, 1.0, 1.0);
            SetPlayerAttachedObject(i, 2, 2908, 2, 0.05,0.06, 0.0, 180, 0.0, 90, 1.1, 1.1, 1.1);
            SetPlayerAttachedObject(i, 3, 2905, 12, 0.1, 0.05, 0.0, 0.0, 0.0, -70, 1.0, 1.0, 1.0);
            SetPlayerSkin(i, 162);
        }
    }
    LiberarInfectar = true;
    return 1;
}
START::RedWins()
{
    foreach(new i: Player)
    {
        if(TanoWarZone[i] == 1)
        {
            SendClientMessage(i, COR_AMARELO, "[War Zone] O Evento chegou ao fim, o time vermelho venceu e os membros receberam: R$20.000 e 1 respeito.");
            if(MaletaAnexada[i] == 1) StopPlayerHoldingObject(i);
            TextDrawHideForPlayer(i, TextDrawRED);
            TextDrawHideForPlayer(i, TextDrawBLUE);
            TextDrawHideForPlayer(i, TextDrawGREEN);
            ContandoRed = 0;
            ContandoBlue = 0;
            ContandoGreen = 0;
            ResetPlayerWeaponsEx(i);
            TanoWarZone[i] = 0;
            NaPorraDoEvento[i] = false;
            KillTimer(TempoVida[i]);
            MaletaAnexada[i] = 0;
            DisablePlayerCheckpoint(i);
            DestroyDynamicObject(maletaid);
            ContagemGreen = 0;
            ContagemRed = 0;
            ContagemBlue = 0;
            SetPlayerSkin(i, PlayerInfo[i][pSkin]);
            IniciarContagemWarZone = 0;
            LimiteRed = 0;
            LimiteBlue = 0;
            LimiteGreen = 0;
            SetPlayerSpawn(i);
            if(EquipeWarZone[i] == 1)
            {
                SendClientMessage(i, COR_LIGHTBLUE, "[Event Zones] O Time vermelho ganhou o evento e Voce ganhou R$15.000 e 1 respeito !");
                PlayerInfo[i][pExp] += 1;
                GivePlayerMoneyEx(i, 20000);
                PlayerInfo[i][pWinner] += 1;
            }
            EquipeWarZone[i] = 0;
        }
    }
}
START::GreenWins()
{
    foreach(new i: Player)
    {
        if(TanoWarZone[i] == 1)
        {
            SendClientMessage(i, COR_AMARELO,"[War Zone] O Evento chegou ao fim, o time verde venceu e os membros receberam: R$20.000 e 1 respeito.");
            if(MaletaAnexada[i] == 1) StopPlayerHoldingObject(i);
            TextDrawHideForPlayer(i, TextDrawRED);
            TextDrawHideForPlayer(i, TextDrawBLUE);
            TextDrawHideForPlayer(i, TextDrawGREEN);
            SetPlayerSkin(i, PlayerInfo[i][pSkin]);
            ContandoRed = 0;
            ContandoBlue = 0;
            ContandoGreen = 0;
            DisablePlayerCheckpoint(i);
            ResetPlayerWeaponsEx(i);
            TanoWarZone[i] = 0;
            ContagemGreen = 0;
            ContagemRed = 0;
            ContagemBlue = 0;
            NaPorraDoEvento[i] = false;
            KillTimer(TempoVida[i]);
            MaletaAnexada[i] = 0;
            DestroyDynamicObject(maletaid);
            IniciarContagemWarZone = 0;
            LimiteRed = 0;
            LimiteBlue = 0;
            LimiteGreen = 0;
            SetPlayerSpawn(i);
            if(EquipeWarZone[i] == 3)
            {
                SendClientMessage(i, COR_LIGHTBLUE, "[Event Zones] O Time verde ganhou o evento e Voce ganhou R$15.000 e 1 respeito !");
                PlayerInfo[i][pExp] += 1;
                GivePlayerMoneyEx(i, 20000);
                PlayerInfo[i][pWinner] += 1;
            }
            EquipeWarZone[i] = 0;
        }
    }
}
START::BlueWins()
{
    foreach(new i: Player)
    {
        if(TanoWarZone[i] == 1)
        {
            SendClientMessage(i, COR_AMARELO,"[War Zone] O Evento chegou ao fim, o time azul venceu e os membros receberam: R$20.000 e 1 respeito.");
            if(MaletaAnexada[i] == 1) StopPlayerHoldingObject(i);
            TextDrawHideForPlayer(i, TextDrawRED);
            TextDrawHideForPlayer(i, TextDrawBLUE);
            TextDrawHideForPlayer(i, TextDrawGREEN);
            SetPlayerSkin(i, PlayerInfo[i][pSkin]);
            ContandoRed = 0;
            ContandoBlue = 0;
            ContandoGreen = 0;
            DisablePlayerCheckpoint(i);
            ResetPlayerWeaponsEx(i);
            TanoWarZone[i] = 0;
            ContagemGreen = 0;
            ContagemRed = 0;
            ContagemBlue = 0;
            NaPorraDoEvento[i] = false;
            KillTimer(TempoVida[i]);
            MaletaAnexada[i] = 0;
            DestroyDynamicObject(maletaid);
            IniciarContagemWarZone = 0;
            LimiteRed = 0;
            LimiteBlue = 0;
            LimiteGreen = 0;
            SetPlayerSpawn(i);
            if(EquipeWarZone[i] == 2)
            {
                SendClientMessage(i, COR_LIGHTBLUE, "[Event Zones] O Time azul ganhou o evento e Voce ganhou R$15.000 e 1 respeito !");
                PlayerInfo[i][pExp] += 1;
                GivePlayerMoneyEx(i, 20000);
                PlayerInfo[i][pWinner] += 1;
            }
            EquipeWarZone[i] = 0;
        }
    }
}
forward editarportaozin(playerid);
public editarportaozin(playerid)
{
    ForT:editarmeuportao(playerid);
    return 1;
}
START::VerificaTitulos(playerid)
{
    new string[190];
    if(IsPlayerConnected(playerid) && gPlayerLogged[playerid])
    {
            // sistema de titulos
            if(TanoEventoJogosVorazes[playerid] == 1 || TaNoQuarentena[playerid] == 1)
            {
                SetPlayerChatBubble(playerid, "", COR_TITULO, 45.0, 100000);
                return 1;
            }
            if(WantedLevel[playerid] != 0 && Roubando[playerid] == 1 && EstaAFK[playerid] == 0)
            {
                 SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
                 format(string, sizeof(string), "Roubo[%d] Procurado:[%d]",Contagem[playerid], WantedLevel[playerid]);
                 SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 100000);
            }
            if(strfind(PlayerInfo[playerid][pATitulo], "", true) != -1 && Roubando[playerid] == 0 && EstaAFK[playerid] == 0)
            {
                 if(WantedLevel[playerid] != 0 && Roubando[playerid] == 0)
                 {
                      SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
                      format(string, sizeof(string), "P:[%d]",WantedLevel[playerid]);
                      SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 100000);
                 }
                 if(PlayerInfo[playerid][pJailed] != 0)
                 {
                      if(PlayerInfo[playerid][pPenitenciaria] == 1)
                      {
                           format(string, sizeof(string), "[ID:%d][Seg:%d][LS]",playerid, PlayerInfo[playerid][pJailTime]);
                           SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 10000);
                      }
                 }
            }
            else
            {
                if(Roubando[playerid] == 0 && EstaAFK[playerid] == 0)
                {
                     if(WantedLevel[playerid] == 0)
                     {
                          SetPlayerChatBubble(playerid, PlayerInfo[playerid][pATitulo], COR_TITULO, 45.0, 10000);
                     }
                     else if(WantedLevel[playerid] != 0)
                     {
                          SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
                          format(string, sizeof(string), "%s[P:%d]", PlayerInfo[playerid][pATitulo], WantedLevel[playerid]);
                          SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 10000);
                     }
                     if(PlayerInfo[playerid][pJailed] != 0)
                     {
                          if(PlayerInfo[playerid][pPenitenciaria] == 1)
                          {
                               format(string, sizeof(string), "%s[ID:%d][Seg:%d][LS]", PlayerInfo[playerid][pATitulo],playerid, PlayerInfo[playerid][pJailTime]);
                               SetPlayerChatBubble(playerid, string, COR_VERMELHO, 45.0, 10000);
                          }
                     }
                }
            }
    }
    return 1;
}
START::ColocarAureola(playerid)
{
    SetPlayerAttachedObject(playerid,9,2992,2,0.306000,-0.012000,0.009000,0.000000,-95.299942,-1.399999,1.000000,1.000000,1.000000);
    SetPlayerAttachedObject(playerid,10,2992,2,0.313000,-0.007000,0.032999,-0.299999,83.700019,0.000000,1.000000,1.000000,1.000000);
    return 1;
}
START::TirarAureola(playerid)
{
    RemovePlayerAttachedObject(playerid, 9);
    RemovePlayerAttachedObject(playerid, 10);
}
START::CarregarItens(playerid)
{
    //----------------- Carregar Itens ----------------------//
    if (!LogouAgora[playerid])
    {
        LoadWeaponsToFile(playerid); //carregar armas
        CreateTextDraws(playerid);
        SetStatusBar(playerid, 0, Player_PayDay[playerid], -PlayerInfo[playerid][pPayDay]);
        if(PlayerInfo[playerid][pTutorial] == 1 && PlayerInfo[playerid][pJailed] == 0)
        {
            if(PlayerInfo[playerid][pAdmin] >= 1)
            {
                new String[1000];
                format(String, sizeof(String), "{ffffff}Conta: {df5454}%s\n{ffffff}Voce logou com Admin ({df5454}Level %d{ffffff})\n\n{ffffff}Voce precisa inserir a senha de seguranca para poder\n{ffffff}logar em sua conta\n\n{fa4c4c}OBS: {ffffff}Voce tem uma tentativa, caso erre sera desconectado do Servidor!\n\n\n{818689}Insira abaixo a senha da Administracao:", PlayerName(playerid), PlayerInfo[playerid][pAdmin]);
                ShowPlayerDialog(playerid,998,DIALOG_STYLE_PASSWORD, " ", String, "Logar", "Cancelar");
                //SendClientMessage(playerid,-1, "{FE2EF7}Voce nao quis ir para ultima posicao onde saiu do jogo.");
            }
        //  ShowPlayerDialog(playerid, 1240, DIALOG_STYLE_MSGBOX, "Carregar Posicao", "Deseja voltar ao local onde saiu do jogo ?", "Sim", "Nao");
            //SendClientMessage(playerid, COR_AMARELO, "Acessorios carregados.");
            ClearChatbox(playerid, 100);
            new PFormat[500];
            SendClientMessage(playerid, COR_START2, "______________________________________________________________________________________________________________");


            new tvstring[500];
            format(tvstring, sizeof(tvstring), "~g~Bem Vindo ~p~%s", PlayerName(playerid));
            GameTextForPlayer(playerid, tvstring, 3000, 3);

            CriarVeiculo(playerid);

            format(PFormat, sizeof(PFormat), "{df5454}* [Aviso] Bem Vindo %s ! Qualquer duvida {ffffff}contate a STAFF!", PlayerName(playerid));
            SendClientMessage(playerid, COR_START, PFormat);
            SendClientMessage(playerid, COR_START, "{df5454}* [Aviso] Para encontrar qualquer localizacao use: ({ffffff}/gps{df5454})!");
            SendClientMessage(playerid, COR_START, "{df5454}* [Aviso] Retire suas Duvidas solicitando ({ffffff}/atendimento{df5454}) ou usando o chat global({ffffff}/n{df5454})!");
            SendClientMessage(playerid, COR_START, "{df5454}* [Aviso] Consulte todo painel de ajuda com  ({ffffff}/ajuda{df5454})!");
            SendClientMessage(playerid, COR_START, "{df5454}* [Aviso] Link Discord: https://discord.gg/9QP6UnS6xd - Servidor IP: 163.245.202.163!");
            if(PlayerInfo[playerid][pAdmin] > 0)
            {
                PhoneOnline[playerid] = 0;
                SendClientMessage(playerid,COR_START,"{df5454}* [Aviso] Voce e admin e logou com o Celular Ligado, se quiser desligar use /statuscel.");
            }


            if(PlayerInfo[playerid][pPHousekey] != 999)
            {
                new borse = PlayerInfo[playerid][pPHousekey];
                new StrRR[500];
                format(StrRR, sizeof(StrRR), "{df5454}* [Aviso] A sua casa sera vendida daqui %d dias, nao esqueca de pagar as despesas para que nao seja!", HouseInfo[borse][hTakings]);
                SendClientMessage(playerid, COR_START, StrRR);
            }




            if(PlayerInfo[playerid][pSocio] == 1)
            {
                new StrS[400];
                format(StrS, sizeof(StrS), "{df5454}[CONTA SoCIO] {ffffff}Voce possui atualmente: [{df5454}%d dias{ffffff}] de: [{df5454}SoCIO COMUM{ffffff}]", PlayerInfo[playerid][pDiaVIP]);
                SendClientMessage(playerid, COR_SHOX, StrS);
            }
            else if(PlayerInfo[playerid][pSocio] == 2)
            {
                new StrS[400];
                format(StrS, sizeof(StrS), "{df5454}[CONTA SoCIO] {ffffff}Voce possui atualmente: [{df5454}%d dias{ffffff}] de: [{df5454}SoCIO PREMIUM{ffffff}]", PlayerInfo[playerid][pDiaVIP]);
                SendClientMessage(playerid, COR_SHOX, StrS);
            }
            else if(PlayerInfo[playerid][pSocio] == 3)
            {
                new StrS[400];
                format(StrS, sizeof(StrS), "{df5454}[CONTA SoCIO] {ffffff}Voce possui atualmente: [{df5454}%d dias{ffffff}] de: [{df5454}SoCIO DIAMANTE{ffffff}]", PlayerInfo[playerid][pDiaVIP]);
                SendClientMessage(playerid, COR_SHOX, StrS);
            }

            if(PlayerInfo[playerid][pVIP] == 1)
            {
                new StrS[400];
                format(StrS, sizeof(StrS), "{df5454}[CONTA VIP] {ffffff}Voce possui atualmente: [{df5454}%d dias{ffffff}] de: [{df5454}VIP COMUM{ffffff}]", PlayerInfo[playerid][pDiaVIP]);
                SendClientMessage(playerid, COR_SHOX, StrS);
            }

            else if(PlayerInfo[playerid][pVIP] == 2)
            {
                new StrS[400];
                format(StrS, sizeof(StrS), "{df5454}[CONTA VIP] {ffffff}Voce possui atualmente: [{df5454}%d dias{ffffff}] de: [{df5454}VIP PREMIUM{ffffff}]", PlayerInfo[playerid][pDiaVIP]);
                SendClientMessage(playerid, COR_SHOX, StrS);
