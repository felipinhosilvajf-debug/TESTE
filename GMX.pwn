    ContagemDuelo[playerid] = 0;
    SendClientMessage(playerid, COR_GRAD1, "O Duelo foi iniciado, boa sorte!");
}
public OnPlayerModelSelectionEx(playerid, response, extraid, modelid)
{
    if(extraid==891)
    {
        if(!response)
        {   ShowPlayerDialog(playerid,890,DIALOG_STYLE_INPUT,"Menu de acessorios: Coloque o id do objeto","Coloque seu objeto custom ''http://wiki.sa-mp.com''.","Editar","Voltar");    }
        if(response)
        {
            if(GetPVarInt(playerid, "AttachmentUsed") == 1) EditAttachedObject(playerid, modelid);
            else
            {
                SetPVarInt(playerid, "AttachmentModelSel", modelid);
                new string[256+1];
                new dialog[500];
                for(new x;x<sizeof(AttachmentBones);x++)
                {
                    format(string, sizeof(string), "Local:%s\n", AttachmentBones[x]);
                    strcat(dialog,string);
                }
                ShowPlayerDialog(playerid, 891, DIALOG_STYLE_LIST, \
                "{FF0000}Edicao do acessorio - Parte do corpo", dialog, "Selecionar", "Cancelar");
            }//else DeletePVar(playerid, "AttachmentIndexSel");
        }
    }
    return 1;
}
public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
    if(response == EDIT_RESPONSE_FINAL)
    {
        new arquivo[64];
        format(arquivo, sizeof(arquivo), Pasta_CAcessorio,PlayerName(playerid));
        new string[20];
        if(DOF2_FileExists(arquivo))
        {
            DOF2_SetInt(arquivo, "index", index);
            format(string, sizeof(string), "modelid%d", index);
            DOF2_SetInt(arquivo, string, modelid);
            format(string, sizeof(string), "boneid%d", index);
            DOF2_SetInt(arquivo, string, boneid);
            format(string, sizeof(string), "fOffsetX%d", index);
            DOF2_SetFloat(arquivo, string, fOffsetX);
            format(string, sizeof(string), "fOffsetY%d", index);
            DOF2_SetFloat(arquivo, string, fOffsetY);
            format(string, sizeof(string), "fOffsetZ%d", index);
            DOF2_SetFloat(arquivo, string, fOffsetZ);
            format(string, sizeof(string), "fRotX%d", index);
            DOF2_SetFloat(arquivo, string, fRotX);
            format(string, sizeof(string), "fRotY%d", index);
            DOF2_SetFloat(arquivo, string, fRotY);
            format(string, sizeof(string), "fRotZ%d", index);
            DOF2_SetFloat(arquivo, string, fRotZ);
            format(string, sizeof(string), "fScaleX%d", index);
            DOF2_SetFloat(arquivo, string, fScaleX);
            format(string, sizeof(string), "fScaleY%d", index);
            DOF2_SetFloat(arquivo, string, fScaleY);
            format(string, sizeof(string), "fScaleZ%d", index);
            DOF2_SetFloat(arquivo, string, fScaleZ);
            format(string, sizeof(string), "modelid%d", index);
            DOF2_SetFloat(arquivo, string, modelid);

            //NomeDoAcessorio(IDObjeto)
            new Str2[800];
            new ystring[20];
            format(arquivo, sizeof(arquivo), Pasta_CAcessorio,PlayerName(playerid));
            format(ystring, sizeof(ystring), "modelid%d", ArmazenarSlot[playerid]);
            new IDObjeto = DOF2_GetInt(arquivo, ystring);
            format(Str2, sizeof(Str2), "{fa4c4c}Alerta: {ffffff}Voce finalizou a edicao do objeto: {df5454}%s{ffffff}!\n\n{818689}Para editar seus acessorios, digite: /acessorios!", NomeDoAcessorio(IDObjeto));
            ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX," ", Str2, "Fechar","");
            SendClientMessage(playerid, 0x33FF00FF, "{33ff00}[!] {ffffff}Voce colocou um acessorio, para editar ou guardar digite /acessorios.");
        }
        else
        {
            DOF2_CreateFile(arquivo);
            DOF2_SetInt(arquivo, "index", index);
            format(string, sizeof(string), "modelid%d", index);
            DOF2_SetInt(arquivo, string, modelid);
            format(string, sizeof(string), "boneid%d", index);
            DOF2_SetInt(arquivo, string, boneid);
            format(string, sizeof(string), "fOffsetX%d", index);
            DOF2_SetFloat(arquivo, string, fOffsetX);
            format(string, sizeof(string), "fOffsetY%d", index);
            DOF2_SetFloat(arquivo, string, fOffsetY);
            format(string, sizeof(string), "fOffsetZ%d", index);
            DOF2_SetFloat(arquivo, string, fOffsetZ);
            format(string, sizeof(string), "fRotX%d", index);
            DOF2_SetFloat(arquivo, string, fRotX);
            format(string, sizeof(string), "fRotY%d", index);
            DOF2_SetFloat(arquivo, string, fRotY);
            format(string, sizeof(string), "fRotZ%d", index);
            DOF2_SetFloat(arquivo, string, fRotZ);
            format(string, sizeof(string), "fScaleX%d", index);
            DOF2_SetFloat(arquivo, string, fScaleX);
            format(string, sizeof(string), "fScaleY%d", index);
            DOF2_SetFloat(arquivo, string, fScaleY);
            format(string, sizeof(string), "fScaleZ%d", index);
            DOF2_SetFloat(arquivo, string, fScaleZ);
            format(string, sizeof(string), "modelid%d", index);
            DOF2_SetFloat(arquivo, string, modelid);
            SendClientMessage(playerid, 0x33FF00FF, "{33ff00}[!] {ffffff}Voce colocou um acessorio, para editar ou guardar digite /acessorios.");
            ShowPlayerDialog(playerid, 999, DIALOG_STYLE_MSGBOX," ", "{fa4c4c}Alerta: {ffffff}Voce finalizou a edicao do objeto: {df5454}**{ffffff}!\n\n{818689}Para editar seus acessorios, digite: /acessorios!", "Fechar","");
        }
    }
    return 1;
}
public OnPlayerModelSelection(playerid, response, listid, modelid)
{
    if(listid == MoveisList || listid == QuartoList || listid == SalaList || listid == BanheiroList || listid == CozinhaList || listid == DecoracaoList)
    {
        if(response)
        {
            new Float:x,Float:y,Float:z,casaid = PlayerInfo[playerid][pPHousekey];
            if(GetPlayerMoney(playerid) < 900){

                return SendClientMessage(playerid, COR_GREY, "Voce nao tem R$900 para comprar um movel !");
            }
            GivePlayerMoneyEx(playerid,-900);
            GetPlayerPos(playerid, x, y, z);
            GetXYInFrontOfPlayer(playerid, x, y, 1.5);
            SetPVarInt(playerid, "editMovel", addMovel(casaid, modelid, x, y, z, 0.0, 0.0, 0.0, GetPlayerVirtualWorld(playerid)));
            SetPVarInt(playerid, "editandoh", 999);
            EditDynamicObject(playerid, MobInfo[casaid][GetPVarInt(playerid, "editMovel")][mobObject]);
            new string[256];
            format(string, sizeof string, "Voce acaba de comprar um movel para sua casa [%d/%d]", countMoveis(casaid), MAX_MOVEIS);
            SendClientMessage(playerid, COR_NEWS, string);
        }
        else {
            SendClientMessage(playerid, COR_NEWS, "Voce cancelou o menu de Moveis!");
        }
    }
    if(listid == BoneLista)
    {
        if(response)
        {
            if(PlayerInfo[playerid][pDinheiro] < 1800)
            {
                return SendClientMessage(playerid, COR_GRAD1, "Voce nao possui dinheiro suficiente!");
            }
            for(new i=0; i<75; i++)
            {
                if(InventarioInfo[playerid][i][iSlot] == 19382)
                {
                    InventarioInfo[playerid][i][iSlot] = modelid;
                    InventarioInfo[playerid][i][iUnidades] = 1;
                    SendClientMessage(playerid, -1, "Voce comprou um bone, custou ${33aa33}1.800{ffffff}, para usa-lo abra seu inventario pressionando a tecla {df5454}( N ).");
                    BizzInfo[12][bTill] += 1800;
                    GivePlayerMoneyEx(playerid, -1800);
                    break;
                }
            }
        }
    }
    if(listid == RelogioLista)
    {
        if(response)
        {
            if(PlayerInfo[playerid][pDinheiro] < 1800)
            {
                return SendClientMessage(playerid, COR_GRAD1, "Voce nao possui dinheiro suficiente!");
            }
            for(new i=0; i<75; i++)
            {
                if(InventarioInfo[playerid][i][iSlot] == 19382)
                {
                    InventarioInfo[playerid][i][iSlot] = modelid;
                    InventarioInfo[playerid][i][iUnidades] = 1;
                    SendClientMessage(playerid, -1, "Voce comprou um relogio, custou ${33aa33}1.800{ffffff}, para usa-lo abra seu inventario pressionando a tecla {df5454}( N ).");
                    BizzInfo[12][bTill] += 1800;
                    GivePlayerMoneyEx(playerid, -1800);
                    break;
                }
            }
        }
    }
    if(listid == OculosLista)
    {
        if(response)
        {
            if(PlayerInfo[playerid][pDinheiro] < 1800)
            {
                return SendClientMessage(playerid, COR_GRAD1, "Voce nao possui dinheiro suficiente!");
            }
            for(new i=0; i<75; i++)
            {
                if(InventarioInfo[playerid][i][iSlot] == 19382)
                {
                    InventarioInfo[playerid][i][iSlot] = modelid;
                    InventarioInfo[playerid][i][iUnidades] = 1;
                    SendClientMessage(playerid, -1, "Voce comprou um oculos, custou ${33aa33}1.800{ffffff}, para usa-lo abra seu inventario pressionando a tecla {df5454}( N ).");
                    BizzInfo[12][bTill] += 1800;
                    GivePlayerMoneyEx(playerid, -1800);
                    break;
                }
            }
        }
    }
    if(listid == BandanaLista)
    {
        if(response)
        {
            if(PlayerInfo[playerid][pDinheiro] < 2000)
            {
                return SendClientMessage(playerid, COR_GRAD1, "Voce nao possui dinheiro suficiente!");
            }
            for(new i=0; i<75; i++)
            {
                if(InventarioInfo[playerid][i][iSlot] == 19382)
                {
                    InventarioInfo[playerid][i][iSlot] = modelid;
                    InventarioInfo[playerid][i][iUnidades] = 1;
                    SendClientMessage(playerid, -1, "Voce comprou uma bandana, custou ${33aa33}2.000{ffffff}, para usa-lo abra seu inventario pressionando a tecla {df5454}( N ).");
                    BizzInfo[12][bTill] += 2000;
                    GivePlayerMoneyEx(playerid, -2000);
                    break;
                }
            }
        }
    }
    if(listid == skinlist)
    {
        if(response)
        {
            SendClientMessage(playerid, COR_LIGHTBLUE, "* Voce comprou nova skin por R$1000. A roupa esta no seu inventario, coloque-a quando quizer!");
            GivePlayerMoney(playerid,-1000);
            SBizzInfo[6][sbTill] += 1000;
            ExtortionSBiz(6, 1000);
            for(new i=0; i<75; i++)
            {
                if(InventarioInfo[playerid][i][iSlot] == 19382)
                {
                    InventarioInfo[playerid][i][iSlot] = modelid;
                    InventarioInfo[playerid][i][iUnidades] = 1;
                    break;
                }
            }
        }
        else SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao escolheu nenhuma skin.");
        return 1;
    }
    if(listid == ComprarSkinList)
    {

        if(response)
        {
            SendClientMessage(playerid, COR_LIGHTBLUE, "Skin Modificada !");
            SetPlayerSkin(playerid, modelid);
            new arquivo[64];
            format(arquivo, sizeof(arquivo), Pasta_Acessorio,PlayerName(playerid));
            if(DOF2_FileExists(arquivo))
            {
                DOF2_SetInt(arquivo, "Skin Permanente", modelid);
            }
            else
            {
                DOF2_CreateFile(arquivo);
                DOF2_SetInt(arquivo, "Skin Permanente", modelid);
            }

        }
        else SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao escolheu nenhuma skin.");
        return 1;
    }
    if(listid == AcessoriosLista)
    {
        if(!response)
        {
            return SendClientMessage(playerid, COR_AMARELO, "Voce saiu do menu de itens !");
        }
        if(response)
