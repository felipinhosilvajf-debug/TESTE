    CMD:jogar(playerid, params[])  return ForT:trabalhar(playerid, params);
    CMD:trabalhar(playerid, params[])
    {
        if(PlayerInfo[playerid][pAdmin] >= 1 && PlayerInfo[playerid][pAdmin] <= 1342)
        {
            if(AdminTrabalhando[playerid] > 0)
            {
                AdminTrabalhando[playerid] = 0;
                GetPlayerName(playerid,sendername,sizeof(sendername));
                format(stringZCMD, sizeof(stringZCMD), "[STAFF]: O admin {858585}%s{FF00FF} Saiu no modo trabalho!",sendername, playerid);
                SendClientMessageToAll(0xFF00FFAA, stringZCMD);
                SetPlayerToTeamColor(playerid);
                ResetPlayerWeaponsEx(playerid);
                SetPlayerHealth(playerid, 100);
                TirarAureola(playerid);
            }
            else
            {
                AdminTrabalhando[playerid] = 1;
                GetPlayerName(playerid,sendername,sizeof(sendername));
                format(stringZCMD, sizeof(stringZCMD), "[STAFF]: O admin {858585}%s{FF00FF} Entrou no modo trabalho!",sendername, playerid);
                SendClientMessageToAll(0xFF00FFAA, stringZCMD);
                SetPlayerToTeamColor(playerid);
                SetPlayerArmour(playerid, 100);
                SetPlayerHealth(playerid, 100);
                ColocarAureola(playerid);
            }
        }
        return 1;
    }
