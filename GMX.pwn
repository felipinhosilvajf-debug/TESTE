START::ScoreLevel(playerid)
{
    new LevScore;
    LevScore = PlayerInfo[playerid][pLevel];
    SetPlayerScore(playerid, LevScore);
}
START::Slide(playerid)
{
    if(Sliding[playerid] == 1)
    {
         new Float:X;
         new Float:Y;
         new Float:Z;
         GetPlayerPos(playerid, X, Y, Z);
         SetPlayerPos(playerid, X, Y, Z - 5.00);
         DestroyDynamicObject(Corda[playerid]);
         ApplyAnimation(playerid,"ped","abseil",4.0,0,0,0,1,0);
         Corda[playerid] = CreateDynamicObject(19089, X, Y, Z, 0.0, 0.0, 0.0);
         SetTimerEx("Slide", 1000, 0, "i", playerid);
    }
    return 1;
}
START::Slidee(playerid)
{
    if(Sliding[playerid] == 1)
    {
        Sliding[playerid] = 0;
        DestroyDynamicObject(Corda[playerid]);
        TogglePlayerControllable(playerid, 1);
        SendClientMessage(playerid, COR_BRANCO, "Sua corda arrebentou, Voce pulou de um lugar muito alto !");
    }
}
