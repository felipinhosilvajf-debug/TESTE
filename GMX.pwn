SaveWeaponsToFile(playerid) //salvamento de armas
{
    new i, path[50], string[128], weaponid, ammo;
    path = GetPlayerFormattedName(playerid);
    if (!DOF2_FileExists(path)) DOF2_CreateFile(path);
    for (i=0; i<13; ++i)
    {
        GetPlayerWeaponData(playerid,i,weaponid,ammo);
        format(string,sizeof(string),"Weapon - %d",i);
        DOF2_SetInt(path,string,weaponid);
        format(string,sizeof(string),"AmmoID - %d",i);
        DOF2_SetInt(path,string,ammo == 65535 ? 0 : ammo);
        DOF2_SaveFile();
    }
}
START::LoadWeaponsToFile(playerid)
{
    new i, path[50], string[128], weaponid, ammo;
    path = GetPlayerFormattedName(playerid);
    ResetPlayerWeaponsEx(playerid);
    if(PlayerInfo[playerid][pJailed] == 0)
    {
        if(PlayerInfo[playerid][pMembro] == 0 && PlayerInfo[playerid][pLider] == 0)
        {
            for (i=0; i<13; ++i)
            {
                format(string,sizeof(string),"Weapon - %d",i);
                weaponid = DOF2_GetInt(path,string);
                format(string,sizeof(string),"AmmoID - %d",i);
                ammo = DOF2_GetInt(path,string);
                GivePlayerWeaponEx(playerid,weaponid,ammo);
            }
        }
    }
    LogouAgora[playerid] = true;
    DOF2_RemoveFile(path);
}
GetPlayerFormattedName(playerid)
{
    new name[24], full[50];
    GetPlayerName(playerid,name,sizeof(name));
    format(full,sizeof(full),"%s/%s.txt","Armas",name);
    return full;
}
START::VerificarGanhador(playerid) //jogos vorazes
{
    if(QuantidadeEvento == 1)
    {
        foreach(new i: Player)
        {
            if(TanoEventoJogosVorazes[i] == 1)
            {
                format(gstring, sizeof(gstring), "[Jogos Vorazes] %s foi o unico sobrevivente nos jogos vorazes e recebeu R$30.000 e 2 de respeito.",PlayerName(i));
                SendClientMessageToAll(COR_AMARELO,gstring);
                SetPlayerWorldBounds(i, 20000.0000,-20000.0000,20000.0000,-20000.0000);
                SetPlayerSkin(i, PlayerInfo[i][pSkin]);
                TanoEventoJogosVorazes[i] = 0;
                PlayerInfo[i][pWinner] += 1;
                GivePlayerMoneyEx(i, 30000);
                NaPorraDoEvento[i] = false;
                KillTimer(TempoVida[i]);
                PlayerInfo[i][pExp] += 2;
                QuantidadeEvento = 0;
                SetPlayerSpawn(i);
                //setarhora pra o player
            }
        }
    }
    return 1;
}
START::DisputaHitAss(playerid)
{
    KillTimer(TempoDisputa);
    TempoDisputa = SetTimer("DisputaGangster", 5000, false); // Disputa Gangster
    //====================[ Disputa Hitmans ]====================//
    if(CHitman > CTriads)
    {
         format(gstring, sizeof(gstring), "[Disputa Contratos] Hitmans ficaram na frente na disputa, resultado: Triads [%d] X [%d] Hitmans, Lider[%s]! (Premio no Cofre: R$500.000)", CTriads,CHitman, InfoOrg[8][Lider]);
         SendClientMessageToAll(COR_AMARELO, gstring);
         DepositarGranaOrg(8, 500000);
    }
    else if(CTriads > CHitman)
    {
         format(gstring, sizeof(gstring), "[Disputa Contratos] Triads ficaram na frente na disputa, resultado: Triads [%d] X [%d] Hitmans, Lider[%s]! (Premio no Cofre: R$500.000)", CTriads, CHitman, InfoOrg[26][Lider]);
         SendClientMessageToAll(COR_AMARELO, gstring);
         DepositarGranaOrg(26, 500000);
    }
    else if(CTriads == CHitman)
    {
         format(gstring, sizeof(gstring), "[Disputa Contratos] Triads e Hitmans ficaram empatados na disputa, cumpriram [%d] contratos! (Premio no Cofre: R$0.000.000)", CTriads);
         SendClientMessageToAll(COR_AMARELO, gstring);
    }
    CHitman = 0;
    CTriads = 0;
}
START::DisputaGangster(playerid)
{
    KillTimer(TempoDisputa);
    TempoDisputa = SetTimer("DisputaMafiosos", 5000, false); // Disputa Mafiosos
    //====================[ Disputa Gangsters ]====================//
    // Los Aztecas
    if(DisputaLosAstecas > DisputaGrooveStreet && DisputaLosAstecas > DisputaBallas && DisputaLosAstecas > DisputaLosVagos && DisputaLosAstecas > DisputaCV && DisputaLosAstecas > DisputaPCC)
    {
         format(gstring, sizeof(gstring), "[Disputa Gangsters] Los Aztecas dominaram: [%d] territorios, ficando na frente nesta ultima hora, Lider[%s].", DisputaLosAstecas, InfoOrg[5][Lider]);
         SendClientMessageToAll(COR_AMARELO, gstring);
         DepositarGranaOrg(5, 500000);
    }
    // Groove Street
    else if(DisputaGrooveStreet > DisputaLosAstecas && DisputaGrooveStreet > DisputaBallas && DisputaGrooveStreet > DisputaLosVagos && DisputaGrooveStreet > DisputaCV && DisputaGrooveStreet > DisputaPCC)
    {
         format(gstring, sizeof(gstring), "[Disputa Gangsters] Groove Street dominaram: [%d] territorios, ficando na frente nesta ultima hora, Lider[%s].", DisputaGrooveStreet, InfoOrg[15][Lider]);
         SendClientMessageToAll(COR_AMARELO, gstring);
         DepositarGranaOrg(15, 500000);
    }
    // Ballas
    else if(DisputaBallas > DisputaLosAstecas && DisputaBallas > DisputaGrooveStreet && DisputaBallas > DisputaLosVagos && DisputaBallas > DisputaCV && DisputaBallas > DisputaPCC)
    {
         format(gstring, sizeof(gstring), "[Disputa Gangsters] Ballas dominaram: [%d] territorios, ficando na frente nesta ultima hora, Lider[%s].", DisputaBallas, InfoOrg[18][Lider]);
         SendClientMessageToAll(COR_AMARELO, gstring);
         DepositarGranaOrg(18, 500000);
    }
    // Los Vagos
    else if(DisputaLosVagos > DisputaGrooveStreet && DisputaLosVagos > DisputaPCC && DisputaLosVagos > DisputaBallas && DisputaLosVagos > DisputaCV && DisputaLosVagos > DisputaLosAstecas)
    {
         format(gstring, sizeof(gstring), "[Disputa Gangsters] Los Vagos dominaram: [%d] territorios, ficando na frente nesta ultima hora, Lider[%s].", DisputaLosVagos, InfoOrg[19][Lider]);
         SendClientMessageToAll(COR_AMARELO, gstring);
         DepositarGranaOrg(19, 500000);
    }
    // Comando Vermelho
    else if(DisputaCV > DisputaGrooveStreet && DisputaCV > DisputaPCC && DisputaCV > DisputaBallas && DisputaCV > DisputaLosVagos && DisputaCV > DisputaCV && DisputaLosVagos > DisputaLosAstecas)
    {
         format(gstring, sizeof(gstring), "[Disputa Gangsters] Comando Vermelho dominaram: [%d] territorios, ficando na frente nesta ultima hora, Lider[%s].", DisputaCV, InfoOrg[23][Lider]);
         SendClientMessageToAll(COR_AMARELO, gstring);
         DepositarGranaOrg(23, 500000);
    }
    // PCC
    else if(DisputaPCC > DisputaGrooveStreet && DisputaPCC > DisputaCV && DisputaPCC > DisputaBallas && DisputaPCC > DisputaLosVagos && DisputaPCC > DisputaLosAstecas)
    {
         format(gstring, sizeof(gstring), "[Disputa Gangsters] Primeiro Comando da Capital dominaram: [%d] territorios, ficando na frente nesta ultima hora, Lider[%s].", DisputaPCC, InfoOrg[11][Lider]);
         SendClientMessageToAll(COR_AMARELO, gstring);
         DepositarGranaOrg(11, 500000);
    }
    DisputaLosAstecas = 0;
    DisputaGrooveStreet = 0;
    DisputaBallas = 0;
    DisputaLosVagos = 0;
    DisputaCV = 0;
    DisputaPCC = 0;
}
