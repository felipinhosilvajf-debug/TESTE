stock CarregarCaixa(playerid)
{
    new Nome[25];
    GetPlayerName(playerid,Nome,sizeof(Nome));
    new Arquivo[41]="Caixas/.cfg";
    strins(Arquivo, Nome, 12, 25);
    if(DOF2_FileExists(Arquivo))
    {
  new str[12];
        for(new i = 0; i != 8; ++i)
        {
            format(str, sizeof(str), "Arma box %d", i);
            CaixaArma[i][playerid]=DOF2_GetInt(Arquivo, str);
            format(str, sizeof(str), "Ammo box %d", i);
            CaixaAmmo[i][playerid]=DOF2_GetInt(Arquivo, str);
        }
    }
    return 1;
}
START::ApagarFogoAdmin(playerid)
{
     for(new e = 0; e < 17; e++)
     {
          DestroyDynamicObject(FogoID[e]);
          FogoApagado[e] = true;
     }
     return 1;
}
START::ZerarEventoChuck(playerid)
{
    foreach(new i: Player)
    {
        if(PlayerInfo[i][pTrazerChuck] == 1 || PrimeiroChuck[i] == 1)
        {
            new string[150];
            new evento[150];
            if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(i, "http://dl.dropboxusercontent.com/s/fugn4csjjhyj734/fimevento.mp3");
            format(string, sizeof(string), "O Evento chegou ao fim, seu K/D foi [%d/%d], obrigado pela participacao.", KillEvento[i], DeatEvento[i]);
            SendClientMessage(i, COR_AMARELO, string);
            if(KillEvento[i] >= CalculoGanhandoEvento)
            {
                format(evento, sizeof(evento), "[Chuck Norris] %s ganhou o evento com o  K/D:[%d/%d]", PlayerName(i), KillEvento[i], DeatEvento[i]);
                MensagemChuck(COR_AMARELO, evento);
            }
            PrimeiroChuck[i] = 0;
            LimiteEvento = 0;
            TipoEvento = 0;
            PrimeiroChuck[i] = 0;
            PlayerInfo[i][pTrazerChuck] = 0;
            LimiteChuck = 0;
            SetPlayerSpawn(i);
            ResetPlayerWeaponsEx(i);
            NaPorraDoEvento[i] = false;
            KillTimer(TempoVida[i]);
            SetPlayerSkin(i, PlayerInfo[i][pSkin]);
            SetPlayerToTeamColor(i);
            SetPlayerWorldBounds(i,20000.0000,-20000.0000,20000.0000,-20000.0000);
        }
    }
}
START::ZerarEventoTiroteio(playerid)
{
    foreach(new i: Player)
    {
        if(PlayerInfo[i][pTiroteio] > 0)
        {
            new string[150];
            new evento[150];
            ResetPlayerWeaponsEx(i);
            if(TaEscutando[playerid] == 0) PlayAudioStreamForPlayer(i, "https://dl.dropboxusercontent.com/s/x8j9tp6lqhro3ui/fimevento.mp3");
            format(string, sizeof(string), "O Evento chegou ao fim, seu K/D foi [%d/%d], obrigado pela participacao.", KillEvento[i], DeatEvento[i]);
            SendClientMessage(i, COR_AMARELO, string);
            if(KillEvento[i] >= CalculoGanhandoEvento)
            {
                format(evento, sizeof(evento), "[Evento Tiroteio] %s ganhou o evento com o  K/D:[%d/%d]", PlayerName(i), KillEvento[i], DeatEvento[i]);
                MensagemTiroteio(COR_AMARELO, evento);
            }
            CalculoGanhandoEvento = 0;
            PlayerInfo[i][pTiroteio] = 0;
            KillEvento[i] = 0;
            DeslogouNoTiroteio[i] = 0;
            TipoEvento = 0;
            DeatEvento[i] = 0;
            eventoconst[i] = 0;
            eventodp[i] = 0;
            MorteEvento[i] = 0;
            eventofloresta[i] = 0;
            eventoarena[i] = 0;
            eventomansao[i] = 0;
            NaPorraDoEvento[i] = false;
            KillTimer(TempoVida[i]);
            eventomansao[i] = 0;
            EventoAcontecendo = 0;
            SetHora();
            SetPlayerSpawn(i);
        }
    }
}
AlertaCop(Msg[])
{
    new
        OrgCop[] = {
            1, 2, 3, 12, 13, 17, 25
        };
    foreach(new all: Player){
        for(new getOrg; getOrg < sizeof(OrgCop); getOrg++){
            if(GetPlayerOrg(all) == OrgCop[getOrg]){
                SendClientMessage(all, COR_LIGHTRED, Msg);
            }
        }
    }
}
//resetar var
START::ContagemRoubo_(playerid, Float:X, Float:Y, Float:Z)
{
    format(stringZCMD, sizeof(stringZCMD), "~w~Tempo Para Roubar:~n~~r~%d Segundos...", TempoRoubo_[playerid]);
    GameTextForPlayer(playerid, stringZCMD, 1500, 3);
    SoundInRange(9200, 20.0, X, Y, Z);
    SetPlayerWantedLevelEx(playerid, WantedLevel[playerid]);
    format(gstring, sizeof(gstring), "Roubo[%d] | Procurado:[%d]",TempoRoubo_[playerid], WantedLevel[playerid]);
    SetPlayerChatBubble(playerid, gstring, COR_VERMELHO, 40.0, 100000);
    FazendaRoubada = 0;
    if(InteriorAtual[playerid] >= 53 && InteriorAtual[playerid] <= 72) FazendaRoubada = GetPlayerVirtualWorld(playerid);
    if(TempoRoubo_[playerid] > 15)
    {
        ApplyAnimation(playerid, "COP_AMBIENT", "COPBROWSE_LOOP", 4.0, 1, 0, 0, 0, 0);
    }
    else if(TempoRoubo_[playerid] == 15)
    {
        new Float: x, Float: y, Float: z, Float: a;
        GetDynamicObjectPos(PortaCofre[LocalDeRoubo[playerid]+FazendaRoubada-1], x, y, z);
        GetDynamicObjectRot(PortaCofre[LocalDeRoubo[playerid]+FazendaRoubada-1], a, a, a);
        MoveDynamicObject(PortaCofre[LocalDeRoubo[playerid]], x, y, z+0.015, 0.011, 0.0, 0.0, a+230.0);
        RemovePlayerAttachedObject(playerid, 9);
        ClearAnimations(playerid);
        ApplyAnimation(playerid, "ROB_BANK", "CAT_Safe_Open", 4.0, 0, 0, 0, 0, 0, 1);
        PlayerPlaySound(playerid, 1057, 0.0, 0.0, 0.0);
    }
    else if(TempoRoubo_[playerid] < 12)
    {
        ApplyAnimation(playerid, "BOMBER","BOM_Plant_In",4.0,0,0,0,0,0);
        SetPlayerHoldingObject(playerid, 1550, 1, 0.024558, -0.279748, -0.060589, 6.105677, 137.291320, 147.132202, 1.019888, 1.000000, 1.000000 );
    }
    if(TempoRoubo_[playerid] == 0)
    {
        KillTimer(TimerRoubando[playerid]);
        format(stringZCMD, sizeof(stringZCMD), "[Roubo] {ffffff}%s(%d) e os %s conseguiram roubar o cofre %s.",PlayerName(playerid), playerid, NomeORG(playerid), getNameLocalRoubo(LocalDeRoubo[playerid]));
        SendClientMessageToAll(GetPlayerColor(playerid), stringZCMD);
        StopPlayerHoldingObject(playerid);
        Roubando[playerid] = 0;
        //Dropar Dinheiro
        for(new C = 0; C < random(10); C++){
            CreateDroppedItem(1212, random(3000), X-random(1), Y+random(1), Z);
        }
        new LocalRoubo = LocalDeRoubo[playerid];
        TempoRoubarNovamente[LocalRoubo] = 70*60; //70 min
        AjustRoubarNovamente[LocalRoubo] = gettime();

        switch(LocalRoubo){
            case 0:
            {
                //Banco LS
                //Drop de grana
                for(new C = 0; C < 10; C++){
                    CreateDroppedItem(1212, random(3000), X-random(1), Y+random(1), Z);
                }

                for(new C = 0; C < 10; C++){
                    CreateDroppedItem(360, 10, X-random(1), Y+random(1), Z);
                }
                //Cartorio
                MoveDynamicObject(PortaCofre[1], -2165.738037, 646.948059, 1051.824951, 0.011, 0.0, 0.0, 628.988159);
            }
            case 1:
            {
                //BANCO LS
                MoveDynamicObject(portabanco,2943.5000000,-1782.1000000,1182.1000000,3.0);
                SetTimer("fecharbanco", 35000, false);
                MoveDynamicObject(PortaCofre[0], 2944.047363, -1766.736450, 1177.868286, 0.011, 0.0, 0.0, 719.764282);
            }
            case 2:
            {
                //Loterica LS
                MoveDynamicObject(PortaCofre[2], 820.430969, 9.296254, 1003.645019, 0.011, 0.0, 0.0, 450.515960);
            }
            case 3:
            {
                //Loja de Armas 1
                for(new C = 0; C < 10; C++){
                    CreateDroppedItem(348, 100, X-random(1), Y+random(1), Z);
                }
                MoveDynamicObject(PortaCofre[3],299.661041, -168.002670, 999.043762, 0.011, 0.0, 0.0, 450.797912);
            }
            case 4:
            {
                //Loja de Armas 2
                for(new C = 0; C < 10; C++){
                    CreateDroppedItem(348, 100, X-random(1), Y+random(1), Z);
                }
                MoveDynamicObject(PortaCofre[4], 302.704650, -56.284645, 1000.965637, 0.011, 0.0, 0.0, 630.117248);
            }
            case 5:
            {
                //Loja de Armas 3
                for(new C = 0; C < 10; C++){
                    CreateDroppedItem(348, 100, X-random(1), Y+random(1), Z);
                }
                MoveDynamicObject(PortaCofre[5], 301.425659, -126.328681, 1003.512512, 0.011, 0.0, 0.0, 718.282592);
            }
            case 6:
            {
                //Puteiro
                MoveDynamicObject(PortaCofre[6], 1221.991333, 5.429377, 1000.371887, 0.011, 0.0, 0.0, 629.693847);
            }
            case 7:
            {
                //Motel
                MoveDynamicObject(portamotel,956, -50.1, 998,3.0);
                SetTimer("fecharmotel", 35000, false);
                MoveDynamicObject(PortaCofre[7], 948.014282, -40.567066, 1000.566650, 0.011, 0.0, 0.0, 628.402343);
            }
            case 8:
            {
                //Ilha
                for(new C = 0; C < 10; C++){
                    CreateDroppedItem(360, 10, X-random(1), Y+random(1), Z);
                }
                MoveDynamicObject(PortaCofre[8], -2170.197509, -7722.098144, 53.411693, 0.011, 0.0, 0.0, 455.629486);
            }
            case 9:
            {
                //Navio
                for(new C = 0; C < 10; C++){
                    CreateDroppedItem(360, 10, X-random(1), Y+random(1), Z);
                }
                MoveDynamicObject(portanavio2, -1383, 1494.1, 4.6,2);
                SetTimer("fecharnavio2", 35000, false);
                MoveDynamicObject(PortaCofre[10], -1434.342285, 1480.052612, 1.317187, 0.011, 0.0, 0.0, 539.498352);
            }
        }
        foreach(new i: Player)
        {
            if(IsPlayerInRangeOfPoint(i, 7, X, Y, Z))
            {
                if(!IsACop(i))
                {
                    StopSoundInRange(20.0, X, Y, Z);
                    new DinheiroRoubo = VarInfoRoubo[LocalRoubo][1] + random(10000);
                    GivePlayerMoneyEx(i, DinheiroRoubo);
                    SetPlayerCriminal(i,255, "Roubo ao Cofre");
                    format(gstring, sizeof(gstring), "Voce e os %s roubaram R$[%s] do cofre e Ganhou [1] de respeito +1 ponto de titulo ladrao profissional.",NomeORG(playerid), ConvertMoney(DinheiroRoubo));
                    SendClientMessage(i, COR_AMARELO, gstring);
                    SendClientMessage(i, COR_AMARELO, "Sobrou alguns malotes de dinheiro e respeito no chao, pegue-o!");
                    PlayerInfo[i][pExp] += 1;
                    PlayerInfo[i][pLadrao] ++;
                    RemovePlayerAttachedObject(i,9);
                    CreateDroppedItem(19941, 1, X-random(1), Y+random(1), Z);
                    format(stringZCMD, sizeof stringZCMD, "{ffffff}Voce e os %s conseguiram concluir o roubo.\n\n{df5454}Voce recebeu:\n {ffffff}* R${228B22}%s\n{ffffff} * {df5454}+1 {aaacae}de Respeito.\n{ffffff} * {df5454}+1 {aaacae}Ponto de Ladrao Profissional (titulos) {ffffff}(%d/60).\n\n{FF6347}OBS: {ffffff}Alguns malotes de grana e respeito ficaram jogado no chao (Pressione F ou Enter para pegar)!", NomeORG(playerid), ConvertMoney(DinheiroRoubo), PlayerInfo[playerid][pLadrao]);
                    ShowPlayerDialog(i, 999, DIALOG_STYLE_MSGBOX, " ", stringZCMD, "Fechar", "");
                    for(new C = 0; C < random(3); C++){
                        CreateDroppedItem(1212,  random(3000), X-random(1), Y+random(1), Z);
                    }
                }
            }
        }
        return 1;
    }
    if(!IsPlayerInRangeOfPoint(playerid, 8, X, Y, Z))
    {

        format(stringZCMD, sizeof(stringZCMD), "[Roubo] {ffffff}%s(%d) E os %s nao conseguiram roubar o cofre %s.",PlayerName(playerid), playerid, NomeORG(playerid),getNameLocalRoubo(LocalDeRoubo[playerid]));
        SendClientMessageToAll(GetPlayerColor(playerid), stringZCMD);
        StopPlayerHoldingObject(playerid);
        KillTimer(TimerRoubando[playerid]);
        Roubando[playerid] = 0;
        return 1;
    }
/*    if(EstaAFK[playerid] == 1)
    {
        format(stringZCMD, sizeof(stringZCMD), "[Roubo] {ffffff}%s(%d) nao conseguiu roubar o cofre %s.",PlayerName(playerid), playerid, getNameLocalRoubo(LocalDeRoubo[playerid]));
        SendClientMessageToAll(GetPlayerColor(playerid), stringZCMD);
        TogglePlayerControllable(playerid, 1);
        StopPlayerHoldingObject(playerid);
        ClearAnimations(playerid);
        KillTimer(TimerRoubando[playerid]);
        Roubando[playerid] = 0;
        SendClientMessage(playerid, COR_LIGHTRED, "Voce perdeu -R$5.000 por roubar de ESC!");
        GivePlayerMoneyEx(playerid, -1000);
        return 1;
    }*/
    if(!IsPlayerConnected(playerid)){
        format(stringZCMD, sizeof(stringZCMD), "[Roubo] {ffffff}%s(%d) E os %s nao conseguiram roubar o cofre %s.",PlayerName(playerid), playerid, NomeORG(playerid),getNameLocalRoubo(LocalDeRoubo[playerid]));
        SendClientMessageToAll(GetPlayerColor(playerid), stringZCMD);
        KillTimer(TimerRoubando[playerid]);
        Roubando[playerid] = 0;
        return 1;
    }
    TempoRoubo_[playerid]--;
    return 1;
}
START::ContagemInvasaoo(playerid)
{
    new string[70];
    format(string, sizeof(string), "~w~Tempo Para Invasao:~n~~r~%d Segundos...", Contagem[playerid]);
    GameTextForPlayer(playerid, string, 1500, 3);
    if(Contagem[playerid] == 0)
    {
        KillTimer(TempoContagem[playerid]);

    }
    Contagem[playerid]--;
}
START::KickTime(p)
{
   #undef Kick
   Kick(p);
   #define Kick(%0) SetTimerEx("KickTime", 100, false, "i", %0)
   return 1;
}
START::BanTime(p)
{
   #undef Ban
   Ban(p);
   #define Ban(%0) SetTimerEx("BanTime", 100, false, "i", %0)
   return 1;
}
START::VidaEvento(playerid)
{
    new Float:health;
    GetPlayerHealth(playerid, health);
    if(NaPorraDoEvento[playerid] == true)
    {
        GetPlayerHealth(playerid, health);
        SetPlayerHealth(playerid, health - 2.0);
        SendClientMessage(playerid, COR_LIGHTBLUE, "Se passaram mais 30 segundos de evento, Voce perdeu 2 de vida !");
    }
    else
    {
        KillTimer(TempoVida[playerid]);
    }
}
START::IniciarEvento(playerid)
{
     if(iniciarrally[playerid] != 0 && iniciartrilha[playerid] != 0 && iniciarcross[playerid] != 0 && iniciarbarco[playerid] != 0 && iniciarkart[playerid] != 0 && iniciartrato[playerid] != 0 && corridamaluca[playerid] != 0 || NaPorraDoEvento[playerid] != false)
     {
          TogglePlayerControllable(playerid, 1);
          PlayerPlaySound(playerid, 1057, 0.0, 0.0, 0.0);
          GameTextForPlayer(playerid,"~w~evento iniciado~n~~r~siga os checkpoints!", 5000, 1);
          KillTimer(tempoiniciar[playerid]);
     }
     return 1;
}
START::PrestesExplodir(playerid)
{
    if(GetPVarInt(playerid,"Explodir") == 1)
    {
        GetPlayerPos(playerid, Ax, Bx, Cx);
        foreach(new i: Player)
        {
            if(IsPlayerInRangeOfPoint(i,8.0,Ax,Bx,Cx))
            {
                SetPlayerHealth(i,0);
                PlayerPlaySound(i, 1057, Ax, Bx, Cx);
            }
        }
        new Nick[MAX_PLAYER_NAME];
        new string[128];
        GetPlayerName(playerid, Nick, sizeof(Nick));
        CreateExplosion(Ax, Bx, Cx, 6, 50.0);
        StopPlayerHoldingObject(playerid);
        SetPVarInt(playerid, "Explodir", 0);
        printf("[Terrorista] Usou Homem Bomba");
        format(string, sizeof(string), "Terrorista: %s se explodiu !", Nick);
        SendClientMessageToAll(GetPlayerColor(playerid), string);
    }
    return 1;
}
