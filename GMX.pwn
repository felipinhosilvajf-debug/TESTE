START::TempoTut(playerid)
{
    PulaTuto[playerid] = 0;
    KillTimer(tempotutorial[playerid]);
}
START::hideBalao(playerid)
{
    if(tempobalao[playerid] != -1)
    {
        tempobalao[playerid] = -1;
    }
    return PlayerTextDrawHide(playerid, balaoAviso[playerid]);
}

START::hideAlerta(playerid)
{
    PlayerTextDrawHide(playerid, balaoAvisoRP[playerid][0]);
    PlayerTextDrawHide(playerid, balaoAvisoRP[playerid][1]);
    PlayerTextDrawHide(playerid, balaoAvisoRP[playerid][2]);
    return 1;
}


START::hideConq(playerid)
{
    if(tempoconq[playerid] != -1)
    {
        tempoconq[playerid] = -1;
    }
    TextDrawHideForPlayer(playerid, Conquistas[0]);
    TextDrawHideForPlayer(playerid, Conquistas[1]);
    TextDrawHideForPlayer(playerid, Conquistas[2]);
    TextDrawHideForPlayer(playerid, Conquistas[3]);
    TextDrawHideForPlayer(playerid, Conquistas[4]);
    TextDrawHideForPlayer(playerid, Conquistas[5]);
    return 1;
}
BalaoTuto(playerid, avisobalao[]){
    if(tempobalao[playerid] != -1){
        KillTimer(tempobalao[playerid]);
    }
    PlayerTextDrawSetString(playerid, TutoAviso[playerid], avisobalao);
    PlayerTextDrawShow(playerid, TutoAviso[playerid]);
}
BalaoIntro(playerid, tempo){
    if(tempobalao[playerid] != -1){
        KillTimer(tempobalao[playerid]);
    }
    tempobalao[playerid] = SetTimerEx("UpdateBalaoIntro", tempo, 0, "i", playerid);
}
START::UpdateBalaoIntro(playerid)
{
    if(tempobalao[playerid] != -1)
    {
        tempobalao[playerid] = -1;
    }
    IntroTuto[playerid]++;
    if(IntroTuto[playerid] == 10)
    {
        IntroTuto[playerid] = 0;
        return SIntro(playerid, IntroTuto[playerid]);
    }
    return SIntro(playerid, IntroTuto[playerid]);
}
START::LoadObjects(playerid)
{
    TogglePlayerControllable(playerid, 0);
    SetTimerEx("LoadOb", 2000, 0, "d", playerid);
}
START::LoadOb(playerid)
{
    TogglePlayerControllable(playerid, 1);
}
START::PlayerUpdateCamrea(playerid)
{
      if(!CameraInfo[air]) return RemovePlayer(playerid);
      GetPlayerPos(CameraInfo[cameraman],CameraInfo[campostion][0],CameraInfo[campostion][1],CameraInfo[campostion][2]);
      GetPlayerFacingAngle(CameraInfo[cameraman], CameraInfo[campostion][3]);
      SetPlayerChatBubble(playerid, "Assistindo TV", 0xFFFF33FF, 50.0, 5000);
      if(CameraInfo[campostion][3] > 0  && CameraInfo[campostion][3] <= 45)
      {
        SetPlayerCameraPos(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1],CameraInfo[campostion][2]+1);
        SetPlayerCameraLookAt(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1]+20.0,CameraInfo[campostion][2]+1);
      }
      if(CameraInfo[campostion][3] > 45 && CameraInfo[campostion][3] <= 135)
      {
        SetPlayerCameraPos(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1],CameraInfo[campostion][2]+1);
        SetPlayerCameraLookAt(playerid,CameraInfo[campostion][0]-20.0,CameraInfo[campostion][1],CameraInfo[campostion][2]+1);
      }
      if(CameraInfo[campostion][3] > 135 && CameraInfo[campostion][3] <= 225)
      {
        SetPlayerCameraPos(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1],CameraInfo[campostion][2]+1);
        SetPlayerCameraLookAt(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1]-20.0,CameraInfo[campostion][2]+1);
      }
      if(CameraInfo[campostion][3] > 225  && CameraInfo[campostion][3] < 315)
      {
        SetPlayerCameraPos(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1],CameraInfo[campostion][2]+1);
        SetPlayerCameraLookAt(playerid,CameraInfo[campostion][0]+20.0,CameraInfo[campostion][1],CameraInfo[campostion][2]+1);
      }
      if(CameraInfo[campostion][3] > 315  && CameraInfo[campostion][3] <= 360)
      {
        SetPlayerCameraPos(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1],CameraInfo[campostion][2]+1);
        SetPlayerCameraLookAt(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1]+20.0,CameraInfo[campostion][2]+1);
      }
      if ( IsPlayerInAnyVehicle ( CameraInfo[cameraman] ) )
      {
        TogglePlayerSpectating(playerid, 1);
        new vehicleid = GetPlayerVehicleID(CameraInfo[cameraman]);
        PlayerSpectateVehicle(playerid, vehicleid, SPECTATE_MODE_SIDE);
      }
      return true;
}
Assistindo(playerid)
{
    new string[255];
    if(player_viewer[playerid]) return SendClientMessage(playerid,COR_VERMELHO,"para parar de assistir use: /desligartv");
    if(!CameraInfo[air]) return SendClientMessage(playerid,COR_VERMELHO,"A Tv esta fora do Ar!");
    CPU[playerid] = SetTimerEx("PlayerUpdateCamrea",50,true,"d",playerid);
    SetPlayerCameraPos(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1],CameraInfo[campostion][2]+1);
    SetPlayerCameraLookAt(playerid,CameraInfo[campostion][0],CameraInfo[campostion][1]+20.0,CameraInfo[campostion][2]+1);
    player_viewer[playerid] = true;
    CameraInfo[audience]++;
    format(string, sizeof(string), "Audiencia de Pessoas Assistindo Televisao: %d", CameraInfo[audience]);
    SendClientMessage(CameraInfo[cameraman], COR_LIGHTGREEN, string);
    return true;
}
RemovePlayer(playerid)
{
  if(player_viewer[playerid] == true)
  {
      new string[255];
      TogglePlayerSpectating(playerid, 0);
      SetCameraBehindPlayer(playerid);
      CameraInfo[audience]--;
      format(string, sizeof(string), "Audiencia de Pessoas Assistindo Televisao: %d", CameraInfo[audience]);
      SendClientMessage(CameraInfo[cameraman], COR_LIGHTGREEN, string);
      player_viewer[playerid] = false;
      KillTimer(CPU[playerid]);
  }
  return true;
}
OnAir(playerid,camera)
{
    if(camera == 1)
    {
        CameraInfo[cameraman] = playerid;
        CameraInfo[air] = true;
    }
    else if(camera == 0)
    {
        if(CameraInfo[cameraman] == playerid)
        {
            new string[128];
            CameraInfo[cameraman] = INVALID_PLAYER_ID;
            format(string, sizeof(string), "Reporter %s: deixou de ser o Camera-Man.", PlayerName(playerid));
            SendFamilyMessage(9, COR_REP, string);
            OffAir();
        }
        if(CameraInfo[cameraman] != playerid)
        {
            new string[128];
            CameraInfo[cameraman] = playerid;
            format(string, sizeof(string), "Reporter %s: Virou o Camera-Man.", PlayerName(playerid));
            SendFamilyMessage(9, COR_REP, string);
        }
    }
    return true;
}
OffAir()
{
    KillTimer(CameraInfo[tup]);
    CameraInfo[air] = false;
    SendClientMessage(CameraInfo[cameraman], COR_LIGHTRED,"Voce Desativou a Camera!");
    for(new i = 0; i < GetMaxPlayers(); i++) RemovePlayer(i);
    return true;
}
START::TempoSalario(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        if(PlayerInfo[playerid][pMinutos] == 0)
        {
            if(PlayerInfo[playerid][pSegundos] == 0)
            {
                GameTextForPlayer(playerid, "~r~PayDay ~n~~y~ Salario", 5000,6);
                PayDay(playerid);
            }
        }
        if(PlayerInfo[playerid][pSegundos] < 0)
        {
            if(PlayerInfo[playerid][pMinutos] == 0)
            PlayerInfo[playerid][pMinutos] = 30;
            PlayerInfo[playerid][pSegundos] = 59;
            PlayerInfo[playerid][pMinutos]--;
        }
        new strpayday[5000];
        format(strpayday,sizeof(strpayday),"%02d:%02d", PlayerInfo[playerid][pMinutos], PlayerInfo[playerid][pSegundos]);
        PlayerTextDrawSetString(playerid, ContagemPayday[playerid][0], strpayday);
        PlayerTextDrawShow(playerid, ContagemPayday[playerid][0]);
        PlayerInfo[playerid][pSegundos]--;
    }
    return 1;
}
START::SaveAtividadeAdmin()
{
    new lol = 0;
    new string[150];
    getdate(Ano,Mes,Dia);
    gettime(Hora,Minuto);
    while(lol < sizeof(AdmInfo))
    {
       if(lol == 0)
       {
            if(strcmp(AdmInfo[lol][AdminNick],"Vazio",true) != 0)
            {
                new Query[64+MAX_PLAYER_NAME], result[10];
                //new DBResult:Resultado; //mysql_escape_string(AdmInfo[lol][AdminNick], DB_Escape(nome));
                format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(AdmInfo[lol][AdminNick]));
                Resultado = db_query(Conexao,Query);
                //mysql_store_result();
                new Atividade;
                db_get_field_assoc(Resultado, "AtividadeAdmin", result, sizeof(result));
                Atividade = strval(result);
                if(Atividade >= 0)
                {
                    //== [ Meia Noite Salvar e resetar a atividade do dia ] ==//
                    if(Hora == 23 && Minuto == 59)
                    {
                        format(string, sizeof(string), "[Controle Semanal] Admin: %s logou [%d] hora nesta semana, Data: [%02d/%02d/%02d].",AdmInfo[lol][AdminNick],Atividade,Dia,Mes,Ano);
                        AtividadeAdminLog(string);
                        //new DBResult:Resultado; //mysql_escape_string(AdmInfo[lol][AdminNick], DB_Escape(AdmInfo[lol][AdminNick]));
                        format(Query, sizeof(Query), "UPDATE `contas` SET `AtividadeAdmin` = '0' WHERE `Nome` = '%s'", DB_Escape(AdmInfo[lol][AdminNick]));
                        Resultado = db_query(Conexao,Query);
                        //mysql_store_result();
                        foreach(new i: Player)
                        {
                            PlayerInfo[i][pAtividadeAdmin] = 0;
                        }
                    }
                }
            }
       }
       else
       {
            if(strcmp(AdmInfo[lol][AdminNick],"Vazio",true) != 0)
            {
                new Query[64+MAX_PLAYER_NAME], result[10];
                //new DBResult:Resultado; //mysql_escape_string(AdmInfo[lol][AdminNick], DB_Escape(AdmInfo[lol][AdminNick]));
                format(Query, sizeof(Query), "SELECT * FROM `contas` WHERE `Nome` = '%s'", DB_Escape(AdmInfo[lol][AdminNick]));
                Resultado = db_query(Conexao,Query);
                //mysql_store_result();
                new Atividade;
                db_get_field_assoc(Resultado, "AtividadeAdmin", result, sizeof(result));
                Atividade = strval(result);
                if(Atividade >= 0)
                {
                    //== [ Meia Noite Salvar e resetar a atividade do dia ] ==//
                    if(Hora == 23 && Minuto == 59)
                    {
                        foreach(new i: Player) //resetar atividade online
                        {
                            PlayerInfo[i][pAtividadeAdmin] = 0;
                        }
                        format(string, sizeof(string), "[Controle Semanal] Admin: %s logou [%d] hora nesta semana, Data: [%02d/%02d/%02d].",AdmInfo[lol][AdminNick],Atividade,Dia,Mes,Ano);
                        AtividadeAdminLog(string);
                        //new DBResult:Resultado; //mysql_escape_string(AdmInfo[lol][AdminNick], DB_Escape(AdmInfo[lol][AdminNick]));
                        format(Query, sizeof(Query), "UPDATE `contas` SET `AtividadeAdmin` = '0' WHERE `Nome` = '%s'", DB_Escape(AdmInfo[lol][AdminNick]));
                        Resultado = db_query(Conexao,Query);
                        //mysql_store_result();
                    }

                }
            }
       }
       lol++;
    }
    DOF2_SaveFile();
    return 1;
}
START::Climas()
{
     new pc = random(12);
     new occ = random(5000);
     PCE += occ;
     PDU += occ;
     DepositarOrgGrana(9,occ);
     if(pc == 0) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA1); SetWeather(0); print(TXT_CLIMA1); print(TXT_ALTERADO);}
     if(pc == 1) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA2); SetWeather(1); print(TXT_CLIMA2); print(TXT_ALTERADO);}
     if(pc == 2) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA3); SetWeather(3); print(TXT_CLIMA3); print(TXT_ALTERADO);}
     if(pc == 3) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA4); SetWeather(7); print(TXT_CLIMA4); print(TXT_ALTERADO);}
     if(pc == 4) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA5); SetWeather(8); print(TXT_CLIMA5); print(TXT_ALTERADO);}
     if(pc == 5) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA6); SetWeather(9); print(TXT_CLIMA6); print(TXT_ALTERADO);}
     if(pc == 6) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA7); SetWeather(11); print(TXT_CLIMA7); print(TXT_ALTERADO);}
     if(pc == 7) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA8); SetWeather(12); print(TXT_CLIMA8); print(TXT_ALTERADO);}
     if(pc == 8) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA9); SetWeather(13); print(TXT_CLIMA9); print(TXT_ALTERADO);}
     if(pc == 9) { SendClientMessageToAll(COR_TITULO, TXT_CLIMA10); SetWeather(15);print(TXT_CLIMA10); print(TXT_ALTERADO);}
     if(pc == 10){ SendClientMessageToAll(COR_TITULO, TXT_CLIMA11); SetWeather(16);print(TXT_CLIMA11); print(TXT_ALTERADO);}
     if(pc == 11){ SendClientMessageToAll(COR_TITULO, TXT_CLIMA12); SetWeather(17);print(TXT_CLIMA12); print(TXT_ALTERADO);}
     if(pc == 12){ SendClientMessageToAll(COR_TITULO, TXT_CLIMA13); SetWeather(19);print(TXT_CLIMA13); print(TXT_ALTERADO);}
}
START::AtivarAir()
{
    posair = 1 + random(4);
    if(posair == 1)
    {
        //Criar e Mover Airdrop
        airdrop = CreateDynamicObject(18849, 306.47028, 2026.83362, 92.34710,   0.00000, 0.00000, 0.00000);
        MoveObject(airdrop, 306.47028, 2026.83362, 23.92002, 3.0);
    }
    else if(posair == 2)
    {
        //Criar e Mover Airdrop
        airdrop = CreateDynamicObject(18849, -2314.9658,200.6077,71.2814,   0.00000, 0.00000, 0.00000);
        MoveObject(airdrop, -2314.965820, 200.607696, 41.684818, 3.0);
    }
    else if(posair == 3)
    {
        //Criar e Mover Airdrop
        airdrop = CreateDynamicObject(18849, 2321.6760,9.3967,68.5022,   0.00000, 0.00000, 0.00000);
        MoveObject(airdrop, 2321.020507, 9.931199, 33.030345, 3.0);
    }
    else if(posair == 4)
    {
        //Criar e Mover Airdrop
        airdrop = CreateDynamicObject(18849, -224.3769,1072.6846,63.2626,   0.00000, 0.00000, 0.00000);
        MoveObject(airdrop, -224.376907, 1072.684570, 26.363143, 3.0);
    }
    else if(posair == 5)
    {
        //Criar e Mover Airdrop
        airdrop = CreateDynamicObject(18849, 1551.5029,-2539.9927,77.6908,   0.00000, 0.00000, 0.00000);
        MoveObject(airdrop, 1551.447875, -2540.414062, 22.216409, 3.0);
    }
    //Enviar Mensagem Que o Airdrop Foi Solto
    SendClientMessageToAll(COR_CV, "[Moedas] Uma Maleta De Moedas foi jogada em algum lugar de San Andreas, ela foi marcada em seu mapa !");
    printf(" ");
    new hora, minuto, segundo; gettime(hora,minuto,segundo);
    printf("> [AIRDROP]: O Airdrop Foi Jogado Na Area 51: Horas: [%i/%i/%i]", hora, minuto, segundo);
    foreach(new i: Player)
    {
        if(posair == 1)
        {
            //Setar Checkpoint Para o Jogador
            SetPlayerCheckpoint(i, 306.47028, 2026.83362, 92.34710, 5);
        }
        else if(posair == 2)
        {
            //Setar Checkpoint Para o Jogador
            SetPlayerCheckpoint(i, -2314.9658,200.6077,35.3341, 5);
        }
        else if(posair == 3)
        {
            //Setar Checkpoint Para o Jogador
            SetPlayerCheckpoint(i, 2321.6760,9.3967,26.5065, 5);
        }
        else if(posair == 4)
        {
            //Setar Checkpoint Para o Jogador
            SetPlayerCheckpoint(i, -224.3769,1072.6846,19.7673, 5);
        }
        else if(posair == 5)
        {
            //Setar Checkpoint Para o Jogador
            SetPlayerCheckpoint(i, 1551.5029,-2539.9927,13.5690, 5);
        }
    }
    return 1;
}
START::SumirCarrosVip()
{
    for(new car; car != MAX_VEHICLES; ++car)
    {
        new Float:Distancia = GetVehicleDistanceFromPoint(car, 1.5343,-0.8107,3.1172); // Essa Funcao e a Mais Importante, Veja Sobre ela no final do code.
        if(Distancia <= 20)
        {
            foreach(new viado: Player)
            {
                if(!IsPlayerInVehicle(viado, car))
                {
                    SetVehicleVirtualWorld(car, 1);
                }
            }
        }
    }
}
