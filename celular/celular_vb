    PlayerTextDrawHide(playerid, dummy);

    NubankSaldoTD[playerid] = CreatePlayerTextDraw(playerid, 578.0, 188.0, "R$ 0");
    PlayerTextDrawLetterSize(playerid, NubankSaldoTD[playerid], 0.24, 1.25);
    PlayerTextDrawAlignment(playerid, NubankSaldoTD[playerid], 2);
    PlayerTextDrawColor(playerid, NubankSaldoTD[playerid], 0x2ECC71FF);
    PlayerTextDrawFont(playerid, NubankSaldoTD[playerid], 2);
    PlayerTextDrawSetProportional(playerid, NubankSaldoTD[playerid], 1);
    PlayerTextDrawSetShadow(playerid, NubankSaldoTD[playerid], 0);
