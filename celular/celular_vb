    CnhDadosTD[playerid] = CreatePlayerTextDraw(playerid, 525.0, 159.0, "_");
    PlayerTextDrawLetterSize(playerid, CnhDadosTD[playerid], 0.125, 0.85);
    PlayerTextDrawColor(playerid, CnhDadosTD[playerid], 0xFFFFFFFF);
    PlayerTextDrawFont(playerid, CnhDadosTD[playerid], 2);
