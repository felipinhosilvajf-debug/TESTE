    PlayerTextDrawSetShadow(playerid, CnhDadosTD[playerid], 0);
    PlayerTextDrawHide(playerid, CnhDadosTD[playerid]);

    return 1;
}
stock MostrarCelularVB(playerid)
{
    if(!CelularCriadoGlobal) CriarCelularGlobal();

    for(new i = 0; i < 7; i++) TextDrawHideForPlayer(playerid, NubankAppBG[i]);
    PlayerTextDrawHide(playerid, NubankSaldoTD[playerid]);
    NubankCelularAberto[playerid] = false;

    for(new i = 0; i < 6; i++) TextDrawShowForPlayer(playerid, CelularBG[i]);
    for(new i = 0; i < 18; i++) TextDrawShowForPlayer(playerid, CelularApp[i]);
    
    for(new i = 0; i < 6; i++) TextDrawHideForPlayer(playerid, CnhAppBG[i]);
    PlayerTextDrawHide(playerid, CnhDadosTD[playerid]);
    CnhCelularAberto[playerid] = false;

    CelularAberto[playerid] = true;
    SelectTextDraw(playerid, 0x820AD1FF);
    return 1;
}
stock AbrirAppNubankCelular(playerid, saldo)
{
    for(new i = 0; i < 18; i++) TextDrawHideForPlayer(playerid, CelularApp[i]);
    for(new i = 2; i < 6; i++) TextDrawHideForPlayer(playerid, CelularBG[i]);

    new str[32];
    format(str, sizeof(str), "R$ %d", saldo);
    PlayerTextDrawSetString(playerid, NubankSaldoTD[playerid], str);

    for(new i = 0; i < 7; i++) TextDrawShowForPlayer(playerid, NubankAppBG[i]);
    PlayerTextDrawShow(playerid, NubankSaldoTD[playerid]);

    NubankCelularAberto[playerid] = true;
    SelectTextDraw(playerid, 0x820AD1FF);
    return 1;
}
stock FecharAppNubankCelular(playerid)
{
    for(new i = 0; i < 7; i++) TextDrawHideForPlayer(playerid, NubankAppBG[i]);
    PlayerTextDrawHide(playerid, NubankSaldoTD[playerid]);
    NubankCelularAberto[playerid] = false;

    for(new i = 2; i < 6; i++) TextDrawShowForPlayer(playerid, CelularBG[i]);
    for(new i = 0; i < 18; i++) TextDrawShowForPlayer(playerid, CelularApp[i]);
    return 1;
}
stock AbrirAppCNHCelular(playerid, car, moto, cam, fly, boat, gun, vCar, vMoto, vCam, vFly, vBoat)
{
    for(new i = 0; i < 18; i++) TextDrawHideForPlayer(playerid, CelularApp[i]);
    for(new i = 2; i < 6; i++) TextDrawHideForPlayer(playerid, CelularBG[i]);

    new str[256];
    format(str, sizeof(str),
        "Carro (B): %s ~w~(%d)~n~Moto (A): %s ~w~(%d)~n~Cam/Onibus: %s ~w~(%d)~n~Aerea: %s ~w~(%d)~n~Nautica: %s ~w~(%d)~n~Armas: %s",
        (car == 1)  ? ("~g~OK") : ("~r~NAO"), vCar,
        (moto == 1) ? ("~g~OK") : ("~r~NAO"), vMoto,
        (cam == 1)  ? ("~g~OK") : ("~r~NAO"), vCam,
        (fly == 1)  ? ("~g~OK") : ("~r~NAO"), vFly,
        (boat == 1) ? ("~g~OK") : ("~r~NAO"), vBoat,
        (gun == 1)  ? ("~g~OK") : ("~r~NAO")
    );
    PlayerTextDrawSetString(playerid, CnhDadosTD[playerid], str);

    for(new i = 0; i < 6; i++) TextDrawShowForPlayer(playerid, CnhAppBG[i]);
    PlayerTextDrawShow(playerid, CnhDadosTD[playerid]);

    CnhCelularAberto[playerid] = true;
    SelectTextDraw(playerid, 0x00B4D8FF);
    return 1;
}

stock FecharAppCNHCelular(playerid)
{
    for(new i = 0; i < 6; i++) TextDrawHideForPlayer(playerid, CnhAppBG[i]);
    PlayerTextDrawHide(playerid, CnhDadosTD[playerid]);
    CnhCelularAberto[playerid] = false;

    for(new i = 2; i < 6; i++) TextDrawShowForPlayer(playerid, CelularBG[i]);
    for(new i = 0; i < 18; i++) TextDrawShowForPlayer(playerid, CelularApp[i]);
    return 1;
}

stock EsconderCelularVB(playerid)
{
    if(!CelularAberto[playerid]) return 1;
    CelularAberto[playerid] = false;
    NubankCelularAberto[playerid] = false;
    
    for(new i = 0; i < 6; i++) TextDrawHideForPlayer(playerid, CnhAppBG[i]);
    PlayerTextDrawHide(playerid, CnhDadosTD[playerid]);
    CnhCelularAberto[playerid] = false;

    CancelSelectTextDraw(playerid);
    for(new i = 0; i < 6; i++) TextDrawHideForPlayer(playerid, CelularBG[i]);
    for(new i = 0; i < 18; i++) TextDrawHideForPlayer(playerid, CelularApp[i]);
    for(new i = 0; i < 7; i++) TextDrawHideForPlayer(playerid, NubankAppBG[i]);
    PlayerTextDrawHide(playerid, NubankSaldoTD[playerid]);
    return 1;
}

stock ExecutarComandoCelular(playerid, const comando[])
{
    EsconderCelularVB(playerid);
    CallRemoteFunction("OnPlayerCommandText", "is", playerid, comando);
    return 1;
}
stock AcionarAppCelular(playerid, appid)
{
    switch(appid)
    {
        case 0: return ExecutarComandoCelular(playerid, "/ajuda");
        case 1: return ExecutarComandoCelular(playerid, "/rg");
        case 2: return ExecutarComandoCelular(playerid, "/gps");
        case 3: return ExecutarComandoCelular(playerid, "/configuracoes");
        case 4:
        {
            CallRemoteFunction("SolicitarCNHCelular", "i", playerid);
            return 1;
        }
        case 5: return ExecutarComandoCelular(playerid, "/orgs");
        case 6: return ExecutarComandoCelular(playerid, "/veiculo ajuda");
        case 7: return ExecutarComandoCelular(playerid, "/servico taxi");
        case 8: return ExecutarComandoCelular(playerid, "/servico onibus");
        case 9: return ExecutarComandoCelular(playerid, "/servico pizza");
        case 10: return ExecutarComandoCelular(playerid, "/servico medico");
        case 11: return ExecutarComandoCelular(playerid, "/servicos");
        case 12: return ExecutarComandoCelular(playerid, "/servico advogado");
        case 13: return ExecutarComandoCelular(playerid, "/servico mecanico");
        case 14:
        {
            EsconderCelularVB(playerid);
            ShowPlayerDialog(playerid, DIALOG_CELULAR_LIGAR, DIALOG_STYLE_INPUT,
                "VIRTUAL PHONE - LIGAR",
                "Digite o numero de telefone que deseja chamar:",
                "LIGAR", "VOLTAR");
            return 1;
        }
        case 15: return ExecutarComandoCelular(playerid, "/sms");
        case 16: // NUBANK (solicita o saldo ao GameMode e abre dentro do celular)
        {
            CallRemoteFunction("SolicitarSaldoNubankCelular", "i", playerid);
            return 1;
        }
        case 17:
        {
            EsconderCelularVB(playerid);
            return 1;
        }
    }
    return 0;
}

public OnFilterScriptInit()
{
    CriarCelularGlobal();
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        CelularAberto[i] = false;
        NubankCelularAberto[i] = false;
        if(IsPlayerConnected(i)) CriarPlayerTD_NubankCelular(i);
    }
    print("[VirtualBoost] VIRTUAL PHONE carregado.");
    return 1;
}

public OnFilterScriptExit()
{
    if(CelularCriadoGlobal)
    {
        for(new i = 0; i < 6; i++) TextDrawDestroy(CelularBG[i]);
        for(new i = 0; i < 18; i++) TextDrawDestroy(CelularApp[i]);
        for(new i = 0; i < 7; i++) TextDrawDestroy(NubankAppBG[i]);
        CelularCriadoGlobal = false;
    }
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i)) PlayerTextDrawDestroy(i, NubankSaldoTD[i]);
    }
    return 1;
}

public OnPlayerConnect(playerid)
{
    CelularAberto[playerid] = false;
    NubankCelularAberto[playerid] = false;
    CriarPlayerTD_NubankCelular(playerid);
    return 1;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
    if(!strcmp(cmdtext, "/celular", true))
    {
        if(CelularAberto[playerid]) EsconderCelularVB(playerid);
        else MostrarCelularVB(playerid);
        return 1;
    }
    return 0;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(!CelularAberto[playerid]) return 0;

    if(clickedid == Text:INVALID_TEXT_DRAW)
    {
        EsconderCelularVB(playerid);
        return 1;
    }

    if(NubankCelularAberto[playerid])
    {
        if(clickedid == NubankAppBG[5]) // TRANSFERIR
        {
            EsconderCelularVB(playerid);
            CallRemoteFunction("AbrirTransferenciaNubankCelular", "i", playerid);
            return 1;
        }
        if(clickedid == NubankAppBG[6]) // FECHAR APP (volta para os icones do celular)
        {
            FecharAppNubankCelular(playerid);
            return 1;
        }
        return 1;
    }
    if(CnhCelularAberto[playerid])
    {
        if(clickedid == CnhAppBG[5])
        {
            FecharAppCNHCelular(playerid);
            return 1;
        }
        return 1;
    }

    for(new i = 0; i < 18; i++)
    {
        if(clickedid == CelularApp[i]) return AcionarAppCelular(playerid, i);
    }
    return 0;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == DIALOG_CELULAR_LIGAR)
    {
        if(!response) return 1;
        new numero = strval(inputtext);
        if(strlen(inputtext) < 1 || numero <= 0)
        {
            SendClientMessage(playerid, 0xE74C3CFF, "[VIRTUAL PHONE] Numero invalido.");
            return 1;
        }
        new comando[32];
        format(comando, sizeof(comando), "/ligar %d", numero);
        CallRemoteFunction("OnPlayerCommandText", "is", playerid, comando);
        return 1;
    }
    return 0;
}

