stock AtualizarPosicaoCelular(playerid)
{
    // SA-MP antigo nao possui PlayerTextDrawSetPos: recria os elementos na nova coordenada.
    for(new i = 0; i < 12; i++)
        PlayerTextDrawDestroy(playerid, CelularBG[playerid][i]);
    PlayerTextDrawDestroy(playerid, CelularTitulo[playerid]);
    PlayerTextDrawDestroy(playerid, CelularAjuda[playerid]);
    PlayerTextDrawDestroy(playerid, CelularFechar[playerid]);
    PlayerTextDrawDestroy(playerid, CelularRG[playerid]);
    PlayerTextDrawDestroy(playerid, CelularGPS[playerid]);
    PlayerTextDrawDestroy(playerid, CelularConfig[playerid]);
    PlayerTextDrawDestroy(playerid, CelularLicencas[playerid]);
    PlayerTextDrawDestroy(playerid, CelularSetaCima[playerid]);
    PlayerTextDrawDestroy(playerid, CelularSetaBaixo[playerid]);
    PlayerTextDrawDestroy(playerid, CelularSetaEsquerda[playerid]);
    PlayerTextDrawDestroy(playerid, CelularSetaDireita[playerid]);
    PlayerTextDrawDestroy(playerid, CelularMoverInfo[playerid]);
    if(CelularImagemCriada[playerid])
    {
        PlayerTextDrawDestroy(playerid, CelularImagem[playerid]);
        CelularImagemCriada[playerid] = false;
    }

    CriarCelularTextDraws(playerid);
    CriarImagemCelular(playerid);
    PlayerTextDrawShow(playerid, CelularImagem[playerid]);

    for(new i = 0; i < 12; i++)
        PlayerTextDrawShow(playerid, CelularBG[playerid][i]);
    PlayerTextDrawShow(playerid, CelularTitulo[playerid]);
    PlayerTextDrawShow(playerid, CelularAjuda[playerid]);
    PlayerTextDrawShow(playerid, CelularFechar[playerid]);
    PlayerTextDrawShow(playerid, CelularRG[playerid]);
    PlayerTextDrawShow(playerid, CelularGPS[playerid]);
    PlayerTextDrawShow(playerid, CelularConfig[playerid]);
    PlayerTextDrawShow(playerid, CelularLicencas[playerid]);

    if(CelularModoMover[playerid]) MostrarControlesMover(playerid);
    return 1;
}

stock MostrarControlesMover(playerid)
{
    PlayerTextDrawShow(playerid, CelularSetaCima[playerid]);
    PlayerTextDrawShow(playerid, CelularSetaBaixo[playerid]);
    PlayerTextDrawShow(playerid, CelularSetaEsquerda[playerid]);
    PlayerTextDrawShow(playerid, CelularSetaDireita[playerid]);
    PlayerTextDrawShow(playerid, CelularMoverInfo[playerid]);
    return 1;
}
stock EsconderControlesMover(playerid)
{
    PlayerTextDrawHide(playerid, CelularSetaCima[playerid]);
    PlayerTextDrawHide(playerid, CelularSetaBaixo[playerid]);
    PlayerTextDrawHide(playerid, CelularSetaEsquerda[playerid]);
    PlayerTextDrawHide(playerid, CelularSetaDireita[playerid]);
    PlayerTextDrawHide(playerid, CelularMoverInfo[playerid]);
    return 1;
}
stock MoverCelular(playerid, Float:dx, Float:dy)
{
    CelularOffsetX[playerid] += dx;
    CelularOffsetY[playerid] += dy;
    if(CelularOffsetX[playerid] < -500.0) CelularOffsetX[playerid] = -500.0;
    if(CelularOffsetX[playerid] > 25.0) CelularOffsetX[playerid] = 25.0;
    if(CelularOffsetY[playerid] < -160.0) CelularOffsetY[playerid] = -160.0;
    if(CelularOffsetY[playerid] > 100.0) CelularOffsetY[playerid] = 100.0;
    AtualizarPosicaoCelular(playerid);
    return 1;
}

stock MostrarCelularVB(playerid)
{
    // Apenas exibe os PlayerTextDraws ja criados no OnPlayerConnect.
    // Nao destrua/recrie a interface ao abrir: isso pode causar sumico/flicker.
    if(!CelularImagemCriada[playerid])
        CriarImagemCelular(playerid);


    for(new i = 0; i < 12; i++)
        PlayerTextDrawShow(playerid, CelularBG[playerid][i]);

    PlayerTextDrawShow(playerid, CelularTitulo[playerid]);
    PlayerTextDrawShow(playerid, CelularAjuda[playerid]);
    PlayerTextDrawShow(playerid, CelularFechar[playerid]);
    PlayerTextDrawShow(playerid, CelularRG[playerid]);
    PlayerTextDrawShow(playerid, CelularGPS[playerid]);
    PlayerTextDrawShow(playerid, CelularConfig[playerid]);
    PlayerTextDrawShow(playerid, CelularLicencas[playerid]);
    PlayerTextDrawShow(playerid, CelularImagem[playerid]);

    CelularAberto[playerid] = true;
    if(CelularModoMover[playerid]) MostrarControlesMover(playerid);
    SelectTextDraw(playerid, 0x00D9FFFF);
    return 1;
}

stock EsconderCelularVB(playerid)
{
    for(new i = 0; i < 12; i++)
        PlayerTextDrawHide(playerid, CelularBG[playerid][i]);

    PlayerTextDrawHide(playerid, CelularTitulo[playerid]);
    PlayerTextDrawHide(playerid, CelularAjuda[playerid]);
    PlayerTextDrawHide(playerid, CelularFechar[playerid]);
    PlayerTextDrawHide(playerid, CelularRG[playerid]);
    PlayerTextDrawHide(playerid, CelularGPS[playerid]);
    PlayerTextDrawHide(playerid, CelularConfig[playerid]);
    PlayerTextDrawHide(playerid, CelularLicencas[playerid]);

    if(CelularImagemCriada[playerid])
        PlayerTextDrawHide(playerid, CelularImagem[playerid]);

    CelularAberto[playerid] = false;
    CelularModoMover[playerid] = false;
    EsconderControlesMover(playerid);
    CancelSelectTextDraw(playerid);
    return 1;
}

stock ExecutarComandoCelular(playerid, const comando[])
{
    EsconderCelularVB(playerid);
    // Encaminha o comando para os scripts/GM que tratam OnPlayerCommandText.
    CallRemoteFunction("OnPlayerCommandText", "is", playerid, comando);
    return 1;
}

public OnFilterScriptInit()
{
    for(new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        if(IsPlayerConnected(playerid))
        {
            CelularOffsetX[playerid] = 0.0;
            CelularOffsetY[playerid] = 0.0;
            CriarCelularTextDraws(playerid);
        }
    }
    print("[VirtualBoost] Celular FilterScript carregado.");
    return 1;
}

stock DestruirCelularTextDraws(playerid)
{
    if(CelularImagemCriada[playerid])
    {
        PlayerTextDrawDestroy(playerid, CelularImagem[playerid]);
        CelularImagemCriada[playerid] = false;
    }
    for(new i = 0; i < 12; i++)
        PlayerTextDrawDestroy(playerid, CelularBG[playerid][i]);
    PlayerTextDrawDestroy(playerid, CelularTitulo[playerid]);
    PlayerTextDrawDestroy(playerid, CelularAjuda[playerid]);
    PlayerTextDrawDestroy(playerid, CelularFechar[playerid]);
    PlayerTextDrawDestroy(playerid, CelularRG[playerid]);
    PlayerTextDrawDestroy(playerid, CelularGPS[playerid]);
    PlayerTextDrawDestroy(playerid, CelularConfig[playerid]);
    PlayerTextDrawDestroy(playerid, CelularLicencas[playerid]);
    PlayerTextDrawDestroy(playerid, CelularSetaCima[playerid]);
    PlayerTextDrawDestroy(playerid, CelularSetaBaixo[playerid]);
    PlayerTextDrawDestroy(playerid, CelularSetaEsquerda[playerid]);
    PlayerTextDrawDestroy(playerid, CelularSetaDireita[playerid]);
    PlayerTextDrawDestroy(playerid, CelularMoverInfo[playerid]);
    return 1;
}

public OnFilterScriptExit()
{
    for(new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        if(IsPlayerConnected(playerid))
        {
            if(CelularAberto[playerid]) EsconderCelularVB(playerid);
            DestruirCelularTextDraws(playerid);
        }
    }
    return 1;
}
public OnPlayerConnect(playerid)
{
    CelularAberto[playerid] = false;
    CelularImagemCriada[playerid] = false;
    CelularModoMover[playerid] = false;
    CelularOffsetX[playerid] = 0.0;
    CelularOffsetY[playerid] = 0.0;
    CriarCelularTextDraws(playerid);
    return 1;
}

public OnPlayerDisconnect(playerid, reason)
{
    if(CelularAberto[playerid])
        EsconderCelularVB(playerid);

    DestruirCelularTextDraws(playerid);
    return 1;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
    if(!strcmp(cmdtext, "/vb", true))
    {
        if(CelularAberto[playerid]) EsconderCelularVB(playerid);
        else MostrarCelularVB(playerid);
        return 1;
    }
    if(!strcmp(cmdtext, "/vbmove", true))
    {
        if(!CelularAberto[playerid]) MostrarCelularVB(playerid);
        CelularModoMover[playerid] = !CelularModoMover[playerid];
        if(CelularModoMover[playerid]) MostrarControlesMover(playerid);
        else EsconderControlesMover(playerid);
        return 1;
    }
    return 0;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    if(!CelularAberto[playerid])
        return 0;

    if(playertextid == PlayerText:INVALID_TEXT_DRAW)
    {
        EsconderCelularVB(playerid);
        return 1;
    }

    if(CelularModoMover[playerid])
    {
        if(playertextid == CelularFechar[playerid]) { EsconderCelularVB(playerid); return 1; }
        if(playertextid == CelularSetaCima[playerid]) return MoverCelular(playerid, 0.0, -5.0);
        if(playertextid == CelularSetaBaixo[playerid]) return MoverCelular(playerid, 0.0, 5.0);
        if(playertextid == CelularSetaEsquerda[playerid]) return MoverCelular(playerid, -5.0, 0.0);
        if(playertextid == CelularSetaDireita[playerid]) return MoverCelular(playerid, 5.0, 0.0);
        return 1;
    }
    if(playertextid == CelularAjuda[playerid])
        return ExecutarComandoCelular(playerid, "/ajuda");

    if(playertextid == CelularRG[playerid])
        return ExecutarComandoCelular(playerid, "/rg");

    if(playertextid == CelularGPS[playerid])
        return ExecutarComandoCelular(playerid, "/gps");

    if(playertextid == CelularConfig[playerid])
        return ExecutarComandoCelular(playerid, "/config");

    if(playertextid == CelularLicencas[playerid])
        return ExecutarComandoCelular(playerid, "/licencas");

    if(playertextid == CelularFechar[playerid])
    {
        EsconderCelularVB(playerid);
        return 1;
    }
    return 0;
}
