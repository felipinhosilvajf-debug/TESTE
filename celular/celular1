stock MostrarCelularVB(playerid)
	{
	if(!CelularCriadoGlobal) CriarCelularGlobal();
	for(new i = 0; i < 11; i++) TextDrawShowForPlayer(playerid, CelularBG[i]);
	TextDrawShowForPlayer(playerid, CelularAjuda);
	TextDrawShowForPlayer(playerid, CelularFechar);
	TextDrawShowForPlayer(playerid, CelularRG);
	TextDrawShowForPlayer(playerid, CelularGPS);
	TextDrawShowForPlayer(playerid, CelularConfig);
	TextDrawShowForPlayer(playerid, CelularCNH);
	CelularAberto[playerid] = true;
	SelectTextDraw(playerid, 0x00D9FFFF);
	return 1;
	}
	stock EsconderCelularVB(playerid)
	{
	CancelSelectTextDraw(playerid);
	for(new i = 0; i < 11; i++) TextDrawHideForPlayer(playerid, CelularBG[i]);
	TextDrawHideForPlayer(playerid, CelularAjuda);
	TextDrawHideForPlayer(playerid, CelularFechar);
	TextDrawHideForPlayer(playerid, CelularRG);
	TextDrawHideForPlayer(playerid, CelularGPS);
	TextDrawHideForPlayer(playerid, CelularConfig);
	TextDrawHideForPlayer(playerid, CelularCNH);
	CelularAberto[playerid] = false;
	return 1;
	}
	stock ExecutarComandoCelular(playerid, const comando[])
	{
	EsconderCelularVB(playerid);
	CallRemoteFunction("OnPlayerCommandText", "is", playerid, comando);
	return 1;
	}
	public OnFilterScriptInit()
	{
	CriarCelularGlobal();
	for(new i = 0; i < MAX_PLAYERS; i++) CelularAberto[i] = false;
	print("[VirtualBoost] Celular Global carregado com sucesso.");
	return 1;
	}
	public OnFilterScriptExit()
	{
	if(CelularCriadoGlobal)
	{
	for(new i = 0; i < 11; i++) TextDrawDestroy(CelularBG[i]);
	TextDrawDestroy(CelularAjuda);
	TextDrawDestroy(CelularFechar);
	TextDrawDestroy(CelularRG);
	TextDrawDestroy(CelularGPS);
	TextDrawDestroy(CelularConfig);
	TextDrawDestroy(CelularCNH);
	CelularCriadoGlobal = false;
	}
	return 1;
	}
	public OnPlayerConnect(playerid)
	{
	CelularAberto[playerid] = false;
	return 1;
	}
	public OnPlayerCommandText(playerid, cmdtext[])
	{
	if(!strcmp(cmdtext, "/celular", true))
	{
	if(CelularAberto[playerid]) EsconderCelularVB(playerid);
	else MostrarCelularVB(playerid);
	return 1;
	}
	return 0;
	}
	public OnPlayerClickTextDraw(playerid, Text:clickedid)
	{
	if(!CelularAberto[playerid]) return 0;
	if(clickedid == Text:INVALID_TEXT_DRAW)
	{
	EsconderCelularVB(playerid);
	return 1;
	}
	if(clickedid == CelularAjuda) return ExecutarComandoCelular(playerid, "/ajuda");
	if(clickedid == CelularRG) return ExecutarComandoCelular(playerid, "/rg");
	if(clickedid == CelularGPS) return ExecutarComandoCelular(playerid, "/gps");
	if(clickedid == CelularConfig) return ExecutarComandoCelular(playerid, "/config");
	if(clickedid == CelularCNH) return ExecutarComandoCelular(playerid, "/minhaslicencas");
	if(clickedid == CelularFechar)
	{
	EsconderCelularVB(playerid);
	return 1;
	}
	return 0;
	}
