    PlayerTextDrawBackgroundColor(playerid, CelularAvatar[playerid], 85);
    PlayerTextDrawFont(playerid, CelularAvatar[playerid], 5);
    PlayerTextDrawSetProportional(playerid, CelularAvatar[playerid], false);
