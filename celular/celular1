#include <a_samp>

// VirtualBoost Phone - Filterscript independente.
// Mantem os comandos da GameMode; os aplicativos apenas encaminham os comandos existentes.

#define DIALOG_CELULAR_LIGAR (9876)

new Text:CelularBG[6];
new Text:CelularApp[18];
new bool:CelularCriadoGlobal = false;
new bool:CelularAberto[MAX_PLAYERS];

static const CelularNomeApp[18][16] =
{
    "AJUDA", "RG", "GPS",
    "CONFIG", "CNH", "ORGS",
    "VEICULO", "UBER", "BUS",
    "IFOOD", "HOSPITAL", "SERVICOS",
    "ADVOGADOS", "MECANICO", "LIGAR",
    "SMS", "NUBANK", "FECHAR"
};

static const CelularCorApp[18] =
{
    0x3978D4FF, 0x607D8BFF, 0x20A4D8FF,
    0x7E57C2FF, 0x26A69AFF, 0x455A64FF,
    0x546E7AFF, 0xF9A825FF, 0x1976D2FF,
    0xE53935FF, 0x43A047FF, 0x00897BFF,
    0x5E35B1FF, 0x78909CFF, 0x2E7D32FF,
    0x039BE5FF, 0x820AD1FF, 0x455A64FF
};

stock CriarCelularGlobal()
{
    if(CelularCriadoGlobal) return 1;

    // Corpo externo e tela branca.
    CelularBG[0] = TextDrawCreate(210.0, 108.0, "_");
    TextDrawLetterSize(CelularBG[0], 0.0, 25.5);
    TextDrawTextSize(CelularBG[0], 635.0, 0.0);
    TextDrawUseBox(CelularBG[0], 1);
    TextDrawBoxColor(CelularBG[0], 0x22252BFF);
    TextDrawFont(CelularBG[0], 1);
    TextDrawSetShadow(CelularBG[0], 0);
    TextDrawSetOutline(CelularBG[0], 0);

    CelularBG[1] = TextDrawCreate(214.0, 112.0, "_");
    TextDrawLetterSize(CelularBG[1], 0.0, 24.5);
    TextDrawTextSize(CelularBG[1], 631.0, 0.0);
    TextDrawUseBox(CelularBG[1], 1);
    TextDrawBoxColor(CelularBG[1], 0xFFFFFFFF);
    TextDrawFont(CelularBG[1], 1);
    TextDrawSetShadow(CelularBG[1], 0);
    TextDrawSetOutline(CelularBG[1], 0);

    // Barra superior e inferior.
    CelularBG[2] = TextDrawCreate(262.0, 121.0, "VIRTUAL PHONE");
    TextDrawLetterSize(CelularBG[2], 0.22, 1.1);
    TextDrawAlignment(CelularBG[2], 2);
    TextDrawTextSize(CelularBG[2], 631.0, 0.0);
    TextDrawColor(CelularBG[2], 0x17191DFF);
    TextDrawFont(CelularBG[2], 2);
    TextDrawSetProportional(CelularBG[2], 1);
    TextDrawSetShadow(CelularBG[2], 0);
    TextDrawSetOutline(CelularBG[2], 0);

    CelularBG[3] = TextDrawCreate(262.0, 133.0, "VIRTUAL BOOST  |  RP");
    TextDrawLetterSize(CelularBG[3], 0.13, 0.7);
    TextDrawAlignment(CelularBG[3], 2);
    TextDrawTextSize(CelularBG[3], 631.0, 0.0);
    TextDrawColor(CelularBG[3], 0x777777FF);
    TextDrawFont(CelularBG[3], 1);
    TextDrawSetProportional(CelularBG[3], 1);
    TextDrawSetShadow(CelularBG[3], 0);
    TextDrawSetOutline(CelularBG[3], 0);

    CelularBG[4] = TextDrawCreate(262.0, 268.0, "●   ●   ●");
    TextDrawLetterSize(CelularBG[4], 0.12, 0.7);
    TextDrawAlignment(CelularBG[4], 2);
    TextDrawTextSize(CelularBG[4], 631.0, 0.0);
    TextDrawColor(CelularBG[4], 0x555555FF);
    TextDrawFont(CelularBG[4], 1);
    TextDrawSetProportional(CelularBG[4], 1);
    TextDrawSetShadow(CelularBG[4], 0);
    TextDrawSetOutline(CelularBG[4], 0);

    CelularBG[5] = TextDrawCreate(262.0, 279.0, "VB  •  VIRTUAL BOOST");
    TextDrawLetterSize(CelularBG[5], 0.10, 0.55);
    TextDrawAlignment(CelularBG[5], 2);
    TextDrawTextSize(CelularBG[5], 631.0, 0.0);
    TextDrawColor(CelularBG[5], 0x888888FF);
    TextDrawFont(CelularBG[5], 1);
    TextDrawSetProportional(CelularBG[5], 1);
    TextDrawSetShadow(CelularBG[5], 0);
    TextDrawSetOutline(CelularBG[5], 0);

    // Grade 3 x 6 de aplicativos.
    for(new i = 0; i < 18; i++)
    {
        new coluna = i % 3;
        new linha = i / 3;
        new Float:x = 228.0 + (coluna * 33.0);
        new Float:y = 153.0 + (linha * 23.5);

        CelularApp[i] = TextDrawCreate(x, y, CelularNomeApp[i]);
        TextDrawLetterSize(CelularApp[i], 0.095, 0.62);
        TextDrawTextSize(CelularApp[i], 29.0, 21.0);
        TextDrawAlignment(CelularApp[i], 2);
        TextDrawColor(CelularApp[i], 0xFFFFFFFF);
        TextDrawUseBox(CelularApp[i], 1);
        TextDrawBoxColor(CelularApp[i], CelularCorApp[i]);
        TextDrawFont(CelularApp[i], 1);
        TextDrawSetProportional(CelularApp[i], 1);
        TextDrawSetShadow(CelularApp[i], 0);
        TextDrawSetOutline(CelularApp[i], 0);
        TextDrawSetSelectable(CelularApp[i], 1);
    }

    CelularCriadoGlobal = true;
    return 1;
}

stock MostrarCelularVB(playerid)
{
    if(!CelularCriadoGlobal) CriarCelularGlobal();

    for(new i = 0; i < 6; i++) TextDrawShowForPlayer(playerid, CelularBG[i]);
    for(new i = 0; i < 18; i++) TextDrawShowForPlayer(playerid, CelularApp[i]);

    CelularAberto[playerid] = true;
    SelectTextDraw(playerid, 0x820AD1FF);
    return 1;
}

stock EsconderCelularVB(playerid)
{
    CancelSelectTextDraw(playerid);
    for(new i = 0; i < 6; i++) TextDrawHideForPlayer(playerid, CelularBG[i]);
    for(new i = 0; i < 18; i++) TextDrawHideForPlayer(playerid, CelularApp[i]);
    CelularAberto[playerid] = false;
    return 1;
}

stock ExecutarComandoCelular(playerid, const comando[])
{
    EsconderCelularVB(playerid);
    CallRemoteFunction("OnPlayerCommandText", "is", playerid, comando);
    return 1;
}

stock AcionarAppCelular(playerid, appid)
{
    switch(appid)
    {
        case 0: return ExecutarComandoCelular(playerid, "/ajuda");
        case 1: return ExecutarComandoCelular(playerid, "/rg");
        case 2: return ExecutarComandoCelular(playerid, "/gps");
        case 3: return ExecutarComandoCelular(playerid, "/configuracoes");
        case 4: return ExecutarComandoCelular(playerid, "/minhaslicencas");
        case 5: return ExecutarComandoCelular(playerid, "/orgs");
        case 6: return ExecutarComandoCelular(playerid, "/veiculo ajuda");
        case 7: return ExecutarComandoCelular(playerid, "/servico taxi");
        case 8: return ExecutarComandoCelular(playerid, "/servico onibus");
        case 9: return ExecutarComandoCelular(playerid, "/servico pizza");
        case 10: return ExecutarComandoCelular(playerid, "/servico medico");
        case 11: return ExecutarComandoCelular(playerid, "/servicos");
        case 12: return ExecutarComandoCelular(playerid, "/servico advogado");
        case 13: return ExecutarComandoCelular(playerid, "/servico mecanico");
        case 14:
        {
            EsconderCelularVB(playerid);
            ShowPlayerDialog(playerid, DIALOG_CELULAR_LIGAR, DIALOG_STYLE_INPUT,
                "VIRTUAL PHONE - LIGAR",
                "Digite o numero de telefone que deseja chamar:",
                "LIGAR", "VOLTAR");
            return 1;
        }
        case 15: return ExecutarComandoCelular(playerid, "/sms");
        case 16:
        {
            // Abre o menu bancario original da GameMode. Assim o saldo e as
            // transferencias continuam usando PlayerInfo[pConta] e o banco existente.
            return ExecutarComandoCelular(playerid, "/banco");
        }
        case 17:
        {
            EsconderCelularVB(playerid);
            return 1;
        }
    }
    return 0;
}

public OnFilterScriptInit()
{
    CriarCelularGlobal();
    for(new i = 0; i < MAX_PLAYERS; i++) CelularAberto[i] = false;
    print("[VirtualBoost] VIRTUAL PHONE estilo iPhone carregado.");
    return 1;
}

public OnFilterScriptExit()
{
    if(CelularCriadoGlobal)
    {
        for(new i = 0; i < 6; i++) TextDrawDestroy(CelularBG[i]);
        for(new i = 0; i < 18; i++) TextDrawDestroy(CelularApp[i]);
        CelularCriadoGlobal = false;
    }
    return 1;
}

public OnPlayerConnect(playerid)
{
    CelularAberto[playerid] = false;
    return 1;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
    if(!strcmp(cmdtext, "/celular", true))
    {
        if(CelularAberto[playerid]) EsconderCelularVB(playerid);
        else MostrarCelularVB(playerid);
        return 1;
    }
    return 0;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(!CelularAberto[playerid]) return 0;

    if(clickedid == Text:INVALID_TEXT_DRAW)
    {
        EsconderCelularVB(playerid);
        return 1;
    }

    for(new i = 0; i < 18; i++)
    {
        if(clickedid == CelularApp[i]) return AcionarAppCelular(playerid, i);
    }
    return 0;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(dialogid == DIALOG_CELULAR_LIGAR)
    {
        if(!response) return 1;

        if(strlen(inputtext) < 1)
        {
            SendClientMessage(playerid, 0xE74C3CFF, "[VIRTUAL PHONE] Digite um numero valido.");
            return 1;
        }

        new numero = strval(inputtext);
        if(numero <= 0)
        {
            SendClientMessage(playerid, 0xE74C3CFF, "[VIRTUAL PHONE] Numero invalido.");
            return 1;
        }

        new comando[32];
        format(comando, sizeof(comando), "/ligar %d", numero);
        CallRemoteFunction("OnPlayerCommandText", "is", playerid, comando);
        return 1;
    }
    return 0;
}

forward AbrirCelularRemoto(playerid);
public AbrirCelularRemoto(playerid)
{
    if(CelularAberto[playerid]) return EsconderCelularVB(playerid);
    return MostrarCelularVB(playerid);
}
