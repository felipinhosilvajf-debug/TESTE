stock CriarAvatarCelular(playerid)
{
    CelularAvatar[playerid] = CreatePlayerTextDraw(playerid, 510.000, 182.000, "_");
    PlayerTextDrawTextSize(playerid, CelularAvatar[playerid], 49.000, 60.000);
    PlayerTextDrawAlignment(playerid, CelularAvatar[playerid], 1);
    PlayerTextDrawColor(playerid, CelularAvatar[playerid], -1);
    PlayerTextDrawSetShadow(playerid, CelularAvatar[playerid], 0);
    PlayerTextDrawSetOutline(playerid, CelularAvatar[playerid], 0);
    PlayerTextDrawBackgroundColor(playerid, CelularAvatar[playerid], 85);
    PlayerTextDrawFont(playerid, CelularAvatar[playerid], 5);
    PlayerTextDrawSetProportional(playerid, CelularAvatar[playerid], false);
    PlayerTextDrawSetPreviewModel(playerid, CelularAvatar[playerid], GetPlayerSkin(playerid));
    PlayerTextDrawSetPreviewRot(playerid, CelularAvatar[playerid], 0.000, 0.000, 0.000, 1.000);
    CelularAvatarCriado[playerid] = true;
    return 1;
}

stock MostrarCelularVB(playerid)
{
    for(new i = 0; i < sizeof(CelularBG); i++)
        TextDrawShowForPlayer(playerid, CelularBG[i]);

    TextDrawShowForPlayer(playerid, CelularTitulo);
    TextDrawShowForPlayer(playerid, CelularAjuda);
    TextDrawShowForPlayer(playerid, CelularFechar);
    TextDrawShowForPlayer(playerid, CelularRG);
    TextDrawShowForPlayer(playerid, CelularGPS);
    TextDrawShowForPlayer(playerid, CelularConfig);
    TextDrawShowForPlayer(playerid, CelularLicencas);

    if(!CelularAvatarCriado[playerid])
        CriarAvatarCelular(playerid);

    // Atualiza a miniatura com a skin atual do jogador ao abrir o telefone.
    PlayerTextDrawSetPreviewModel(playerid, CelularAvatar[playerid], GetPlayerSkin(playerid));
    PlayerTextDrawShow(playerid, CelularAvatar[playerid]);

    CelularAberto[playerid] = true;
    SelectTextDraw(playerid, 0x00D9FFFF);
    return 1;
}

stock EsconderCelularVB(playerid)
{
    for(new i = 0; i < sizeof(CelularBG); i++)
        TextDrawHideForPlayer(playerid, CelularBG[i]);

    TextDrawHideForPlayer(playerid, CelularTitulo);
    TextDrawHideForPlayer(playerid, CelularAjuda);
    TextDrawHideForPlayer(playerid, CelularFechar);
    TextDrawHideForPlayer(playerid, CelularRG);
    TextDrawHideForPlayer(playerid, CelularGPS);
    TextDrawHideForPlayer(playerid, CelularConfig);
    TextDrawHideForPlayer(playerid, CelularLicencas);

    if(CelularAvatarCriado[playerid])
        PlayerTextDrawHide(playerid, CelularAvatar[playerid]);

    CelularAberto[playerid] = false;
    CancelSelectTextDraw(playerid);
    return 1;
}

stock ExecutarComandoCelular(playerid, const comando[])
{
    EsconderCelularVB(playerid);
    // Encaminha o comando para os scripts/GM que tratam OnPlayerCommandText.
    CallRemoteFunction("OnPlayerCommandText", "is", playerid, comando);
    return 1;
}

public OnFilterScriptInit()
{
    CriarCelularTextDraws();
    print("[VirtualBoost] Celular FilterScript carregado.");
    return 1;
}

public OnFilterScriptExit()
{
    for(new i = 0; i < sizeof(CelularBG); i++)
        TextDrawDestroy(CelularBG[i]);

    TextDrawDestroy(CelularTitulo);
    TextDrawDestroy(CelularAjuda);
    TextDrawDestroy(CelularFechar);
    TextDrawDestroy(CelularRG);
    TextDrawDestroy(CelularGPS);
    TextDrawDestroy(CelularConfig);
    TextDrawDestroy(CelularLicencas);

    for(new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        if(CelularAvatarCriado[playerid])
        {
            PlayerTextDrawDestroy(playerid, CelularAvatar[playerid]);
            CelularAvatarCriado[playerid] = false;
        }
    }
    return 1;
}

public OnPlayerConnect(playerid)
{
    CelularAberto[playerid] = false;
    CelularAvatarCriado[playerid] = false;
    return 1;
}

public OnPlayerDisconnect(playerid, reason)
{
    if(CelularAberto[playerid])
        EsconderCelularVB(playerid);

    if(CelularAvatarCriado[playerid])
    {
        PlayerTextDrawDestroy(playerid, CelularAvatar[playerid]);
        CelularAvatarCriado[playerid] = false;
    }
    return 1;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
    if(!strcmp(cmdtext, "/vb", true))
    {
        if(CelularAberto[playerid])
            EsconderCelularVB(playerid);
        else
            MostrarCelularVB(playerid);
        return 1;
    }
    return 0;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(!CelularAberto[playerid])
        return 0;

    if(clickedid == Text:INVALID_TEXT_DRAW)
    {
        EsconderCelularVB(playerid);
        return 1;
    }

    if(clickedid == CelularAjuda)
        return ExecutarComandoCelular(playerid, "/ajuda");

    if(clickedid == CelularRG)
        return ExecutarComandoCelular(playerid, "/rg");

    if(clickedid == CelularGPS)
        return ExecutarComandoCelular(playerid, "/gps");

    if(clickedid == CelularConfig)
        return ExecutarComandoCelular(playerid, "/config");

    if(clickedid == CelularLicencas)
        return ExecutarComandoCelular(playerid, "/licencas");

    if(clickedid == CelularFechar)
    {
        EsconderCelularVB(playerid);
        return 1;
    }
    return 0;
}
