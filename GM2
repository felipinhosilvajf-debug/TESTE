    CMD:convidar(playerid, params[])
    {
        if(IsPlayerConnected(playerid))
        {
            new para1;
            if(sscanf(params, "u", para1))return SendClientMessage(playerid, COR_GRAD2, "{df5454}Ã—{ffffff} USE: /convidar [playerid/Parte-do-Nick]");
            if (PlayerInfo[playerid][pLider] > 0 || PlayerInfo[playerid][pCargo] == 5)
            {
                new lolz = GetPlayerOrg(playerid);
                if(TemVaga(lolz) == 0)
                {
                    SendClientMessage(playerid, COR_GRAD1, "nao ha mais vagas na lista use /limparvaga primeiro.");
                    return 1;
                }
                if(IsPlayerConnected(para1))
                {
                    if(PlayerInfo[para1][pMembro] != 0 || PlayerInfo[para1][pLider] != 0)
                    {
                        SendClientMessage(playerid, COR_GREY, "Este player ja participa de alguma ORG.");
                        return 1;
                    }
                    if(WantedLevel[para1] != 0)
                    {
                        SendClientMessage(playerid, COR_AMARELO, "Voce nao pode convidar um procurado !");
                        return 1;
                    }
                    if(PlayerInfo[para1][pLevel] < 2)
                    {
                        SendClientMessage(playerid, COR_AMARELO, "Voce nao pode convidar um novato !");
                        return 1;
                    }
                    if(para1 != INVALID_PLAYER_ID)
                    {
                        new string[122];
                        format(string, sizeof(string), "* Voce convidou %s para sua organizacao: %s.", PlayerName(para1),NomeORG(playerid));
                        SendClientMessage(playerid, COR_LIGHTBLUE, string);
                        convidado[para1] = 1;
                        InviteOffer[para1] = playerid;
                        InviteJob[para1] = lolz;
                        format(gstring,sizeof(gstring),"{00BFFF}Lider/Sub {FFFFFF}%s\n{00BFFF}Esta Te Convidando\npara a Organizacao {FFFFFF}%s\n{00BFFF}Deseja Aceitar ?",PlayerName(playerid), NomeORG(playerid));
                        ShowPlayerDialog(para1,1112,DIALOG_STYLE_MSGBOX,"Convite",gstring,"Sim","Nao");
                    }
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GREY, "Somente lideres podem usar este comando !");
            }
        }
        return 1;
    }
