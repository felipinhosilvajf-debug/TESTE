public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    if(AntiXiterSis == true)
    {
        new string[256];
        switch(weaponid){ case 0..18, 39..54: return 1;}//invalid weapons
        //Anti CBern Crasher
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        if(weaponid < 22 || weaponid > 38)
        {
            if(PlayerInfo[playerid][pLevel] < 6)
            {
                format(string, sizeof(string), "ANTIXITER: %s[%d] estava tentando crashar jogadores(cBern) e foi banido automaticamente!", PlayerName(playerid), playerid);
                SendClientMessageToAll(COR_LIGHTRED,string);
                BanBHC(playerid, "cBern crasher", "Automatico");
                BanLog(string);
                AntiXiterLog(string);
            }
            if(PlayerInfo[playerid][pLevel] > 5)
            {
                format(string, sizeof(string), "ANTIXITER: %s[%d] parece esta utilizando cBern de crasher players, /tvon nele rapido!", PlayerName(playerid), playerid);
                ABroadCast(COR_LIGHTRED,string,1);
                AntiXiterLog(string);
            }
            return 0;
        }
        if(!(-20000.0 <= z <= 20000.0))
        {
            if(PlayerInfo[playerid][pLevel] < 6)
            {
                format(string, sizeof(string), "ANTIXITER: %s[%d] estava tentando crashar jogadores(cBern) e foi banido automaticamente!", PlayerName(playerid), playerid);
                SendClientMessageToAll(COR_LIGHTRED,string);
                BanBHC(playerid, "CBern crasher", "Automatico");
                BanLog(string);
                AntiXiterLog(string);
            }
            if(PlayerInfo[playerid][pLevel] > 5)
            {
                format(string, sizeof(string), "ANTIXITER: %s[%d] parece esta utilizando cBern de crasher players, /tvon nele rapido!", PlayerName(playerid), playerid);
                ABroadCast(COR_LIGHTRED,string,1);
                AntiXiterLog(string);
            }
        }
        // anti rapid fire
        if(weaponid != 38)
        {
             if((gettime() - shotTime[playerid]) < 1)
             {
                 shot[playerid]+=1;
             }
             else
             {
                shot[playerid]=0;
             }
             if(shot[playerid] > 10)
             {
                format(string, sizeof(string), "ANTIXITER: %s[%d] suspeito de rapid fire, /tvon nele rapido!", PlayerName(playerid),playerid);
                ABroadCast(COR_LIGHTRED,string,1);
                AntiXiterLog(string);
             }
             shotTime[playerid] = gettime();
        }
        // anti auto cbug
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && weaponid == 24)
        {
            fAutoC[playerid] ++;
            if(gettime() > GetPVarInt(playerid, "UmSegundo"))
            {
                SetPVarInt(playerid, "UmSegundo", gettime() + 1);
                fAutoC[playerid] = 0;
            }
            else
            {
                if(fAutoC[playerid] > 4)
                {
                    format(string, sizeof(string), "ANTIXITER: %s[%d] parece estar usando auto cbug, /tvon nele rapido!", PlayerName(playerid),playerid);
                    ABroadCast(COR_LIGHTRED,string,1);
                    fAutoC[playerid] = 0;
                    AntiXiterLog(string);
                }
            }
        }
    }
    return 1;
}
