public OnPlayerCommandReceived(playerid, cmdtext[])
{
    if(enjaulado[playerid] == 1)
    {
         if(PlayerInfo[playerid][pAdmin] == 0)
         {
              SendClientMessage(playerid, COR_LIGHTRED, "Voce nao pode usar comandos, Voce esta sequestrado !");
              return 0;
         }
    }
    if(pimobilizado[playerid] == 1 && PlayerInfo[playerid][pAdmin] == 0)
    {
         SendClientMessage(playerid, COR_AMARELO, "Voce nao pode usar comandos, Voce esta imobilizado !");
         return 0;
    }
    if(Dormindo[playerid] == true) // sistema de dormir
    {
         SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao pode usar comandos dormindo, para acordar aperte Enter !");
         return 0;
    }
    if(strcmp("/sairduelo", cmdtext, true) == 0)
    {
         if(emduelo[playerid] == 0)
         {
             return SendClientMessage(playerid,COR_GRAD1,"Voce nao esta em um Duelo!");
         }
         new Float:arm;
         GetPlayerHealth(playerid,arm);
         if(arm < 100) return SendClientMessage(playerid,COR_GRAD1,"Voce so pode usar esse comando com vida cheia!");
         emduelo[playerid] = 0;
         desafiou[playerid] = 0;
         desafiado[playerid] = 0;
         duelols[playerid] = 0;
         duelolv[playerid] = 0;
         SetPlayerInterior(playerid, 0);
         SetPlayerPos(playerid, 2688.7698,-1702.2043,10.3984);
         SetPlayerVirtualWorld(playerid, 0);
         PlayerInfo[playerid][pDesafiador] = 0;
         PlayerInfo[playerid][pDesafiante] = 0;
         return 1;
    }
    if(emduelo[playerid] == 1)
    {
        SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao pode usar comandos durante o duelo ! para sair digite /sairduelo");
        return 0;
    }
    if(strcmp("/sairarena", cmdtext, true) == 0)
    {
         if(TDM[playerid] == 0)
         {
             return SendClientMessage(playerid,COR_GRAD1,"Voce nao esta em na Arena Deagle!");
         }
         new Float:arm;
         GetPlayerHealth(playerid,arm);
         if(arm < 100) return SendClientMessage(playerid,COR_GRAD1,"Voce so pode usar esse comando com vida cheia!");
         TDM[playerid] = 0;
         SetPlayerInterior(playerid, 0);
         SetPlayerPos(playerid, 1211.6652,-1750.1676,13.5942);
         SetPlayerVirtualWorld(playerid, 0);
         return 1;
    }
    if(TDM[playerid] == 1)
    {
        SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao pode usar comandos na arena de duelos ! para sair digite /sairarena");
        return 0;
    }
    if(NoTuto[playerid] > 0)
    {
        SendClientMessage(playerid, COR_LIGHTBLUE, "Voce nao pode usar comandos durante o tutorial !");
        return 0;
    }
    return 1;
}
