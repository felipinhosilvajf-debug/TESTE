    CMD:doar(playerid, result[])
    {
         new para1;
         new tipo;
         new quantidade;
         if(sscanf(result, "udd", para1, tipo, quantidade))
         {
              SendClientMessage(playerid, COR_LIGHTBLUE, "{df5454}Ã—{ffffff} USE: /doar [id] [tipo] [quantidade]");
              SendClientMessage(playerid, COR_GRAD6, "Tipos: 1(material) 2(credito cel)");
              return 1;
         }
         if(tipo < 1 || tipo > 2) { return 1; }
         if(IsPlayerConnected(para1))
         {
              if(para1 != INVALID_PLAYER_ID)
              {
                   if(PlayerInfo[para1][pLevel] <= 2)
                   {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode doar nada para jogadores level 2 !");
                        return 1;
                   }
                   if(AdminTrabalhando[para1] > 0)
                   {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode doar nada para um admin em modo trabalho !");
                        return 1;
                   }
                   if(tipo == 1)
                   {
                        if(strval(result) > PlayerInfo[playerid][pMats])
                        {
                             SendClientMessage(playerid, COR_GRAD1, "Voce nao tem materiais suficiente para poder doar !");
                             return 1;
                        }
                        PlayerInfo[playerid][pMats] -= quantidade;
                        PlayerInfo[para1][pMats] += quantidade;
                        format(stringZCMD, sizeof(stringZCMD), "Jogador: %s doou [%d] materiais de seus materiais para %s.", PlayerName(playerid), quantidade, PlayerName(para1));
                        ProxDetector(30.0, playerid, stringZCMD, COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE);
                   }
                   if(tipo == 2)
                   {
                        if(strval(result) > PlayerInfo[playerid][pCreditos])
                        {
                             SendClientMessage(playerid, COR_GRAD1, "Voce nao tem creditos suficiente para poder doar !");
                             return 1;
                        }
                        PlayerInfo[playerid][pCreditos] -= quantidade;
                        PlayerInfo[para1][pCreditos] += quantidade;
                        format(stringZCMD, sizeof(stringZCMD), "Jogador: %s doou [%d] creditos de seu celular para %s.", PlayerName(playerid), quantidade, PlayerName(para1));
                        ProxDetector(30.0, playerid, stringZCMD, COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE,COR_DBLUE);
                   }
              }
         }
         return 1;
    }
