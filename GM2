            }
            if(!IsACop(playerid) && PlayerInfo[playerid][pEmprego] != 7)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao e um Oficial !");
                return 1;
            }
            if(OnDuty[playerid] != 1 && PlayerInfo[playerid][pEmprego] != 7)
            {
                SendClientMessage(playerid, COR_GREY, "Voce nao Bateu o cartao!");
                return 1;
            }
            if(gPlayerInGuerra(playerid) || IsPlayerInSkate(playerid) || IsPlayerInPark(playerid) || IsPlayerInCasarao(playerid) || IsPlayerInMotel(playerid) || IsPlayerInMata(playerid) || IsPlayerInEstacao(playerid) || IsPlayerInChuck(playerid))
            {
                SendClientMessage(playerid, COR_GRAD1, "Voce nao pode usar este comando agora !");
                return 1;
            }
            if (IsACop(playerid) || PlayerInfo[playerid][pEmprego] == 7)
            {
                if(IsPlayerConnected(sscanfid))
                {
                    if(IsACop(sscanfid))
                    {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode dar su em Policiais!");
                        return 1;
                    }
                    if(PlayerInfo[playerid][pEmprego] == 7)
                    {
                        if(PlayerInfo[sscanfid][pEmprego] == 2)
                        {
                            SendClientMessage(playerid, COR_AMARELO, "Voce nao pode duvidar de um Advogado !");
                            return 1;
                        }
                        if(!PlayerToPoint(30.0,playerid,1770.6527,-1573.1688,1734.9430))
                        {
                            SendClientMessage(playerid, COR_AMARELO, "Voce so pode duvidar de jogadores dentro da penitenciaria !");
                            return 1;
                        }
                    }
                    if(PlayerInfo[sscanfid][pAdmin] == 1342)
                    {
                        SendClientMessage(playerid, COR_GRAD1, "Voce nao pode dar su em um Fundador !");
                        return 1;
                    }
                    if(PlayerInfo[sscanfid][pLider] == 7)
                    {
                        SendClientMessage(playerid, COR_AMARELO, "Voce nao pode duvidar do Governador !");
                        return 1;
                    }
                    if(GetTickCount() - TempoSu[sscanfid] < 4000)
                    {
                        SendClientMessage(playerid, COR_GRAY, "Este jogador levou um su a pouco tempo, espere 4 segundos!");
                        return 1;
                    }
                    if(PlayerInfo[playerid][pJailed] != 0 && PlayerInfo[playerid][pCargo] < 5)
                    {
                        SendClientMessage(playerid, COR_GRAY, "Voce nao pode dar su em quem esta preso, so sub-lider ou lider !");
                        return 1;
                    }
                    if(sscanfid != INVALID_PLAYER_ID)
                    {
                        if(GetDistanceBetweenPlayers(playerid,sscanfid) <= 70)
                        {
                            GetPlayerName(sscanfid, giveplayerZCMD, sizeof(giveplayerZCMD));
                            GetPlayerName(playerid, sendername, sizeof(sendername));
                            if(!CrimesServidor(result)) { SendClientMessage(playerid, COR_GREY, "Este tipo de su, nao e considerado um crime"); return 1; }
                            if(gPlayerInGuerra(playerid) && IsPlayerInSkate(playerid) && IsPlayerInPark(playerid) && IsPlayerInCasarao(playerid) && IsPlayerInMotel(playerid) && IsPlayerInMata(playerid) && IsPlayerInEstacao(playerid) && IsPlayerInTerritorio(playerid))
                            {
                                if(strcmp(!result,"Cumplice",true) == 0)
                                {
                                    SendClientMessage(playerid, COR_GRAY, "Voce esta em um territorio, so podera usar o /su cumplice!");
                                    return 1;
                                }
                            }
                            if(sscanfid == playerid) { SendClientMessage(playerid, COR_GREY, "Voce nao pode se dar su!"); return 1; }
                            if(strcmp(result,"DOP",true) == 0) { result = "Desobediencia a ordem policial"; }
                            if(strcmp(result,"TH",true) == 0) { result = "Tentativa de homicidio"; }
                            if(strcmp(result,"PIA",true) == 0) { result = "Porte Ilegal de Armas"; }
                            if(strcmp(result,"SEQ",true) == 0) { result = "Sequestro"; }
                            if(strcmp(result,"RP",true) == 0) { result = "Resistencia a Prisao"; }
                            if(strcmp(result,"vandalismo",true) == 0) { result = "Atentado Violento ao Pudor"; }
                            if(strcmp(result,"DSC",true) == 0) { result = "Dirigndo sem Carteira"; }
                            format(gstring, sizeof(gstring), "* Voce colou o jogador %s como suspeito. Crime: %s",giveplayerZCMD,result);
                            SendClientMessage(playerid, COR_LIGHTBLUE, gstring);
                            SetPlayerCriminal(sscanfid,playerid, result);
                            TempoSu[sscanfid] = GetTickCount();
                            return 1;
                        }
                        else
                        {
                            SendClientMessage(playerid, COR_LIGHTBLUE, "Este jogador esta muito longe de Voce !");
                            return 1;
                        }
                    }
                }
                else
                {
                    SendClientMessage(playerid, COR_GRAD1, "Esse jogador nao esta conectado.");
                    return 1;
                }
            }
            else
            {
                SendClientMessage(playerid, COR_GRAD2, "Voce nao e um Oficial !");
                return 1;
            }
        }
        return 1;
    }

