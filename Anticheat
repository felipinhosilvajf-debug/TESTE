package l2f.gameserver.anticheat;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

import l2f.gameserver.ThreadPoolManager;
import l2f.gameserver.database.DatabaseFactory;
import l2f.gameserver.model.Player;
import l2f.gameserver.model.Skill;

public final class AntiCheatManager
{
    private static final AntiCheatManager INSTANCE =
        new AntiCheatManager();

    private final Map<Integer, AttackState> _attackStates =
        new ConcurrentHashMap<Integer, AttackState>();

    private final Map<Integer, SkillState> _skillStates =
        new ConcurrentHashMap<Integer, SkillState>();

    private AntiCheatManager()
    {
    }

    public static AntiCheatManager getInstance()
    {
        return INSTANCE;
    }

    /*
     * ============================================================
     * ATAQUES
     * ============================================================
     */

    public void onAttack(final Player player)
    {
        if (player == null || !player.isOnline())
            return;

        final int objectId = player.getObjectId();
        final long now = System.currentTimeMillis();

        AttackState state = _attackStates.get(objectId);

        if (state == null)
        {
            state = new AttackState();
            state.lastAttack = now;
            _attackStates.put(objectId, state);
            return;
        }

        final long interval = now - state.lastAttack;

        state.lastAttack = now;

        if (interval > 2000L)
        {
            state.fastAttacks = 0;
            state.veryFastAttacks = 0;
            return;
        }

        if (interval < 250L)
            state.fastAttacks++;
        else
            state.fastAttacks = 0;

        if (interval < 180L)
            state.veryFastAttacks++;
        else
            state.veryFastAttacks = 0;

        if (state.fastAttacks > 20)
            state.fastAttacks = 20;

        if (state.veryFastAttacks > 20)
            state.veryFastAttacks = 20;

        if (state.fastAttacks == 5)
        {
            reportEvent(
                player,
                "ATTACK_RATE",
                35,
                "Intervalo entre ataques: "
                + interval
                + " ms | Ataques consecutivos rápidos: "
                + state.fastAttacks
            );

            return;
        }

        if (state.fastAttacks == 8)
        {
            reportEvent(
                player,
                "ATTACK_RATE",
                60,
                "Intervalo entre ataques: "
                + interval
                + " ms | Ataques consecutivos rápidos: "
                + state.fastAttacks
            );

            return;
        }

        if (state.veryFastAttacks == 12)
        {
            reportEvent(
                player,
                "ATTACK_RATE",
                80,
                "Intervalo entre ataques: "
                + interval
                + " ms | Ataques consecutivos muito rápidos: "
                + state.veryFastAttacks
            );
        }
    }

    /*
     * ============================================================
     * SKILLS
     * ============================================================
     */

	public void onSkillUse(
		final Player player,
		final Skill skill)
	{
		if (player == null || !player.isOnline())
			return;

		if (skill == null)
			return;

		final int objectId = player.getObjectId();
		final int skillId = skill.getId();
		final long now = System.currentTimeMillis();

		SkillState state = _skillStates.get(objectId);

		if (state == null)
		{
			state = new SkillState();

			state.lastSkillTime = now;
			state.lastSkillId = skillId;
			state.sameSkillCount = 1;

			_skillStates.put(objectId, state);

			return;
		}

		final long interval = now - state.lastSkillTime;

		/*
		 * Se mudou de skill, reinicia a sequência.
		 */
		if (state.lastSkillId != skillId)
		{
			state.lastSkillId = skillId;
			state.sameSkillCount = 1;
			state.lastSkillTime = now;

			return;
		}

		state.lastSkillTime = now;
		state.sameSkillCount++;

		/*
		 * Se demorou muito entre as utilizações,
		 * não existe sequência suspeita.
		 */
		if (interval > 5000L)
		{
			state.sameSkillCount = 1;
			return;
		}

		/*
		 * ============================================================
		 * NÍVEL 1 — SUSPEITA
		 * ============================================================
		 *
		 * 6 utilizações consecutivas da mesma skill
		 * com intervalo inferior a 500 ms.
		 */
		if (interval < 500L && state.sameSkillCount == 6)
		{
			reportSkillEvent(
				player,
				skill,
				interval,
				state.sameSkillCount,
				35
			);

			return;
		}

		/*
		 * ============================================================
		 * NÍVEL 2 — ALTA SUSPEITA
		 * ============================================================
		 *
		 * 10 utilizações consecutivas da mesma skill
		 * com intervalo inferior a 350 ms.
		 */
		if (interval < 350L && state.sameSkillCount == 10)
		{
			reportSkillEvent(
				player,
				skill,
				interval,
				state.sameSkillCount,
				60
			);

			return;
		}

		/*
		 * ============================================================
		 * NÍVEL 3 — CRÍTICO
		 * ============================================================
		 *
		 * 15 utilizações consecutivas da mesma skill
		 * com intervalo inferior a 200 ms.
		 */
		if (interval < 200L && state.sameSkillCount == 15)
		{
			reportSkillEvent(
				player,
				skill,
				interval,
				state.sameSkillCount,
				80
			);

			return;
		}

		/*
		 * Segurança contra crescimento infinito.
		 */
		if (state.sameSkillCount > 20)
			state.sameSkillCount = 20;
	}

    /*
     * ============================================================
     * EVENTOS
     * ============================================================
     */

    private void reportSkillEvent(
        final Player player,
        final Skill skill,
        final long interval,
        final int count,
        final int score)
    {
        final String details =
            "Skill ID: "
            + skill.getId()
            + " | Nível: "
            + skill.getLevel()
            + " | Intervalo: "
            + interval
            + " ms | Repetições: "
            + count
            + " | Score: "
            + score;

        reportEvent(
            player,
            "SKILL_RATE",
            score,
            details
        );
    }

    private void reportEvent(
        final Player player,
        final String eventType,
        final int score,
        final String details)
    {
        final String characterName = player.getName();
        final String accountName = player.getAccountName();
        final String ip = player.getIP();
        final String hwid = player.getHWID();

        final String severity;

        if (score >= 80)
            severity = "CRITICAL";
        else if (score >= 60)
            severity = "HIGH";
        else if (score >= 30)
            severity = "MEDIUM";
        else
            severity = "LOW";

        ThreadPoolManager.getInstance().execute(
            new Runnable()
            {
                @Override
                public void run()
                {
                    saveEvent(
                        characterName,
                        accountName,
                        ip,
                        hwid,
                        eventType,
                        severity,
                        score,
                        details
                    );
                }
            }
        );
    }

    private void saveEvent(
        String characterName,
        String accountName,
        String ip,
        String hwid,
        String eventType,
        String severity,
        int score,
        String details)
    {
        Connection con = null;
        PreparedStatement statement = null;

        try
        {
            con =
                DatabaseFactory.getInstance()
                    .getConnection();

            statement = con.prepareStatement(
                "INSERT INTO anticheat_events "
                + "(character_name, account_name, ip_address, hwid, "
                + "event_type, severity, score, details, created_at) "
                + "VALUES (?, ?, ?, ?, ?, ?, ?, ?, NOW())"
            );

            statement.setString(1, characterName);
            statement.setString(2, accountName);
            statement.setString(3, ip);
            statement.setString(4, hwid);
            statement.setString(5, eventType);
            statement.setString(6, severity);
            statement.setInt(7, score);
            statement.setString(8, details);

            statement.executeUpdate();
        }
        catch (Exception ignored)
        {
            /*
             * INTENCIONALMENTE SILENCIOSO.
             */
        }
        finally
        {
            try
            {
                if (statement != null)
                    statement.close();
            }
            catch (Exception ignored)
            {
            }

            try
            {
                if (con != null)
                    con.close();
            }
            catch (Exception ignored)
            {
            }
        }
    }

    /*
     * ============================================================
     * ESTADOS
     * ============================================================
     */

    private static final class AttackState
    {
        private long lastAttack = 0L;
        private int fastAttacks = 0;
        private int veryFastAttacks = 0;
    }

    private static final class SkillState
    {
        private long lastSkillTime = 0L;
        private int lastSkillId = 0;
        private int sameSkillCount = 0;
    }
}
