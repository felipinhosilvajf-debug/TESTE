global $pdo;

const VB_GOLD_ID = 40024;
const VB_SILVER_ID = 40025;

function h(?string $value): string
{
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function fmt(int $value): string
{
    return number_format($value, 0, ',', '.');
}

function getScalar(PDO $pdo, string $sql, array $params = []): int
{
    try {
        $stmt = $pdo->prepare($sql);
        $stmt->execute($params);
        return (int)$stmt->fetchColumn();
    } catch (Throwable $e) {
        return 0;
    }
}

function getRows(PDO $pdo, string $sql, array $params = []): array
{
    try {
        $stmt = $pdo->prepare($sql);
        $stmt->execute($params);
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    } catch (Throwable $e) {
        return [];
    }
}

/*
|--------------------------------------------------------------------------
| VISÃO GERAL
|--------------------------------------------------------------------------
| 40024 = VBGold
| 40025 = VBSilver
|
| Fonte real:
| items.owner_id -> characters.obj_Id
| items.item_id  -> ID da moeda
| items.count    -> quantidade
| items.loc      -> localização
|--------------------------------------------------------------------------
*/

$goldTotal = getScalar(
    $pdo,
    "SELECT COALESCE(SUM(count),0)
     FROM items
     WHERE item_id = :item_id
       AND count > 0",
    [':item_id' => VB_GOLD_ID]
);

$silverTotal = getScalar(
    $pdo,
    "SELECT COALESCE(SUM(count),0)
     FROM items
     WHERE item_id = :item_id
       AND count > 0",
    [':item_id' => VB_SILVER_ID]
);

$goldPlayers = getScalar(
    $pdo,
    "SELECT COUNT(DISTINCT owner_id)
     FROM items
     WHERE item_id = :item_id
       AND owner_id > 0
       AND count > 0",
    [':item_id' => VB_GOLD_ID]
);

$silverPlayers = getScalar(
    $pdo,
    "SELECT COUNT(DISTINCT owner_id)
     FROM items
     WHERE item_id = :item_id
       AND owner_id > 0
       AND count > 0",
    [':item_id' => VB_SILVER_ID]
);

$totalPlayers = getScalar(
    $pdo,
    "SELECT COUNT(DISTINCT owner_id)
     FROM items
     WHERE item_id IN (40024,40025)
       AND owner_id > 0
       AND count > 0"
);

$goldMax = getScalar(
    $pdo,
    "SELECT COALESCE(MAX(count),0)
     FROM items
     WHERE item_id = :item_id
       AND count > 0",
    [':item_id' => VB_GOLD_ID]
);

$silverMax = getScalar(
    $pdo,
    "SELECT COALESCE(MAX(count),0)
     FROM items
     WHERE item_id = :item_id
       AND count > 0",
    [':item_id' => VB_SILVER_ID]
);

$goldMin = getScalar(
    $pdo,
    "SELECT COALESCE(MIN(count),0)
     FROM items
     WHERE item_id = :item_id
       AND count > 0",
    [':item_id' => VB_GOLD_ID]
);

$silverMin = getScalar(
    $pdo,
    "SELECT COALESCE(MIN(count),0)
     FROM items
     WHERE item_id = :item_id
       AND count > 0",
    [':item_id' => VB_SILVER_ID]
);

/*
|--------------------------------------------------------------------------
| BUSCA
|--------------------------------------------------------------------------
*/

$search = trim((string)($_GET['search'] ?? ''));

$searchResults = [];

if ($search !== '') {
    $searchResults = getRows(
        $pdo,
        "SELECT
            c.obj_Id,
            c.char_name,
            c.account_name,
            c.online,
            COALESCE(SUM(CASE WHEN i.item_id = 40024 THEN i.count ELSE 0 END),0) AS gold,
            COALESCE(SUM(CASE WHEN i.item_id = 40025 THEN i.count ELSE 0 END),0) AS silver
         FROM characters c
         INNER JOIN items i ON i.owner_id = c.obj_Id
         WHERE
            (c.char_name LIKE :search1 OR c.account_name LIKE :search2)
            AND i.item_id IN (40024,40025)
            AND i.count > 0
         GROUP BY c.obj_Id,c.char_name,c.account_name,c.online
         ORDER BY (gold + silver) DESC
         LIMIT 100",
        [
            ':search1' => '%' . $search . '%',
            ':search2' => '%' . $search . '%'
        ]
    );
}

/*
|--------------------------------------------------------------------------
| RANKING
|--------------------------------------------------------------------------
*/

$ranking = getRows(
    $pdo,
    "SELECT
        c.obj_Id,
        c.char_name,
        c.account_name,
        c.online,
        COALESCE(SUM(CASE WHEN i.item_id = 40024 THEN i.count ELSE 0 END),0) AS gold,
        COALESCE(SUM(CASE WHEN i.item_id = 40025 THEN i.count ELSE 0 END),0) AS silver,
        COALESCE(SUM(i.count),0) AS total
     FROM characters c
     INNER JOIN items i ON i.owner_id = c.obj_Id
     WHERE i.item_id IN (40024,40025)
       AND i.count > 0
     GROUP BY c.obj_Id,c.char_name,c.account_name,c.online
     HAVING total > 0
     ORDER BY total DESC
     LIMIT 100",
    []
);

/*
|--------------------------------------------------------------------------
| MAIORES SALDOS SEPARADOS
|--------------------------------------------------------------------------
*/

$goldTop = getRows(
    $pdo,
    "SELECT
        c.obj_Id,
        c.char_name,
        c.account_name,
        c.online,
        SUM(i.count) AS amount
     FROM characters c
     INNER JOIN items i ON i.owner_id = c.obj_Id
     WHERE i.item_id = 40024
       AND i.count > 0
     GROUP BY c.obj_Id,c.char_name,c.account_name,c.online
     ORDER BY amount DESC
     LIMIT 10"
);

$silverTop = getRows(
    $pdo,
    "SELECT
        c.obj_Id,
        c.char_name,
        c.account_name,
        c.online,
        SUM(i.count) AS amount
     FROM characters c
     INNER JOIN items i ON i.owner_id = c.obj_Id
     WHERE i.item_id = 40025
       AND i.count > 0
     GROUP BY c.obj_Id,c.char_name,c.account_name,c.online
     ORDER BY amount DESC
     LIMIT 10"
);

/*
|--------------------------------------------------------------------------
| DISTRIBUIÇÃO POR LOCAL
|--------------------------------------------------------------------------
*/

$locations = getRows(
    $pdo,
    "SELECT
        i.loc,
        SUM(CASE WHEN i.item_id = 40024 THEN i.count ELSE 0 END) AS gold,
        SUM(CASE WHEN i.item_id = 40025 THEN i.count ELSE 0 END) AS silver,
        SUM(i.count) AS total
     FROM items i
     WHERE i.item_id IN (40024,40025)
       AND i.count > 0
     GROUP BY i.loc
     ORDER BY total DESC"
);

/*
|--------------------------------------------------------------------------
| CONTROLE POR PERSONAGEM
|--------------------------------------------------------------------------
*/

$inventoryRows = getRows(
    $pdo,
    "SELECT
        c.obj_Id,
        c.char_name,
        c.account_name,
        c.online,
        COALESCE(SUM(CASE WHEN i.item_id = 40024 AND i.loc = 'INVENTORY' THEN i.count ELSE 0 END),0) AS gold_inventory,
        COALESCE(SUM(CASE WHEN i.item_id = 40024 AND i.loc = 'WAREHOUSE' THEN i.count ELSE 0 END),0) AS gold_warehouse,
        COALESCE(SUM(CASE WHEN i.item_id = 40025 AND i.loc = 'INVENTORY' THEN i.count ELSE 0 END),0) AS silver_inventory,
        COALESCE(SUM(CASE WHEN i.item_id = 40025 AND i.loc = 'WAREHOUSE' THEN i.count ELSE 0 END),0) AS silver_warehouse
     FROM characters c
     INNER JOIN items i ON i.owner_id = c.obj_Id
     WHERE i.item_id IN (40024,40025)
       AND i.count > 0
     GROUP BY c.obj_Id,c.char_name,c.account_name,c.online
     HAVING
        gold_inventory > 0 OR gold_warehouse > 0
        OR silver_inventory > 0 OR silver_warehouse > 0
     ORDER BY
        (gold_inventory + gold_warehouse + silver_inventory + silver_warehouse) DESC
     LIMIT 500"
);

