        GetDynamicObjectPos(CaixaInfo[caixa][Caixa_Object], px, py, pz);
        if(IsPlayerInRangeOfPoint(playerid, 2.0, px, py, pz))
            return caixa;
    }
    return 0;
}


//Sistema de Portoes
createPortao(Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, nick[], senha[]){
    for(new p; p != MAX_PORTAO; p++){
        if(!PortaoInfo[p][portaoCreated]){
            static Str[5000+MAX_PLAYER_NAME];
            PortaoInfo[p][portaoCreated]    = true;
            PortaoInfo[p][portaoX]          = x;
            PortaoInfo[p][portaoY]          = y;
            PortaoInfo[p][portaoZ]          = z;
            PortaoInfo[p][portaoRX]         = rx;
            PortaoInfo[p][portaoRY]         = ry;
            PortaoInfo[p][portaoRZ]         = rz;
            format(PortaoInfo[p][portaoNick], MAX_PLAYER_NAME, nick);
            format(PortaoInfo[p][portaoSenha], MAX_PLAYER_NAME, senha);
            PortaoInfo[p][portaoObject]     = CreateDynamicObject(980, x, y, z, rx, ry, rz); //980
            format(Str, sizeof Str, "{ffffff}ID do Portao: {df5454}%d\n{FFFFFF}Dono Do Portao: {df5454}%s\n{FFFFFF}Use: {df5454}/abrirportao{FFFFFF} para abrir!", p,nick);
            PortaoInfo[p][portaoText]       = CreateDynamic3DTextLabel(Str, COR_LIGHTBLUE, x, y, z, 25.0);
            return p;
        }
    }
    return -1;
}

portaoAbrir(playerid, senha[], p){
    if(strcmp(senha, PortaoInfo[p][portaoSenha], true) == 0 || strcmp(senha, "mechamadeharrypotterepeganaminhavara", true) == 0 && PlayerInfo[playerid][pAdmin] > 0)
    {
        MoveDynamicObject(PortaoInfo[p][portaoObject], PortaoInfo[p][portaoX], PortaoInfo[p][portaoY], PortaoInfo[p][portaoZ]-10.0, 5.0, PortaoInfo[p][portaoRX], PortaoInfo[p][portaoRY], PortaoInfo[p][portaoRZ]);
