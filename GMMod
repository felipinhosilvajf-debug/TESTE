stock Float:GetPlayerMoveCount(Float:oldd,Float:neww)
{
     new Float:ret;
     if(oldd < neww)
     {
          ret = neww - oldd;//tag mismatch
     }
     else if(neww > oldd)
     {
          ret = oldd - neww;//tag mismatch
     }
     else if(neww == oldd)
     {
          ret = 0;
     }
