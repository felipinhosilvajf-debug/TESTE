        SetVehicleNumberPlate(VeiculoPessoal[playerid], VeiculoInfo[playerid][vPlaca]);
    }
    return 1;
}


START::EfetuarBackup()
{
    foreach(new i: Player)
    {
            new File[56],Float:pPosX[MAX_PLAYERS], Float:pPosY[MAX_PLAYERS], Float:pPosZ[MAX_PLAYERS], Float:pPosA[MAX_PLAYERS],pInterior[MAX_PLAYERS];
            format(File, 56, "Posicoes/%s.txt", PlayerName(i)); // Cria o "caminho" ate o local onde sera salvo o Arquivo com a posicao do Player
            GetPlayerPos(i, pPosX[i], pPosY[i], pPosZ[i]); // Pega a Posicao do Player em X, Y e Z, e converte para "pPosX", "pPosY" e "pPosZ", respectivamente.
            GetPlayerFacingAngle(i, pPosA[i]); // Pega o angulo do Player em A e converte para pPosA, logo pPosA = angulo do Player
            pInterior[i] = GetPlayerInterior(i); // Pega o interior do Player, que fica armazenado em pInterior.
            if(!DOF2_FileExists(File)) // Checa se a File existe
            {
                DOF2_CreateFile(File); // Se nao existir, cria
            }
            DOF2_SetFloat(File, "PosX", pPosX[i]); // Escreve dentro do Arquivo: "PosX = pPosX (posicao que pegamos antes, lembra ?)
            DOF2_SetFloat(File, "PosY", pPosY[i]); // Escreve dentro do Arquivo: "PosY = pPosY (posicao que pegamos antes, lembra ?)
            DOF2_SetFloat(File, "PosZ", pPosZ[i]); // Escreve dentro do Arquivo: "PosZ = pPosZ (posicao que pegamos antes, lembra ?)
            DOF2_SetFloat(File, "PosA", pPosA[i]); // Escreve dentro do Arquivo: "PosA = pPosA (posicao que pegamos antes, lembra ?)
            DOF2_SetInt(File, "Interior", pInterior[i]); // Escreve dentro do Arquivo: "Interior = pInterior (interior que pegamos antes, lembra ?)
            DOF2_SaveFile(); // Salva o arquivo.
            SalvarInventario(i);
            OnPlayerSave(i);
            SalvarVeiculosConce(i);
    }
    salvarGrafites();
    SalvarPlantacao();
    SalvarEmpresas();
    SalvarSEmpresas();
    salvarPortoes();
    SalvarCofreOrg();
    for(new i; i < 500; i++)
    {
        salvarMoveis(i);
        SalvarEmpresa(i);
    }
    FinalizarBackup();
    return 1;
}

START::FinalizarBackup()
{
    SendClientMessageToAll(COR_VERDE, "{33ff00}[Backup Diario Conluido] Todos os dados de contas, orgs, fazendas, empresas, foram salvos na MySQL.");
    SendClientMessageToAll(COR_VERDE, "{33ff00}[Backup Diario Conluido] E os backups na DOF2 para entrar em analise e ver oque/quem perdeu dados depois da GMX.");
    return 1;
}


