                    if(PlayerInfo[playerid][pSede] < 10){
                        format(stringZCMD, sizeof stringZCMD, "* Voce esta com sede, perdeu %d porcento de vida!", porcento);
                        SendClientMessage(playerid, COR_START2, stringZCMD);
                    }
                    retirada[playerid] = 0;
                    return 1;
                }

                if(PlayerInfo[playerid][pFome] < 25 || PlayerInfo[playerid][pSede] < 25)
                {
                    PlayerInfo[playerid][pFome] -- ;
                    PlayerInfo[playerid][pSede] -= random(2);
                    if(PlayerInfo[playerid][pFome] < 1)PlayerInfo[playerid][pFome] = 1;
                    if(PlayerInfo[playerid][pSede] < 1)PlayerInfo[playerid][pSede] = 1;
                    if(vidaplayer >5 )
                    {
                        SetPlayerHealth(playerid, vidaplayer - 5);
                    }
                    retirada[playerid] = 0;
                    return 1;
                }
                if(PlayerInfo[playerid][pFome] < 50 || PlayerInfo[playerid][pSede] < 50 )
                {
                    PlayerInfo[playerid][pFome] -- ;
                    PlayerInfo[playerid][pSede] -= random(2);
                    if(PlayerInfo[playerid][pFome] < 1)PlayerInfo[playerid][pFome] = 1;
                    if(PlayerInfo[playerid][pSede] < 1)PlayerInfo[playerid][pSede] = 1;
                    if(vidaplayer >2 )
                    {
                        SetPlayerHealth(playerid, vidaplayer - 2);
                    }
                    retirada[playerid] = 0;
                    return 1;
                }
                PlayerInfo[playerid][pFome] -- ;
                PlayerInfo[playerid][pSede] -= random(2);
                retirada[playerid] = 0;
            }
        }
    }
    return 1;
}
