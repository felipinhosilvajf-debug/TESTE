        {
            if(ModoEditar[playerid] == 1)
            {
                PlayerTextDrawSetString(playerid, EditorMobile[playerid][10], "Posicao");
            }
            else if(ModoEditar[playerid] == 2)
            {
                PlayerTextDrawSetString(playerid, EditorMobile[playerid][10], "Rotacao");
            }
            else if(ModoEditar[playerid] == 3)
            {
                PlayerTextDrawSetString(playerid, EditorMobile[playerid][10], "Tamanho");
            }
        }
        if(LagSis == true)
        {
            OnPlayerSave(playerid); //pode dar merda
        //  SalvarVeiculosConce(playerid);
        }
        SalvarVeiculosConce(playerid);
