        SendClientMessage(playerid, COR_START, "{df5454}PORTao: {ffffff}Voce abriu o seu portao, ele fechara em 5 segundos!");
    }
    else {
        SendClientMessage(playerid, COR_START, "{df5454}ERRO: {ffffff}A Senha do portao esta incorreta!");
    }
}


