                            EstaAFK[playerid] = 0;
                    }

            }
        }
        if((gettime()-TempoAFK[playerid]) > 2)return true;
        ResetPlayerMoney(playerid);
        GivePlayerMoney(playerid, GetPlayerMoneyEx(playerid));
        if (IsPlayerInRangeOfPoint(playerid, 10.0, FogoX[1], FogoY[1], FogoZ[1]))
        {
