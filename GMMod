        switch(GetPlayerState(playerid)){
            case 1, 2, 3:{
                if((gettime()-TempoAFK[playerid]) > 4 && !IsPlayerNPC(playerid)){
                        format(gstring, sizeof gstring, "{df5454}Ausente a {ffffff}%s", ConvertTime(gettime()-TempoAFK[playerid]));
